        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"io\"\n5\t\n6\t\t\"github.com/spf13/cobra\"\n7\t\n8\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n9\t\t\"github.com/Teeeep/talaria/internal/output\"\n10\t\t\"github.com/Teeeep/talaria/internal/spec\"\n11\t)\n12\t\n13\t// version is the binary's version string. It defaults to \"dev\" and is\n14\t// overridden at build time with -ldflags \"-X main.version=v0.1.0\".\n15\tvar version = \"dev\"\n16\t\n17\t// newRootCmd builds the talaria command tree. Every command is constructed\n18\t// per-call rather than living in a package-level var so tests can run against\n19\t// an isolated tree with their own output writers.\n20\tfunc newRootCmd() *cobra.Command {\n21\t\troot := &cobra.Command{\n22\t\t\tUse:   \"talaria\",\n23\t\t\tShort: \"Point it at any API doc; your agent works the API and never sees your credentials\",\n24\t\t\tLong: \"talaria turns any OpenAPI/Swagger spec into an explorable API client, a\\n\" +\n25\t\t\t\t\"spec-driven tester, and a digital twin — without exposing credentials to\\n\" +\n26\t\t\t\t\"the agent driving it.\",\n27\t\t\tVersion: version,\n28\t\t\t// Agents parse stderr. Cobra's default behaviour of dumping the usage\n29\t\t\t// block on every error, and of printing the error itself on top of the\n30\t\t\t// caller doing so, is noise.\n31\t\t\tSilenceUsage:  true,\n32\t\t\tSilenceErrors: true,\n33\t\t}\n34\t\n35\t\t// Registered once, here, so every present and future subcommand accepts it\n36\t\t// (DESIGN.md §3.1: \"--output json on every command\"). The empty default\n37\t\t// means \"decide from the terminal\"; see output.Resolve.\n38\t\troot.PersistentFlags().String(\"output\", \"\",\n39\t\t\t\"output format: json|pretty|tsv (default: pretty on a terminal, json when piped)\")\n40\t\n41\t\t// Also persistent: every spec-reading command takes the same spec the same\n42\t\t// way, and an agent that exports $TALARIA_SPEC once should not have to\n43\t\t// repeat itself on each call (DESIGN.md §4). Precedence between the three\n44\t\t// sources lives in spec.Resolve, not here.\n45\t\troot.PersistentFlags().String(\"spec\", \"\",\n46\t\t\t\"OpenAPI/Swagger spec to use: file path or URL (default: $\"+spec.EnvSpec+\")\")\n47\t\n48\t\t// Persistent for the same reason: call, run and auth check all take them\n49\t\t// (DESIGN.md §4), and registering either per-command would shadow the other\n50\t\t// registration silently. Commands that read no config simply ignore them.\n51\t\troot.PersistentFlags().String(\"profile\", \"\",\n52\t\t\t\"named profile from the config file: base-url + headers + auth\")\n53\t\troot.PersistentFlags().String(\"base-url\", \"\",\n54\t\t\t\"override the spec's server URL\")\n55\t\n56\t\t// A bad flag is a bad invocation, not a failed request; without this it\n57\t\t// would reach the translator as a bare error and exit 1.\n58\t\troot.SetFlagErrorFunc(func(_ *cobra.Command, err error) error {\n59\t\t\treturn clierr.Usage(\"%s\", err)\n60\t\t})\n61\t\n62\t\t// The Args counterpart of SetFlagErrorFunc lives per-command, in usageArgs;\n63\t\t// cobra has no tree-wide hook for it.\n64\t\n65\t\t// Validated once for the whole tree, so an unusable --output fails before a\n66\t\t// command does any work — including on commands that ignore the format.\n67\t\troot.PersistentPreRunE = func(cmd *cobra.Command, _ []string) error {\n68\t\t\t_, err := resolveFormat(cmd)\n69\t\t\treturn err\n70\t\t}\n71\t\n72\t\troot.AddCommand(newVersionCmd())\n73\t\troot.AddCommand(newListCmd())\n74\t\troot.AddCommand(newDescribeCmd())\n75\t\troot.AddCommand(newSearchCmd())\n76\t\troot.AddCommand(newUsesCmd())\n77\t\troot.AddCommand(newCallCmd())\n78\t\troot.AddCommand(newRunCmd())\n79\t\troot.AddCommand(newAuthCmd())\n80\t\troot.AddCommand(newHistoryCmd())\n81\t\n82\t\treturn root\n83\t}\n84\t\n85\t// usageArgs wraps a positional-argument validator so a wrong argument count\n86\t// exits 2 like every other bad invocation. Cobra returns a bare error here, and\n87\t// SetFlagErrorFunc does not cover it, so without this the caller would see the\n88\t// unclassified-failure code 1.\n89\tfunc usageArgs(validate cobra.PositionalArgs) cobra.PositionalArgs {\n90\t\treturn func(cmd *cobra.Command, args []string) error {\n91\t\t\tif err := validate(cmd, args); err != nil {\n92\t\t\t\treturn clierr.Usage(\"%w\", err)\n93\t\t\t}\n94\t\t\treturn nil\n95\t\t}\n96\t}\n97\t\n98\t// resolveFormat resolves --output for cmd against the TTY-ness of its stdout.\n99\t// internal/output deliberately returns a bare error; it becomes a usage error\n100\t// here, where the exit-code contract lives, carrying the valid values so an\n101\t// agent can correct itself without reading the help text.\n102\tfunc resolveFormat(cmd *cobra.Command) (output.Format, error) {\n103\t\texplicit, err := cmd.Flags().GetString(\"output\")\n104\t\tif err != nil {\n105\t\t\treturn \"\", clierr.Usage(\"%w\", err)\n106\t\t}\n107\t\n108\t\tformat, err := output.Resolve(explicit, output.IsTTY(cmd.OutOrStdout()))\n109\t\tif err != nil {\n110\t\t\treturn \"\", clierr.Usage(\"%w\", err).WithAlternatives(output.Formats()...)\n111\t\t}\n112\t\treturn format, nil\n113\t}\n114\t\n115\t// run executes the talaria command tree and returns the process exit code.\n116\t// It deliberately does not call os.Exit — main is the only place that does —\n117\t// so every exit code in the CLI is assertable in-process.\n118\tfunc run(args []string, stdout, stderr io.Writer) int {\n119\t\troot := newRootCmd()\n120\t\troot.SetOut(stdout)\n121\t\troot.SetErr(stderr)\n122\t\troot.SetArgs(args)\n123\t\n124\t\treturn exitCode(root.Execute(), stderr)\n125\t}\n126\t\n127\t// exitCode renders err as structured JSON on stderr and returns the code to\n128\t// exit with. An error that was never classified is a request failure (1).\n129\tfunc exitCode(err error, stderr io.Writer) int {\n130\t\tif err == nil {\n131\t\t\treturn int(clierr.CodeOK)\n132\t\t}\n133\t\n134\t\tclierr.Render(stderr, err)\n135\t\treturn int(clierr.From(err).Code)\n136\t}\n137\t"
      }
