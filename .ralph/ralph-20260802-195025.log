        "content": "1\t// Package curl turns a bound request into curl: the displayable command\n2\t// `--dry-run` prints and every executed call reports, the config document curl\n3\t// actually reads, and the executor that spawns it (DESIGN.md §3.4).\n4\t//\n5\t// This file is symbolic. It reads request.Value's Symbolic and redacted forms\n6\t// and never calls SecretRef.Resolve, so an emitted command references\n7\t// $TALARIA_AUTH_BEARER rather than a token: \"runnable in a shell where the env\n8\t// var is set, useless to exfiltrate\" (§5a). Resolution happens in exactly one\n9\t// place, config.go's resolve, and nothing outside this package can reach it.\n10\tpackage curl\n11\t\n12\timport (\n13\t\t\"net/http\"\n14\t\t\"net/url\"\n15\t\t\"regexp\"\n16\t\t\"strings\"\n17\t\n18\t\t\"github.com/Teeeep/talaria/internal/request\"\n19\t)\n20\t\n21\t// Render returns the curl command that reproduces req: a portable, symbolic\n22\t// reproduction for bug reports, docs and scripts (§3.4).\n23\t//\n24\t// The URL comes last, the way the design's sketch and most hand-written curl\n25\t// put it, so a reader sees what is being called without scanning past the\n26\t// flags.\n27\tfunc Render(req *request.Request) string {\n28\t\tif req == nil {\n29\t\t\treturn \"\"\n30\t\t}\n31\t\n32\t\t// -q mirrors the executed command (config.go's argv), so a pasted\n33\t\t// reproduction behaves like the call talaria made rather than like the\n34\t\t// reader's ~/.curlrc — which would otherwise apply its directives to a\n35\t\t// request the reader has just expanded a real credential into.\n36\t\targs := []string{\"curl\", \"-q\", \"-s\"}\n37\t\tswitch {\n38\t\t// -I rather than -X HEAD, matching the config document: pasted, -X HEAD waits\n39\t\t// for a body the server never sends, so the reproduction would hang where the\n40\t\t// call it reproduces did not.\n41\t\tcase strings.EqualFold(req.Method, http.MethodHead):\n42\t\t\targs = append(args, \"-I\")\n43\t\t// GET is curl's default and naming it adds noise; anything else is worth\n44\t\t// seeing, and for a mutation it is the most important token in the line.\n45\t\tcase req.Method != \"\" && !strings.EqualFold(req.Method, http.MethodGet):\n46\t\t\targs = append(args, \"-X\", req.Method)\n47\t\t}\n48\t\n49\t\targs = append(args, headerArgs(req)...)\n50\t\tif cookies := cookieWord(req); cookies != nil {\n51\t\t\targs = append(args, \"-b\", cookies.String())\n52\t\t}\n53\t\targs = append(args, bodyArgs(req)...)\n54\t\targs = append(args, urlWord(req, request.Value.Symbolic).String())\n55\t\n56\t\treturn strings.Join(args, \" \")\n57\t}\n58\t\n59\t// URL renders req's URL the way a reader consumes it: percent-encoded like the\n60\t// wire form, but with credentials shown as <redacted:env:NAME> rather than\n61\t// percent-encoded into illegibility. It is what the `request.url` field of\n62\t// call's output carries (§5a: symbolic in emitted curl, redacted in output URL\n63\t// fields).\n64\t//\n65\t// request.Request.URL is the wire-correct counterpart, and is what the executor\n66\t// uses once it has resolved the credentials.\n67\tfunc URL(req *request.Request) string {\n68\t\tif req == nil {\n69\t\t\treturn \"\"\n70\t\t}\n71\t\n72\t\treturn urlWord(req, request.Value.String).plain()\n73\t}\n74\t\n75\t// headerArgs renders the request headers, with basic auth diverted to curl's\n76\t// own -u.\n77\tfunc headerArgs(req *request.Request) []string {\n78\t\tvar args []string\n79\t\tfor _, h := range req.Headers {\n80\t\t\t// A basic-auth header's text is base64(user:password), which cannot be\n81\t\t\t// produced without the credential. -u takes the raw user:password, so\n82\t\t\t// the command stays symbolic and still works when it is pasted.\n83\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n84\t\t\t\targs = append(args, \"-u\", (&word{}).credential(h.Value.Ref().Symbolic(), h.Value).String())\n85\t\t\t\tcontinue\n86\t\t\t}\n87\t\n88\t\t\targs = append(args, \"-H\", (&word{}).literal(h.Name+\": \").value(h.Value).String())\n89\t\t}\n90\t\n91\t\treturn args\n92\t}\n93\t\n94\t// cookieWord renders every cookie into one -b argument. curl keeps only the\n95\t// last -b of several, so the cookies are joined rather than repeated.\n96\tfunc cookieWord(req *request.Request) *word {\n97\t\tif len(req.Cookies) == 0 {\n98\t\t\treturn nil\n99\t\t}\n100\t\n101\t\tw := &word{}\n102\t\tfor i, c := range req.Cookies {\n103\t\t\tif i > 0 {\n104\t\t\t\tw.literal(\"; \")\n105\t\t\t}\n106\t\t\tw.literal(c.Name + \"=\").value(c.Value)\n107\t\t}\n108\t\n109\t\treturn w\n110\t}\n111\t\n112\t// bodyArgs renders the request body and the content type that describes it.\n113\t// --data-raw rather than --data or --data-binary, matching the config document\n114\t// for the same reason (config.go's body): those two read a value starting with\n115\t// @ as a filename, so the emitted command would read a local file and send it\n116\t// to the API where the call sent the text. --data also strips newlines, which\n117\t// changes the bytes a signed or whitespace-sensitive payload carries.\n118\tfunc bodyArgs(req *request.Request) []string {\n119\t\tif req.Body == nil {\n120\t\t\treturn nil\n121\t\t}\n122\t\n123\t\tvar args []string\n124\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n125\t\t\targs = append(args, \"-H\", (&word{}).literal(\"Content-Type: \"+req.Body.ContentType).String())\n126\t\t}\n127\t\n128\t\treturn append(args, \"--data-raw\", (&word{}).literal(string(req.Body.Data)).String())\n129\t}\n130\t\n131\tfunc hasHeader(req *request.Request, name string) bool {\n132\t\tfor _, h := range req.Headers {\n133\t\t\tif strings.EqualFold(h.Name, name) {\n134\t\t\t\treturn true\n135\t\t\t}\n136\t\t}\n137\t\n138\t\treturn false\n139\t}\n140\t\n141\t// urlWord builds the request URL as one shell word. render chooses how a\n142\t// credential in the query string appears — Symbolic for the emitted command,\n143\t// String for the redacted display form.\n144\t//\n145\t// Literal values are percent-encoded here rather than by request.QueryString\n146\t// because a percent-encoded $NAME would no longer be a reference the shell can\n147\t// expand. Encoding per value, instead of over the finished string, is what lets\n148\t// the two live in one URL.\n149\tfunc urlWord(req *request.Request, render func(request.Value) string) *word {\n150\t\tw := (&word{}).literal(req.BaseURL + req.Path)\n151\t\n152\t\tfor i, q := range req.Query {\n153\t\t\tseparator := \"&\"\n154\t\t\tif i == 0 {\n155\t\t\t\tseparator = \"?\"\n156\t\t\t}\n157\t\t\tw.literal(separator + url.QueryEscape(q.Name) + \"=\")\n158\t\n159\t\t\t// Sensitive rather than secret: a literal hidden by name has no value to\n160\t\t\t// render here either, and percent-encoding its placeholder would print\n161\t\t\t// %3Credacted%3E where a reader expects <redacted>. Skipping the encode\n162\t\t\t// is safe because render is Symbolic or String — display forms, never a\n163\t\t\t// resolving renderer.\n164\t\t\tif q.Value.IsSensitive() {\n165\t\t\t\tw.credential(render(q.Value), q.Value)\n166\t\t\t\tcontinue\n167\t\t\t}\n168\t\t\tw.literal(url.QueryEscape(q.Value.String()))\n169\t\t}\n170\t\n171\t\treturn w\n172\t}\n173\t\n174\t// shellName matches an environment variable name a shell will expand from a\n175\t// bare $NAME. A ref whose name is not one of these is rendered redacted\n176\t// instead: an emitted command that stops being copy-pasteable is a better\n177\t// outcome than one that expands into something unintended.\n178\tvar shellName = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\n179\t\n180\t// part is one piece of a shell word. expand marks the pieces the shell is\n181\t// meant to act on — the credential references, and nothing else.\n182\ttype part struct {\n183\t\ttext   string\n184\t\texpand bool\n185\t}\n186\t\n187\t// word is one argument of the rendered command, assembled from literal text and\n188\t// credential references.\n189\t//\n190\t// The quoting rule follows from what each word contains. A word of pure literal\n191\t// text is single-quoted, which needs no escaping beyond the quote itself and\n192\t// leaves every $ and backtick inert. A word carrying a reference has to be\n193\t// double-quoted so the shell expands it, so its literal parts are escaped\n194\t// against the four characters double quotes still interpret.\n195\ttype word struct{ parts []part }\n196\t\n197\tfunc (w *word) literal(s string) *word {\n198\t\tif s != \"\" {\n199\t\t\tw.parts = append(w.parts, part{text: s})\n200\t\t}\n201\t\n202\t\treturn w\n203\t}\n204\t\n205\t// value appends a request value: the reference symbolically, or the literal\n206\t// text for a literal value.\n207\tfunc (w *word) value(v request.Value) *word {\n208\t\tif v.IsSecret() {\n209\t\t\treturn w.credential(v.Symbolic(), v)\n210\t\t}\n211\t\n212\t\treturn w.literal(v.String())\n213\t}\n214\t\n215\t// credential appends a rendered credential, marking it for expansion only when\n216\t// the shell can actually expand it back into the value. A basic-auth value, a\n217\t// redacted rendering, or a ref from a source that is not the environment all\n218\t// render as inert text.\n219\tfunc (w *word) credential(rendered string, v request.Value) *word {\n220\t\tif rendered == v.String() || !shellName.MatchString(v.Ref().Name) {\n221\t\t\treturn w.literal(rendered)\n222\t\t}\n223\t\n224\t\tw.parts = append(w.parts, part{text: rendered, expand: true})\n225\t\n226\t\treturn w\n227\t}\n228\t\n229\t// plain returns the word's text with no quoting, for the display fields that\n230\t// are read rather than run.\n231\tfunc (w *word) plain() string {\n232\t\tvar b strings.Builder\n233\t\tfor _, p := range w.parts {\n234\t\t\tb.WriteString(p.text)\n235\t\t}\n236\t\n237\t\treturn b.String()\n238\t}\n239\t\n240\t// String returns the word quoted for a shell.\n241\tfunc (w *word) String() string {\n242\t\texpands := false\n243\t\tfor _, p := range w.parts {\n244\t\t\tif p.expand {\n245\t\t\t\texpands = true\n246\t\t\t\tbreak\n247\t\t\t}\n248\t\t}\n249\t\n250\t\tif !expands {\n251\t\t\treturn \"'\" + strings.ReplaceAll(w.plain(), \"'\", `'\\''`) + \"'\"\n252\t\t}\n253\t\n254\t\tvar b strings.Builder\n255\t\tb.WriteByte('\"')\n256\t\tfor _, p := range w.parts {\n257\t\t\tif p.expand {\n258\t\t\t\tb.WriteString(p.text)\n259\t\t\t\tcontinue\n260\t\t\t}\n261\t\t\tb.WriteString(escapeInDoubleQuotes(p.text))\n262\t\t}\n263\t\tb.WriteByte('\"')\n264\t\n265\t\treturn b.String()\n266\t}\n267\t\n268\t// doubleQuoted escapes the characters a shell still interprets inside double\n269\t// quotes: command substitution, variable expansion, the quote itself and the\n270\t// escape.\n271\tvar doubleQuoted = strings.NewReplacer(\n272\t\t`\\`, `\\\\`,\n273\t\t`\"`, `\\\"`,\n274\t\t\"`\", \"\\\\`\",\n275\t\t`$`, `\\$`,\n276\t)\n277\t\n278\tfunc escapeInDoubleQuotes(s string) string { return doubleQuoted.Replace(s) }\n279\t"
      }
    ]
  },
