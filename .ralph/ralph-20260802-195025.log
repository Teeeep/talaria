        "type": "tool_result",
        "content": "1\t# Build, lint and test on every push and pull request.\n2\t#\n3\t# The commands below are the ones recorded in .ralph/stack.json, verbatim;\n4\t# internal/ci/workflow_test.go fails if this file drifts from them. Running the\n5\t# whole suite is what makes internal/canary a build gate, as DESIGN.md §5a\n6\t# requires: a redaction regression fails CI rather than waiting for someone to\n7\t# remember the suite exists.\n8\t#\n9\t# curl is preinstalled on ubuntu-latest and is well above the 7.70 floor, so\n10\t# there is no install step; internal/curl's preflight covers hosts where it is\n11\t# missing or too old.\n12\tname: CI\n13\t\n14\ton:\n15\t  push:\n16\t    branches: [main]\n17\t  pull_request:\n18\t\n19\tpermissions:\n20\t  contents: read\n21\t\n22\tjobs:\n23\t  build:\n24\t    runs-on: ubuntu-latest\n25\t    steps:\n26\t      - uses: actions/checkout@v4\n27\t\n28\t      - uses: actions/setup-go@v5\n29\t        with:\n30\t          go-version: \"1.26.0\"\n31\t\n32\t      - name: Build\n33\t        run: go build ./...\n34\t\n35\t      - name: Lint\n36\t        run: 'test -z \"$(gofmt -l .)\" && go vet ./...'\n37\t\n38\t      - name: Test\n39\t        run: go test ./...\n40\t"
      }
    ]
