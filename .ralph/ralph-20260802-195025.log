    "content": [
      {
        "tool_use_id": "toolu_01WLjvTiAYhwNeD9kWcY46QG",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"strings\"\n5\t\n6\t\t\"github.com/spf13/cobra\"\n7\t\n8\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n9\t\t\"github.com/Teeeep/talaria/internal/config\"\n10\t\t\"github.com/Teeeep/talaria/internal/operation\"\n11\t\t\"github.com/Teeeep/talaria/internal/output\"\n12\t)\n13\t\n14\t// authView is the JSON payload: one entry per security scheme the spec\n15\t// declares and talaria can satisfy.\n16\ttype authView struct {\n17\t\tSchemes []authScheme `json:\"schemes\"`\n18\t}\n19\t\n20\t// authScheme is DESIGN.md §4's object, field for field. The source is a *name* —\n21\t// `env:TALARIA_AUTH_BEARER` — because that is the whole of what an agent needs\n22\t// and the whole of what it may learn: it turns the name into \"export this and\n23\t// retry\" without ever holding the value.\n24\ttype authScheme struct {\n25\t\tScheme  string `json:\"scheme\"`\n26\t\tSource  string `json:\"source\"`\n27\t\tPresent bool   `json:\"present\"`\n28\t}\n29\t\n30\tfunc newAuthCmd() *cobra.Command {\n31\t\tcmd := &cobra.Command{\n32\t\t\tUse:   \"auth\",\n33\t\t\tShort: \"Inspect the credentials a spec's security schemes need\",\n34\t\t}\n35\t\n36\t\tcmd.AddCommand(newAuthCheckCmd())\n37\t\n38\t\treturn cmd\n39\t}\n40\t\n41\tfunc newAuthCheckCmd() *cobra.Command {\n42\t\treturn &cobra.Command{\n43\t\t\tUse:   \"check [spec]\",\n44\t\t\tShort: \"Report which security schemes have a credential, without reading one\",\n45\t\t\tLong: \"Answer, for each of a spec's security schemes, whether a credential is\\n\" +\n46\t\t\t\t\"present and which environment variable it comes from. Values are never\\n\" +\n47\t\t\t\t\"read, so this is how an agent diagnoses a broken auth setup blind. It\\n\" +\n48\t\t\t\t\"exits 5 when an operation has no credential to authenticate it with.\",\n49\t\t\tArgs: usageArgs(cobra.MaximumNArgs(1)),\n50\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n51\t\t\t\tformat, err := resolveFormat(cmd)\n52\t\t\t\tif err != nil {\n53\t\t\t\t\treturn err\n54\t\t\t\t}\n55\t\n56\t\t\t\tdoc, index, err := loadSpec(cmd, args)\n57\t\t\t\tif err != nil {\n58\t\t\t\t\treturn err\n59\t\t\t\t}\n60\t\n61\t\t\t\tcfg, err := config.Load(\"\")\n62\t\t\t\tif err != nil {\n63\t\t\t\t\treturn err\n64\t\t\t\t}\n65\t\n66\t\t\t\tprof, err := selectProfile(cmd, cfg)\n67\t\t\t\tif err != nil {\n68\t\t\t\t\treturn err\n69\t\t\t\t}\n70\t\n71\t\t\t\tcreds, err := config.Schemes(doc, prof)\n72\t\t\t\tif err != nil {\n73\t\t\t\t\treturn err\n74\t\t\t\t}\n75\t\n76\t\t\t\tif err := output.New(format, cmd.OutOrStdout()).Render(authPayload(creds)); err != nil {\n77\t\t\t\t\treturn err\n78\t\t\t\t}\n79\t\n80\t\t\t\t// The report is printed before the verdict, and whatever the verdict\n81\t\t\t\t// is: the exit code says \"act on this\", and the body says what to act\n82\t\t\t\t// on. Failing first would leave an agent a code 5 and nothing to read.\n83\t\t\t\treturn unsatisfied(index.Operations(), creds)\n84\t\t\t},\n85\t\t}\n86\t}\n87\t\n88\tfunc authPayload(creds []config.Credential) output.Payload {\n89\t\tview := authView{Schemes: make([]authScheme, 0, len(creds))}\n90\t\trows := make([][]string, 0, len(creds))\n91\t\n92\t\tfor _, cred := range creds {\n93\t\t\tpresent := cred.Present()\n94\t\t\tview.Schemes = append(view.Schemes, authScheme{\n95\t\t\t\tScheme:  cred.Scheme,\n96\t\t\t\tSource:  cred.Ref.Location(),\n97\t\t\t\tPresent: present,\n98\t\t\t})\n99\t\t\trows = append(rows, []string{cred.Scheme, cred.Ref.Location(), presenceLabel(present)})\n100\t\t}\n101\t\n102\t\treturn output.Payload{Data: view, Table: output.Table{Rows: rows}}\n103\t}\n104\t\n105\t// presenceLabel is the pretty and TSV form of the present field. The words name\n106\t// the two states a reader acts on, and \"missing\" is the one to go export.\n107\tfunc presenceLabel(present bool) string {\n108\t\tif present {\n109\t\t\treturn \"present\"\n110\t\t}\n111\t\n112\t\treturn \"missing\"\n113\t}\n114\t\n115\t// unsatisfied returns the exit-5 error naming the credentials that stand\n116\t// between the caller and some operation, or nil when every operation in the\n117\t// spec can be authenticated.\n118\tfunc unsatisfied(ops []operation.Operation, creds []config.Credential) error {\n119\t\tbyName := make(map[string]config.Credential, len(creds))\n120\t\tfor _, cred := range creds {\n121\t\t\tbyName[cred.Scheme] = cred\n122\t\t}\n123\t\n124\t\t// creds is already sorted by scheme name, so walking it to collect the\n125\t\t// blocking ones keeps the message's order stable too.\n126\t\tblocking := map[string]bool{}\n127\t\tfor _, op := range ops {\n128\t\t\tif satisfied(op, byName) {\n129\t\t\t\tcontinue\n130\t\t\t}\n131\t\n132\t\t\tfor _, req := range op.Security {\n133\t\t\t\tfor _, want := range req.Schemes {\n134\t\t\t\t\tif cred, ok := byName[want.Name]; ok && !cred.Present() {\n135\t\t\t\t\t\tblocking[want.Name] = true\n136\t\t\t\t\t}\n137\t\t\t\t}\n138\t\t\t}\n139\t\t}\n140\t\tif len(blocking) == 0 {\n141\t\t\treturn nil\n142\t\t}\n143\t\n144\t\tvar parts []string\n145\t\tfor _, cred := range creds {\n146\t\t\tif blocking[cred.Scheme] {\n147\t\t\t\tparts = append(parts, cred.Scheme+\" (set \"+cred.Ref.Symbolic()+\")\")\n148\t\t\t}\n149\t\t}\n150\t\n151\t\tif len(parts) == 1 {\n152\t\t\treturn clierr.CredentialMissing(\"no credential for security scheme %s\", parts[0])\n153\t\t}\n154\t\n155\t\treturn clierr.CredentialMissing(\"no credential for security schemes %s\", strings.Join(parts, \", \"))\n156\t}\n157\t\n158\t// satisfied reports whether op has an alternative talaria can authenticate with\n159\t// the credentials that are actually set.\n160\t//\n161\t// A spec may offer alternatives and any one of them is enough, so a bearer\n162\t// token alone satisfies an operation that accepts either it or an API key. An\n163\t// alternative naming a scheme talaria cannot supply — OAuth2 — is skipped\n164\t// rather than counted against the caller: v1's position is that you bring your\n165\t// own token for those, and there is no variable to report missing (§5 Auth).\n166\tfunc satisfied(op operation.Operation, byName map[string]config.Credential) bool {\n167\t\tusable := false\n168\t\n169\t\tfor _, req := range op.Security {\n170\t\t\t// An empty requirement is the spec saying authentication is optional here.\n171\t\t\tif len(req.Schemes) == 0 {\n172\t\t\t\treturn true\n173\t\t\t}\n174\t\n175\t\t\tknown, present := true, true\n176\t\t\tfor _, want := range req.Schemes {\n177\t\t\t\tcred, ok := byName[want.Name]\n178\t\t\t\tswitch {\n179\t\t\t\tcase !ok:\n180\t\t\t\t\tknown = false\n181\t\t\t\tcase !cred.Present():\n182\t\t\t\t\tpresent = false\n183\t\t\t\t}\n184\t\t\t}\n185\t\n186\t\t\tif !known {\n187\t\t\t\tcontinue\n188\t\t\t}\n189\t\t\tusable = true\n190\t\n191\t\t\tif present {\n192\t\t\t\treturn true\n193\t\t\t}\n194\t\t}\n195\t\n196\t\t// No usable alternative means nothing talaria could have satisfied, which\n197\t\t// includes the common case of an operation with no security at all.\n198\t\treturn !usable\n199\t}\n200\t"
      }
