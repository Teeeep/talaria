        "content": "openapi: 3.0.3\ninfo:\n  title: Call Fixture\n  version: 1.0.0\nservers:\n  # Deliberately unroutable: a dry-run that reached the network would hang or\n  # fail here rather than quietly passing.\n  - url: https://api.invalid/v1\ncomponents:\n  securitySchemes:\n    bearerAuth:\n      type: http\n      scheme: bearer\n    petKey:\n      type: apiKey\n      in: query\n      name: api_key\n# Document-level security, so every operation below is authenticated unless it\n# says otherwise.\nsecurity:\n  - bearerAuth: []\npaths:\n  /pets/{petId}:\n    get:\n      operationId: getPet\n      summary: Fetch one pet\n      parameters:\n        - name: petId\n          in: path\n          required: true\n          schema:\n            type: string\n        - name: verbose\n          in: query\n          schema:\n            type: boolean\n      responses:\n        \"200\":\n          description: A pet\n  /pets:\n    post:\n      operationId: createPet\n      summary: Create a pet\n      responses:\n        \"201\":\n          description: Created\n    delete:\n      operationId: deleteAllPets\n      summary: Delete every pet\n      responses:\n        \"204\":\n          description: Gone\n  /public:\n    get:\n      operationId: getPublic\n      summary: An unauthenticated endpoint\n      security: []\n      responses:\n        \"200\":\n          description: OK\n  /keyed:\n    get:\n      operationId: getKeyed\n      summary: Authenticated with a query-string API key\n      security:\n        - petKey: []\n      responses:\n        \"200\":\n          description: OK\n=== RUN.YAML ===\nopenapi: 3.0.3\ninfo:\n  title: Run Fixture\n  version: 1.0.0\nservers:\n  # Deliberately unroutable: every test passes --base-url, so a request that\n  # ignored it would fail here rather than quietly reaching the network.\n  - url: https://api.invalid/v1\ncomponents:\n  schemas:\n    Pet:\n      type: object\n      properties:\n        id:\n          type: string\n        name:\n          type: string\n  securitySchemes:\n    bearerAuth:\n      type: http\n      scheme: bearer\n    petKey:\n      type: apiKey\n      in: header\n      name: X-Pet-Key\n# Document-level security, so every operation below needs the bearer token\n# unless it names its own scheme.\nsecurity:\n  - bearerAuth: []\npaths:\n  /pets:\n    get:\n      operationId: listPets\n      summary: List pets\n      tags: [pets]\n      responses:\n        \"200\":\n          description: A pet\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"\n    post:\n      operationId: createPet\n      summary: Create a pet\n      tags: [pets]\n      requestBody:\n        required: true\n        content:\n          application/json:\n            # No example anywhere: the body comes from a fixture when one is\n            # supplied and from generation otherwise, which is what the fixture\n            # tests need to tell apart.\n            schema:\n              type: object\n              required: [name]\n              properties:\n                name:\n                  type: string\n      responses:\n        \"201\":\n          description: Created\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"\n  /pets/{petId}:\n    get:\n      operationId: getPet\n      summary: Fetch one pet\n      tags: [pets]\n      parameters:\n        - name: petId\n          in: path\n          required: true\n          schema:\n            type: string\n            example: \"42\"\n      responses:\n        \"200\":\n          description: A pet\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"\n  /status:\n    get:\n      operationId: getStatus\n      summary: Service status\n      tags: [ops]\n      responses:\n        \"200\":\n          description: A pet-shaped status\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"\n  /reports/{reportId}:\n    get:\n      operationId: getReport\n      summary: Fetch one report\n      tags: [reports]\n      parameters:\n        # A content-typed parameter has no schema, so there is nothing to\n        # generate from and nothing to fill the path template with.\n        - name: reportId\n          in: path\n          required: true\n          content:\n            application/json:\n              schema:\n                type: string\n      responses:\n        \"200\":\n          description: A pet\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"\n  /secure:\n    get:\n      operationId: getSecure\n      summary: Needs its own API key\n      tags: [secure]\n      security:\n        - petKey: []\n      responses:\n        \"200\":\n          description: A pet\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"\n  /boom:\n    get:\n      operationId: getBoom\n      summary: Always fails\n      tags: [ops]\n      responses:\n        \"200\":\n          description: A pet\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"",
