        "content": "1\tpackage request\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"fmt\"\n6\t\t\"net/url\"\n7\t\t\"path/filepath\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t\n11\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n12\t\t\"github.com/Teeeep/talaria/internal/config\"\n13\t\t\"github.com/Teeeep/talaria/internal/operation\"\n14\t\t\"github.com/Teeeep/talaria/internal/secret\"\n15\t\t\"github.com/Teeeep/talaria/internal/spec\"\n16\t)\n17\t\n18\t// canary is the credential value the firewall must never let out. Every test\n19\t// that touches auth sets it, so \"the canary is absent\" is the assertion that no\n20\t// value escaped the Request.\n21\tconst canary = \"s3cr3t-canary-value\"\n22\t\n23\t// fixture loads the request fixture and returns the named operation with the\n24\t// document it came from.\n25\tfunc fixture(t *testing.T, id string) (operation.Operation, *spec.Document) {\n26\t\tt.Helper()\n27\t\n28\t\tdoc, err := spec.LoadFile(filepath.Join(\"testdata\", \"request.yaml\"))\n29\t\tif err != nil {\n30\t\t\tt.Fatalf(\"LoadFile(request.yaml): %v\", err)\n31\t\t}\n32\t\n33\t\tfor _, op := range operation.Extract(doc) {\n34\t\t\tif op.ID == id {\n35\t\t\t\treturn op, doc\n36\t\t\t}\n37\t\t}\n38\t\n39\t\tt.Fatalf(\"fixture has no operation %q\", id)\n40\t\treturn operation.Operation{}, nil\n41\t}\n42\t\n43\t// inputs is the common case: an operation from the fixture, no profile, no\n44\t// credentials. Tests layer their own flags on top.\n45\tfunc inputs(t *testing.T, id string) Inputs {\n46\t\tt.Helper()\n47\t\n48\t\top, doc := fixture(t, id)\n49\t\treturn Inputs{Op: op, Doc: doc}\n50\t}\n51\t\n52\tfunc build(t *testing.T, in Inputs) *Request {\n53\t\tt.Helper()\n54\t\n55\t\treq, err := Build(in)\n56\t\tif err != nil {\n57\t\t\tt.Fatalf(\"Build: %v\", err)\n58\t\t}\n59\t\n60\t\treturn req\n61\t}\n62\t\n63\t// buildErr asserts Build failed with a usage error (exit 2) and returns it, so\n64\t// each test can go on to assert what the message has to