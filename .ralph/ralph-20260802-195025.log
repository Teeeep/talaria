        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"io\"\n6\t\t\"net/http\"\n7\t\t\"net/http/httptest\"\n8\t\t\"os/exec\"\n9\t\t\"regexp\"\n10\t\t\"strings\"\n11\t\t\"testing\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n15\t\t\"github.com/Teeeep/talaria/internal/request\"\n16\t\t\"github.com/Teeeep/talaria/internal/secret\"\n17\t)\n18\t\n19\t// requireCurl skips a test that needs the real binary. curl is talaria's\n20\t// execution engine (§3.4), so these tests drive it rather than a stub: a fake\n21\t// would only prove the parser agrees with itself.\n22\tfunc requireCurl(t *testing.T) {\n23\t\tt.Helper()\n24\t\n25\t\tif _, err := exec.LookPath(\"curl\"); err != nil {\n26\t\t\tt.Skip(\"curl is not installed\")\n27\t\t}\n28\t}\n29\t\n30\t// getFrom returns a GET request against a test server's URL.\n31\tfunc getFrom(base string) *request.Request {\n32\t\treturn &request.Request{Method: http.MethodGet, BaseURL: base, Path: \"/pets\"}\n33\t}\n34\t\n35\t// serve starts a test server and stops it when the test ends.\n36\tfunc serve(t *testing.T, handler http.HandlerFunc) *httptest.Server {\n37\t\tt.Helper()\n38\t\n39\t\tserver := httptest.NewServer(handler)\n40\t\tt.Cleanup(server.Close)\n41\t\n42\t\treturn server\n43\t}\n44\t\n45\t// requireCLIError unwraps err to the *clierr.Error the exit-code contract is\n46\t// carried on, failing the test if it is not one.\n47\tfunc requireCLIError(t *testing.T, err error) *clierr.Error {\n48\t\tt.Helper()\n49\t\n50\t\tif err == nil {\n51\t\t\tt.Fatal(\"Execute() error = nil, want a failure\")\n52\t\t}\n53\t\n54\t\tvar cerr *clierr.Error\n55\t\tif !errors.As(err, &cerr) {\n56\t\t\tt.Fatalf(\"Execute() error = %T (%v), want *clierr.Error\", err, err)\n57\t\t}\n58\t\n59\t\treturn cerr\n60\t}\n61\t\n62\tfunc TestExecuteReturnsStatusBodyHeadersAndTiming(t *testing.T) {\n63\t\trequireCurl(t)\n64\t\n65\t\tserver := serve(t, func(w http.ResponseWriter, _ *http.Request) {\n66\t\t\t// The sleep is what makes timing observable: a loopback round trip can\n67\t\t\t// otherwise finish inside curl's reporting resolution and round to zero,\n68\t\t\t// which would make the assertion below a coin flip rather than a test.\n69\t\t\ttime.Sleep(15 * time.Millisecond)\n70\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n71\t\t\tw.Header().Set(\"X-Request-Id\", \"req-42\")\n72\t\t\tw.WriteHeader(http.StatusOK)\n73\t\t\tio.WriteString(w, `{\"id\":1,\"name\":\"rex\"}`) //nolint:errcheck // Test server.\n74\t\t})\n75\t\n76\t\tresp, err := Execute(getFrom(server.URL))\n77\t\tif err != nil {\n78\t\t\tt.Fatalf(\"Execute() error = %v\", err)\n79\t\t}\n80\t\n81\t\tif resp.Status != http.StatusOK {\n82\t\t\tt.Errorf(\"Status = %d, want 200\", resp.Status)\n83\t\t}\n84\t\tif got, want := string(resp.Body), `{\"id\":1,\"name\":\"rex\"}`; got != want {\n85\t\t\tt.Errorf(\"Body = %q, want %q\", got, want)\n86\t\t}\n87\t\tif got := resp.Headers.Get(\"X-Request-Id\"); got != \"req-42\" {\n88\t\t\tt.Errorf(\"Headers[X-Request-Id] = %q, want %q\", got, \"req-42\")\n89\t\t}\n90\t\tif got := resp.Headers.Get(\"Content-Type\"); got != \"application/json\" {\n91\t\t\tt.Errorf(\"Headers[Content-Type] = %q, want %q\", got, \"application/json\")\n92\t\t}\n93\t\tif resp.TimingMS <= 0 {\n94\t\t\tt.Errorf(\"TimingMS = %d, want > 0\", resp.TimingMS)\n95\t\t}\n96\t}\n97\t\n98\tfunc TestExecuteKeepsBodyAndMetadataOnSeparateChannels(t *testing.T) {\n99\t\trequireCurl(t)\n100\t\n101\t\t// A response body that impersonates curl's own --write-out payload, closing\n102\t\t// braces and all. If the body ever shared a stream with the metadata, the\n103\t\t// status below would come back as 599 rather than 200.\n104\t\tbody := `{\"http_code\":599,\"time_total\":42.0,\"note\":\"} not the real metadata {\"}`\n105\t\tserver := serve(t, func(w http.ResponseWriter, _ *http.Request) {\n106\t\t\tw.WriteHeader(http.StatusOK)\n107\t\t\tio.WriteString(w, body) //nolint:errcheck // Test server.\n108\t\t})\n109\t\n110\t\tresp, err := Execute(getFrom(server.URL))\n111\t\tif err != nil {\n112\t\t\tt.Fatalf(\"Execute() error = %v\", err)\n113\t\t}\n114\t\n115\t\tif resp.Status != http.StatusOK {\n116\t\t\tt.Errorf(\"Status = %d, want 200 — the body was parsed as metadata\", resp.Status)\n117\t\t}\n118\t\tif string(resp.Body) != body {\n119\t\t\tt.Errorf(\"Body = %q, want %q\", resp.Body, body)\n120\t\t}\n121\t\tif resp.TimingMS > 1000 {\n122\t\t\tt.Errorf(\"TimingMS = %d, want the real timing, not the body's 42s\", resp.TimingMS)\n123\t\t}\n124\t}\n125\t\n126\tfunc TestExecuteCompletesAHEADRequest(t *testing.T) {\n127\t\trequireCurl(t)\n128\t\n129\t\t// A compliant server answers HEAD with the Content-Length the GET would have\n130\t\t// carried and no body at all. `-X HEAD` makes curl wait for those bytes\n131\t\t// forever (or exit 18 when the connection closes); `--head` is what makes\n132\t\t// this return. There is no max-time yet, so the deadline lives here rather\n133\t\t// than letting a regression hang the suite.\n134\t\tserver := serve(t, func(w http.ResponseWriter, _ *http.Request) {\n135\t\t\tw.Header().Set(\"Content-Length\", \"42\")\n136\t\t\tw.Header().Set(\"X-Request-Id\", \"req-42\")\n137\t\t\tw.WriteHeader(http.StatusOK)\n138\t\t})\n139\t\n140\t\treq := getFrom(server.URL)\n141\t\treq.Method = http.MethodHead\n142\t\n143\t\ttype outcome struct {\n144\t\t\tresp *Response\n145\t\t\terr  error\n146\t\t}\n147\t\tdone := make(chan outcome, 1)\n148\t\tgo func() {\n149\t\t\tresp, err := Execute(req)\n150\t\t\tdone <- outcome{resp, err}\n151\t\t}()\n152\t\n153\t\tselect {\n154\t\tcase got := <-done:\n155\t\t\tif got.err != nil {\n156\t\t\t\tt.Fatalf(\"Execute() error = %v\", got.err)\n157\t\t\t}\n158\t\t\tif got.resp.Status != http.StatusOK {\n159\t\t\t\tt.Errorf(\"Status = %d, want 200\", got.resp.Status)\n160\t\t\t}\n161\t\t\tif id := got.resp.Headers.Get(\"X-Request-Id\"); id != \"req-42\" {\n162\t\t\t\tt.Errorf(\"Headers[X-Request-Id] = %q, want %q\", id, \"req-42\")\n163\t\t\t}\n164\t\t\t// The header block goes to the dump, not to the body: a HEAD response has\n165\t\t\t// no body, and reporting the headers as one would be a fabricated body.\n166\t\t\tif len(got.resp.Body) != 0 {\n167\t\t\t\tt.Errorf(\"Body = %q, want empty for a HEAD response\", got.resp.Body)\n168\t\t\t}\n169\t\tcase <-time.After(10 * time.Second):\n170\t\t\tt.Fatal(\"Execute() on HEAD did not return in 10s — curl is waiting for a body the server never sends\")\n171\t\t}\n172\t}\n173\t\n174\tfunc TestExecuteReportsAConnectionFailureAsRequestFailed(t *testing.T) {\n175\t\trequireCurl(t)\n176\t\n177\t\t// A server that has been stopped leaves a port nothing is listening on,\n178\t\t// without this test having to guess an unused one.\n179\t\tserver := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))\n180\t\tbase := server.URL\n181\t\tserver.Close()\n182\t\n183\t\t_, err := Execute(getFrom(base))\n184\t\n185\t\tcerr := requireCLIError(t, err)\n186\t\tif cerr.Code != clierr.CodeRequestFailed {\n187\t\t\tt.Errorf(\"Code = %d, want %d\", cerr.Code, clierr.CodeRequestFailed)\n188\t\t}\n189\t\t// The exact status is curl's to choose (7 for a refused connection); that one\n190\t\t// is reported at all is what an operator needs to look it up.\n191\t\tif !regexp.MustCompile(`curl exited [1-9][0-9]*`).MatchString(cerr.Message) {\n192\t\t\tt.Errorf(\"Message = %q, want curl's non-zero exit status in it\", cerr.Message)\n193\t\t}\n194\t}\n195\t\n196\tfunc TestExecuteTreatsHTTPErrorsAsSuccessfulObservations(t *testing.T) {\n197\t\trequireCurl(t)\n198\t\n199\t\t// §4: a 404 is a successful observation, not a failed request. Only\n200\t\t// --fail-on-error changes that, and it is not this layer's decision.\n201\t\tfor _, status := range []int{http.StatusNotFound, http.StatusInternalServerError} {\n202\t\t\tt.Run(http.StatusText(status), func(t *testing.T) {\n203\t\t\t\tserver := serve(t, func(w http.ResponseWriter, _ *http.Request) {\n204\t\t\t\t\tw.WriteHeader(status)\n205\t\t\t\t\tio.WriteString(w, `{\"error\":\"nope\"}`) //nolint:errcheck // Test server.\n206\t\t\t\t})\n207\t\n208\t\t\t\tresp, err := Execute(getFrom(server.URL))\n209\t\t\t\tif err != nil {\n210\t\t\t\t\tt.Fatalf(\"Execute() error = %v, want nil for HTTP %d\", err, status)\n211\t\t\t\t}\n212\t\t\t\tif resp.Status != status {\n213\t\t\t\t\tt.Errorf(\"Status = %d, want %d\", resp.Status, status)\n214\t\t\t\t}\n215\t\t\t\tif string(resp.Body) != `{\"error\":\"nope\"}` {\n216\t\t\t\t\tt.Errorf(\"Body = %q, want the error body\", resp.Body)\n217\t\t\t\t}\n218\t\t\t})\n219\t\t}\n220\t}\n221\t\n222\tfunc TestCheckVersionEnforcesTheFloor(t *testing.T) {\n223\t\ttests := []struct {\n224\t\t\tname    string\n225\t\t\toutput  string\n226\t\t\twantErr bool\n227\t\t}{\n228\t\t\t{\n229\t\t\t\tname:    \"below the floor\",\n230\t\t\t\toutput:  \"curl 7.69.1 (x86_64-pc-linux-gnu) libcurl/7.69.1 OpenSSL/1.1.1\",\n231\t\t\t\twantErr: true,\n232\t\t\t},\n233\t\t\t{\n234\t\t\t\tname:   \"exactly the floor\",\n235\t\t\t\toutput: \"curl 7.70.0 (x86_64-pc-linux-gnu) libcurl/7.70.0 OpenSSL/1.1.1\",\n236\t\t\t},\n237\t\t\t{\n238\t\t\t\tname:   \"above the floor\",\n239\t\t\t\toutput: \"curl 8.14.1 (x86_64-pc-linux-gnu) libcurl/8.14.1 OpenSSL/3.5.0\\nRelease-Date: 2025-06-04\",\n240\t\t\t},\n241\t\t\t{\n242\t\t\t\tname:   \"a newer major with a lower minor\",\n243\t\t\t\toutput: \"curl 8.0.1 (x86_64-pc-linux-gnu) libcurl/8.0.1\",\n244\t\t\t},\n245\t\t\t{\n246\t\t\t\tname:    \"unparseable\",\n247\t\t\t\toutput:  \"not curl at all\",\n248\t\t\t\twantErr: true,\n249\t\t\t},\n250\t\t}\n251\t\n252\t\tfor _, tt := range tests {\n253\t\t\tt.Run(tt.name, func(t *testing.T) {\n254\t\t\t\terr := checkVersion(tt.output)\n255\t\t\t\tif (err != nil) != tt.wantErr {\n256\t\t\t\t\tt.Fatalf(\"checkVersion() error = %v, wantErr = %v\", err, tt.wantErr)\n257\t\t\t\t}\n258\t\t\t\tif err != nil && !strings.Contains(err.Error(), minVersion) {\n259\t\t\t\t\tt.Errorf(\"error = %q, want the %s floor named in it\", err, minVersion)\n260\t\t\t\t}\n261\t\t\t})\n262\t\t}\n263\t}\n264\t\n265\tfunc TestParseHeadersTakesTheLastBlock(t *testing.T) {\n266\t\t// A redirect leaves the intermediate response's headers in front of the real\n267\t\t// one. Taking the last block is what keeps a stale Location or a 100 Continue\n268\t\t// out of the reported response.\n269\t\tdump := \"HTTP/1.1 301 Moved Permanently\\r\\n\" +\n270\t\t\t\"Location: /pets/42\\r\\n\" +\n271\t\t\t\"X-Stale: yes\\r\\n\" +\n272\t\t\t\"\\r\\n\" +\n273\t\t\t\"HTTP/1.1 200 OK\\r\\n\" +\n274\t\t\t\"Content-Type: application/json\\r\\n\" +\n275\t\t\t\"X-Fresh: yes\\r\\n\" +\n276\t\t\t\"\\r\\n\"\n277\t\n278\t\theaders := parseHeaders([]byte(dump))\n279\t\n280\t\tif got := headers.Get(\"X-Fresh\"); got != \"yes\" {\n281\t\t\tt.Errorf(\"X-Fresh = %q, want %q\", got, \"yes\")\n282\t\t}\n283\t\tif got := headers.Get(\"X-Stale\"); got != \"\" {\n284\t\t\tt.Errorf(\"X-Stale = %q, want it dropped with the redirect block\", got)\n285\t\t}\n286\t\tif got := headers.Get(\"Location\"); got != \"\" {\n287\t\t\tt.Errorf(\"Location = %q, want it dropped with the redirect block\", got)\n288\t\t}\n289\t}\n290\t\n291\tfunc TestRequestFailedRedactsCredentialsInCurlStderr(t *testing.T) {\n292\t\tconst canary = \"canary-9f3a-not-in-any-output\"\n293\t\tt.Setenv(\"TALARIA_AUTH_APIKEY\", canary)\n294\t\n295\t\treq := &request.Request{\n296\t\t\tMethod:  http.MethodGet,\n297\t\t\tBaseURL: \"https://api.example.com\",\n298\t\t\tPath:    \"/pets\",\n299\t\t\tQuery: []request.Pair{{\n300\t\t\t\tName:  \"api_key\",\n301\t\t\t\tValue: request.Secret(secret.Env(\"TALARIA_AUTH_APIKEY\"), request.EncodeRaw),\n302\t\t\t}},\n303\t\t}\n304\t\t// curl echoes the URL it was given into several of its errors, and the URL is\n305\t\t// where an API-key credential lives. §5a: errors are built from the redacted\n306\t\t// representation.\n307\t\tstderr := \"curl: (60) SSL certificate problem for https://api.example.com/pets?api_key=\" + canary\n308\t\n309\t\terr := requestFailed(req, 60, stderr)\n310\t\n311\t\tif strings.Contains(err.Error(), canary) {\n312\t\t\tt.Fatalf(\"error leaked the credential: %q\", err)\n313\t\t}\n314\t\tif !strings.Contains(err.Error(), \"<redacted:env:TALARIA_AUTH_APIKEY>\") {\n315\t\t\tt.Errorf(\"error = %q, want the credential shown as its redacted ref\", err)\n316\t\t}\n317\t\tif !strings.Contains(err.Error(), \"curl exited 60\") {\n318\t\t\tt.Errorf(\"error = %q, want curl's exit status in it\", err)\n319\t\t}\n320\t}\n321\t"
      }
