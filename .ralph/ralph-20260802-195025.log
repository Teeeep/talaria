5-\t\t\t\t}\n576-\n577-\t\t\t\tvar surfaces []canary.Surface\n578-\t\t\t\tfor _, res := range runs {\n579-\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n580-\t\t\t\t}\n581-\n582-\t\t\t\tassertNoLeak(t, value, append(surfaces, h.written()...))\n583-\t\t\t})\n584-\t\t}\n585-\t}\n586-}\n587-\n588-// TestAnUnconfiguredResponseBodySecretIsNotRedacted documents the boundary\n589-// rather than pretending it is elsewhere. §5a redacts response headers and the\n590-// RFC 6749 token fields by name; a secret under an API-specific name is the\n591-// known uncovered threat, because talaria cannot tell a credential from any\n592-// other string by looking at it.\n593-//\n594-// If this ever fails because the value was redacted, the boundary moved and the\n595-// documentation — AGENT.md, DESIGN.md §5a — moves with it.\n596-func TestAnUnconfiguredResponseBodySecretIsNotRedacted(t *testing.T) {\n597-\tt.Parallel()\n598-\n599-\tvalue := canary.Value(\"response\")\n600-\th := newHarness(t, nil)\n601-\tsrv := newServer(t, `{\"access_token\":\"issued\",\"data\":{\"session\":\"`+value+`\"}}`)\n602-\n603-\tres := h.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", \"json\")\n604-\tif !strings.Contains(res.stdout, value) {\n605-\t\tt.Errorf(\"an unconfigured response body secret was redacted; the documented boundary has moved:\\n%s\", res.stdout)\n606-\t}\n607-\t// The names talaria *can* recognise are covered without configuration, which\n608-\t// is what makes the above a boundary rather than an absence of redaction.\n609-\tif strings.Contains(res.stdout, `\"issued\"`) {\n610-\t\tt.Errorf(\"the built-in access_token body path was not redacted:\\n%s\", res.stdout)\n611-\t}\n612-\n613-\t// And the configured countermeasure closes the rest of the gap.\n614-\twriteConfig(t, h, \"redact:\\n  body-paths:\\n    - data.session\\n\")\n615-\n616-\tres = h.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", \"json\")\n617-\tif strings.Contains(res.stdout, value) {\n618-\t\tt.Errorf(\"redact.body-paths did not redact the configured path:\\n%s\", res.stdout)\n619-\t}\n620-}\n621-\n622-// TestNoCommandExposesAVerboseOrDebugFlag is §5a's \"no --verbose that bypasses\n623-// [redaction]\" in its strongest form: there is no such flag to bypass it.",
