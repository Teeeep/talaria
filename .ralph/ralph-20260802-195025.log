        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"encoding/xml\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"net/http/httptest\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t\t\"sync\"\n13\t\t\"testing\"\n14\t\n15\t\t\"github.com/Teeeep/talaria/internal/spec\"\n16\t)\n17\t\n18\t// runSpecFile is the fixture every test here drives: seven operations across\n19\t// four tags, one of which always 500s and one of which cannot be supplied with\n20\t// its path parameter.\n21\tconst runSpecFile = \"testdata/run.yaml\"\n22\t\n23\t// runResultJSON is one operation's line in the report.\n24\ttype runResultJSON struct {\n25\t\tOperationID string `json:\"operation_id\"`\n26\t\tMethod      string `json:\"method\"`\n27\t\tPath        string `json:\"path\"`\n28\t\tOutcome     string `json:\"outcome\"`\n29\t\tReason      string `json:\"reason\"`\n30\t\tStatus      int    `json:\"status\"`\n31\t\t// A pointer so an absent timing is distinguishable from a call to a local\n32\t\t// server that legitimately rounded to 0ms.\n33\t\tTimingMS   *int64 `json:\"timing_ms\"`\n34\t\tValidation *struct {\n35\t\t\tStatusDocumented bool `json:\"status_documented\"`\n36\t\t\tBodyValid        bool `json:\"body_valid\"`\n37\t\t\tErrors           []struct {\n38\t\t\t\tMessage string `json:\"message\"`\n39\t\t\t} `json:\"errors\"`\n40\t\t} `json:\"validation\"`\n41\t}\n42\t\n43\t// runJSON is the whole `run` envelope.\n44\ttype runJSON struct {\n45\t\tSchema  string          `json:\"schema\"`\n46\t\tResults []runResultJSON `json:\"results\"`\n47\t\tSummary struct {\n48\t\t\tTotal   int `json:\"total\"`\n49\t\t\tPassed  int `json:\"passed\"`\n50\t\t\tFailed  int `json:\"failed\"`\n51\t\t\tSkipped int `json:\"skipped\"`\n52\t\t} `json:\"summary\"`\n53\t}\n54\t\n55\t// runServer records every request it serves so a test can assert on what\n56\t// actually went out, and answers with a body the fixture spec documents.\n57\ttype runServer struct {\n58\t\t*httptest.Server\n59\t\n60\t\tmu       sync.Mutex\n61\t\trequests []recordedRequest\n62\t}\n63\t\n64\tfunc newRunServer(t *testing.T) *runServer {\n65\t\tt.Helper()\n66\t\n67\t\trs := &runServer{}\n68\t\trs.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n69\t\t\tbody, err := io.ReadAll(r.Body)\n70\t\t\tif err != nil {\n71\t\t\t\tt.Errorf(\"reading the request body: %v\", err)\n72\t\t\t}\n73\t\n74\t\t\trs.mu.Lock()\n75\t\t\trs.requests = append(rs.requests, recordedRequest{\n76\t\t\t\tMethod: r.Method,\n77\t\t\t\tPath:   r.URL.Path,\n78\t\t\t\tQuery:  r.URL.RawQuery,\n79\t\t\t\tHeader: r.Header.Clone(),\n80\t\t\t\tBody:   string(body),\n81\t\t\t})\n82\t\t\trs.mu.Unlock()\n83\t\n84\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n85\t\t\tswitch {\n86\t\t\tcase r.URL.Path == \"/boom\":\n87\t\t\t\tw.WriteHeader(http.StatusInternalServerError)\n88\t\t\t\t_, _ = io.WriteString(w, `{\"error\":\"boom\"}`)\n89\t\t\tcase r.Method == http.MethodPost:\n90\t\t\t\tw.WriteHeader(http.StatusCreated)\n91\t\t\t\t_, _ = io.WriteString(w, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n92\t\t\tdefault:\n93\t\t\t\tw.WriteHeader(http.StatusOK)\n94\t\t\t\t_, _ = io.WriteString(w, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n95\t\t\t}\n96\t\t}))\n97\t\tt.Cleanup(rs.Close)\n98\t\n99\t\treturn rs\n100\t}\n101\t\n102\tfunc (rs *runServer) received() []recordedRequest {\n103\t\trs.mu.Lock()\n104\t\tdefer rs.mu.Unlock()\n105\t\n106\t\treturn append([]recordedRequest(nil), rs.requests...)\n107\t}\n108\t\n109\t// paths is what the server was asked for, in order, as \"METHOD /path\".\n110\tfunc (rs *runServer) paths() []string {\n111\t\tvar out []string\n112\t\tfor _, req := range rs.received() {\n113\t\t\tout = append(out, req.Method+\" \"+req.Path)\n114\t\t}\n115\t\n116\t\treturn out\n117\t}\n118\t\n119\t// runRun executes `run` against a fresh, isolated history.\n120\tfunc runRun(t *testing.T, args ...string) (code int, stdout, stderr string) {\n121\t\tt.Helper()\n122\t\n123\t\treturn runRunIn(t, t.TempDir(), args...)\n124\t}\n125\t\n126\t// runRunIn is runRun with the state directory named, so a test can share one\n127\t// history between several commands.\n128\t//\n129\t// Credentials default to the canary, but one the test has already set — to the\n130\t// empty string, say — is left alone: that is how the missing-credential case is\n131\t// written.\n132\tfunc runRunIn(t *testing.T, stateDir string, args ...string) (code int, stdout, stderr string) {\n133\t\tt.Helper()\n134\t\tt.Setenv(spec.EnvSpec, \"\")\n135\t\tt.Setenv(\"XDG_STATE_HOME\", stateDir)\n136\t\tsetUnlessSet(t, \"TALARIA_AUTH_BEARER\", callCanary)\n137\t\tsetUnlessSet(t, \"TALARIA_AUTH_APIKEY_PETKEY\", callCanary)\n138\t\n139\t\tvar out, errOut strings.Builder\n140\t\tcode = run(append([]string{\"run\"}, args...), &out, &errOut)\n141\t\tstdout, stderr = out.String(), errOut.String()\n142\t\n143\t\tif strings.Contains(stdout, callCanary) {\n144\t\t\tt.Fatalf(\"run leaked the credential on stdout:\\n%s\", stdout)\n145\t\t}\n146\t\tif strings.Contains(stderr, callCanary) {\n147\t\t\tt.Fatalf(\"run leaked the credential on stderr:\\n%s\", stderr)\n148\t\t}\n149\t\n150\t\treturn code, stdout, stderr\n151\t}\n152\t\n153\tfunc setUnlessSet(t *testing.T, key, value string) {\n154\t\tt.Helper()\n155\t\n156\t\tif _, ok := os.LookupEnv(key); ok {\n157\t\t\treturn\n158\t\t}\n159\t\tt.Setenv(key, value)\n160\t}\n161\t\n162\tfunc decodeRun(t *testing.T, stdout string) runJSON {\n163\t\tt.Helper()\n164\t\n165\t\tvar got runJSON\n166\t\tif err := json.Unmarshal([]byte(stdout), &got); err != nil {\n167\t\t\tt.Fatalf(\"decoding %q: %v\", stdout, err)\n168\t\t}\n169\t\n170\t\treturn got\n171\t}\n172\t\n173\t// result finds one operation's line, failing the test when the report has none.\n174\tfunc (r runJSON) result(t *testing.T, id string) runResultJSON {\n175\t\tt.Helper()\n176\t\n177\t\tfor _, res := range r.Results {\n178\t\t\tif res.OperationID == id {\n179\t\t\t\treturn res\n180\t\t\t}\n181\t\t}\n182\t\n183\t\tt.Fatalf(\"no result for %s in %+v\", id, r.Results)\n184\t\n185\t\treturn runResultJSON{}\n186\t}\n187\t\n188\t// ids is every operation the report covered, in order.\n189\tfunc (r runJSON) ids() []string {\n190\t\tvar out []string\n191\t\tfor _, res := range r.Results {\n192\t\t\tout = append(out, res.OperationID)\n193\t\t}\n194\t\n195\t\treturn out\n196\t}\n197\t\n198\tfunc TestRunExecutesEveryReadOnlyOperation(t *testing.T) {\n199\t\tsrv := newRunServer(t)\n200\t"
