        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"errors\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"net/http/httptest\"\n9\t\t\"os\"\n10\t\t\"os/exec\"\n11\t\t\"path/filepath\"\n12\t\t\"regexp\"\n13\t\t\"strings\"\n14\t\t\"testing\"\n15\t\n16\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n17\t\t\"github.com/Teeeep/talaria/internal/request\"\n18\t\t\"github.com/Teeeep/talaria/internal/secret\"\n19\t)\n20\t\n21\t// buildConfig runs the builder and fails the test on error, for the cases whose\n22\t// subject is the document rather than the failure path.\n23\tfunc buildConfig(t *testing.T, req *request.Request, capture Capture) ([]byte, []string, func()) {\n24\t\tt.Helper()\n25\t\n26\t\tconfig, argv, cleanup, err := BuildConfig(req, capture)\n27\t\tif err != nil {\n28\t\t\tt.Fatalf(\"BuildConfig() error = %v\", err)\n29\t\t}\n30\t\tt.Cleanup(cleanup)\n31\t\n32\t\treturn config, argv, cleanup\n33\t}\n34\t\n35\t// directive reports whether the document contains the given line, ignoring the\n36\t// surrounding lines' order.\n37\tfunc hasDirective(config []byte, line string) bool {\n38\t\tfor _, got := range strings.Split(string(config), \"\\n\") {\n39\t\t\tif got == line {\n40\t\t\t\treturn true\n41\t\t\t}\n42\t\t}\n43\t\n44\t\treturn false\n45\t}\n46\t\n47\tfunc TestBuildConfigEmitsTheRequestAsDirectives(t *testing.T) {\n48\t\treq := &request.Request{\n49\t\t\tMethod:  \"POST\",\n50\t\t\tBaseURL: \"https://api.example.com/v1\",\n51\t\t\tPath:    \"/pets\",\n52\t\t\tHeaders: []request.Pair{{Name: \"Accept\", Value: request.Literal(\"application/json\")}},\n53\t\t}\n54\t\n55\t\tconfig, _, _ := buildConfig(t, req, Capture{})\n56\t\n57\t\twant := []string{\n58\t\t\t`url = \"https://api.example.com/v1/pets\"`,\n59\t\t\t`request = \"POST\"`,\n60\t\t\t`header = \"Accept: application/json\"`,\n61\t\t\t\"silent\",\n62\t\t\t\"show-error\",\n63\t\t\t`write-out = \"%{json}\"`,\n64\t\t}\n65\t\tfor _, line := range want {\n66\t\t\tif !hasDirective(config, line) {\n67\t\t\t\tt.Errorf(\"config is missing directive %s\\ngot:\\n%s\", line, config)\n68\t\t\t}\n69\t\t}\n70\t}\n71\t\n72\t// Defence in depth behind the scheme check in request.Build: a URL that slips\n73\t// past it, or a 302 pointing at file:///, still cannot make curl speak anything\n74\t// but http(s). The `=` prefix makes each list absolute rather than additive.\n75\tfunc TestBuildConfigConfinesCurlToHTTPSchemes(t *testing.T) {\n76\t\treq := &request.Request{Method: \"GET\", BaseURL: \"https://api.example.com\", Path: \"/pets\"}\n77\t\n78\t\tconfig, _, _ := buildConfig(t, req, Capture{})\n79\t\n80\t\tfor _, line := range []string{`proto = \"=http,https\"`, `proto-redir = \"=http,https\"`} {\n81\t\t\tif !hasDirective(config, line) {\n82\t\t\t\tt.Errorf(\"config is missing directive %s\\ngot:\\n%s\", line, config)\n83\t\t\t}\n84\t\t}\n85\t}\n86\t\n87\tfunc TestBuildConfigResolvesCredentialsIntoTheDocumentButNotArgv(t *testing.T) {\n88\t\tt.Setenv(\"TALARIA_AUTH_BEARER\", canary)\n89\t\n90\t\tconfig, argv, _ := buildConfig(t, bearerReq(), Capture{})\n91\t\n92\t\t// The document is the one place a resolved credential is allowed to exist.\n93\t\tif !hasDirective(config, `header = \"Authorization: Bearer `+canary+`\"`) {\n94\t\t\tt.Errorf(\"config does not carry the resolved credential:\\n%s\", config)\n95\t\t}\n96\t\n97\t\tfor _, arg := range argv {\n98\t\t\tif strings.Contains(arg, canary) {\n99\t\t\t\tt.Fatalf(\"argv carries the credential value: %q\", argv)\n100\t\t\t}\n101\t\t}\n102\t}\n103\t\n104\tfunc TestBuildConfigArgvIsOnlyTheStdinConfigFlags(t *testing.T) {\n105\t\tt.Setenv(\"TALARIA_AUTH_BEARER\", canary)\n106\t\n107\t\treq := bearerReq()\n108\t\treq.Query = []request.Pair{{Name: \"limit\", Value: request.Literal(\"10\")}}\n109\t\treq.Body = &request.Body{ContentType: \"application/json\", Data: []byte(`{\"a\":1}`)}\n110\t\n111\t\t_, argv, _ := buildConfig(t, req, Capture{\n112\t\t\tBodyPath:   filepath.Join(t.TempDir(), \"body\"),\n113\t\t\tHeaderPath: filepath.Join(t.TempDir(), \"hdr\"),\n114\t\t})\n115\t\n116\t\t// §5a: /proc/*/cmdline is world-readable, so nothing about the request may be\n117\t\t// an argument — not the URL, not a header, not an output path.\n118\t\twant := []string{\"curl\", \"-K\", \"-\"}\n119\t\tif len(argv) != len(want) {\n120\t\t\tt.Fatalf(\"argv = %q, want exactly %q\", argv, want)\n121\t\t}\n122\t\tfor i, arg := range want {\n123\t\t\tif argv[i] != arg {\n124\t\t\t\tt.Fatalf(\"argv = %q, want exactly %q\", argv, want)\n125\t\t\t}\n126\t\t}\n127\t}\n128\t\n129\tfunc TestBuildConfigTakesCaptureFilesAsDirectivesNotArguments(t *testing.T) {\n130\t\tdir := t.TempDir()\n131\t\tcapture := Capture{\n132\t\t\tBodyPath:   filepath.Join(dir, \"body\"),\n133\t\t\tHeaderPath: filepath.Join(dir, \"headers\"),\n134\t\t}\n135\t\n136\t\tconfig, _, _ := buildConfig(t, &request.Request{\n137\t\t\tMethod:  \"GET\",\n138\t\t\tBaseURL: \"https://api.example.com\",\n139\t\t\tPath:    \"/pets\",\n140\t\t}, capture)\n141\t\n142\t\tfor _, line := range []string{\n143\t\t\t`output = \"` + capture.BodyPath + `\"`,\n144\t\t\t`dump-header = \"` + capture.HeaderPath + `\"`,\n145\t\t} {\n146\t\t\tif !hasDirective(config, line) {\n147\t\t\t\tt.Errorf(\"config is missing directive %s\\ngot:\\n%s\", line, config)\n148\t\t\t}\n149\t\t}\n150\t}\n151\t\n152\tfunc TestBuildConfigEscapesBodyInTheVerifiedOrder(t *testing.T) {\n153\t\t// A literal backslash-n next to a real newline is the double-escaping trap: a\n154\t\t// sequential replace that escapes backslashes after newlines turns the real\n155\t\t// newline into a literal one.\n156\t\treq := &request.Request{\n157\t\t\tMethod:  \"POST\",\n158\t\t\tBaseURL: \"https://api.example.com\",\n159\t\t\tPath:    \"/pets\",\n160\t\t\tBody:    &request.Body{Data: []byte(\"a\\\\nb\\nc\\td\\re\\\"f\")},\n161\t\t}\n162\t\n163\t\tconfig, _, _ := buildConfig(t, req, Capture{})\n164\t\n165\t\tconst want = `data-raw = \"a\\\\nb\\nc\\td\\re\\\"f\"`\n166\t\tif !hasDirective(config, want) {\n167\t\t\tt.Errorf(\"config body directive is wrong\\ngot:\\n%s\\nwant it to contain:\\n%s\", config, want)\n168\t\t}\n169\t}\n170\t\n171\tfunc TestBuildConfigInlineBodyRoundTripsThroughRealCurl(t *testing.T) {\n172\t\t// The escaping is only correct if curl's own parser agrees, so this asserts\n173\t\t// against curl rather than against our idea of curl. A leading @ is in the\n174\t\t// body deliberately: with `data` or `data-binary` curl would read it as a\n175\t\t// filename, which is why the builder emits `data-raw`.\n176\t\tbody := []byte(\"{\\\"a\\\":\\\"x\\ty\\nz\\\\\\\"q\\\\\\\\b\\r\\\",\\\"u\\\":\\\"héllo→€\\\"}@not-a-file\")\n177\t\n178\t\tgot := postThroughCurl(t, &request.Request{\n179\t\t\tMethod:  \"POST\",\n180\t\t\tBaseURL: \"\", // filled in by postThroughCurl\n181\t\t\tPath:    \"/pets\",\n182\t\t\tBody:    &request.Body{ContentType: \"application/json\", Data: body},\n183\t\t})\n184\t\n185\t\tif !bytes.Equal(got, body) {\n186\t\t\tt.Errorf(\"curl sent %q, want byte-identical %q\", got, body)\n187\t\t}\n188\t}\n189\t\n190\tfunc TestBuildConfigLargeBodyGoesToATempFile(t *testing.T) {\n191\t\tbody := bytes.Repeat([]byte(\"x\"), maxInlineBody+1)\n192\t\treq := &request.Request{\n193\t\t\tMethod:  \"POST\",\n194\t\t\tBaseURL: \"https://api.example.com\",\n195\t\t\tPath:    \"/pets\",\n196\t\t\tBody:    &request.Body{Data: body},\n197\t\t}\n198\t\n199\t\tconfig, _, cleanup, err := BuildConfig(req, Capture{})\n200\t\tif err != nil {\n201\t\t\tt.Fatalf(\"BuildConfig() error = %v\", err)\n202\t\t}\n203\t\n204\t\tpath := bodyFilePath(t, config)\n205\t\tif bytes.Contains(config, body) {\n206\t\t\tt.Error(\"a body over the inline limit was still written into the config document\")\n207\t\t}\n208\t\n209\t\tinfo, err := os.Stat(path)\n210\t\tif err != nil {\n211\t\t\tt.Fatalf(\"temp body file: %v\", err)\n212\t\t}\n213\t\tif perm := info.Mode().Perm(); perm != 0o600 {\n214\t\t\tt.Errorf(\"temp body file mode = %04o, want 0600\", perm)\n215\t\t}\n216\t\n217\t\twritten, err := os.ReadFile(path)\n218\t\tif err != nil {\n219\t\t\tt.Fatalf(\"read temp body file: %v\", err)\n220\t\t}\n221\t\tif !bytes.Equal(written, body) {\n222\t\t\tt.Error(\"temp body file does not hold the body bytes\")\n223\t\t}\n224\t\n225\t\tcleanup()\n226\t\tif _, err := os.Stat(path); !errors.Is(err, os.ErrNotExist) {\n227\t\t\tt.Errorf(\"cleanup left the temp body file behind: stat err = %v\", err)\n228\t\t}\n229\t}\n230\t\n231\tfunc TestBuildConfigNonUTF8BodyGoesToATempFileRegardlessOfSize(t *testing.T) {\n232\t\t// Short, but it cannot survive the config document: 0x00 would truncate the\n233\t\t// quoted value and 0xff is not text curl's parser can carry back out.\n234\t\tbody := []byte{0x7b, 0xff, 0xfe, 0x00, 0x7d}\n235\t\treq := &request.Request{\n236\t\t\tMethod:  \"POST\",\n237\t\t\tBaseURL: \"https://api.example.com\",\n238\t\t\tPath:    \"/pets\",\n239\t\t\tBody:    &request.Body{Data: body},\n240\t\t}\n241\t\n242\t\tconfig, _, cleanup, err := BuildConfig(req, Capture{})\n243\t\tif err != nil {\n244\t\t\tt.Fatalf(\"BuildConfig() error = %v\", err)\n245\t\t}\n246\t\tdefer cleanup()\n247\t\n248\t\twritten, err := os.ReadFile(bodyFilePath(t, config))\n249\t\tif err != nil {\n250\t\t\tt.Fatalf(\"read temp body file: %v\", err)\n251\t\t}\n252\t\tif !bytes.Equal(written, body) {\n253\t\t\tt.Errorf(\"temp body file = %x, want %x\", written, body)\n254\t\t}\n255\t}\n256\t\n257\tfunc TestBuildConfigMissingCredentialIsExitCodeFive(t *testing.T) {\n258\t\tt.Setenv(\"TALARIA_AUTH_BEARER\", canary)\n259\t\tos.Unsetenv(\"TALARIA_AUTH_BEARER\") //nolint:errcheck // t.Setenv restores it.\n260\t\n261\t\tconfig, _, cleanup, err := BuildConfig(bearerReq(), Capture{})\n262\t\tif cleanup != nil {\n263\t\t\tcleanup()\n264\t\t}\n265\t\n266\t\tvar cerr *clierr.Error\n267\t\tif !errors.As(err, &cerr) {\n268\t\t\tt.Fatalf(\"BuildConfig() error = %v, want a *clierr.Error\", err)\n269\t\t}\n270\t\tif cerr.Code != clierr.CodeCredentialMissing {\n271\t\t\tt.Errorf(\"exit code = %d, want %d\", cerr.Code, clierr.CodeCredentialMissing)\n272\t\t}\n273\t\t// An empty header is the failure mode this test exists to rule out: it would\n274\t\t// send an unauthenticated request that looks authenticated.\n275\t\tif config != nil {\n276\t\t\tt.Errorf(\"a document was built despite the missing credential:\\n%s\", config)\n277\t\t}\n278\t}\n279\t\n280\tfunc TestBuildConfigCleanupZeroesTheDocument(t *testing.T) {\n281\t\tt.Setenv(\"TALARIA_AUTH_BEARER\", canary)\n282\t\n283\t\tconfig, _, cleanup, err := BuildConfig(bearerReq(), Capture{})\n284\t\tif err != nil {\n285\t\t\tt.Fatalf(\"BuildConfig() error = %v\", err)\n286\t\t}\n287\t\n288\t\tcleanup()\n289\t\n290\t\tif bytes.Contains(config, []byte(canary)) {\n291\t\t\tt.Error(\"cleanup left the resolved credential in the config buffer\")\n292\t\t}\n293\t}\n294\t\n295\tfunc TestBuildConfigResolvesQueryAndCookieCredentials(t *testing.T) {\n296\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_Q\", canary+\"-query\")\n297\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_C\", canary+\"-cookie\")\n298\t\n299\t\treq := &request.Request{\n300\t\t\tMethod:  \"GET\",\n301\t\t\tBaseURL: \"https://api.example.com\",\n302\t\t\tPath:    \"/pets\",\n303\t\t\tQuery: []request.Pair{\n304\t\t\t\t{Name: \"api_key\", Value: request.Secret(secret.Env(\"TALARIA_AUTH_APIKEY_Q\"), request.EncodeRaw)},\n305\t\t\t},\n306\t\t\tCookies: []request.Pair{\n307\t\t\t\t{Name: \"flavour\", Value: request.Literal(\"salty\")},\n308\t\t\t\t{Name: \"session\", Value: request.Secret(secret.Env(\"TALARIA_AUTH_APIKEY_C\"), request.EncodeRaw)},\n309\t\t\t},\n310\t\t}\n311\t\n312\t\tconfig, _, _ := buildConfig(t, req, Capture{})\n313\t\n314\t\tif !hasDirective(config, `url = \"https://api.example.com/pets?api_key=`+canary+`-query\"`) {\n315\t\t\tt.Errorf(\"query credential was not resolved into the url directive:\\n%s\", config)\n316\t\t}\n317\t\tif !hasDirective(config, `cookie = \"flavour=salty; session=`+canary+`-cookie\"`) {\n318\t\t\tt.Errorf(\"cookie credential was not resolved into the cookie directive:\\n%s\", config)\n319\t\t}\n320\t}\n321\t\n322\tfunc TestBuildConfigRendersBasicAuthAsTheUserDirective(t *testing.T) {\n323\t\tt.Setenv(\"TALARIA_AUTH_BASIC\", \"alice:\"+canary)\n324\t\n325\t\treq := &request.Request{\n326\t\t\tMethod:  \"GET\",\n327\t\t\tBaseURL: \"https://api.example.com\",\n328\t\t\tPath:    \"/pets\",\n329\t\t\tHeaders: []request.Pair{{\n330\t\t\t\tName:  \"Authorization\",\n331\t\t\t\tValue: request.Secret(secret.Env(\"TALARIA_AUTH_BASIC\"), request.EncodeBasic),\n332\t\t\t}},\n333\t\t}\n334\t\n335\t\tconfig, _, _ := buildConfig(t, req, Capture{})\n336\t\n337\t\t// curl does the base64, so the raw user:password never has to be encoded here.\n338\t\tif !hasDirective(config, `user = \"alice:`+canary+`\"`) {\n339\t\t\tt.Errorf(\"basic auth is not a user directive:\\n%s\", config)\n340\t\t}\n341\t\tif bytes.Contains(config, []byte(`header = \"Authorization:`)) {\n342\t\t\tt.Errorf(\"basic auth was also emitted as a header:\\n%s\", config)\n343\t\t}\n344\t}\n345\t\n346\t// bodyFilePath extracts the path from the document's data-binary = \"@path\"\n347\t// directive, failing the test if the body was not diverted to a file.\n348\tfunc bodyFilePath(t *testing.T, config []byte) string {\n349\t\tt.Helper()\n350\t\n351\t\tmatch := regexp.MustCompile(`(?m)^data-binary = \"@(.*)\"$`).FindSubmatch(config)\n352\t\tif match == nil {\n353\t\t\tt.Fatalf(\"config has no temp-file body directive:\\n%s\", config)\n354\t\t}\n355\t\n356\t\treturn string(match[1])\n357\t}\n358\t\n359\t// postThroughCurl runs the built document through the real curl binary against a\n360\t// test server and returns the body the server received.\n361\tfunc postThroughCurl(t *testing.T, req *request.Request) []byte {\n362\t\tt.Helper()\n363\t\n364\t\tcurlPath, err := exec.LookPath(\"curl\")\n365\t\tif err != nil {\n366\t\t\tt.Skip(\"curl is not installed\")\n367\t\t}\n368\t\n369\t\tvar received []byte\n370\t\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n371\t\t\treceived, _ = io.ReadAll(r.Body)\n372\t\t\tw.WriteHeader(http.StatusOK)\n373\t\t}))\n374\t\tdefer server.Close()\n375\t\n376\t\treq.BaseURL = server.URL\n377\t\tconfig, argv, cleanup, err := BuildConfig(req, Capture{})\n378\t\tif err != nil {\n379\t\t\tt.Fatalf(\"BuildConfig() error = %v\", err)\n380\t\t}\n381\t\tdefer cleanup()\n382\t\n383\t\tcmd := exec.Command(curlPath, argv[1:]...)\n384\t\tcmd.Stdin = bytes.NewReader(config)\n385\t\tif out, err := cmd.CombinedOutput(); err != nil {\n386\t\t\tt.Fatalf(\"curl failed: %v\\n%s\\nconfig:\\n%s\", err, out, config)\n387\t\t}\n388\t\n389\t\treturn received\n390\t}\n391\t"
      }
