    "content": [
      {
        "tool_use_id": "toolu_01DTLMPbA6mZmwSsk6SHhpvP",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"io\"\n6\t\t\"net/http\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/spf13/cobra\"\n11\t\n12\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n13\t\t\"github.com/Teeeep/talaria/internal/config\"\n14\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n15\t\t\"github.com/Teeeep/talaria/internal/curl\"\n16\t\t\"github.com/Teeeep/talaria/internal/gen\"\n17\t\t\"github.com/Teeeep/talaria/internal/operation\"\n18\t\t\"github.com/Teeeep/talaria/internal/output\"\n19\t\t\"github.com/Teeeep/talaria/internal/request\"\n20\t\t\"github.com/Teeeep/talaria/internal/secret\"\n21\t\t\"github.com/Teeeep/talaria/internal/spec\"\n22\t\t\"github.com/Teeeep/talaria/internal/validate\"\n23\t)\n24\t\n25\t// runSeed is what the data generator draws from. It is a constant rather than a\n26\t// flag because a smoke test whose request bodies change between runs fails once,\n27\t// passes next time and teaches nobody anything (DESIGN.md §5a).\n28\tconst runSeed = 1\n29\t\n30\t// contentTypeHeader is the header a generated body's media type travels in.\n31\tconst contentTypeHeader = \"Content-Type\"\n32\t\n33\t// The three outcomes one operation can have. Skipped is deliberately not a\n34\t// failure: a DELETE left alone without --allow-mutations, or an operation whose\n35\t// path parameter nothing could supply, is correct behaviour rather than a\n36\t// broken API.\n37\tconst (\n38\t\toutcomePassed  = \"passed\"\n39\t\toutcomeFailed  = \"failed\"\n40\t\toutcomeSkipped = \"skipped\"\n41\t)\n42\t\n43\t// runResult is one operation's line in the report.\n44\ttype runResult struct {\n45\t\tOperationID string `json:\"operation_id\"`\n46\t\tMethod      string `json:\"method\"`\n47\t\tPath        string `json:\"path\"`\n48\t\tOutcome     string `json:\"outcome\"`\n49\t\t// Reason says why a skip or a failure happened. A passing operation has\n50\t\t// none: there is nothing to explain.\n51\t\tReason string `json:\"reason,omitempty\"`\n52\t\t// Status and TimingMS are absent for an operation that was never executed.\n53\t\t// TimingMS is a pointer so a call to a local server that legitimately\n54\t\t// rounded to 0ms is still reported as timed.\n55\t\tStatus     int              `json:\"status,omitempty\"`\n56\t\tTimingMS   *int64           `json:\"timing_ms,omitempty\"`\n57\t\tValidation *validate.Result `json:\"validation,omitempty\"`\n58\t}\n59\t\n60\t// runSummary is the count an agent, or a CI job, reads first.\n61\ttype runSummary struct {\n62\t\tTotal   int `json:\"total\"`\n63\t\tPassed  int `json:\"passed\"`\n64\t\tFailed  int `json:\"failed\"`\n65\t\tSkipped int `json:\"skipped\"`\n66\t}\n67\t\n68\t// runView is the whole report.\n69\ttype runView struct {\n70\t\tResults []runResult `json:\"results\"`\n71\t\tSummary runSummary  `json:\"summary\"`\n72\t}\n73\t\n74\tfunc newRunCmd() *cobra.Command {\n75\t\tvar (\n76\t\t\ttags           []string\n77\t\t\tids            []string\n78\t\t\tfixturesDir    string\n79\t\t\treport         string\n80\t\t\tallowMutations bool\n81\t\t\tfailOnError    bool\n82\t\t\ttimeout        float64\n83\t\t)\n84\t\n85\t\t// One warner for the whole command, as on `call`: a run that puts a\n86\t\t// credential in the query string makes the point once, not once per\n87\t\t// operation.\n88\t\twarner := secret.NewQueryKeyWarner()\n89\t\n90\t\tcmd := &cobra.Command{\n91\t\t\tUse:   \"run [spec]\",\n92\t\t\tShort: \"Smoke-test a spec's operations and report what each one did\",\n93\t\t\tLong: \"Call every operation the filters select, check each response against the\\n\" +\n94\t\t\t\t\"spec, and report one line per operation. Mutating operations are skipped\\n\" +\n95\t\t\t\t\"unless --allow-mutations is given. Request data comes from the spec's own\\n\" +\n96\t\t\t\t\"examples first, then --fixtures, then generation.\",\n97\t\t\tArgs: usageArgs(cobra.MaximumNArgs(1)),\n98\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n99\t\t\t\tformat, err := resolveReportFormat(cmd, report)\n100\t\t\t\tif err != nil {\n101\t\t\t\t\treturn err\n102\t\t\t\t}\n103\t\n104\t\t\t\tdoc, index, err := loadSpec(cmd, args)\n105\t\t\t\tif err != nil {\n106\t\t\t\t\treturn err\n107\t\t\t\t}\n108\t\n109\t\t\t\tops, err := selectOperations(index, tags, ids)\n110\t\t\t\tif err != nil {\n111\t\t\t\t\treturn err\n112\t\t\t\t}\n113\t\n114\t\t\t\trunner, err := newRunner(cmd, doc, fixturesDir, allowMutations, timeoutOptions(timeout), warner)\n115\t\t\t\tif err != nil {\n116\t\t\t\t\treturn err\n117\t\t\t\t}\n118\t\n119\t\t\t\t// Sequential, in spec order. Determinism beats speed here, and\n120\t\t\t\t// parallel calls against a real API are a surprise nobody asked for.\n121\t\t\t\tresults := make([]runResult, 0, len(ops))\n122\t\t\t\tfor _, op := range ops {\n123\t\t\t\t\tresults = append(results, runner.execute(op))\n124\t\t\t\t}\n125\t\n126\t\t\t\tview := runView{Results: results, Summary: summarise(results)}\n127\t\n128\t\t\t\t// Rendered before the exit code is decided, for the reason `call`\n129\t\t\t\t// renders first: the flags change what the process exits with, not\n130\t\t\t\t// what the caller gets to read.\n131\t\t\t\tif err := output.New(format, cmd.OutOrStdout()).Render(runPayload(view)); err != nil {\n132\t\t\t\t\treturn err\n133\t\t\t\t}\n134\t\n135\t\t\t\treturn runner.verdict(view, failOnError)\n136\t\t\t},\n137\t\t}\n138\t\n139\t\t// All local to run: no other command enumerates operations, reports on a\n140\t\t// suite, or has test data to supply.\n141\t\tcmd.Flags().StringArrayVar(&tags, \"tag\", nil,\n142\t\t\t\"only operations carrying this tag (repeatable)\")\n143\t\tcmd.Flags().StringArrayVar(&ids, \"operation\", nil,\n144\t\t\t\"only this operationId (repeatable); combined with --tag as a union\")\n145\t\tcmd.Flags().StringVar(&fixturesDir, \"fixtures\", \"\",\n146\t\t\t\"directory of <operationId>.json test data, consulted after spec examples\")\n147\t\tcmd.Flags().StringVar(&report, \"report\", \"\",\n148\t\t\t\"report format: json|pretty|tsv|junit (overrides --output)\")\n149\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n150\t\t\t\"include operations whose method is not GET, HEAD or OPTIONS\")\n151\t\tcmd.Flags().BoolVar(&failOnError, \"fail-on-error\", false,\n152\t\t\t\"exit 4 if any operation failed\")\n153\t\t// Per operation, not per suite: the bound that matters is the one that keeps\n154\t\t// a single wedged endpoint from costing the report.\n155\t\tcmd.Flags().Float64Var(&timeout, \"timeout\", curl.DefaultMaxTime.Seconds(),\n156\t\t\t\"give up on each operation's request after this many seconds\")\n157\t\n158\t\treturn cmd\n159\t}\n160\t\n161\t// resolveReportFormat picks the format the report is written in. --report is\n162\t// run's own flag and wins over the persistent --output: an agent that set\n163\t// --output globally and then asked run for JSON must get JSON, not a format it\n164\t// asked for two flags ago.\n165\t//\n166\t// It also accepts junit, which --output does not: a suite of operations is the\n167\t// only thing there is to render as a test report, and `run` is the only command\n168\t// that produces one.\n169\tfunc resolveReportFormat(cmd *cobra.Command, report string) (output.Format, error) {\n170\t\tif report == \"\" {\n171\t\t\treturn resolveFormat(cmd)\n172\t\t}\n173\t\n174\t\tformat, err := output.ParseReportFormat(report)\n175\t\tif err != nil {\n176\t\t\treturn \"\", clierr.Usage(\"%w\", err).WithAlternatives(output.ReportFormats()...)\n177\t\t}\n178\t\n179\t\treturn format, nil\n180\t}\n181\t\n182\t// selectOperations applies --tag and --operation as a union, in spec order. No\n183\t// filters at all means the whole spec.\n184\t//\n185\t// A filter that selects nothing is a usage error rather than an empty pass: a\n186\t// mistyped tag that exits 0 with nothing tested is a green CI run that proves\n187\t// nothing, which is the one result a smoke test must never produce.\n188\tfunc selectOperations(index *operation.Index, tags, ids []string) ([]operation.Operation, error) {\n189\t\tif len(tags) == 0 && len(ids) == 0 {\n190\t\t\treturn index.Operations(), nil\n191\t\t}\n192\t\n193\t\tkeep := map[string]bool{}\n194\t\tfor _, tag := range tags {\n195\t\t\tfor _, op := range index.ByTag(tag) {\n196\t\t\t\tkeep[operationKey(op)] = true\n197\t\t\t}\n198\t\t}\n199\t\t// Looked up rather than matched, so a misspelt id gets Lookup's suggestions\n200\t\t// instead of silently selecting nothing.\n201\t\tfor _, id := range ids {\n202\t\t\top, err := index.Lookup(id)\n203\t\t\tif err != nil {\n204\t\t\t\treturn nil, err\n205\t\t\t}\n206\t\t\tkeep[operationKey(op)] = true\n207\t\t}\n208\t\n209\t\tvar ops []operation.Operation\n210\t\tfor _, op := range index.Operations() {\n211\t\t\tif keep[operationKey(op)] {\n212\t\t\t\tops = append(ops, op)\n213\t\t\t}\n214\t\t}\n215\t\tif len(ops) == 0 {\n216\t\t\treturn nil, clierr.Usage(\"no operation matches %s\",\n217\t\t\t\tstrings.Join(append(quoted(\"--tag\", tags), quoted(\"--operation\", ids)...), \" or \"))\n218\t\t}\n219\t\n220\t\treturn ops, nil\n221\t}\n222\t\n223\t// operationKey identifies an operation independently of its id, so the two\n224\t// filters can be unioned even for operations the spec never named.\n225\tfunc operationKey(op operation.Operation) string { return op.Method + \" \" + op.Path }\n226\t\n227\t// quoted renders one filter's values for an error message.\n228\tfunc quoted(flag string, values []string) []string {\n229\t\tout := make([]string, 0, len(values))\n230\t\tfor _, value := range values {\n231\t\t\tout = append(out, fmt.Sprintf(\"%s %q\", flag, value))\n232\t\t}\n233\t\n234\t\treturn out\n235\t}\n236\t\n237\t// runner holds everything one suite reuses across operations: the compiled\n238\t// validator, the seeded generator, the history store and the redactors. Built\n239\t// once so the per-operation loop only makes requests.\n240\ttype runner struct {\n241\t\tdoc       *spec.Document\n242\t\tprofile   *config.Profile\n243\t\tbaseURL   string\n244\t\tgen       *gen.Generator\n245\t\tvalidator *validate.Validator\n246\t\tstore     *corpus.Store\n247\t\tredactors corpus.Redactors\n248\t\twarner    *secret.QueryKeyWarner\n249\t\topts      curl.Options\n250\t\tstderr    io.Writer\n251\t\n252\t\tallowMutations bool\n253\t\t// missing collects the security schemes that stopped an operation from\n254\t\t// running, in the display form the exit-5 error reports.\n255\t\tmissing []string\n256\t}\n257\t\n258\tfunc newRunner(\n259\t\tcmd *cobra.Command,\n260\t\tdoc *spec.Document,\n261\t\tfixturesDir string,\n262\t\tallowMutations bool,\n263\t\topts curl.Options,\n264\t\twarner *secret.QueryKeyWarner,\n265\t) (*runner, error) {\n266\t\t// The whole fixtures directory is read up front, before any request goes\n267\t\t// out: a typo in a fixture should not surface halfway through a suite.\n268\t\tfixtures, err := gen.LoadFixtures(fixturesDir)\n269\t\tif err != nil {\n270\t\t\treturn nil, err\n271\t\t}\n272\t\n273\t\tcfg, err := config.Load(\"\")\n274\t\tif err != nil {\n275\t\t\treturn nil, err\n276\t\t}\n277\t\n278\t\tprofile, err := selectProfile(cmd, cfg)\n279\t\tif err != nil {\n280\t\t\treturn nil, err\n281\t\t}\n282\t\n283\t\tstore, err := openHistory(cmd, cfg)\n284\t\tif err != nil {\n285\t\t\treturn nil, err\n286\t\t}\n287\t\n288\t\tbaseURL, err := cmd.Flags().GetString(\"base-url\")\n289\t\tif err != nil {\n290\t\t\treturn nil, clierr.Usage(\"%w\", err)\n291\t\t}\n292\t\n293\t\tgenerator := gen.New(runSeed)\n294\t\tgenerator.Fixtures = fixtures\n295\t\n296\t\treturn &runner{\n297\t\t\tdoc:            doc,\n298\t\t\tprofile:        profile,\n299\t\t\tbaseURL:        baseURL,\n300\t\t\tgen:            generator,\n301\t\t\tvalidator:      validate.New(doc),\n302\t\t\tstore:          store,\n303\t\t\tredactors:      newRedactors(cfg),\n304\t\t\twarner:         warner,\n305\t\t\topts:           opts,\n306\t\t\tstderr:         cmd.ErrOrStderr(),\n307\t\t\tallowMutations: allowMutations,\n308\t\t}, nil\n309\t}\n310\t\n311\t// execute runs one operation and reports what happened. It never returns an\n312\t// error: one operation's problem is a line in the report, not the end of the\n313\t// suite, and the exit code is decided once at the end from the whole of it.\n314\tfunc (r *runner) execute(op operation.Operation) runResult {\n315\t\tres := runResult{\n316\t\t\tOperationID: operationName(op),\n317\t\t\tMethod:      op.Method,\n318\t\t\tPath:        op.Path,\n319\t\t}\n320\t\n321\t\tif op.IsMutation() && !r.allowMutations {\n322\t\t\treturn res.skip(\"a %s request may change server state: pass --allow-mutations to include it\",\n323\t\t\t\top.Method)\n324\t\t}\n325\t\n326\t\tcreds, err := config.Resolve(op, r.doc, r.profile)\n327\t\tif err != nil {\n328\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n329\t\t}\n330\t\t// Checked before the request is built rather than left to fail at exec\n331\t\t// time, so an agent gets the variable to export and the server gets no\n332\t\t// request it was always going to reject.\n333\t\tif missing := missingCredentials(creds); len(missing) > 0 {\n334\t\t\tr.noteMissing(missing)\n335\t\n336\t\t\treturn res.skip(\"no credential for security %s\",\n337\t\t\t\tpluralise(len(missing), \"scheme\")+\" \"+strings.Join(missing, \", \"))\n338\t\t}\n339\t\n340\t\tdata := r.gen.DataFor(op)\n341\t\treq, err := request.Build(request.Inputs{\n342\t\t\tOp:      op,\n343\t\t\tDoc:     r.doc,\n344\t\t\tProfile: r.profile,\n345\t\t\tCreds:   creds,\n346\t\t\tBaseURL: r.baseURL,\n347\t\t\tParams:  flagPairs(data.Params),\n348\t\t\tHeaders: flagPairs(headersFor(data)),\n349\t\t\tBody:    bodyFlag(data.Body),\n350\t\t\t// No stdin: `run` makes many requests and stdin can only be read once,\n351\t\t\t// so there is nothing here for `--body -` to mean.\n352\t\t})\n353\t\tif err != nil {\n354\t\t\t// A request that cannot be built is data talaria could not supply, not\n355\t\t\t// an API that misbehaved, so it is a skip carrying the builder's own\n356\t\t\t// message — which names the parameter.\n357\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n358\t\t}\n359\t\n360\t\twarnQueryCredentials(r.stderr, r.warner, req)\n361\t\n362\t\tresp, execErr := curl.ExecuteWith(req, r.opts)\n363\t\t// Recorded either way, as `call` records: a request that never completed is\n364\t\t// still something that was tried.\n365\t\trecordCall(r.stderr, r.store, corpus.SourceRun, req, resp, r.redactors)\n366\t\tif execErr != nil {\n367\t\t\treturn res.fail(\"%s\", clierr.From(execErr).Message)\n368\t\t}\n369\t\n370\t\tview := redactResponse(resp, r.redactors.Response)\n371\t\ttiming := view.TimingMS\n372\t\tres.Status, res.TimingMS = view.Status, &timing\n373\t\tres.Validation = validateWith(r.stderr, r.validator, req, view)\n374\t\n375\t\treturn res.judge()\n376\t}\n377\t\n378\t// noteMissing records the credentials blocking an operation, without repeating\n379\t// one that already blocked another.\n380\tfunc (r *runner) noteMissing(missing []string) {\n381\t\tfor _, name := range missing {\n382\t\t\tif !slicesContains(r.missing, name) {\n383\t\t\t\tr.missing = append(r.missing, name)\n384\t\t\t}\n385\t\t}\n386\t}\n387\t\n388\t// verdict turns the finished report into an exit code.\n389\t//\n390\t// A missing credential exits 5 whether or not --fail-on-error was given, as\n391\t// `auth check` does: it means the suite did not test the operation at all,\n392\t// which is a different thing from an API that answered badly, and an agent\n393\t// acts on it by exporting a variable rather than by reading the report.\n394\tfunc (r *runner) verdict(view runView, failOnError bool) error {\n395\t\tif len(r.missing) > 0 {\n396\t\t\treturn clierr.CredentialMissing(\"no credential for security %s %s\",\n397\t\t\t\tpluralise(len(r.missing), \"scheme\"), strings.Join(r.missing, \", \"))\n398\t\t}\n399\t\tif failOnError && view.Summary.Failed > 0 {\n400\t\t\treturn clierr.Validation(\"%s failed\", pluralise(view.Summary.Failed, \"operation\"))\n401\t\t}\n402\t\n403\t\treturn nil\n404\t}\n405\t\n406\t// skip marks an operation as not run, and why.\n407\tfunc (res runResult) skip(format string, a ...any) runResult {\n408\t\tres.Outcome, res.Reason = outcomeSkipped, fmt.Sprintf(format, a...)\n409\t\n410\t\treturn res\n411\t}\n412\t\n413\t// fail marks an operation as run and wrong, and why.\n414\tfunc (res runResult) fail(format string, a ...any) runResult {\n415\t\tres.Outcome, res.Reason = outcomeFailed, fmt.Sprintf(format, a...)\n416\t\n417\t\treturn res\n418\t}\n419\t\n420\t// judge decides the outcome of an operation that reached the server. The HTTP\n421\t// status is reported first when both apply, for `call --fail-on-error`'s\n422\t// reason: a 500 whose body does not match the error schema is a server that is\n423\t// down, not a server with a documentation problem.\n424\tfunc (res runResult) judge() runResult {\n425\t\tswitch {\n426\t\tcase res.Status >= http.StatusBadRequest:\n427\t\t\treturn res.fail(\"the server returned %s\", statusText(res.Status))\n428\t\tcase res.Validation != nil && len(res.Validation.Errors) > 0:\n429\t\t\treturn res.fail(\"the response violates the spec: %s\",\n430\t\t\t\tpluralise(len(res.Validation.Errors), \"validation error\"))\n431\t\tdefault:\n432\t\t\tres.Outcome = outcomePassed\n433\t\n434\t\t\treturn res\n435\t\t}\n436\t}\n437\t\n438\t// missingCredentials names the credentials an operation needs and does not\n439\t// have, in the form `scheme (set $VAR)` — the same phrasing `auth check` uses,\n440\t// because it answers the same question.\n441\tfunc missingCredentials(creds []config.Credential) []string {\n442\t\tvar missing []string\n443\t\tfor _, cred := range creds {\n444\t\t\tif !cred.Present() {\n445\t\t\t\tmissing = append(missing, cred.Scheme+\" (set \"+cred.Ref.Symbolic()+\")\")\n446\t\t\t}\n447\t\t}\n448\t\n449\t\treturn missing\n450\t}\n451\t\n452\t// flagPairs renders generated data as the `name=value` strings request.Build\n453\t// parses, sorted so two runs of the same spec build byte-identical requests.\n454\tfunc flagPairs(values map[string]string) []string {\n455\t\tout := make([]string, 0, len(values))\n456\t\tfor name, value := range values {\n457\t\t\tout = append(out, name+\"=\"+value)\n458\t\t}\n459\t\tsort.Strings(out)\n460\t\n461\t\treturn out\n462\t}\n463\t\n464\t// headersFor is the headers one request sends: the fixture's, plus the media\n465\t// type the body was generated as.\n466\t//\n467\t// Without that header the request builder falls back to the operation's first\n468\t// declared media type, which is not necessarily the one the body was generated\n469\t// from — a spec listing application/xml before application/json, or a converted\n470\t// Swagger 2.0 formData operation, then sends JSON bytes under a media type it\n471\t// is not. A fixture header wins, as a user-set --header wins in `call`.\n472\tfunc headersFor(data gen.Data) map[string]string {\n473\t\theaders := make(map[string]string, len(data.Headers)+1)\n474\t\tfor name, value := range data.Headers {\n475\t\t\theaders[name] = value\n476\t\t}\n477\t\n478\t\tif len(data.Body) == 0 || data.ContentType == \"\" {\n479\t\t\treturn headers\n480\t\t}\n481\t\n482\t\tfor name := range headers {\n483\t\t\tif strings.EqualFold(name, contentTypeHeader) {\n484\t\t\t\treturn headers\n485\t\t\t}\n486\t\t}\n487\t\theaders[contentTypeHeader] = data.ContentType\n488\t\n489\t\treturn headers\n490\t}\n491\t\n492\t// bodyFlag renders a generated body as the --body value it stands in for, so\n493\t// the media type travels with it in headersFor rather than being re-derived\n494\t// from the spec. Generated and fixture bodies are always JSON, so neither can\n495\t// collide with --body's `@file` and `-` spellings.\n496\tfunc bodyFlag(body []byte) []string {\n497\t\tif len(body) == 0 {\n498\t\t\treturn nil\n499\t\t}\n500\t\n501\t\treturn []string{string(body)}\n502\t}\n503\t\n504\t// summarise counts the outcomes.\n505\tfunc summarise(results []runResult) runSummary {\n506\t\tsummary := runSummary{Total: len(results)}\n507\t\tfor _, res := range results {\n508\t\t\tswitch res.Outcome {\n509\t\t\tcase outcomePassed:\n510\t\t\t\tsummary.Passed++\n511\t\t\tcase outcomeFailed:\n512\t\t\t\tsummary.Failed++\n513\t\t\tdefault:\n514\t\t\t\tsummary.Skipped++\n515\t\t\t}\n516\t\t}\n517\t\n518\t\treturn summary\n519\t}\n520\t\n521\t// runPayload builds the JSON view and the table from the same results.\n522\t//\n523\t// The table is one row per operation and then the summary, which is the shape a\n524\t// human reads top to bottom and a `grep -c failed` reads too. The last row is a\n525\t// single cell, so tabwriter leaves it unpadded rather than aligning a sentence\n526\t// into the status column.\n527\tfunc runPayload(view runView) output.Payload {\n528\t\trows := make([][]string, 0, len(view.Results)+1)\n529\t\tfor _, res := range view.Results {\n530\t\t\trows = append(rows, []string{\n531\t\t\t\tres.Outcome,\n532\t\t\t\tres.Method,\n533\t\t\t\tres.Path,\n534\t\t\t\tres.OperationID,\n535\t\t\t\tstatusCell(res.Status),\n536\t\t\t\tres.Reason,\n537\t\t\t})\n538\t\t}\n539\t\trows = append(rows, []string{summaryLine(view.Summary)})\n540\t\n541\t\treturn output.Payload{\n542\t\t\tData:  view,\n543\t\t\tTable: output.Table{Rows: rows},\n544\t\t\tJUnit: junitSuite(view),\n545\t\t}\n546\t}\n547\t\n548\t// junitSuite is the same results as a test suite, for `--report junit`.\n549\t//\n550\t// A skip stays a skip rather than becoming a failure: a DELETE left alone\n551\t// without --allow-mutations is correct behaviour, and a CI job that went red\n552\t// over it would be turned off within a week.\n553\tfunc junitSuite(view runView) output.Suite {\n554\t\tcases := make([]output.Case, 0, len(view.Results))\n555\t\tfor _, res := range view.Results {\n556\t\t\tc := output.Case{Name: res.OperationID, Seconds: res.seconds()}\n557\t\t\tswitch res.Outcome {\n558\t\t\tcase outcomeFailed:\n559\t\t\t\tc.Failure = res.Reason\n560\t\t\tcase outcomeSkipped:\n561\t\t\t\tc.Skipped = res.Reason\n562\t\t\t}\n563\t\n564\t\t\tcases = append(cases, c)\n565\t\t}\n566\t\n567\t\treturn output.Suite{Name: \"talaria run\", Cases: cases}\n568\t}\n569\t\n570\t// seconds is the operation's timing in the unit JUnit's time attribute is\n571\t// defined in. An operation that never reached a server took no measured time\n572\t// rather than an unknown one: it is reported as 0, with the <skipped> child\n573\t// saying why.\n574\tfunc (res runResult) seconds() float64 {\n575\t\tif res.TimingMS == nil {\n576\t\t\treturn 0\n577\t\t}\n578\t\n579\t\treturn float64(*res.TimingMS) / 1000\n580\t}\n581\t\n582\t// summaryLine is the one line a human is looking for.\n583\tfunc summaryLine(s runSummary) string {\n584\t\treturn fmt.Sprintf(\"%s: %d passed, %d failed, %d skipped\",\n585\t\t\tpluralise(s.Total, \"operation\"), s.Passed, s.Failed, s.Skipped)\n586\t}\n587\t\n588\t// slicesContains reports whether values already holds value.\n589\tfunc slicesContains(values []string, value string) bool {\n590\t\tfor _, v := range values {\n591\t\t\tif v == value {\n592\t\t\t\treturn true\n593\t\t\t}\n594\t\t}\n595\t\n596\t\treturn false\n597\t}\n598\t"
      }
    ]
