        "tool_use_id": "toolu_018GsbRh5P48mUc8pkiyaoTt",
        "type": "tool_result",
        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"math\"\n8\t\t\"net/http\"\n9\t\t\"net/url\"\n10\t\t\"os\"\n11\t\t\"os/exec\"\n12\t\t\"path/filepath\"\n13\t\t\"strings\"\n14\t\n15\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n16\t\t\"github.com/Teeeep/talaria/internal/request\"\n17\t)\n18\t\n19\t// Response is one observed HTTP response. It is the `response` block of call's\n20\t// output (DESIGN.md §4) before any redaction is applied — redaction of what came\n21\t// back off the wire is Task 20's job, and doing it here would leave no\n22\t// unredacted copy for validation to check against the spec.\n23\ttype Response struct {\n24\t\tStatus   int         `json:\"status\"`\n25\t\tHeaders  http.Header `json:\"headers\"`\n26\t\tBody     []byte      `json:\"body\"`\n27\t\tTimingMS int64       `json:\"timing_ms\"`\n28\t}\n29\t\n30\t// Execute runs req through the system curl and returns what came back.\n31\t//\n32\t// An HTTP 4xx or 5xx is a successful observation and returns a Response with no\n33\t// error (§4); only a request that could not be completed at all — a refused\n34\t// connection, a TLS failure, curl itself failing — is an error, and it carries\n35\t// exit code 1.\n36\t//\n37\t// The credential values live in the config document written to curl's stdin and\n38\t// nowhere else: not in argv, which /proc/*/cmdline exposes to any process on\n39\t// the host, and not in the environment curl inherits (§5a).\n40\tfunc Execute(req *request.Request) (*Response, error) {\n41\t\tpath, err := exec.LookPath(\"curl\")\n42\t\tif err != nil {\n43\t\t\treturn nil, clierr.RequestFailed(\"curl is not installed or not on PATH: %w\", err)\n44\t\t}\n45\t\tif err := preflight(path); err != nil {\n46\t\t\treturn nil, err\n47\t\t}\n48\t\n49\t\tcapture, cleanupCapture, err := newCapture()\n50\t\tif err != nil {\n51\t\t\treturn nil, err\n52\t\t}\n53\t\tdefer cleanupCapture()\n54\t\n55\t\tconfig, argv, cleanupConfig, err := BuildConfig(req, capture)\n56\t\tdefer cleanupConfig()\n57\t\tif err != nil {\n58\t\t\treturn nil, err\n59\t\t}\n60\t\n61\t\t// argv[0] is the command name BuildConfig reports; the resolved path is what\n62\t\t// actually gets executed, so a PATH change mid-run cannot swap the binary\n63\t\t// between the preflight and the call.\n64\t\tcmd := exec.Command(path, argv[1:]...)\n65\t\t// The document goes in over a pipe rather than through the process's own\n66\t\t// stdin, which belongs to the user and may be a request body (Task 18).\n67\t\tcmd.Stdin = bytes.NewReader(config)\n68\t\n69\t\tvar stdout, stderr bytes.Buffer\n70\t\tcmd.Stdout = &stdout\n71\t\tcmd.Stderr = &stderr\n72\t\n73\t\tif err := cmd.Run(); err != nil {\n74\t\t\treturn nil, runFailure(req, err, stderr.String())\n75\t\t}\n76\t\n77\t\treturn readResponse(req, capture, stdout.Bytes())\n78\t}\n79\t\n80\t// writeOut is curl's `--write-out '%{json}'` payload, of which talaria reads\n81\t// two fields. It arrives as the whole of curl's stdout, so it is unmarshalled\n82\t// as one object rather than scanned for out of a mixed stream — the split that\n83\t// makes a response body impersonating this shape a non-event.\n84\ttype writeOut struct {\n85\t\tHTTPCode  int     `json:\"http_code\"`\n86\t\tTimeTotal float64 `json:\"time_total\"`\n87\t\tErrorMsg  string  `json:\"errormsg\"`\n88\t}\n89\t\n90\t// readResponse assembles the Response from curl's three output channels.\n91\tfunc readResponse(req *request.Request, capture Capture, stdout []byte) (*Response, error) {\n92\t\tvar meta writeOut\n93\t\tif err := json.Unmarshal(stdout, &meta); err != nil {\n94\t\t\treturn nil, clierr.RequestFailed(\"cannot parse curl's response metadata: %w\", err)\n95\t\t}\n96\t\n97\t\tbody, err := os.ReadFile(capture.BodyPath)\n98\t\tif err != nil {\n99\t\t\treturn nil, clierr.RequestFailed(\"cannot read the response body: %w\", err)\n100\t\t}\n101\t\n102\t\tdump, err := os.ReadFile(capture.HeaderPath)\n103\t\tif err != nil {\n104\t\t\treturn nil, clierr.RequestFailed(\"cannot read the response headers: %w\", err)\n105\t\t}\n106\t\n107\t\t// http_code is 0 when curl never got a response. That is a completed process\n108\t\t// with nothing observed, which is a failed request rather than an empty one.\n109\t\tif meta.HTTPCode == 0 {\n110\t\t\treturn nil, requestFailed(req, 0, meta.ErrorMsg)\n111\t\t}\n112\t\n113\t\treturn &Response{\n114\t\t\tStatus:   meta.HTTPCode,\n115\t\t\tHeaders:  parseHeaders(dump),\n116\t\t\tBody:     body,\n117\t\t\tTimingMS: int64(math.Round(meta.TimeTotal * 1000)),\n118\t\t}, nil\n119\t}\n120\t\n121\t// newCapture allocates the two files curl writes the response to, inside a 0700\n122\t// directory of their own. They hold response data, which may carry a session\n123\t// cookie or a token the API handed back, so they are never world-readable and\n124\t// never outlive the exec.\n125\tfunc newCapture() (Capture, func(), error) {\n126\t\tdir, err := os.MkdirTemp(\"\", \"talaria-call-*\")\n127\t\tif err != nil {\n128\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot stage the response: %w\", err)\n129\t\t}\n130\t\n131\t\tcleanup := func() { os.RemoveAll(dir) } //nolint:errcheck // Best effort; 0700 and in TMPDIR.\n132\t\n133\t\tif err := os.Chmod(dir, 0o700); err != nil {\n134\t\t\tcleanup()\n135\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot secure the response directory: %w\", err)\n136\t\t}\n137\t\n138\t\tcapture := Capture{\n139\t\t\tBodyPath:   filepath.Join(dir, \"body\"),\n140\t\t\tHeaderPath: filepath.Join(dir, \"headers\"),\n141\t\t}\n142\t\n143\t\t// Creating both up front means curl writes into a file that is already 0600,\n144\t\t// rather than one whose mode comes from curl's umask.\n145\t\tfor _, path := range []string{capture.BodyPath, capture.HeaderPath} {\n146\t\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)\n147\t\t\tif err != nil {\n148\t\t\t\tcleanup()\n149\t\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot stage the response: %w\", err)\n150\t\t\t}\n151\t\t\tif err := f.Close(); err != nil {\n152\t\t\t\tcleanup()\n153\t\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot stage the response: %w\", err)\n154\t\t\t}\n155\t\t}\n156\t\n157\t\treturn capture, cleanup, nil\n158\t}\n159\t\n160\t// parseHeaders turns curl's dump-header file into an http.Header, keeping only\n161\t// the last response block. Redirects and a 100 Continue each leave a block in\n162\t// front of the real one, and a stale Location reported as the response's own is\n163\t// worse than no Location at all.\n164\tfunc parseHeaders(dump []byte) http.Header {\n165\t\theaders := http.Header{}\n166\t\n167\t\tblocks := strings.Split(strings.ReplaceAll(string(dump), \"\\r\\n\", \"\\n\"), \"\\n\\n\")\n168\t\tlast := \"\"\n169\t\tfor _, block := range blocks {\n170\t\t\tif strings.TrimSpace(block) != \"\" {\n171\t\t\t\tlast = block\n172\t\t\t}\n173\t\t}\n174\t\n175\t\tfor _, line := range strings.Split(last, \"\\n\") {\n176\t\t\t// The status line is not a header; the Response's Status comes from\n177\t\t\t// %{json}, which does not need re-deriving from text.\n178\t\t\tif line == \"\" || strings.HasPrefix(line, \"HTTP/\") {\n179\t\t\t\tcontinue\n180\t\t\t}\n181\t\n182\t\t\tname, value, ok := strings.Cut(line, \":\")\n183\t\t\tif !ok {\n184\t\t\t\tcontinue\n185\t\t\t}\n186\t\t\theaders.Add(strings.TrimSpace(name), strings.TrimSpace(value))\n187\t\t}\n188\t\n189\t\treturn headers\n190\t}\n191\t\n192\t// runFailure classifies a curl process that did not exit 0.\n193\tfunc runFailure(req *request.Request, err error, stderr string) error {\n194\t\tvar exitErr *exec.ExitError\n195\t\tif errors.As(err, &exitErr) {\n196\t\t\treturn requestFailed(req, exitErr.ExitCode(), stderr)\n197\t\t}\n198\t\n199\t\treturn clierr.RequestFailed(\"cannot run curl: %w\", err)\n200\t}\n201\t\n202\t// requestFailed builds the error for a request curl could not complete, with\n203\t// curl's own exit status in it so an operator can look the code up.\n204\t//\n205\t// The detail passes through the request's scrubber first: curl echoes the URL\n206\t// it was given into several of its messages, and for an API-key scheme the URL\n207\t// is exactly where the credential is. §5a — errors are built from the redacted\n208\t// representation.\n209\tfunc requestFailed(req *request.Request, exitCode int, detail string) error {\n210\t\tdetail = strings.TrimSpace(scrubber(req).Replace(detail))\n211\t\tif detail == \"\" {\n212\t\t\treturn clierr.RequestFailed(\"the request could not be completed: curl exited %d\", exitCode)\n213\t\t}\n214\t\n215\t\treturn clierr.RequestFailed(\"the request could not be completed: curl exited %d: %s\", exitCode, detail)\n216\t}\n217\t\n218\t// scrubber returns a replacer that rewrites any credential this request\n219\t// resolved back into its <redacted:env:NAME> form.\n220\t//\n221\t// It works from the request's own refs rather than from a pattern over the\n222\t// text: talaria knows exactly which values it put on the wire, and matching\n223\t// those is neither a guess nor defeatable by an unusual message format. A\n224\t// credential that will not resolve was never sent and so cannot be echoed.\n225\tfunc scrubber(req *request.Request) *strings.Replacer {\n226\t\tif req == nil {\n227\t\t\treturn strings.NewReplacer()\n228\t\t}\n229\t\n230\t\tvar pairs []string\n231\t\tfor _, group := range [][]request.Pair{req.Headers, req.Query, req.Cookies} {\n232\t\t\tfor _, p := range group {\n233\t\t\t\tif !p.Value.IsSecret() {\n234\t\t\t\t\tcontinue\n235\t\t\t\t}\n236\t\n237\t\t\t\tresolved, err := p.Value.Ref().Resolve()\n238\t\t\t\tif err != nil || resolved == \"\" {\n239\t\t\t\t\tcontinue\n240\t\t\t\t}\n241\t\n242\t\t\t\tredacted := p.Value.Ref().String()\n243\t\t\t\tpairs = append(pairs, resolved, redacted)\n244\t\t\t\t// A credential echoed back as part of a URL is percent-encoded, which\n245\t\t\t\t// the literal form would walk straight past.\n246\t\t\t\tif encoded := url.QueryEscape(resolved); encoded != resolved {\n247\t\t\t\t\tpairs = append(pairs, encoded, redacted)\n248\t\t\t\t}\n249\t\t\t}\n250\t\t}\n251\t\n252\t\treturn strings.NewReplacer(pairs...)\n253\t}\n254\t"
