n:\"entry\"`\n60\t}\n61\t\n62\t// isolateHistory points the state directory at a fresh temp dir and returns the\n63\t// path the store will write to, so a test can assert on the file's absence as\n64\t// well as on its contents.\n65\tfunc isolateHistory(t *testing.T) string {\n66\t\tt.Helper()\n67\t\n68\t\tdir := t.TempDir()\n69\t\tt.Setenv(\"XDG_STATE_HOME\", dir)\n70\t\n71\t\treturn filepath.Join(dir, \"talaria\", \"history.jsonl\")\n72\t}\n73\t\n74\t// runHistory runs `history` with the same credential present as runCall, and\n75\t// fails the test if either stream carries it. History is a permanent artifact\n76\t// (§5a), so the leak check matters more here than anywhere else.\n77\tfunc runHistory(t *testing.T, args ...string) (code int, stdout, stderr string) {\n78\t\tt.Helper()\n79\t\tt.Setenv(spec.EnvSpec, \"\")\n80\t\tt.Setenv(\"TALARIA_AUTH_BEARER\", callCanary)\n81\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_PETKEY\", callCanary)\n82\t\n83\t\tvar out, errOut strings.Builder\n84\t\tcode = run(append([]string{\"history\"}, args...), &out, &errOut)\n85\t\tstdout, stderr = out.String(), errOut.String()\n86\t\n87\t\tif strings.Contains(stdout, callCanary) {\n88\t\t\tt.Fatalf(\"history leaked the credential on stdout:\\n%s\", stdout)\n89\t\t}\n90\t\tif strings.Contains(stderr, callCanary) {\n91\t\t\tt.Fatalf(\"history leaked the credential on stderr:\\n%s\", stderr)\n92\t\t}\n93\t\n94\t\treturn code, stdout, stderr\n95\t}\n96\t\n97\tfunc decodeHistoryList(t *testing.T, stdout string) historyListJSON {\n98\t\tt.Helper()\n99\t\n100\t\tvar got historyListJSON\n101\t\tif err := json.Unmarshal([]byte(stdout), &got); err != nil {\n102\t\t\tt.Fatalf(\"decoding %q: %v\", stdout, err)\n103\t\t}\n104\t\n105\t\treturn got\n106\t}\n107\t\n108\tfunc decodeHistoryShow(t *testing.T, stdout string) historyShowJSON {\n109\t\tt.Helper()\n110\t\n111\t\tvar got historyShowJSON\n112\t\tif err := json.Unmarshal([]byte(stdout), &got); err != nil {\n113\t\t\tt.Fatalf(\"decoding %q: %v\", stdout,