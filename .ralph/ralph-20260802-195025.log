{
  "type": "user",
  "message": {
    "role": "user",
    "content": [
      {
        "tool_use_id": "toolu_01Kp7poUVyrUaeEQubCL5f1o",
        "type": "tool_result",
        "content": "1\t// Package e2e drives the whole tool as one loop: a real binary, a real server,\n2\t// a real spec, in the order DESIGN.md §4 documents an agent working an API.\n3\t//\n4\t// Every other suite in this module tests one component against its own\n5\t// fixtures. This is the only one that proves component N's output actually\n6\t// reaches component N+1 — that the id `list` prints is the id `describe`\n7\t// accepts, that the curl `--dry-run` shows is the curl `call` runs, that a\n8\t// Swagger 2.0 document converted at load time survives all the way to the\n9\t// validator, and that the credential firewall holds across a whole session\n10\t// rather than one command at a time.\n11\tpackage e2e\n12\t\n13\timport (\n14\t\t\"encoding/json\"\n15\t\t\"errors\"\n16\t\t\"fmt\"\n17\t\t\"io\"\n18\t\t\"io/fs\"\n19\t\t\"net/http\"\n20\t\t\"net/http/httptest\"\n21\t\t\"os\"\n22\t\t\"os/exec\"\n23\t\t\"path/filepath\"\n24\t\t\"strings\"\n25\t\t\"sync\"\n26\t\t\"testing\"\n27\t\n28\t\t\"github.com/Teeeep/talaria/internal/canary\"\n29\t)\n30\t\n31\t// The two specs the suite drives, describing the same API: one OpenAPI 3.0,\n32\t// one Swagger 2.0. The same test server answers both, which is what makes the\n33\t// 2.0 run a test of the conversion rather than of a second API.\n34\tconst (\n35\t\tspecPath  = \"testdata/e2e-api.yaml\"\n36\t\tspec2Path = \"testdata/e2e-api-2.0.json\"\n37\t)\n38\t\n39\t// binary is the talaria under test, built once by TestMain.\n40\t//\n41\t// The suite drives a real process rather than the command tree in-process, for\n42\t// the reason the canary suite does: the tree lives in package main and cannot\n43\t// be imported. It is also the stronger reading of an end-to-end test — the exit\n44\t// codes asserted here are the ones a shell would see, and the streams scanned\n45\t// for a credential include anything written outside the writers a test would\n46\t// otherwise hand it.\n47\tvar binary string\n48\t\n49\tfunc TestMain(m *testing.M) {\n50\t\tdir, err := os.MkdirTemp(\"\", \"talaria-e2e-*\")\n51\t\tif err != nil {\n52\t\t\tfmt.Fprintf(os.Stderr, \"creating the build directory: %v\\n\", err)\n53\t\t\tos.Exit(1)\n54\t\t}\n55\t\n56\t\tif err := readSources(); err != nil {\n57\t\t\tfmt.Fprintf(os.Stderr, \"reading the sources under test: %v\\n\", err)\n58\t\t\tos.Exit(1)\n59\t\t}\n60\t\n61\t\tbinary = filepath.Join(dir, \"talaria\")\n62\t\tbuild := exec.Command(\"go\", \"build\", \"-o\", binary, \"./cmd/talaria\")\n63\t\tbuild.Dir = filepath.Join(\"..\", \"..\")\n64\t\tif out, err := build.CombinedOutput(); err != nil {\n65\t\t\tfmt.Fprintf(os.Stderr, \"building talaria: %v\\n%s\", err, out)\n66\t\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n67\t\t\tos.Exit(1)\n68\t\t}\n69\t\n70\t\tcode := m.Run()\n71\t\n72\t\t// Explicit rather than deferred: os.Exit does not run defers.\n73\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n74\t\tos.Exit(code)\n75\t}\n76\t\n77\t// readSources opens every Go source file in the module so the test cache knows\n78\t// this suite depends on all of them.\n79\t//\n80\t// The dependency is real but invisible to the tool: the suite reaches the code\n81\t// under test by building a binary in a subprocess, and `go test` records\n82\t// nothing about that. Without this, a break anywhere in cmd/ or internal/ would\n83\t// leave this package's own inputs untouched and `go test ./...` would replay a\n84\t// cached pass over code that never ran.\n85\tfunc readSources() error {\n86\t\troot := filepath.Join(\"..\", \"..\")\n87\t\n88\t\treturn filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {\n89\t\t\tif err != nil || d.IsDir() || !strings.HasSuffix(path, \".go\") {\n90\t\t\t\treturn err\n91\t\t\t}\n92\t\n93\t\t\t_, err = os.ReadFile(path)\n94\t\n95\t\t\treturn err\n96\t\t})\n97\t}\n98\t\n99\t// result is one talaria invocation.\n100\ttype result struct {\n101\t\targs   []string\n102\t\tcode   int\n103\t\tstdout string\n104\t\tstderr string\n105\t}\n106\t\n107\t// label renders the invocation for a failure message.\n108\tfunc (r result) label() string { return \"talaria \" + strings.Join(r.args, \" \") }\n109\t\n110\t// surfaces returns both streams of a result as scannable surfaces.\n111\tfunc (r result) surfaces() []canary.Surface {\n112\t\treturn []canary.Surface{\n113\t\t\tcanary.Stream(\"stdout of `\"+r.label()+\"`\", r.stdout),\n114\t\t\tcanary.Stream(\"stderr of `\"+r.label()+\"`\", r.stderr),\n115\t\t}\n116\t}\n117\t\n118\t// harness runs talaria against an isolated home, so history, cache and config\n119\t// belong to the test rather than to the developer, and the only credentials in\n120\t// reach are the ones the case injected.\n121\ttype harness struct {\n122\t\tt     *testing.T\n123\t\tenv   []string\n124\t\tstate string\n125\t\tcache string\n126\t\tconf  string\n127\t}\n128\t\n129\tfunc newHarness(t *testing.T, vars map[string]string) *harness {\n130\t\tt.Helper()\n131\t\n132\t\thome := t.TempDir()\n133\t\th := &harness{\n134\t\t\tt:     t,\n135\t\t\tstate: filepath.Join(home, \"state\"),\n136\t\t\tcache: filepath.Join(home, \"cache\"),\n137\t\t\tconf:  filepath.Join(home, \"config\"),\n138\t\t}\n139\t\n140\t\t// Built from nothing rather than from os.Environ: a developer's own\n141\t\t// TALARIA_AUTH_BEARER or TALARIA_SPEC must not be able to change what this\n142\t\t// suite tests, and PATH is all curl needs to be found.\n143\t\th.env = []string{\n144\t\t\t\"PATH=\" + os.Getenv(\"PATH\"),\n145\t\t\t\"HOME=\" + home,\n146\t\t\t\"XDG_STATE_HOME=\" + h.state,\n147\t\t\t\"XDG_CACHE_HOME=\" + h.cache,\n148\t\t\t\"XDG_CONFIG_HOME=\" + h.conf,\n149\t\t}\n150\t\tfor name, value := range vars {\n151\t\t\th.env = append(h.env, name+\"=\"+value)\n152\t\t}\n153\t\n154\t\treturn h\n155\t}\n156\t\n157\t// run executes talaria and captures both streams and the exit code.\n158\tfunc (h *harness) run(args ...string) result {\n159\t\th.t.Helper()\n160\t\n161\t\tcmd := exec.Command(binary, args...)\n162\t\tcmd.Env = h.env\n163\t\n164\t\tvar stdout, stderr strings.Builder\n165\t\tcmd.Stdout, cmd.Stderr = &stdout, &stderr\n166\t\n167\t\tcode := 0\n168\t\tif err := cmd.Run(); err != nil {\n169\t\t\tvar exit *exec.ExitError\n170\t\t\tif !errors.As(err, &exit) {\n171\t\t\t\th.t.Fatalf(\"running talaria %s: %v\", strings.Join(args, \" \"), err)\n172\t\t\t}\n173\t\t\tcode = exit.ExitCode()\n174\t\t}\n175\t\n176\t\treturn result{args: args, code: code, stdout: stdout.String(), stderr: stderr.String()}\n177\t}\n178\t\n179\t// runOK runs talaria and fails the test unless it exited 0. A step of a\n180\t// workflow that did not succeed makes every assertion after it meaningless, so\n181\t// this is fatal rather than an error.\n182\tfunc (h *harness) runOK(args ...string) result {\n183\t\th.t.Helper()\n184\t\n185\t\tres := h.run(args...)\n186\t\tif res.code != 0 {\n187\t\t\th.t.Fatalf(\"`%s` = %d, want 0; stderr: %s\", res.label(), res.code, res.stderr)\n188\t\t}\n189\t\n190\t\treturn res\n191\t}\n192\t\n193\t// written returns every file talaria left behind — the history store, the spec\n194\t// cache — as surfaces to scan. Enumerated by walking rather than by name, so a\n195\t// new persistent artifact is covered the day it appears.\n196\tfunc (h *harness) written() []canary.Surface {\n197\t\th.t.Helper()\n198\t\n199\t\tvar surfaces []canary.Surface\n200\t\tfor label, root := range map[string]string{\"history\": h.state, \"cache\": h.cache} {\n201\t\t\tfound, err := canary.Tree(label, root)\n202\t\t\tif err != nil {\n203\t\t\t\th.t.Fatalf(\"enumerating the %s surfaces: %v\", label, err)\n204\t\t\t}\n205\t\t\tsurfaces = append(surfaces, found...)\n206\t\t}\n207\t\n208\t\treturn surfaces\n209\t}\n210\t\n211\t// The bodies the test server answers with. brokenPet is the one that matters:\n212\t// it is a 200 the spec documents, carrying a body the spec's Pet schema does\n213\t// not allow — an integer id and no name — so it separates \"the server is down\"\n214\t// from \"the server disagrees with its own documentation\".\n215\tconst (\n216\t\tonePet     = `{\"id\":\"42\",\"name\":\"Rex\"}`\n217\t\tbrokenPet  = `{\"id\":7}`\n218\t\tcreatedPet = `{\"id\":\"43\",\"name\":\"Rex\"}`\n219\t)\n220\t\n221\t// recordedRequest is one request as it arrived at the test server.\n222\ttype recordedRequest struct {\n223\t\tMethod string\n224\t\tPath   string\n225\t\tHeader http.Header\n226\t\tBody   string\n227\t}\n228\t\n229\t// server is the API both specs describe.\n230\ttype server struct {\n231\t\t*httptest.Server\n232\t\n233\t\tmu       sync.Mutex\n234\t\treceived []recordedRequest\n235\t}\n236\t\n237\t// newServer starts the API. The routes are exactly the paths both fixtures\n238\t// declare, so a request talaria built from either spec lands on the same\n239\t// handler and gets the same body.\n240\tfunc newServer(t *testing.T) *server {\n241\t\tt.Helper()\n242\t\n243\t\tsrv := &server{}\n244\t\tmux := http.NewServeMux()\n245\t\n246\t\tmux.HandleFunc(\"GET /pets\", srv.answer(http.StatusOK, `[`+onePet+`]`))\n247\t\tmux.HandleFunc(\"POST /pets\", srv.answer(http.StatusCreated, createdPet))\n248\t\tmux.HandleFunc(\"GET /pets/{petId}\", srv.answer(http.StatusOK, onePet))\n249\t\tmux.HandleFunc(\"GET /broken\", srv.answer(http.StatusOK, brokenPet))\n250\t\tmux.HandleFunc(\"GET /secure\", srv.answer(http.StatusOK, onePet))\n251\t\n252\t\tsrv.Server = httptest.NewServer(mux)\n253\t\tt.Cleanup(srv.Close)\n254\t\n255\t\treturn srv\n256\t}\n257\t\n258\t// answer records the request and writes a fixed JSON response.\n259\tfunc (s *server) answer(status int, body string) http.HandlerFunc {\n260\t\treturn func(w http.ResponseWriter, r *http.Request) {\n261\t\t\tread, _ := io.ReadAll(r.Body)\n262\t\n263\t\t\ts.mu.Lock()\n264\t\t\ts.received = append(s.received, recordedRequest{\n265\t\t\t\tMethod: r.Method,\n266\t\t\t\tPath:   r.URL.Path,\n267\t\t\t\tHeader: r.Header.Clone(),\n268\t\t\t\tBody:   string(read),\n269\t\t\t})\n270\t\t\ts.mu.Unlock()\n271\t\n272\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n273\t\t\tw.WriteHeader(status)\n274\t\t\t_, _ = io.WriteString(w, body)\n275\t\t}\n276\t}\n277\t\n278\t// requests returns everything the server has been asked for so far.\n279\tfunc (s *server) requests() []recordedRequest {\n280\t\ts.mu.Lock()\n281\t\tdefer s.mu.Unlock()\n282\t\n283\t\treturn append([]recordedRequest(nil), s.received...)\n284\t}\n285\t\n286\t// sawHeader reports whether any request carried the given header value. It is\n287\t// what makes the leak assertions mean something: a talaria that quietly sent no\n288\t// credential at all would pass every one of them.\n289\tfunc (s *server) sawHeader(name, value string) bool {\n290\t\tfor _, req := range s.requests() {\n291\t\t\tif req.Header.Get(name) == value {\n292\t\t\t\treturn true\n293\t\t\t}\n294\t\t}\n295\t\n296\t\treturn false\n297\t}\n298\t\n299\t// The JSON payloads the suite reads. They are deliberately partial: each holds\n300\t// the fields one step hands to the next, and nothing else, so a field added\n301\t// elsewhere does not have to be mirrored here.\n302\ttype listView struct {\n303\t\tOperations []struct {\n304\t\t\tID      string `json:\"id\"`\n305\t\t\tMethod  string `json:\"method\"`\n306\t\t\tPath    string `json:\"path\"`\n307\t\t\tSummary string `json:\"summary\"`\n308\t\t} `json:\"operations\"`\n309\t}\n310\t\n311\ttype searchView struct {\n312\t\tQuery   string `json:\"query\"`\n313\t\tResults []struct {\n314\t\t\tKind  string `json:\"kind\"`\n315\t\t\tName  string `json:\"name\"`\n316\t\t\tWhere string `json:\"where\"`\n317\t\t} `json:\"results\"`\n318\t}\n319\t\n320\ttype describeView struct {\n321\t\tID     string `json:\"id\"`\n322\t\tMethod string `json:\"method\"`\n323\t\tPath   string `json:\"path\"`\n324\t\tParams []struct {\n325\t\t\tName     string `json:\"name\"`\n326\t\t\tIn       string `json:\"in\"`\n327\t\t\tRequired bool   `json:\"required\"`\n328\t\t} `json:\"params\"`\n329\t\tResponses []struct {\n330\t\t\tStatus string `json:\"status\"`\n331\t\t} `json:\"responses\"`\n332\t}\n333\t\n334\ttype callVw struct {\n335\t\tDryRun  bool `json:\"dry_run\"`\n336\t\tRequest struct {\n337\t\t\tCurl   string `json:\"curl\"`\n338\t\t\tMethod string `json:\"method\"`\n339\t\t\tURL    string `json:\"url\"`\n340\t\t\tBody   string `json:\"body\"`\n341\t\t} `json:\"request\"`\n342\t\tResponse *struct {\n343\t\t\tStatus int             `json:\"status\"`\n344\t\t\tBody   json.RawMessage `json:\"body\"`\n345\t\t} `json:\"response\"`\n346\t\tValidation *struct {\n347\t\t\tStatusDocumented      bool `json:\"status_documented\"`\n348\t\t\tContentTypeDocumented bool `json:\"content_type_documented\"`\n349\t\t\tBodyValid             bool `json:\"body_valid\"`\n350\t\t\tErrors                []struct {\n351\t\t\t\tMessage string `json:\"message\"`\n352\t\t\t\tField   string `json:\"field\"`\n353\t\t\t} `json:\"errors\"`\n354\t\t} `json:\"validation\"`\n355\t}\n356\t\n357\ttype historyView struct {\n358\t\tEntries []struct {\n359\t\t\tIndex       int    `json:\"index\"`\n360\t\t\tSource      string `json:\"source\"`\n361\t\t\tOperationID string `json:\"operation_id\"`\n362\t\t\tMethod      string `json:\"method\"`\n363\t\t\tPath        string `json:\"path\"`\n364\t\t\tURL         string `json:\"url\"`\n365\t\t\tStatus      int    `json:\"status\"`\n366\t\t} `json:\"entries\"`\n367\t}\n368\t\n369\ttype runView struct {\n370\t\tResults []struct {\n371\t\t\tOperationID string `json:\"operation_id\"`\n372\t\t\tMethod      string `json:\"method\"`\n373\t\t\tPath        string `json:\"path\"`\n374\t\t\tOutcome     string `json:\"outcome\"`\n375\t\t\tReason      string `json:\"reason\"`\n376\t\t\tStatus      int    `json:\"status\"`\n377\t\t} `json:\"results\"`\n378\t\tSummary struct {\n379\t\t\tTotal   int `json:\"total\"`\n380\t\t\tPassed  int `json:\"passed\"`\n381\t\t\tFailed  int `json:\"failed\"`\n382\t\t\tSkipped int `json:\"skipped\"`\n383\t\t} `json:\"summary\"`\n384\t}\n385\t\n386\t// decode reads one command's JSON output into the view it renders.\n387\tfunc decode[T any](t *testing.T, res result) T {\n388\t\tt.Helper()\n389\t\n390\t\tvar out T\n391\t\tif err := json.Unmarshal([]byte(res.stdout), &out); err != nil {\n392\t\t\tt.Fatalf(\"decoding the output of `%s`: %v\\nstdout: %s\", res.label(), err, res.stdout)\n393\t\t}\n394\t\n395\t\treturn out\n396\t}\n397\t\n398\t// TestTheDocumentedAgentWorkflowRunsEndToEnd walks the sequence from DESIGN.md\n399\t// §4 against one spec and one server, asserting at each step that what came out\n400\t// is what the next step needs.\n401\t//\n402\t// The steps are not independent and are deliberately not subtests: history is\n403\t// built by the calls before it, and a `describe` that took an id `list` did not\n404\t// print would prove nothing about either.\n405\tfunc TestTheDocumentedAgentWorkflowRunsEndToEnd(t *testing.T) {\n406\t\tt.Parallel()\n407\t\n408\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": \"e2e-workflow-token\"})\n409\t\tsrv := newServer(t)\n410\t\n411\t\t// 1. list — the agent's entry point: what can this API do?\n412\t\tlisted := decode[listView](t, h.runOK(\"list\", specPath, \"--output\", \"json\"))\n413\t\tid := \"\"\n414\t\tfor _, op := range listed.Operations {\n415\t\t\tif op.Method == http.MethodGet && op.Path == \"/pets\" {\n416\t\t\t\tid = op.ID\n417\t\t\t}\n418\t\t}\n419\t\tif id == \"\" {\n420\t\t\tt.Fatalf(\"`list` printed no id for GET /pets: %+v\", listed.Operations)\n421\t\t}\n422\t\n423\t\t// 2. search — the same operation, found by a word rather than by reading\n424\t\t// the whole list. It must name the same id, because that is what the agent\n425\t\t// carries to the next command.\n426\t\tfound := decode[searchView](t, h.runOK(\"search\", specPath, \"pet\", \"--output\", \"json\"))\n427\t\tif !namesOperation(found, id) {\n428\t\t\tt.Fatalf(\"`search pet` does not name %q as an operation: %+v\", id, found.Results)\n429\t\t}\n430\t\n431\t\t// 3. describe — the id from step 1 is accepted verbatim.\n432\t\tdescribed := decode[describeView](t, h.runOK(\"describe\", specPath, id, \"--output\", \"json\"))\n433\t\tif described.ID != id || described.Path != \"/pets\" {\n434\t\t\tt.Fatalf(\"`describe %s` describes %s %s, not GET /pets\", id, described.Method, described.Path)\n435\t\t}\n436\t\tif len(described.Responses) == 0 {\n437\t\t\tt.Errorf(\"`describe %s` reports no responses, so there is no contract to call against\", id)\n438\t\t}\n439\t\n440\t\t// 4. call --dry-run — the request, sent nowhere.\n441\t\tdry := decode[callVw](t, h.runOK(\"call\", specPath, id,\n442\t\t\t\"--base-url\", srv.URL, \"--output\", \"json\", \"--dry-run\"))\n443\t\tif !dry.DryRun || dry.Response != nil {\n444\t\t\tt.Fatalf(\"`call --dry-run` reported dry_run=%v with a response block=%v\",\n445\t\t\t\tdry.DryRun, dry.Response != nil)\n446\t\t}\n447\t\tif len(srv.requests()) != 0 {\n448\t\t\tt.Fatalf(\"`call --dry-run` reached the server %d time(s)\", len(srv.requests()))\n449\t\t}\n450\t\n451\t\t// 5. call — the same request, sent. The curl the dry run showed is the curl\n452\t\t// the real call ran: that equality is the whole claim of --dry-run.\n453\t\tcalled := decode[callVw](t, h.runOK(\"call\", specPath, id, \"--base-url\", srv.URL, \"--output\", \"json\"))\n454\t\tif called.Request.Curl != dry.Request.Curl {\n455\t\t\tt.Errorf(\"the real call ran a different command than --dry-run previewed:\\n dry: %s\\nreal: %s\",\n456\t\t\t\tdry.Request.Curl, called.Request.Curl)\n457\t\t}\n458\t\tif called.Response == nil || called.Response.Status != http.StatusOK {\n459\t\t\tt.Fatalf(\"`call %s` did not observe a 200: %s\", id, called.stdoutOf())\n460\t\t}\n461\t\tif called.Validation == nil || !called.Validation.BodyValid {\n462\t\t\tt.Errorf(\"the server's documented response did not validate: %+v\", called.Validation)\n463\t\t}\n464\t\n465\t\t// 6. history — the call is on the record, under the id it was made with.\n466\t\tlistedHistory := decode[historyView](t, h.runOK(\"history\", \"--output\", \"json\"))\n467\t\tif len(listedHistory.Entries) != 1 {\n468\t\t\tt.Fatalf(\"history holds %d entries after one call and one dry run, want 1: %+v\",\n469\t\t\t\tlen(listedHistory.Entries), listedHistory.Entries)\n470\t\t}\n471\t\tentry := listedHistory.Entries[0]\n472\t\tif entry.Index != 1 || entry.OperationID != id || entry.Status != http.StatusOK {\n473\t\t\tt.Fatalf(\"history entry 1 is %+v, want index 1, operation %q, status 200\", entry, id)\n474\t\t}\n475\t\n476\t\t// 7. history replay — the index `history` printed is the index `replay`\n477\t\t// takes, and it re-issues the call without the spec being named again.\n478\t\treplayed := decode[callVw](t, h.runOK(\"history\", \"replay\", \"1\", \"--output\", \"json\"))\n479\t\tif replayed.Response == nil || replayed.Response.Status != http.StatusOK {\n480\t\t\tt.Fatalf(\"`history replay 1` did not observe a 200: %s\", replayed.stdoutOf())\n481\t\t}\n482\t\tif replayed.Request.URL != called.Request.URL {\n483\t\t\tt.Errorf(\"the replay called %s, the original called %s\", replayed.Request.URL, called.Request.URL)\n484\t\t}\n485\t\n486\t\t// 8. run — the same operation as a smoke test, selected by the same id.\n487\t\treport := decode[runView](t, h.runOK(\"run\", specPath,\n488\t\t\t\"--operation\", id, \"--base-url\", srv.URL, \"--report\", \"json\"))\n489\t\tif report.Summary.Total != 1 || report.Summary.Passed != 1 {\n490\t\t\tt.Fatalf(\"`run --operation %s` summarised %+v, want 1 total and 1 passed\", id, report.Summary)\n491\t\t}\n492\t\tif report.Results[0].OperationID != id {\n493\t\t\tt.Errorf(\"`run` reported %q, not the operation it was asked for\", report.Results[0].OperationID)\n494\t\t}\n495\t\n496\t\t// The replay is on the record too, so the store grew across the session\n497\t\t// rather than being rewritten by each command.\n498\t\tfinal := decode[historyView](t, h.runOK(\"history\", \"--output\", \"json\"))\n499\t\tif len(final.Entries) != 3 {\n500\t\t\tt.Errorf(\"history holds %d entries after a call, a replay and a run, want 3: %+v\",\n501\t\t\t\tlen(final.Entries), final.Entries)\n502\t\t}\n503\t}\n504\t\n505\t// stdoutOf renders a decoded call for a failure message. The view is what was\n506\t// parsed rather than the raw bytes, which is enough to see what came back and\n507\t// carries no field the parse dropped.\n508\tfunc (v callVw) stdoutOf() string {\n509\t\tout, err := json.Marshal(v)\n510\t\tif err != nil {\n511\t\t\treturn fmt.Sprintf(\"%+v\", v)\n512\t\t}\n513\t\n514\t\treturn string(out)\n515\t}\n516\t\n517\t// namesOperation reports whether a search result set names id as an operation.\n518\tfunc namesOperation(found searchView, id string) bool {\n519\t\tfor _, res := range found.Results {\n520\t\t\tif res.Kind == \"operation\" && res.Name == id {\n521\t\t\t\treturn true\n522\t\t\t}\n523\t\t}\n524\t\n525\t\treturn false\n526\t}\n527\t\n528\t// TestNoStepOfTheWorkflowLeaksTheCredential runs the whole sequence with a\n529\t// canary in the environment and greps every surface it produced.\n530\t//\n531\t// The canary suite proves each command redacts. This proves the *session* does:\n532\t// a credential that survived one command's redaction and was written down by\n533\t// the next would pass there and fail here.\n534\tfunc TestNoStepOfTheWorkflowLeaksTheCredential(t *testing.T) {\n535\t\tt.Parallel()\n536\t\n537\t\tvalue := canary.Value(\"e2e\")\n538\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n539\t\tsrv := newServer(t)\n540\t\n541\t\truns := []result{\n542\t\t\th.runOK(\"list\", specPath, \"--output\", \"json\"),\n543\t\t\th.runOK(\"search\", specPath, \"pet\", \"--output\", \"json\"),\n544\t\t\th.runOK(\"describe\", specPath, \"listPets\", \"--output\", \"json\"),\n545\t\t\th.runOK(\"call\", specPath, \"listPets\", \"--base-url\", srv.URL, \"--dry-run\", \"--output\", \"json\"),\n546\t\t\th.runOK(\"call\", specPath, \"listPets\", \"--base-url\", srv.URL, \"--output\", \"json\"),\n547\t\t\th.runOK(\"history\", \"--output\", \"json\"),\n548\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", \"json\"),\n549\t\t\th.runOK(\"history\", \"replay\", \"1\", \"--output\", \"json\"),\n550\t\t\t// Exits 5: secureKey is unset. The report is written on the way to that\n551\t\t\t// exit code, with the bearer canary in reach the whole time.\n552\t\t\th.run(\"auth\", \"check\", specPath, \"--output\", \"json\"),\n553\t\t\th.runOK(\"run\", specPath, \"--operation\", \"listPets\", \"--base-url\", srv.URL, \"--report\", \"json\"),\n554\t\t\t// A failure surface, because §5a's rule is that error paths are where\n555\t\t\t// redaction bugs live.\n556\t\t\th.run(\"call\", specPath, \"getBroken\", \"--base-url\", srv.URL, \"--fail-on-error\", \"--output\", \"json\"),\n557\t\t}\n558\t\n559\t\t// The credential reached the server. Without this the assertions below\n560\t\t// would pass just as well against a talaria that sent nothing.\n561\t\tif !srv.sawHeader(\"Authorization\", \"Bearer \"+value) {\n562\t\t\tt.Fatalf(\"the server never saw the bearer credential; the leak assertions below prove nothing\")\n563\t\t}\n564\t\n565\t\tvar surfaces []canary.Surface\n566\t\tfor _, res := range runs {\n567\t\t\tif strings.TrimSpace(res.stdout) == \"\" {\n568\t\t\t\tt.Errorf(\"`%s` printed nothing; there is no surface here to check\", res.label())\n569\t\t\t}\n570\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n571\t\t}\n572\t\tsurfaces = append(surfaces, h.written()...)\n573\t\n574\t\tleaks := canary.Scan(value, surfaces...)\n575\t\tif len(leaks) == 0 {\n576\t\t\treturn\n577\t\t}\n578\t\n579\t\tvar names []string\n580\t\tfor _, leak := range leaks {\n581\t\t\tnames = append(names, leak.String())\n582\t\t}\n583\t\tt.Errorf(\"the canary reached %d surface(s) across the workflow:\\n  %s\",\n584\t\t\tlen(leaks), strings.Join(names, \"\\n  \"))\n585\t}\n586\t\n587\t// TestAMutationIsRefusedWithoutAllowMutationsAtBothLevels holds the safety rail\n588\t// DESIGN.md §4 puts in the tool rather than in the prompt, at each of the two\n589\t// places a request can be issued from.\n590\tfunc TestAMutationIsRefusedWithoutAllowMutationsAtBothLevels(t *testing.T) {\n591\t\tt.Parallel()\n592\t\n593\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": \"e2e-mutation-token\"})\n594\t\tsrv := newServer(t)\n595\t\n596\t\t// `call`: refused before anything is built, so nothing reaches the server.\n597\t\trefused := h.run(\"call\", specPath, \"createPet\", \"--base-url\", srv.URL,\n598\t\t\t\"--body\", `{\"name\":\"Rex\"}`, \"--output\", \"json\")\n599\t\tif refused.code != 2 {\n600\t\t\tt.Errorf(\"`%s` = %d, want 2; stderr: %s\", refused.label(), refused.code, refused.stderr)\n601\t\t}\n602\t\tif !strings.Contains(refused.stderr, \"--allow-mutations\") {\n603\t\t\tt.Errorf(\"the refusal does not name the flag that lifts it: %s\", refused.stderr)\n604\t\t}\n605\t\tif len(srv.requests()) != 0 {\n606\t\t\tt.Fatalf(\"a refused mutation still reached the server %d time(s)\", len(srv.requests()))\n607\t\t}\n608\t\n609\t\t// `call --allow-mutations`: the same request, sent.\n610\t\tallowed := decode[callVw](t, h.runOK(\"call\", specPath, \"createPet\", \"--base-url\", srv.URL,\n611\t\t\t\"--body\", `{\"name\":\"Rex\"}`, \"--allow-mutations\", \"--output\", \"json\"))\n612\t\tif allowed.Response == nil || allowed.Response.Status != http.StatusCreated {\n613\t\t\tt.Fatalf(\"the allowed mutation did not observe a 201: %s\", allowed.stdoutOf())\n614\t\t}\n615\t\tif got := srv.requests(); len(got) != 1 || got[0].Method != http.MethodPost {\n616\t\t\tt.Fatalf(\"the server saw %+v, want one POST\", got)\n617\t\t}\n618\t\n619\t\t// `run`: the same gate, reported as a skip rather than a failure — a DELETE\n620\t\t// left alone is correct behaviour, not a broken API.\n621\t\tskipped := decode[runView](t, h.runOK(\"run\", specPath, \"--operation\", \"createPet\",\n622\t\t\t\"--base-url\", srv.URL, \"--report\", \"json\"))\n623\t\tif skipped.Summary.Skipped != 1 || skipped.Summary.Passed != 0 {\n624\t\t\tt.Fatalf(\"`run` on a mutation summarised %+v, want 1 skipped\", skipped.Summary)\n625\t\t}\n626\t\tif !strings.Contains(skipped.Results[0].Reason, \"--allow-mutations\") {\n627\t\t\tt.Errorf(\"the skip does not name the flag that lifts it: %q\", skipped.Results[0].Reason)\n628\t\t}\n629\t\n630\t\t// `run --allow-mutations`: included, called, and validated against the\n631\t\t// spec's 201 contract.\n632\t\tincluded := decode[runView](t, h.runOK(\"run\", specPath, \"--operation\", \"createPet\",\n633\t\t\t\"--base-url\", srv.URL, \"--allow-mutations\", \"--report\", \"json\"))\n634\t\tif included.Summary.Passed != 1 {\n635\t\t\tt.Fatalf(\"`run --allow-mutations` summarised %+v, want 1 passed: %s\",\n636\t\t\t\tincluded.Summary, included.Results[0].Reason)\n637\t\t}\n638\t\tif got := srv.requests(); len(got) != 2 {\n639\t\t\tt.Fatalf(\"the server saw %d requests, want 2 (one from call, one from run)\", len(got))\n640\t\t}\n641\t}\n642\t\n643\t// TestTheExitCodeContractIsObservableAcrossOneSpec covers the codes an agent\n644\t// branches on, against the same spec and the same server, so the mapping is\n645\t// proved to be a property of what happened rather than of which fixture was\n646\t// loaded (DESIGN.md §4).\n647\t//\n648\t// Codes 1 and 3 are absent by design: a request that cannot complete and a spec\n649\t// that cannot be read are failures *before* the loop this suite is about, and\n650\t// both are covered where they happen.\n651\tfunc TestTheExitCodeContractIsObservableAcrossOneSpec(t *testing.T) {\n652\t\tt.Parallel()\n653\t\n654\t\t// bearerAuth is set and secureKey is not, so the same spec produces both a\n655\t\t// successful call and an unsatisfiable operation.\n656\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": \"e2e-exitcode-token\"})\n657\t\tsrv := newServer(t)\n658\t\n659\t\tcases := []struct {\n660\t\t\tname string\n661\t\t\targs []string\n662\t\t\tcode int\n663\t\t\twhy  string\n664\t\t}{\n665\t\t\t{\n666\t\t\t\tname: \"0 the call succeeded\",\n667\t\t\t\targs: []string{\"call\", specPath, \"listPets\", \"--base-url\", srv.URL, \"--output\", \"json\"},\n668\t\t\t\tcode: 0,\n669\t\t\t\twhy:  \"a documented 200 that matches its schema\",\n670\t\t\t},\n671\t\t\t{\n672\t\t\t\tname: \"2 the invocation was wrong\",\n673\t\t\t\targs: []string{\"call\", specPath, \"noSuchOperation\", \"--base-url\", srv.URL, \"--output\", \"json\"},\n674\t\t\t\tcode: 2,\n675\t\t\t\twhy:  \"an operationId the spec does not declare\",\n676\t\t\t},\n677\t\t\t{\n678\t\t\t\tname: \"4 the response violates the spec\",\n679\t\t\t\targs: []string{\"call\", specPath, \"getBroken\", \"--base-url\", srv.URL,\n680\t\t\t\t\t\"--fail-on-error\", \"--output\", \"json\"},\n681\t\t\t\tcode: 4,\n682\t\t\t\twhy:  \"a documented 200 carrying a body the schema forbids\",\n683\t\t\t},\n684\t\t\t{\n685\t\t\t\tname: \"5 a credential is missing\",\n686\t\t\t\targs: []string{\"auth\", \"check\", specPath, \"--output\", \"json\"},\n687\t\t\t\tcode: 5,\n688\t\t\t\twhy:  \"getSecure needs secureKey and nothing sets it\",\n689\t\t\t},\n690\t\t}\n691\t\n692\t\tfor _, tc := range cases {\n693\t\t\tres := h.run(tc.args...)\n694\t\t\tif res.code != tc.code {\n695\t\t\t\tt.Errorf(\"`%s` = %d, want %d (%s); stderr: %s\",\n696\t\t\t\t\tres.label(), res.code, tc.code, tc.why, res.stderr)\n697\t\t\t}\n698\t\t\t// Every non-zero code is an error an agent reads, so it comes with a\n699\t\t\t// structured message rather than a bare code.\n700\t\t\tif tc.code != 0 && !strings.Contains(res.stderr, `\"code\":`) {\n701\t\t\t\tt.Errorf(\"`%s` exited %d with no structured error on stderr: %q\",\n702\t\t\t\t\tres.label(), res.code, res.stderr)\n703\t\t\t}\n704\t\t}\n705\t\n706\t\t// Code 4 is a verdict about the body, not about the transport: the same\n707\t\t// call without --fail-on-error is a successful observation, and the\n708\t\t// violations are on stdout either way.\n709\t\tobserved := decode[callVw](t, h.runOK(\"call\", specPath, \"getBroken\",\n710\t\t\t\"--base-url\", srv.URL, \"--output\", \"json\"))\n711\t\tif observed.Validation == nil || len(observed.Validation.Errors) == 0 {\n712\t\t\tt.Fatalf(\"the broken response validated clean, so exit 4 above was not about the body: %s\",\n713\t\t\t\tobserved.stdoutOf())\n714\t\t}\n715\t}\n716\t\n717\t// TestASwagger2SpecFlowsThroughTheWholeLoop repeats the core of the workflow\n718\t// against the same API described as Swagger 2.0.\n719\t//\n720\t// Conversion happens once, at load time (DESIGN.md §5). This is what proves its\n721\t// output actually reaches everything downstream: the operation model reads it,\n722\t// the curl builder binds a path parameter and a converted security scheme from\n723\t// it, the executor sends the result, and the validator checks the response\n724\t// against the converted response schema — including catching a violation of it.\n725\tfunc TestASwagger2SpecFlowsThroughTheWholeLoop(t *testing.T) {\n726\t\tt.Parallel()\n727\t\n728\t\tvalue := canary.Value(\"swagger2\")\n729\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_APIKEY_APIKEY\": value})\n730\t\tsrv := newServer(t)\n731\t\n732\t\t// The operation model, built from the converted document.\n733\t\tlisted := decode[listView](t, h.runOK(\"list\", spec2Path, \"--output\", \"json\"))\n734\t\tif len(listed.Operations) != 4 {\n735\t\t\tt.Fatalf(\"the converted 2.0 spec has %d operations, want 4: %+v\",\n736\t\t\t\tlen(listed.Operations), listed.Operations)\n737\t\t}\n738\t\n739\t\t// The converted parameter: `type: string` in 2.0 becomes a schema in 3.x,\n740\t\t// and `describe` reads it as one.\n741\t\tdescribed := decode[describeView](t, h.runOK(\"describe\", spec2Path, \"getPet\", \"--output\", \"json\"))\n742\t\tif described.Path != \"/pets/{petId}\" || len(described.Params) != 1 {\n743\t\t\tt.Fatalf(\"`describe getPet` on the converted spec reports %s with %d p