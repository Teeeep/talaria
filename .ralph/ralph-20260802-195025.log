          "+func TestBuildConfigUsesTheHeadFlagForHEAD(t *testing.T) {",
          "+  dir := t.TempDir()",
          "+  capture := Capture{",
          "+    BodyPath:   filepath.Join(dir, \"body\"),",
          "+    HeaderPath: filepath.Join(dir, \"headers\"),",
