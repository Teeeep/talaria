    "content": [
      {
        "tool_use_id": "toolu_01DAuDMKVTwyK2CHnHrWudMd",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"io\"\n5\t\n6\t\t\"github.com/spf13/cobra\"\n7\t\n8\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n9\t\t\"github.com/Teeeep/talaria/internal/output\"\n10\t\t\"github.com/Teeeep/talaria/internal/spec\"\n11\t)\n12\t\n13\t// version is the binary's version string. It defaults to \"dev\" and is\n14\t// overridden at build time with -ldflags \"-X main.version=v0.1.0\".\n15\tvar version = \"dev\"\n16\t\n17\t// newRootCmd builds the talaria command tree. Every command is constructed\n18\t// per-call rather than living in a package-level var so tests can run against\n19\t// an isolated tree with their own output writers.\n20\tfunc newRootCmd() *cobra.Command {\n21\t\troot := &cobra.Command{\n22\t\t\tUse:   \"talaria\",\n23\t\t\tShort: \"Point it at any API doc; your agent works the API and never sees your credentials\",\n24\t\t\tLong: \"talaria turns any OpenAPI/Swagger spec into an explorable API client, a\\n\" +\n25\t\t\t\t\"spec-driven tester, and a digital twin — without exposing credentials to\\n\" +\n26\t\t\t\t\"the agent driving it.\",\n27\t\t\tVersion: version,\n28\t\t\t// Args and RunE work together to give a typo exit 2 instead of 1. Left\n29\t\t\t// to itself cobra reports an unknown command from Find, as a bare error\n30\t\t\t// that exitCode can only read as a request failure — and exit 1 is the\n31\t\t\t// code AGENT.md calls transient and worth retrying, so a typo would send\n32\t\t\t// an agent into a retry loop. Rejecting the argument in Args instead\n33\t\t\t// classifies it, but cobra reaches ValidateArgs only on a *runnable*\n34\t\t\t// command, so the root needs a RunE it would otherwise do without.\n35\t\t\tArgs: unknownCommand,\n36\t\t\t// SuggestionsFor, unlike cobra's own unknown-command path, does not\n37\t\t\t// default this: left at 0 it would only ever suggest by prefix, and\n38\t\t\t// `talaria vrsion` — the shape of a typo — would get nothing back.\n39\t\t\tSuggestionsMinimumDistance: 2,\n40\t\t\t// What the non-runnable root used to get for free: bare `talaria` prints\n41\t\t\t// the help and exits 0. That is how a human finds the commands.\n42\t\t\tRunE: func(cmd *cobra.Command, _ []string) error { return cmd.Help() },\n43\t\t\t// Agents parse stderr. Cobra's default behaviour of dumping the usage\n44\t\t\t// block on every error, and of printing the error itself on top of the\n45\t\t\t// caller doing so, is noise.\n46\t\t\tSilenceUsage:  true,\n47\t\t\tSilenceErrors: true,\n48\t\t}\n49\t\n50\t\t// Registered once, here, so every present and future subcommand accepts it\n51\t\t// (DESIGN.md §3.1: \"--output json on every command\"). The empty default\n52\t\t// means \"decide from the terminal\"; see output.Resolve.\n53\t\troot.PersistentFlags().String(\"output\", \"\",\n54\t\t\t\"output format: json|pretty|tsv (default: pretty on a terminal, json when piped)\")\n55\t\n56\t\t// Also persistent: every spec-reading command takes the same spec the same\n57\t\t// way, and an agent that exports $TALARIA_SPEC once should not have to\n58\t\t// repeat itself on each call (DESIGN.md §4). Precedence between the three\n59\t\t// sources lives in spec.Resolve, not here.\n60\t\troot.PersistentFlags().String(\"spec\", \"\",\n61\t\t\t\"OpenAPI/Swagger spec to use: file path or URL (default: $\"+spec.EnvSpec+\")\")\n62\t\n63\t\t// Persistent for the same reason: call, run and auth check all take them\n64\t\t// (DESIGN.md §4), and registering either per-command would shadow the other\n65\t\t// registration silently. Commands that read no config simply ignore them.\n66\t\troot.PersistentFlags().String(\"profile\", \"\",\n67\t\t\t\"named profile from the config file: base-url + headers + auth\")\n68\t\troot.PersistentFlags().String(\"base-url\", \"\",\n69\t\t\t\"override the spec's server URL\")\n70\t\n71\t\t// A bad flag is a bad invocation, not a failed request; without this it\n72\t\t// would reach the translator as a bare error and exit 1.\n73\t\troot.SetFlagErrorFunc(func(_ *cobra.Command, err error) error {\n74\t\t\treturn clierr.Usage(\"%s\", err)\n75\t\t})\n76\t\n77\t\t// The Args counterpart of SetFlagErrorFunc lives per-command, in usageArgs;\n78\t\t// cobra has no tree-wide hook for it.\n79\t\n80\t\t// Validated once for the whole tree, so an unusable --output fails before a\n81\t\t// command does any work — including on commands that ignore the format.\n82\t\troot.PersistentPreRunE = func(cmd *cobra.Command, _ []string) error {\n83\t\t\t_, err := resolveFormat(cmd)\n84\t\t\treturn err\n85\t\t}\n86\t\n87\t\troot.AddCommand(newVersionCmd())\n88\t\troot.AddCommand(newListCmd())\n89\t\troot.AddCommand(newDescribeCmd())\n90\t\troot.AddCommand(newSearchCmd())\n91\t\troot.AddCommand(newUsesCmd())\n92\t\troot.AddCommand(newCallCmd())\n93\t\troot.AddCommand(newRunCmd())\n94\t\troot.AddCommand(newAuthCmd())\n95\t\troot.AddCommand(newHistoryCmd())\n96\t\n97\t\treturn root\n98\t}\n99\t\n100\t// unknownCommand rejects any positional argument on the root command, which by\n101\t// then can only be a command that does not exist. It reproduces cobra's own\n102\t// wording, and carries the near misses as structured alternatives rather than\n103\t// as prose appended to the message (§3.1: \"what failed, why, valid\n104\t// alternatives\") — a typo is the one error an agent can correct unaided.\n105\tfunc unknownCommand(cmd *cobra.Command, args []string) error {\n106\t\tif len(args) == 0 {\n107\t\t\treturn nil\n108\t\t}\n109\t\n110\t\treturn clierr.Usage(\"unknown command %q for %q\", args[0], cmd.CommandPath()).\n111\t\t\tWithAlternatives(cmd.SuggestionsFor(args[0])...)\n112\t}\n113\t\n114\t// usageArgs wraps a positional-argument validator so a wrong argument count\n115\t// exits 2 like every other bad invocation. Cobra returns a bare error here, and\n116\t// SetFlagErrorFunc does not cover it, so without this the caller would see the\n117\t// unclassified-failure code 1.\n118\tfunc usageArgs(validate cobra.PositionalArgs) cobra.PositionalArgs {\n119\t\treturn func(cmd *cobra.Command, args []string) error {\n120\t\t\tif err := validate(cmd, args); err != nil {\n121\t\t\t\treturn clierr.Usage(\"%w\", err)\n122\t\t\t}\n123\t\t\treturn nil\n124\t\t}\n125\t}\n126\t\n127\t// resolveFormat resolves --output for cmd against the TTY-ness of its stdout.\n128\t// internal/output deliberately returns a bare error; it becomes a usage error\n129\t// here, where the exit-code contract lives, carrying the valid values so an\n130\t// agent can correct itself without reading the help text.\n131\tfunc resolveFormat(cmd *cobra.Command) (output.Format, error) {\n132\t\texplicit, err := cmd.Flags().GetString(\"output\")\n133\t\tif err != nil {\n134\t\t\treturn \"\", clierr.Usage(\"%w\", err)\n135\t\t}\n136\t\n137\t\tformat, err := output.Resolve(explicit, output.IsTTY(cmd.OutOrStdout()))\n138\t\tif err != nil {\n139\t\t\treturn \"\", clierr.Usage(\"%w\", err).WithAlternatives(output.Formats()...)\n140\t\t}\n141\t\treturn format, nil\n142\t}\n143\t\n144\t// run executes the talaria command tree and returns the process exit code.\n145\t// It deliberately does not call os.Exit — main is the only place that does —\n146\t// so every exit code in the CLI is assertable in-process.\n147\tfunc run(args []string, stdout, stderr io.Writer) int {\n148\t\troot := newRootCmd()\n149\t\troot.SetOut(stdout)\n150\t\troot.SetErr(stderr)\n151\t\troot.SetArgs(args)\n152\t\n153\t\treturn exitCode(root.Execute(), stderr)\n154\t}\n155\t\n156\t// exitCode renders err as structured JSON on stderr and returns the code to\n157\t// exit with. An error that was never classified is a request failure (1).\n158\tfunc exitCode(err error, stderr io.Writer) int {\n159\t\tif err == nil {\n160\t\t\treturn int(clierr.CodeOK)\n161\t\t}\n162\t\n163\t\tclierr.Render(stderr, err)\n164\t\treturn int(clierr.From(err).Code)\n165\t}\n166\t"
      }
    ]
