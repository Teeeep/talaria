        "tool_use_id": "toolu_014ATrWuzYWXthQHDRvVRkMk",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"io\"\n6\t\t\"net/url\"\n7\t\t\"sort\"\n8\t\t\"strconv\"\n9\t\t\"strings\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/spf13/cobra\"\n13\t\n14\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n15\t\t\"github.com/Teeeep/talaria/internal/config\"\n16\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n17\t\t\"github.com/Teeeep/talaria/internal/curl\"\n18\t\t\"github.com/Teeeep/talaria/internal/operation\"\n19\t\t\"github.com/Teeeep/talaria/internal/output\"\n20\t\t\"github.com/Teeeep/talaria/internal/request\"\n21\t\t\"github.com/Teeeep/talaria/internal/secret\"\n22\t)\n23\t\n24\t// historyEntryView is one line of `history`: enough to recognise a call and its\n25\t// index, and nothing more. The whole entry is what `history show` is for.\n26\ttype historyEntryView struct {\n27\t\t// Index is the entry's position in the whole store, newest first and\n28\t\t// 1-based. It is *not* its position in a filtered list: it is the number\n29\t\t// `history show` and `history replay` take, so filtering must not renumber\n30\t\t// it.\n31\t\tIndex int `json:\"index\"`\n32\t\t// ID is the entry's stable handle, which `show` and `replay` also take. It\n33\t\t// is what an agent should keep hold of: unlike Index it does not shift when\n34\t\t// something appends, and every one of those three commands appends. An entry\n35\t\t// recorded before ids existed has none.\n36\t\tID          string    `json:\"id\"`\n37\t\tTimestamp   time.Time `json:\"timestamp\"`\n38\t\tSource      string    `json:\"source\"`\n39\t\tOperationID string    `json:\"operation_id,omitempty\"`\n40\t\tMethod      string    `json:\"method\"`\n41\t\t// Path is the URL's path, which is what identifies a call at a glance; URL\n42\t\t// carries the rest for anyone who needs it.\n43\t\tPath   string `json:\"path\"`\n44\t\tURL    string `json:\"url\"`\n45\t\tStatus int    `json:\"status,omitempty\"`\n46\t\t// TimingMS is omitted along with Status for an entry that observed no\n47\t\t// response, rather than reported as a zero that reads like a fast call.\n48\t\tTimingMS int64 `json:\"timing_ms,omitempty\"`\n49\t}\n50\t\n51\t// historyListView is the `history` payload.\n52\ttype historyListView struct {\n53\t\tEntries []historyEntryView `json:\"entries\"`\n54\t}\n55\t\n56\t// historyShowView is the `history show` payload: one entry exactly as stored,\n57\t// alongside the index it was asked for.\n58\ttype historyShowView struct {\n59\t\tIndex int          `json:\"index\"`\n60\t\tEntry corpus.Entry `json:\"entry\"`\n61\t}\n62\t\n63\t// historyFilter is the set of `history` flags, parsed. A nil field is a filter\n64\t// the caller did not ask for.\n65\ttype historyFilter struct {\n66\t\toperation string\n67\t\tsource    corpus.Source\n68\t\tsince     *time.Time\n69\t\tstatus    *statusFilter\n70\t}\n71\t\n72\t// statusFilter is `--status`: either an exact code or a class such as 4xx.\n73\ttype statusFilter struct {\n74\t\tlow, high int\n75\t}\n76\t\n77\t// matches reports whether a status falls in the filter's range.\n78\tfunc (s statusFilter) matches(status int) bool {\n79\t\treturn status >= s.low && status <= s.high\n80\t}\n81\t\n82\tfunc newHistoryCmd() *cobra.Command {\n83\t\tvar (\n84\t\t\toperationID string\n85\t\t\tsource      string\n86\t\t\tsince       string\n87\t\t\tstatus      string\n88\t\t)\n89\t\n90\t\tcmd := &cobra.Command{\n91\t\t\tUse:   \"history\",\n92\t\t\tShort: \"List what talaria has already called and what came back\",\n93\t\t\tLong: \"List the recorded request/response pairs, newest first. Everything here\\n\" +\n94\t\t\t\t\"was written redacted: a credential was never stored, so none can be read\\n\" +\n95\t\t\t\t\"back. Recording is switched off per profile with `history.enabled: false`\\n\" +\n96\t\t\t\t\"or everywhere with TALARIA_HISTORY=off.\",\n97\t\t\tArgs: usageArgs(cobra.NoArgs),\n98\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n99\t\t\t\tformat, err := resolveFormat(cmd)\n100\t\t\t\tif err != nil {\n101\t\t\t\t\treturn err\n102\t\t\t\t}\n103\t\n104\t\t\t\tfilter, err := parseHistoryFilter(operationID, source, since, status)\n105\t\t\t\tif err != nil {\n106\t\t\t\t\treturn err\n107\t\t\t\t}\n108\t\n109\t\t\t\tentries, err := loadHistory(cmd)\n110\t\t\t\tif err != nil {\n111\t\t\t\t\treturn err\n112\t\t\t\t}\n113\t\n114\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(historyPayload(entries, filter))\n115\t\t\t},\n116\t\t}\n117\t\n118\t\tcmd.Flags().StringVar(&operationID, \"operation\", \"\",\n119\t\t\t\"only entries for this operationId\")\n120\t\tcmd.Flags().StringVar(&since, \"since\", \"\",\n121\t\t\t\"only entries newer than a duration ago, e.g. 1h or 30m\")\n122\t\tcmd.Flags().StringVar(&status, \"status\", \"\",\n123\t\t\t\"only entries with this response status: an exact code (404) or a class (4xx)\")\n124\t\tcmd.Flags().StringVar(&source, \"source\", \"\",\n125\t\t\t\"only entries from this command: \"+strings.Join(historySources(), \"|\"))\n126\t\n127\t\tcmd.AddCommand(newHistoryShowCmd())\n128\t\tcmd.AddCommand(newHistoryReplayCmd())\n129\t\n130\t\treturn cmd\n131\t}\n132\t\n133\tfunc newHistoryShowCmd() *cobra.Command {\n134\t\treturn &cobra.Command{\n135\t\t\tUse:   \"show <id|n>\",\n136\t\t\tShort: \"Print one recorded request and response in full\",\n137\t\t\tLong: \"Print the whole of one entry: the request as it was sent and the response\\n\" +\n138\t\t\t\t\"as it came back, both redacted. Name the entry by the id `history` prints,\\n\" +\n139\t\t\t\t\"which is stable, or by its index, which shifts every time anything is\\n\" +\n140\t\t\t\t\"recorded.\",\n141\t\t\tArgs: usageArgs(cobra.ExactArgs(1)),\n142\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n143\t\t\t\tformat, err := resolveFormat(cmd)\n144\t\t\t\tif err != nil {\n145\t\t\t\t\treturn err\n146\t\t\t\t}\n147\t\n148\t\t\t\tentries, err := loadHistory(cmd)\n149\t\t\t\tif err != nil {\n150\t\t\t\t\treturn err\n151\t\t\t\t}\n152\t\n153\t\t\t\tindex, entry, err := selectEntry(entries, args[0])\n154\t\t\t\tif err != nil {\n155\t\t\t\t\treturn err\n156\t\t\t\t}\n157\t\n158\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(historyShowPayload(index, entry))\n159\t\t\t},\n160\t\t}\n161\t}\n162\t\n163\tfunc newHistoryReplayCmd() *cobra.Command {\n164\t\tvar allowMutations bool\n165\t\n166\t\tcmd := &cobra.Command{\n167\t\t\tUse:   \"replay <id|n>\",\n168\t\t\tShort: \"Re-issue a recorded call\",\n169\t\t\tLong: \"Send a recorded request again, to the URL it went to, and record the\\n\" +\n170\t\t\t\t\"result as a new entry. Credentials are resolved from the environment as\\n\" +\n171\t\t\t\t\"they were the first time — history holds their names, never their values,\\n\" +\n172\t\t\t\t\"so there is nothing there to read back. Name the entry by its id: a replay\\n\" +\n173\t\t\t\t\"is itself recorded, so every index shifts as soon as one runs.\",\n174\t\t\tArgs: usageArgs(cobra.ExactArgs(1)),\n175\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n176\t\t\t\tformat, err := resolveFormat(cmd)\n177\t\t\t\tif err != nil {\n178\t\t\t\t\treturn err\n179\t\t\t\t}\n180\t\n181\t\t\t\tcfg, err := config.Load(\"\")\n182\t\t\t\tif err != nil {\n183\t\t\t\t\treturn err\n184\t\t\t\t}\n185\t\n186\t\t\t\tstore, err := openHistory(cmd, cfg)\n187\t\t\t\tif err != nil {\n188\t\t\t\t\treturn err\n189\t\t\t\t}\n190\t\n191\t\t\t\tentries, err := store.Read()\n192\t\t\t\tif err != nil {\n193\t\t\t\t\treturn err\n194\t\t\t\t}\n195\t\n196\t\t\t\t_, entry, err := selectEntry(entries, args[0])\n197\t\t\t\tif err != nil {\n198\t\t\t\t\treturn err\n199\t\t\t\t}\n200\t\n201\t\t\t\t// The same gate `call` applies, for the same reason: the method is what\n202\t\t\t\t// makes a request dangerous, and a recorded POST is still a POST.\n203\t\t\t\tif (operation.Operation{Method: entry.Method}).IsMutation() && !allowMutations {\n204\t\t\t\t\treturn clierr.Usage(\n205\t\t\t\t\t\t\"entry %s is a %s request and may change server state: pass --allow-mutations to replay it\",\n206\t\t\t\t\t\targs[0], entry.Method)\n207\t\t\t\t}\n208\t\n209\t\t\t\treq, err := replayRequest(cmd.ErrOrStderr(), entry)\n210\t\t\t\tif err != nil {\n211\t\t\t\t\treturn err\n212\t\t\t\t}\n213\t\n214\t\t\t\trenderer := output.New(format, cmd.OutOrStdout())\n215\t\t\t\tredactors := newRedactors(cfg)\n216\t\n217\t\t\t\tresp, execErr := curl.Execute(cmd.Context(), req)\n218\t\t\t\trecordCall(cmd.ErrOrStderr(), store, corpus.SourceReplay, req, resp, redactors)\n219\t\t\t\tif execErr != nil {\n220\t\t\t\t\treturn execErr\n221\t\t\t\t}\n222\t\n223\t\t\t\t// No validation block: replay reads a recorded request and needs no\n224\t\t\t\t// spec to send one, so there is no contract here to check against.\n225\t\t\t\treturn renderer.Render(callPayload(req, redactResponse(resp, redactors.Response), nil))\n226\t\t\t},\n227\t\t}\n228\t\n229\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n230\t\t\t\"permit replaying a method other than GET, HEAD or OPTIONS\")\n231\t\n232\t\treturn cmd\n233\t}\n234\t\n235\t// openHistory builds the store with the recording setting the selected profile\n236\t// asks for. Reading never consults it — history written before recording was\n237\t// switched off is still history — but replay writes, so it has to be right.\n238\tfunc openHistory(cmd *cobra.Command, cfg *config.Config) (*corpus.Store, error) {\n239\t\tprof, err := selectProfile(cmd, cfg)\n240\t\tif err != nil {\n241\t\t\treturn nil, err\n242\t\t}\n243\t\n244\t\t// The empty dir is the default state directory; internal/corpus locates it.\n245\t\treturn corpus.New(\"\", prof.HistoryEnabled()), nil\n246\t}\n247\t\n248\t// loadHistory loads the store for a read-only command. The profile still\n249\t// decides the Enabled flag so the store is constructed the one way, but nothing\n250\t// on this path writes.\n251\tfunc loadHistory(cmd *cobra.Command) ([]corpus.Entry, error) {\n252\t\tcfg, err := config.Load(\"\")\n253\t\tif err != nil {\n254\t\t\treturn nil, err\n255\t\t}\n256\t\n257\t\tstore, err := openHistory(cmd, cfg)\n258\t\tif err != nil {\n259\t\t\treturn nil, err\n260\t\t}\n261\t\n262\t\treturn store.Read()\n263\t}\n264\t\n265\t// historyPayload renders the store newest first, keeping the entries the filter\n266\t// admits and the index each had before filtering.\n267\tfunc historyPayload(entries []corpus.Entry, filter historyFilter) output.Payload {\n268\t\tview := historyListView{Entries: []historyEntryView{}}\n269\t\trows := [][]string{}\n270\t\n271\t\t// The store is oldest first, so walking it backwards is both the display\n272\t\t// order and the index order.\n273\t\tfor i := len(entries) - 1; i >= 0; i-- {\n274\t\t\tentry := entries[i]\n275\t\t\tif !filter.admits(entry) {\n276\t\t\t\tcontinue\n277\t\t\t}\n278\t\n279\t\t\tline := newHistoryEntryView(len(entries)-i, entry)\n280\t\t\tview.Entries = append(view.Entries, line)\n281\t\t\trows = append(rows, []string{\n282\t\t\t\tstrconv.Itoa(line.Index),\n283\t\t\t\tidCell(line.ID),\n284\t\t\t\tline.Timestamp.Format(time.RFC3339),\n285\t\t\t\tstring(line.Source),\n286\t\t\t\tline.Method,\n287\t\t\t\tline.Path,\n288\t\t\t\tstatusCell(line.Status),\n289\t\t\t\tline.OperationID,\n290\t\t\t})\n291\t\t}\n292\t\n293\t\treturn output.Payload{\n294\t\t\tData: view,\n295\t\t\tTable: output.Table{\n296\t\t\t\tHeaders: []string{\"#\", \"ID\", \"WHEN\", \"SOURCE\", \"METHOD\", \"PATH\", \"STATUS\", \"OPERATION\"},\n297\t\t\t\tRows:    rows,\n298\t\t\t},\n299\t\t}\n300\t}\n301\t\n302\tfunc newHistoryEntryView(index int, entry corpus.Entry) historyEntryView {\n303\t\tview := historyEntryView{\n304\t\t\tIndex:       index,\n305\t\t\tID:          entry.ID,\n306\t\t\tTimestamp:   entry.Timestamp,\n307\t\t\tSource:      string(entry.Source),\n308\t\t\tOperationID: entry.OperationID,\n309\t\t\tMethod:      entry.Method,\n310\t\t\tPath:        urlPath(entry.URL),\n311\t\t\tURL:         entry.URL,\n312\t\t}\n313\t\tif entry.Response != nil {\n314\t\t\tview.Status = entry.Response.Status\n315\t\t\tview.TimingMS = entry.Response.TimingMS\n316\t\t}\n317\t\n318\t\treturn view\n319\t}\n320\t\n321\tfunc historyShowPayload(index int, entry corpus.Entry) output.Payload {\n322\t\trows := [][]string{\n323\t\t\t{entry.Method + \" \" + entry.URL},\n324\t\t}\n325\t\tfor _, name := range sortedKeys(entry.Request.Headers) {\n326\t\t\trows = append(rows, []string{name + \": \" + entry.Request.Headers[name]})\n327\t\t}\n328\t\tif entry.Request.Body != nil {\n329\t\t\trows = append(rows, []string{bodyLine(entry.Request.Body)})\n330\t\t}\n331\t\tif entry.Response != nil {\n332\t\t\trows = append(rows, []string{fmt.Sprintf(\"%d in %dms\", entry.Response.Status, entry.Response.TimingMS)})\n333\t\t\tif entry.Response.Body != nil {\n334\t\t\t\trows = append(rows, []string{bodyLine(entry.Response.Body)})\n335\t\t\t}\n336\t\t}\n337\t\n338\t\treturn output.Payload{\n339\t\t\tData:  historyShowView{Index: index, Entry: entry},\n340\t\t\tTable: output.Table{Rows: rows},\n341\t\t}\n342\t}\n343\t\n344\t// bodyLine renders a recorded body for a human. A body with no encoding is the\n345\t// text that was sent and prints as itself; anything else is not text, and\n346\t// printing its stored form would claim bytes went on the wire that did not. The\n347\t// summary says how big it was and how to get at it — `--output json` carries the\n348\t// entry as recorded, encoding and all.\n349\tfunc bodyLine(body *corpus.Body) string {\n350\t\tif body.Encoding == \"\" {\n351\t\t\treturn body.Data\n352\t\t}\n353\t\n354\t\tdata, err := body.Bytes()\n355\t\tif err != nil {\n356\t\t\treturn fmt.Sprintf(\"<body with unreadable %s encoding: %v>\", body.Encoding, err)\n357\t\t}\n358\t\n359\t\treturn fmt.Sprintf(\"<binary body, %d bytes, %s in --output json>\", len(data), body.Encoding)\n360\t}\n361\t\n362\t// statusCell renders the status column, which is empty for an entry that\n363\t// observed no response rather than a 0 nobody's server returned.\n364\tfunc statusCell(status int) string {\n365\t\tif status == 0 {\n366\t\t\treturn \"-\"\n367\t\t}\n368\t\n369\t\treturn strconv.Itoa(status)\n370\t}\n371\t\n372\t// idCell renders the id column. An entry recorded before ids existed has none,\n373\t// and prints as the same dash an absent status does rather than as a blank cell\n374\t// a reader could mistake for a column that failed to render.\n375\tfunc idCell(id string) string {\n376\t\tif id == \"\" {\n377\t\t\treturn \"-\"\n378\t\t}\n379\t\n380\t\treturn id\n381\t}\n382\t\n383\t// urlPath is the path component of a recorded URL, for the list's path column.\n384\t// A URL that will not parse — nothing writes one, but the store is a file on\n385\t// disk — degrades to itself rather than to nothing.\n386\tfunc urlPath(raw string) string {\n387\t\tparsed, err := url.Parse(raw)\n388\t\tif err != nil {\n389\t\t\treturn raw\n390\t\t}\n391\t\n392\t\treturn parsed.EscapedPath()\n393\t}\n394\t\n395\t// selectEntry resolves what `show` and `replay` are given: an entry's stable id,\n396\t// or a 1-based, newest-first positional index.\n397\t//\n398\t// The id is tried first and wins outright. An index is recomputed on every read\n399\t// and shifts as soon as anything appends — and `call`, `run` and `replay` all\n400\t// append, replay included — so `replay 2` followed by `replay 1` re-issues the\n401\t// same entry twice. The id is what makes two commands in a row mean two entries.\n402\t// The index stays supported because it is documented and is what a human reads\n403\t// off the list.\n404\t//\n405\t// Every failure is a usage error carrying what the caller can do instead: the\n406\t// valid range, or the fact that there is no history yet. An agent that guessed\n407\t// corrects itself from the message without a second command.\n408\tfunc selectEntry(entries []corpus.Entry, arg string) (int, corpus.Entry, error) {\n409\t\t// Newest first, so an id that a hand-edited store repeats resolves to the\n410\t\t// same entry the index would.\n411\t\tif arg != \"\" {\n412\t\t\tfor i := len(entries) - 1; i >= 0; i-- {\n413\t\t\t\tif entries[i].ID == arg {\n414\t\t\t\t\treturn len(entries) - i, entries[i], nil\n415\t\t\t\t}\n416\t\t\t}\n417\t\t}\n418\t\n419\t\tindex, err := strconv.Atoi(arg)\n420\t\tif err != nil {\n421\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\n422\t\t\t\t\"no history entry %q: give an id from the ID column, or an entry's 1-based index\", arg)\n423\t\t}\n424\t\n425\t\tif len(entries) == 0 {\n426\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\"no history entry %d: the history is empty\", index)\n427\t\t}\n428\t\tif index < 1 || index > len(entries) {\n429\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\n430\t\t\t\t\"no history entry %d: the valid range is 1-%d\", index, len(entries))\n431\t\t}\n432\t\n433\t\treturn index, entries[len(entries)-index], nil\n434\t}\n435\t\n436\t// admits reports whether an entry survives every filter that was asked for.\n437\tfunc (f historyFilter) admits(entry corpus.Entry) bool {\n438\t\tif f.operation != \"\" && entry.OperationID != f.operation {\n439\t\t\treturn false\n440\t\t}\n441\t\tif f.source != \"\" && entry.Source != f.source {\n442\t\t\treturn false\n443\t\t}\n444\t\tif f.since != nil && entry.Timestamp.Before(*f.since) {\n445\t\t\treturn false\n446\t\t}\n447\t\tif f.status != nil {\n448\t\t\t// An entry with no response has no status to match, so a status filter\n449\t\t\t// excludes it rather than matching it as a zero.\n450\t\t\tif entry.Response == nil || !f.status.matches(entry.Response.Status) {\n451\t\t\t\treturn false\n452\t\t\t}\n453\t\t}\n454\t\n455\t\treturn true\n456\t}\n457\t\n458\t// parseHistoryFilter turns the flags into a filter, failing with exit 2 on\n459\t// anything it cannot read. Parsing happens before the store is opened so a\n460\t// typo is reported without touching the disk.\n461\tfunc parseHistoryFilter(operationID, source, since, status string) (historyFilter, error) {\n462\t\tfilter := historyFilter{operation: operationID}\n463\t\n464\t\tif source != \"\" {\n465\t\t\tparsed, err := parseSource(source)\n466\t\t\tif err != nil {\n467\t\t\t\treturn historyFilter{}, err\n468\t\t\t}\n469\t\t\tfilter.source = parsed\n470\t\t}\n471\t\n472\t\tif since != \"\" {\n473\t\t\tage, err := time.ParseDuration(since)\n474\t\t\tif err != nil || age < 0 {\n475\t\t\t\treturn historyFilter{}, clierr.Usage(\n476\t\t\t\t\t\"cannot read --since %q: give a duration such as 30m, 1h or 7d as 168h\", since)\n477\t\t\t}\n478\t\t\tcutoff := time.Now().Add(-age)\n479\t\t\tfilter.since = &cutoff\n480\t\t}\n481\t\n482\t\tif status != \"\" {\n483\t\t\tparsed, err := parseStatusFilter(status)\n484\t\t\tif err != nil {\n485\t\t\t\treturn historyFilter{}, err\n486\t\t\t}\n487\t\t\tfilter.status = parsed\n488\t\t}\n489\t\n490\t\treturn filter, nil\n491\t}\n492\t\n493\t// parseSource reads --source, offering the valid values on a miss.\n494\tfunc parseSource(value string) (corpus.Source, error) {\n495\t\tfor _, source := range historySources() {\n496\t\t\tif strings.EqualFold(value, source) {\n497\t\t\t\treturn corpus.Source(source), nil\n498\t\t\t}\n499\t\t}\n500\t\n501\t\treturn \"\", clierr.Usage(\"no history source %q\", value).WithAlternatives(historySources()...)\n502\t}\n503\t\n504\t// historySources is the set of commands that write to the store, in the order\n505\t// they are worth reading about.\n506\tfunc historySources() []string {\n507\t\treturn []string{string(corpus.SourceCall), string(corpus.SourceRun), string(corpus.SourceReplay)}\n508\t}\n509\t\n510\t// parseStatusFilter reads --status: an exact code, or a class with x in place\n511\t// of the digits that vary.\n512\tfunc parseStatusFilter(value string) (*statusFilter, error) {\n513\t\tconst bad = \"cannot read --status %q: give an exact code such as 404 or a class such as 4xx\"\n514\t\n515\t\ttrimmed := strings.ToLower(strings.TrimSpace(value))\n516\t\tif len(trimmed) != 3 {\n517\t\t\treturn nil, clierr.Usage(bad, value)\n518\t\t}\n519\t\n520\t\tif strings.HasSuffix(trimmed, \"xx\") {\n521\t\t\tclass, err := strconv.Atoi(trimmed[:1])\n522\t\t\tif err != nil || class < 1 || class > 9 {\n523\t\t\t\treturn nil, clierr.Usage(bad, value)\n524\t\t\t}\n525\t\n526\t\t\treturn &statusFilter{low: class * 100, high: class*100 + 99}, nil\n527\t\t}\n528\t\n529\t\tcode, err := strconv.Atoi(trimmed)\n530\t\tif err != nil {\n531\t\t\treturn nil, clierr.Usage(bad, value)\n532\t\t}\n533\t\n534\t\treturn &statusFilter{low: code, high: code}, nil\n535\t}\n536\t\n537\t// replayRequest rebuilds a runnable request from a stored entry.\n538\t//\n539\t// Every credential position in the entry holds `<redacted:env:NAME>`, which\n540\t// becomes a reference again here — the value is resolved from the environment\n541\t// at exec time, exactly as it was on the original call. Nothing in this function\n542\t// reads a credential, because there is none in the store to read (§5a).\n543\tfunc replayRequest(stderr io.Writer, entry corpus.Entry) (*request.Request, error) {\n544\t\t// The store is a file on disk, so what it holds is checked on the way out as\n545\t\t// well as on the way in: an edited entry must not be able to replay as a\n546\t\t// file read or a raw TCP write, nor to smuggle a credential into a URL that\n547\t\t// every later surface prints whole. Both checks come before the parse error\n548\t\t// below, which quotes the URL it could not read.\n549\t\tif host, ok := request.Userinfo(entry.URL); ok {\n550\t\t\treturn nil, clierr.Usage(\n551\t\t\t\t\"the recorded URL for %s carries a credential in its userinfo, so it will not be replayed; \"+\n552\t\t\t\t\t\"re-run the call with %s=user:password set instead\", host, config.EnvBasic)\n553\t\t}\n554\t\n555\t\tparsed, err := url.Parse(entry.URL)\n556\t\tif err != nil {\n557\t\t\treturn nil, clierr.Usage(\"the recorded URL %q cannot be parsed: %v\", entry.URL, err)\n558\t\t}\n559\t\tif !request.IsHTTPScheme(parsed.Scheme) {\n560\t\t\treturn nil, clierr.Usage(\"the recorded URL %q has scheme %q; only http and https can be replayed\",\n561\t\t\t\tentry.URL, parsed.Scheme)\n562\t\t}\n563\t\n564\t\treq := &request.Request{\n565\t\t\tOperationID: entry.OperationID,\n566\t\t\tMethod:      entry.Method,\n567\t\t\tBaseURL:     parsed.Scheme + \"://\" + parsed.Host,\n568\t\t\tPath:        parsed.EscapedPath(),\n569\t\t}\n570\t\n571\t\treq.Query, err = replayQuery(stderr, parsed.RawQuery)\n572\t\tif err != nil {\n573\t\t\treturn nil, err\n574\t\t}\n575\t\treq.Headers = replayPairs(stderr, \"header\", entry.Request.Headers)\n576\t\treq.Cookies = replayPairs(stderr, \"cookie\", entry.Request.Cookies)\n577\t\n578\t\tif body := entry.Request.Body; body != nil {\n579\t\t\tif body.Truncated {\n580\t\t\t\treturn nil, clierr.Usage(\n581\t\t\t\t\t\"the recorded request body was truncated at %d bytes, so replaying it would send something the original did not\",\n582\t\t\t\t\tcorpus.MaxBody)\n583\t\t\t}\n584\t\t\tdata, err := body.Bytes()\n585\t\t\tif err != nil {\n586\t\t\t\treturn nil, err\n587\t\t\t}\n588\t\t\treq.Body = &request.Body{ContentType: body.ContentType, Data: data}\n589\t\t}\n590\t\n591\t\treturn req, nil\n592\t}\n593\t\n594\t// replayQuery rebuilds the query parameters in the order they were recorded.\n595\t// The raw string is walked rather than url.ParseQuery'd because a map would lose\n596\t// that order, and a replay that reorders the query string is not the same\n597\t// request.\n598\tfunc replayQuery(stderr io.Writer, raw string) ([]request.Pair, error) {\n599\t\tvar pairs []request.Pair\n600\t\n601\t\tfor _, field := range strings.Split(raw, \"&\") {\n602\t\t\tif field == \"\" {\n603\t\t\t\tcontinue\n604\t\t\t}\n605\t\n606\t\t\trawName, rawValue, _ := strings.Cut(field, \"=\")\n607\t\t\tname, err := url.QueryUnescape(rawName)\n608\t\t\tif err != nil {\n609\t\t\t\treturn nil, clierr.Usage(\"the recorded query parameter %q cannot be parsed: %v\", rawName, err)\n610\t\t\t}\n611\t\t\tvalue, err := url.QueryUnescape(rawValue)\n612\t\t\tif err != nil {\n613\t\t\t\treturn nil, clierr.Usage(\"the recorded value of query parameter %q cannot be parsed: %v\", name, err)\n614\t\t\t}\n615\t\n616\t\t\treplayed, ok := replayValue(value)\n617\t\t\tif !ok {\n618\t\t\t\twarnUnreplayable(stderr, \"query parameter\", name)\n619\t\t\t\tcontinue\n620\t\t\t}\n621\t\t\tpairs = append(pairs, request.Pair{Name: name, Value: replayed})\n622\t\t}\n623\t\n624\t\treturn pairs, nil\n625\t}\n626\t\n627\t// replayPairs rebuilds headers or cookies. The stored form is a map, so the\n628\t// order is gone and is restored as sorted-by-name: emitted curl and the config\n629\t// document both have to be deterministic, and byte-for-byte header order is not\n630\t// something an HTTP request depends on.\n631\tfunc replayPairs(stderr io.Writer, kind string, stored map[string]string) []request.Pair {\n632\t\tvar pairs []request.Pair\n633\t\n634\t\tfor _, name := range sortedKeys(stored) {\n635\t\t\tvalue, ok := replayValue(stored[name])\n636\t\t\tif !ok {\n637\t\t\t\twarnUnreplayable(stderr, kind, name)\n638\t\t\t\tcontinue\n639\t\t\t}\n640\t\t\tpairs = append(pairs, request.Pair{Name: name, Value: value})\n641\t\t}\n642\t\n643\t\treturn pairs\n644\t}\n645\t\n646\t// replayValue turns one stored value back into a request Value, reporting\n647\t// false for one that cannot be reproduced.\n648\t//\n649\t// A `<redacted:env:NAME>` — with or without a scheme prefix — becomes a\n650\t// reference to the same variable. A bare `<redacted>` is a value the name-based\n651\t// matcher caught: a literal the user typed, which was deliberately not written\n652\t// down and so cannot come back. That is the firewall working, not a bug, and\n653\t// the caller says so on stderr rather than silently sending a request missing a\n654\t// header the original had.\n655\tfunc replayValue(stored string) (request.Value, bool) {\n656\t\tif stored == secret.Placeholder {\n657\t\t\treturn request.Value{}, false\n658\t\t}\n659\t\n660\t\t// Longest prefix first, so the raw encoding's empty prefix is the fallback\n661\t\t// rather than the first match.\n662\t\tfor _, enc := range []request.Encoding{request.EncodeBearer, request.EncodeBasic, request.EncodeRaw} {\n663\t\t\tprefix := encodingPrefix(enc)\n664\t\t\tif prefix != \"\" && !strings.HasPrefix(stored, prefix) {\n665\t\t\t\tcontinue\n666\t\t\t}\n667\t\n668\t\t\tif ref, ok := secret.ParseRef(strings.TrimPrefix(stored, prefix)); ok {\n669\t\t\t\treturn request.Secret(ref, enc), true\n670\t\t\t}\n671\t\t}\n672\t\n673\t\treturn request.Literal(stored), true\n674\t}\n675\t\n676\t// encodingPrefix is the text a scheme puts in front of a credential — \"Bearer \"\n677\t// and the rest. It is asked of internal/request rather than repeated here, so\n678\t// the two cannot drift apart.\n679\tfunc encodingPrefix(enc request.Encoding) string {\n680\t\treturn request.Secret(secret.SecretRef{}, enc).Prefix()\n681\t}\n682\t\n683\t// warnUnreplayable reports a field the replay had to drop. It is a warning\n684\t// rather than a failure: the request is still worth making, and a 401 with an\n685\t// explanation on stderr is more useful than a refusal.\n686\tfunc warnUnreplayable(stderr io.Writer, kind, name string) {\n687\t\tfmt.Fprintf(stderr,\n688\t\t\t\"warning: the recorded %s %q held a redacted literal, which history does not store; replaying without it\\n\",\n689\t\t\tkind, name)\n690\t}\n691\t\n692\t// sortedKeys is the deterministic iteration order for the maps a stored entry\n693\t// holds.\n694\tfunc sortedKeys(m map[string]string) []string {\n695\t\tnames := make([]string, 0, len(m))\n696\t\tfor name := range m {\n697\t\t\tnames = append(names, name)\n698\t\t}\n699\t\tsort.Strings(names)\n700\t\n701\t\treturn names\n702\t}\n703\t"
