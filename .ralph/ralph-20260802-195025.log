    def do_HEAD(self): self._send(200, b\"\")\nEOF\ncd /tmp/tal && nohup python3 -c \"\nimport sys; sys.path.insert(0,'/tmp/tal')\nfrom server import H\nimport http.server\nhttp.server.HTTPServer(('127.0.0.1',9911), H).serve_forever()\n\" > /tmp/tal/server.log 2>&1 &\nsleep 1; curl -s http://127.0.0.1:9911/pets/42; echo",
