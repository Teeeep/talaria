        "content": "225\t\n226\t\treturn out\n227\t}\n228\t\n229\t// runner holds everything one suite reuses across operations: the compiled\n230\t// validator, the seeded generator, the history store and the redactors. Built\n231\t// once so the per-operation loop only makes requests.\n232\ttype runner struct {\n233\t\tdoc       *spec.Document\n234\t\tprofile   *config.Profile\n235\t\tbaseURL   string\n236\t\tgen       *gen.Generator\n237\t\tvalidator *validate.Validator\n238\t\tstore     *corpus.Store\n239\t\tredactors corpus.Redactors\n240\t\twarner    *secret.QueryKeyWarner\n241\t\tstderr    io.Writer\n242\t\n243\t\tallowMutations bool\n244\t\t// missing collects the security schemes that stopped an operation from\n245\t\t// running, in the display form the exit-5 error reports.\n246\t\tmissing []string\n247\t}\n248\t\n249\tfunc newRunner(\n250\t\tcmd *cobra.Command,\n251\t\tdoc *spec.Document,\n252\t\tfixturesDir string,\n253\t\tallowMutations bool,\n254\t\twarner *secret.QueryKeyWarner,\n255\t) (*runner, error) {\n256\t\t// The whole fixtures directory is read up front, before any request goes\n257\t\t// out: a typo in a fixture should not surface halfway through a suite.\n258\t\tfixtures, err := gen.LoadFixtures(fixturesDir)\n259\t\tif err != nil {\n260\t\t\treturn nil, err\n261\t\t}\n262\t\n263\t\tcfg, err := config.Load(\"\")\n264\t\tif err != nil {\n265\t\t\treturn nil, err\n266\t\t}\n267\t\n268\t\tprofile, err := selectProfile(cmd, cfg)\n269\t\tif err != nil {\n270\t\t\treturn nil, err\n271\t\t}\n272\t\n273\t\tstore, err := openHistory(cmd, cfg)\n274\t\tif err != nil {\n275\t\t\treturn nil, err\n276\t\t}\n277\t\n278\t\tbaseURL, err := cmd.Flags().GetString(\"base-url\")\n279\t\tif err != nil {\n280\t\t\treturn nil, clierr.Usage(\"%w\", err)\n281\t\t}\n282\t\n283\t\tgenerator := gen.New(runSeed)\n284\t\tgenerator.Fixtures = fixtures\n285\t\n286\t\treturn &runner{\n287\t\t\tdoc:            doc,\n288\t\t\tprofile:        profile,\n289\t\t\tbaseURL:        baseURL,\n290\t\t\tgen:            generator,\n291\t\t\tvalidator:      validate.New(doc),\n292\t\t\tstore:          store,\n293\t\t\tredactors:      newRedactors(cfg),\n294\t\t\twarner:         warner,\n295\t\t\tstderr:         cmd.ErrOrStderr(),\n296\t\t\tallowMutations: allowMutations,\n297\t\t}, nil\n298\t}\n299\t\n300\t// execute runs one operation and reports what happened. It never returns an\n301\t// error: one operation's problem is a line in the report, not the end of the\n302\t// suite, and the exit code is decided once at the end from the whole of it.\n303\tfunc (r *runner) execute(op operation.Operation) runResult {\n304\t\tres := runResult{\n305\t\t\tOperationID: operationName(op),\n306\t\t\tMethod:      op.Method,\n307\t\t\tPath:        op.Path,\n308\t\t}\n309\t\n310\t\tif op.IsMutation() && !r.allowMutations {\n311\t\t\treturn res.skip(\"a %s request may change server state: pass --allow-mutations to include it\",\n312\t\t\t\top.Method)\n313\t\t}\n314\t\n315\t\tcreds, err := config.Resolve(op, r.doc, r.profile)\n316\t\tif err != nil {\n317\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n318\t\t}\n319\t\t// Checked before the request is built rather than left to fail at exec\n320\t\t// time, so an agent gets the variable to export and the server gets no\n321\t\t// request it was always going to reject.\n322\t\tif missing := missingCredentials(creds); len(missing) > 0 {\n323\t\t\tr.noteMissing(missing)\n324\t\n325\t\t\treturn res.skip(\"no credential for security %s\",\n326\t\t\t\tpluralise(len(missing), \"scheme\")+\" \"+strings.Join(missing, \", \"))\n327\t\t}\n328\t\n329\t\tdata := r.gen.DataFor(op)\n330\t\treq, err := request.Build(request.Inputs{\n331\t\t\tOp:      op,\n332\t\t\tDoc:     r.doc,\n333\t\t\tProfile: r.profile,\n334\t\t\tCreds:   creds,\n335\t\t\tBaseURL: r.baseURL,\n336\t\t\tParams:  flagPairs(data.Params),\n337\t\t\tHeaders: flagPairs(data.Headers),\n338\t\t\tBody:    bodyFlag(data.Body),\n339\t\t\t// No stdin: `run` makes many requests and stdin can only be read once,\n340\t\t\t// so there is nothing here for `--body -` to mean.\n341\t\t})\n342\t\tif err != nil {\n343\t\t\t// A request that cannot be built is data talaria could not supply, not\n344\t\t\t// an API that misbehaved, so it is a skip carrying the builder's own\n345\t\t\t// message — which names the parameter.\n346\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n347\t\t}\n348\t\n349\t\twarnQueryCredentials(r.stderr, r.warner, req)\n350\t\n351\t\tresp, execErr := curl.Execute(req)\n352\t\t// Recorded either way, as `call` records: a request that never completed is\n353\t\t// still something that was tried.\n354\t\trecordCall(r.stderr, r.store, corpus.SourceRun, req, resp, r.redactors)\n355\t\tif execErr != nil {\n356\t\t\treturn res.fail(\"%s\", clierr.From(execErr).Message)\n357\t\t}\n358\t\n359\t\tview := redactResponse(resp, r.redactors.Response)\n360\t\ttiming := view.TimingMS\n361\t\tres.Status, res.TimingMS = view.Status, &timing\n362\t\tres.Validation = validateWith(r.stderr, r.validator, req, view)\n363\t\n364\t\treturn res.judge()"
