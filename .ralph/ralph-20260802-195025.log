        "type": "tool_result",
        "content": "1\tpackage corpus\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"net/http\"\n6\t\t\"os\"\n7\t\t\"path/filepath\"\n8\t\t\"strconv\"\n9\t\t\"strings\"\n10\t\t\"testing\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/Teeeep/talaria/internal/curl\"\n14\t\t\"github.com/Teeeep/talaria/internal/request\"\n15\t\t\"github.com/Teeeep/talaria/internal/secret\"\n16\t)\n17\t\n18\t// canary is the credential every test in this file greps the store's bytes for.\n19\t// DESIGN.md §5a calls the recording \"a permanent artifact — the highest-risk\n20\t// surface in the tool\" and answers it with redaction at *write* time, so the\n21\t// assertion that matters is not \"the entry looks redacted\" but \"the value is\n22\t// nowhere in the file\".\n23\tconst canary = \"history-CANARY-4d81f0\"\n24\t\n25\t// canaryRequest is a request carrying the canary through every channel that\n26\t// could put it on disk: a resolved-at-exec-time secret header, a literal\n27\t// Authorization header the user typed themselves, a literal cookie, a secret in\n28\t// the query string, and a body field the built-in redaction paths name.\n29\tfunc canaryRequest(t *testing.T) *request.Request {\n30\t\tt.Helper()\n31\t\n32\t\tt.Setenv(\"TALARIA_TOKEN\", canary)\n33\t\n34\t\treturn &request.Request{\n35\t\t\tOperationID: \"getPet\",\n36\t\t\tMethod:      \"GET\",\n37\t\t\tBaseURL:     \"https://api.example.com\",\n38\t\t\tPath:        \"/pets/42\",\n39\t\t\tQuery: []request.Pair{\n40\t\t\t\t{Name: \"api_key\", Value: request.Secret(secret.Env(\"TALARIA_TOKEN\"), request.EncodeRaw)},\n41\t\t\t\t{Name: \"verbose\", Value: request.Literal(\"true\")},\n42\t\t\t},\n43\t\t\tHeaders: []request.Pair{\n44\t\t\t\t{Name: \"Authorization\", Value: request.Secret(secret.Env(\"TALARIA_TOKEN\"), request.EncodeBearer)},\n45\t\t\t\t{Name: \"X-Api-Key\", Value: request.Literal(canary)},\n46\t\t\t\t{Name: \"Accept\", Value: request.Literal(\"application/json\")},\n47\t\t\t},\n48\t\t\tCookies: []request.Pair{\n49\t\t\t\t{Name: \"session\", Value: request.Literal(canary)},\n50\t\t\t},\n51\t\t\tBody: &request.Body{\n52\t\t\t\tContentType: \"application/json\",\n53\t\t\t\tData:        []byte(`{\"refresh_token\":\"` + canary + `\",\"name\":\"fido\"}`),\n54\t\t\t},\n55\t\t}\n56\t}\n57\t\n58\t// canaryResponse is a response carrying the canary back off the wire, in the\n59\t// two places §5a's leak-channel table names: Set-Cookie and a token field.\n60\tfunc canaryResponse() *curl.Response {\n61\t\treturn &curl.Response{\n62\t\t\tStatus: 200,\n63\t\t\tHeaders: http.Header{\n64\t\t\t\t\"Set-Cookie\":   {\"session=\" + canary},\n65\t\t\t\t\"Content-Type\": {\"application/json\"},\n66\t\t\t},\n67\t\t\tBody:     []byte(`{\"access_token\":\"` + canary + `\",\"id\":42}`),\n68\t\t\tTimingMS: 137,\n69\t\t}\n70\t}\n71\t\n72\t// newStore returns a recording store writing under a temporary directory, with\n73\t// TALARIA_HISTORY cleared so a value in the developer's own environment cannot\n74\t// silently turn every test in this file into a no-op.\n75\tfunc newStore(t *testing.T) (*Store, string) {\n76\t\tt.Helper()\n77\t\n78\t\tt.Setenv(EnvHistory, \"\")\n79\t\tdir := filepath.Join(t.TempDir(), \"state\")\n80\t\n81\t\treturn New(dir, true), filepath.Join(dir, \"history.jsonl\")\n82\t}\n83\t\n84\tfunc TestAppendStoresWhatWasSentAndWhatCameBack(t *testing.T) {\n85\t\tstore, _ := newStore(t)\n86\t\n87\t\tbefore := time.Now().Add(-time.Second)\n88\t\tif err := store.Append(NewEntry(SourceCall, canaryRequest(t), canaryResponse(), Redactors{})); err != nil {\n89\t\t\tt.Fatalf(\"Append: %v\", err)\n90\t\t}\n91\t\n92\t\tentries, err := store.Read()\n93\t\tif err != nil {\n94\t\t\tt.Fatalf(\"Read: %v\", err)\n95\t\t}\n96\t\tif len(entries) != 1 {\n97\t\t\tt.Fatalf(\"read %d entries, want 1\", len(entries))\n98\t\t}\n99\t\n100\t\tgot := entries[0]\n101\t\tif got.Source != SourceCall {\n102\t\t\tt.Errorf(\"Source = %q, want %q\", got.Source, SourceCall)\n103\t\t}\n104\t\tif got.OperationID != \"getPet\" {\n105\t\t\tt.Errorf(\"OperationID = %q, want getPet\", got.OperationID)\n106\t\t}\n107\t\tif got.Method != \"GET\" {\n108\t\t\tt.Errorf(\"Method = %q, want GET\", got.Method)\n109\t\t}\n110\t\tif !strings.HasPrefix(got.URL, \"https://api.example.com/pets/42?\") {\n111\t\t\tt.Errorf(\"URL = %q, want the bound path and query\", got.URL)\n112\t\t}\n113\t\tif got.Timestamp.Before(before) || got.Timestamp.After(time.Now().Add(time.Second)) {\n114\t\t\tt.Errorf(\"Timestamp = %v, want roughly now\", got.Timestamp)\n115\t\t}\n116\t\tif got.Request.Headers[\"Accept\"] != \"application/json\" {\n117\t\t\tt.Errorf(\"request Accept = %q, want it kept\", got.Request.Headers[\"Accept\"])\n118\t\t}\n119\t\tif got.Request.Body == nil || !strings.Contains(got.Request.Body.Data, `\"name\":\"fido\"`) {\n120\t\t\tt.Errorf(\"request body = %+v, want the non-secret fields kept\", got.Request.Body)\n121\t\t}\n122\t\tif got.Response == nil {\n123\t\t\tt.Fatal(\"Response is nil, want the observed response\")\n124\t\t}\n125\t\tif got.Response.Status != 200 {\n126\t\t\tt.Errorf(\"Response.Status = %d, want 200\", got.Response.Status)\n127\t\t}\n128\t\tif got.Response.TimingMS != 137 {\n129\t\t\tt.Errorf(\"Response.TimingMS = %d, want 137\", got.Response.TimingMS)\n130\t\t}\n131\t\tif got.Response.Body == nil || !strings.Contains(got.Response.Body.Data, `\"id\":42`) {\n132\t\t\tt.Errorf(\"response body = %+v, want the non-secret fields kept\", got.Response.Body)\n133\t\t}\n134\t\tif ct := got.Response.Headers[\"Content-Type\"]; len(ct) != 1 || ct[0] != \"application/json\" {\n135\t\t\tt.Errorf(\"response Content-Type = %v, want it kept\", ct)\n136\t\t}\n137\t}\n138\t\n139\tfunc TestAppendWritesAnRFC3339Timestamp(t *testing.T) {\n140\t\tstore, path := newStore(t)\n141\t\n142\t\tif err := store.Append(NewEntry(SourceCall, canaryRequest(t), nil, Redactors{})); err != nil {\n143\t\t\tt.Fatalf(\"Append: %v\", err)\n144\t\t}\n145\t\n146\t\tvar line map[string]any\n147\t\tif err := json.Unmarshal(firstLine(t, path), &line); err != nil {\n148\t\t\tt.Fatalf(\"the entry is not JSON: %v\", err)\n149\t\t}\n150\t\n151\t\tstamp, ok := line[\"timestamp\"].(string)\n152\t\tif !ok {\n153\t\t\tt.Fatalf(\"timestamp = %v, want a string\", line[\"timestamp\"])\n154\t\t}\n155\t\tif _, err := time.Parse(time.RFC3339, stamp); err != nil {\n156\t\t\tt.Errorf(\"timestamp %q is not RFC3339: %v\", stamp, err)\n157\t\t}\n158\t}\n159\t\n160\tfunc TestAppendRedactsAtWriteTime(t *testing.T) {\n161\t\tstore, path := newStore(t)\n162\t\n163\t\tentry := NewEntry(SourceCall, canaryRequest(t), canaryResponse(), Redactors{})\n164\t\tif err := store.Append(entry); err != nil {\n165\t\t\tt.Fatalf(\"Append: %v\", err)\n166\t\t}\n167\t\n168\t\tdata, err := os.ReadFile(path)\n169\t\tif err != nil {\n170\t\t\tt.Fatalf(\"reading the store: %v\", err)\n171\t\t}\n172\t\tif strings.Contains(string(data), canary) {\n173\t\t\tt.Errorf(\"the canary is in the history file:\\n%s\", data)\n174\t\t}\n175\t}\n176\t\n177\tfunc TestAppendRedactsCredentialsSuppliedAsLiterals(t *testing.T) {\n178\t\tstore, _ := newStore(t)\n179\t\n180\t\tif err := store.Append(NewEntry(SourceCall, canaryRequest(t), canaryResponse(), Redactors{})); err != nil {\n181\t\t\tt.Fatalf(\"Append: %v\", err)\n182\t\t}\n183\t\n184\t\tentries, err := store.Read()\n185\t\tif err != nil {\n186\t\t\tt.Fatalf(\"Read: %v\", err)\n187\t\t}\n188\t\n189\t\tgot := entries[0]\n190\t\t// Typed into --header rather than resolved from a ref, so only name-based\n191\t\t// redaction catches it.\n192\t\tif v := got.Request.Headers[\"X-Api-Key\"]; v != secret.Placeholder {\n193\t\t\tt.Errorf(\"X-Api-Key = %q, want %q\", v, secret.Placeholder)\n194\t\t}\n195\t\tif v := got.Request.Cookies[\"session\"]; v != secret.Placeholder {\n196\t\t\tt.Errorf(\"session cookie = %q, want %q\", v, secret.Placeholder)\n197\t\t}\n198\t\tif v := got.Request.Headers[\"Authorization\"]; !strings.Contains(v, \"<redacted:env:TALARIA_TOKEN>\") {\n199\t\t\tt.Errorf(\"Authorization = %q, want the ref's redacted form\", v)\n200\t\t}\n201\t\tif v := got.Response.Headers[\"Set-Cookie\"]; len(v) != 1 || v[0] != secret.Placeholder {\n202\t\t\tt.Errorf(\"Set-Cookie = %v, want it redacted\", v)\n203\t\t}\n204\t}\n205\t\n206\tfunc TestAppendCreatesA0600FileInA0700Directory(t *testing.T) {\n207\t\tstore, path := newStore(t)\n208\t\n209\t\tif err := store.Append(NewEntry(SourceCall, canaryRequest(t), nil, Redactors{})); err != nil {\n210\t\t\tt.Fatalf(\"Append: %v\", err)\n211\t\t}\n212\t\n213\t\tfile, err := os.Stat(path)\n214\t\tif err != nil {\n215\t\t\tt.Fatalf(\"stat file: %v\", err)\n216\t\t}\n217\t\tif mode := file.Mode().Perm(); mode != 0o600 {\n218\t\t\tt.Errorf(\"file mode = %04o, want 0600\", mode)\n219\t\t}\n220\t\n221\t\tdir, err := os.Stat(filepath.Dir(path))\n222\t\tif err != nil {\n223\t\t\tt.Fatalf(\"stat dir: %v\", err)\n224\t\t}\n225\t\tif mode := dir.Mode().Perm(); mode != 0o700 {\n226\t\t\tt.Errorf(\"directory mode = %04o, want 0700\", mode)\n227\t\t}\n228\t}\n229\t\n230\tfunc TestAppendCapsEachSourceSeparately(t *testing.T) {\n231\t\tstore, _ := newStore(t)\n232\t\n233\t\t// One interactive call first: a run over a large spec must not be able to\n234\t\t// evict a session of `call` history, which a single global cap would allow.\n235\t\tif err := store.Append(Entry{Source: SourceCall, Method: \"GET\", URL: \"https://api.example.com/pets/1\"}); err != nil {\n236\t\t\tt.Fatalf(\"Append: %v\", err)\n237\t\t}\n238\t\tfor i := 0; i < maxPerSource+1; i++ {\n239\t\t\tentry := Entry{Source: SourceRun, Method: \"GET\", URL: \"https://api.example.com/pets/2\"}\n240\t\t\tif err := store.Append(entry); err != nil {\n241\t\t\t\tt.Fatalf(\"Append run entry %d: %v\", i, err)\n242\t\t\t}\n243\t\t}\n244\t\n245\t\tentries, err := store.Read()\n246\t\tif err != nil {\n247\t\t\tt.Fatalf(\"Read: %v\", err)\n248\t\t}\n249\t\n250\t\tcounts := map[Source]int{}\n251\t\tfor _, e := range entries {\n252\t\t\tcounts[e.Source]++\n253\t\t}\n254\t\tif counts[SourceRun] != maxPerSource {\n255\t\t\tt.Errorf(\"kept %d run entries, want %d\", counts[SourceRun], maxPerSource)\n256\t\t}\n257\t\tif counts[SourceCall] != 1 {\n258\t\t\tt.Errorf(\"kept %d call entries, want the one interactive call untouched\", counts[SourceCall])\n259\t\t}\n260\t}\n261\t\n262\tfunc TestAppendTrimsOldestFirst(t *testing.T) {\n263\t\tstore, _ := newStore(t)\n264\t\n265\t\tfor i := 0; i < maxPerSource+2; i++ {\n266\t\t\tentry := Entry{Source: SourceRun, Method: \"GET\", URL: \"https://api.example.com/pets/\" + strconv.Itoa(i)}\n267\t\t\tif err := store.Append(entry); err != nil {\n268\t\t\t\tt.Fatalf(\"Append %d: %v\", i, err)\n269\t\t\t}\n270\t\t}\n271\t\n272\t\tentries, err := store.Read()\n273\t\tif err != nil {\n274\t\t\tt.Fatalf(\"Read: %v\", err)\n275\t\t}\n276\t\tif len(entries) != maxPerSource {\n277\t\t\tt.Fatalf(\"kept %d entries, want %d\", len(entries), maxPerSource)\n278\t\t}\n279\t\tif want := \"https://api.example.com/pets/2\"; entries[0].URL != want {\n280\t\t\tt.Errorf(\"oldest kept entry = %q, want %q\", entries[0].URL, want)\n281\t\t}\n282\t\tif want := \"https://api.example.com/pets/\" + strconv.Itoa(maxPerSource+1); entries[len(entries)-1].URL != want {\n283\t\t\tt.Errorf(\"newest entry = %q, want %q\", entries[len(entries)-1].URL, want)\n284\t\t}\n285\t}\n286\t\n287\tfunc TestAppendTruncatesLargeBodies(t *testing.T) {\n288\t\tstore, path := newStore(t)\n289\t\n290\t\tbig := strings.Repeat(\"x\", MaxBody+512)\n291\t\treq := &request.Request{\n292\t\t\tMethod:  \"POST\",\n293\t\t\tBaseURL: \"https://api.example.com\",\n294\t\t\tPath:    \"/pets\",\n295\t\t\tBody:    &request.Body{ContentType: \"text/plain\", Data: []byte(big)},\n296\t\t}\n297\t\tresp := &curl.Response{Status: 200, Body: []byte(big), TimingMS: 4}\n298\t\n299\t\tif err := store.Append(NewEntry(SourceCall, req, resp, Redactors{})); err != nil {\n300\t\t\tt.Fatalf(\"Append: %v\", err)\n301\t\t}\n302\t\n303\t\tentries, err := store.Read()\n304\t\tif err != nil {\n305\t\t\tt.Fatalf(\"Read: %v\", err)\n306\t\t}\n307\t\n308\t\tfor name, body := range map[string]*Body{\n309\t\t\t\"request\":  entries[0].Request.Body,\n310\t\t\t\"response\": entries[0].Response.Body,\n311\t\t} {\n312\t\t\tif body == nil {\n313\t\t\t\tt.Fatalf(\"%s body is nil\", name)\n314\t\t\t}\n315\t\t\tif !body.Truncated {\n316\t\t\t\tt.Errorf(\"%s body Truncated = false, want true\", name)\n317\t\t\t}\n318\t\t\tif len(body.Data) != MaxBody {\n319\t\t\t\tt.Errorf(\"%s body kept %d bytes, want %d\", name, len(body.Data), MaxBody)\n320\t\t\t}\n321\t\t}\n322\t\n323\t\t// A truncated body must not be able to truncate the *line*: the store is\n324\t\t// JSONL, and one unparseable line would take the rest of the file with it.\n325\t\tdata, err := os.ReadFile(path)\n326\t\tif err != nil {\n327\t\t\tt.Fatalf(\"reading the store: %v\", err)\n328\t\t}\n329\t\tfor i, line := range strings.Split(strings.TrimSuffix(string(data), \"\\n\"), \"\\n\") {\n330\t\t\tif !json.Valid([]byte(line)) {\n331\t\t\t\tt.Fatalf(\"line %d is not valid JSON\", i)\n332\t\t\t}\n333\t\t}\n334\t}\n335\t\n336\tfunc TestAppendIsANoOpWhenTheEnvVarTurnsHistoryOff(t *testing.T) {\n337\t\tstore, path := newStore(t)\n338\t\tt.Setenv(EnvHistory, \"off\")\n339\t\n340\t\tif store.Recording() {\n341\t\t\tt.Error(\"Recording() = true, want false with TALARIA_HISTORY=off\")\n342\t\t}\n343\t\tif err := store.Append(NewEntry(SourceCall, canaryRequest(t), canaryResponse(), Redactors{})); err != nil {\n344\t\t\tt.Fatalf(\"Append: %v\", err)\n345\t\t}\n346\t\n347\t\tassertNoFile(t, path)\n348\t}\n349\t\n350\tfunc TestAppendIsANoOpWhenTheStoreIsDisabled(t *testing.T) {\n351\t\tt.Setenv(EnvHistory, \"\")\n352\t\tdir := filepath.Join(t.TempDir(), \"state\")\n353\t\tstore := New(dir, false)\n354\t\n355\t\tif err := store.Append(NewEntry(SourceCall, canaryRequest(t), canaryResponse(), Redactors{})); err != nil {\n356\t\t\tt.Fatalf(\"Append: %v\", err)\n357\t\t}\n358\t\n359\t\tassertNoFile(t, filepath.Join(dir, \"history.jsonl\"))\n360\t}\n361\t\n362\tfunc TestTheEnvVarBeatsAnEnabledSetting(t *testing.T) {\n363\t\t// The profile setting is the user's default; the variable is the operator's\n364\t\t// override, so it wins.\n365\t\tstore, path := newStore(t)\n366\t\tt.Setenv(EnvHistory, \"off\")\n367\t\n368\t\tif err := store.Append(NewEntry(SourceCall, canaryRequest(t), nil, Redactors{})); err != nil {\n369\t\t\tt.Fatalf(\"Append: %v\", err)\n370\t\t}\n371\t\n372\t\tassertNoFile(t, path)\n373\t}\n374\t\n375\tfunc TestReadSkipsACorruptLine(t *testing.T) {\n376\t\tstore, path := newStore(t)\n377\t\n378\t\tif err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {\n379\t\t\tt.Fatalf(\"mkdir: %v\", err)\n380\t\t}\n381\t\tlines := `{\"source\":\"call\",\"method\":\"GET\",\"url\":\"https://api.example.com/pets/1\"}\n382\t{\"source\":\"call\",\"method\":\"GET\",\n383\t{\"source\":\"call\",\"method\":\"GET\",\"url\":\"https://api.example.com/pets/3\"}\n384\t`\n385\t\tif err := os.WriteFile(path, []byte(lines), 0o600); err != nil {\n386\t\t\tt.Fatalf(\"writing the store: %v\", err)\n387\t\t}\n388\t\n389\t\tentries, err := store.Read()\n390\t\tif err != nil {\n391\t\t\tt.Fatalf(\"Read: %v\", err)\n392\t\t}\n393\t\tif len(entries) != 2 {\n394\t\t\tt.Fatalf(\"read %d entries, want the 2 readable ones\", len(entries))\n395\t\t}\n396\t\tif entries[1].URL != \"https://api.example.com/pets/3\" {\n397\t\t\tt.Errorf(\"second entry = %q, want the line after the corrupt one\", entries[1].URL)\n398\t\t}\n399\t}\n400\t\n401\tfunc TestReadOfAStoreThatWasNeverWrittenIsEmpty(t *testing.T) {\n402\t\tstore, _ := newStore(t)\n403\t\n404\t\tentries, err := store.Read()\n405\t\tif err != nil {\n406\t\t\tt.Fatalf(\"Read: %v\", err)\n407\t\t}\n408\t\tif len(entries) != 0 {\n409\t\t\tt.Errorf(\"read %d entries, want none\", len(entries))\n410\t\t}\n411\t}\n412\t\n413\tfunc TestPathFollowsXDGStateHome(t *testing.T) {\n414\t\tdir := t.TempDir()\n415\t\tt.Setenv(\"XDG_STATE_HOME\", dir)\n416\t\n417\t\tgot, err := New(\"\", true).Path()\n418\t\tif err != nil {\n419\t\t\tt.Fatalf(\"Path: %v\", err)\n420\t\t}\n421\t\tif want := filepath.Join(dir, \"talaria\", \"history.jsonl\"); got != want {\n422\t\t\tt.Errorf(\"Path() = %q, want %q\", got, want)\n423\t\t}\n424\t}\n425\t\n426\tfunc TestPathFallsBackToTheHomeStateDirectory(t *testing.T) {\n427\t\thome := t.TempDir()\n428\t\tt.Setenv(\"XDG_STATE_HOME\", \"\")\n429\t\tt.Setenv(\"HOME\", home)\n430\t\n431\t\tgot, err := New(\"\", true).Path()\n432\t\tif err != nil {\n433\t\t\tt.Fatalf(\"Path: %v\", err)\n434\t\t}\n435\t\tif want := filepath.Join(home, \".local\", \"state\", \"talaria\", \"history.jsonl\"); got != want {\n436\t\t\tt.Errorf(\"Path() = %q, want %q\", got, want)\n437\t\t}\n438\t}\n439\t\n440\tfunc assertNoFile(t *testing.T, path string) {\n441\t\tt.Helper()\n442\t\n443\t\tif _, err := os.Stat(path); !os.IsNotExist(err) {\n444\t\t\tt.Errorf(\"%s exists, want recording to have created nothing\", path)\n445\t\t}\n446\t\tif _, err := os.Stat(filepath.Dir(path)); !os.IsNotExist(err) {\n447\t\t\tt.Errorf(\"%s exists, want recording to have created nothing\", filepath.Dir(path))\n448\t\t}\n449\t}\n450\t\n451\tfunc firstLine(t *testing.T, path string) []byte {\n452\t\tt.Helper()\n453\t\n454\t\tdata, err := os.ReadFile(path)\n455\t\tif err != nil {\n456\t\t\tt.Fatalf(\"reading the store: %v\", err)\n457\t\t}\n458\t\n459\t\tline, _, _ := strings.Cut(string(data), \"\\n\")\n460\t\n461\t\treturn []byte(line)\n462\t}\n463\t"
