        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"io\"\n6\t\t\"net/http\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/spf13/cobra\"\n11\t\n12\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n13\t\t\"github.com/Teeeep/talaria/internal/config\"\n14\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n15\t\t\"github.com/Teeeep/talaria/internal/curl\"\n16\t\t\"github.com/Teeeep/talaria/internal/gen\"\n17\t\t\"github.com/Teeeep/talaria/internal/operation\"\n18\t\t\"github.com/Teeeep/talaria/internal/output\"\n19\t\t\"github.com/Teeeep/talaria/internal/request\"\n20\t\t\"github.com/Teeeep/talaria/internal/secret\"\n21\t\t\"github.com/Teeeep/talaria/internal/spec\"\n22\t\t\"github.com/Teeeep/talaria/internal/validate\"\n23\t)\n24\t\n25\t// runSeed is what the data generator draws from. It is a constant rather than a\n26\t// flag because a smoke test whose request bodies change between runs fails once,\n27\t// passes next time and teaches nobody anything (DESIGN.md §5a).\n28\tconst runSeed = 1\n29\t\n30\t// The three outcomes one operation can have. Skipped is deliberately not a\n31\t// failure: a DELETE left alone without --allow-mutations, or an operation whose\n32\t// path parameter nothing could supply, is correct behaviour rather than a\n33\t// broken API.\n34\tconst (\n35\t\toutcomePassed  = \"passed\"\n36\t\toutcomeFailed  = \"failed\"\n37\t\toutcomeSkipped = \"skipped\"\n38\t)\n39\t\n40\t// runResult is one operation's line in the report.\n41\ttype runResult struct {\n42\t\tOperationID string `json:\"operation_id\"`\n43\t\tMethod      string `json:\"method\"`\n44\t\tPath        string `json:\"path\"`\n45\t\tOutcome     string `json:\"outcome\"`\n46\t\t// Reason says why a skip or a failure happened. A passing operation has\n47\t\t// none: there is nothing to explain.\n48\t\tReason string `json:\"reason,omitempty\"`\n49\t\t// Status and TimingMS are absent for an operation that was never executed.\n50\t\t// TimingMS is a pointer so a call to a local server that legitimately\n51\t\t// rounded to 0ms is still reported as timed.\n52\t\tStatus     int              `json:\"status,omitempty\"`\n53\t\tTimingMS   *int64           `json:\"timing_ms,omitempty\"`\n54\t\tValidation *validate.Result `json:\"validation,omitempty\"`\n55\t}\n56\t\n57\t// runSummary is the count an agent, or a CI job, reads first.\n58\ttype runSummary struct {\n59\t\tTotal   int `json:\"total\"`\n60\t\tPassed  int `json:\"passed\"`\n61\t\tFailed  int `json:\"failed\"`\n62\t\tSkipped int `json:\"skipped\"`\n63\t}\n64\t\n65\t// runView is the whole report.\n66\ttype runView struct {\n67\t\tResults []runResult `json:\"results\"`\n68\t\tSummary runSummary  `json:\"summary\"`\n69\t}\n70\t\n71\tfunc newRunCmd() *cobra.Command {\n72\t\tvar (\n73\t\t\ttags           []string\n74\t\t\tids            []string\n75\t\t\tfixturesDir    string\n76\t\t\treport         string\n77\t\t\tallowMutations bool\n78\t\t\tfailOnError    bool\n79\t\t)\n80\t\n81\t\t// One warner for the whole command, as on `call`: a run that puts a\n82\t\t// credential in the query string makes the point once, not once per\n83\t\t// operation.\n84\t\twarner := secret.NewQueryKeyWarner()\n85\t\n86\t\tcmd := &cobra.Command{\n87\t\t\tUse:   \"run [spec]\",\n88\t\t\tShort: \"Smoke-test a spec's operations and report what each one did\",\n89\t\t\tLong: \"Call every operation the filters select, check each response against the\\n\" +\n90\t\t\t\t\"spec, and report one line per operation. Mutating operations are skipped\\n\" +\n91\t\t\t\t\"unless --allow-mutations is given. Request data comes from the spec's own\\n\" +\n92\t\t\t\t\"examples first, then --fixtures, then generation.\",\n93\t\t\tArgs: usageArgs(cobra.MaximumNArgs(1)),\n94\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n95\t\t\t\tformat, err := resolveReportFormat(cmd, report)\n96\t\t\t\tif err != nil {\n97\t\t\t\t\treturn err\n98\t\t\t\t}\n99\t\n100\t\t\t\tdoc, index, err := loadSpec(cmd, args)\n101\t\t\t\tif err != nil {\n102\t\t\t\t\treturn err\n103\t\t\t\t}\n104\t\n105\t\t\t\tops, err := selectOperations(index, tags, ids)\n106\t\t\t\tif err != nil {\n107\t\t\t\t\treturn err\n108\t\t\t\t}\n109\t\n110\t\t\t\trunner, err := newRunner(cmd, doc, fixturesDir, allowMutations, warner)\n111\t\t\t\tif err != nil {\n112\t\t\t\t\treturn err\n113\t\t\t\t}\n114\t\n115\t\t\t\t// Sequential, in spec order. Determinism beats speed here, and\n116\t\t\t\t// parallel calls against a real API are a surprise nobody asked for.\n117\t\t\t\tresults := make([]runResult, 0, len(ops))\n118\t\t\t\tfor _, op := range ops {\n119\t\t\t\t\tresults = append(results, runner.execute(op))\n120\t\t\t\t}\n121\t\n122\t\t\t\tview := runView{Results: results, Summary: summarise(results)}\n123\t\n124\t\t\t\t// Rendered before the exit code is decided, for the reason `call`\n125\t\t\t\t// renders first: the flags change what the process exits with, not\n126\t\t\t\t// what the caller gets to read.\n127\t\t\t\tif err := output.New(format, cmd.OutOrStdout()).Render(runPayload(view)); err != nil {\n128\t\t\t\t\treturn err\n129\t\t\t\t}\n130\t\n131\t\t\t\treturn runner.verdict(view, failOnError)\n132\t\t\t},\n133\t\t}\n134\t\n135\t\t// All local to run: no other command enumerates operations, reports on a\n136\t\t// suite, or has test data to supply.\n137\t\tcmd.Flags().StringArrayVar(&tags, \"tag\", nil,\n138\t\t\t\"only operations carrying this tag (repeatable)\")\n139\t\tcmd.Flags().StringArrayVar(&ids, \"operation\", nil,\n140\t\t\t\"only this operationId (repeatable); combined with --tag as a union\")\n141\t\tcmd.Flags().StringVar(&fixturesDir, \"fixtures\", \"\",\n142\t\t\t\"directory of <operationId>.json test data, consulted after spec examples\")\n143\t\tcmd.Flags().StringVar(&report, \"report\", \"\",\n144\t\t\t\"report format: json|pretty|tsv|junit (overrides --output)\")\n145\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n146\t\t\t\"include operations whose method is not GET, HEAD or OPTIONS\")\n147\t\tcmd.Flags().BoolVar(&failOnError, \"fail-on-error\", false,\n148\t\t\t\"exit 4 if any operation failed\")\n149\t\n150\t\treturn cmd\n151\t}\n152\t\n153\t// resolveReportFormat picks the format the report is written in. --report is\n154\t// run's own flag and wins over the persistent --output: an agent that set\n155\t// --output globally and then asked run for JSON must get JSON, not a format it\n156\t// asked for two flags ago.\n157\t//\n158\t// It also accepts junit, which --output does not: a suite of operations is the\n159\t// only thing there is to render as a test report, and `run` is the only command\n160\t// that produces one.\n161\tfunc resolveReportFormat(cmd *cobra.Command, report string) (output.Format, error) {\n162\t\tif report == \"\" {\n163\t\t\treturn resolveFormat(cmd)\n164\t\t}\n165\t\n166\t\tformat, err := output.ParseReportFormat(report)\n167\t\tif err != nil {\n168\t\t\treturn \"\", clierr.Usage(\"%w\", err).WithAlternatives(output.ReportFormats()...)\n169\t\t}\n170\t\n171\t\treturn format, nil\n172\t}\n173\t\n174\t// selectOperations applies --tag and --operation as a union, in spec order. No\n175\t// filters at all means the whole spec.\n176\t//\n177\t// A filter that selects nothing is a usage error rather than an empty pass: a\n178\t// mistyped tag that exits 0 with nothing tested is a green CI run that proves\n179\t// nothing, which is the one result a smoke test must never produce.\n180\tfunc selectOperations(index *operation.Index, tags, ids []string) ([]operation.Operation, error) {\n181\t\tif len(tags) == 0 && len(ids) == 0 {\n182\t\t\treturn index.Operations(), nil\n183\t\t}\n184\t\n185\t\tkeep := map[string]bool{}\n186\t\tfor _, tag := range tags {\n187\t\t\tfor _, op := range index.ByTag(tag) {\n188\t\t\t\tkeep[operationKey(op)] = true\n189\t\t\t}\n190\t\t}\n191\t\t// Looked up rather than matched, so a misspelt id gets Lookup's suggestions\n192\t\t// instead of silently selecting nothing.\n193\t\tfor _, id := range ids {\n194\t\t\top, err := index.Lookup(id)\n195\t\t\tif err != nil {\n196\t\t\t\treturn nil, err\n197\t\t\t}\n198\t\t\tkeep[operationKey(op)] = true\n199\t\t}\n200\t\n201\t\tvar ops []operation.Operation\n202\t\tfor _, op := range index.Operations() {\n203\t\t\tif keep[operationKey(op)] {\n204\t\t\t\tops = append(ops, op)\n205\t\t\t}\n206\t\t}\n207\t\tif len(ops) == 0 {\n208\t\t\treturn nil, clierr.Usage(\"no operation matches %s\",\n209\t\t\t\tstrings.Join(append(quoted(\"--tag\", tags), quoted(\"--operation\", ids)...), \" or \"))\n210\t\t}\n211\t\n212\t\treturn ops, nil\n213\t}\n214\t\n215\t// operationKey identifies an operation independently of its id, so the two\n216\t// filters can be unioned even for operations the spec never named.\n217\tfunc operationKey(op operation.Operation) string { return op.Method + \" \" + op.Path }\n218\t\n219\t// quoted renders one filter's values for an error message.\n220\tfunc quoted(flag string, values []string) []string {\n221\t\tout := make([]string, 0, len(values))\n222\t\tfor _, value := range values {\n223\t\t\tout = append(out, fmt.Sprintf(\"%s %q\", flag, value))\n224\t\t}\n225\t\n226\t\treturn out\n227\t}\n228\t\n229\t// runner holds everything one suite reuses across operations: the compiled\n230\t// validator, the seeded generator, the history store and the redactors. Built\n231\t// once so the per-operation loop only makes requests.\n232\ttype runner struct {\n233\t\tdoc       *spec.Document\n234\t\tprofile   *config.Profile\n235\t\tbaseURL   string\n236\t\tgen       *gen.Generator\n237\t\tvalidator *validate.Validator\n238\t\tstore     *corpus.Store\n239\t\tredactors corpus.Redactors\n240\t\twarner    *secret.QueryKeyWarner\n241\t\tstderr    io.Writer\n242\t\n243\t\tallowMutations bool\n244\t\t// missing collects the security schemes that stopped an operation from\n245\t\t// running, in the display form the exit-5 error reports.\n246\t\tmissing []string\n247\t}\n248\t\n249\tfunc newRunner(\n250\t\tcmd *cobra.Command,\n251\t\tdoc *spec.Document,\n252\t\tfixturesDir string,\n253\t\tallowMutations bool,\n254\t\twarner *secret.QueryKeyWarner,\n255\t) (*runner, error) {\n256\t\t// The whole fixtures directory is read up front, before any request goes\n257\t\t// out: a typo in a fixture should not surface halfway through a suite.\n258\t\tfixtures, err := gen.LoadFixtures(fixturesDir)\n259\t\tif err != nil {\n260\t\t\treturn nil, err\n261\t\t}\n262\t\n263\t\tcfg, err := config.Load(\"\")\n264\t\tif err != nil {\n265\t\t\treturn nil, err\n266\t\t}\n267\t\n268\t\tprofile, err := selectProfile(cmd, cfg)\n269\t\tif err != nil {\n270\t\t\treturn nil, err\n271\t\t}\n272\t\n273\t\tstore, err := openHistory(cmd, cfg)\n274\t\tif err != nil {\n275\t\t\treturn nil, err\n276\t\t}\n277\t\n278\t\tbaseURL, err := cmd.Flags().GetString(\"base-url\")\n279\t\tif err != nil {\n280\t\t\treturn nil, clierr.Usage(\"%w\", err)\n281\t\t}\n282\t\n283\t\tgenerator := gen.New(runSeed)\n284\t\tgenerator.Fixtures = fixtures\n285\t\n286\t\treturn &runner{\n287\t\t\tdoc:            doc,\n288\t\t\tprofile:        profile,\n289\t\t\tbaseURL:        baseURL,\n290\t\t\tgen:            generator,\n291\t\t\tvalidator:      validate.New(doc),\n292\t\t\tstore:          store,\n293\t\t\tredactors:      newRedactors(cfg),\n294\t\t\twarner:         warner,\n295\t\t\tstderr:         cmd.ErrOrStderr(),\n296\t\t\tallowMutations: allowMutations,\n297\t\t}, nil\n298\t}\n299\t\n300\t// execute runs one operation and reports what happened. It never returns an\n301\t// error: one operation's problem is a line in the report, not the end of the\n302\t// suite, and the exit code is decided once at the end from the whole of it.\n303\tfunc (r *runner) execute(op operation.Operation) runResult {\n304\t\tres := runResult{\n305\t\t\tOperationID: operationName(op),\n306\t\t\tMethod:      op.Method,\n307\t\t\tPath:        op.Path,\n308\t\t}\n309\t\n310\t\tif op.IsMutation() && !r.allowMutations {\n311\t\t\treturn res.skip(\"a %s request may change server state: pass --allow-mutations to include it\",\n312\t\t\t\top.Method)\n313\t\t}\n314\t\n315\t\tcreds, err := config.Resolve(op, r.doc, r.profile)\n316\t\tif err != nil {\n317\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n318\t\t}\n319\t\t// Checked before the request is built rather than left to fail at exec\n320\t\t// time, so an agent gets the variable to export and the server gets no\n321\t\t// request it was always going to reject.\n322\t\tif missing := missingCredentials(creds); len(missing) > 0 {\n323\t\t\tr.noteMissing(missing)\n324\t\n325\t\t\treturn res.skip(\"no credential for security %s\",\n326\t\t\t\tpluralise(len(missing), \"scheme\")+\" \"+strings.Join(missing, \", \"))\n327\t\t}\n328\t\n329\t\tdata := r.gen.DataFor(op)\n330\t\treq, err := request.Build(request.Inputs{\n331\t\t\tOp:      op,\n332\t\t\tDoc:     r.doc,\n333\t\t\tProfile: r.profile,\n334\t\t\tCreds:   creds,\n335\t\t\tBaseURL: r.baseURL,\n336\t\t\tParams:  flagPairs(data.Params),\n337\t\t\tHeaders: flagPairs(data.Headers),\n338\t\t\tBody:    bodyFlag(data.Body),\n339\t\t\t// No stdin: `run` makes many requests and stdin can only be read once,\n340\t\t\t// so there is nothing here for `--body -` to mean.\n341\t\t})\n342\t\tif err != nil {\n343\t\t\t// A request that cannot be built is data talaria could not supply, not\n344\t\t\t// an API that misbehaved, so it is a skip carrying the builder's own\n345\t\t\t// message — which names the parameter.\n346\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n347\t\t}\n348\t\n349\t\twarnQueryCredentials(r.stderr, r.warner, req)\n350\t\n351\t\tresp, execErr := curl.Execute(req)\n352\t\t// Recorded either way, as `call` records: a request that never completed is\n353\t\t// still something that was tried.\n354\t\trecordCall(r.stderr, r.store, corpus.SourceRun, req, resp, r.redactors)\n355\t\tif execErr != nil {\n356\t\t\treturn res.fail(\"%s\", clierr.From(execErr).Message)\n357\t\t}\n358\t\n359\t\tview := redactResponse(resp, r.redactors.Response)\n360\t\ttiming := view.TimingMS\n361\t\tres.Status, res.TimingMS = view.Status, &timing\n362\t\tres.Validation = validateWith(r.stderr, r.validator, req, view)\n363\t\n364\t\treturn res.judge()\n365\t}\n366\t\n367\t// noteMissing records the credentials blocking an operation, without repeating\n368\t// one that already blocked another.\n369\tfunc (r *runner) noteMissing(missing []string) {\n370\t\tfor _, name := range missing {\n371\t\t\tif !slicesContains(r.missing, name) {\n372\t\t\t\tr.missing = append(r.missing, name)\n373\t\t\t}\n374\t\t}\n375\t}\n376\t\n377\t// verdict turns the finished report into an exit code.\n378\t//\n379\t// A missing credential exits 5 whether or not --fail-on-error was given, as\n380\t// `auth check` does: it means the suite did not test the operation at all,\n381\t// which is a different thing from an API that answered badly, and an agent\n382\t// acts on it by exporting a variable rather than by reading the report.\n383\tfunc (r *runner) verdict(view runView, failOnError bool) error {\n384\t\tif len(r.missing) > 0 {\n385\t\t\treturn clierr.CredentialMissing(\"no credential for security %s %s\",\n386\t\t\t\tpluralise(len(r.missing), \"scheme\"), strings.Join(r.missing, \", \"))\n387\t\t}\n388\t\tif failOnError && view.Summary.Failed > 0 {\n389\t\t\treturn clierr.Validation(\"%s failed\", pluralise(view.Summary.Failed, \"operation\"))\n390\t\t}\n391\t\n392\t\treturn nil\n393\t}\n394\t\n395\t// skip marks an operation as not run, and why.\n396\tfunc (res runResult) skip(format string, a ...any) runResult {\n397\t\tres.Outcome, res.Reason = outcomeSkipped, fmt.Sprintf(format, a...)\n398\t\n399\t\treturn res\n400\t}\n401\t\n402\t// fail marks an operation as run and wrong, and why.\n403\tfunc (res runResult) fail(format string, a ...any) runResult {\n404\t\tres.Outcome, res.Reason = outcomeFailed, fmt.Sprintf(format, a...)\n405\t\n406\t\treturn res\n407\t}\n408\t\n409\t// judge decides the outcome of an operation that reached the server. The HTTP\n410\t// status is reported first when both apply, for `call --fail-on-error`'s\n411\t// reason: a 500 whose body does not match the error schema is a server that is\n412\t// down, not a server with a documentation problem.\n413\tfunc (res runResult) judge() runResult {\n414\t\tswitch {\n415\t\tcase res.Status >= http.StatusBadRequest:\n416\t\t\treturn res.fail(\"the server returned %s\", statusText(res.Status))\n417\t\tcase res.Validation != nil && len(res.Validation.Errors) > 0:\n418\t\t\treturn res.fail(\"the response violates the spec: %s\",\n419\t\t\t\tpluralise(len(res.Validation.Errors), \"validation error\"))\n420\t\tdefault:\n421\t\t\tres.Outcome = outcomePassed\n422\t\n423\t\t\treturn res\n424\t\t}\n425\t}\n426\t\n427\t// missingCredentials names the credentials an operation needs and does not\n428\t// have, in the form `scheme (set $VAR)` — the same phrasing `auth check` uses,\n429\t// because it answers the same question.\n430\tfunc missingCredentials(creds []config.Credential) []string {\n431\t\tvar missing []string\n432\t\tfor _, cred := range creds {\n433\t\t\tif !cred.Present() {\n434\t\t\t\tmissing = append(missing, cred.Scheme+\" (set \"+cred.Ref.Symbolic()+\")\")\n435\t\t\t}\n436\t\t}\n437\t\n438\t\treturn missing\n439\t}\n440\t\n441\t// flagPairs renders generated data as the `name=value` strings request.Build\n442\t// parses, sorted so two runs of the same spec build byte-identical requests.\n443\tfunc flagPairs(values map[string]string) []string {\n444\t\tout := make([]string, 0, len(values))\n445\t\tfor name, value := range values {\n446\t\t\tout = append(out, name+\"=\"+value)\n447\t\t}\n448\t\tsort.Strings(out)\n449\t\n450\t\treturn out\n451\t}\n452\t\n453\t// bodyFlag renders a generated body as the --body value it stands in for, so\n454\t// the media type is chosen by the one piece of code that chooses media types.\n455\t// Generated and fixture bodies are always JSON, so neither can collide with\n456\t// --body's `@file` and `-` spellings.\n457\tfunc bodyFlag(body []byte) []string {\n458\t\tif len(body) == 0 {\n459\t\t\treturn nil\n460\t\t}\n461\t\n462\t\treturn []string{string(body)}\n463\t}\n464\t\n465\t// summarise counts the outcomes.\n466\tfunc summarise(results []runResult) runSummary {\n467\t\tsummary := runSummary{Total: len(results)}\n468\t\tfor _, res := range results {\n469\t\t\tswitch res.Outcome {\n470\t\t\tcase outcomePassed:\n471\t\t\t\tsummary.Passed++\n472\t\t\tcase outcomeFailed:\n473\t\t\t\tsummary.Failed++\n474\t\t\tdefault:\n475\t\t\t\tsummary.Skipped++\n476\t\t\t}\n477\t\t}\n478\t\n479\t\treturn summary\n480\t}\n481\t\n482\t// runPayload builds the JSON view and the table from the same results.\n483\t//\n484\t// The table is one row per operation and then the summary, which is the shape a\n485\t// human reads top to bottom and a `grep -c failed` reads too. The last row is a\n486\t// single cell, so tabwriter leaves it unpadded rather than aligning a sentence\n487\t// into the status column.\n488\tfunc runPayload(view runView) output.Payload {\n489\t\trows := make([][]string, 0, len(view.Results)+1)\n490\t\tfor _, res := range view.Results {\n491\t\t\trows = append(rows, []string{\n492\t\t\t\tres.Outcome,\n493\t\t\t\tres.Method,\n494\t\t\t\tres.Path,\n495\t\t\t\tres.OperationID,\n496\t\t\t\tstatusCell(res.Status),\n497\t\t\t\tres.Reason,\n498\t\t\t})\n499\t\t}\n500\t\trows = append(rows, []string{summaryLine(view.Summary)})\n501\t\n502\t\treturn output.Payload{\n503\t\t\tData:  view,\n504\t\t\tTable: output.Table{Rows: rows},\n505\t\t\tJUnit: junitSuite(view),\n506\t\t}\n507\t}\n508\t\n509\t// junitSuite is the same results as a test suite, for `--report junit`.\n510\t//\n511\t// A skip stays a skip rather than becoming a failure: a DELETE left alone\n512\t// without --allow-mutations is correct behaviour, and a CI job that went red\n513\t// over it would be turned off within a week.\n514\tfunc junitSuite(view runView) output.Suite {\n515\t\tcases := make([]output.Case, 0, len(view.Results))\n516\t\tfor _, res := range view.Results {\n517\t\t\tc := output.Case{Name: res.OperationID, Seconds: res.seconds()}\n518\t\t\tswitch res.Outcome {\n519\t\t\tcase outcomeFailed:\n520\t\t\t\tc.Failure = res.Reason\n521\t\t\tcase outcomeSkipped:\n522\t\t\t\tc.Skipped = res.Reason\n523\t\t\t}\n524\t\n525\t\t\tcases = append(cases, c)\n526\t\t}\n527\t\n528\t\treturn output.Suite{Name: \"talaria run\", Cases: cases}\n529\t}\n530\t\n531\t// seconds is the operation's timing in the unit JUnit's time attribute is\n532\t// defined in. An operation that never reached a server took no measured time\n533\t// rather than an unknown one: it is reported as 0, with the <skipped> child\n534\t// saying why.\n535\tfunc (res runResult) seconds() float64 {\n536\t\tif res.TimingMS == nil {\n537\t\t\treturn 0\n538\t\t}\n539\t\n540\t\treturn float64(*res.TimingMS) / 1000\n541\t}\n542\t\n543\t// summaryLine is the one line a human is looking for.\n544\tfunc summaryLine(s runSummary) string {\n545\t\treturn fmt.Sprintf(\"%s: %d passed, %d failed, %d skipped\",\n546\t\t\tpluralise(s.Total, \"operation\"), s.Passed, s.Failed, s.Skipped)\n547\t}\n548\t\n549\t// slicesContains reports whether values already holds value.\n550\tfunc slicesContains(values []string, value string) bool {\n551\t\tfor _, v := range values {\n552\t\t\tif v == value {\n553\t\t\t\treturn true\n554\t\t\t}\n555\t\t}\n556\t\n557\t\treturn false\n558\t}\n559\t"
      }
