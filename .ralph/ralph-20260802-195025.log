        "tool_use_id": "toolu_017dR9y38BCFExpzKovzKyFz",
        "type": "tool_result",
        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"strings\"\n6\t\t\"unicode/utf8\"\n7\t\n8\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n9\t\t\"github.com/Teeeep/talaria/internal/request\"\n10\t)\n11\t\n12\t// maxInlineBody is the size above which a body stops being a directive and\n13\t// becomes a 0600 temp file. DESIGN.md §5a calls the temp file \"the exception\":\n14\t// it is a real file on disk for the length of one exec, so the threshold is set\n15\t// where the config document stops being a reasonable place to put bytes rather\n16\t// than at any hard limit of curl's.\n17\tconst maxInlineBody = 1 << 20\n18\t\n19\t// Capture names the files curl writes the response to. Both are optional; the\n20\t// executor allocates them and passes them here rather than appending them to\n21\t// argv, because §5a's rule is that *nothing* about the call is an argument, not\n22\t// merely nothing sensitive.\n23\ttype Capture struct {\n24\t\t// BodyPath receives the response body, via the output directive.\n25\t\tBodyPath string\n26\t\t// HeaderPath receives the response headers, via the dump-header directive.\n27\t\tHeaderPath string\n28\t}\n29\t\n30\t// BuildConfig renders req as a curl config document for `curl -K -`.\n31\t//\n32\t// This is the one place in talaria where a resolved credential exists. The\n33\t// document is written to curl's stdin and holds the real values; the returned\n34\t// argv is exactly `curl -K -` and holds nothing, because /proc/*/cmdline is\n35\t// readable by any process on the host — including ones an agent spawns (§5a).\n36\t//\n37\t// cleanup must be called once curl has exited. It removes any temp body file\n38\t// and zeroes the document, so the resolved values do not linger in a buffer the\n39\t// rest of the process can still reach. It is safe to call more than once, and\n40\t// is non-nil even when BuildConfig fails.\n41\t//\n42\t// A credential whose environment variable is unset fails with exit code 5 and\n43\t// no document, rather than sending an empty header — an unauthenticated request\n44\t// that looks authenticated is the worse outcome (§4).\n45\tfunc BuildConfig(req *request.Request, capture Capture) (config []byte, argv []string, cleanup func(), err error) {\n46\t\targv = []string{\"curl\", \"-K\", \"-\"}\n47\t\tif req == nil {\n48\t\t\treturn nil, argv, func() {}, clierr.RequestFailed(\"no request to execute\")\n49\t\t}\n50\t\n51\t\tvar doc document\n52\t\tif err := doc.build(req, capture); err != nil {\n53\t\t\tdoc.discard()\n54\t\t\treturn nil, argv, doc.cleanup, err\n55\t\t}\n56\t\n57\t\tconfig = []byte(doc.b.String())\n58\t\tdoc.b.Reset()\n59\t\n60\t\treturn config, argv, doc.cleanupWith(config), nil\n61\t}\n62\t\n63\t// document accumulates the directives and the temp files they point at, so a\n64\t// failure part-way through still knows what to remove.\n65\ttype document struct {\n66\t\tb     strings.Builder\n67\t\tfiles []string\n68\t}\n69\t\n70\tfunc (d *document) build(req *request.Request, capture Capture) error {\n71\t\turl, err := req.URL(resolve)\n72\t\tif err != nil {\n73\t\t\treturn err\n74\t\t}\n75\t\td.directive(\"url\", url)\n76\t\n77\t\tif req.Method != \"\" {\n78\t\t\td.directive(\"request\", req.Method)\n79\t\t}\n80\t\n81\t\tif err := d.auth(req); err != nil {\n82\t\t\treturn err\n83\t\t}\n84\t\tif err := d.cookies(req); err != nil {\n85\t\t\treturn err\n86\t\t}\n87\t\tif err := d.body(req); err != nil {\n88\t\t\treturn err\n89\t\t}\n90\t\n91\t\t// Defence in depth behind request.IsHTTPScheme: curl speaks file, gopher,\n92\t\t// dict and smb, and a redirect chooses the scheme of the next hop without\n93\t\t// asking talaria. The leading `=` makes each list absolute rather than\n94\t\t// additive, so these two are the only protocols this process can use.\n95\t\td.directive(\"proto\", \"=http,https\")\n96\t\td.directive(\"proto-redir\", \"=http,https\")\n97\t\n98\t\t// silent suppresses the progress meter, which would otherwise be interleaved\n99\t\t// with the write-out payload on stdout; show-error keeps real failures\n100\t\t// visible despite it.\n101\t\td.flag(\"silent\")\n102\t\td.flag(\"show-error\")\n103\t\t// %{json} is the whole response metadata in one parseable object, and is the\n104\t\t// reason DESIGN.md sets a curl >= 7.70 floor.\n105\t\td.directive(\"write-out\", \"%{json}\")\n106\t\n107\t\tif capture.BodyPath != \"\" {\n108\t\t\td.directive(\"output\", capture.BodyPath)\n109\t\t}\n110\t\tif capture.HeaderPath != \"\" {\n111\t\t\td.directive(\"dump-header\", capture.HeaderPath)\n112\t\t}\n113\t\n114\t\treturn nil\n115\t}\n116\t\n117\t// auth writes the request headers, diverting basic auth to curl's own user\n118\t// directive: the header text is base64(user:password), and letting curl encode\n119\t// it means this package never has to.\n120\tfunc (d *document) auth(req *request.Request) error {\n121\t\tfor _, h := range req.Headers {\n122\t\t\tvalue, err := resolve(h.Value)\n123\t\t\tif err != nil {\n124\t\t\t\treturn err\n125\t\t\t}\n126\t\n127\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n128\t\t\t\td.directive(\"user\", strings.TrimPrefix(value, h.Value.Prefix()))\n129\t\t\t\tcontinue\n130\t\t\t}\n131\t\n132\t\t\td.directive(\"header\", h.Name+\": \"+value)\n133\t\t}\n134\t\n135\t\treturn nil\n136\t}\n137\t\n138\t// cookies writes every cookie as one directive. curl keeps only the last of\n139\t// several, so they are joined rather than repeated.\n140\tfunc (d *document) cookies(req *request.Request) error {\n141\t\tif len(req.Cookies) == 0 {\n142\t\t\treturn nil\n143\t\t}\n144\t\n145\t\tvar b strings.Builder\n146\t\tfor i, c := range req.Cookies {\n147\t\t\tvalue, err := resolve(c.Value)\n148\t\t\tif err != nil {\n149\t\t\t\treturn err\n150\t\t\t}\n151\t\n152\t\t\tif i > 0 {\n153\t\t\t\tb.WriteString(\"; \")\n154\t\t\t}\n155\t\t\tb.WriteString(c.Name + \"=\" + value)\n156\t\t}\n157\t\n158\t\td.directive(\"cookie\", b.String())\n159\t\n160\t\treturn nil\n161\t}\n162\t\n163\t// body writes the request body, inline when it can be and via a temp file when\n164\t// it cannot.\n165\tfunc (d *document) body(req *request.Request) error {\n166\t\tif req.Body == nil {\n167\t\t\treturn nil\n168\t\t}\n169\t\n170\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n171\t\t\td.directive(\"header\", \"Content-Type: \"+req.Body.ContentType)\n172\t\t}\n173\t\n174\t\tif inlinable(req.Body.Data) {\n175\t\t\t// data-raw rather than data or data-binary: those two read a value\n176\t\t\t// starting with @ as a filename, and a JSON body legitimately can. Verified\n177\t\t\t// against curl 8.14.1 — data-raw sends the bytes as given and strips\n178\t\t\t// nothing, where `data = \"@path\"` also strips newlines.\n179\t\t\td.directive(\"data-raw\", string(req.Body.Data))\n180\t\t\treturn nil\n181\t\t}\n182\t\n183\t\tpath, err := d.tempFile(req.Body.Data)\n184\t\tif err != nil {\n185\t\t\treturn err\n186\t\t}\n187\t\t// The file's bytes are read verbatim, so data-binary rather than data: data\n188\t\t// strips newlines and carriage returns out of a file, which corrupts any\n189\t\t// pretty-printed JSON and breaks any signed payload.\n190\t\td.directive(\"data-binary\", \"@\"+path)\n191\t\n192\t\treturn nil\n193\t}\n194\t\n195\t// inlinable reports whether a body can live in the config document. Valid UTF-8\n196\t// under the size limit can; anything else takes the temp-file path, because a\n197\t// NUL byte truncates a quoted value and arbitrary bytes have no escape sequence\n198\t// that survives curl's parser.\n199\tfunc inlinable(data []byte) bool {\n200\t\tif len(data) > maxInlineBody || !utf8.Valid(data) {\n201\t\t\treturn false\n202\t\t}\n203\t\n204\t\treturn !strings.ContainsRune(string(data), 0)\n205\t}\n206\t\n207\t// tempFile writes data to a 0600 file and records it for cleanup.\n208\tfunc (d *document) tempFile(data []byte) (string, error) {\n209\t\tf, err := os.CreateTemp(\"\", \"talaria-body-*\")\n210\t\tif err != nil {\n211\t\t\treturn \"\", clierr.RequestFailed(\"cannot stage the request body: %w\", err)\n212\t\t}\n213\t\td.files = append(d.files, f.Name())\n214\t\n215\t\t// CreateTemp already makes the file 0600; setting it explicitly keeps that a\n216\t\t// guarantee of this code rather than of the standard library's current\n217\t\t// behaviour, since the body may carry credentials the user put in it.\n218\t\tif err := f.Chmod(0o600); err != nil {\n219\t\t\tf.Close()\n220\t\t\treturn \"\", clierr.RequestFailed(\"cannot secure the request body file: %w\", err)\n221\t\t}\n222\t\n223\t\tif _, err := f.Write(data); err != nil {\n224\t\t\tf.Close()\n225\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n226\t\t}\n227\t\n228\t\tif err := f.Close(); err != nil {\n229\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n230\t\t}\n231\t\n232\t\treturn f.Name(), nil\n233\t}\n234\t\n235\t// directive writes one `name = \"value\"` line, escaped for curl's parser.\n236\tfunc (d *document) directive(name, value string) {\n237\t\td.b.WriteString(name + ` = \"` + escapeDirective(value) + \"\\\"\\n\")\n238\t}\n239\t\n240\t// flag writes one bare directive, the config form of a boolean option.\n241\tfunc (d *document) flag(name string) { d.b.WriteString(name + \"\\n\") }\n242\t\n243\t// discard drops a partially built document, so a failure returns nothing a\n244\t// caller could accidentally send or print.\n245\tfunc (d *document) discard() { d.b.Reset() }\n246\t\n247\t// cleanup removes the temp files this document points at.\n248\tfunc (d *document) cleanup() {\n249\t\tfor _, path := range d.files {\n250\t\t\tos.Remove(path) //nolint:errcheck // Best effort; the file is 0600 and in TMPDIR.\n251\t\t}\n252\t\td.files = nil\n253\t}\n254\t\n255\t// cleanupWith also zeroes the finished document, so the resolved credentials in\n256\t// it stop being readable from the buffer once curl has exited.\n257\tfunc (d *document) cleanupWith(config []byte) func() {\n258\t\treturn func() {\n259\t\t\td.cleanup()\n260\t\t\tfor i := range config {\n261\t\t\t\tconfig[i] = 0\n262\t\t\t}\n263\t\t}\n264\t}\n265\t\n266\t// resolve is the renderer that reads real credential values. It is the single\n267\t// crossing of the firewall described in DESIGN.md §5a: every other renderer in\n268\t// talaria produces a redacted or symbolic form, and this one exists only to\n269\t// feed the config document.\n270\tfunc resolve(v request.Value) (string, error) {\n271\t\tif !v.IsSecret() {\n272\t\t\t// Reveal rather than String: a literal the user typed under a\n273\t\t\t// credential-shaped name displays redacted everywhere else, and the\n274\t\t\t// wire is the one place it must not.\n275\t\t\treturn v.Reveal(), nil\n276\t\t}\n277\t\n278\t\tvalue, err := v.Ref().Resolve()\n279\t\tif err != nil {\n280\t\t\treturn \"\", err\n281\t\t}\n282\t\n283\t\treturn v.Prefix() + value, nil\n284\t}\n285\t\n286\t// configEscape covers the escape sequences curl's config parser understands, in\n287\t// the order a single pass must apply them. strings.Replacer scans once and\n288\t// picks the longest match at each position, which is what keeps the backslash\n289\t// rule from re-escaping the backslashes the other rules just introduced — the\n290\t// double-escaping bug that ordered sequential replaces invite.\n291\tvar configEscape = strings.NewReplacer(\n292\t\t`\\`, `\\\\`,\n293\t\t`\"`, `\\\"`,\n294\t\t\"\\t\", `\\t`,\n295\t\t\"\\n\", `\\n`,\n296\t\t\"\\r\", `\\r`,\n297\t)\n298\t\n299\tfunc escapeDirective(s string) string { return configEscape.Replace(s) }\n300\t"
