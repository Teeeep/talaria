        "content": "1\tpackage corpus\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io/fs\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t)\n13\t\n14\t// EnvHistory switches recording off wherever talaria runs. It is read here\n15\t// rather than layered in with the profile settings because it is the operator's\n16\t// override: `history.enabled` is what a user configured, and this is what\n17\t// someone auditing a machine sets, so it wins over both.\n18\tconst EnvHistory = \"TALARIA_HISTORY\"\n19\t\n20\tconst (\n21\t\t// fileName is the store, one JSON entry per line, under the state directory.\n22\t\tfileName = \"history.jsonl\"\n23\t\t// lockSuffix names the sibling file appends hold their advisory lock on. It\n24\t\t// is a separate file so the lock outlives trim's rename of the store.\n25\t\tlockSuffix = \".lock\"\n26\t\t// maxPerSource is the retention cap, applied per Source rather than over the\n27\t\t// whole file: a single `run` over a large spec would otherwise evict every\n28\t\t// interactive call a session had made.\n29\t\tmaxPerSource = 1000\n30\t\n31\t\tdirMode  fs.FileMode = 0o700\n32\t\tfileMode fs.FileMode = 0o600\n33\t)\n34\t\n35\t// Store is the append-only history file.\n36\t//\n37\t// Failures from its methods are deliberately unclassified: a call that reached\n38\t// the server and came back is a success, and whether talaria managed to write\n39\t// the fact down afterwards is the caller's decision to report, not a reason to\n40\t// change the command's exit code.\n41\ttype Store struct {\n42\t\tdir     string\n43\t\tenabled bool\n44\t}\n45\t\n46\t// New returns a store writing under dir, recording only when enabled.\n47\t//\n48\t// An empty dir means the default state directory; tests pass a temporary one.\n49\t// The enabled flag is the profile's `history.enabled` as the caller resolved it\n50\t// — this package never reads the config itself, so that the twin can use the\n51\t// same store without one.\n52\tfunc New(dir string, enabled bool) *Store {\n53\t\treturn &Store{dir: dir, enabled: enabled}\n54\t}\n55\t\n56\t// Path is the history file's location.\n57\tfunc (s *Store) Path() (string, error) {\n58\t\tdir := \"\"\n59\t\tif s != nil {\n60\t\t\tdir = s.dir\n61\t\t}\n62\t\n63\t\tif dir == \"\" {\n64\t\t\tbase, err := stateDir()\n65\t\t\tif err != nil {\n66\t\t\t\treturn \"\", fmt.Errorf(\"cannot locate the talaria state directory: %w\", err)\n67\t\t\t}\n68\t\t\tdir = base\n69\t\t}\n70\t\n71\t\treturn filepath.Join(dir, fileName), nil\n72\t}\n73\t\n74\t// Recording reports whether Append will write anything, so a caller can skip\n75\t// building an entry it is only going to throw away.\n76\tfunc (s *Store) Recording() bool {\n77\t\tif s == nil || !s.enabled {\n78\t\t\treturn false\n79\t\t}\n80\t\n81\t\treturn !off(os.Getenv(EnvHistory))\n82\t}\n83\t\n84\t// Append records one entry and applies the retention cap.\n85\t//\n86\t// The write and the trim are one critical section. Trim rewrites the whole file\n87\t// from a snapshot it read, so an entry appended between that read and the\n88\t// rename would be dropped silently — Append had already returned nil for it, so\n89\t// nothing would ever report it missing. Holding the lock across both is what\n90\t// makes a nil return mean the entry is in the store.\n91\t//\n92\t// With recording off it does nothing at all — no file, no directory, no lock.\n93\t// An opt-out that still left a history file behind would not be one.\n94\tfunc (s *Store) Append(e Entry) error {\n95\t\tif !s.Recording() {\n96\t\t\treturn nil\n97\t\t}\n98\t\n99\t\tpath, err := s.Path()\n100\t\tif err != nil {\n101\t\t\treturn err\n102\t\t}\n103\t\n104\t\tline, err := json.Marshal(e)\n105\t\tif err != nil {\n106\t\t\treturn fmt.Errorf(\"cannot encode the history entry: %w\", err)\n107\t\t}\n108\t\n109\t\tunlock, err := lock(path)\n110\t\tif err != nil {\n111\t\t\treturn err\n112\t\t}\n113\t\tdefer unlock()\n114\t\n115\t\tif err := write(path, append(line, '\\n')); err != nil {\n116\t\t\treturn err\n117\t\t}\n118\t\n119\t\treturn trim(path)\n120\t}\n121\t\n122\t// Read returns every readable entry, oldest first.\n123\t//\n124\t// It does not consult the recording setting: history written before recording\n125\t// was switched off is still history, and reading it puts nothing new on disk.\n126\t// A store that was never written is empty rather than an error.\n127\tfunc (s *Store) Read() ([]Entry, error) {\n128\t\tpath, err := s.Path()\n129\t\tif err != nil {\n130\t\t\treturn nil, err\n131\t\t}\n132\t\n133\t\tdata, err := os.ReadFile(path)\n134\t\tif errors.Is(err, fs.ErrNotExist) {\n135\t\t\treturn nil, nil\n136\t\t}\n137\t\tif err != nil {\n138\t\t\treturn nil, fmt.Errorf(\"cannot read the history file: %w\", err)\n139\t\t}\n140\t\n141\t\tvar entries []Entry\n142\t\tfor _, line := range lines(data) {\n143\t\t\tvar entry Entry\n144\t\t\t// A line that will not parse is skipped rather than fatal. The file is\n145\t\t\t// appended to by every call, so a process killed mid-write leaves a\n146\t\t\t// partial last line, and losing every earlier entry to it would make the\n147\t\t\t// store fragile exactly when something has already gone wrong.\n148\t\t\tif err := json.Unmarshal(line, &entry); err != nil {\n149\t\t\t\tcontinue\n150\t\t\t}\n151\t\t\tentries = append(entries, entry)\n152\t\t}\n153\t\n154\t\treturn entries, nil\n155\t}\n156\t\n157\t// write appends one line, creating the directory and the file with the modes\n158\t// DESIGN.md §5a requires of talaria's highest-risk artifact.\n159\tfunc write(path string, line []byte) error {\n160\t\tdir := filepath.Dir(path)\n161\t\tif err := os.MkdirAll(dir, dirMode); err != nil {\n162\t\t\treturn fmt.Errorf(\"cannot create the history directory: %w\", err)\n163\t\t}\n164\t\t// MkdirAll leaves an existing directory's mode alone and gives a new one\n165\t\t// dirMode masked by the umask. The Chmod makes 0700 a guarantee rather than\n166\t\t// an inherited default.\n167\t\tif err := os.Chmod(dir, dirMode); err != nil {\n168\t\t\treturn fmt.Errorf(\"cannot secure the history directory: %w\", err)\n169\t\t}\n170\t\n171\t\tf, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, fileMode)\n172\t\tif err != nil {\n173\t\t\treturn fmt.Errorf(\"cannot open the history file: %w\", err)\n174\t\t}\n175\t\tif err := f.Chmod(fileMode); err != nil {\n176\t\t\tf.Close() //nolint:errcheck // The Chmod failure is the one worth reporting.\n177\t\t\treturn fmt.Errorf(\"cannot secure the history file: %w\", err)\n178\t\t}\n179\t\tif _, err := f.Write(line); err != nil {\n180\t\t\tf.Close() //nolint:errcheck // The Write failure is the one worth reporting.\n181\t\t\treturn fmt.Errorf(\"cannot write the history entry: %w\", err)\n182\t\t}\n183\t\n184\t\tif err := f.Close(); err != nil {\n185\t\t\treturn fmt.Errorf(\"cannot write the history entry: %w\", err)\n186\t\t}\n187\t\n188\t\treturn nil\n189\t}\n190\t\n191\t// trim enforces the per-source cap, rewriting the file only when some source is\n192\t// over it. The common append leaves the file alone.\n193\tfunc trim(path string) error {\n194\t\tdata, err := os.ReadFile(path)\n195\t\tif err != nil {\n196\t\t\treturn fmt.Errorf(\"cannot read the history file: %w\", err)\n197\t\t}\n198\t\n199\t\tall := lines(data)\n200\t\tsources := make([]Source, len(all))\n201\t\treadable := make([]bool, len(all))\n202\t\tcounts := map[Source]int{}\n203\t\tfor i, line := range all {\n204\t\t\tsource, ok := lineSource(line)\n205\t\t\tsources[i], readable[i] = source, ok\n206\t\t\tif ok {\n207\t\t\t\tcounts[source]++\n208\t\t\t}\n209\t\t}\n210\t\n211\t\tdrop := map[Source]int{}\n212\t\tfor source, n := range counts {\n213\t\t\tif n > maxPerSource {\n214\t\t\t\tdrop[source] = n - maxPerSource\n215\t\t\t}\n216\t\t}\n217\t\tif len(drop) == 0 {\n218\t\t\treturn nil\n219\t\t}\n220\t\n221\t\t// Oldest first: the file is in append order, so dropping the first n lines\n222\t\t// of an over-cap source keeps the newest maxPerSource of it, and every other\n223\t\t// source stays exactly where it was.\n224\t\tvar kept bytes.Buffer\n225\t\tfor i, line := range all {\n226\t\t\tif !readable[i] {\n227\t\t\t\t// The rewrite is the one moment a line nothing can parse can be\n228\t\t\t\t// dropped without losing anything Read would have returned.\n229\t\t\t\tcontinue\n230\t\t\t}\n231\t\t\tif drop[sources[i]] > 0 {\n232\t\t\t\tdrop[sources[i]]--\n233\t\t\t\tcontinue\n234\t\t\t}\n235\t\t\tkept.Write(line)\n236\t\t\tkept.WriteByte('\\n')\n237\t\t}\n238\t\n239\t\treturn replace(path, kept.Bytes())\n240\t}\n241\t\n242\t// replace swaps the file's contents atomically, so a reader never sees a\n243\t// half-written store and a crash mid-trim leaves the old file intact.\n244\tfunc replace(path string, data []byte) error {\n245\t\tdir := filepath.Dir(path)\n246\t\n247\t\ttmp, err := os.CreateTemp(dir, \".history-*\")\n248\t\tif err != nil {\n249\t\t\treturn fmt.Errorf(\"cannot stage the trimmed history: %w\", err)\n250\t\t}\n251\t\t// A no-op once the rename has happened, and the cleanup for every path where\n252\t\t// it has not.\n253\t\tdefer os.Remove(tmp.Name()) //nolint:errcheck // Best effort; the file is 0600 in the state dir.\n254\t\n255\t\t// CreateTemp already opens at 0600; the Chmod makes that a stated guarantee\n256\t\t// rather than an inherited default.\n257\t\tif err := tmp.Chmod(fileMode); err != nil {\n258\t\t\ttmp.Close() //nolint:errcheck // The Chmod failure is the one worth reporting.\n259\t\t\treturn fmt.Errorf(\"cannot secure the trimmed history: %w\", err)\n260\t\t}\n261\t\tif _, err := tmp.Write(data); err != nil {\n262\t\t\ttmp.Close() //nolint:errcheck // The Write failure is the one worth reporting.\n263\t\t\treturn fmt.Errorf(\"cannot write the trimmed history: %w\", err)\n264\t\t}\n265\t\tif err := tmp.Close(); err != nil {\n266\t\t\treturn fmt.Errorf(\"cannot write the trimmed history: %w\", err)\n267\t\t}\n268\t\n269\t\tif err := os.Rename(tmp.Name(), path); err != nil {\n270\t\t\treturn fmt.Errorf(\"cannot replace the history file: %w\", err)\n271\t\t}\n272\t\n273\t\treturn nil\n274\t}\n275\t\n276\t// lineSource reads just the source off a stored line, reporting whether the\n277\t// line parses at all. Trimming works from the raw bytes rather than from decoded\n278\t// entries so a rewrite reproduces what was written, byte for byte.\n279\tfunc lineSource(line []byte) (Source, bool) {\n280\t\tvar head struct {\n281\t\t\tSource Source `json:\"source\"`\n282\t\t}\n283\t\tif err := json.Unmarshal(line, &head); err != nil {\n284\t\t\treturn \"\", false\n285\t\t}\n286\t\n287\t\treturn head.Source, true\n288\t}\n289\t\n290\t// lines splits the store into its non-empty lines.\n291\tfunc lines(data []byte) [][]byte {\n292\t\tvar out [][]byte\n293\t\tfor _, line := range bytes.Split(data, []byte(\"\\n\")) {\n294\t\t\tif len(bytes.TrimSpace(line)) == 0 {\n295\t\t\t\tcontinue\n296\t\t\t}\n297\t\t\tout = append(out, line)\n298\t\t}\n299\t\n300\t\treturn out\n301\t}\n302\t\n303\t// stateDir is $XDG_STATE_HOME/talaria, falling back to ~/.local/state/talaria.\n304\t// The lookup is spelled out because Go's os package has no UserStateDir; the\n305\t// fallback is the one the XDG spec itself names. A relative XDG_STATE_HOME is\n306\t// ignored, as the spec requires.\n307\tfunc stateDir() (string, error) {\n308\t\tif dir := os.Getenv(\"XDG_STATE_HOME\"); filepath.IsAbs(dir) {\n309\t\t\treturn filepath.Join(dir, \"talaria\"), nil\n310\t\t}\n311\t\n312\t\thome, err := os.UserHomeDir()\n313\t\tif err != nil {\n314\t\t\treturn \"\", err\n315\t\t}\n316\t\n317\t\treturn filepath.Join(home, \".local\", \"state\", \"talaria\"), nil\n318\t}\n319\t\n320\t// off reports whether a TALARIA_HISTORY value switches recording off. The\n321\t// variable has no other job, so every plausible spelling of \"no\" counts;\n322\t// anything else — including an empty value — leaves the caller's setting in\n323\t// force. Guessing wrong in