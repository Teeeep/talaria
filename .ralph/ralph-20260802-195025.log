        "type": "tool_result",
        "content": "1\tpackage request\n2\t\n3\timport (\n4\t\t\"io\"\n5\t\t\"os\"\n6\t\t\"strings\"\n7\t)\n8\t\n9\t// stdinFlag is the --body value that means \"read the body from this process's\n10\t// standard input\". It is curl's own spelling, so a user who knows curl already\n11\t// knows it.\n12\tconst stdinFlag = \"-\"\n13\t\n14\t// fileFlagPrefix marks a --body value as a filename, again following curl.\n15\tconst fileFlagPrefix = \"@\"\n16\t\n17\t// contentTypeHeader is the header a body's media type travels in.\n18\tconst contentTypeHeader = \"Content-Type\"\n19\t\n20\t// body resolves the --body flag into the bytes that will be sent and the media\n21\t// type that describes them, or nil when no body was asked for.\n22\t//\n23\t// The bytes are resolved here, in the Go process, before any curl invocation\n24\t// exists. That is the whole point of this function: DESIGN.md §5a gives the Go\n25\t// process ownership of the real stdin, because curl's stdin is already taken by\n26\t// the `-K -` config document. If `--body -` were passed through to curl, the two\n27\t// would be the same pipe and the body and the credentials would be spliced into\n28\t// one stream (docs/research §8).\n29\t//\n30\t// req is read for the headers already bound, so a user's own Content-Type can\n31\t// beat the operation's declared media type.\n32\tfunc (b *binder) body(req *Request) *Body {\n33\t\tdata, ok := b.bodyData()\n34\t\tif !ok {\n35\t\t\treturn nil\n36\t\t}\n37\t\n38\t\treturn &Body{ContentType: b.contentType(req), Data: data}\n39\t}\n40\t\n41\t// bodyData reads whichever of the three sources --body named. The second return\n42\t// is false when there is no body to send, either because none was asked for or\n43\t// because reading it failed — in which case the problem is already recorded and\n44\t// Build will return it.\n45\tfunc (b *binder) bodyData() ([]byte, bool) {\n46\t\tif len(b.in.Body) == 0 {\n47\t\t\treturn nil, false\n48\t\t}\n49\t\t// A repeated --body is a mistake worth naming rather than resolving by\n50\t\t// last-one-wins: the two values are usually a literal and a file, and\n51\t\t// silently dropping one of them sends a request the user did not write.\n52\t\t//\n53\t\t// What it is named by is the count and the kind of each value, never the\n54\t\t// values themselves. A request body is where a client_secret or a password\n55\t\t// travels, so joining them into an error message would put credentials on\n56\t\t// stderr — the §5a firewall covers error paths too.\n57\t\tif len(b.in.Body) > 1 {\n58\t\t\tkinds := make([]string, 0, len(b.in.Body))\n59\t\t\tfor _, raw := range b.in.Body {\n60\t\t\t\tkinds = append(kinds, bodyKind(raw))\n61\t\t\t}\n62\t\n63\t\t\tb.fail(\"--body was given %d times (%s); a request has one body\",\n64\t\t\t\tlen(b.in.Body), strings.Join(kinds, \", \"))\n65\t\t\treturn nil, false\n66\t\t}\n67\t\n68\t\traw := b.in.Body[0]\n69\t\tswitch {\n70\t\tcase raw == stdinFlag:\n71\t\t\treturn b.stdinBody()\n72\t\tcase strings.HasPrefix(raw, fileFlagPrefix):\n73\t\t\treturn b.fileBody(strings.TrimPrefix(raw, fileFlagPrefix))\n74\t\tdefault:\n75\t\t\treturn []byte(raw), true\n76\t\t}\n77\t}\n78\t\n79\t// bodyKind names which of the three sources a --body value is, so a message can\n80\t// tell the user which of their bodies is which without quoting any of them.\n81\t// A file's path is elided along with the bytes: it is chosen by the same\n82\t// command line and can name the secret it holds.\n83\tfunc bodyKind(raw string) string {\n84\t\tswitch {\n85\t\tcase raw == stdinFlag:\n86\t\t\treturn \"stdin\"\n87\t\tcase strings.HasPrefix(raw, fileFlagPrefix):\n88\t\t\treturn \"@file\"\n89\t\tdefault:\n90\t\t\treturn \"literal\"\n91\t\t}\n92\t}\n93\t\n94\t// stdinBody reads the process's standard input to EOF.\n95\tfunc (b *binder) stdinBody() ([]byte, bool) {\n96\t\tif b.in.Stdin == nil {\n97\t\t\tb.fail(\"--body %s reads the request body from stdin, but this process has no stdin to read\",\n98\t\t\t\tstdinFlag)\n99\t\t\treturn nil, false\n100\t\t}\n101\t\n102\t\tdata, err := io.ReadAll(b.in.Stdin)\n103\t\tif err != nil {\n104\t\t\tb.fail(\"cannot read the request body from stdin: %v\", err)\n105\t\t\treturn nil, false\n106\t\t}\n107\t\n108\t\treturn data, true\n109\t}\n110\t\n111\t// fileBody reads a body from disk verbatim. Nothing is trimmed: a body is bytes,\n112\t// and a signed payload stops verifying if its trailing newline is tidied away.\n113\tfunc (b *binder) fileBody(path string) ([]byte, bool) {\n114\t\tif path == \"\" {\n115\t\t\tb.fail(\"--body %s names no file\", fileFlagPrefix)\n116\t\t\treturn nil, false\n117\t\t}\n118\t\n119\t\tdata, err := os.ReadFile(path)\n120\t\tif err != nil {\n121\t\t\tb.fail(\"cannot read the request body from %s: %v\", path, err)\n122\t\t\treturn nil, false\n123\t\t}\n124\t\n125\t\treturn data, true\n126\t}\n127\t\n128\t// contentType is what the body will be sent as: the Content-Type the user set\n129\t// explicitly, otherwise the first media type the operation declares.\n130\t//\n131\t// The user wins because the spec describes what the server accepts, not what\n132\t// this particular call is sending — an operation declaring application/json can\n133\t// still be handed a form body deliberately. When the operation declares no body\n134\t// at all the result is empty, and talaria sends no Content-Type rather than\n135\t// guessing one.\n136\tfunc (b *binder) contentType(req *Request) string {\n137\t\tfor _, h := range req.Headers {\n138\t\t\tif strings.EqualFold(h.Name, contentTypeHeader) {\n139\t\t\t\treturn h.Value.String()\n140\t\t\t}\n141\t\t}\n142\t\n143\t\trb := b.in.Op.RequestBody\n144\t\tif rb == nil || len(rb.Content) == 0 {\n145\t\t\treturn \"\"\n146\t\t}\n147\t\n148\t\treturn rb.Content[0].ContentType\n149\t}\n150\t"
      }
