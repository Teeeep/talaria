          "command": "cat > /tmp/pgrace/reuse.go <<'EOF'\n//go:build ignore\npackage main\nEOF\nmkdir -p /tmp/pidreuse && cat > /tmp/pidreuse/main.go <<'EOF'\npackage main\n\n// How fast does Linux hand a reaped pid back out? That is the window in which\n// talaria's raw syscall.Kill(-pid, SIGKILL) hits a stranger.\nimport (\n\t\"fmt\"\n\t\"os/exec\"\n)\n\nfunc main() {\n\tseen := map[int]int{}\n\tconst n = 4000\n\treused := 0\n\tfor i := 0; i < n; i++ {\n\t\tc := exec.Command(\"/bin/true\")\n\t\t_ = c.Start()\n\t\tpid := c.Process.Pid\n\t\tif first, ok := seen[pid]; ok {\n\t\t\treused++\n\t\t\tif reused <= 3 {\n\t\t\t\tfmt.Printf(\"pid %d handed out again at spawn %d (first at %d, %d spawns later)\\n\", pid, i, first, i-first)\n\t\t\t}\n\t\t}\n\t\tseen[pid] = i\n\t\t_ = c.Wait()\n\t}\n\tfmt.Printf(\"spawns=%d distinct-pids=%d reuses=%d\\n\", n, len(seen), reused)\n}\nEOF\ncd /tmp/pidreuse && go mod init pidreuse >/dev/null 2>&1; go run /tmp/pidreuse/main.go",
