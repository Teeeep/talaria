        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"errors\"\n5\t\t\"io\"\n6\t\t\"net/http\"\n7\t\t\"net/http/httptest\"\n8\t\t\"os/exec\"\n9\t\t\"regexp\"\n10\t\t\"strings\"\n11\t\t\"testing\"\n12\t\t\"time\"\n13\t\n14\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n15\t\t\"github.com/Teeeep/talaria/internal/request\"\n16\t\t\"github.com/Teeeep/talaria/internal/secret\"\n17\t)\n18\t\n19\t// requireCurl skips a test that needs the real binary. curl is talaria's\n20\t// execution engine (§3.4), so these tests drive it rather than a stub: a fake\n21\t// would only prove the parser agrees with itself.\n22\tfunc requireCurl(t *testing.T) {\n23\t\tt.Helper()\n24\t\n25\t\tif _, err := exec.LookPath(\"curl\"); err != nil {\n26\t\t\tt.Skip(\"curl is not installed\")\n27\t\t}\n28\t}\n29\t\n30\t// getFrom returns a GET request against a test server's URL.\n31\tfunc getFrom(base string) *request.Request {\n32\t\treturn &request.Request{Method: http.MethodGet, BaseURL: base, Path: \"/pets\"}\n33\t}\n34\t\n35\t// serve starts a test server and stops it when the test ends.\n36\tfunc serve(t *testing.T, handler http.HandlerFunc) *httptest.Server {\n37\t\tt.Helper()\n38\t\n39\t\tserver := httptest.NewServer(handler)\n40\t\tt.Cleanup(server.Close)\n41\t\n42\t\treturn server\n43\t}\n44\t\n45\t// requireCLIError unwraps err to the *clierr.Error the exit-code contract is\n46\t// carried on, failing the test if it is not one.\n47\tfunc requireCLIError(t *testing.T, err error) *clierr.Error {\n48\t\tt.Helper()\n49\t\n50\t\tif err == nil {\n51\t\t\tt.Fatal(\"Execute() error = nil, want a failure\")\n52\t\t}\n53\t\n54\t\tvar cerr *clierr.Error\n55\t\tif !errors.As(err, &cerr) {\n56\t\t\tt.Fatalf(\"Execute() error = %T (%v), want *clierr.Error\", err, err)\n57\t\t}\n58\t\n59\t\treturn cerr\n60\t}\n61\t\n62\tfunc TestExecuteReturnsStatusBodyHeadersAndTiming(t *testing.T) {\n63\t\trequireCurl(t)\n64\t\n65\t\tserver := serve(t, func(w http.ResponseWriter, _ *http.Request) {\n66\t\t\t// The sleep is what makes timing observable: a loopback round trip can\n67\t\t\t// otherwise finish inside curl's reporting resolution and round to zero,\n68\t\t\t// which would make the assertion below a coin flip rather than a test.\n69\t\t\ttime.Sleep(15 * time.Millisecond)\n70\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n71\t\t\tw.Header().Set(\"X-Request-Id\", \"req-42\")\n72\t\t\tw.WriteHeader(http.StatusOK)\n73\t\t\tio.WriteString(w, `{\"id\":1,\"name\":\"rex\"}`) //nolint:errcheck // Test server.\n74\t\t})\n75\t\n76\t\tresp, err := Execute(getFrom(server.URL))\n77\t\tif err != nil {\n78\t\t\tt.Fatalf(\"Execute() error = %v\", err)\n79\t\t}\n80\t\n81\t\tif resp.Status != http.StatusOK {\n82\t\t\tt.Errorf(\"Status = %d, want 200\", resp.Status)\n83\t\t}\n84\t\tif got, want := string(resp.Body), `{\"id\":1,\"name\":\"rex\"}`; got != want {\n85\t\t\tt.Errorf(\"Body = %q, want %q\", got, want)\n86\t\t}\n87\t\tif got := resp.Headers.Get(\"X-Request-Id\"); got != \"req-42\" {\n88\t\t\tt.Errorf(\"Headers[X-Request-Id] = %q, want %q\", got, \"req-42\")\n89\t\t}\n90\t\tif got := resp.Headers.Get(\"Content-Type\"); got != \"application/json\" {\n91\t\t\tt.Errorf(\"Headers[Content-Type] = %q, want %q\", got, \"application/json\")\n92\t\t}\n93\t\tif resp.TimingMS <= 0 {\n94\t\t\tt.Errorf(\"TimingMS = %d, want > 0\", resp.TimingMS)\n95\t\t}\n96\t}\n97\t\n98\tfunc TestExecuteKeepsBodyAndMetadataOnSeparateChannels(t *testing.T) {\n99\t\trequireCurl(t)\n100\t\n101\t\t// A response body that impersonates curl's own --write-out payload, closing\n102\t\t// braces and all. If the body ever shared a stream with the metadata, the\n103\t\t// status below would come back as 599 rather than 200.\n104\t\tbody := `{\"http_code\":599,\"time_total\":42.0,\"note\":\"} not the real metadata {\"}`\n105\t\tserver := serve(t, func(w http.ResponseWriter, _ *http.Request) {\n106\t\t\tw.WriteHeader(http.StatusOK)\n107\t\t\tio.WriteString(w, body) //nolint:errcheck // Test server.\n108\t\t})\n109\t\n110\t\tresp, err := Execute(getFrom(server.URL))\n111\t\tif err != nil {\n112\t\t\tt.Fatalf(\"Execute() error = %v\", err)\n113\t\t}\n114\t\n115\t\tif resp.Status != http.StatusOK {\n116\t\t\tt.Errorf(\"Status = %d, want 200 — the body was parsed as metadata\", resp.Status)\n117\t\t}\n118\t\tif string(resp.Body) != body {\n119\t\t\tt.Errorf(\"Body = %q, want %q\", resp.Body, body)\n120\t\t}\n121\t\tif resp.TimingMS > 1000 {\n122\t\t\tt.Errorf(\"TimingMS = %d, want the real timing, not the body's 42s\", resp.TimingMS)\n123\t\t}\n124\t}\n125\t\n126\tfunc TestExecuteReportsAConnectionFailureAsRequestFailed(t *testing.T) {\n127\t\trequireCurl(t)\n128\t\n129\t\t// A server that has been stopped leaves a port nothing is listening on,\n130\t\t// without this test having to guess an unused one.\n131\t\tserver := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) {}))\n132\t\tbase := server.URL\n133\t\tserver.Close()\n134\t\n135\t\t_, err := Execute(getFrom(base))\n136\t\n137\t\tcerr := requireCLIError(t, err)\n138\t\tif cerr.Code != clierr.CodeRequestFailed {\n139\t\t\tt.Errorf(\"Code = %d, want %d\", cerr.Code, clierr.CodeRequestFailed)\n140\t\t}\n141\t\t// The exact status is curl's to choose (7 for a refused connection); that one\n142\t\t// is reported at all is what an operator needs to look it up.\n143\t\tif !regexp.MustCompile(`curl exited [1-9][0-9]*`).MatchString(cerr.Message) {\n144\t\t\tt.Errorf(\"Message = %q, want curl's non-zero exit status in it\", cerr.Message)\n145\t\t}\n146\t}\n147\t\n148\tfunc TestExecuteTreatsHTTPErrorsAsSuccessfulObservations(t *testing.T) {\n149\t\trequireCurl(t)\n150\t\n151\t\t// §4: a 404 is a successful observation, not a failed request. Only\n152\t\t// --fail-on-error changes that, and it is not this layer's decision.\n153\t\tfor _, status := range []int{http.StatusNotFound, http.StatusInternalServerError} {\n154\t\t\tt.Run(http.StatusText(status), func(t *testing.T) {\n155\t\t\t\tserver := serve(t, func(w http.ResponseWriter, _ *http.Request) {\n156\t\t\t\t\tw.WriteHeader(status)\n157\t\t\t\t\tio.WriteString(w, `{\"error\":\"nope\"}`) //nolint:errcheck // Test server.\n158\t\t\t\t})\n159\t\n160\t\t\t\tresp, err := Execute(getFrom(server.URL))\n161\t\t\t\tif err != nil {\n162\t\t\t\t\tt.Fatalf(\"Execute() error = %v, want nil for HTTP %d\", err, status)\n163\t\t\t\t}\n164\t\t\t\tif resp.Status != status {\n165\t\t\t\t\tt.Errorf(\"Status = %d, want %d\", resp.Status, status)\n166\t\t\t\t}\n167\t\t\t\tif string(resp.Body) != `{\"error\":\"nope\"}` {\n168\t\t\t\t\tt.Errorf(\"Body = %q, want the error body\", resp.Body)\n169\t\t\t\t}\n170\t\t\t})\n171\t\t}\n172\t}\n173\t\n174\tfunc TestCheckVersionEnforcesTheFloor(t *testing.T) {\n175\t\ttests := []struct {\n176\t\t\tname    string\n177\t\t\toutput  string\n178\t\t\twantErr bool\n179\t\t}{\n180\t\t\t{\n181\t\t\t\tname:    \"below the floor\",\n182\t\t\t\toutput:  \"curl 7.69.1 (x86_64-pc-linux-gnu) libcurl/7.69.1 OpenSSL/1.1.1\",\n183\t\t\t\twantErr: true,\n184\t\t\t},\n185\t\t\t{\n186\t\t\t\tname:   \"exactly the floor\",\n187\t\t\t\toutput: \"curl 7.70.0 (x86_64-pc-linux-gnu) libcurl/7.70.0 OpenSSL/1.1.1\",\n188\t\t\t},\n189\t\t\t{\n190\t\t\t\tname:   \"above the floor\",\n191\t\t\t\toutput: \"curl 8.14.1 (x86_64-pc-linux-gnu) libcurl/8.14.1 OpenSSL/3.5.0\\nRelease-Date: 2025-06-04\",\n192\t\t\t},\n193\t\t\t{\n194\t\t\t\tname:   \"a newer major with a lower minor\",\n195\t\t\t\toutput: \"curl 8.0.1 (x86_64-pc-linux-gnu) libcurl/8.0.1\",\n196\t\t\t},\n197\t\t\t{\n198\t\t\t\tname:    \"unparseable\",\n199\t\t\t\toutput:  \"not curl at all\",\n200\t\t\t\twantErr: true,\n201\t\t\t},\n202\t\t}\n203\t\n204\t\tfor _, tt := range tests {\n205\t\t\tt.Run(tt.name, func(t *testing.T) {\n206\t\t\t\terr := checkVersion(tt.output)\n207\t\t\t\tif (err != nil) != tt.wantErr {\n208\t\t\t\t\tt.Fatalf(\"checkVersion() error = %v, wantErr = %v\", err, tt.wantErr)\n209\t\t\t\t}\n210\t\t\t\tif err != nil && !strings.Contains(err.Error(), minVersion) {\n211\t\t\t\t\tt.Errorf(\"error = %q, want the %s floor named in it\", err, minVersion)\n212\t\t\t\t}\n213\t\t\t})\n214\t\t}\n215\t}\n216\t\n217\tfunc TestParseHeadersTakesTheLastBlock(t *testing.T) {\n218\t\t// A redirect leaves the intermediate response's headers in front of the real\n219\t\t// one. Taking the last block is what keeps a stale Location or a 100 Continue\n220\t\t// out of the reported response.\n221\t\tdump := \"HTTP/1.1 301 Moved Permanently\\r\\n\" +\n222\t\t\t\"Location: /pets/42\\r\\n\" +\n223\t\t\t\"X-Stale: yes\\r\\n\" +\n224\t\t\t\"\\r\\n\" +\n225\t\t\t\"HTTP/1.1 200 OK\\r\\n\" +\n226\t\t\t\"Content-Type: application/json\\r\\n\" +\n227\t\t\t\"X-Fresh: yes\\r\\n\" +\n228\t\t\t\"\\r\\n\"\n229\t\n230\t\theaders := parseHeaders([]byte(dump))\n231\t\n232\t\tif got := headers.Get(\"X-Fresh\"); got != \"yes\" {\n233\t\t\tt.Errorf(\"X-Fresh = %q, want %q\", got, \"yes\")\n234\t\t}\n235\t\tif got := headers.Get(\"X-Stale\"); got != \"\" {\n236\t\t\tt.Errorf(\"X-Stale = %q, want it dropped with the redirect block\", got)\n237\t\t}\n238\t\tif got := headers.Get(\"Location\"); got != \"\" {\n239\t\t\tt.Errorf(\"Location = %q, want it dropped with the redirect block\", got)\n240\t\t}\n241\t}\n242\t\n243\tfunc TestRequestFailedRedactsCredentialsInCurlStderr(t *testing.T) {\n244\t\tconst canary = \"canary-9f3a-not-in-any-output\"\n245\t\tt.Setenv(\"TALARIA_AUTH_APIKEY\", canary)\n246\t\n247\t\treq := &request.Request{\n248\t\t\tMethod:  http.MethodGet,\n249\t\t\tBaseURL: \"https://api.example.com\",\n250\t\t\tPath:    \"/pets\",\n251\t\t\tQuery: []request.Pair{{\n252\t\t\t\tName:  \"api_key\",\n253\t\t\t\tValue: request.Secret(secret.Env(\"TALARIA_AUTH_APIKEY\"), request.EncodeRaw),\n254\t\t\t}},\n255\t\t}\n256\t\t// curl echoes the URL it was given into several of its errors, and the URL is\n257\t\t// where an API-key credential lives. §5a: errors are built from the redacted\n258\t\t// representation.\n259\t\tstderr := \"curl: (60) SSL certificate problem for https://api.example.com/pets?api_key=\" + canary\n260\t\n261\t\terr := requestFailed(req, 60, stderr)\n262\t\n263\t\tif strings.Contains(err.Error(), canary) {\n264\t\t\tt.Fatalf(\"error leaked the credential: %q\", err)\n265\t\t}\n266\t\tif !strings.Contains(err.Error(), \"<redacted:env:TALARIA_AUTH_APIKEY>\") {\n267\t\t\tt.Errorf(\"error = %q, want the credential shown as its redacted ref\", err)\n268\t\t}\n269\t\tif !strings.Contains(err.Error(), \"curl exited 60\") {\n270\t\t\tt.Errorf(\"error = %q, want curl's exit status in it\", err)\n271\t\t}\n272\t}\n273\t"
