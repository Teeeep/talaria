        "content": "1\tpackage secret\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"strings\"\n6\t\t\"testing\"\n7\t)\n8\t\n9\t// responseCanary stands in for a credential the *server* handed back — a\n10\t// session cookie, or the token a login endpoint issues. §5a says these are a\n11\t// known uncovered threat, mitigated by Set-Cookie redaction and configured body\n12\t// paths; every assertion here greps for it rather than only comparing against\n13\t// the expected redacted form.\n14\tconst responseCanary = \"server-issued-CANARY-4e91b7\"\n15\t\n16\tfunc TestResponseHeadersRedactsSetCookieByDefault(t *testing.T) {\n17\t\tred := NewResponseRedactor(nil, nil)\n18\t\n19\t\tgot := red.Headers(map[string][]string{\n20\t\t\t\"Set-Cookie\":   {\"session=\" + responseCanary, \"csrf=\" + responseCanary},\n21\t\t\t\"Content-Type\": {\"application/json\"},\n22\t\t})\n23\t\n24\t\tfor i, value := range got[\"Set-Cookie\"] {\n25\t\t\tif value != Placeholder {\n26\t\t\t\tt.Errorf(\"Set-Cookie[%d] = %q, want %q\", i, value, Placeholder)\n27\t\t\t}\n28\t\t}\n29\t\tif n := len(got[\"Set-Cookie\"]); n != 2 {\n30\t\t\tt.Errorf(\"Set-Cookie has %d values, want both repetitions kept\", n)\n31\t\t}\n32\t\tif got := got[\"Content-Type\"]; len(got) != 1 || got[0] != \"application/json\" {\n33\t\t\tt.Errorf(\"Content-Type = %v, want it untouched\", got)\n34\t\t}\n35\t\n36\t\tassertNoResponseCanary(t, got)\n37\t}\n38\t\n39\tfunc TestResponseHeadersLeavesTheOriginalAlone(t *testing.T) {\n40\t\t// The Response the rest of talaria validates against must stay as it came\n41\t\t// off the wire; only the copy bound for an output surface is redacted.\n42\t\theaders := map[string][]string{\"Set-Cookie\": {\"session=\" + responseCanary}}\n43\t\n44\t\tNewResponseRedactor(nil, nil).Headers(headers)\n45\t\n46\t\tif got := headers[\"Set-Cookie\"][0]; got != \"session=\"+responseCanary {\n47\t\t\tt.Errorf(\"the input map was modified: Set-Cookie = %q\", got)\n48\t\t}\n49\t}\n50\t\n51\tfunc TestResponseHeadersOfNilMapIsNil(t *testing.T) {\n52\t\tif got := NewResponseRedactor(nil, nil).Headers(nil); got != nil {\n53\t\t\tt.Errorf(\"Headers(nil) = %v, want nil\", got)\n54\t\t}\n55\t}\n56\t\n57\tfunc TestResponseHeadersExtraPatternsExtendTheBuiltInList(t *testing.T) {\n58\t\tred := NewResponseRedactor([]string{\"x-session-*\"}, nil)\n59\t\n60\t\tgot := red.Headers(map[string][]string{\n61\t\t\t\"X-Session-Id\": {responseCanary},\n62\t\t\t\"Set-Cookie\":   {\"session=\" + responseCanary},\n63\t\t})\n64\t\n65\t\tif got := got[\"X-Session-Id\"]; len(got) != 1 || got[0] != Placeholder {\n66\t\t\tt.Errorf(\"X-Session-Id = %v, want it redacted by the extra pattern\", got)\n67\t\t}\n68\t\tif got := got[\"Set-Cookie\"]; len(got) != 1 || got[0] != Placeholder {\n69\t\t\tt.Errorf(\"Set-Cookie = %v, want the built-in list still in effect\", got)\n70\t\t}\n71\t}\n72\t\n73\tfunc TestBodyRedactsConfiguredPathsAndLeavesTheRestIntact(t *testing.T) {\n74\t\tred := NewResponseRedactor(nil, []string{\"data.token\"})\n75\t\n76\t\tbody := red.Body([]byte(`{\"access_token\":\"` + responseCanary +\n77\t\t\t`\",\"data\":{\"token\":\"` + responseCanary + `\",\"name\":\"Rex\"},\"count\":42}`))\n78\t\n79\t\tassertNoResponseCanary(t, string(body))\n80\t\n81\t\tvar got map[string]any\n82\t\tif err := json.Unmarshal(body, &got); err != nil {\n83\t\t\tt.Fatalf(\"the redacted body is not valid JSON (%s): %v\", body, err)\n84\t\t}\n85\t\tif got[\"access_token\"] != Placeholder {\n86\t\t\tt.Errorf(\"access_token = %v, want %q from the built-in list\", got[\"access_token\"], Placeholder)\n87\t\t}\n88\t\n89\t\tdata, ok := got[\"data\"].(map[string]any)\n90\t\tif !ok {\n91\t\t\tt.Fatalf(\"data = %v, want the surrounding object preserved\", got[\"data\"])\n92\t\t}\n93\t\tif data[\"token\"] != Placeholder {\n94\t\t\tt.Errorf(\"data.token = %v, want %q\", data[\"token\"], Placeholder)\n95\t\t}\n96\t\tif data[\"name\"] != \"Rex\" {\n97\t\t\tt.Errorf(\"data.name = %v, want it untouched\", data[\"name\"])\n98\t\t}\n99\t\tif got[\"count\"] != float64(42) {\n100\t\t\tt.Errorf(\"count = %v, want 42\", got[\"count\"])\n101\t\t}\n102\t}\n103\t\n104\tfunc TestBodyPreservesNumbersItDoesNotRedact(t *testing.T) {\n105\t\t// Decoding to any and re-encoding turns an int64 into 1.234567890123457e+18\n106\t\t// unless numbers are kept as text. A body talaria rewrote must still report\n107\t\t// what the server actually sent.\n108\t\tred := NewResponseRedactor(nil, nil)\n109\t\n110\t\tbody := red.Body([]byte(`{\"access_token\":\"` + responseCanary + `\",\"id\":1234567890123456789}`))\n111\t\n112\t\tif !strings.Contains(string(body), \"1234567890123456789\") {\n113\t\t\tt.Errorf(\"redaction reformatted a number it was not asked to touch:\\n%s\", body)\n114\t\t}\n115\t}\n116\t\n117\tfunc TestBodyOfAMissingPathIsANoOp(t *testing.T) {\n118\t\tred := NewResponseRedactor(nil, []string{\"data.token\", \"nothing.here.at.all\"})\n119\t\n120\t\toriginal := `{\"name\":\"Rex\",\"data\":{\"name\":\"Rex\"}}`\n121\t\n122\t\tif got := string(red.Body([]byte(original))); got != original {\n123\t\t\tt.Errorf(\"Body = %q, want the bytes returned verbatim when nothing matched\", got)\n124\t\t}\n125\t}\n126\t\n127\tfunc TestBodySkipsNonJSONBodies(t *testing.T) {\n128\t\tred := NewResponseRedactor(nil, []string{\"access_token\"})\n129\t\n130\t\tfor _, body := range []string{\n131\t\t\t\"not json at all\",\n132\t\t\t\"\",\n133\t\t\t`[{\"access_token\":\"x\"}]`,\n134\t\t\t`{\"access_token\":\"x\"} trailing junk`,\n135\t\t} {\n136\t\t\tif got := string(red.Body([]byte(body))); got != body {\n137\t\t\t\tt.Errorf(\"Body(%q) = %q, want it returned unchanged\", body, got)\n138\t\t\t}\n139\t\t}\n140\t}\n141\t\n142\tfunc TestBodyDoesNotDescendIntoNonObjects(t *testing.T) {\n143\t\t// data is a string, so data.token names nothing. Walking into it must not\n144\t\t// panic and must not rewrite the value that is there.\n145\t\tred := NewResponseRedactor(nil, []string{\"data.token\"})\n146\t\n147\t\toriginal := `{\"data\":\"a string\"}`\n148\t\n149\t\tif got := string(red.Body([]byte(original))); got != original {\n150\t\t\tt.Errorf(\"Body = %q, want %q\", got, original)\n151\t\t}\n152\t}\n153\t\n154\tfunc TestNilResponseRedactorStillRedacts(t *testing.T) {\n155\t\t// A nil *ResponseRedactor is what an unset struct field is, and redaction is\n156\t\t// never accidentally opt-in.\n157\t\tvar red *ResponseRedactor\n158\t\n159\t\tgot := red.Headers(map[string][]string{\"Set-Cookie\": {\"session=\" + responseCanary}})\n160\t\tif got := got[\"Set-Cookie\"]; len(got) != 1 || got[0] != Placeholder {\n161\t\t\tt.Errorf(\"Set-Cookie = %v, want it redacted by a nil redactor\", got)\n162\t\t}\n163\t\n164\t\tbody := red.Body([]byte(`{\"access_token\":\"` + responseCanary + `\"}`))\n165\t\tassertNoResponseCanary(t, string(body))\n166\t}\n167\t\n168\tfunc TestQueryKeyWarningNamesTheParameterAndNoValue(t *testing.T) {\n169\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_PETKEY\", responseCanary)\n170\t\n171\t\tvar out strings.Builder\n172\t\tNewQueryKeyWarner().Warn(&out, \"api_key\", Env(\"TALARIA_AUTH_APIKEY_PETKEY\"))\n173\t\n174\t\tgot := out.String()\n175\t\tfor _, want := range []string{\"api_key\", \"TALARIA_AUTH_APIKEY_PETKEY\", \"log\"} {\n176\t\t\tif !strings.Contains(got, want) {\n177\t\t\t\tt.Errorf(\"the warning does not mention %q:\\n%s\", want, got)\n178\t\t\t}\n179\t\t}\n180\t\tassertNoResponseCanary(t, got)\n181\t}\n182\t\n183\tfunc TestQueryKeyWarningFiresOncePerWarner(t *testing.T) {\n184\t\twarner := NewQueryKeyWarner()\n185\t\n186\t\tvar out strings.Builder\n187\t\tfor range 3 {\n188\t\t\twarner.Warn(&out, \"api_key\", Env(\"TALARIA_AUTH_APIKEY_PETKEY\"))\n189\t\t}\n190\t\n191\t\tif n := strings.Count(out.String(), \"api_key\"); n != 1 {\n192\t\t\tt.Errorf(\"the warning fired %d times, want once per process:\\n%s\", n, out.String())\n193\t\t}\n194\t}\n195\t\n196\t// assertNoResponseCanary fails if value, rendered as text, contains the\n197\t// server-issued canary anywhere.\n198\tfunc assertNoResponseCanary(t *testing.T, value any) {\n199\t\tt.Helper()\n200\t\n201\t\trendered, err := json.Marshal(value)\n202\t\tif err != nil {\n203\t\t\tt.Fatalf(\"rendering %v: %v\", value, err)\n204\t\t}\n205\t\tif strings.Contains(string(rendered), responseCanary) {\n206\t\t\tt.Errorf(\"a response credential survived redaction:\\n%s\", rendered)\n207\t\t}\n208\t}\n209\t"
