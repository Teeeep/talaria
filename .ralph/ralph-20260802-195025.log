        "tool_use_id": "toolu_01CCVBbu44LwmQxXwkL3soUG",
        "type": "tool_result",
        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"net/http\"\n5\t\t\"os\"\n6\t\t\"strings\"\n7\t\t\"unicode/utf8\"\n8\t\n9\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n10\t\t\"github.com/Teeeep/talaria/internal/request\"\n11\t)\n12\t\n13\t// maxInlineBody is the size above which a body stops being a directive and\n14\t// becomes a 0600 temp file. DESIGN.md §5a calls the temp file \"the exception\":\n15\t// it is a real file on disk for the length of one exec, so the threshold is set\n16\t// where the config document stops being a reasonable place to put bytes rather\n17\t// than at any hard limit of curl's.\n18\tconst maxInlineBody = 1 << 20\n19\t\n20\t// Capture names the files curl writes the response to. Both are optional; the\n21\t// executor allocates them and passes them here rather than appending them to\n22\t// argv, because §5a's rule is that *nothing* about the call is an argument, not\n23\t// merely nothing sensitive.\n24\ttype Capture struct {\n25\t\t// BodyPath receives the response body, via the output directive.\n26\t\tBodyPath string\n27\t\t// HeaderPath receives the response headers, via the dump-header directive.\n28\t\tHeaderPath string\n29\t}\n30\t\n31\t// BuildConfig renders req as a curl config document for `curl -K -`.\n32\t//\n33\t// This is the one place in talaria where a resolved credential exists. The\n34\t// document is written to curl's stdin and holds the real values; the returned\n35\t// argv is exactly `curl -K -` and holds nothing, because /proc/*/cmdline is\n36\t// readable by any process on the host — including ones an agent spawns (§5a).\n37\t//\n38\t// cleanup must be called once curl has exited. It removes any temp body file\n39\t// and zeroes the document, so the resolved values do not linger in a buffer the\n40\t// rest of the process can still reach. It is safe to call more than once, and\n41\t// is non-nil even when BuildConfig fails.\n42\t//\n43\t// A credential whose environment variable is unset fails with exit code 5 and\n44\t// no document, rather than sending an empty header — an unauthenticated request\n45\t// that looks authenticated is the worse outcome (§4).\n46\tfunc BuildConfig(req *request.Request, capture Capture) (config []byte, argv []string, cleanup func(), err error) {\n47\t\targv = []string{\"curl\", \"-K\", \"-\"}\n48\t\tif req == nil {\n49\t\t\treturn nil, argv, func() {}, clierr.RequestFailed(\"no request to execute\")\n50\t\t}\n51\t\n52\t\tvar doc document\n53\t\tif err := doc.build(req, capture); err != nil {\n54\t\t\tdoc.discard()\n55\t\t\treturn nil, argv, doc.cleanup, err\n56\t\t}\n57\t\n58\t\tconfig = []byte(doc.b.String())\n59\t\tdoc.b.Reset()\n60\t\n61\t\treturn config, argv, doc.cleanupWith(config), nil\n62\t}\n63\t\n64\t// document accumulates the directives and the temp files they point at, so a\n65\t// failure part-way through still knows what to remove.\n66\ttype document struct {\n67\t\tb     strings.Builder\n68\t\tfiles []string\n69\t}\n70\t\n71\tfunc (d *document) build(req *request.Request, capture Capture) error {\n72\t\turl, err := req.URL(resolve)\n73\t\tif err != nil {\n74\t\t\treturn err\n75\t\t}\n76\t\td.directive(\"url\", url)\n77\t\n78\t\t// head rather than `request = \"HEAD\"`: -X HEAD leaves curl waiting for a body\n79\t\t// of Content-Length bytes that a compliant server never sends, so the call\n80\t\t// hangs (or exits 18 when the connection closes first). HEAD is a safe method\n81\t\t// that `run` includes without --allow-mutations, so one such operation would\n82\t\t// stall an entire report.\n83\t\thead := strings.EqualFold(req.Method, http.MethodHead)\n84\t\tswitch {\n85\t\tcase head:\n86\t\t\td.flag(\"head\")\n87\t\tcase req.Method != \"\":\n88\t\t\td.directive(\"request\", req.Method)\n89\t\t}\n90\t\n91\t\tif err := d.auth(req); err != nil {\n92\t\t\treturn err\n93\t\t}\n94\t\tif err := d.cookies(req); err != nil {\n95\t\t\treturn err\n96\t\t}\n97\t\tif err := d.body(req); err != nil {\n98\t\t\treturn err\n99\t\t}\n100\t\n101\t\t// Defence in depth behind request.IsHTTPScheme: curl speaks file, gopher,\n102\t\t// dict and smb, and a redirect chooses the scheme of the next hop without\n103\t\t// asking talaria. The leading `=` makes each list absolute rather than\n104\t\t// additive, so these two are the only protocols this process can use.\n105\t\td.directive(\"proto\", \"=http,https\")\n106\t\td.directive(\"proto-redir\", \"=http,https\")\n107\t\n108\t\t// silent suppresses the progress meter, which would otherwise be interleaved\n109\t\t// with the write-out payload on stdout; show-error keeps real failures\n110\t\t// visible despite it.\n111\t\td.flag(\"silent\")\n112\t\td.flag(\"show-error\")\n113\t\t// %{json} is the whole response metadata in one parseable object, and is the\n114\t\t// reason DESIGN.md sets a curl >= 7.70 floor.\n115\t\td.directive(\"write-out\", \"%{json}\")\n116\t\n117\t\tif capture.BodyPath != \"\" {\n118\t\t\t// head makes curl write the header block to the output file, which at\n119\t\t\t// capture.BodyPath would be reported as the response body. dump-header\n120\t\t\t// still captures the headers, and the staged empty body file keeps\n121\t\t\t// readResponse reading a real path.\n122\t\t\tpath := capture.BodyPath\n123\t\t\tif head {\n124\t\t\t\tpath = os.DevNull\n125\t\t\t}\n126\t\t\td.directive(\"output\", path)\n127\t\t}\n128\t\tif capture.HeaderPath != \"\" {\n129\t\t\td.directive(\"dump-header\", capture.HeaderPath)\n130\t\t}\n131\t\n132\t\treturn nil\n133\t}\n134\t\n135\t// auth writes the request headers, diverting basic auth to curl's own user\n136\t// directive: the header text is base64(user:password), and letting curl encode\n137\t// it means this package never has to.\n138\tfunc (d *document) auth(req *request.Request) error {\n139\t\tfor _, h := range req.Headers {\n140\t\t\tvalue, err := resolve(h.Value)\n141\t\t\tif err != nil {\n142\t\t\t\treturn err\n143\t\t\t}\n144\t\n145\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n146\t\t\t\td.directive(\"user\", strings.TrimPrefix(value, h.Value.Prefix()))\n147\t\t\t\tcontinue\n148\t\t\t}\n149\t\n150\t\t\td.directive(\"header\", h.Name+\": \"+value)\n151\t\t}\n152\t\n153\t\treturn nil\n154\t}\n155\t\n156\t// cookies writes every cookie as one directive. curl keeps only the last of\n157\t// several, so they are joined rather than repeated.\n158\tfunc (d *document) cookies(req *request.Request) error {\n159\t\tif len(req.Cookies) == 0 {\n160\t\t\treturn nil\n161\t\t}\n162\t\n163\t\tvar b strings.Builder\n164\t\tfor i, c := range req.Cookies {\n165\t\t\tvalue, err := resolve(c.Value)\n166\t\t\tif err != nil {\n167\t\t\t\treturn err\n168\t\t\t}\n169\t\n170\t\t\tif i > 0 {\n171\t\t\t\tb.WriteString(\"; \")\n172\t\t\t}\n173\t\t\tb.WriteString(c.Name + \"=\" + value)\n174\t\t}\n175\t\n176\t\td.directive(\"cookie\", b.String())\n177\t\n178\t\treturn nil\n179\t}\n180\t\n181\t// body writes the request body, inline when it can be and via a temp file when\n182\t// it cannot.\n183\tfunc (d *document) body(req *request.Request) error {\n184\t\tif req.Body == nil {\n185\t\t\treturn nil\n186\t\t}\n187\t\n188\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n189\t\t\td.directive(\"header\", \"Content-Type: \"+req.Body.ContentType)\n190\t\t}\n191\t\n192\t\tif inlinable(req.Body.Data) {\n193\t\t\t// data-raw rather than data or data-binary: those two read a value\n194\t\t\t// starting with @ as a filename, and a JSON body legitimately can. Verified\n195\t\t\t// against curl 8.14.1 — data-raw sends the bytes as given and strips\n196\t\t\t// nothing, where `data = \"@path\"` also strips newlines.\n197\t\t\td.directive(\"data-raw\", string(req.Body.Data))\n198\t\t\treturn nil\n199\t\t}\n200\t\n201\t\tpath, err := d.tempFile(req.Body.Data)\n202\t\tif err != nil {\n203\t\t\treturn err\n204\t\t}\n205\t\t// The file's bytes are read verbatim, so data-binary rather than data: data\n206\t\t// strips newlines and carriage returns out of a file, which corrupts any\n207\t\t// pretty-printed JSON and breaks any signed payload.\n208\t\td.directive(\"data-binary\", \"@\"+path)\n209\t\n210\t\treturn nil\n211\t}\n212\t\n213\t// inlinable reports whether a body can live in the config document. Valid UTF-8\n214\t// under the size limit can; anything else takes the temp-file path, because a\n215\t// NUL byte truncates a quoted value and arbitrary bytes have no escape sequence\n216\t// that survives curl's parser.\n217\tfunc inlinable(data []byte) bool {\n218\t\tif len(data) > maxInlineBody || !utf8.Valid(data) {\n219\t\t\treturn false\n220\t\t}\n221\t\n222\t\treturn !strings.ContainsRune(string(data), 0)\n223\t}\n224\t\n225\t// tempFile writes data to a 0600 file and records it for cleanup.\n226\tfunc (d *document) tempFile(data []byte) (string, error) {\n227\t\tf, err := os.CreateTemp(\"\", \"talaria-body-*\")\n228\t\tif err != nil {\n229\t\t\treturn \"\", clierr.RequestFailed(\"cannot stage the request body: %w\", err)\n230\t\t}\n231\t\td.files = append(d.files, f.Name())\n232\t\n233\t\t// CreateTemp already makes the file 0600; setting it explicitly keeps that a\n234\t\t// guarantee of this code rather than of the standard library's current\n235\t\t// behaviour, since the body may carry credentials the user put in it.\n236\t\tif err := f.Chmod(0o600); err != nil {\n237\t\t\tf.Close()\n238\t\t\treturn \"\", clierr.RequestFailed(\"cannot secure the request body file: %w\", err)\n239\t\t}\n240\t\n241\t\tif _, err := f.Write(data); err != nil {\n242\t\t\tf.Close()\n243\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n244\t\t}\n245\t\n246\t\tif err := f.Close(); err != nil {\n247\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n248\t\t}\n249\t\n250\t\treturn f.Name(), nil\n251\t}\n252\t\n253\t// directive writes one `name = \"value\"` line, escaped for curl's parser.\n254\tfunc (d *document) directive(name, value string) {\n255\t\td.b.WriteString(name + ` = \"` + escapeDirective(value) + \"\\\"\\n\")\n256\t}\n257\t\n258\t// flag writes one bare directive, the config form of a boolean option.\n259\tfunc (d *document) flag(name string) { d.b.WriteString(name + \"\\n\") }\n260\t\n261\t// discard drops a partially built document, so a failure returns nothing a\n262\t// caller could accidentally send or print.\n263\tfunc (d *document) discard() { d.b.Reset() }\n264\t\n265\t// cleanup removes the temp files this document points at.\n266\tfunc (d *document) cleanup() {\n267\t\tfor _, path := range d.files {\n268\t\t\tos.Remove(path) //nolint:errcheck // Best effort; the file is 0600 and in TMPDIR.\n269\t\t}\n270\t\td.files = nil\n271\t}\n272\t\n273\t// cleanupWith also zeroes the finished document, so the resolved credentials in\n274\t// it stop being readable from the buffer once curl has exited.\n275\tfunc (d *document) cleanupWith(config []byte) func() {\n276\t\treturn func() {\n277\t\t\td.cleanup()\n278\t\t\tfor i := range config {\n279\t\t\t\tconfig[i] = 0\n280\t\t\t}\n281\t\t}\n282\t}\n283\t\n284\t// resolve is the renderer that reads real credential values. It is the single\n285\t// crossing of the firewall described in DESIGN.md §5a: every other renderer in\n286\t// talaria produces a redacted or symbolic form, and this one exists only to\n287\t// feed the config document.\n288\tfunc resolve(v request.Value) (string, error) {\n289\t\tif !v.IsSecret() {\n290\t\t\t// Reveal rather than String: a literal the user typed under a\n291\t\t\t// credential-shaped name displays redacted everywhere else, and the\n292\t\t\t// wire is the one place it must not.\n293\t\t\treturn v.Reveal(), nil\n294\t\t}\n295\t\n296\t\tvalue, err := v.Ref().Resolve()\n297\t\tif err != nil {\n298\t\t\treturn \"\", err\n299\t\t}\n300\t\n301\t\treturn v.Prefix() + value, nil\n302\t}\n303\t\n304\t// configEscape covers the escape sequences curl's config parser understands, in\n305\t// the order a single pass must apply them. strings.Replacer scans once and\n306\t// picks the longest match at each position, which is what keeps the backslash\n307\t// rule from re-escaping the backslashes the other rules just introduced — the\n308\t// double-escaping bug that ordered sequential replaces invite.\n309\tvar configEscape = strings.NewReplacer(\n310\t\t`\\`, `\\\\`,\n311\t\t`\"`, `\\\"`,\n312\t\t\"\\t\", `\\t`,\n313\t\t\"\\n\", `\\n`,\n314\t\t\"\\r\", `\\r`,\n315\t)\n316\t\n317\tfunc escapeDirective(s string) string { return configEscape.Replace(s) }\n318\t"
