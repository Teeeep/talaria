      {
        "tool_use_id": "toolu_01G8yVa5dtnYttBjdtCJj3e2",
        "type": "tool_result",
        "content": "1\t// Package corpus is talaria's record of what it actually sent and what came\n2\t// back. It backs `talaria history` now and the twin's recordings later: DESIGN.md\n3\t// §5 puts it in Phase 2 even though the recording proxy is Phase 5, because\n4\t// \"history and the twin's corpus are the same data\".\n5\t//\n6\t// Everything here is written redacted. §5a calls the recording \"a permanent\n7\t// artifact — the highest-risk surface in the tool\" and answers it with\n8\t// \"redaction at write time, not read time. Un-redacted recording is not an\n9\t// option.\" An Entry is therefore built by NewEntry out of the redacted\n10\t// representation of a request and a response, and there is no path through this\n11\t// package that puts a resolved credential on disk.\n12\t//\n13\t// The package deliberately does not import internal/config: the profile's\n14\t// history setting arrives as the Enabled bool a caller passes to New, so the\n15\t// store stays usable by the twin, which has no profiles.\n16\tpackage corpus\n17\t\n18\timport (\n19\t\t\"encoding/base64\"\n20\t\t\"time\"\n21\t\t\"unicode/utf8\"\n22\t\n23\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n24\t\t\"github.com/Teeeep/talaria/internal/curl\"\n25\t\t\"github.com/Teeeep/talaria/internal/request\"\n26\t\t\"github.com/Teeeep/talaria/internal/secret\"\n27\t)\n28\t\n29\t// MaxBody is how much of a request or response body one entry keeps. A body\n30\t// past it is cut and marked truncated: history is for answering \"what have I\n31\t// already tried\", and a 40 MB download answers that no better than its first\n32\t// 64 KiB while being the difference between a store you can read and one you\n33\t// cannot.\n34\tconst MaxBody = 64 << 10\n35\t\n36\t// Source says which command produced an entry. It exists because the retention\n37\t// cap is applied per source: a `run` over a large spec must not be able to evict\n38\t// a session of interactive `call` history.\n39\ttype Source string\n40\t\n41\tconst (\n42\t\t// SourceCall is one interactive `talaria call`.\n43\t\tSourceCall Source = \"call\"\n44\t\t// SourceRun is one request made by `talaria run`.\n45\t\tSourceRun Source = \"run\"\n46\t\t// SourceReplay is a `talaria history replay` of an earlier entry.\n47\t\tSourceReplay Source = \"replay\"\n48\t)\n49\t\n50\t// Entry is one recorded request/response pair, already redacted.\n51\t//\n52\t// A Response of nil is a request that produced no observation — a dry run, or a\n53\t// call whose connection failed — which is still worth recording as something\n54\t// that was tried.\n55\ttype Entry struct {\n56\t\tTimestamp   time.Time `json:\"timestamp\"`\n57\t\tSource      Source    `json:\"source\"`\n58\t\tOperationID string    `json:\"operation_id,omitempty\"`\n59\t\tMethod      string    `json:\"method\"`\n60\t\t// URL is the full request URL with credentials in the query string rendered\n61\t\t// as <redacted:env:NAME>.\n62\t\tURL      string         `json:\"url\"`\n63\t\tRequest  EntryRequest   `json:\"request\"`\n64\t\tResponse *EntryResponse `json:\"response,omitempty\"`\n65\t}\n66\t\n67\t// EntryRequest is the redacted request. Headers and cookies are maps rather\n68\t// than ordered pairs because history is read by name; a name that repeats is\n69\t// joined the way HTTP joins repeated field values.\n70\ttype EntryRequest struct {\n71\t\tHeaders map[string]string `json:\"headers,omitempty\"`\n72\t\tCookies map[string]string `json:\"cookies,omitempty\"`\n73\t\tBody    *Body             `json:\"body,omitempty\"`\n74\t}\n75\t\n76\t// EntryResponse is the redacted response. Headers keep their repetitions, since\n77\t// Set-Cookie legitimately appears more than once.\n78\ttype EntryResponse struct {\n79\t\tStatus   int                 `json:\"status\"`\n80\t\tHeaders  map[string][]string `json:\"headers,omitempty\"`\n81\t\tBody     *Body               `json:\"body,omitempty\"`\n82\t\tTimingMS int64               `json:\"timing_ms\"`\n83\t}\n84\t\n85\t// EncodingBase64 marks a Data that holds standard base64 rather than the body's\n86\t// own bytes. It is the only encoding this build writes or reads.\n87\tconst EncodingBase64 = \"base64\"\n88\t\n89\t// Body is a recorded body and how much of it was kept.\n90\ttype Body struct {\n91\t\tContentType string `json:\"content_type,omitempty\"`\n92\t\tData        string `json:\"data\"`\n93\t\t// Encoding says how to read Data. Empty means Data is the body's bytes as\n94\t\t// text, which is the case for everything that is valid UTF-8; a body that is\n95\t\t// not gets EncodingBase64, because a JSON string cannot carry an invalid\n96\t\t// byte — encoding/json rewrites each one to U+FFFD, and a reader replaying\n97\t\t// that would send bytes the original call never sent.\n98\t\tEncoding string `json:\"encoding,omitempty\"`\n99\t\t// Truncated reports that Data is the first MaxBody bytes and not the whole\n100\t\t// body. It is explicit so a reader never mistakes a cut body for what the\n101\t\t// server sent.\n102\t\tTruncated bool `json:\"truncated,omitempty\"`\n103\t}\n104\t\n105\t// Bytes returns the recorded body as the bytes it was on the wire.\n106\t//\n107\t// An encoding this build does not know is refused rather than guessed at: the\n108\t// store is a file anything can write, and a newer talaria may have added one.\n109\t// Reading such a Data as literal text is the exact silent corruption the\n110\t// Encoding field exists to prevent.\n111\tfunc (b Body) Bytes() ([]byte, error) {\n112\t\tswitch b.Encoding {\n113\t\tcase \"\":\n114\t\t\treturn []byte(b.Data), nil\n115\t\tcase EncodingBase64:\n116\t\t\tdata, err := base64.StdEncoding.DecodeString(b.Data)\n117\t\t\tif err != nil {\n118\t\t\t\treturn nil, clierr.Usage(\"the recorded body claims %s encoding but does not decode: %v\", EncodingBase64, err)\n119\t\t\t}\n120\t\n121\t\t\treturn data, nil\n122\t\tdefault:\n123\t\t\treturn nil, clierr.Usage(\"the recorded body has encoding %q, which this version of talaria cannot read\", b.Encoding)\n124\t\t}\n125\t}\n126\t\n127\t// Redactors are the two firewalls an entry passes through on its way to disk.\n128\t// Both are nil-safe: the zero Redactors applies the built-in lists, so a caller\n129\t// that forgets to configure them records less rather than more.\n130\ttype Redactors struct {\n131\t\t// Request matches request header names against the built-in credential list\n132\t\t// plus whatever the profile added.\n133\t\tRequest *secret.Redactor\n134\t\t// Response redacts response headers by name and both bodies by JSON path.\n135\t\tResponse *secret.ResponseRedactor\n136\t}\n137\t\n138\t// NewEntry builds the record of one request and the response it produced.\n139\t//\n140\t// Redaction happens here rather than at read time, and it happens before\n141\t// truncation: cutting a JSON body first would leave a prefix the path redactor\n142\t// can no longer parse, and a secret in that prefix would survive.\n143\tfunc NewEntry(source Source, req *request.Request, resp *curl.Response, red Redactors) Entry {\n144\t\tentry := Entry{\n145\t\t\tTimestamp: time.Now().UTC(),\n146\t\t\tSource:    source,\n147\t\t}\n148\t\n149\t\tif req != nil {\n150\t\t\tentry.OperationID = req.OperationID\n151\t\t\tentry.Method = req.Method\n152\t\t\t// request.Redacted cannot fail, and a URL that somehow did not render is\n153\t\t\t// not worth dropping the whole recording over.\n154\t\t\tentry.URL, _ = req.URL(request.Redacted)\n155\t\t\tentry.Request = EntryRequest{\n156\t\t\t\tHeaders: red.headers(req.Headers),\n157\t\t\t\tCookies: red.cookies(req.Cookies),\n158\t\t\t\tBody:    red.requestBody(req.Body),\n159\t\t\t}\n160\t\t}\n161\t\n162\t\tif resp != nil {\n163\t\t\tentry.Response = &EntryResponse{\n164\t\t\t\tStatus:   resp.Status,\n165\t\t\t\tHeaders:  red.Response.Headers(resp.Headers),\n166\t\t\t\tBody:     newBody(contentType(resp.Headers), red.Response.Body(resp.Body)),\n167\t\t\t\tTimingMS: resp.TimingMS,\n168\t\t\t}\n169\t\t}\n170\t\n171\t\treturn entry\n172\t}\n173\t\n174\t// headers renders the request headers by whichever route redacts them.\n175\t//\n176\t// A Value holding a SecretRef prints as <redacted:env:NAME> by construction and\n177\t// keeps that form, which tells a reader which variable to export. Everything\n178\t// else goes through the name-based matcher, which is what catches a credential\n179\t// the user typed into --header as a literal — nothing structural would.\n180\tfunc (r Redactors) headers(pairs []request.Pair) map[string]string {\n181\t\tif len(pairs) == 0 {\n182\t\t\treturn nil\n183\t\t}\n184\t\n185\t\tout := make(map[string]string, len(pairs))\n186\t\tfor _, p := range pairs {\n187\t\t\tvalue := p.Value.String()\n188\t\t\tif !p.Value.IsSecret() {\n189\t\t\t\tvalue = r.Request.Value(p.Name, value)\n190\t\t\t}\n191\t\t\tif existing, ok := out[p.Name]; ok {\n192\t\t\t\tvalue = existing + \", \" + value\n193\t\t\t}\n194\t\t\tout[p.Name] = value\n195\t\t}\n196\t\n197\t\treturn out\n198\t}\n199\t\n200\t// cookies records cookie names and no literal cookie values.\n201\t//\n202\t// On the wire these are one Cookie header, which the built-in list redacts\n203\t// whole; matching a per-cookie name like \"session\" against that list would\n204\t// catch nothing, so keeping literals here would make the same credential safe\n205\t// as a header and exposed as a cookie. A cookie that names a SecretRef keeps\n206\t// its <redacted:env:NAME> form, which says more than the placeholder does.\n207\tfunc (r Redactors) cookies(pairs []request.Pair) map[string]string {\n208\t\tif len(pairs) == 0 {\n209\t\t\treturn nil\n210\t\t}\n211\t\n212\t\tout := make(map[string]string, len(pairs))\n213\t\tfor _, p := range pairs {\n214\t\t\tif p.Value.IsSecret() {\n215\t\t\t\tout[p.Name] = p.Value.String()\n216\t\t\t\tcontinue\n217\t\t\t}\n218\t\t\tout[p.Name] = secret.Placeholder\n219\t\t}\n220\t\n221\t\treturn out\n222\t}\n223\t\n224\t// requestBody redacts and cuts the body that was sent. The response redactor's\n225\t// JSON paths are applied to it too: the built-in list names access_token and\n226\t// refresh_token, and a token-refresh request carries one in exactly that field.\n227\tfunc (r Redactors) requestBody(b *request.Body) *Body {\n228\t\tif b == nil {\n229\t\t\treturn nil\n230\t\t}\n231\t\n232\t\treturn newBody(b.ContentType, r.Response.Body(b.Data))\n233\t}\n234\t\n235\t// newBody keeps at most MaxBody bytes of data, reporting whether it had to cut.\n236\t//\n237\t// A JSONL line has to stay parseable — one unparseable line is one a reader has\n238\t// to skip — and encoding/json buys that by rewriting every byte a Go string\n239\t// cannot hold to U+FFFD. That is fine for text and destroys anything else, so\n240\t// the bytes are checked first: valid UTF-8 is stored as itself and stays\n241\t// readable in the store, and anything else is base64'd so the entry survives the\n242\t// round trip byte for byte. The cut is at a byte offset and may land inside a\n243\t// UTF-8 sequence, which lands such a body in the base64 case too.\n244\tfunc newBody(contentType string, data []byte) *Body {\n245\t\tif len(data) == 0 {\n246\t\t\treturn nil\n247\t\t}\n248\t\n249\t\tbody := &Body{ContentType: contentType}\n250\t\tif len(data) > MaxBody {\n251\t\t\tdata = data[:MaxBody]\n252\t\t\tbody.Truncated = true\n253\t\t}\n254\t\tif utf8.Valid(data) {\n255\t\t\tbody.Data = string(data)\n256\t\n257\t\t\treturn body\n258\t\t}\n259\t\tbody.Data = base64.StdEncoding.EncodeToString(data)\n260\t\tbody.Encoding = EncodingBase64\n261\t\n262\t\treturn body\n263\t}\n264\t\n265\t// contentType reads the media type off a response, for a reader deciding how to\n266\t// interpret the recorded bytes.\n267\tfunc contentType(headers map[string][]string) string {\n268\t\tfor _, value := range headers[\"Content-Type\"] {\n269\t\t\treturn value\n270\t\t}\n271\t\n272\t\treturn \"\"\n273\t}\n274\t"
      }
