        "tool_use_id": "toolu_01H7aEyBRtH2eMti5xPYzT4H",
        "type": "tool_result",
        "content": "1\tpackage secret\n2\t\n3\timport (\n4\t\t\"regexp\"\n5\t\t\"strings\"\n6\t)\n7\t\n8\t// Placeholder is what a redacted value renders as when there is no ref behind\n9\t// it — a literal the user typed into --header, or a value that arrived from the\n10\t// wire. Where a SecretRef exists, its own <redacted:env:NAME> form is more\n11\t// useful and is used instead.\n12\tconst Placeholder = \"<redacted>\"\n13\t\n14\t// builtinPatterns is the list from the DESIGN.md §5a leak-channel table, plus\n15\t// Set-Cookie from the same table's response-header row. Patterns are globs over\n16\t// the lower-cased header name where * matches any run of characters; a pattern\n17\t// without a * matches the whole name exactly, which is why Cookie does not also\n18\t// catch Set-Cookie.\n19\tvar builtinPatterns = []string{\n20\t\t\"authorization\",\n21\t\t\"proxy-authorization\",\n22\t\t\"cookie\",\n23\t\t\"set-cookie\",\n24\t\t\"*api*key*\",\n25\t\t\"*token*\",\n26\t\t\"*secret*\",\n27\t}\n28\t\n29\t// builtin is compiled once at startup and shared by every Redactor.\n30\tvar builtin = compileGlobs(builtinPatterns)\n31\t\n32\t// Redactor decides which header names carry credentials. The built-in list is\n33\t// always in effect: a Redactor's extra patterns extend it and there is no way\n34\t// to remove one, because a configurable firewall is one a misconfiguration can\n35\t// switch off.\n36\t//\n37\t// The zero value — including a nil *Redactor, which is what an unset struct\n38\t// field is — matches the built-in list, so redaction is never accidentally\n39\t// opt-in.\n40\ttype Redactor struct {\n41\t\tpatterns []*regexp.Regexp\n42\t}\n43\t\n44\t// NewRedactor returns a Redactor matching the built-in list plus extra, each of\n45\t// which is a glob over the header name.\n46\tfunc NewRedactor(extra ...string) *Redactor {\n47\t\tif len(extra) == 0 {\n48\t\t\treturn &Redactor{patterns: builtin}\n49\t\t}\n50\t\n51\t\tpatterns := make([]*regexp.Regexp, 0, len(builtin)+len(extra))\n52\t\tpatterns = append(patterns, builtin...)\n53\t\tpatterns = append(patterns, compileGlobs(extra)...)\n54\t\n55\t\treturn &Redactor{patterns: patterns}\n56\t}\n57\t\n58\t// IsSensitive reports whether a header by this name carries a credential.\n59\t// Matching is case-insensitive, as header names are.\n60\tfunc (r *Redactor) IsSensitive(name string) bool {\n61\t\tif name == \"\" {\n62\t\t\treturn false\n63\t\t}\n64\t\n65\t\tlowered := strings.ToLower(name)\n66\t\tfor _, pattern := range r.match() {\n67\t\t\tif pattern.MatchString(lowered) {\n68\t\t\t\treturn true\n69\t\t\t}\n70\t\t}\n71\t\n72\t\treturn false\n73\t}\n74\t\n75\t// Value returns value if a header by this name is safe to show, and the\n76\t// placeholder otherwise. The name alone decides: a bearer token the user typed\n77\t// into --header is as sensitive as one talaria resolved itself.\n78\tfunc (r *Redactor) Value(name, value string) string {\n79\t\tif r.IsSensitive(name) {\n80\t\t\treturn Placeholder\n81\t\t}\n82\t\n83\t\treturn value\n84\t}\n85\t\n86\t// Headers returns a copy of h with sensitive values replaced. The original is\n87\t// left untouched — it is still the map the request will be built from, and only\n88\t// the copy is bound for an output surface.\n89\tfunc (r *Redactor) Headers(h map[string]string) map[string]string {\n90\t\tif h == nil {\n91\t\t\treturn nil\n92\t\t}\n93\t\n94\t\tredacted := make(map[string]string, len(h))\n95\t\tfor name, value := range h {\n96\t\t\tredacted[name] = r.Value(name, value)\n97\t\t}\n98\t\n99\t\treturn redacted\n100\t}\n101\t\n102\t// match returns the patterns in effect, treating a nil Redactor as the\n103\t// built-in list.\n104\tfunc (r *Redactor) match() []*regexp.Regexp {\n105\t\tif r == nil {\n106\t\t\treturn builtin\n107\t\t}\n108\t\n109\t\treturn r.patterns\n110\t}\n111\t\n112\tfunc compileGlobs(patterns []string) []*regexp.Regexp {\n113\t\tcompiled := make([]*regexp.Regexp, 0, len(patterns))\n114\t\tfor _, pattern := range patterns {\n115\t\t\tcompiled = append(compiled, compileGlob(pattern))\n116\t\t}\n117\t\n118\t\treturn compiled\n119\t}\n120\t\n121\t// compileGlob turns a header-name glob into an anchored regexp. Everything but\n122\t// * is quoted, so a user-supplied pattern cannot be a regexp injection and\n123\t// compilation cannot fail.\n124\tfunc compileGlob(pattern string) *regexp.Regexp {\n125\t\tparts := strings.Split(strings.ToLower(pattern), \"*\")\n126\t\tfor i, part := range parts {\n127\t\t\tparts[i] = regexp.QuoteMeta(part)\n128\t\t}\n129\t\n130\t\treturn regexp.MustCompile(\"^\" + strings.Join(parts, \".*\") + \"$\")\n131\t}\n132\t"
      }
    ]
