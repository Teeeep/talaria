        "content": "1\tpackage spec\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\n6\t\t\"github.com/pb33f/libopenapi\"\n7\t\n8\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n9\t)\n10\t\n11\t// sourceBytes is the Source recorded for a spec that never had a path or URL.\n12\tconst sourceBytes = \"<bytes>\"\n13\t\n14\t// LoadBytes parses raw spec bytes, in either JSON or YAML, and builds the\n15\t// OpenAPI 3.x model. Every failure comes back as a clierr.SpecLoad (exit 3),\n16\t// including the ones libopenapi reports as a panic-free error slice, so no\n17\t// caller has to classify a parse failure itself.\n18\tfunc LoadBytes(data []byte) (*Document, error) {\n19\t\treturn loadBytes(data, sourceBytes)\n20\t}\n21\t\n22\t// LoadFile reads a spec from disk and loads it. A missing or unreadable path is\n23\t// a spec-load failure too, not a usage error: the distinction that matters to an\n24\t// agent is \"the spec did not come up\", and the message names the path either\n25\t// way.\n26\tfunc LoadFile(path string) (*Document, error) {\n27\t\tdata, err := os.ReadFile(path)\n28\t\tif err != nil {\n29\t\t\treturn nil, clierr.SpecLoad(\"reading spec %s: %w\", path, err)\n30\t\t}\n31\t\n32\t\treturn loadBytes(data, path)\n33\t}\n34\t\n35\t// loadBytes is the single parse path both entry points share, so the error\n36\t// wrapping and the Source bookkeeping stay in one place.\n37\tfunc loadBytes(data []byte, source string) (*Document, error) {\n38\t\t// Swagger 2.0 is converted here, before anything else sees the bytes, so\n39\t\t// \"any API doc\" stops being a special case one command at a time.\n40\t\tvar convertedFrom string\n41\t\tif isSwagger2(data) {\n42\t\t\tconverted, err := convertSwagger2(data, source)\n43\t\t\tif err != nil {\n44\t\t\t\treturn nil, err\n45\t\t\t}\n46\t\t\tdata, convertedFrom = converted, versionSwagger2\n47\t\t}\n48\t\n49\t\tdoc, err := libopenapi.NewDocument(data)\n50\t\tif err != nil {\n51\t\t\treturn nil, clierr.SpecLoad(\"parsing spec %s: %w\", source