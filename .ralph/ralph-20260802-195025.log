        "content": "700\t\t\tif strings.Contains(rendering, canary) {\n701\t\t\t\tt.Errorf(\"%s() = %q, want the value hidden\", name, rendering)\n702\t\t\t}\n703\t\t}\n704\t\n705\t\t// Hidden from display, not from the request: Reveal is what the config\n706\t\t// document is built from, and it is the only way back to the value.\n707\t\tif got := v.Reveal(); got != canary {\n708\t\t\tt.Errorf(\"Reveal() = %q, want the literal back\", got)\n709\t\t}\n710\t\tif !v.IsSensitive() || v.IsSecret() {\n711\t\t\tt.Errorf(\"IsSensitive() = %v, IsSecret() = %v; want a sensitive literal, not a ref\",\n712\t\t\t\tv.IsSensitive(), v.IsSecret())\n713\t\t}\n714\t}\n715\t\n716\tfunc TestBuildHidesALiteralUnderACredentialShapedHeaderName(t *testing.T) {\n717\t\tin := inputs(t, \"listPets\")\n718\t\tin.Params = []string{\"limit=10\"}\n719\t\tin.Headers = []string{\n720\t\t\t\"X-Api-Key=\" + canary,\n721\t\t\t\"Authorization=Bearer \" + canary,\n722\t\t\t\"X-Request-Id=trace-42\",\n723\t\t}\n724\t\n725\t\treq := build(t, in)\n726\t\n727\t\tfor _, name := range []string{\"X-Api-Key\", \"Authorization\"} {\n728\t\t\tvalue := find(t, req.Headers, name)\n729\t\t\tif got := value.String(); strings.Contains(got, canary) {\n730\t\t\t\tt.Errorf(\"header %s displays as %q; a literal under a credential-shaped name is redacted\", name, got)\n731\t\t\t}\n732\t\t\tif !strings.Contains(value.Reveal(), canary) {\n733\t\t\t\tt.Errorf(\"header %s no longer carries the value it will send: %q\", name, value.Reveal())\n734\t\t\t}\n735\t\t}\n736\t\n737\t\t// Redaction is by name, so an ordinary header is left alone: a request whose\n738\t\t// every header read <redacted> would tell an agent nothing.\n739\t\tif got := find(t, req.Headers, \"X-Request-Id\").String(); got != \"trace-42\" {\n740\t\t\tt.Errorf(\"header X-Request-Id = %q, want trace-42\", got)\n741\t\t}\n742\t}\n743\t\n744\tfunc TestBuildHidesALiteralUnderACredentialShapedQueryName(t *testing.T) {\n745\t\tin := inputs(t, \"listPets\")\n746\t\tin.Params = []string{\"limit=10\"}\n747\t\tin.Query = []string{\"api_key=\" + canary, \"page=2\"}\n748\t\n749\t\treq := build(t, in)\n750\t\n751\t\t// §5a names \"query-string API keys (?api_key=)\" as a credential location,\n752\t\t// so the built-in name matcher applies here exactly as it does to headers.\n753\t\tvalue := find(t, req.Query, \"api_key\")\n754\t\tif !value.IsSensitive() {\n755\t\t\tt.Error(\"--query api_key is not sensitive; a query-string API key is a credential (§5a)\")\n756\t\t}\n757\t\tif got := value.String(); got != secret.Placeholder {\n758\t\t\tt.Errorf(\"api_key displays as %q, want %q\", got, secret.Placeholder)\n759\t\t}\n760\t\tif got := value.Reveal(); got != canary {\n761\t\t\tt.Errorf(\"api_key no longer carries the value it will send: %q\", got)\n762\t\t}\n763\t\n764\t\t// By name, as everywhere else: an ordinary query parameter is untouched.\n765\t\tif got := find(t, req.Query, \"page\").String(); got != \"2\" {\n766\t\t\tt.Errorf(\"query page = %q, want 2\", got)\n767\t\t}\n768\t}\n769\t\n770\t// TestQueryStringEscapesAResolvedSensitiveLiteral pins the half of the fix that\n771\t// is easy to lose: QueryString is shared with the wire path, so skipping the\n772\t// percent-encoding is only ever safe for a placeholder, never for a value.\n773\tfunc TestQueryStringEscapesAResolvedSensitiveLiteral(t *testing.T) {\n774\t\treq := Request{\n775\t\t\tBaseURL: \"https://api.example.com\",\n776\t\t\tPath:    \"/pets\",\n777\t\t\tQuery:   []Pair{{Name: \"api_key\", Value: Literal(\"a b&c\").Sensitive()}},\n778\t\t}\n779\t\n780\t\tresolve := func(v Value) (string, error) { return v.Reveal(), nil }\n781\t\n782\t\tgot, err := req.QueryString(resolve)\n783\t\tif err != nil {\n784\t\t\tt.Fatalf(\"QueryString: %v\", err)\n785\t\t}\n786\t\tif got != \"api_key=a+b%26c\" {\n787\t\t\tt.Errorf(\"QueryString(resolve) = %q, want the resolved value percent-encoded\", got)\n788\t\t}\n789\t\n790\t\t// The display form is the placeholder, and it is the one case that skips\n791\t\t// the escape so it stays readable.\n792\t\tgot, err = req.QueryString(Redacted)\n793\t\tif err != nil {\n794\t\t\tt.Fatalf(\"QueryString(Redacted): %v\", err)\n795\t\t}\n796\t\tif got != \"api_key=\"+secret.Placeholder {\n797\t\t\tt.Errorf(\"QueryString(Redacted) = %q, want %q\", got, \"api_key=\"+secret.Placeholder)\n798\t\t}\n799\t}"
