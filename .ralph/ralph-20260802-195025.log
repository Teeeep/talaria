          "-    t.Errorf(\"error = %q, want it to name --body\", msg)",
          "+  msg := bodyUsageErr(t, in)",
          "+  // The count and the kind of each value locate the mistake; the bytes are",
          "+  // what a request body carries a client_secret in.",
