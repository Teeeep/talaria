    "content": [
      {
        "tool_use_id": "toolu_01Jpe16UfY8qsu94jDDYy51q",
        "type": "tool_result",
        "content": "1\tpackage request\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"io\"\n6\t\t\"net/url\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n11\t\t\"github.com/Teeeep/talaria/internal/config\"\n12\t\t\"github.com/Teeeep/talaria/internal/operation\"\n13\t\t\"github.com/Teeeep/talaria/internal/secret\"\n14\t\t\"github.com/Teeeep/talaria/internal/spec\"\n15\t)\n16\t\n17\t// Parameter locations. Three of them are also credential locations and are\n18\t// aliased from internal/config so the two packages cannot drift; `path` is the\n19\t// one place a credential never goes, which is why config does not name it.\n20\tconst (\n21\t\tinPath   = \"path\"\n22\t\tinQuery  = config.InQuery\n23\t\tinHeader = config.InHeader\n24\t\tinCookie = config.InCookie\n25\t)\n26\t\n27\t// Inputs is everything one call needs: the operation and the document it came\n28\t// from, the resolved profile and credentials, and the raw `name=value` flag\n29\t// strings exactly as the CLI received them. Parsing them here rather than in\n30\t// cmd/ keeps the binding rules — and their error messages — testable without a\n31\t// command tree.\n32\ttype Inputs struct {\n33\t\tOp      operation.Operation\n34\t\tDoc     *spec.Document\n35\t\tProfile *config.Profile\n36\t\t// Creds are the credentials config.Resolve produced for Op. They name\n37\t\t// credentials; they never carry one.\n38\t\tCreds []config.Credential\n39\t\t// BaseURL is --base-url. It beats the profile, which beats the spec.\n40\t\tBaseURL string\n41\t\t// Params are --param name=value for parameters the operation declares, in\n42\t\t// any location.\n43\t\tParams []string\n44\t\t// Query are --query name=value, for query parameters the spec may not\n45\t\t// declare.\n46\t\tQuery []string\n47\t\t// Headers are --header name=value.\n48\t\tHeaders []string\n49\t\t// Body holds --body exactly as given: a literal, @file, or \"-\" for stdin.\n50\t\t// It is a slice so a repeated flag is a reportable mistake rather than a\n51\t\t// silent last-one-wins.\n52\t\tBody []string\n53\t\t// Redactor is the config file's user-extensible display patterns\n54\t\t// (`redact.headers`), layered over the built-in credential names §5a fixes\n55\t\t// as the non-configurable floor. Nil means that floor and nothing more.\n56\t\tRedactor *secret.Redactor\n57\t\t// Stdin is the reader `--body -` consumes. It is injected rather than read\n58\t\t// from os.Stdin so the ownership rule is testable: the Go process reads the\n59\t\t// body in full before curl exists, and curl's own stdin carries the config\n60\t\t// document (DESIGN.md §5a).\n61\t\tStdin io.Reader\n62\t}\n63\t\n64\t// Build binds inputs to an operation and returns the request to make.\n65\t//\n66\t// Every binding problem is collected before returning rather than reported one\n67\t// at a time: an agent that gets \"petId is required; --header malformed\" fixes\n68\t// both in one round trip, where a fail-fast builder would cost it two.\n69\tfunc Build(in Inputs) (*Request, error) {\n70\t\tb := &binder{in: in}\n71\t\n72\t\treq := &Request{\n73\t\t\tOperationID: in.Op.ID,\n74\t\t\tMethod:      in.Op.Method,\n75\t\t\tBaseURL:     b.baseURL(),\n76\t\t}\n77\t\n78\t\tbound := b.params()\n79\t\treq.Path = b.path(bound)\n80\t\n81\t\t// Query goes through hide for the same reason headers and cookies do: §5a\n82\t\t// names query-string API keys (`?api_key=`) as a credential location, and a\n83\t\t// value's origin — spec, profile, --param or --query — does not change what\n84\t\t// the name says it is.\n85\t\treq.Query = hide(in.Redactor, append(b.located(bound, inQuery), b.pairs(in.Query, \"--query\", nil)...))\n86\t\treq.Headers = hide(in.Redactor, b.headers(bound))\n87\t\treq.Cookies = hide(in.Redactor, b.located(bound, inCookie))\n88\t\t// After the headers, because the body's content type defers to a\n89\t\t// Content-Type the user set; before the credentials, which never set one.\n90\t\treq.Body = b.body(req)\n91\t\n92\t\tb.credentials(req)\n93\t\n94\t\tif err := b.err(); err != nil {\n95\t\t\treturn nil, err\n96\t\t}\n97\t\n98\t\treturn req, nil\n99\t}\n100\t\n101\t// binder accumulates the problems found while binding so they can all be\n102\t// reported together.\n103\ttype binder struct {\n104\t\tin       Inputs\n105\t\tproblems []string\n106\t\t// unknown records that some --param named a parameter the operation does\n107\t\t// not declare, so the error can carry the declared names as alternatives.\n108\t\tunknown bool\n109\t}\n110\t\n111\tfunc (b *binder) fail(format string, a ...any) {\n112\t\tb.problems = append(b.problems, clierr.Usage(format, a...).Message)\n113\t}\n114\t\n115\t// err folds the collected problems into one usage error, naming the operation\n116\t// so the message stands alone in a log.\n117\tfunc (b *binder) err() error {\n118\t\tif len(b.problems) == 0 {\n119\t\t\treturn nil\n120\t\t}\n121\t\n122\t\terr := clierr.Usage(\"cannot build a request for %s: %s\",\n123\t\t\toperationName(b.in.Op), strings.Join(b.problems, \"; \"))\n124\t\tif b.unknown {\n125\t\t\terr = err.WithAlternatives(declaredNames(b.in.Op)...)\n126\t\t}\n127\t\n128\t\treturn err\n129\t}\n130\t\n131\t// baseURL resolves where the request goes: --base-url, then the profile, then\n132\t// the spec's first server (DESIGN.md §4). A spec whose server URL is relative\n133\t// — common for specs that expect a host to be supplied — counts as no server.\n134\tfunc (b *binder) baseURL() string {\n135\t\tcandidates := []struct{ source, raw string }{\n136\t\t\t{\"--base-url\", b.in.BaseURL},\n137\t\t}\n138\t\tif b.in.Profile != nil {\n139\t\t\tcandidates = append(candidates, struct{ source, raw string }{\n140\t\t\t\t\"profile \" + b.in.Profile.Name, b.in.Profile.BaseURL})\n141\t\t}\n142\t\tcandidates = append(candidates, struct{ source, raw string }{\"the spec's servers[0].url\", firstServer(b.in.Doc)})\n143\t\n144\t\tfor _, c := range candidates {\n145\t\t\tif c.raw == \"\" {\n146\t\t\t\tcontinue\n147\t\t\t}\n148\t\n149\t\t\t// Before the parse, so a URL that fails to parse cannot have its\n150\t\t\t// userinfo quoted back by the message below.\n151\t\t\tif host, ok := Userinfo(c.raw); ok {\n152\t\t\t\tb.fail(\"base URL from %s carries a credential in its userinfo (user:password@%s); \"+\n153\t\t\t\t\t\"remove it and set %s=user:password instead, which keeps the value out of the \"+\n154\t\t\t\t\t\"request, the emitted curl and the history\", c.source, host, config.EnvBasic)\n155\t\t\t\treturn \"\"\n156\t\t\t}\n157\t\n158\t\t\tparsed, err := url.Parse(c.raw)\n159\t\t\tif err != nil || parsed.Host == \"\" || !IsHTTPScheme(parsed.Scheme) {\n160\t\t\t\tb.fail(\"base URL %q from %s is not an absolute http(s) URL\", c.raw, c.source)\n161\t\t\t\treturn \"\"\n162\t\t\t}\n163\t\n164\t\t\treturn strings.TrimSuffix(c.raw, \"/\")\n165\t\t}\n166\t\n167\t\tb.fail(\"no base URL: the spec declares no server, so pass --base-url or set one in a profile\")\n168\t\n169\t\treturn \"\"\n170\t}\n171\t\n172\t// firstServer returns the document's first server URL, or \"\" when it has none.\n173\tfunc firstServer(doc *spec.Document) string {\n174\t\tif doc == nil || doc.Model == nil || len(doc.Model.Servers) == 0 || doc.Model.Servers[0] == nil {\n175\t\t\treturn \"\"\n176\t\t}\n177\t\n178\t\treturn doc.Model.Servers[0].URL\n179\t}\n180\t\n181\t// params parses --param flags against the parameters the operation declares,\n182\t// keyed by the declared name so path substitution and location routing both\n183\t// read from one place.\n184\tfunc (b *binder) params() map[string]string {\n185\t\tdeclared := map[string]operation.Param{}\n186\t\tfor _, p := range b.in.Op.Params {\n187\t\t\tdeclared[p.Name] = p\n188\t\t}\n189\t\n190\t\tbound := map[string]string{}\n191\t\tfor i, raw := range b.in.Params {\n192\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n193\t\t\tif !ok || name == \"\" {\n194\t\t\t\t// Reported like every other rejected name=value flag: by position,\n195\t\t\t\t// with the value elided. A --param can be a query-string API key.\n196\t\t\t\tb.fail(\"--param %d is not name=value%s\", i+1, elided(raw))\n197\t\t\t\tcontinue\n198\t\t\t}\n199\t\n200\t\t\tif _, ok := declared[name]; !ok {\n201\t\t\t\tb.unknown = true\n202\t\t\t\tb.fail(\"%s declares no parameter %q\", operationName(b.in.Op), name)\n203\t\t\t\tcontinue\n204\t\t\t}\n205\t\n206\t\t\tbound[name] = value\n207\t\t}\n208\t\n209\t\t// Reported after parsing so a missing parameter and a misspelt one surface\n210\t\t// together rather than one run apart.\n211\t\tfor _, p := range b.in.Op.Params {\n212\t\t\tif _, ok := bound[p.Name]; p.Required && !ok {\n213\t\t\t\tb.fail(\"--param %s is required (%s parameter)\", p.Name, p.In)\n214\t\t\t}\n215\t\t}\n216\t\n217\t\treturn bound\n218\t}\n219\t\n220\t// path substitutes the bound path parameters into the operation's template.\n221\t//\n222\t// Values are escaped with url.PathEscape, so a value containing / or ? stays\n223\t// inside its own segment instead of rewriting the request's target — the same\n224\t// reason SQL uses placeholders rather than string concatenation.\n225\tfunc (b *binder) path(bound map[string]string) string {\n226\t\tpath := b.in.Op.Path\n227\t\tfor _, p := range b.in.Op.Params {\n228\t\t\tif p.In != inPath {\n229\t\t\t\tcontinue\n230\t\t\t}\n231\t\n232\t\t\tvalue, ok := bound[p.Name]\n233\t\t\tif !ok {\n234\t\t\t\tcontinue\n235\t\t\t}\n236\t\n237\t\t\tpath = strings.ReplaceAll(path, \"{\"+p.Name+\"}\", url.PathEscape(value))\n238\t\t}\n239\t\n240\t\t// A leftover placeholder means the spec templated a segment it never\n241\t\t// declared a parameter for; without this the request would go to a literal\n242\t\t// \"/pets/{petId}\".\n243\t\tif strings.ContainsAny(path, \"{}\") {\n244\t\t\tb.fail(\"path %q has a placeholder the operation declares no parameter for\", b.in.Op.Path)\n245\t\t}\n246\t\n247\t\treturn path\n248\t}\n249\t\n250\t// located returns the bound parameters that belong in one location, in the\n251\t// order the spec declares them so the result is stable across runs.\n252\tfunc (b *binder) located(bound map[string]string, in string) []Pair {\n253\t\tvar out []Pair\n254\t\tfor _, p := range b.in.Op.Params {\n255\t\t\tif p.In != in {\n256\t\t\t\tcontinue\n257\t\t\t}\n258\t\t\tif value, ok := bound[p.Name]; ok {\n259\t\t\t\tout = append(out, Pair{Name: p.Name, Value: Literal(value)})\n260\t\t\t}\n261\t\t}\n262\t\n263\t\treturn out\n264\t}\n265\t\n266\t// headers merges the three sources of request headers. The profile is the least\n267\t// specific and only contributes names nothing else supplied, so `--header\n268\t// X-Env=explicit` overrides a profile's X-Env instead of sending both.\n269\tfunc (b *binder) headers(bound map[string]string) []Pair {\n270\t\tout := append(b.located(bound, inHeader), b.pairs(b.in.Headers, \"--header\", httpFieldName)...)\n271\t\n272\t\tif b.in.Profile == nil {\n273\t\t\treturn out\n274\t\t}\n275\t\n276\t\tset := map[string]bool{}\n277\t\tfor _, p := range out {\n278\t\t\tset[strings.ToLower(p.Name)] = true\n279\t\t}\n280\t\n281\t\tnames := make([]string, 0, len(b.in.Profile.Headers))\n282\t\tfor name := range b.in.Profile.Headers {\n283\t\t\tnames = append(names, name)\n284\t\t}\n285\t\tsort.Strings(names)\n286\t\n287\t\tfor _, name := range names {\n288\t\t\tif !set[strings.ToLower(name)] {\n289\t\t\t\tout = append(out, Pair{Name: name, Value: Literal(b.in.Profile.Headers[name])})\n290\t\t\t}\n291\t\t}\n292\t\n293\t\treturn out\n294\t}\n295\t\n296\t// hide marks every literal sitting under a credential-shaped name — the §5a\n297\t// built-in list: Authorization, Cookie, Proxy-Authorization, *api*key*, *token*,\n298\t// *secret* — as sensitive, so it renders `<redacted>` on every surface that\n299\t// displays a Value while still going on the wire.\n300\t//\n301\t// The name is all there is to go on. talaria cannot tell a token the user typed\n302\t// into --header from an ordinary string by looking at the string, and §5a's\n303\t// answer is that it does not have to: the name decides, whether the value came\n304\t// from a spec's security scheme, a profile, a bound parameter or the flag.\n305\t//\n306\t// red is the config file's extension of that list. A nil one is the built-in\n307\t// floor alone, which is what it has to be: redaction is never opt-in, so a\n308\t// caller that supplies no patterns gets the same protection as one that does.\n309\tfunc hide(red *secret.Redactor, pairs []Pair) []Pair {\n310\t\tfor i, p := range pairs {\n311\t\t\tif !p.Value.IsSecret() && red.IsSensitive(p.Name) {\n312\t\t\t\tpairs[i].Value = p.Value.Sensitive()\n313\t\t\t}\n314\t\t}\n315\t\n316\t\treturn pairs\n317\t}\n318\t\n319\t// pairs parses repeatable name=value flags. Only the first = separates, because\n320\t// header and query values legitimately contain more.\n321\t//\n322\t// A rejected argument is reported by position and never by content. The shell\n323\t// expanded it before talaria saw it, so `--header \"Authorization: Bearer\n324\t// $TOKEN\"` — the form a user reaches for — holds the real token, and quoting it\n325\t// back would publish the credential in the exit-2 message on stderr. §5a puts\n326\t// error paths inside the firewall, not outside it.\n327\t//\n328\t// rule, when non-nil, is the extra constraint this flag holds its names to.\n329\tfunc (b *binder) pairs(raws []string, flag string, rule *nameRule) []Pair {\n330\t\tout := make([]Pair, 0, len(raws))\n331\t\tfor i, raw := range raws {\n332\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n333\t\t\tif !ok || name == \"\" {\n334\t\t\t\tb.fail(\"%s %d is not name=value%s\", flag, i+1, elided(raw))\n335\t\t\t\tcontinue\n336\t\t\t}\n337\t\n338\t\t\tif rule != nil && !rule.ok(name) {\n339\t\t\t\tb.fail(\"%s %d %s%s\", flag, i+1, rule.want, elided(name))\n340\t\t\t\tcontinue\n341\t\t\t}\n342\t\n343\t\t\tout = append(out, Pair{Name: name, Value: Literal(value)})\n344\t\t}\n345\t\n346\t\treturn out\n347\t}\n348\t\n349\t// nameRule constrains what the name half of a name=value flag may be. Only\n350\t// --header has one: a header name goes on the wire as an HTTP field name, while\n351\t// a query parameter name is an ordinary string an API is free to spell\n352\t// `filter[status]`.\n353\ttype nameRule struct {\n354\t\t// ok reports whether the name is usable.\n355\t\tok func(string) bool\n356\t\t// want completes \"--header 2 …\" when it is not.\n357\t\twant string\n358\t}\n359\t\n360\t// httpFieldName holds --header names to what a header name can actually be.\n361\tvar httpFieldName = &nameRule{ok: isFieldName, want: \"is not a valid HTTP header name\"}\n362\t\n363\t// fieldNameChars is the token character set an HTTP field name is drawn from\n364\t// (RFC 9110 §5.1, via §5.6.2).\n365\tconst fieldNameChars = \"!#$%&'*+-.^_`|~\" +\n366\t\t\"0123456789\" +\n367\t\t\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\" +\n368\t\t\"abcdefghijklmnopqrstuvwxyz\"\n369\t\n370\t// isFieldName reports whether name can be sent as a header name.\n371\t//\n372\t// The character that fails this in practice is the colon, from curl's `Name:\n373\t// value` form: `--header 'X-Trace: abc=1'` parses as the name \"X-Trace: abc\",\n374\t// which curl's config document renders as the malformed wire header\n375\t// `X-Trace: abc: 1`. Refusing it is the difference between a request the user\n376\t// did not write and a clean exit 2.\n377\tfunc isFieldName(name string) bool {\n378\t\tfor _, r := range name {\n379\t\t\tif !strings.ContainsRune(fieldNameChars, r) {\n380\t\t\t\treturn false\n381\t\t\t}\n382\t\t}\n383\t\n384\t\treturn name != \"\"\n385\t}\n386\t\n387\t// elided describes a rejected argument without echoing what may be a\n388\t// credential: the text before its first `=` or `:`, which is a name, and\n389\t// nothing at all when it holds neither separator — an argument with no\n390\t// separator in it is indistinguishable from a bare token. Not even a truncated\n391\t// prefix of the value: part of a credential is still part of a credential.\n392\tfunc elided(raw string) string {\n393\t\tif cut := strings.IndexAny(raw, \"=:\"); cut > 0 {\n394\t\t\treturn fmt.Sprintf(\" (it starts %q; the rest is not echoed)\", raw[:cut])\n395\t\t}\n396\t\n397\t\treturn \" (its text is not echoed)\"\n398\t}\n399\t\n400\t// credentials puts each resolved credential where its scheme says it goes, as a\n401\t// reference. This is the §5a boundary: what lands on the request is the name of\n402\t// a credential and how to encode it, never the credential.\n403\tfunc (b *binder) credentials(req *Request) {\n404\t\tfor _, cred := range b.in.Creds {\n405\t\t\tpair := Pair{Name: cred.Name, Value: Secret(cred.Ref, encodingFor(cred.Kind))}\n406\t\n407\t\t\tswitch cred.In {\n408\t\t\tcase inHeader:\n409\t\t\t\treq.Headers = append(req.Headers, pair)\n410\t\t\tcase inQuery:\n411\t\t\t\treq.Query = append(req.Query, pair)\n412\t\t\tcase inCookie:\n413\t\t\t\treq.Cookies = append(req.Cookies, pair)\n414\t\t\tdefault:\n415\t\t\t\tb.fail(\"scheme %q wants its credential in %q, which is not a place a request has\",\n416\t\t\t\t\tcred.Scheme, cred.In)\n417\t\t\t}\n418\t\t}\n419\t}\n420\t\n421\tfunc encodingFor(kind config.Kind) Encoding {\n422\t\tswitch kind {\n423\t\tcase config.KindBearer:\n424\t\t\treturn EncodeBearer\n425\t\tcase config.KindBasic:\n426\t\t\treturn EncodeBasic\n427\t\tdefault:\n428\t\t\treturn EncodeRaw\n429\t\t}\n430\t}\n431\t\n432\t// declaredNames lists the parameters the operation accepts, for the\n433\t// valid_alternatives an agent corrects itself from.\n434\tfunc declaredNames(op operation.Operation) []string {\n435\t\tnames := make([]string, 0, len(op.Params))\n436\t\tfor _, p := range op.Params {\n437\t\t\tnames = append(names, p.Name)\n438\t\t}\n439\t\n440\t\treturn names\n441\t}\n442\t\n443\t// operationName is the operation's ID, falling back to method and path for a\n444\t// spec that sets no operationId.\n445\tfunc operationName(op operation.Operation) string {\n446\t\tif op.ID != \"\" {\n447\t\t\treturn op.ID\n448\t\t}\n449\t\n450\t\treturn op.Method + \" \" + op.Path\n451\t}\n452\t"
      }
    ]
