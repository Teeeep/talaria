        "content": "1\t// This file is an external test package because assertion 4 of Task 18 — that a\n2\t// body read from the process's stdin still reaches curl — has to watch the body\n3\t// cross into internal/curl, and internal/curl imports internal/request. Testing\n4\t// from outside the package is what keeps that a one-way dependency.\n5\tpackage request_test\n6\t\n7\timport (\n8\t\t\"bytes\"\n9\t\t\"io\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"testing\"\n14\t\n15\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n16\t\t\"github.com/Teeeep/talaria/internal/curl\"\n17\t\t\"github.com/Teeeep/talaria/internal/operation\"\n18\t\t\"github.com/Teeeep/talaria/internal/request\"\n19\t\t\"github.com/Teeeep/talaria/internal/spec\"\n20\t)\n21\t\n22\t// bodyInputs is the common case for a body test: the fixture's POST, which\n23\t// declares a JSON request body, with no parameters bound.\n24\tfunc bodyInputs(t *testing.T) request.Inputs {\n25\t\tt.Helper()\n26\t\n27\t\tdoc, err := spec.LoadFile(filepath.Join(\"testdata\", \"request.yaml\"))\n28\t\tif err != nil {\n29\t\t\tt.Fatalf(\"LoadFile(request.yaml): %v\", err)\n30\t\t}\n31\t\n32\t\tfor _, op := range operation.Extract(doc) {\n33\t\t\tif op.ID == \"createPet\" {\n34\t\t\t\treturn request.Inputs{Op: op, Doc: doc}\n35\t\t\t}\n36\t\t}\n37\t\n38\t\tt.Fatal(\"fixture has no operation createPet\")\n39\t\treturn request.Inputs{}\n40\t}\n41\t\n42\tfunc buildBody(t *testing.T, in request.Inputs) *request.Body {\n43\t\tt.Helper()\n44\t\n45\t\treq, err := request.Build(in)\n46\t\tif err != nil {\n47\t\t\tt.Fatalf(\"Build: %v\", err)\n48\t\t}\n49\t\tif req.Body == nil {\n50\t\t\tt.Fatal(\"Build returned a request with no body, want the --body bytes\")\n51\t\t}\n52\t\n53\t\treturn req.Body\n54\t}\n55\t\n56\t// bodyUsageErr asserts Build refused the inputs with exit code 2 and returns the\n57\t// message, so each test can go on to assert what it has to name.\n58\tfunc bodyUsageErr(t *testing.T, in request.Inputs) string {\n59\t\tt.Helper()\n60\t\n61\t\treq, err := request.Build(in)\n62\t\tif err == nil {\n63\t\t\tt.Fatalf(\"Build succeeded, want a usage error; got %+v\", req)\n64\t\t}\n65\t\tif code := clierr.From(err).Code; code != clierr.CodeUsage {\n66\t\t\tt.Fatalf(\"Build error = %v (code %d), want a usage error (%d)\", err, code, clierr.CodeUsage)\n67\t\t}\n68\t\n69\t\treturn err.Error()\n70\t}\n71\t\n72\tfunc TestBodyFlagLiteralIsSentVerbatim(t *testing.T) {\n73\t\tin := bodyInputs(t)\n74\t\tin.Body = []string{`{\"a\":1}`}\n75\t\n76\t\tif got := string(buildBody(t, in).Data); got != `{\"a\":1}` {\n77\t\t\tt.Errorf(\"body = %q, want the literal --body value\", got)\n78\t\t}\n79\t}\n80\t\n81\tfunc TestNoBodyFlagLeavesTheRequestBodyNil(t *testing.T) {\n82\t\treq, err := request.Build(bodyInputs(t))\n83\t\tif err != nil {\n84\t\t\tt.Fatalf(\"Build: %v\", err)\n85\t\t}\n86\t\tif req.Body != nil {\n87\t\t\tt.Errorf(\"body = %+v, want nil when no --body was given\", req.Body)\n88\t\t}\n89\t}\n90\t\n91\tfunc TestBodyFlagAtFileReadsTheFile(t *testing.T) {\n92\t\t// Pretty-printed with a trailing newline: a file body has to arrive byte for\n93\t\t// byte, because a signed or whitespace-sensitive payload does not survive\n94\t\t// being tidied up.\n95\t\twant := \"{\\n  \\\"a\\\": 1\\n}\\n\"\n96\t\tpath := filepath.Join(t.TempDir(), \"body.json\")\n97\t\tif err := os.WriteFile(path, []byte(want), 0o600); err != nil {\n98\t\t\tt.Fatalf(\"WriteFile: %v\", err)\n99\t\t}\n100\t"
