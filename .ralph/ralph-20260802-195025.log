        "content": "1\tpackage secret\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"strings\"\n9\t\t\"sync\"\n10\t)\n11\t\n12\t// builtinBodyPaths are the response-body JSON paths redacted without any\n13\t// configuration: the RFC 6749 token-response fields. A body carrying one of\n14\t// these came from a credential-issuing endpoint, which is exactly the case\n15\t// DESIGN.md §5a names. Everything else is API-specific — talaria cannot tell a\n16\t// secret field from an ordinary one by looking at it — and has to be configured.\n17\tvar builtinBodyPaths = []string{\"access_token\", \"refresh_token\", \"id_token\"}\n18\t\n19\t// ResponseRedactor redacts what came back off the wire, which is the one leak\n20\t// channel §5a admits it does not close: a response body may contain a secret\n21\t// and the tool cannot know which field it is. What it can do is what this type\n22\t// does — always redact the response headers that carry credentials by name, and\n23\t// redact the body paths the user has told it about.\n24\t//\n25\t// It is deliberately separate from the request-side Redactor. A request's\n26\t// secrets are structural: they are SecretRefs, and a ref cannot print its\n27\t// value. A response's secrets are just bytes, so redacting them is pattern\n28\t// matching, with the weaker guarantee that implies.\n29\t//\n30\t// The zero value — including a nil *ResponseRedactor, which is what an unset\n31\t// struct field is — redacts the built-in lists, so redaction is never\n32\t// accidentally opt-in.\n33\ttype ResponseRedactor struct {\n34\t\theaders *Redactor\n35\t\tpaths   [][]string\n36\t}\n37\t\n38\t// NewResponseRedactor returns a redactor matching the built-in header list plus\n39\t// extraHeaders, and the built-in body paths plus extraPaths.\n40\t//\n41\t// A body path is dotted — `data.token` names the `token` key of the top-level\n42\t// `data` object. Neither list can be shrunk: a firewall a misconfiguration can\n43\t// switch off is not one.\n44\tfunc NewResponseRedactor(extraHeaders, extraPaths []string) *ResponseRedactor {\n45\t\tpaths := make([][]string, 0, len(builtinBodyPaths)+len(extraPaths))\n46\t\tfor _, path := range builtinBodyPaths {\n47\t\t\tpaths = append(paths, strings.Split(path, \".\"))\n48\t\t}\n49\t\tfor _, path := range extraPaths {\n50\t\t\tif segments := splitPath(path); segments != nil {\n51\t\t\t\tpaths = append(paths, segments)\n52\t\t\t}\n53\t\t}\n54\t\n55\t\treturn &ResponseRedactor{headers: NewRedactor(extraHeaders...), paths: paths}\n56\t}\n57\t\n58\t// Headers returns a copy of h with the values of sensitive headers replaced.\n59\t//\n60\t// Repetitions are kept — Set-Cookie legitimately appears more than once, and a\n61\t// caller counting cookies should still see the right number — and the whole\n62\t// value goes, cookie name included, because `session=` in front of a token does\n63\t// not make the token safe to print.\n64\t//\n65\t// The original map is left untouched — a redactor reports, it does not edit\n66\t// what came off the wire — and only the copy travels onward. Everything\n67\t// downstream of this point, response validation included, reads the copy.\n68\tfunc (r *ResponseRedactor) Headers(h map[string][]string) map[string][]string {\n69\t\tif h == nil {\n70\t\t\treturn nil\n71\t\t}\n72\t\n73\t\tredacted := make(map[string][]string, len(h))\n74\t\tfor name, values := range h {\n75\t\t\tsensitive := r.headerRedactor().IsSensitive(name)\n76\t\n77\t\t\tcopied := make([]string, len(values))\n78\t\t\tfor i, value := range values {\n79\t\t\t\tif sensitive {\n80\t\t\t\t\tcopied[i] = Placeholder\n81\t\t\t\t} else {\n82\t\t\t\t\tcopied[i] = value\n83\t\t\t\t}\n84\t\t\t}\n85\t\t\tredacted[name] = copied\n86\t\t}\n87\t\n88\t\treturn redacted\n89\t}\n90\t\n91\t// Body returns body with the configured JSON paths replaced.\n92\t//\n93\t// A body that is not a single JSON object is returned verbatim: a dotted path\n94\t// has no meaning in a text or binary body, and rewriting bytes talaria does not\n95\t// understand would report a document the server never sent. So is a body in\n96\t// which nothing matched, which keeps the common case exact — the caller sees\n97\t// the server's own formatting, not encoding/json's.\n98\tfunc (r *ResponseRedactor) Body(body []byte) []byte {\n99\t\tpaths := r.bodyPaths()\n100\t\tif len(paths) == 0 || len(body) == 0 {\n101\t\t\treturn body\n102\t\t}\n103\t\n104\t\tdoc, ok := decodeObject(body)\n105\t\tif !ok {\n106\t\t\treturn body\n107\t\t}\n108\t\n109\t\tredacted := false\n110\t\tfor _, path := range paths {\n111\t\t\tif redactPath(doc, path) {\n112\t\t\t\tredacted = true\n113\t\t\t}\n114\t\t}\n115\t\tif !redacted {\n116\t\t\treturn body\n117\t\t}\n118\t\n119\t\tout, err := json.Marshal(doc)\n120\t\tif err != nil {\n121\t\t\t// Unreachable for a document that just decoded, but the alternative to\n122\t\t\t// returning the original here is returning nothing at all.\n123\t\t\treturn body\n124\t\t}\n125\t\n126\t\treturn out\n127\t}\n128\t\n129\t// headerRedactor returns the header matcher, treating a nil receiver as the\n130\t// built-in list.\n131\tfunc (r *ResponseRedactor) headerRedactor() *Redactor {\n132\t\tif r == nil {\n133\t\t\treturn nil // A nil *Redactor is the built-in list; see Redactor.match.\n134\t\t}\n135\t\n136\t\treturn r.headers\n137\t}\n138\t\n139\t// bodyPaths returns the paths in effect, treating a nil receiver as the\n140\t// built-in list.\n141\tfunc (r *ResponseRedactor) bodyPaths() [][]string {\n142\t\tif r == nil {\n143\t\t\treturn NewResponseRedactor(nil, nil).paths\n144\t\t}\n145\t\n146\t\treturn r.paths\n147\t}\n148\t\n149\t// decodeObject decodes body as exactly one JSON object. Trailing content means\n150\t// this was never one JSON document — a body ending in junk is not something to\n151\t// re-encode — and a top-level array is skipped because a dotted path is rooted\n152\t// at a named key.\n153\tfunc decodeObject(body []byte) (map[string]any, bool) {\n154\t\ttrimmed := bytes.TrimLeft(body, \" \\t\\r\\n\")\n155\t\tif len(trimmed) == 0 || trimmed[0] != '{' {\n156\t\t\treturn nil, false\n157\t\t}\n158\t\n159\t\tdec := json.NewDecoder(bytes.NewReader(trimmed))\n160\t\t// Numbers stay as their original text: without this an id of\n161\t\t// 1234567890123456789 comes back out as 1.2345678901234568e+18, and a\n162\t\t// redacted body must still report what the server actually sent.\n163\t\tdec.UseNumber()\n164\t\n165\t\tvar doc map[string]any\n166\t\tif err := dec.Decode(&doc); err != nil {\n167\t\t\treturn nil, false\n168\t\t}\n169\t\tif _, err := dec.Token(); err != io.EOF {\n170\t\t\treturn nil, false\n171\t\t}\n172\t\n173\t\treturn doc, true\n174\t}\n175\t\n176\t// redactPath replaces the value at path within doc, reporting whether anything\n177\t// was there to replace. A path that names nothing — a missing key, or a segment\n178\t// that turns out not to be an object — is a no-op rather than an error: a\n179\t// redaction list is written once and applied to every response an API returns.\n180\tfunc redactPath(doc map[string]any, path []string) bool {\n181\t\tif len(path) == 1 {\n182\t\t\tif _, ok := doc[path[0]]; !ok {\n183\t\t\t\treturn false\n184\t\t\t}\n185\t\t\tdoc[path[0]] = Placeholder\n186\t\n187\t\t\treturn true\n188\t\t}\n189\t\n190\t\tchild, ok := doc[path[0]].(map[string]any)\n191\t\tif !ok {\n192\t\t\treturn false\n193\t\t}\n194\t\n195\t\treturn redactPath(child, path[1:])\n196\t}\n197\t\n198\t// splitPath splits a dotted path into segments, returning nil for one that\n199\t// cannot name anything — empty, or with an empty segment. Silently ignoring it\n200\t// is right here: config validation belongs to whoever read the config, and a\n201\t// redactor that refused to be built would fail an unrelated call.\n202\tfunc splitPath(path string) []string {\n203\t\tif path == \"\" {\n204\t\t\treturn nil\n205\t\t}\n206\t\n207\t\tsegments := strings.Split(path, \".\")\n208\t\tfor _, segment := range segments {\n209\t\t\tif segment == \"\" {\n210\t\t\t\treturn nil\n211\t\t\t}\n212\t\t}\n213\t\n214\t\treturn segments\n215\t}\n216\t\n217\t// QueryKeyWarner emits the one-time warning from §5a's leak-channel table: an\n218\t// API key in the query string is symbolic in emitted curl and redacted in\n219\t// output, and still ends up in the *server's* access log, where talaria has no\n220\t// say. The user is told once so they can decide whether that is acceptable.\n221\t//\n222\t// Once per process rather than once per call, because `run` makes hundreds of\n223\t// calls against the same spec and a warning repeated hundreds of times is one\n224\t// nobody reads.\n225\ttype QueryKeyWarner struct{ once sync.Once }\n226\t\n227\t// NewQueryKeyWarner returns a warner that has not yet fired.\n228\tfunc NewQueryKeyWarner() *QueryKeyWarner { return &QueryKeyWarner{} }\n229\t\n230\t// Warn writes the warning for a credential travelling in query parameter param,\n231\t// the first time it is called and never again.\n232\t//\n233\t// The message names the parameter and the environment variable, both of which\n234\t// are names; a warning about a leak that quoted the value would be one.\n235\tfunc (w *QueryKeyWarner) Warn(out io.Writer, param string, ref SecretRef) {\n236\t\tif w == nil || out == nil {\n237\t\t\treturn\n238\t\t}\n239\t\n240\t\tw.once.Do(func() {\n241\t\t\tfmt.Fprintf(out,\n242\t\t\t\t\"warning: this operation sends %s in the query parameter %q; \"+\n243\t\t\t\t\t\"URLs are recorded in server access logs, so the key is exposed there \"+\n244\t\t\t\t\t\"whatever talaria redacts\\n\",\n245\t\t\t\tref.Symbolic(), param)\n246\t\t})\n247\t}\n248\t"
      }
