        "tool_use_id": "toolu_01RqzNPSeT3Xh1omdkq2zrBw",
        "type": "tool_result",
        "content": "1\tpackage request\n2\t\n3\timport (\n4\t\t\"io\"\n5\t\t\"net/url\"\n6\t\t\"sort\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n10\t\t\"github.com/Teeeep/talaria/internal/config\"\n11\t\t\"github.com/Teeeep/talaria/internal/operation\"\n12\t\t\"github.com/Teeeep/talaria/internal/secret\"\n13\t\t\"github.com/Teeeep/talaria/internal/spec\"\n14\t)\n15\t\n16\t// Parameter locations. Three of them are also credential locations and are\n17\t// aliased from internal/config so the two packages cannot drift; `path` is the\n18\t// one place a credential never goes, which is why config does not name it.\n19\tconst (\n20\t\tinPath   = \"path\"\n21\t\tinQuery  = config.InQuery\n22\t\tinHeader = config.InHeader\n23\t\tinCookie = config.InCookie\n24\t)\n25\t\n26\t// Inputs is everything one call needs: the operation and the document it came\n27\t// from, the resolved profile and credentials, and the raw `name=value` flag\n28\t// strings exactly as the CLI received them. Parsing them here rather than in\n29\t// cmd/ keeps the binding rules — and their error messages — testable without a\n30\t// command tree.\n31\ttype Inputs struct {\n32\t\tOp      operation.Operation\n33\t\tDoc     *spec.Document\n34\t\tProfile *config.Profile\n35\t\t// Creds are the credentials config.Resolve produced for Op. They name\n36\t\t// credentials; they never carry one.\n37\t\tCreds []config.Credential\n38\t\t// BaseURL is --base-url. It beats the profile, which beats the spec.\n39\t\tBaseURL string\n40\t\t// Params are --param name=value for parameters the operation declares, in\n41\t\t// any location.\n42\t\tParams []string\n43\t\t// Query are --query name=value, for query parameters the spec may not\n44\t\t// declare.\n45\t\tQuery []string\n46\t\t// Headers are --header name=value.\n47\t\tHeaders []string\n48\t\t// Body holds --body exactly as given: a literal, @file, or \"-\" for stdin.\n49\t\t// It is a slice so a repeated flag is a reportable mistake rather than a\n50\t\t// silent last-one-wins.\n51\t\tBody []string\n52\t\t// Stdin is the reader `--body -` consumes. It is injected rather than read\n53\t\t// from os.Stdin so the ownership rule is testable: the Go process reads the\n54\t\t// body in full before curl exists, and curl's own stdin carries the config\n55\t\t// document (DESIGN.md §5a).\n56\t\tStdin io.Reader\n57\t}\n58\t\n59\t// Build binds inputs to an operation and returns the request to make.\n60\t//\n61\t// Every binding problem is collected before returning rather than reported one\n62\t// at a time: an agent that gets \"petId is required; --header malformed\" fixes\n63\t// both in one round trip, where a fail-fast builder would cost it two.\n64\tfunc Build(in Inputs) (*Request, error) {\n65\t\tb := &binder{in: in}\n66\t\n67\t\treq := &Request{\n68\t\t\tOperationID: in.Op.ID,\n69\t\t\tMethod:      in.Op.Method,\n70\t\t\tBaseURL:     b.baseURL(),\n71\t\t}\n72\t\n73\t\tbound := b.params()\n74\t\treq.Path = b.path(bound)\n75\t\n76\t\t// Query goes through hide for the same reason headers and cookies do: §5a\n77\t\t// names query-string API keys (`?api_key=`) as a credential location, and a\n78\t\t// value's origin — spec, profile, --param or --query — does not change what\n79\t\t// the name says it is.\n80\t\treq.Query = hide(append(b.located(bound, inQuery), b.pairs(in.Query, \"--query\")...))\n81\t\treq.Headers = hide(b.headers(bound))\n82\t\treq.Cookies = hide(b.located(bound, inCookie))\n83\t\t// After the headers, because the body's content type defers to a\n84\t\t// Content-Type the user set; before the credentials, which never set one.\n85\t\treq.Body = b.body(req)\n86\t\n87\t\tb.credentials(req)\n88\t\n89\t\tif err := b.err(); err != nil {\n90\t\t\treturn nil, err\n91\t\t}\n92\t\n93\t\treturn req, nil\n94\t}\n95\t\n96\t// binder accumulates the problems found while binding so they can all be\n97\t// reported together.\n98\ttype binder struct {\n99\t\tin       Inputs\n100\t\tproblems []string\n101\t\t// unknown records that some --param named a parameter the operation does\n102\t\t// not declare, so the error can carry the declared names as alternatives.\n103\t\tunknown bool\n104\t}\n105\t\n106\tfunc (b *binder) fail(format string, a ...any) {\n107\t\tb.problems = append(b.problems, clierr.Usage(format, a...).Message)\n108\t}\n109\t\n110\t// err folds the collected problems into one usage error, naming the operation\n111\t// so the message stands alone in a log.\n112\tfunc (b *binder) err() error {\n113\t\tif len(b.problems) == 0 {\n114\t\t\treturn nil\n115\t\t}\n116\t\n117\t\terr := clierr.Usage(\"cannot build a request for %s: %s\",\n118\t\t\toperationName(b.in.Op), strings.Join(b.problems, \"; \"))\n119\t\tif b.unknown {\n120\t\t\terr = err.WithAlternatives(declaredNames(b.in.Op)...)\n121\t\t}\n122\t\n123\t\treturn err\n124\t}\n125\t\n126\t// baseURL resolves where the request goes: --base-url, then the profile, then\n127\t// the spec's first server (DESIGN.md §4). A spec whose server URL is relative\n128\t// — common for specs that expect a host to be supplied — counts as no server.\n129\tfunc (b *binder) baseURL() string {\n130\t\tcandidates := []struct{ source, raw string }{\n131\t\t\t{\"--base-url\", b.in.BaseURL},\n132\t\t}\n133\t\tif b.in.Profile != nil {\n134\t\t\tcandidates = append(candidates, struct{ source, raw string }{\n135\t\t\t\t\"profile \" + b.in.Profile.Name, b.in.Profile.BaseURL})\n136\t\t}\n137\t\tcandidates = append(candidates, struct{ source, raw string }{\"the spec's servers[0].url\", firstServer(b.in.Doc)})\n138\t\n139\t\tfor _, c := range candidates {\n140\t\t\tif c.raw == \"\" {\n141\t\t\t\tcontinue\n142\t\t\t}\n143\t\n144\t\t\tparsed, err := url.Parse(c.raw)\n145\t\t\tif err != nil || parsed.Host == \"\" || !IsHTTPScheme(parsed.Scheme) {\n146\t\t\t\tb.fail(\"base URL %q from %s is not an absolute http(s) URL\", c.raw, c.source)\n147\t\t\t\treturn \"\"\n148\t\t\t}\n149\t\n150\t\t\treturn strings.TrimSuffix(c.raw, \"/\")\n151\t\t}\n152\t\n153\t\tb.fail(\"no base URL: the spec declares no server, so pass --base-url or set one in a profile\")\n154\t\n155\t\treturn \"\"\n156\t}\n157\t\n158\t// firstServer returns the document's first server URL, or \"\" when it has none.\n159\tfunc firstServer(doc *spec.Document) string {\n160\t\tif doc == nil || doc.Model == nil || len(doc.Model.Servers) == 0 || doc.Model.Servers[0] == nil {\n161\t\t\treturn \"\"\n162\t\t}\n163\t\n164\t\treturn doc.Model.Servers[0].URL\n165\t}\n166\t\n167\t// params parses --param flags against the parameters the operation declares,\n168\t// keyed by the declared name so path substitution and location routing both\n169\t// read from one place.\n170\tfunc (b *binder) params() map[string]string {\n171\t\tdeclared := map[string]operation.Param{}\n172\t\tfor _, p := range b.in.Op.Params {\n173\t\t\tdeclared[p.Name] = p\n174\t\t}\n175\t\n176\t\tbound := map[string]string{}\n177\t\tfor _, raw := range b.in.Params {\n178\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n179\t\t\tif !ok || name == \"\" {\n180\t\t\t\tb.fail(\"--param %q is not name=value\", raw)\n181\t\t\t\tcontinue\n182\t\t\t}\n183\t\n184\t\t\tif _, ok := declared[name]; !ok {\n185\t\t\t\tb.unknown = true\n186\t\t\t\tb.fail(\"%s declares no parameter %q\", operationName(b.in.Op), name)\n187\t\t\t\tcontinue\n188\t\t\t}\n189\t\n190\t\t\tbound[name] = value\n191\t\t}\n192\t\n193\t\t// Reported after parsing so a missing parameter and a misspelt one surface\n194\t\t// together rather than one run apart.\n195\t\tfor _, p := range b.in.Op.Params {\n196\t\t\tif _, ok := bound[p.Name]; p.Required && !ok {\n197\t\t\t\tb.fail(\"--param %s is required (%s parameter)\", p.Name, p.In)\n198\t\t\t}\n199\t\t}\n200\t\n201\t\treturn bound\n202\t}\n203\t\n204\t// path substitutes the bound path parameters into the operation's template.\n205\t//\n206\t// Values are escaped with url.PathEscape, so a value containing / or ? stays\n207\t// inside its own segment instead of rewriting the request's target — the same\n208\t// reason SQL uses placeholders rather than string concatenation.\n209\tfunc (b *binder) path(bound map[string]string) string {\n210\t\tpath := b.in.Op.Path\n211\t\tfor _, p := range b.in.Op.Params {\n212\t\t\tif p.In != inPath {\n213\t\t\t\tcontinue\n214\t\t\t}\n215\t\n216\t\t\tvalue, ok := bound[p.Name]\n217\t\t\tif !ok {\n218\t\t\t\tcontinue\n219\t\t\t}\n220\t\n221\t\t\tpath = strings.ReplaceAll(path, \"{\"+p.Name+\"}\", url.PathEscape(value))\n222\t\t}\n223\t\n224\t\t// A leftover placeholder means the spec templated a segment it never\n225\t\t// declared a parameter for; without this the request would go to a literal\n226\t\t// \"/pets/{petId}\".\n227\t\tif strings.ContainsAny(path, \"{}\") {\n228\t\t\tb.fail(\"path %q has a placeholder the operation declares no parameter for\", b.in.Op.Path)\n229\t\t}\n230\t\n231\t\treturn path\n232\t}\n233\t\n234\t// located returns the bound parameters that belong in one location, in the\n235\t// order the spec declares them so the result is stable across runs.\n236\tfunc (b *binder) located(bound map[string]string, in string) []Pair {\n237\t\tvar out []Pair\n238\t\tfor _, p := range b.in.Op.Params {\n239\t\t\tif p.In != in {\n240\t\t\t\tcontinue\n241\t\t\t}\n242\t\t\tif value, ok := bound[p.Name]; ok {\n243\t\t\t\tout = append(out, Pair{Name: p.Name, Value: Literal(value)})\n244\t\t\t}\n245\t\t}\n246\t\n247\t\treturn out\n248\t}\n249\t\n250\t// headers merges the three sources of request headers. The profile is the least\n251\t// specific and only contributes names nothing else supplied, so `--header\n252\t// X-Env=explicit` overrides a profile's X-Env instead of sending both.\n253\tfunc (b *binder) headers(bound map[string]string) []Pair {\n254\t\tout := append(b.located(bound, inHeader), b.pairs(b.in.Headers, \"--header\")...)\n255\t\n256\t\tif b.in.Profile == nil {\n257\t\t\treturn out\n258\t\t}\n259\t\n260\t\tset := map[string]bool{}\n261\t\tfor _, p := range out {\n262\t\t\tset[strings.ToLower(p.Name)] = true\n263\t\t}\n264\t\n265\t\tnames := make([]string, 0, len(b.in.Profile.Headers))\n266\t\tfor name := range b.in.Profile.Headers {\n267\t\t\tnames = append(names, name)\n268\t\t}\n269\t\tsort.Strings(names)\n270\t\n271\t\tfor _, name := range names {\n272\t\t\tif !set[strings.ToLower(name)] {\n273\t\t\t\tout = append(out, Pair{Name: name, Value: Literal(b.in.Profile.Headers[name])})\n274\t\t\t}\n275\t\t}\n276\t\n277\t\treturn out\n278\t}\n279\t\n280\t// hide marks every literal sitting under a credential-shaped name — the §5a\n281\t// built-in list: Authorization, Cookie, Proxy-Authorization, *api*key*, *token*,\n282\t// *secret* — as sensitive, so it renders `<redacted>` on every surface that\n283\t// displays a Value while still going on the wire.\n284\t//\n285\t// The name is all there is to go on. talaria cannot tell a token the user typed\n286\t// into --header from an ordinary string by looking at the string, and §5a's\n287\t// answer is that it does not have to: the name decides, whether the value came\n288\t// from a spec's security scheme, a profile, a bound parameter or the flag.\n289\tfunc hide(pairs []Pair) []Pair {\n290\t\t// A nil *Redactor is the built-in list, which is the whole point here: the\n291\t\t// user-extensible patterns are a display concern the config file adds\n292\t\t// downstream, and this floor is not configurable.\n293\t\tvar builtin *secret.Redactor\n294\t\n295\t\tfor i, p := range pairs {\n296\t\t\tif !p.Value.IsSecret() && builtin.IsSensitive(p.Name) {\n297\t\t\t\tpairs[i].Value = p.Value.Sensitive()\n298\t\t\t}\n299\t\t}\n300\t\n301\t\treturn pairs\n302\t}\n303\t\n304\t// pairs parses repeatable name=value flags. Only the first = separates, because\n305\t// header and query values legitimately contain more.\n306\tfunc (b *binder) pairs(raws []string, flag string) []Pair {\n307\t\tout := make([]Pair, 0, len(raws))\n308\t\tfor _, raw := range raws {\n309\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n310\t\t\tif !ok || name == \"\" {\n311\t\t\t\tb.fail(\"%s %q is not name=value\", flag, raw)\n312\t\t\t\tcontinue\n313\t\t\t}\n314\t\n315\t\t\tout = append(out, Pair{Name: name, Value: Literal(value)})\n316\t\t}\n317\t\n318\t\treturn out\n319\t}\n320\t\n321\t// credentials puts each resolved credential where its scheme says it goes, as a\n322\t// reference. This is the §5a boundary: what lands on the request is the name of\n323\t// a credential and how to encode it, never the credential.\n324\tfunc (b *binder) credentials(req *Request) {\n325\t\tfor _, cred := range b.in.Creds {\n326\t\t\tpair := Pair{Name: cred.Name, Value: Secret(cred.Ref, encodingFor(cred.Kind))}\n327\t\n328\t\t\tswitch cred.In {\n329\t\t\tcase inHeader:\n330\t\t\t\treq.Headers = append(req.Headers, pair)\n331\t\t\tcase inQuery:\n332\t\t\t\treq.Query = append(req.Query, pair)\n333\t\t\tcase inCookie:\n334\t\t\t\treq.Cookies = append(req.Cookies, pair)\n335\t\t\tdefault:\n336\t\t\t\tb.fail(\"scheme %q wants its credential in %q, which is not a place a request has\",\n337\t\t\t\t\tcred.Scheme, cred.In)\n338\t\t\t}\n339\t\t}\n340\t}\n341\t\n342\tfunc encodingFor(kind config.Kind) Encoding {\n343\t\tswitch kind {\n344\t\tcase config.KindBearer:\n345\t\t\treturn EncodeBearer\n346\t\tcase config.KindBasic:\n347\t\t\treturn EncodeBasic\n348\t\tdefault:\n349\t\t\treturn EncodeRaw\n350\t\t}\n351\t}\n352\t\n353\t// declaredNames lists the parameters the operation accepts, for the\n354\t// valid_alternatives an agent corrects itself from.\n355\tfunc declaredNames(op operation.Operation) []string {\n356\t\tnames := make([]string, 0, len(op.Params))\n357\t\tfor _, p := range op.Params {\n358\t\t\tnames = append(names, p.Name)\n359\t\t}\n360\t\n361\t\treturn names\n362\t}\n363\t\n364\t// operationName is the operation's ID, falling back to method and path for a\n365\t// spec that sets no operationId.\n366\tfunc operationName(op operation.Operation) string {\n367\t\tif op.ID != \"\" {\n368\t\t\treturn op.ID\n369\t\t}\n370\t\n371\t\treturn op.Method + \" \" + op.Path\n372\t}\n373\t"
      }
