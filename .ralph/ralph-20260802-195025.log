        "type": "tool_result",
        "content": "1\t// Package curl turns a bound request into curl: the displayable command\n2\t// `--dry-run` prints and every executed call reports, the config document curl\n3\t// actually reads, and the executor that spawns it (DESIGN.md §3.4).\n4\t//\n5\t// This file is symbolic. It reads request.Value's Symbolic and redacted forms\n6\t// and never calls SecretRef.Resolve, so an emitted command references\n7\t// $TALARIA_AUTH_BEARER rather than a token: \"runnable in a shell where the env\n8\t// var is set, useless to exfiltrate\" (§5a). Resolution happens in exactly one\n9\t// place, config.go's resolve, and nothing outside this package can reach it.\n10\tpackage curl\n11\t\n12\timport (\n13\t\t\"net/http\"\n14\t\t\"net/url\"\n15\t\t\"regexp\"\n16\t\t\"strings\"\n17\t\n18\t\t\"github.com/Teeeep/talaria/internal/request\"\n19\t)\n20\t\n21\t// Render returns the curl command that reproduces req: a portable, symbolic\n22\t// reproduction for bug reports, docs and scripts (§3.4).\n23\t//\n24\t// The URL comes last, the way the design's sketch and most hand-written curl\n25\t// put it, so a reader sees what is being called without scanning past the\n26\t// flags.\n27\tfunc Render(req *request.Request) string {\n28\t\tif req == nil {\n29\t\t\treturn \"\"\n30\t\t}\n31\t\n32\t\targs := []string{\"curl\", \"-s\"}\n33\t\tswitch {\n34\t\t// -I rather than -X HEAD, matching the config document: pasted, -X HEAD waits\n35\t\t// for a body the server never sends, so the reproduction would hang where the\n36\t\t// call it reproduces did not.\n37\t\tcase strings.EqualFold(req.Method, http.MethodHead):\n38\t\t\targs = append(args, \"-I\")\n39\t\t// GET is curl's default and naming it adds noise; anything else is worth\n40\t\t// seeing, and for a mutation it is the most important token in the line.\n41\t\tcase req.Method != \"\" && !strings.EqualFold(req.Method, http.MethodGet):\n42\t\t\targs = append(args, \"-X\", req.Method)\n43\t\t}\n44\t\n45\t\targs = append(args, headerArgs(req)...)\n46\t\tif cookies := cookieWord(req); cookies != nil {\n47\t\t\targs = append(args, \"-b\", cookies.String())\n48\t\t}\n49\t\targs = append(args, bodyArgs(req)...)\n50\t\targs = append(args, urlWord(req, request.Value.Symbolic).String())\n51\t\n52\t\treturn strings.Join(args, \" \")\n53\t}\n54\t\n55\t// URL renders req's URL the way a reader consumes it: percent-encoded like the\n56\t// wire form, but with credentials shown as <redacted:env:NAME> rather than\n57\t// percent-encoded into illegibility. It is what the `request.url` field of\n58\t// call's output carries (§5a: symbolic in emitted curl, redacted in output URL\n59\t// fields).\n60\t//\n61\t// request.Request.URL is the wire-correct counterpart, and is what the executor\n62\t// uses once it has resolved the credentials.\n63\tfunc URL(req *request.Request) string {\n64\t\tif req == nil {\n65\t\t\treturn \"\"\n66\t\t}\n67\t\n68\t\treturn urlWord(req, request.Value.String).plain()\n69\t}\n70\t\n71\t// headerArgs renders the request headers, with basic auth diverted to curl's\n72\t// own -u.\n73\tfunc headerArgs(req *request.Request) []string {\n74\t\tvar args []string\n75\t\tfor _, h := range req.Headers {\n76\t\t\t// A basic-auth header's text is base64(user:password), which cannot be\n77\t\t\t// produced without the credential. -u takes the raw user:password, so\n78\t\t\t// the command stays symbolic and still works when it is pasted.\n79\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n80\t\t\t\targs = append(args, \"-u\", (&word{}).credential(h.Value.Ref().Symbolic(), h.Value).String())\n81\t\t\t\tcontinue\n82\t\t\t}\n83\t\n84\t\t\targs = append(args, \"-H\", (&word{}).literal(h.Name+\": \").value(h.Value).String())\n85\t\t}\n86\t\n87\t\treturn args\n88\t}\n89\t\n90\t// cookieWord renders every cookie into one -b argument. curl keeps only the\n91\t// last -b of several, so the cookies are joined rather than repeated.\n92\tfunc cookieWord(req *request.Request) *word {\n93\t\tif len(req.Cookies) == 0 {\n94\t\t\treturn nil\n95\t\t}\n96\t\n97\t\tw := &word{}\n98\t\tfor i, c := range req.Cookies {\n99\t\t\tif i > 0 {\n100\t\t\t\tw.literal(\"; \")\n101\t\t\t}\n102\t\t\tw.literal(c.Name + \"=\").value(c.Value)\n103\t\t}\n104\t\n105\t\treturn w\n106\t}\n107\t\n108\t// bodyArgs renders the request body and the content type that describes it.\n109\t// --data-raw rather than --data or --data-binary, matching the config document\n110\t// for the same reason (config.go's body): those two read a value starting with\n111\t// @ as a filename, so the emitted command would read a local file and send it\n112\t// to the API where the call sent the text. --data also strips newlines, which\n113\t// changes the bytes a signed or whitespace-sensitive payload carries.\n114\tfunc bodyArgs(req *request.Request) []string {\n115\t\tif req.Body == nil {\n116\t\t\treturn nil\n117\t\t}\n118\t\n119\t\tvar args []string\n120\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n121\t\t\targs = append(args, \"-H\", (&word{}).literal(\"Content-Type: \"+req.Body.ContentType).String())\n122\t\t}\n123\t\n124\t\treturn append(args, \"--data-raw\", (&word{}).literal(string(req.Body.Data)).String())\n125\t}\n126\t\n127\tfunc hasHeader(req *request.Request, name string) bool {\n128\t\tfor _, h := range req.Headers {\n129\t\t\tif strings.EqualFold(h.Name, name) {\n130\t\t\t\treturn true\n131\t\t\t}\n132\t\t}\n133\t\n134\t\treturn false\n135\t}\n136\t\n137\t// urlWord builds the request URL as one shell word. render chooses how a\n138\t// credential in the query string appears — Symbolic for the emitted command,\n139\t// String for the redacted display form.\n140\t//\n141\t// Literal values are percent-encoded here rather than by request.QueryString\n142\t// because a percent-encoded $NAME would no longer be a reference the shell can\n143\t// expand. Encoding per value, instead of over the finished string, is what lets\n144\t// the two live in one URL.\n145\tfunc urlWord(req *request.Request, render func(request.Value) string) *word {\n146\t\tw := (&word{}).literal(req.BaseURL + req.Path)\n147\t\n148\t\tfor i, q := range req.Query {\n149\t\t\tseparator := \"&\"\n150\t\t\tif i == 0 {\n151\t\t\t\tseparator = \"?\"\n152\t\t\t}\n153\t\t\tw.literal(separator + url.QueryEscape(q.Name) + \"=\")\n154\t\n155\t\t\t// Sensitive rather than secret: a literal hidden by name has no value to\n156\t\t\t// render here either, and percent-encoding its placeholder would print\n157\t\t\t// %3Credacted%3E where a reader expects <redacted>. Skipping the encode\n158\t\t\t// is safe because render is Symbolic or String — display forms, never a\n159\t\t\t// resolving renderer.\n160\t\t\tif q.Value.IsSensitive() {\n161\t\t\t\tw.credential(render(q.Value), q.Value)\n162\t\t\t\tcontinue\n163\t\t\t}\n164\t\t\tw.literal(url.QueryEscape(q.Value.String()))\n165\t\t}\n166\t\n167\t\treturn w\n168\t}\n169\t\n170\t// shellName matches an environment variable name a shell will expand from a\n171\t// bare $NAME. A ref whose name is not one of these is rendered redacted\n172\t// instead: an emitted command that stops being copy-pasteable is a better\n173\t// outcome than one that expands into something unintended.\n174\tvar shellName = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\n175\t\n176\t// part is one piece of a shell word. expand marks the pieces the shell is\n177\t// meant to act on — the credential references, and nothing else.\n178\ttype part struct {\n179\t\ttext   string\n180\t\texpand bool\n181\t}\n182\t\n183\t// word is one argument of the rendered command, assembled from literal text and\n184\t// credential references.\n185\t//\n186\t// The quoting rule follows from what each word contains. A word of pure literal\n187\t// text is single-quoted, which needs no escaping beyond the quote itself and\n188\t// leaves every $ and backtick inert. A word carrying a reference has to be\n189\t// double-quoted so the shell expands it, so its literal parts are escaped\n190\t// against the four characters double quotes still interpret.\n191\ttype word struct{ parts []part }\n192\t\n193\tfunc (w *word) literal(s string) *word {\n194\t\tif s != \"\" {\n195\t\t\tw.parts = append(w.parts, part{text: s})\n196\t\t}\n197\t\n198\t\treturn w\n199\t}\n200\t\n201\t// value appends a request value: the reference symbolically, or the literal\n202\t// text for a literal value.\n203\tfunc (w *word) value(v request.Value) *word {\n204\t\tif v.IsSecret() {\n205\t\t\treturn w.credential(v.Symbolic(), v)\n206\t\t}\n207\t\n208\t\treturn w.literal(v.String())\n209\t}\n210\t\n211\t// credential appends a rendered credential, marking it for expansion only when\n212\t// the shell can actually expand it back into the value. A basic-auth value, a\n213\t// redacted rendering, or a ref from a source that is not the environment all\n214\t// render as inert text.\n215\tfunc (w *word) credential(rendered string, v request.Value) *word {\n216\t\tif rendered == v.String() || !shellName.MatchString(v.Ref().Name) {\n217\t\t\treturn w.literal(rendered)\n218\t\t}\n219\t\n220\t\tw.parts = append(w.parts, part{text: rendered, expand: true})\n221\t\n222\t\treturn w\n223\t}\n224\t\n225\t// plain returns the word's text with no quoting, for the display fields that\n226\t// are read rather than run.\n227\tfunc (w *word) plain() string {\n228\t\tvar b strings.Builder\n229\t\tfor _, p := range w.parts {\n230\t\t\tb.WriteString(p.text)\n231\t\t}\n232\t\n233\t\treturn b.String()\n234\t}\n235\t\n236\t// String returns the word quoted for a shell.\n237\tfunc (w *word) String() string {\n238\t\texpands := false\n239\t\tfor _, p := range w.parts {\n240\t\t\tif p.expand {\n241\t\t\t\texpands = true\n242\t\t\t\tbreak\n243\t\t\t}\n244\t\t}\n245\t\n246\t\tif !expands {\n247\t\t\treturn \"'\" + strings.ReplaceAll(w.plain(), \"'\", `'\\''`) + \"'\"\n248\t\t}\n249\t\n250\t\tvar b strings.Builder\n251\t\tb.WriteByte('\"')\n252\t\tfor _, p := range w.parts {\n253\t\t\tif p.expand {\n254\t\t\t\tb.WriteString(p.text)\n255\t\t\t\tcontinue\n256\t\t\t}\n257\t\t\tb.WriteString(escapeInDoubleQuotes(p.text))\n258\t\t}\n259\t\tb.WriteByte('\"')\n260\t\n261\t\treturn b.String()\n262\t}\n263\t\n264\t// doubleQuoted escapes the characters a shell still interprets inside double\n265\t// quotes: command substitution, variable expansion, the quote itself and the\n266\t// escape.\n267\tvar doubleQuoted = strings.NewReplacer(\n268\t\t`\\`, `\\\\`,\n269\t\t`\"`, `\\\"`,\n270\t\t\"`\", \"\\\\`\",\n271\t\t`$`, `\\$`,\n272\t)\n273\t\n274\tfunc escapeInDoubleQuotes(s string) string { return doubleQuoted.Replace(s) }\n275\t"
      }
