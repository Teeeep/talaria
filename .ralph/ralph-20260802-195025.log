          "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"path/filepath\"\n\t\"strings\"\n\t\"syscall\"\n\t\"time\"\n)\n\nfunc curlProcs() []string {\n\tvar out []string\n\tentries, _ := os.ReadDir(\"/proc\")\n\tfor _, e := range entries {\n\t\tif !e.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tb, err := os.ReadFile(filepath.Join(\"/proc\", e.Name(), \"cmdline\"))\n\t\tif err != nil {\n\t\t\tcontinue\n\t\t}\n\t\ts := strings.ReplaceAll(string(b), \"\\x00\", \" \")\n\t\tif strings.Contains(s, \"curl -K -\") {\n\t\t\tppid := \"?\"\n\t\t\tst, err := os.ReadFile(filepath.Join(\"/proc\", e.Name(), \"stat\"))\n\t\t\tif err == nil {\n\t\t\t\tf := strings.Fields(string(st))\n\t\t\t\tif len(f) > 3 {\n\t\t\t\t\tppid = f[3]\n\t\t\t\t}\n\t\t\t}\n\t\t\tout = append(out, fmt.Sprintf(\"pid=%s ppid=%s cmd=%s\", e.Name(), ppid, strings.TrimSpace(s)))\n\t\t}\n\t}\n\treturn out\n}\n\nfunc listTmp(dir string) []string {\n\tvar out []string\n\tentries, _ := os.ReadDir(dir)\n\tfor _, e := range entries {\n\t\tout = append(out, e.Name())\n\t\tif e.IsDir() {\n\t\t\tsub, _ := os.ReadDir(filepath.Join(dir, e.Name()))\n\t\t\tfor _, s := range sub {\n\t\t\t\tfi, _ := s.Info()\n\t\t\t\tsz := int64(-1)\n\t\t\t\tif fi != nil {\n\t\t\t\t\tsz = fi.Size()\n\t\t\t\t}\n\t\t\t\tout = append(out, fmt.Sprintf(\"   %s/%s (%d bytes)\", e.Name(), s.Name(), sz))\n\t\t\t}\n\t\t}\n\t}\n\treturn out\n}\n\nfunc main() {\n\tsig := syscall.SIGTERM\n\tif len(os.Args) > 1 && os.Args[1] == \"int\" {\n\t\tsig = syscall.SIGINT\n\t}\n\n\ttmp := \"/tmp/talrev/tmp\"\n\tos.RemoveAll(tmp)\n\tos.MkdirAll(tmp, 0o755)\n\n\tcmd := exec.Command(\"/tmp/talaria-rev\", \"call\", \"/tmp/talrev/spec.yaml\", \"getSlow\", \"--timeout\", \"120\")\n\tcmd.Env = append(os.Environ(), \"TMPDIR=\"+tmp, \"XDG_STATE_HOME=/tmp/talrev/state\")\n\tcmd.Stdout = os.Stdout\n\tcmd.Stderr = os.Stderr\n\tif err := cmd.Start(); err != nil {\n\t\tpanic(err)\n\t}\n\tfmt.Println(\"talaria pid:\", cmd.Process.Pid)\n\n\ttime.Sleep(3 * time.Second)\n\tfmt.Println(\"BEFORE curl procs:\", curlProcs())\n\tfmt.Println(\"BEFORE tmp:\", listTmp(tmp))\n\n\tfmt.Println(\"sending\", sig, \"to talaria only\")\n\tcmd.Process.Signal(sig)\n\tcmd.Wait()\n\tfmt.Println(\"talaria exited:\", cmd.ProcessState)\n\n\ttime.Sleep(2 * time.Second)\n\tfmt.Println(\"AFTER curl procs:\", curlProcs())\n\tfmt.Println(\"AFTER tmp:\", listTmp(tmp))\n\n\ttime.Sleep(3 * time.Second)\n\tfmt.Println(\"AFTER+5s curl procs:\", curlProcs())\n\tfmt.Println(\"AFTER+5s tmp:\", listTmp(tmp))\n}\n"
