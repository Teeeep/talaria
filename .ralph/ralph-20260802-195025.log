          "content": "package corpus\n\nimport (\n\t\"sync\"\n\t\"testing\"\n)\n\n// Probe: concurrent Append (two talaria processes / goroutines sharing a store)\n// once the per-source cap is in play. trim() is a read-modify-write over the\n// whole file with no lock, so entries written between its ReadFile and its\n// Rename are silently discarded.\nfunc TestProbeConcurrentAppendLosesEntries(t *testing.T) {\n\tdir := t.TempDir()\n\tt.Setenv(EnvHistory, \"\")\n\n\ts := New(dir, true)\n\n\t// Seed to just under the cap so every concurrent append triggers a trim.\n\tconst seed = maxPerSource - 1\n\tfor i := 0; i < seed; i++ {\n\t\tif err := s.Append(Entry{Source: SourceCall}); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t}\n\n\tconst writers = 8\n\tconst each = 10\n\tvar wg sync.WaitGroup\n\tfor w := 0; w < writers; w++ {\n\t\twg.Add(1)\n\t\tgo func() {\n\t\t\tdefer wg.Done()\n\t\t\tfor i := 0; i < each; i++ {\n\t\t\t\t_ = s.Append(Entry{Source: SourceCall})\n\t\t\t}\n\t\t}()\n\t}\n\twg.Wait()\n\n\tentries, err := s.Read()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tt.Logf(\"appended %d, cap %d, file holds %d\", seed+writers*each, maxPerSource, len(entries))\n\tif len(entries) != maxPerSource {\n\t\tt.Errorf(\"LOST/EXTRA ENTRIES: want exactly %d retained, got %d\", maxPerSource, len(entries))\n\t}\n}\n"
        },
        "caller": {
