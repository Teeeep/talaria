        "type": "tool_result",
        "content": "1\t//go:build unix\n2\t\n3\tpackage corpus\n4\t\n5\timport (\n6\t\t\"fmt\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"syscall\"\n10\t)\n11\t\n12\t// lock takes the exclusive advisory lock covering the history file at path and\n13\t// returns the call that releases it.\n14\t//\n15\t// The lock lives on a sibling file rather than on the store itself because trim\n16\t// replaces the store by rename. A descriptor held on the store would end up\n17\t// guarding an inode that is no longer at that path, and the next appender would\n18\t// open the new one and find no contention at all. The sibling is never renamed,\n19\t// so every appender contends on the same inode.\n20\t//\n21\t// The lock is advisory and per open file description, so goroutines sharing a\n22\t// Store serialise against each other exactly as separate talaria processes do.\n23\tfunc lock(path string) (func(), error) {\n24\t\tif err := os.MkdirAll(filepath.Dir(path), dirMode); err != nil {\n25\t\t\treturn nil, fmt.Errorf(\"cannot create the history directory: %w\", err)\n26\t\t}\n27\t\n28\t\tf, err := os.OpenFile(path+lockSuffix, os.O_CREATE|os.O_RDWR, fileMode)\n29\t\tif err != nil {\n30\t\t\treturn nil, fmt.Errorf(\"cannot open the history lock: %w\", err)\n31\t\t}\n32\t\n33\t\t// LOCK_EX without LOCK_NB: an append that has to wait for another writer is\n34\t\t// correct, and one that gave up would drop history the caller was told had\n35\t\t// been recorded, which is the bug this lock exists to prevent.\n36\t\tif err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX); err != nil {\n37\t\t\tf.Close() //nolint:errcheck // The Flock failure is the one worth reporting.\n38\t\t\treturn nil, fmt.Errorf(\"cannot lock the history file: %w\", err)\n39\t\t}\n40\t\n41\t\treturn func() {\n42\t\t\t// Close alone would release the lock; the unlock is spelled out so the\n43\t\t\t// release does not rest on that being remembered.\n44\t\t\tsyscall.Flock(int(f.Fd()), syscall.LOCK_UN) //nolint:errcheck // The Close below releases it either way.\n45\t\t\tf.Close()                                   //nolint:errcheck // Nothing was written through this descriptor.\n46\t\t}, nil\n47\t}\n48\t"
      }
    ]
