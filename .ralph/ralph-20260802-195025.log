        "type": "tool_result",
        "content": "1\topenapi: 3.0.3\n2\tinfo:\n3\t  title: Talaria E2E API\n4\t  version: 1.0.0\n5\tservers:\n6\t  # Unroutable on purpose: every case passes --base-url at the test server, so\n7\t  # a step that ignored it would fail here rather than reach the network.\n8\t  - url: https://api.invalid/v1\n9\tcomponents:\n10\t  schemas:\n11\t    Pet:\n12\t      type: object\n13\t      required: [id, name]\n14\t      properties:\n15\t        id:\n16\t          type: string\n17\t        name:\n18\t          type: string\n19\t  securitySchemes:\n20\t    bearerAuth:\n21\t      type: http\n22\t      scheme: bearer\n23\t    secureKey:\n24\t      type: apiKey\n25\t      in: header\n26\t      name: X-Secure-Key\n27\t# Document-level, so every operation below needs the bearer token unless it\n28\t# names its own scheme. The canary rides in on this one.\n29\tsecurity:\n30\t  - bearerAuth: []\n31\tpaths:\n32\t  /pets:\n33\t    get:\n34\t      operationId: listPets\n35\t      summary: List every pet in the store\n36\t      tags: [pets]\n37\t      responses:\n38\t        \"200\":\n39\t          description: The pets\n40\t          content:\n41\t            application/json:\n42\t              schema:\n43\t                type: array\n44\t                items:\n45\t                  $ref: \"#/components/schemas/Pet\"\n46\t    post:\n47\t      operationId: createPet\n48\t      summary: Create a pet\n49\t      tags: [pets]\n50\t      requestBody:\n51\t        required: true\n52\t        content:\n53\t          application/json:\n54\t            schema:\n55\t              type: object\n56\t              required: [name]\n57\t              properties:\n58\t                name:\n59\t                  type: string\n60\t      responses:\n61\t        \"201\":\n62\t          description: Created\n63\t          content:\n64\t            application/json:\n65\t              schema:\n66\t                $ref: \"#/components/schemas/Pet\"\n67\t  /pets/{petId}:\n68\t    get:\n69\t      operationId: getPet\n70\t      summary: Fetch one pet by id\n71\t      tags: [pets]\n72\t      parameters:\n73\t        # The example is what `run` fills the path template with; without it\n74\t        # the operation would be skipped rather than called.\n75\t        - name: petId\n76\t          in: path\n77\t          required: true\n78\t          schema:\n79\t            type: string\n80\t            example: \"42\"\n81\t      responses:\n82\t        \"200\":\n83\t          description: The pet\n84\t          content:\n85\t            application/json:\n86\t              schema:\n87\t                $ref: \"#/components/schemas/Pet\"\n88\t  /broken:\n89\t    get:\n90\t      operationId: getBroken\n91\t      summary: Answers 200 with a body that violates the contract\n92\t      tags: [ops]\n93\t      responses:\n94\t        \"200\":\n95\t          description: A pet\n96\t          content:\n97\t            application/json:\n98\t              schema:\n99\t                $ref: \"#/components/schemas/Pet\"\n100\t  /secure:\n101\t    get:\n102\t      operationId: getSecure\n103\t      summary: Needs a credential this suite never sets\n104\t      tags: [secure]\n105\t      security:\n106\t        - secureKey: []\n107\t      responses:\n108\t        \"200\":\n109\t          description: A pet\n110\t          content:\n111\t            application/json:\n112\t              schema:\n113\t                $ref: \"#/components/schemas/Pet\"\n114\t"
