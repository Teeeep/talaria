        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"go/ast\"\n5\t\t\"go/parser\"\n6\t\t\"go/token\"\n7\t\t\"os\"\n8\t\t\"regexp\"\n9\t\t\"strconv\"\n10\t\t\"strings\"\n11\t\t\"testing\"\n12\t\n13\t\t\"github.com/spf13/cobra\"\n14\t\n15\t\t\"github.com/Teeeep/talaria/internal/config\"\n16\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n17\t\t\"github.com/Teeeep/talaria/internal/spec\"\n18\t)\n19\t\n20\t// AGENT.md is the operating manual for the one reader who cannot check the\n21\t// source when the manual is wrong (DESIGN.md §3.7). These tests hold the three\n22\t// facts a model will act on directly — exit codes, command names, credential\n23\t// variable names — against the code that implements them, so the doc fails the\n24\t// build rather than drifting.\n25\t\n26\tconst agentDocPath = \"../../AGENT.md\"\n27\tconst clierrPath = \"../../internal/clierr/clierr.go\"\n28\t\n29\tfunc TestAgentDocDocumentsEveryExitCode(t *testing.T) {\n30\t\tdoc := readAgentDoc(t)\n31\t\n32\t\tdocumented := documentedExitCodes(t, doc)\n33\t\timplemented := implementedExitCodes(t)\n34\t\n35\t\tfor code, name := range implemented {\n36\t\t\tif !documented[code] {\n37\t\t\t\tt.Errorf(\"clierr.%s is exit code %d and AGENT.md's table does not list it\", name, code)\n38\t\t\t}\n39\t\t}\n40\t\tfor code := range documented {\n41\t\t\tif _, ok := implemented[code]; !ok {\n42\t\t\t\tt.Errorf(\"AGENT.md documents exit code %d, which no clierr constant defines\", code)\n43\t\t\t}\n44\t\t}\n45\t}\n46\t\n47\tfunc TestAgentDocDocumentsEveryCommand(t *testing.T) {\n48\t\tdoc := readAgentDoc(t)\n49\t\n50\t\tfor _, path := range commandPaths(newRootCmd()) {\n51\t\t\tif !strings.Contains(doc, path) {\n52\t\t\t\tt.Errorf(\"`%s` is a registered command and AGENT.md never names it\", path)\n53\t\t\t}\n54\t\t}\n55\t}\n56\t\n57\tfunc TestAgentDocNamesOnlyRegisteredCommands(t *testing.T) {\n58\t\troot := newRootCmd()\n59\t\n60\t\tfor _, invocation := range docInvocations(readAgentDoc(t)) {\n61\t\t\tif err := resolves(root, invocation); err != \"\" {\n62\t\t\t\tt.Errorf(\"AGENT.md shows `%s`: %s\", invocation, err)\n63\t\t\t}\n64\t\t}\n65\t}\n66\t\n67\tfunc TestAgentDocNamesOnlyRealEnvVars(t *testing.T) {\n68\t\t// The doc's whole job on this subject is to tell an agent which variable to\n69\t\t// ask a human to export. A name that no code reads sends that human to set\n70\t\t// something that will never be looked at.\n71\t\tknown := map[string]bool{\n72\t\t\tspec.EnvSpec:      true,\n73\t\t\tcorpus.EnvHistory: true,\n74\t\t\tconfig.EnvBearer:  true,\n75\t\t\tconfig.EnvBasic:   true,\n76\t\t}\n77\t\n78\t\tfor _, name := range regexp.MustCompile(`TALARIA_[A-Z0-9_]*`).FindAllString(readAgentDoc(t), -1) {\n79\t\t\tif known[name] || strings.HasPrefix(name, config.EnvAPIKeyPrefix) {\n80\t\t\t\tcontinue\n81\t\t\t}\n82\t\n83\t\t\tt.Errorf(\"AGENT.md names $%s, which talaria never reads\", name)\n84\t\t}\n85\t}\n86\t\n87\tfunc readAgentDoc(t *testing.T) string {\n88\t\tt.Helper()\n89\t\n90\t\tbody, err := os.ReadFile(agentDocPath)\n91\t\tif err != nil {\n92\t\t\tt.Fatalf(\"reading AGENT.md: %v\", err)\n93\t\t}\n94\t\n95\t\treturn string(body)\n96\t}\n97\t\n98\t// exitCodeRow matches a markdown table row whose first cell is a bare integer,\n99\t// which is the shape of the exit-code table and of nothing else in the doc.\n100\tvar exitCodeRow = regexp.MustCompile(`(?m)^\\|\\s*(\\d+)\\s*\\|`)\n101\t\n102\tfunc documentedExitCodes(t *testing.T, doc string) map[int]bool {\n103\t\tt.Helper()\n104\t\n105\t\tcodes := map[int]bool{}\n106\t\tfor _, match := range exitCodeRow.FindAllStringSubmatch(doc, -1) {\n107\t\t\tcode, err := strconv.Atoi(match[1])\n108\t\t\tif err != nil {\n109\t\t\t\tt.Fatalf(\"parsing exit-code row %q: %v\", match[0], err)\n110\t\t\t}\n111\t\t\tcodes[code] = true\n112\t\t}\n113\t\n114\t\tif len(codes) == 0 {\n115\t\t\tt.Fatal(\"AGENT.md has no exit-code table\")\n116\t\t}\n117\t\n118\t\treturn codes\n119\t}\n120\t\n121\t// implementedExitCodes reads the clierr.Code constants out of the source rather\n122\t// than listing them here: a test that names them would itself be a second copy\n123\t// of the contract, drifting alongside the doc it is meant to police.\n124\tfunc implementedExitCodes(t *testing.T) map[int]string {\n125\t\tt.Helper()\n126\t\n127\t\tfile, err := parser.ParseFile(token.NewFileSet(), clierrPath, nil, 0)\n128\t\tif err != nil {\n129\t\t\tt.Fatalf(\"parsing %s: %v\", clierrPath, err)\n130\t\t}\n131\t\n132\t\tcodes := map[int]string{}\n133\t\tfor _, decl := range file.Decls {\n134\t\t\tgen, ok := decl.(*ast.GenDecl)\n135\t\t\tif !ok || gen.Tok != token.CONST {\n136\t\t\t\tcontinue\n137\t\t\t}\n138\t\n139\t\t\tfor _, s := range gen.Specs {\n140\t\t\t\tspec, ok := s.(*ast.ValueSpec)\n141\t\t\t\tif !ok {\n142\t\t\t\t\tcontinue\n143\t\t\t\t}\n144\t\t\t\tif ident, ok := spec.Type.(*ast.Ident); !ok || ident.Name != \"Code\" {\n145\t\t\t\t\tcontinue\n146\t\t\t\t}\n147\t\n148\t\t\t\tfor i, name := range spec.Names {\n149\t\t\t\t\tlit, ok := spec.Values[i].(*ast.BasicLit)\n150\t\t\t\t\tif !ok || lit.Kind != token.INT {\n151\t\t\t\t\t\tt.Fatalf(\"clierr.%s is not a literal exit code\", name.Name)\n152\t\t\t\t\t}\n153\t\n154\t\t\t\t\tvalue, err := strconv.Atoi(lit.Value)\n155\t\t\t\t\tif err != nil {\n156\t\t\t\t\t\tt.Fatalf(\"parsing clierr.%s = %s: %v\", name.Name, lit.Value, err)\n157\t\t\t\t\t}\n158\t\t\t\t\tcodes[value] = name.Name\n159\t\t\t\t}\n160\t\t\t}\n161\t\t}\n162\t\n163\t\tif len(codes) == 0 {\n164\t\t\tt.Fatalf(\"found no Code constants in %s\", clierrPath)\n165\t\t}\n166\t\n167\t\treturn codes\n168\t}\n169\t\n170\t// commandPaths lists every invocable command in the tree as it would be typed,\n171\t// e.g. \"talaria auth check\". A command with subcommands and no Run of its own —\n172\t// `auth` — is a namespace rather than something to document.\n173\tfunc commandPaths(root *cobra.Command) []string {\n174\t\tvar paths []string\n175\t\n176\t\tvar walk func(cmd *cobra.Command)\n177\t\twalk = func(cmd *cobra.Command) {\n178\t\t\tif cmd.Runnable() {\n179\t\t\t\tpaths = append(paths, cmd.CommandPath())\n180\t\t\t}\n181\t\t\tfor _, child := range cmd.Commands() {\n182\t\t\t\twalk(child)\n183\t\t\t}\n184\t\t}\n185\t\twalk(root)\n186\t\n187\t\treturn paths\n188\t}\n189\t\n190\t// docInvocation matches a code span or fenced line beginning with the binary's\n191\t// name, which is how the doc shows a command.\n192\tvar docInvocation = regexp.MustCompile(\"(?m)(?:`|^\\\\s*)talaria ([^`\\n]+)\")\n193\t\n194\t// docInvocations extracts every `talaria …` the doc shows, so the reverse of\n195\t// TestAgentDocDocumentsEveryCommand can check that each one exists.\n196\tfunc docInvocations(doc string) []string {\n197\t\tvar out []string\n198\t\tfor _, match := range docInvocation.FindAllStringSubmatch(doc, -1) {\n199\t\t\tout = append(out, \"talaria \"+strings.TrimSpace(match[1]))\n200\t\t}\n201\t\n202\t\treturn out\n203\t}\n204\t\n205\t// resolves walks an invocation's leading words down the command tree and\n206\t// reports why it does not name a command, or \"\" when it does. Words stop being\n207\t// command names at the first flag, placeholder or path, which is where the\n208\t// arguments begin.\n209\tfunc resolves(root *cobra.Command, invocation string) string {\n210\t\tcmd := root\n211\t\tfor _, word := range strings.Fields(invocation)[1:] {\n212\t\t\tif strings.HasPrefix(word, \"-\") || strings.HasPrefix(word, \"<\") ||\n213\t\t\t\tstrings.HasPrefix(word, \"[\") || strings.HasPrefix(word, \"$\") ||\n214\t\t\t\tstrings.ContainsAny(word, \"/.=\") {\n215\t\t\t\tbreak\n216\t\t\t}\n217\t\n218\t\t\tchild := childNamed(cmd, word)\n219\t\t\tif child == nil {\n220\t\t\t\t// A word that names no subcommand is an argument once the command it\n221\t\t\t\t// follows can run — `history show 3` — and a mistake otherwise.\n222\t\t\t\tif cmd.Runnable() {\n223\t\t\t\t\tbreak\n224\t\t\t\t}\n225\t\n226\t\t\t\treturn \"`\" + word + \"` is not a subcommand of `\" + cmd.CommandPath() + \"`\"\n227\t\t\t}\n228\t\t\tcmd = child\n229\t\t}\n230\t\n231\t\tif cmd == root {\n232\t\t\treturn \"it names no command\"\n233\t\t}\n234\t\tif !cmd.Runnable() {\n235\t\t\treturn \"`\" + cmd.CommandPath() + \"` is a group of subcommands, not a command\"\n236\t\t}\n237\t\n238\t\treturn \"\"\n239\t}\n240\t\n241\tfunc childNamed(cmd *cobra.Command, name string) *cobra.Command {\n242\t\tfor _, child := range cmd.Commands() {\n243\t\t\tif child.Name() == name {\n244\t\t\t\treturn child\n245\t\t\t}\n246\t\t}\n247\t\n248\t\treturn nil\n249\t}\n250\t"
