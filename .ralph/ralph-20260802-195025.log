          "file_path": "/home/casper/projects/talaria/internal/curl/zz_probe_test.go",
          "content": "package curl\n\nimport (\n\t\"net/http\"\n\t\"net/http/httptest\"\n\t\"strings\"\n\t\"testing\"\n\t\"time\"\n\n\t\"github.com/Teeeep/talaria/internal/request\"\n)\n\n// Probe 1: a large response body must not deadlock the executor.\nfunc TestProbeLargeBody(t *testing.T) {\n\tpayload := strings.Repeat(\"x\", 32<<20) // 32 MiB\n\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\tfor i := 0; i < 200; i++ {\n\t\t\tw.Header().Add(\"X-Pad-\"+strings.Repeat(\"a\", i%40), strings.Repeat(\"b\", 200))\n\t\t}\n\t\tw.Write([]byte(payload))\n\t}))\n\tdefer srv.Close()\n\n\tdone := make(chan struct{})\n\tvar got int\n\tgo func() {\n\t\tdefer close(done)\n\t\tresp, err := Execute(&request.Request{Method: \"GET\", BaseURL: srv.URL, Path: \"/\"})\n\t\tif err != nil {\n\t\t\tt.Error(err)\n\t\t\treturn\n\t\t}\n\t\tgot = len(resp.Body)\n\t}()\n\n\tselect {\n\tcase <-done:\n\t\tt.Logf(\"large body returned %d bytes\", got)\n\tcase <-time.After(60 * time.Second):\n\t\tt.Fatal(\"DEADLOCK: Execute did not return for a 32MiB response\")\n\t}\n}\n\n// Probe 2: a server that accepts and never answers.\nfunc TestProbeHangingServer(t *testing.T) {\n\tsrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n\t\ttime.Sleep(90 * time.Second)\n\t}))\n\tdefer srv.Close()\n\n\tdone := make(chan struct{})\n\tstart := time.Now()\n\tgo func() {\n\t\tdefer close(done)\n\t\t_, err := Execute(&request.Request{Method: \"GET\", BaseURL: srv.URL, Path: \"/\"})\n\t\tt.Logf(\"returned after %s: %v\", time.Since(start), err)\n\t}()\n\n\tselect {\n\tcase <-done:\n\t\tt.Logf(\"Execute returned on its own after %s\", time.Since(start))\n\tcase <-time.After(25 * time.Second):\n\t\tt.Errorf(\"NO TIMEOUT: Execute still blocked after 25s against a non-responding server\")\n\t}\n}\n"
        },
        "caller": {
          "type": "direct"
        }
      }
    ],
