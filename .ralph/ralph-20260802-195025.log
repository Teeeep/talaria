        "tool_use_id": "toolu_016v6KJoRQFGeppesnQVaoDH",
        "type": "tool_result",
        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"strings\"\n5\t\t\"testing\"\n6\t\n7\t\t\"github.com/Teeeep/talaria/internal/request\"\n8\t\t\"github.com/Teeeep/talaria/internal/secret\"\n9\t)\n10\t\n11\t// canary is a value that must never appear in rendered output. Every test that\n12\t// exports a credential exports this one, so a leak fails a test rather than\n13\t// only being noticed in review.\n14\tconst canary = \"canary-4f8c1e-do-not-leak\"\n15\t\n16\t// bearerReq is a GET carrying a bearer token, the shape §3.4 uses as its\n17\t// example of symbolic rendering.\n18\tfunc bearerReq() *request.Request {\n19\t\treturn &request.Request{\n20\t\t\tOperationID: \"getPet\",\n21\t\t\tMethod:      \"GET\",\n22\t\t\tBaseURL:     \"https://api.example.com/v1\",\n23\t\t\tPath:        \"/pets/42\",\n24\t\t\tHeaders: []request.Pair{{\n25\t\t\t\tName:  \"Authorization\",\n26\t\t\t\tValue: request.Secret(secret.Env(\"TALARIA_AUTH_BEARER\"), request.EncodeBearer),\n27\t\t\t}},\n28\t\t}\n29\t}\n30\t\n31\t// assertNoCanary is the §5a invariant in one line: whatever else the renderer\n32\t// did, it did not print the credential.\n33\tfunc assertNoCanary(t *testing.T, got string) {\n34\t\tt.Helper()\n35\t\tif strings.Contains(got, canary) {\n36\t\t\tt.Fatalf(\"rendered curl contains the credential value:\\n%s\", got)\n37\t\t}\n38\t}\n39\t\n40\tfunc TestRenderReferencesBearerTokenByEnvVarName(t *testing.T) {\n41\t\tt.Setenv(\"TALARIA_AUTH_BEARER\", canary)\n42\t\n43\t\tgot := Render(bearerReq())\n44\t\n45\t\tconst want = `-H \"Authorization: Bearer $TALARIA_AUTH_BEARER\"`\n46\t\tif !strings.Contains(got, want) {\n47\t\t\tt.Errorf(\"Render() = %s\\nwant it to contain %s\", got, want)\n48\t\t}\n49\t\tassertNoCanary(t, got)\n50\t}\n51\t\n52\tfunc TestRenderReferencesQueryAPIKeyByEnvVarName(t *testing.T) {\n53\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_PETKEY\", canary)\n54\t\n55\t\treq := &request.Request{\n56\t\t\tMethod:  \"GET\",\n57\t\t\tBaseURL: \"https://api.example.com\",\n58\t\t\tPath:    \"/pets\",\n59\t\t\tQuery: []request.Pair{{\n60\t\t\t\tName:  \"api_key\",\n61\t\t\t\tValue: request.Secret(secret.Env(\"TALARIA_AUTH_APIKEY_PETKEY\"), request.EncodeRaw),\n62\t\t\t}},\n63\t\t}\n64\t\n65\t\tgot := Render(req)\n66\t\n67\t\t// $NAME rather than %24NAME: percent-encoding the reference would make the\n68\t\t// emitted command send the literal text instead of the credential.\n69\t\tconst want = `api_key=$TALARIA_AUTH_APIKEY_PETKEY`\n70\t\tif !strings.Contains(got, want) {\n71\t\t\tt.Errorf(\"Render() = %s\\nwant it to contain %s\", got, want)\n72\t\t}\n73\t\tassertNoCanary(t, got)\n74\t}\n75\t\n76\tfunc TestRenderReferencesCookieCredentialByEnvVarName(t *testing.T) {\n77\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_COOKIEKEY\", canary)\n78\t\n79\t\treq := &request.Request{\n80\t\t\tMethod:  \"GET\",\n81\t\t\tBaseURL: \"https://api.example.com\",\n82\t\t\tPath:    \"/pets\",\n83\t\t\tCookies: []request.Pair{\n84\t\t\t\t{Name: \"flavour\", Value: request.Literal(\"salty\")},\n85\t\t\t\t{\n86\t\t\t\t\tName:  \"session_id\",\n87\t\t\t\t\tValue: request.Secret(secret.Env(\"TALARIA_AUTH_APIKEY_COOKIEKEY\"), request.EncodeRaw),\n88\t\t\t\t},\n89\t\t\t},\n90\t\t}\n91\t\n92\t\tgot := Render(req)\n93\t\n94\t\tconst want = `-b \"flavour=salty; session_id=$TALARIA_AUTH_APIKEY_COOKIEKEY\"`\n95\t\tif !strings.Contains(got, want) {\n96\t\t\tt.Errorf(\"Render() = %s\\nwant it to contain %s\", got, want)\n97\t\t}\n98\t\tassertNoCanary(t, got)\n99\t}\n100\t\n101\tfunc TestRenderQuotesLiteralHeaderValues(t *testing.T) {\n102\t\treq := &request.Request{\n103\t\t\tMethod:  \"GET\",\n104\t\t\tBaseURL: \"https://api.example.com\",\n105\t\t\tPath:    \"/pets\",\n106\t\t\tHeaders: []request.Pair{\n107\t\t\t\t{Name: \"X-Note\", Value: request.Literal(`it's a \"test\" $HOME`)},\n108\t\t\t},\n109\t\t}\n110\t\n111\t\tgot := Render(req)\n112\t\n113\t\t// Single quotes need no escaping except for the quote itself, and they stop\n114\t\t// the shell expanding $HOME — the value is text the user gave, not a\n115\t\t// reference talaria made.\n116\t\tconst want = `-H 'X-Note: it'\\''s a \"test\" $HOME'`\n117\t\tif !strings.Contains(got, want) {\n118\t\t\tt.Errorf(\"Render() = %s\\nwant it to contain %s\", got, want)\n119\t\t}\n120\t}\n121\t\n122\tfunc TestRenderEscapesLiteralsSharingAWordWithACredential(t *testing.T) {\n123\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_PETKEY\", canary)\n124\t\n125\t\treq := &request.Request{\n126\t\t\tMethod:  \"GET\",\n127\t\t\tBaseURL: \"https://api.example.com\",\n128\t\t\tPath:    \"/pets\",\n129\t\t\tQuery: []request.Pair{\n130\t\t\t\t{Name: \"q\", Value: request.Literal(`$HOME \"x\"`)},\n131\t\t\t\t{Name: \"api_key\", Value: request.Secret(secret.Env(\"TALARIA_AUTH_APIKEY_PETKEY\"), request.EncodeRaw)},\n132\t\t\t},\n133\t\t}\n134\t\n135\t\tgot := Render(req)\n136\t\n137\t\t// The credential forces the URL into double quotes, so every other shell\n138\t\t// metacharacter in the same word has to be escaped or neutralised. The\n139\t\t// literal is percent-encoded by then, which is what does the neutralising.\n140\t\tif strings.Contains(got, `\"$HOME`) || strings.Contains(got, `$HOME\"`) {\n141\t\t\tt.Errorf(\"Render() left an unescaped $HOME inside a double-quoted word:\\n%s\", got)\n142\t\t}\n143\t\tif !strings.Contains(got, \"q=%24HOME+%22x%22\") {\n144\t\t\tt.Errorf(\"Render() = %s\\nwant the literal query value percent-encoded\", got)\n145\t\t}\n146\t\tassertNoCanary(t, got)\n147\t}\n148\t\n149\tfunc TestRenderPercentEncodesLiteralQueryValues(t *testing.T) {\n150\t\treq := &request.Request{\n151\t\t\tMethod:  \"GET\",\n152\t\t\tBaseURL: \"https://api.example.com\",\n153\t\t\tPath:    \"/pets\",\n154\t\t\tQuery:   []request.Pair{{Name: \"q\", Value: request.Literal(\"a b\")}},\n155\t\t}\n156\t\n157\t\tgot := Render(req)\n158\t\n159\t\tif !strings.Contains(got, \"q=a+b\") && !strings.Contains(got, \"q=a%20b\") {\n160\t\t\tt.Errorf(\"Render() = %s\\nwant the space in the query value encoded\", got)\n161\t\t}\n162\t}\n163\t\n164\tfunc TestRenderUsesDashUForBasicAuth(t *testing.T) {\n165\t\tt.Setenv(\"TALARIA_AUTH_BASIC\", canary)\n166\t\n167\t\treq := &request.Request{\n168\t\t\tMethod:  \"GET\",\n169\t\t\tBaseURL: \"https://api.example.com\",\n170\t\t\tPath:    \"/pets\",\n171\t\t\tHeaders: []request.Pair{{\n172\t\t\t\tName:  \"Authorization\",\n173\t\t\t\tValue: request.Secret(secret.Env(\"TALARIA_AUTH_BASIC\"), request.EncodeBasic),\n174\t\t\t}},\n175\t\t}\n176\t\n177\t\tgot := Render(req)\n178\t\n179\t\t// Basic auth's header text is base64(user:password), which cannot be built\n180\t\t// without the value. curl's -u takes the raw user:password, so the emitted\n181\t\t// command stays both symbolic and runnable.\n182\t\tconst want = `-u \"$TALARIA_AUTH_BASIC\"`\n183\t\tif !strings.Contains(got, want) {\n184\t\t\tt.Errorf(\"Render() = %s\\nwant it to contain %s\", got, want)\n185\t\t}\n186\t\tif strings.Contains(got, \"Authorization\") {\n187\t\t\tt.Errorf(\"Render() emitted an Authorization header for basic auth:\\n%s\", got)\n188\t\t}\n189\t\tassertNoCanary(t, got)\n190\t}\n191\t\n192\tfunc TestRenderNamesTheMethodAndBodyForAMutation(t *testing.T) {\n193\t\treq := &request.Request{\n194\t\t\tMethod:  \"POST\",\n195\t\t\tBaseURL: \"https://api.example.com\",\n196\t\t\tPath:    \"/pets\",\n197\t\t\tBody:    &request.Body{ContentType: \"application/json\", Data: []byte(`{\"name\":\"Rex\"}`)},\n198\t\t}\n199\t\n200\t\tgot := Render(req)\n201\t\n202\t\tfor _, want := range []string{\n203\t\t\t\"-X POST\",\n204\t\t\t`-H 'Content-Type: application/json'`,\n205\t\t\t`--data-binary '{\"name\":\"Rex\"}'`,\n206\t\t} {\n207\t\t\tif !strings.Contains(got, want) {\n208\t\t\t\tt.Errorf(\"Render() = %s\\nwant it to contain %s\", got, want)\n209\t\t\t}\n210\t\t}\n211\t}\n212\t\n213\tfunc TestRenderPutsTheURLLast(t *testing.T) {\n214\t\tgot := Render(bearerReq())\n215\t\n216\t\tif !strings.HasPrefix(got, \"curl -s \") {\n217\t\t\tt.Errorf(\"Render() = %s\\nwant it to start with `curl -s `\", got)\n218\t\t}\n219\t\tif !strings.HasSuffix(got, `'https://api.example.com/v1/pets/42'`) {\n220\t\t\tt.Errorf(\"Render() = %s\\nwant it to end with the quoted URL\", got)\n221\t\t}\n222\t}\n223\t\n224\tfunc TestURLShowsCredentialsRedacted(t *testing.T) {\n225\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_PETKEY\", canary)\n226\t\n227\t\treq := &request.Request{\n228\t\t\tMethod:  \"GET\",\n229\t\t\tBaseURL: \"https://api.example.com\",\n230\t\t\tPath:    \"/pets\",\n231\t\t\tQuery: []request.Pair{\n232\t\t\t\t{Name: \"q\", Value: request.Literal(\"a b\")},\n233\t\t\t\t{Name: \"api_key\", Value: request.Secret(secret.Env(\"TALARIA_AUTH_APIKEY_PETKEY\"), request.EncodeRaw)},\n234\t\t\t},\n235\t\t}\n236\t\n237\t\tgot := URL(req)\n238\t\n239\t\t// §5a: symbolic in emitted curl, <redacted> in the URL an agent reads.\n240\t\tconst want = \"https://api.example.com/pets?q=a+b&api_key=<redacted:env:TALARIA_AUTH_APIKEY_PETKEY>\"\n241\t\tif got != want {\n242\t\t\tt.Errorf(\"URL() = %q, want %q\", got, want)\n243\t\t}\n244\t\tassertNoCanary(t, got)\n245\t}\n246\t\n247\t// hiddenQueryReq is a GET whose api_key is a literal the user typed, hidden by\n248\t// name rather than resolved from a ref — the shape `--query api_key=…` builds.\n249\tfunc hiddenQueryReq() *request.Request {\n250\t\treturn &request.Request{\n251\t\t\tMethod:  \"GET\",\n252\t\t\tBaseURL: \"https://api.example.com\",\n253\t\t\tPath:    \"/pets\",\n254\t\t\tQuery: []request.Pair{\n255\t\t\t\t{Name: \"q\", Value: request.Literal(\"a b\")},\n256\t\t\t\t{Name: \"api_key\", Value: request.Literal(canary).Sensitive()},\n257\t\t\t},\n258\t\t}\n259\t}\n260\t\n261\t// TestRenderRedactsAHiddenLiteralQueryValue: a hidden literal has no symbolic\n262\t// form, so it renders as the placeholder — and as the placeholder itself, not\n263\t// percent-encoded into %3Credacted%3E. Both renderers here are display-only.\n264\tfunc TestRenderRedactsAHiddenLiteralQueryValue(t *testing.T) {\n265\t\tgot := Render(hiddenQueryReq())\n266\t\n267\t\tif !strings.Contains(got, \"?q=a+b&api_key=<redacted>\") {\n268\t\t\tt.Errorf(\"Render() = %s\\nwant it to contain ?q=a+b&api_key=<redacted>\", got)\n269\t\t}\n270\t\tif strings.Contains(got, \"%3Credacted%3E\") {\n271\t\t\tt.Errorf(\"Render() percent-encoded the placeholder:\\n%s\", got)\n272\t\t}\n273\t\tassertNoCanary(t, got)\n274\t}\n275\t\n276\tfunc TestURLRedactsAHiddenLiteralQueryValue(t *testing.T) {\n277\t\tgot := URL(hiddenQueryReq())\n278\t\n279\t\tconst want = \"https://api.example.com/pets?q=a+b&api_key=<redacted>\"\n280\t\tif got != want {\n281\t\t\tt.Errorf(\"URL() = %q, want %q\", got, want)\n282\t\t}\n283\t\tassertNoCanary(t, got)\n284\t}\n285\t\n286\tfunc TestURLOmitsTheQuestionMarkWithNoQuery(t *testing.T) {\n287\t\tif got, want := URL(bearerReq()), \"https://api.example.com/v1/pets/42\"; got != want {\n288\t\t\tt.Errorf(\"URL() = %q, want %q\", got, want)\n289\t\t}\n290\t}\n291\t\n292\tfunc TestRenderFallsBackToTheRedactedFormForANonEnvReference(t *testing.T) {\n293\t\treq := &request.Request{\n294\t\t\tMethod:  \"GET\",\n295\t\t\tBaseURL: \"https://api.example.com\",\n296\t\t\tPath:    \"/pets\",\n297\t\t\tHeaders: []request.Pair{{\n298\t\t\t\tName:  \"X-Key\",\n299\t\t\t\tValue: request.Secret(secret.SecretRef{Source: \"vault\", Name: \"prod/key\"}, request.EncodeRaw),\n300\t\t\t}},\n301\t\t}\n302\t\n303\t\tgot := Render(req)\n304\t\n305\t\t// Nothing to interpolate, so the command stops being copy-pasteable. That\n306\t\t// is the correct trade against printing the value.\n307\t\tconst want = `-H 'X-Key: <redacted:vault:prod/key>'`\n308\t\tif !strings.Contains(got, want) {\n309\t\t\tt.Errorf(\"Render() = %s\\nwant it to contain %s\", got, want)\n310\t\t}\n311\t}\n312\t"
