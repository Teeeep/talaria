        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"encoding/xml\"\n6\t\t\"io\"\n7\t\t\"net\"\n8\t\t\"net/http\"\n9\t\t\"net/http/httptest\"\n10\t\t\"os\"\n11\t\t\"path/filepath\"\n12\t\t\"strings\"\n13\t\t\"sync\"\n14\t\t\"testing\"\n15\t\n16\t\t\"github.com/Teeeep/talaria/internal/spec\"\n17\t)\n18\t\n19\t// runSpecFile is the fixture every test here drives: seven operations across\n20\t// four tags, one of which always 500s and one of which cannot be supplied with\n21\t// its path parameter.\n22\tconst runSpecFile = \"testdata/run.yaml\"\n23\t\n24\t// runResultJSON is one operation's line in the report.\n25\ttype runResultJSON struct {\n26\t\tOperationID string `json:\"operation_id\"`\n27\t\tMethod      string `json:\"method\"`\n28\t\tPath        string `json:\"path\"`\n29\t\tOutcome     string `json:\"outcome\"`\n30\t\tReason      string `json:\"reason\"`\n31\t\tStatus      int    `json:\"status\"`\n32\t\t// A pointer so an absent timing is distinguishable from a call to a local\n33\t\t// server that legitimately rounded to 0ms.\n34\t\tTimingMS   *int64 `json:\"timing_ms\"`\n35\t\tValidation *struct {\n36\t\t\tStatusDocumented bool `json:\"status_documented\"`\n37\t\t\tBodyValid        bool `json:\"body_valid\"`\n38\t\t\tErrors           []struct {\n39\t\t\t\tMessage string `json:\"message\"`\n40\t\t\t} `json:\"errors\"`\n41\t\t} `json:\"validation\"`\n42\t}\n43\t\n44\t// runJSON is the whole `run` envelope.\n45\ttype runJSON struct {\n46\t\tSchema  string          `json:\"schema\"`\n47\t\tResults []runResultJSON `json:\"results\"`\n48\t\tSummary struct {\n49\t\t\tTotal   int `json:\"total\"`\n50\t\t\tPassed  int `json:\"passed\"`\n51\t\t\tFailed  int `json:\"failed\"`\n52\t\t\tSkipped int `json:\"skipped\"`\n53\t\t} `json:\"summary\"`\n54\t}\n55\t\n56\t// runServer records every request it serves so a test can assert on what\n57\t// actually went out, and answers with a body the fixture spec documents.\n58\ttype runServer struct {\n59\t\t*httptest.Server\n60\t\n61\t\tmu       sync.Mutex\n62\t\trequests []recordedRequest\n63\t}\n64\t\n65\tfunc newRunServer(t *testing.T) *runServer {\n66\t\tt.Helper()\n67\t\n68\t\trs := &runServer{}\n69\t\trs.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n70\t\t\tbody, err := io.ReadAll(r.Body)\n71\t\t\tif err != nil {\n72\t\t\t\tt.Errorf(\"reading the request body: %v\", err)\n73\t\t\t}\n74\t\n75\t\t\trs.mu.Lock()\n76\t\t\trs.requests = append(rs.requests, recordedRequest{\n77\t\t\t\tMethod: r.Method,\n78\t\t\t\tPath:   r.URL.Path,\n79\t\t\t\tQuery:  r.URL.RawQuery,\n80\t\t\t\tHeader: r.Header.Clone(),\n81\t\t\t\tBody:   string(body),\n82\t\t\t})\n83\t\t\trs.mu.Unlock()\n84\t\n85\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n86\t\t\tswitch {\n87\t\t\tcase r.URL.Path == \"/boom\":\n88\t\t\t\tw.WriteHeader(http.StatusInternalServerError)\n89\t\t\t\t_, _ = io.WriteString(w, `{\"error\":\"boom\"}`)\n90\t\t\tcase r.Method == http.MethodPost:\n91\t\t\t\tw.WriteHeader(http.StatusCreated)\n92\t\t\t\t_, _ = io.WriteString(w, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n93\t\t\tdefault:\n94\t\t\t\tw.WriteHeader(http.StatusOK)\n95\t\t\t\t_, _ = io.WriteString(w, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n96\t\t\t}\n97\t\t}))\n98\t\tt.Cleanup(rs.Close)\n99\t\n100\t\treturn rs\n101\t}\n102\t\n103\tfunc (rs *runServer) received() []recordedRequest {\n104\t\trs.mu.Lock()\n105\t\tdefer rs.mu.Unlock()\n106\t\n107\t\treturn append([]recordedRequest(nil), rs.requests...)\n108\t}\n109\t\n110\t// paths is what the server was asked for, in order, as \"METHOD /path\".\n111\tfunc (rs *runServer) paths() []string {\n112\t\tvar out []string\n113\t\tfor _, req := range rs.received() {\n114\t\t\tout = append(out, req.Method+\" \"+req.Path)\n115\t\t}\n116\t\n117\t\treturn out\n118\t}\n119\t\n120\t// runRun executes `run` against a fresh, isolated history.\n121\tfunc runRun(t *testing.T, args ...string) (code int, stdout, stderr string) {\n122\t\tt.Helper()\n123\t\n124\t\treturn runRunIn(t, t.TempDir(), args...)\n125\t}\n126\t\n127\t// runRunIn is runRun with the state directory named, so a test can share one\n128\t// history between several commands.\n129\t//\n130\t// Credentials default to the canary, but one the test has already set — to the\n131\t// empty string, say — is left alone: that is how the missing-credential case is\n132\t// written.\n133\tfunc runRunIn(t *testing.T, stateDir string, args ...string) (code int, stdout, stderr string) {\n134\t\tt.Helper()\n135\t\tt.Setenv(spec.EnvSpec, \"\")\n136\t\tt.Setenv(\"XDG_STATE_HOME\", stateDir)\n137\t\tsetUnlessSet(t, \"TALARIA_AUTH_BEARER\", callCanary)\n138\t\tsetUnlessSet(t, \"TALARIA_AUTH_APIKEY_PETKEY\", callCanary)\n139\t\n140\t\tvar out, errOut strings.Builder\n141\t\tcode = run(append([]string{\"run\"}, args...), &out, &errOut)\n142\t\tstdout, stderr = out.String(), errOut.String()\n143\t\n144\t\tif strings.Contains(stdout, callCanary) {\n145\t\t\tt.Fatalf(\"run leaked the credential on stdout:\\n%s\", stdout)\n146\t\t}\n147\t\tif strings.Contains(stderr, callCanary) {\n148\t\t\tt.Fatalf(\"run leaked the credential on stderr:\\n%s\", stderr)\n149\t\t}\n150\t\n151\t\treturn code, stdout, stderr\n152\t}\n153\t\n154\tfunc setUnlessSet(t *testing.T, key, value string) {\n155\t\tt.Helper()\n156\t\n157\t\tif _, ok := os.LookupEnv(key); ok {\n158\t\t\treturn\n159\t\t}\n160\t\tt.Setenv(key, value)\n161\t}\n162\t\n163\tfunc decodeRun(t *testing.T, stdout string) runJSON {\n164\t\tt.Helper()\n165\t\n166\t\tvar got runJSON\n167\t\tif err := json.Unmarshal([]byte(stdout), &got); err != nil {\n168\t\t\tt.Fatalf(\"decoding %q: %v\", stdout, err)\n169\t\t}\n170\t\n171\t\treturn got\n172\t}\n173\t\n174\t// result finds one operation's line, failing the test when the report has none.\n175\tfunc (r runJSON) result(t *testing.T, id string) runResultJSON {\n176\t\tt.Helper()\n177\t\n178\t\tfor _, res := range r.Results {\n179\t\t\tif res.OperationID == id {