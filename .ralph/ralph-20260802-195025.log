  "message": {
    "role": "user",
    "content": [
      {
        "tool_use_id": "toolu_01MhtkCumXfCv2K1kKJLXF4C",
        "type": "tool_result",
        "content": "1\t// The §8 open question — libopenapi-validator strictness on 3.0 specs —\n2\t// is answered by TestResponseHonoursOpenAPI30SchemaSemantics below.\n3\t//\n4\t// Finding (libopenapi-validator v0.14.0, 2026-08-02): no false failure.\n5\t// The library reads the document's OpenAPI version and, for 3.0, rewrites the\n6\t// draft-04-era constructs before compiling: `nullable: true` becomes a union\n7\t// with \"null\", boolean `exclusiveMinimum`/`exclusiveMaximum` become the numeric\n8\t// 2020-12 spelling, and singular `example` is ignored rather than rejected.\n9\t// No per-document configuration is needed, so validate.Response passes no\n10\t// strictness options. The fixture (testdata/strict-3.0.yaml) is adversarial on\n11\t// purpose — it carries all four constructs and a body that only validates if\n12\t// every one of them is honoured — so the test would catch a regression that\n13\t// re-imposed 3.1 semantics on a 3.0 document.\n14\tpackage validate\n15\t\n16\timport (\n17\t\t\"net/http\"\n18\t\t\"path/filepath\"\n19\t\t\"strings\"\n20\t\t\"testing\"\n21\t\n22\t\t\"github.com/Teeeep/talaria/internal/spec\"\n23\t)\n24\t\n25\t// load reads a fixture spec, failing the test rather than returning an error:\n26\t// every test here needs a document before it can assert anything.\n27\tfunc load(t *testing.T, name string) *spec.Document {\n28\t\tt.Helper()\n29\t\n30\t\tdoc, err := spec.LoadFile(filepath.Join(\"testdata\", name))\n31\t\tif err != nil {\n32\t\t\tt.Fatalf(\"loading %s: %v\", name, err)\n33\t\t}\n34\t\n35\t\treturn doc\n36\t}\n37\t\n38\t// jsonInput is the common case: a JSON response to a GET.\n39\tfunc jsonInput(url string, status int, body string) Input {\n40\t\treturn Input{\n41\t\t\tMethod:  http.MethodGet,\n42\t\t\tURL:     url,\n43\t\t\tStatus:  status,\n44\t\t\tHeaders: http.Header{\"Content-Type\": []string{\"application/json\"}},\n45\t\t\tBody:    []byte(body),\n46\t\t}\n47\t}\n48\t\n49\t// errorText flattens a result's errors so a test can assert on the whole\n50\t// reported surface without caring which field carried the detail.\n51\tfunc errorText(r *Result) string {\n52\t\tvar b strings.Builder\n53\t\tfor _, e := range r.Errors {\n54\t\t\tb.WriteString(e.Message)\n55\t\t\tb.WriteString(\" \")\n56\t\t\tb.WriteString(e.Reason)\n57\t\t\tb.WriteString(\" \")\n58\t\t\tb.WriteString(e.Field)\n59\t\t\tb.WriteString(\"\\n\")\n60\t\t}\n61\t\n62\t\treturn b.String()\n63\t}\n64\t\n65\tfunc TestResponseReportsDocumentedStatus(t *testing.T) {\n66\t\tdoc := load(t, \"petstore-3.0.yaml\")\n67\t\n68\t\tres, err := Response(doc, jsonInput(\"https://api.real.example.com/v1/pets\", 404,\n69\t\t\t`{\"message\":\"none\"}`))\n70\t\tif err != nil {\n71\t\t\tt.Fatalf(\"Response: %v\", err)\n72\t\t}\n73\t\n74\t\tif !res.StatusDocumented {\n75\t\t\tt.Errorf(\"StatusDocumented = false, want true; errors: %s\", errorText(res))\n76\t\t}\n77\t\tif !res.BodyValid {\n78\t\t\tt.Errorf(\"BodyValid = false, want true; errors: %s\", errorText(res))\n79\t\t}\n80\t\tif len(res.Errors) != 0 {\n81\t\t\tt.Errorf(\"Errors = %v, want none\", res.Errors)\n82\t\t}\n83\t}\n84\t\n85\t// An undocumented status is a finding, not a failure: validation still returns\n86\t// a result so call can render the block and exit 0 without --fail-on-error.\n87\tfunc TestResponseReportsUndocumentedStatusWithoutErroring(t *testing.T) {\n88\t\tdoc := load(t, \"petstore-3.0.yaml\")\n89\t\n90\t\tres, err := Response(doc, jsonInput(\"https://api.real.example.com/v1/pets\", 418,\n91\t\t\t`{\"message\":\"teapot\"}`))\n92\t\tif err != nil {\n93\t\t\tt.Fatalf(\"Response: %v\", err)\n94\t\t}\n95\t\n96\t\tif res.StatusDocumented {\n97\t\t\tt.Error(\"StatusDocumented = true, want false\")\n98\t\t}\n99\t\tif len(res.Errors) == 0 {\n100\t\t\tt.Fatal(\"Errors is empty, want the undocumented status reported\")\n101\t\t}\n102\t\tif !strings.Contains(errorText(res), \"418\") {\n103\t\t\tt.Errorf(\"errors do not name the status: %s\", errorText(res))\n104\t\t}\n105\t}\n106\t\n107\tfunc TestResponseValidatesBodyAgainstSchema(t *testing.T) {\n108\t\tdoc := load(t, \"petstore-3.0.yaml\")\n109\t\n110\t\tres, err := Response(doc, jsonInput(\"https://api.real.example.com/v1/pets\", 200,\n111\t\t\t`[{\"id\":1,\"name\":\"fido\"}]`))\n112\t\tif err != nil {\n113\t\t\tt.Fatalf(\"Response: %v\", err)\n114\t\t}\n115\t\n116\t\tif !res.BodyValid {\n117\t\t\tt.Errorf(\"BodyValid = false, want true; errors: %s\", errorText(res))\n118\t\t}\n119\t}\n120\t\n121\t// The error has to name the field and the type the spec asked for, because the\n122\t// consumer is an agent deciding what to do next, not a human reading a stack\n123\t// trace.\n124\tfunc TestResponseReportsWrongFieldType(t *testing.T) {\n125\t\tdoc := load(t, \"petstore-3.0.yaml\")\n126\t\n127\t\tres, err := Response(doc, jsonInput(\"https://api.real.example.com/v1/pets\", 200,\n128\t\t\t`[{\"id\":\"not-a-number\",\"name\":\"fido\"}]`))\n129\t\tif err != nil {\n130\t\t\tt.Fatalf(\"Response: %v\", err)\n131\t\t}\n132\t\n133\t\tif res.BodyValid {\n134\t\t\tt.Fatal(\"BodyValid = true, want false\")\n135\t\t}\n136\t\n137\t\ttext := errorText(res)\n138\t\tif !strings.Contains(text, \"id\") {\n139\t\t\tt.Errorf(\"errors do not name the field %q: %s\", \"id\", text)\n140\t\t}\n141\t\tif !strings.Contains(text, \"integer\") {\n142\t\t\tt.Errorf(\"errors do not name the expected type %q: %s\", \"integer\", text)\n143\t\t}\n144\t}\n145\t\n146\tfunc TestResponseFlagsUndeclaredContentType(t *testing.T) {\n147\t\tdoc := load(t, \"petstore-3.0.yaml\")\n148\t\n149\t\tin := jsonInput(\"https://api.real.example.com/v1/pets\", 200, \"plain text, not json\")\n150\t\tin.Headers.Set(\"Content-Type\", \"text/plain\")\n151\t\n152\t\tres, err := Response(doc, in)\n153\t\tif err != nil {\n154\t\t\tt.Fatalf(\"Response: %v\", err)\n155\t\t}\n156\t\n157\t\tif res.ContentTypeDocumented {\n158\t\t\tt.Error(\"ContentTypeDocumented = true, want false\")\n159\t\t}\n160\t\tif !strings.Contains(errorText(res), \"text/plain\") {\n161\t\t\tt.Errorf(\"errors do not name the content type: %s\", errorText(res))\n162\t\t}\n163\t}\n164\t\n165\t// `default` is the spec's own catch-all. A status it covers is documented, so\n166\t// reporting it as undocumented would make every well-specified error response\n167\t// look like a contract violation.\n168\tfunc TestResponseAcceptsStatusCoveredByDefault(t *testing.T) {\n169\t\tdoc := load(t, \"petstore-3.0.yaml\")\n170\t\n171\t\tres, err := Response(doc, jsonInput(\"https://api.real.example.com/v1/pets/7\", 503,\n172\t\t\t`{\"message\":\"down\"}`))\n173\t\tif err != nil {\n174\t\t\tt.Fatalf(\"Response: %v\", err)\n175\t\t}\n176\t\n177\t\tif !res.StatusDocumented {\n178\t\t\tt.Errorf(\"StatusDocumented = false, want true; errors: %s\", errorText(res))\n179\t\t}\n180\t\tif !res.BodyValid {\n181\t\t\tt.Errorf(\"BodyValid = false, want true; errors: %s\", errorText(res))\n182\t\t}\n183\t}\n184\t\n185\t// A 204 declares no content at all. \"No schema\" must read as nothing to check,\n186\t// not as a missing body.\n187\tfunc TestResponseAcceptsEmptyBodyFor204(t *testing.T) {\n188\t\tdoc := load(t, \"petstore-3.0.yaml\")\n189\t\n190\t\tres, err := Response(doc, Input{\n191\t\t\tMethod:  http.MethodDelete,\n192\t\t\tURL:     \"https://api.real.example.com/v1/pets/7\",\n193\t\t\tStatus:  204,\n194\t\t\tHeaders: http.Header{},\n195\t\t})\n196\t\tif err != nil {\n197\t\t\tt.Fatalf(\"Response: %v\", err)\n198\t\t}\n199\t\n200\t\tif !res.StatusDocumented {\n201\t\t\tt.Errorf(\"StatusDocumented = false, want true; errors: %s\", errorText(res))\n202\t\t}\n203\t\tif !res.BodyValid {\n204\t\t\tt.Errorf(\"BodyValid = false, want true; errors: %s\", errorText(res))\n205\t\t}\n206\t\tif len(res.Errors) != 0 {\n207\t\t\tt.Errorf(\"Errors = %v, want none\", res.Errors)\n208\t\t}\n209\t}\n210\t\n211\t// --base-url points a call at a twin or a staging host, which shares nothing\n212\t// with the spec's declared server but the paths. Validation has to route on the\n213\t// path, tolerating both a different host and the presence or absence of the\n214\t// server's /v1 prefix — otherwise every twin-served call in Phase 6 reports a\n215\t// spurious violation.\n216\tfunc TestResponseRoutesRegardlessOfHostAndServerPrefix(t *testing.T) {\n217\t\tdoc := load(t, \"petstore-3.0.yaml\")\n218\t\n219\t\turls := []string{\n220\t\t\t\"https://api.real.example.com/v1/pets\",\n221\t\t\t\"http://127.0.0.1:8931/pets\",\n222\t\t\t\"http://127.0.0.1:8931/v1/pets\",\n223\t\t}\n224\t\n225\t\tfor _, url := range urls {\n226\t\t\tres, err := Response(doc, jsonInput(url, 200, `[{\"id\":1,\"name\":\"fido\"}]`))\n227\t\t\tif err != nil {\n228\t\t\t\tt.Fatalf(\"Response(%s): %v\", url, err)\n229\t\t\t}\n230\t\n231\t\t\tif !res.StatusDocumented || !res.BodyValid || !res.ContentTypeDocumented {\n232\t\t\t\tt.Errorf(\"%s: got %+v, want everything documented and valid; errors: %s\",\n233\t\t\t\t\turl, res, errorText(res))\n234\t\t\t}\n235\t\t}\n236\t}\n237\t\n238\t// A path the spec has never heard of documents nothing, so all three answers\n239\t// are false. This is the shape an agent sees when the spec has drifted from the\n240\t// server, and it must not read as \"the status was documented\".\n241\tfunc TestResponseReportsUndocumentedPath(t *testing.T) {\n242\t\tdoc := load(t, \"petstore-3.0.yaml\")\n243\t\n244\t\tres, err := Response(doc, jsonInput(\"https://api.real.example.com/v1/nope\", 200, `{}`))\n245\t\tif err != nil {\n246\t\t\tt.Fatalf(\"Response: %v\", err)\n247\t\t}\n248\t\n249\t\tif res.StatusDocumented || res.ContentTypeDocumented || res.BodyValid {\n250\t\t\tt.Errorf(\"got %+v, want everything false for an undocumented path\", res)\n251\t\t}\n252\t\tif !strings.Contains(errorText(res), \"/nope\") {\n253\t\t\tt.Errorf(\"errors do not name the path: %s\", errorText(res))\n254\t\t}\n255\t}\n256\t\n257\t// See the finding recorded at the top of this file.\n258\tfunc TestResponseHonoursOpenAPI30SchemaSemantics(t *testing.T) {\n259\t\tdoc := load(t, \"strict-3.0.yaml\")\n260\t\n261\t\t// Every field exercises one 3.0-only construct: the nulls need `nullable`\n262\t\t// to be honoured, and id sits strictly inside the boolean-exclusive bounds.\n263\t\tres, err := Response(doc, jsonInput(\"https://api.strict.example.com/widgets\", 200,\n264\t\t\t`{\"id\":5,\"label\":null,\"score\":null,\"tags\":null}`))\n265\t\tif err != nil {\n266\t\t\tt.Fatalf(\"Response: %v\", err)\n267\t\t}\n268\t\n269\t\tif !res.BodyValid {\n270\t\t\tt.Errorf(\"BodyValid = false on a valid 3.0 body — 3.1 strictness is being \"+\n271\t\t\t\t\"applied to a 3.0 document; errors: %s\", errorText(res))\n272\t\t}\n273\t}\n274\t\n275\t// The mirror of the test above: honouring 3.0 semantics must not mean skipping\n276\t// the constraints. `exclusiveMinimum: true` with `minimum: 0` still rejects 0.\n277\tfunc TestResponseEnforcesOpenAPI30ExclusiveBounds(t *testing.T) {\n278\t\tdoc := load(t, \"strict-3.0.yaml\")\n279\t\n280\t\tres, err := Response(doc, jsonInput(\"https://api.strict.example.com/widgets\", 200,\n281\t\t\t`{\"id\":0,\"label\":\"w\",\"score\":1,\"tags\":[]}`))\n282\t\tif err != nil {\n283\t\t\tt.Fatalf(\"Response: %v\", err)\n284\t\t}\n285\t\n286\t\tif res.BodyValid {\n287\t\t\tt.Error(\"BodyValid = true, want false: id=0 violates exclusiveMinimum 0\")\n288\t\t}\n289\t}\n290\t"
