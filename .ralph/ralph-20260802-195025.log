        "content": "// The name is all there is to go on. talaria cannot tell a token the user typed\n// into --header from an ordinary string by looking at the string, and §5a's\n// answer is that it does not have to: the name decides, whether the value came\n// from a spec's security scheme, a profile, a bound parameter or the flag.\nfunc hide(pairs []Pair) []Pair {\n\t// A nil *Redactor is the built-in list, which is the whole point here: the\n\t// user-extensible patterns are a display concern the config file adds\n\t// downstream, and this floor is not configurable.\n\tvar builtin *secret.Redactor\n\n\tfor i, p := range pairs {\n\t\tif !p.Value.IsSecret() && builtin.IsSensitive(p.Name) {\n\t\t\tpairs[i].Value = p.Value.Sensitive()\n\t\t}\n\t}\n\n=== call.go 230,245 ===\n\treturn curl.Options{MaxTime: time.Duration(seconds * float64(time.Second))}\n}\n\n// newRedactors builds the pair of firewalls an entry passes through on its way\n// to disk, extended with whatever the config file added. Request and response\n// share the header list: a name worth hiding on the way back is worth hiding on\n// the way out.\nfunc newRedactors(cfg *config.Config) corpus.Redactors {\n\treturn corpus.Redactors{\n\t\tRequest:  secret.NewRedactor(cfg.Redact.Headers...),\n\t\tResponse: secret.NewResponseRedactor(cfg.Redact.Headers, cfg.Redact.BodyPaths),\n\t}\n}\n\n// recordCall writes one entry, reporting a failure to write as a warning and\n// nothing more.\n=== AGENT.md ===\nAGENT.md:54:talaria call getPet --param petId=42 --query verbose=true --header 'X-Trace: abc'\nAGENT.md:58:  `--header` add ones it does not. All three repeat.\nAGENT.md:60:  `--header Content-Type`, else from the operation's declared media type.\nAGENT.md:169:— `--header 'X-Api-Key: sk-live-…'` — is redacted by name in the output and in the emitted curl,\nREADME.md:251:parameter the operation declares, in any location; `--query` and `--header` add ones it does\nREADME.md:259:`--header`, otherwise the media type the operation declares.\nREADME.md:274:A credential you supply yourself is treated the same way. `--header \"X-Api-Key: sk-live-…\"`,\nREADME.md:421:`headers` entry setting `Content-Type` wins, as `--header` does in `call`.\n=== canary harness HOME ===\n188:\t\t\"HOME=\" + home,\n189:\t\t\"XDG_STATE_HOME=\" + h.state,\n190:\t\t\"XDG_CACHE_HOME=\" + h.cache,\n191:\t\t\"XDG_CONFIG_HOME=\" + h.conf,\n426:\tstages := []struct {",
