    "content": [
      {
        "tool_use_id": "toolu_013a7Hq9bVQGweDm5VAHwLwg",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"io\"\n6\t\t\"os\"\n7\t\t\"os/signal\"\n8\t\t\"syscall\"\n9\t\n10\t\t\"github.com/spf13/cobra\"\n11\t\n12\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n13\t\t\"github.com/Teeeep/talaria/internal/curl\"\n14\t\t\"github.com/Teeeep/talaria/internal/output\"\n15\t\t\"github.com/Teeeep/talaria/internal/spec\"\n16\t)\n17\t\n18\t// version is the binary's version string. It defaults to \"dev\" and is\n19\t// overridden at build time with -ldflags \"-X main.version=v0.1.0\".\n20\tvar version = \"dev\"\n21\t\n22\t// newRootCmd builds the talaria command tree. Every command is constructed\n23\t// per-call rather than living in a package-level var so tests can run against\n24\t// an isolated tree with their own output writers.\n25\tfunc newRootCmd() *cobra.Command {\n26\t\troot := &cobra.Command{\n27\t\t\tUse:   \"talaria\",\n28\t\t\tShort: \"Point it at any API doc; your agent works the API and never sees your credentials\",\n29\t\t\tLong: \"talaria turns any OpenAPI/Swagger spec into an explorable API client, a\\n\" +\n30\t\t\t\t\"spec-driven tester, and a digital twin — without exposing credentials to\\n\" +\n31\t\t\t\t\"the agent driving it.\",\n32\t\t\tVersion: version,\n33\t\t\t// Args and RunE work together to give a typo exit 2 instead of 1. Left\n34\t\t\t// to itself cobra reports an unknown command from Find, as a bare error\n35\t\t\t// that exitCode can only read as a request failure — and exit 1 is the\n36\t\t\t// code AGENT.md calls transient and worth retrying, so a typo would send\n37\t\t\t// an agent into a retry loop. Rejecting the argument in Args instead\n38\t\t\t// classifies it, but cobra reaches ValidateArgs only on a *runnable*\n39\t\t\t// command, so the root needs a RunE it would otherwise do without.\n40\t\t\tArgs: unknownCommand,\n41\t\t\t// SuggestionsFor, unlike cobra's own unknown-command path, does not\n42\t\t\t// default this: left at 0 it would only ever suggest by prefix, and\n43\t\t\t// `talaria vrsion` — the shape of a typo — would get nothing back.\n44\t\t\tSuggestionsMinimumDistance: 2,\n45\t\t\t// What the non-runnable root used to get for free: bare `talaria` prints\n46\t\t\t// the help and exits 0. That is how a human finds the commands.\n47\t\t\tRunE: func(cmd *cobra.Command, _ []string) error { return cmd.Help() },\n48\t\t\t// Agents parse stderr. Cobra's default behaviour of dumping the usage\n49\t\t\t// block on every error, and of printing the error itself on top of the\n50\t\t\t// caller doing so, is noise.\n51\t\t\tSilenceUsage:  true,\n52\t\t\tSilenceErrors: true,\n53\t\t}\n54\t\n55\t\t// Registered once, here, so every present and future subcommand accepts it\n56\t\t// (DESIGN.md §3.1: \"--output json on every command\"). The empty default\n57\t\t// means \"decide from the terminal\"; see output.Resolve.\n58\t\troot.PersistentFlags().String(\"output\", \"\",\n59\t\t\t\"output format: json|pretty|tsv (default: pretty on a terminal, json when piped)\")\n60\t\n61\t\t// Also persistent: every spec-reading command takes the same spec the same\n62\t\t// way, and an agent that exports $TALARIA_SPEC once should not have to\n63\t\t// repeat itself on each call (DESIGN.md §4). Precedence between the three\n64\t\t// sources lives in spec.Resolve, not here.\n65\t\troot.PersistentFlags().String(\"spec\", \"\",\n66\t\t\t\"OpenAPI/Swagger spec to use: file path or URL (default: $\"+spec.EnvSpec+\")\")\n67\t\n68\t\t// Persistent for the same reason: call, run and auth check all take them\n69\t\t// (DESIGN.md §4), and registering either per-command would shadow the other\n70\t\t// registration silently. Commands that read no config simply ignore them.\n71\t\troot.PersistentFlags().String(\"profile\", \"\",\n72\t\t\t\"named profile from the config file: base-url + headers + auth\")\n73\t\troot.PersistentFlags().String(\"base-url\", \"\",\n74\t\t\t\"override the spec's server URL\")\n75\t\n76\t\t// A bad flag is a bad invocation, not a failed request; without this it\n77\t\t// would reach the translator as a bare error and exit 1.\n78\t\troot.SetFlagErrorFunc(func(_ *cobra.Command, err error) error {\n79\t\t\treturn clierr.Usage(\"%s\", err)\n80\t\t})\n81\t\n82\t\t// The Args counterpart of SetFlagErrorFunc lives per-command, in usageArgs;\n83\t\t// cobra has no tree-wide hook for it.\n84\t\n85\t\t// Validated once for the whole tree, so an unusable --output fails before a\n86\t\t// command does any work — including on commands that ignore the format.\n87\t\troot.PersistentPreRunE = func(cmd *cobra.Command, _ []string) error {\n88\t\t\t_, err := resolveFormat(cmd)\n89\t\t\treturn err\n90\t\t}\n91\t\n92\t\troot.AddCommand(newVersionCmd())\n93\t\troot.AddCommand(newListCmd())\n94\t\troot.AddCommand(newDescribeCmd())\n95\t\troot.AddCommand(newSearchCmd())\n96\t\troot.AddCommand(newUsesCmd())\n97\t\troot.AddCommand(newCallCmd())\n98\t\troot.AddCommand(newRunCmd())\n99\t\troot.AddCommand(newAuthCmd())\n100\t\troot.AddCommand(newHistoryCmd())\n101\t\n102\t\treturn root\n103\t}\n104\t\n105\t// unknownCommand rejects any positional argument on the root command, which by\n106\t// then can only be a command that does not exist. It reproduces cobra's own\n107\t// wording, and carries the near misses as structured alternatives rather than\n108\t// as prose appended to the message (§3.1: \"what failed, why, valid\n109\t// alternatives\") — a typo is the one error an agent can correct unaided.\n110\tfunc unknownCommand(cmd *cobra.Command, args []string) error {\n111\t\tif len(args) == 0 {\n112\t\t\treturn nil\n113\t\t}\n114\t\n115\t\treturn clierr.Usage(\"unknown command %q for %q\", args[0], cmd.CommandPath()).\n116\t\t\tWithAlternatives(cmd.SuggestionsFor(args[0])...)\n117\t}\n118\t\n119\t// usageArgs wraps a positional-argument validator so a wrong argument count\n120\t// exits 2 like every other bad invocation. Cobra returns a bare error here, and\n121\t// SetFlagErrorFunc does not cover it, so without this the caller would see the\n122\t// unclassified-failure code 1.\n123\tfunc usageArgs(validate cobra.PositionalArgs) cobra.PositionalArgs {\n124\t\treturn func(cmd *cobra.Command, args []string) error {\n125\t\t\tif err := validate(cmd, args); err != nil {\n126\t\t\t\treturn clierr.Usage(\"%w\", err)\n127\t\t\t}\n128\t\t\treturn nil\n129\t\t}\n130\t}\n131\t\n132\t// resolveFormat resolves --output for cmd against the TTY-ness of its stdout.\n133\t// internal/output deliberately returns a bare error; it becomes a usage error\n134\t// here, where the exit-code contract lives, carrying the valid values so an\n135\t// agent can correct itself without reading the help text.\n136\tfunc resolveFormat(cmd *cobra.Command) (output.Format, error) {\n137\t\texplicit, err := cmd.Flags().GetString(\"output\")\n138\t\tif err != nil {\n139\t\t\treturn \"\", clierr.Usage(\"%w\", err)\n140\t\t}\n141\t\n142\t\tformat, err := output.Resolve(explicit, output.IsTTY(cmd.OutOrStdout()))\n143\t\tif err != nil {\n144\t\t\treturn \"\", clierr.Usage(\"%w\", err).WithAlternatives(output.Formats()...)\n145\t\t}\n146\t\treturn format, nil\n147\t}\n148\t\n149\t// run executes the talaria command tree and returns the process exit code.\n150\t// It deliberately does not call os.Exit — main is the only place that does —\n151\t// so every exit code in the CLI is assertable in-process.\n152\t//\n153\t// The signal context is what makes a Ctrl-C or a `kill` orderly rather than\n154\t// abrupt. Without it nothing catches the signal, the process dies where it\n155\t// stands, and none of the deferred cleanup runs: curl is reparented to init and\n156\t// finishes the request talaria was told to stop — a write that carries on after\n157\t// the caller cancelled it — while the capture directory holding the raw,\n158\t// unredacted response stays on disk.\n159\tfunc run(args []string, stdout, stderr io.Writer) int {\n160\t\t// Anything a previous SIGKILL left behind goes first: that signal cannot be\n161\t\t// caught, so the sweep is the only cleanup those files will ever get.\n162\t\tcurl.SweepStale()\n163\t\n164\t\tctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)\n165\t\tdefer stop()\n166\t\n167\t\treturn runContext(ctx, args, stdout, stderr)\n168\t}\n169\t\n170\t// runContext is run with the cancellation source given rather than taken from\n171\t// the process's signals, so a test can cancel a call without signalling itself.\n172\t//\n173\t// The context reaches every command through cobra, which is how internal/curl\n174\t// gets the one it kills the subprocess with.\n175\tfunc runContext(ctx context.Context, args []string, stdout, stderr io.Writer) int {\n176\t\troot := newRootCmd()\n177\t\troot.SetOut(stdout)\n178\t\troot.SetErr(stderr)\n179\t\troot.SetArgs(args)\n180\t\n181\t\treturn exitCode(root.ExecuteContext(ctx), stderr)\n182\t}\n183\t\n184\t// exitCode renders err as structured JSON on stderr and returns the code to\n185\t// exit with. An error that was never classified is a request failure (1).\n186\tfunc exitCode(err error, stderr io.Writer) int {\n187\t\tif err == nil {\n188\t\t\treturn int(clierr.CodeOK)\n189\t\t}\n190\t\n191\t\tclierr.Render(stderr, err)\n192\t\treturn int(clierr.From(err).Code)\n193\t}\n194\t"
      }
