g or number.\n153\t//\n154\t// An array root is decoded rather than skipped: a collection endpoint answers\n155\t// with one, and the elements are objects a path does name.\n156\tfunc decodeDocument(body []byte) (any, bool) {\n157\t\ttrimmed := bytes.TrimLeft(body, \" \\t\\r\\n\")\n158\t\tif len(trimmed) == 0 || (trimmed[0] != '{' && trimmed[0] != '[') {\n159\t\t\treturn nil, false\n160\t\t}\n161\t\n162\t\tdec := json.NewDecoder(bytes.NewReader(trimmed))\n163\t\t// Numbers stay as their original text: without this an id of\n164\t\t// 1234567890123456789 comes back out as 1.2345678901234568e+18, and a\n165\t\t// redacted body must still report what the server actually sent.\n166\t\tdec.UseNumber()\n167\t\n168\t\tvar doc any\n169\t\tif err := dec.Decode(&doc); err != nil {\n170\t\t\treturn nil, false\n171\t\t}\n172\t\tif _, err := dec.Token(); err != io.EOF {\n173\t\t\treturn nil, false\n174\t\t}\n175\t\n176\t\treturn doc, true\n177\t}\n178\t\n179\t// redactPath replaces the value at path within doc, reporting whether anything\n180\t// was there to replace. A path that names nothing — a missing key, or a segment\n181\t// that turns out not to be an object — is a no-op rather than an error: a\n182\t// redaction list is written once and applied to every response an API returns.\n183\t//\n184\t// An array is fanned out over without consuming a segment, because a path names\n185\t// keys and an array has none: `items.token` reaches the token of every element\n186\t// of items, and a top-level `access_token` reaches every element of a top-level\n187\t// array. Anything matched anywhere is reported as a match.\n188\tfunc redactPath(doc any, path []string) bool {\n189\t\tswitch node := doc.(type) {\n190\t\tcase []any:\n191\t\t\tredacted := false\n192\t\t\tfor _, element := range node {\n193\t\t\t\tif redactPath(element, path) {\n194\t\t\t\t\tredacted = true\n195\t\t\t\t}\n196\t\t\t}\n197\t\n198\t\t\treturn redacted\n199\t\n200\t\tcase map[string]any:\n201\t\t\tif len(path) > 1 {\n202\t\t\t\treturn redactPath(node[path[0]], path[1:])\n203\t\t\t}\n204\t\t\tif _, ok := node[path[0]]; !ok {\n205\t\t\t\treturn false\n206\t\t\t}\n207\t\t\tnode[path[0]] = Placeholder\n208\t\n209\t\t\treturn true\n210\t\n211\t\tdefault:\n212\t\t\treturn false\n213\t\t}\n214\t}\n215\t\n216\t// splitPath splits a dotted path into segments, returning nil for one that\n217\t// cannot name anything — empty, or with an empty segment. Silently ignoring it\n218\t// is right here: config validation belongs to whoever read the config, and a\n219\t// redactor that refused to be built would fail an unrelated call.\n220\tfunc splitPath(path string) []string {\n221\t\tif path == \"\" {\n222\t\t\treturn nil\n223\t\t}\n224\t\n225\t\tsegments := strings.Split(path, \".\")\n226\t\tfor _, segment := range segments {\n227\t\t\tif segment == \"\" {\n228\t\t\t\treturn nil\n229\t\t\t}\n230\t\t}\n231\t\n232\t\treturn segments\n233\t}\n234\t\n235\t// QueryKeyWarner emits the one-time warning from §5a's leak-channel table: an\n236\t// API key in the query string is symbolic in emitted curl and redacted in\n237\t// output, and still ends up in the *server's* access log, where talaria has no\n238\t// say. The user is told once so they can decide whether that is acceptable.\n239\t//\n240\t// Once per process rather than once per call, because `run` makes hundreds of\n241\t// calls against the same spec and a warning repeated hundreds of times is one\n242\t// nobody reads.\n243\ttype QueryKeyWarner struct{ once sync.Once }\n244\t\n245\t// NewQueryKeyWarner returns a warner that has not yet fired.\n246\tfunc NewQueryKeyWarner() *QueryKeyWarner { return &QueryKeyWarner{} }\n247\t\n248\t// Warn writes the warning for a credential travelling in query parameter param,\n249\t// the first time it is called and never again.\n250\t//\n251\t// The message names the parameter and the environment variable, both of which\n252\t// are names; a warning about a leak that quoted the value would be one.\n253\tfunc (w *QueryKeyWarner) Warn(out io.Writer, param string, ref SecretRef) {\n254\t\tif w == nil || out == nil {\n255\t\t\treturn\n256\t\t}\n257\t\n258\t\tw.once.Do(func() {\n259\t\t\tfmt.Fprintf(out,\n260\t\t\t\t\"warning: this operation sends %s in the query parameter %q; \"+\n261\t\t\t\t\t\"URLs are recorded in server access logs, so the key is exposed there \"+\n262\t\t\t\t\t\"whatever talaria redacts\\n\",\n263\t\t\t\tref.Symbolic(), param)\n264\t\t})\n265\t}\n266\t"
