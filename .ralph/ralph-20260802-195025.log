        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"errors\"\n8\t\t\"math\"\n9\t\t\"net/http\"\n10\t\t\"net/url\"\n11\t\t\"os\"\n12\t\t\"os/exec\"\n13\t\t\"path/filepath\"\n14\t\t\"strings\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n18\t\t\"github.com/Teeeep/talaria/internal/request\"\n19\t)\n20\t\n21\t// Response is one observed HTTP response. It is the `response` block of call's\n22\t// output (DESIGN.md §4) before any redaction is applied — redaction of what came\n23\t// back off the wire is Task 20's job, and doing it here would leave no\n24\t// unredacted copy for validation to check against the spec.\n25\ttype Response struct {\n26\t\tStatus   int         `json:\"status\"`\n27\t\tHeaders  http.Header `json:\"headers\"`\n28\t\tBody     []byte      `json:\"body\"`\n29\t\tTimingMS int64       `json:\"timing_ms\"`\n30\t}\n31\t\n32\t// Execute runs req through the system curl and returns what came back.\n33\t//\n34\t// An HTTP 4xx or 5xx is a successful observation and returns a Response with no\n35\t// error (§4); only a request that could not be completed at all — a refused\n36\t// connection, a TLS failure, curl itself failing — is an error, and it carries\n37\t// exit code 1.\n38\t//\n39\t// The credential values live in the config document written to curl's stdin and\n40\t// nowhere else: not in argv, which /proc/*/cmdline exposes to any process on\n41\t// the host, and not in the environment curl inherits (§5a).\n42\tfunc Execute(req *request.Request) (*Response, error) {\n43\t\treturn ExecuteWith(req, DefaultOptions())\n44\t}\n45\t\n46\t// killGrace is how long past its own max-time a curl gets before talaria stops\n47\t// waiting for it. curl enforces the timeout itself in every case anyone has\n48\t// seen; this margin is for the ones nobody has — a curl wedged in a syscall, or\n49\t// one whose stdout pipe a child process is still holding open. Without it, the\n50\t// bound is only as good as the subprocess's willingness to honour it.\n51\tconst killGrace = 2 * time.Second\n52\t\n53\t// ExecuteWith is Execute with the timeouts named rather than defaulted.\n54\tfunc ExecuteWith(req *request.Request, opts Options) (*Response, error) {\n55\t\topts = opts.withDefaults()\n56\t\n57\t\tpath, err := exec.LookPath(\"curl\")\n58\t\tif err != nil {\n59\t\t\treturn nil, clierr.RequestFailed(\"curl is not installed or not on PATH: %w\", err)\n60\t\t}\n61\t\tif err := preflight(path); err != nil {\n62\t\t\treturn nil, err\n63\t\t}\n64\t\n65\t\tcapture, cleanupCapture, err := newCapture()\n66\t\tif err != nil {\n67\t\t\treturn nil, err\n68\t\t}\n69\t\tdefer cleanupCapture()\n70\t\n71\t\tconfig, argv, cleanupConfig, err := BuildConfigWith(req, capture, opts)\n72\t\tdefer cleanupConfig()\n73\t\tif err != nil {\n74\t\t\treturn nil, err\n75\t\t}\n76\t\n77\t\tctx, cancel := context.WithTimeout(context.Background(), opts.MaxTime+killGrace)\n78\t\tdefer cancel()\n79\t\n80\t\t// argv[0] is the command name BuildConfig reports; the resolved path is what\n81\t\t// actually gets executed, so a PATH change mid-run cannot swap the binary\n82\t\t// between the preflight and the call.\n83\t\tcmd := exec.CommandContext(ctx, path, argv[1:]...)\n84\t\t// The context kills the process; WaitDelay bounds the reaping too, so a\n85\t\t// grandchild still holding the output pipe cannot leave Wait blocked after\n86\t\t// curl itself is gone.\n87\t\tcmd.WaitDelay = killGrace\n88\t\t// The document goes in over a pipe rather than through the process's own\n89\t\t// stdin, which belongs to the user and may be a request body (Task 18).\n90\t\tcmd.Stdin = bytes.NewReader(config)\n91\t\n92\t\tvar stdout, stderr bytes.Buffer\n93\t\tcmd.Stdout = &stdout\n94\t\tcmd.Stderr = &stderr\n95\t\n96\t\tif err := cmd.Run(); err != nil {\n97\t\t\t// The deadline firing means curl did not honour max-time, so its exit\n98\t\t\t// status is talaria's signal (killed) rather than curl's own 28, and the\n99\t\t\t// message says which of the two happened.\n100\t\t\tif ctx.Err() != nil {\n101\t\t\t\treturn nil, clierr.RequestFailed(\n102\t\t\t\t\t\"the request could not be completed: curl outlived its %s timeout and was killed\",\n103\t\t\t\t\topts.MaxTime)\n104\t\t\t}\n105\t\n106\t\t\treturn nil, runFailure(req, err, stderr.String())\n107\t\t}\n108\t\n109\t\treturn readResponse(req, capture, stdout.Bytes())\n110\t}\n111\t\n112\t// writeOut is curl's `--write-out '%{json}'` payload, of which talaria reads\n113\t// two fields. It arrives as the whole of curl's stdout, so it is unmarshalled\n114\t// as one object rather than scanned for out of a mixed stream — the split that\n115\t// makes a response body impersonating this shape a non-event.\n116\ttype writeOut struct {\n117\t\tHTTPCode  int     `json:\"http_code\"`\n118\t\tTimeTotal float64 `json:\"time_total\"`\n119\t\tErrorMsg  string  `json:\"errormsg\"`\n120\t}\n121\t\n122\t// readResponse assembles the Response from curl's three output channels.\n123\tfunc readResponse(req *request.Request, capture Capture, stdout []byte) (*Response, error) {\n124\t\tvar meta writeOut\n125\t\tif err := json.Unmarshal(stdout, &meta); err != nil {\n126\t\t\treturn nil, clierr.RequestFailed(\"cannot parse curl's response metadata: %w\", err)\n127\t\t}\n128\t\n129\t\tbody, err := os.ReadFile(capture.BodyPath)\n130\t\tif err != nil {\n131\t\t\treturn nil, clierr.RequestFailed(\"cannot read the response body: %w\", err)\n132\t\t}\n133\t\n134\t\tdump, err := os.ReadFile(capture.HeaderPath)\n135\t\tif err != nil {\n136\t\t\treturn nil, clierr.RequestFailed(\"cannot read the response headers: %w\", err)\n137\t\t}\n138\t\n139\t\t// http_code is 0 when curl never got a response. That is a completed process\n140\t\t// with nothing observed, which is a failed request rather than an empty one.\n141\t\tif meta.HTTPCode == 0 {\n142\t\t\treturn nil, requestFailed(req, 0, meta.ErrorMsg)\n143\t\t}\n144\t\n145\t\treturn &Response{\n146\t\t\tStatus:   meta.HTTPCode,\n147\t\t\tHeaders:  parseHeaders(dump),\n148\t\t\tBody:     body,\n149\t\t\tTimingMS: int64(math.Round(meta.TimeTotal * 1000)),\n150\t\t}, nil\n151\t}\n152\t\n153\t// newCapture allocates the two files curl writes the response to, inside a 0700\n154\t// directory of their own. They hold response data, which may carry a session\n155\t// cookie or a token the API handed back, so they are never world-readable and\n156\t// never outlive the exec.\n157\tfunc newCapture() (Capture, func(), error) {\n158\t\tdir, err := os.MkdirTemp(\"\", \"talaria-call-*\")\n159\t\tif err != nil {\n160\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot stage the response: %w\", err)\n161\t\t}\n162\t\n163\t\tcleanup := func() { os.RemoveAll(dir) } //nolint:errcheck // Best effort; 0700 and in TMPDIR.\n164\t\n165\t\tif err := os.Chmod(dir, 0o700); err != nil {\n166\t\t\tcleanup()\n167\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot secure the response directory: %w\", err)\n168\t\t}\n169\t\n170\t\tcapture := Capture{\n171\t\t\tBodyPath:   filepath.Join(dir, \"body\"),\n172\t\t\tHeaderPath: filepath.Join(dir, \"headers\"),\n173\t\t}\n174\t\n175\t\t// Creating both up front means curl writes into a file that is already 0600,\n176\t\t// rather than one whose mode comes from curl's umask.\n177\t\tfor _, path := range []string{capture.BodyPath, capture.HeaderPath} {\n178\t\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)\n179\t\t\tif err != nil {\n180\t\t\t\tcleanup()\n181\t\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot stage the response: %w\", err)\n182\t\t\t}\n183\t\t\tif err := f.Close(); err != nil {\n184\t\t\t\tcleanup()\n185\t\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot stage the response: %w\", err)\n186\t\t\t}\n187\t\t}\n188\t\n189\t\treturn capture, cleanup, nil\n190\t}\n191\t\n192\t// parseHeaders turns curl's dump-header file into an http.Header, keeping only\n193\t// the last response block. Redirects and a 100 Continue each leave a block in\n194\t// front of the real one, and a stale Location reported as the response's own is\n195\t// worse than no Location at all.\n196\tfunc parseHeaders(dump []byte) http.Header {\n197\t\theaders := http.Header{}\n198\t\n199\t\tblocks := strings.Split(strings.ReplaceAll(string(dump), \"\\r\\n\", \"\\n\"), \"\\n\\n\")\n200\t\tlast := \"\"\n201\t\tfor _, block := range blocks {\n202\t\t\tif strings.TrimSpace(block) != \"\" {\n203\t\t\t\tlast = block\n204\t\t\t}\n205\t\t}\n206\t\n207\t\tfor _, line := range strings.Split(last, \"\\n\") {\n208\t\t\t// The status line is not a header; the Response's Status comes from\n209\t\t\t// %{json}, which does not need re-deriving from text.\n210\t\t\tif line == \"\" || strings.HasPrefix(line, \"HTTP/\") {\n211\t\t\t\tcontinue\n212\t\t\t}\n213\t\n214\t\t\tname, value, ok := strings.Cut(line, \":\")\n215\t\t\tif !ok {\n216\t\t\t\tcontinue\n217\t\t\t}\n218\t\t\theaders.Add(strings.TrimSpace(name), strings.TrimSpace(value))\n219\t\t}\n220\t\n221\t\treturn headers\n222\t}\n223\t\n224\t// runFailure classifies a curl process that did not exit 0.\n225\tfunc runFailure(req *request.Request, err error, stderr string) error {\n226\t\tvar exitErr *exec.ExitError\n227\t\tif errors.As(err, &exitErr) {\n228\t\t\treturn requestFailed(req, exitErr.ExitCode(), stderr)\n229\t\t}\n230\t\n231\t\treturn clierr.RequestFailed(\"cannot run curl: %w\", err)\n232\t}\n233\t\n234\t// requestFailed builds the error for a request curl could not complete, with\n235\t// curl's own exit status in it so an operator can look the code up.\n236\t//\n237\t// The detail passes through the request's scrubber first: curl echoes the URL\n238\t// it was given into several of its messages, and for an API-key scheme the URL\n239\t// is exactly where the credential is. §5a — errors are built from the redacted\n240\t// representation.\n241\tfunc requestFailed(req *request.Request, exitCode int, detail string) error {\n242\t\tdetail = strings.TrimSpace(scrubber(req).Replace(detail))\n243\t\tif detail == \"\" {\n244\t\t\treturn clierr.RequestFailed(\"the request could not be completed: curl exited %d\", exitCode)\n245\t\t}\n246\t\n247\t\treturn clierr.RequestFailed(\"the request could not be completed: curl exited %d: %s\", exitCode, detail)\n248\t}\n249\t\n250\t// scrubber returns a replacer that rewrites any credential this request\n251\t// resolved back into its <redacted:env:NAME> form.\n252\t//\n253\t// It works from the request's own refs rather than from a pattern over the\n254\t// text: talaria knows exactly which values it put on the wire, and matching\n255\t// those is neither a guess nor defeatable by an unusual message format. A\n256\t// credential that will not resolve was never sent and so cannot be echoed.\n257\tfunc scrubber(req *request.Request) *strings.Replacer {\n258\t\tif req == nil {\n259\t\t\treturn strings.NewReplacer()\n260\t\t}\n261\t\n262\t\tvar pairs []string\n263\t\tfor _, group := range [][]request.Pair{req.Headers, req.Query, req.Cookies} {\n264\t\t\tfor _, p := range group {\n265\t\t\t\tif !p.Value.IsSecret() {\n266\t\t\t\t\tcontinue\n267\t\t\t\t}\n268\t\n269\t\t\t\tresolved, err := p.Value.Ref().Resolve()\n270\t\t\t\tif err != nil || resolved == \"\" {\n271\t\t\t\t\tcontinue\n272\t\t\t\t}\n273\t\n274\t\t\t\tredacted := p.Value.Ref().String()\n275\t\t\t\tpairs = append(pairs, resolved, redacted)\n276\t\t\t\t// A credential echoed back as part of a URL is percent-encoded, which\n277\t\t\t\t// the literal form would walk straight past.\n278\t\t\t\tif encoded := url.QueryEscape(resolved); encoded != resolved {\n279\t\t\t\t\tpairs = append(pairs, encoded, redacted)\n280\t\t\t\t}\n281\t\t\t}\n282\t\t}\n283\t\n284\t\treturn strings.NewReplacer(pairs...)\n285\t}\n286\t"
      }
