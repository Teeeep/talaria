        "tool_use_id": "toolu_019fPr4eMTSJSYGjhY2q9cRV",
        "type": "tool_result",
        "content": "1\tpackage gen\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"strconv\"\n10\t\t\"strings\"\n11\t\n12\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n13\t\t\"github.com/Teeeep/talaria/internal/operation\"\n14\t\t\"github.com/pb33f/libopenapi/datamodel/high/base\"\n15\t)\n16\t\n17\t// Fixture is one operation's test data as written on disk, in\n18\t// `<fixtures-dir>/<operationId>.json`. Every field is optional: a fixture that\n19\t// only pins the path id and leaves the body to generation is the common case.\n20\ttype Fixture struct {\n21\t\t// Params supply declared parameters by name, in any location. Values are\n22\t\t// scalars; they are rendered to text the way they will travel on the wire.\n23\t\tParams map[string]any `json:\"params\"`\n24\t\t// Headers are sent verbatim, and need not be declared by the spec — a\n25\t\t// tenant or trace header the API expects but the document never mentions is\n26\t\t// exactly what this is for.\n27\t\tHeaders map[string]string `json:\"headers\"`\n28\t\t// Body is kept raw so a fixture reaches the server as the author wrote it,\n29\t\t// rather than round-tripped through a Go value.\n30\t\tBody json.RawMessage `json:\"body\"`\n31\t}\n32\t\n33\t// Fixtures is a loaded --fixtures directory, keyed by operationId. The zero\n34\t// value and a nil *Fixtures are both usable and empty, which is what `run`\n35\t// holds when the flag is unset.\n36\ttype Fixtures struct {\n37\t\tdir  string\n38\t\tbyID map[string]Fixture\n39\t}\n40\t\n41\t// LoadFixtures reads every `*.json` file in dir into a set keyed by the file's\n42\t// base name. An empty path is not an error — it is an unset --fixtures flag —\n43\t// and yields an empty set, so `run` builds the priority chain the same way with\n44\t// or without the flag.\n45\t//\n46\t// The whole directory is read once, up front. A fixture that only fails to\n47\t// parse on the operation that happens to need it would report a typo halfway\n48\t// through a suite, after real requests have already gone out.\n49\tfunc LoadFixtures(dir string) (*Fixtures, error) {\n50\t\tfx := &Fixtures{dir: dir, byID: map[string]Fixture{}}\n51\t\tif dir == \"\" {\n52\t\t\treturn fx, nil\n53\t\t}\n54\t\n55\t\tentries, err := os.ReadDir(dir)\n56\t\tif err != nil {\n57\t\t\treturn nil, clierr.Usage(\"reading fixtures directory %s: %w\", dir, err)\n58\t\t}\n59\t\n60\t\tfor _, entry := range entries {\n61\t\t\tname := entry.Name()\n62\t\t\tif entry.IsDir() || !strings.EqualFold(filepath.Ext(name), \".json\") {\n63\t\t\t\tcontinue\n64\t\t\t}\n65\t\n66\t\t\tpath := filepath.Join(dir, name)\n67\t\t\tdata, err := os.ReadFile(path)\n68\t\t\tif err != nil {\n69\t\t\t\treturn nil, clierr.Usage(\"reading fixture %s: %w\", path, err)\n70\t\t\t}\n71\t\n72\t\t\tvar f Fixture\n73\t\t\tif err := json.Unmarshal(data, &f); err != nil {\n74\t\t\t\treturn nil, clierr.Usage(\"parsing fixture %s: %w\", path, err)\n75\t\t\t}\n76\t\n77\t\t\tfx.byID[strings.TrimSuffix(name, filepath.Ext(name))] = f\n78\t\t}\n79\t\n80\t\treturn fx, nil\n81\t}\n82\t\n83\t// Get returns the fixture for an operationId, and whether there was one.\n84\tfunc (f *Fixtures) Get(id string) (Fixture, bool) {\n85\t\tif f == nil {\n86\t\t\treturn Fixture{}, false\n87\t\t}\n88\t\n89\t\tfixture, ok := f.byID[id]\n90\t\n91\t\treturn fixture, ok\n92\t}\n93\t\n94\t// Len is how many fixtures were loaded.\n95\tfunc (f *Fixtures) Len() int {\n96\t\tif f == nil {\n97\t\t\treturn 0\n98\t\t}\n99\t\n100\t\treturn len(f.byID)\n101\t}\n102\t\n103\t// Data is one operation's request data: what to bind to its declared\n104\t// parameters, what extra headers to send, and the body, JSON-encoded and nil\n105\t// when there is none.\n106\ttype Data struct {\n107\t\t// Params are declared parameters by name, already rendered as text, ready\n108\t\t// for request.Inputs.Params.\n109\t\tParams map[string]string\n110\t\t// Headers are fixture-supplied headers, ready for request.Inputs.Headers.\n111\t\tHeaders map[string]string\n112\t\t// Body is the encoded request body, or nil.\n113\t\tBody []byte\n114\t}\n115\t\n116\t// DataFor returns the request data for one operation, applying the DESIGN.md\n117\t// §5a priority chain: a spec example, then a fixture, then generation.\n118\t//\n119\t// This is the only entry point that decides the order, so `run` cannot get it\n120\t// wrong by assembling the pieces itself. The chain runs per field rather than\n121\t// per request — an example on one parameter beats the fixture for that\n122\t// parameter while the fixture still supplies the next — because a spec that\n123\t// documents one id and a fixture that supplies the rest is the normal case, not\n124\t// a conflict to resolve wholesale.\n125\tfunc (g *Generator) DataFor(op operation.Operation) Data {\n126\t\tfixture, _ := g.Fixtures.Get(op.ID)\n127\t\n128\t\tdata := Data{\n129\t\t\tParams:  make(map[string]string, len(op.Params)),\n130\t\t\tHeaders: make(map[string]string, len(fixture.Headers)),\n131\t\t\tBody:    g.bodyFor(op, fixture),\n132\t\t}\n133\t\n134\t\tfor name, value := range fixture.Headers {\n135\t\t\tdata.Headers[name] = value\n136\t\t}\n137\t\n138\t\tfor _, p := range op.Params {\n139\t\t\tif v, ok := g.paramValue(p, fixture); ok {\n140\t\t\t\tdata.Params[p.Name] = scalarString(v)\n141\t\t\t}\n142\t\t}\n143\t\n144\t\t// Fixture parameters the operation does not declare are passed through\n145\t\t// rather than dropped: the request builder reports an unknown parameter by\n146\t\t// name, which is a better answer to a typo than a value that silently never\n147\t\t// arrives.\n148\t\tfor name, value := range fixture.Params {\n149\t\t\tif _, ok := data.Params[name]; !ok {\n150\t\t\t\tdata.Params[name] = scalarString(value)\n151\t\t\t}\n152\t\t}\n153\t\n154\t\treturn data\n155\t}\n156\t\n157\t// paramValue resolves one parameter through the chain, reporting whether it\n158\t// found anything at all.\n159\t//\n160\t// An optional parameter with no example and no fixture is deliberately left\n161\t// out. Generating one means a smoke test filtering on an invented cursor or\n162\t// searching for a made-up name, which tests the API's error handling rather\n163\t// than the operation. A required one is always supplied: a request the server\n164\t// rejects for a missing parameter never reaches the behaviour under test.\n165\tfunc (g *Generator) paramValue(p operation.Param, fixture Fixture) (any, bool) {\n166\t\tif p.Schema != nil {\n167\t\t\tif s := p.Schema.Schema(); s != nil {\n168\t\t\t\tif v, ok := exampleValue(s); ok {\n169\t\t\t\t\treturn v, true\n170\t\t\t\t}\n171\t\t\t}\n172\t\t}\n173\t\n174\t\tif v, ok := fixture.Params[p.Name]; ok {\n175\t\t\treturn v, true\n176\t\t}\n177\t\n178\t\tif !p.Required {\n179\t\t\treturn nil, false\n180\t\t}\n181\t\n182\t\treturn g.value(p.Schema, 0, make(map[string]int))\n183\t}\n184\t\n185\t// bodyFor resolves the request body through the same chain.\n186\t//\n187\t// A fixture body is used even for an operation that declares no request body:\n188\t// specs under-document bodies all the time, and a fixture is the escape hatch\n189\t// for exactly that. The reverse — inventing a body for an operation the spec\n190\t// says takes none — is not something anyone asked for, so generation only runs\n191\t// when there is a schema to generate from.\n192\tfunc (g *Generator) bodyFor(op operation.Operation, fixture Fixture) []byte {\n193\t\tsp := bodySchema(op)\n194\t\n195\t\tif sp != nil {\n196\t\t\tif s := sp.Schema(); s != nil {\n197\t\t\t\tif v, ok := exampleValue(s); ok {\n198\t\t\t\t\treturn encode(v)\n199\t\t\t\t}\n200\t\t\t}\n201\t\t}\n202\t\n203\t\tif len(fixture.Body) > 0 {\n204\t\t\treturn compact(fixture.Body)\n205\t\t}\n206\t\n207\t\tif sp == nil {\n208\t\t\treturn nil\n209\t\t}\n210\t\n211\t\tv, ok := g.value(sp, 0, make(map[string]int))\n212\t\tif !ok {\n213\t\t\treturn nil\n214\t\t}\n215\t\n216\t\treturn encode(v)\n217\t}\n218\t\n219\t// bodySchema picks the media type to generate for: JSON if the operation\n220\t// accepts it, otherwise the first declared. Generation produces a Go value\n221\t// shaped for encoding/json, so a JSON media type is the one it can actually\n222\t// satisfy.\n223\tfunc bodySchema(op operation.Operation) *base.SchemaProxy {\n224\t\tif op.RequestBody == nil {\n225\t\t\treturn nil\n226\t\t}\n227\t\n228\t\tfor _, mt := range op.RequestBody.Content {\n229\t\t\tif strings.Contains(mt.ContentType, \"json\") {\n230\t\t\t\treturn mt.Schema\n231\t\t\t}\n232\t\t}\n233\t\n234\t\tif len(op.RequestBody.Content) > 0 {\n235\t\t\treturn op.RequestBody.Content[0].Schema\n236\t\t}\n237\t\n238\t\treturn nil\n239\t}\n240\t\n241\t// encode marshals a generated value. The value came from the generator or from\n242\t// a spec example that already round-tripped through YAML, so a marshalling\n243\t// failure is not a state the caller can act on: an empty body is the honest\n244\t// result.\n245\tfunc encode(v any) []byte {\n246\t\tout, err := json.Marshal(v)\n247\t\tif err != nil {\n248\t\t\treturn nil\n249\t\t}\n250\t\n251\t\treturn out\n252\t}\n253\t\n254\t// compact strips the formatting from a fixture body so two runs of the same\n255\t// fixture produce byte-identical requests regardless of how it was indented.\n256\tfunc compact(raw json.RawMessage) []byte {\n257\t\tvar buf bytes.Buffer\n258\t\tif err := json.Compact(&buf, raw); err != nil {\n259\t\t\treturn raw\n260\t\t}\n261\t\n262\t\treturn buf.Bytes()\n263\t}\n264\t\n265\t// scalarString renders a parameter value as the text that will travel in a URL\n266\t// or a header. Numbers decoded from a fixture arrive as float64, so 42 has to\n267\t// come back as \"42\" and not \"42.000000\" — a path segment is not the place to\n268\t// discover Go's default float formatting.\n269\tfunc scalarString(v any) string {\n270\t\tswitch t := v.(type) {\n271\t\tcase nil:\n272\t\t\treturn \"\"\n273\t\tcase string:\n274\t\t\treturn t\n275\t\tcase bool:\n276\t\t\treturn strconv.FormatBool(t)\n277\t\tcase float64:\n278\t\t\treturn strconv.FormatFloat(t, 'f', -1, 64)\n279\t\tcase int64:\n280\t\t\treturn strconv.FormatInt(t, 10)\n281\t\tcase int:\n282\t\t\treturn strconv.Itoa(t)\n283\t\tdefault:\n284\t\t\tif out, err := json.Marshal(t); err == nil {\n285\t\t\t\treturn string(out)\n286\t\t\t}\n287\t\n288\t\t\treturn fmt.Sprint(t)\n289\t\t}\n290\t}\n291\t"
      }
