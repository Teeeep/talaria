        "tool_use_id": "toolu_01RKpAUqRjTxYrwZAREFqwdn",
        "type": "tool_result",
        "content": "1\t// Package curl turns a bound request into curl: the displayable command\n2\t// `--dry-run` prints and every executed call reports, the config document curl\n3\t// actually reads, and the executor that spawns it (DESIGN.md §3.4).\n4\t//\n5\t// This file is symbolic. It reads request.Value's Symbolic and redacted forms\n6\t// and never calls SecretRef.Resolve, so an emitted command references\n7\t// $TALARIA_AUTH_BEARER rather than a token: \"runnable in a shell where the env\n8\t// var is set, useless to exfiltrate\" (§5a). Resolution happens in exactly one\n9\t// place, config.go's resolve, and nothing outside this package can reach it.\n10\tpackage curl\n11\t\n12\timport (\n13\t\t\"net/http\"\n14\t\t\"net/url\"\n15\t\t\"regexp\"\n16\t\t\"strings\"\n17\t\n18\t\t\"github.com/Teeeep/talaria/internal/request\"\n19\t)\n20\t\n21\t// Render returns the curl command that reproduces req: a portable, symbolic\n22\t// reproduction for bug reports, docs and scripts (§3.4).\n23\t//\n24\t// The URL comes last, the way the design's sketch and most hand-written curl\n25\t// put it, so a reader sees what is being called without scanning past the\n26\t// flags.\n27\tfunc Render(req *request.Request) string {\n28\t\tif req == nil {\n29\t\t\treturn \"\"\n30\t\t}\n31\t\n32\t\targs := []string{\"curl\", \"-s\"}\n33\t\t// GET is curl's default and naming it adds noise; anything else is worth\n34\t\t// seeing, and for a mutation it is the most important token in the line.\n35\t\tif req.Method != \"\" && !strings.EqualFold(req.Method, http.MethodGet) {\n36\t\t\targs = append(args, \"-X\", req.Method)\n37\t\t}\n38\t\n39\t\targs = append(args, headerArgs(req)...)\n40\t\tif cookies := cookieWord(req); cookies != nil {\n41\t\t\targs = append(args, \"-b\", cookies.String())\n42\t\t}\n43\t\targs = append(args, bodyArgs(req)...)\n44\t\targs = append(args, urlWord(req, request.Value.Symbolic).String())\n45\t\n46\t\treturn strings.Join(args, \" \")\n47\t}\n48\t\n49\t// URL renders req's URL the way a reader consumes it: percent-encoded like the\n50\t// wire form, but with credentials shown as <redacted:env:NAME> rather than\n51\t// percent-encoded into illegibility. It is what the `request.url` field of\n52\t// call's output carries (§5a: symbolic in emitted curl, redacted in output URL\n53\t// fields).\n54\t//\n55\t// request.Request.URL is the wire-correct counterpart, and is what the executor\n56\t// uses once it has resolved the credentials.\n57\tfunc URL(req *request.Request) string {\n58\t\tif req == nil {\n59\t\t\treturn \"\"\n60\t\t}\n61\t\n62\t\treturn urlWord(req, request.Value.String).plain()\n63\t}\n64\t\n65\t// headerArgs renders the request headers, with basic auth diverted to curl's\n66\t// own -u.\n67\tfunc headerArgs(req *request.Request) []string {\n68\t\tvar args []string\n69\t\tfor _, h := range req.Headers {\n70\t\t\t// A basic-auth header's text is base64(user:password), which cannot be\n71\t\t\t// produced without the credential. -u takes the raw user:password, so\n72\t\t\t// the command stays symbolic and still works when it is pasted.\n73\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n74\t\t\t\targs = append(args, \"-u\", (&word{}).credential(h.Value.Ref().Symbolic(), h.Value).String())\n75\t\t\t\tcontinue\n76\t\t\t}\n77\t\n78\t\t\targs = append(args, \"-H\", (&word{}).literal(h.Name+\": \").value(h.Value).String())\n79\t\t}\n80\t\n81\t\treturn args\n82\t}\n83\t\n84\t// cookieWord renders every cookie into one -b argument. curl keeps only the\n85\t// last -b of several, so the cookies are joined rather than repeated.\n86\tfunc cookieWord(req *request.Request) *word {\n87\t\tif len(req.Cookies) == 0 {\n88\t\t\treturn nil\n89\t\t}\n90\t\n91\t\tw := &word{}\n92\t\tfor i, c := range req.Cookies {\n93\t\t\tif i > 0 {\n94\t\t\t\tw.literal(\"; \")\n95\t\t\t}\n96\t\t\tw.literal(c.Name + \"=\").value(c.Value)\n97\t\t}\n98\t\n99\t\treturn w\n100\t}\n101\t\n102\t// bodyArgs renders the request body and the content type that describes it.\n103\t// --data-binary rather than --data because --data strips newlines, which\n104\t// changes the bytes a signed or whitespace-sensitive payload sends.\n105\tfunc bodyArgs(req *request.Request) []string {\n106\t\tif req.Body == nil {\n107\t\t\treturn nil\n108\t\t}\n109\t\n110\t\tvar args []string\n111\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n112\t\t\targs = append(args, \"-H\", (&word{}).literal(\"Content-Type: \"+req.Body.ContentType).String())\n113\t\t}\n114\t\n115\t\treturn append(args, \"--data-binary\", (&word{}).literal(string(req.Body.Data)).String())\n116\t}\n117\t\n118\tfunc hasHeader(req *request.Request, name string) bool {\n119\t\tfor _, h := range req.Headers {\n120\t\t\tif strings.EqualFold(h.Name, name) {\n121\t\t\t\treturn true\n122\t\t\t}\n123\t\t}\n124\t\n125\t\treturn false\n126\t}\n127\t\n128\t// urlWord builds the request URL as one shell word. render chooses how a\n129\t// credential in the query string appears — Symbolic for the emitted command,\n130\t// String for the redacted display form.\n131\t//\n132\t// Literal values are percent-encoded here rather than by request.QueryString\n133\t// because a percent-encoded $NAME would no longer be a reference the shell can\n134\t// expand. Encoding per value, instead of over the finished string, is what lets\n135\t// the two live in one URL.\n136\tfunc urlWord(req *request.Request, render func(request.Value) string) *word {\n137\t\tw := (&word{}).literal(req.BaseURL + req.Path)\n138\t\n139\t\tfor i, q := range req.Query {\n140\t\t\tseparator := \"&\"\n141\t\t\tif i == 0 {\n142\t\t\t\tseparator = \"?\"\n143\t\t\t}\n144\t\t\tw.literal(separator + url.QueryEscape(q.Name) + \"=\")\n145\t\n146\t\t\tif q.Value.IsSecret() {\n147\t\t\t\tw.credential(render(q.Value), q.Value)\n148\t\t\t\tcontinue\n149\t\t\t}\n150\t\t\tw.literal(url.QueryEscape(q.Value.String()))\n151\t\t}\n152\t\n153\t\treturn w\n154\t}\n155\t\n156\t// shellName matches an environment variable name a shell will expand from a\n157\t// bare $NAME. A ref whose name is not one of these is rendered redacted\n158\t// instead: an emitted command that stops being copy-pasteable is a better\n159\t// outcome than one that expands into something unintended.\n160\tvar shellName = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\n161\t\n162\t// part is one piece of a shell word. expand marks the pieces the shell is\n163\t// meant to act on — the credential references, and nothing else.\n164\ttype part struct {\n165\t\ttext   string\n166\t\texpand bool\n167\t}\n168\t\n169\t// word is one argument of the rendered command, assembled from literal text and\n170\t// credential references.\n171\t//\n172\t// The quoting rule follows from what each word contains. A word of pure literal\n173\t// text is single-quoted, which needs no escaping beyond the quote itself and\n174\t// leaves every $ and backtick inert. A word carrying a reference has to be\n175\t// double-quoted so the shell expands it, so its literal parts are escaped\n176\t// against the four characters double quotes still interpret.\n177\ttype word struct{ parts []part }\n178\t\n179\tfunc (w *word) literal(s string) *word {\n180\t\tif s != \"\" {\n181\t\t\tw.parts = append(w.parts, part{text: s})\n182\t\t}\n183\t\n184\t\treturn w\n185\t}\n186\t\n187\t// value appends a request value: the reference symbolically, or the literal\n188\t// text for a literal value.\n189\tfunc (w *word) value(v request.Value) *word {\n190\t\tif v.IsSecret() {\n191\t\t\treturn w.credential(v.Symbolic(), v)\n192\t\t}\n193\t\n194\t\treturn w.literal(v.String())\n195\t}\n196\t\n197\t// credential appends a rendered credential, marking it for expansion only when\n198\t// the shell can actually expand it back into the value. A basic-auth value, a\n199\t// redacted rendering, or a ref from a source that is not the environment all\n200\t// render as inert text.\n201\tfunc (w *word) credential(rendered string, v request.Value) *word {\n202\t\tif rendered == v.String() || !shellName.MatchString(v.Ref().Name) {\n203\t\t\treturn w.literal(rendered)\n204\t\t}\n205\t\n206\t\tw.parts = append(w.parts, part{text: rendered, expand: true})\n207\t\n208\t\treturn w\n209\t}\n210\t\n211\t// plain returns the word's text with no quoting, for the display fields that\n212\t// are read rather than run.\n213\tfunc (w *word) plain() string {\n214\t\tvar b strings.Builder\n215\t\tfor _, p := range w.parts {\n216\t\t\tb.WriteString(p.text)\n217\t\t}\n218\t\n219\t\treturn b.String()\n220\t}\n221\t\n222\t// String returns the word quoted for a shell.\n223\tfunc (w *word) String() string {\n224\t\texpands := false\n225\t\tfor _, p := range w.parts {\n226\t\t\tif p.expand {\n227\t\t\t\texpands = true\n228\t\t\t\tbreak\n229\t\t\t}\n230\t\t}\n231\t\n232\t\tif !expands {\n233\t\t\treturn \"'\" + strings.ReplaceAll(w.plain(), \"'\", `'\\''`) + \"'\"\n234\t\t}\n235\t\n236\t\tvar b strings.Builder\n237\t\tb.WriteByte('\"')\n238\t\tfor _, p := range w.parts {\n239\t\t\tif p.expand {\n240\t\t\t\tb.WriteString(p.text)\n241\t\t\t\tcontinue\n242\t\t\t}\n243\t\t\tb.WriteString(escapeInDoubleQuotes(p.text))\n244\t\t}\n245\t\tb.WriteByte('\"')\n246\t\n247\t\treturn b.String()\n248\t}\n249\t\n250\t// doubleQuoted escapes the characters a shell still interprets inside double\n251\t// quotes: command substitution, variable expansion, the quote itself and the\n252\t// escape.\n253\tvar doubleQuoted = strings.NewReplacer(\n254\t\t`\\`, `\\\\`,\n255\t\t`\"`, `\\\"`,\n256\t\t\"`\", \"\\\\`\",\n257\t\t`$`, `\\$`,\n258\t)\n259\t\n260\tfunc escapeInDoubleQuotes(s string) string { return doubleQuoted.Replace(s) }\n261\t"
