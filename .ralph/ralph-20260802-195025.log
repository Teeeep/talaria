{
  "type": "user",
  "message": {
    "role": "user",
    "content": [
      {
        "tool_use_id": "toolu_01FYcwzQwyS6G5U5zRK4sES2",
        "type": "tool_result",
        "content": "1\tpackage corpus\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io/fs\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"strings\"\n12\t)\n13\t\n14\t// EnvHistory switches recording off wherever talaria runs. It is read here\n15\t// rather than layered in with the profile settings because it is the operator's\n16\t// override: `history.enabled` is what a user configured, and this is what\n17\t// someone auditing a machine sets, so it wins over both.\n18\tconst EnvHistory = \"TALARIA_HISTORY\"\n19\t\n20\tconst (\n21\t\t// fileName is the store, one JSON entry per line, under the state directory.\n22\t\tfileName = \"history.jsonl\"\n23\t\t// maxPerSource is the retention cap, applied per Source rather than over the\n24\t\t// whole file: a single `run` over a large spec would otherwise evict every\n25\t\t// interactive call a session had made.\n26\t\tmaxPerSource = 1000\n27\t\n28\t\tdirMode  fs.FileMode = 0o700\n29\t\tfileMode fs.FileMode = 0o600\n30\t)\n31\t\n32\t// Store is the append-only history file.\n33\t//\n34\t// Failures from its methods are deliberately unclassified: a call that reached\n35\t// the server and came back is a success, and whether talaria managed to write\n36\t// the fact down afterwards is the caller's decision to report, not a reason to\n37\t// change the command's exit code.\n38\ttype Store struct {\n39\t\tdir     string\n40\t\tenabled bool\n41\t}\n42\t\n43\t// New returns a store writing under dir, recording only when enabled.\n44\t//\n45\t// An empty dir means the default state directory; tests pass a temporary one.\n46\t// The enabled flag is the profile's `history.enabled` as the caller resolved it\n47\t// — this package never reads the config itself, so that the twin can use the\n48\t// same store without one.\n49\tfunc New(dir string, enabled bool) *Store {\n50\t\treturn &Store{dir: dir, enabled: enabled}\n51\t}\n52\t\n53\t// Path is the history file's location.\n54\tfunc (s *Store) Path() (string, error) {\n55\t\tdir := \"\"\n56\t\tif s != nil {\n57\t\t\tdir = s.dir\n58\t\t}\n59\t\n60\t\tif dir == \"\" {\n61\t\t\tbase, err := stateDir()\n62\t\t\tif err != nil {\n63\t\t\t\treturn \"\", fmt.Errorf(\"cannot locate the talaria state directory: %w\", err)\n64\t\t\t}\n65\t\t\tdir = base\n66\t\t}\n67\t\n68\t\treturn filepath.Join(dir, fileName), nil\n69\t}\n70\t\n71\t// Recording reports whether Append will write anything, so a caller can skip\n72\t// building an entry it is only going to throw away.\n73\tfunc (s *Store) Recording() bool {\n74\t\tif s == nil || !s.enabled {\n75\t\t\treturn false\n76\t\t}\n77\t\n78\t\treturn !off(os.Getenv(EnvHistory))\n79\t}\n80\t\n81\t// Append records one entry and applies the retention cap.\n82\t//\n83\t// With recording off it does nothing at all — no file, no directory. An opt-out\n84\t// that still left a history file behind would not be one.\n85\tfunc (s *Store) Append(e Entry) error {\n86\t\tif !s.Recording() {\n87\t\t\treturn nil\n88\t\t}\n89\t\n90\t\tpath, err := s.Path()\n91\t\tif err != nil {\n92\t\t\treturn err\n93\t\t}\n94\t\n95\t\tline, err := json.Marshal(e)\n96\t\tif err != nil {\n97\t\t\treturn fmt.Errorf(\"cannot encode the history entry: %w\", err)\n98\t\t}\n99\t\n100\t\tif err := write(path, append(line, '\\n')); err != nil {\n101\t\t\treturn err\n102\t\t}\n103\t\n104\t\treturn trim(path)\n105\t}\n106\t\n107\t// Read returns every readable entry, oldest first.\n108\t//\n109\t// It does not consult the recording setting: history written before recording\n110\t// was switched off is still history, and reading it puts nothing new on disk.\n111\t// A store that was never written is empty rather than an error.\n112\tfunc (s *Store) Read() ([]Entry, error) {\n113\t\tpath, err := s.Path()\n114\t\tif err != nil {\n115\t\t\treturn nil, err\n116\t\t}\n117\t\n118\t\tdata, err := os.ReadFile(path)\n119\t\tif errors.Is(err, fs.ErrNotExist) {\n120\t\t\treturn nil, nil\n121\t\t}\n122\t\tif err != nil {\n123\t\t\treturn nil, fmt.Errorf(\"cannot read the history file: %w\", err)\n124\t\t}\n125\t\n126\t\tvar entries []Entry\n127\t\tfor _, line := range lines(data) {\n128\t\t\tvar entry Entry\n129\t\t\t// A line that will not parse is skipped rather than fatal. The file is\n130\t\t\t// appended to by every call, so a process killed mid-write leaves a\n131\t\t\t// partial last line, and losing every earlier entry to it would make the\n132\t\t\t// store fragile exactly when something has already gone wrong.\n133\t\t\tif err := json.Unmarshal(line, &entry); err != nil {\n134\t\t\t\tcontinue\n135\t\t\t}\n136\t\t\tentries = append(entries, entry)\n137\t\t}\n138\t\n139\t\treturn entries, nil\n140\t}\n141\t\n142\t// write appends one line, creating the directory and the file with the modes\n143\t// DESIGN.md §5a requires of talaria's highest-risk artifact.\n144\tfunc write(path string, line []byte) error {\n145\t\tdir := filepath.Dir(path)\n146\t\tif err := os.MkdirAll(dir, dirMode); err != nil {\n147\t\t\treturn fmt.Errorf(\"cannot create the history directory: %w\", err)\n148\t\t}\n149\t\t// MkdirAll leaves an existing directory's mode alone and gives a new one\n150\t\t// dirMode masked by the umask. The Chmod makes 0700 a guarantee rather than\n151\t\t// an inherited default.\n152\t\tif err := os.Chmod(dir, dirMode); err != nil {\n153\t\t\treturn fmt.Errorf(\"cannot secure the history directory: %w\", err)\n154\t\t}\n155\t\n156\t\tf, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, fileMode)\n157\t\tif err != nil {\n158\t\t\treturn fmt.Errorf(\"cannot open the history file: %w\", err)\n159\t\t}\n160\t\tif err := f.Chmod(fileMode); err != nil {\n161\t\t\tf.Close() //nolint:errcheck // The Chmod failure is the one worth reporting.\n162\t\t\treturn fmt.Errorf(\"cannot secure the history file: %w\", err)\n163\t\t}\n164\t\tif _, err := f.Write(line); err != nil {\n165\t\t\tf.Close() //nolint:errcheck // The Write failure is the one worth reporting.\n166\t\t\treturn fmt.Errorf(\"cannot write the history entry: %w\", err)\n167\t\t}\n168\t\n169\t\tif err := f.Close(); err != nil {\n170\t\t\treturn fmt.Errorf(\"cannot write the history entry: %w\", err)\n171\t\t}\n172\t\n173\t\treturn nil\n174\t}\n175\t\n176\t// trim enforces the per-source cap, rewriting the file only when some source is\n177\t// over it. The common append leaves the file alone.\n178\tfunc trim(path string) error {\n179\t\tdata, err := os.ReadFile(path)\n180\t\tif err != nil {\n181\t\t\treturn fmt.Errorf(\"cannot read the history file: %w\", err)\n182\t\t}\n183\t\n184\t\tall := lines(data)\n185\t\tsources := make([]Source, len(all))\n186\t\treadable := make([]bool, len(all))\n187\t\tcounts := map[Source]int{}\n188\t\tfor i, line := range all {\n189\t\t\tsource, ok := lineSource(line)\n190\t\t\tsources[i], readable[i] = source, ok\n191\t\t\tif ok {\n192\t\t\t\tcounts[source]++\n193\t\t\t}\n194\t\t}\n195\t\n196\t\tdrop := map[Source]int{}\n197\t\tfor source, n := range counts {\n198\t\t\tif n > maxPerSource {\n199\t\t\t\tdrop[source] = n - maxPerSource\n200\t\t\t}\n201\t\t}\n202\t\tif len(drop) == 0 {\n203\t\t\treturn nil\n204\t\t}\n205\t\n206\t\t// Oldest first: the file is in append order, so dropping the first n lines\n207\t\t// of an over-cap source keeps the newest maxPerSource of it, and every other\n208\t\t// source stays exactly where it was.\n209\t\tvar kept bytes.Buffer\n210\t\tfor i, line := range all {\n211\t\t\tif !readable[i] {\n212\t\t\t\t// The rewrite is the one moment a line nothing can parse can be\n213\t\t\t\t// dropped without losing anything Read would have returned.\n214\t\t\t\tcontinue\n215\t\t\t}\n216\t\t\tif drop[sources[i]] > 0 {\n217\t\t\t\tdrop[sources[i]]--\n218\t\t\t\tcontinue\n219\t\t\t}\n220\t\t\tkept.Write(line)\n221\t\t\tkept.WriteByte('\\n')\n222\t\t}\n223\t\n224\t\treturn replace(path, kept.Bytes())\n225\t}\n226\t\n227\t// replace swaps the file's contents atomically, so a reader never sees a\n228\t// half-written store and a crash mid-trim leaves the old file intact.\n229\tfunc replace(path string, data []byte) error {\n230\t\tdir := filepath.Dir(path)\n231\t\n232\t\ttmp, err := os.CreateTemp(dir, \".history-*\")\n233\t\tif err != nil {\n234\t\t\treturn fmt.Errorf(\"cannot stage the trimmed history: %w\", err)\n235\t\t}\n236\t\t// A no-op once the rename has happened, and the cleanup for every path where\n237\t\t// it has not.\n238\t\tdefer os.Remove(tmp.Name()) //nolint:errcheck // Best effort; the file is 0600 in the state dir.\n239\t\n240\t\t// CreateTemp already opens at 0600; the Chmod makes that a stated guarantee\n241\t\t// rather than an inherited default.\n242\t\tif err := tmp.Chmod(fileMode); err != nil {\n243\t\t\ttmp.Close() //nolint:errcheck // The Chmod failure is the one worth reporting.\n244\t\t\treturn fmt.Errorf(\"cannot secure the trimmed history: %w\", err)\n245\t\t}\n246\t\tif _, err := tmp.Write(data); err != nil {\n247\t\t\ttmp.Close() //nolint:errcheck // The Write failure is the one worth reporting.\n248\t\t\treturn fmt.Errorf(\"cannot write the trimmed history: %w\", err)\n249\t\t}\n250\t\tif err := tmp.Close(); err != nil {\n251\t\t\treturn fmt.Errorf(\"cannot write the trimmed history: %w\", err)\n252\t\t}\n253\t\n254\t\tif err := os.Rename(tmp.Name(), path); err != nil {\n255\t\t\treturn fmt.Errorf(\"cannot replace the history file: %w\", err)\n256\t\t}\n257\t\n258\t\treturn nil\n259\t}\n260\t\n261\t// lineSource reads just the source off a stored line, reporting whether the\n262\t// line parses at all. Trimming works from the raw bytes rather than from decoded\n263\t// entries so a rewrite reproduces what was written, byte for byte.\n264\tfunc lineSource(line []byte) (Source, bool) {\n265\t\tvar head struct {\n266\t\t\tSource Source `json:\"source\"`\n267\t\t}\n268\t\tif err := json.Unmarshal(line, &head); err != nil {\n269\t\t\treturn \"\", false\n270\t\t}\n271\t\n272\t\treturn head.Source, true\n273\t}\n274\t\n275\t// lines splits the store into its non-empty lines.\n276\tfunc lines(data []byte) [][]byte {\n277\t\tvar out [][]byte\n278\t\tfor _, line := range bytes.Split(data, []byte(\"\\n\")) {\n279\t\t\tif len(bytes.TrimSpace(line)) == 0 {\n280\t\t\t\tcontinue\n281\t\t\t}\n282\t\t\tout = append(out, line)\n283\t\t}\n284\t\n285\t\treturn out\n286\t}\n287\t\n288\t// stateDir is $XDG_STATE_HOME/talaria, falling back to ~/.local/state/talaria.\n289\t// The lookup is spelled out because Go's os package has no UserStateDir; the\n290\t// fallback is the one the XDG spec itself names. A relative XDG_STATE_HOME is\n291\t// ignored, as the spec requires.\n292\tfunc stateDir() (string, error) {\n293\t\tif dir := os.Getenv(\"XDG_STATE_HOME\"); filepath.IsAbs(dir) {\n294\t\t\treturn filepath.Join(dir, \"talaria\"), nil\n295\t\t}\n296\t\n297\t\thome, err := os.UserHomeDir()\n298\t\tif err != nil {\n299\t\t\treturn \"\", err\n300\t\t}\n301\t\n302\t\treturn filepath.Join(home, \".local\", \"state\", \"talaria\"), nil\n303\t}\n304\t\n305\t// off reports whether a TALARIA_HISTORY value switches recording off. The\n306\t// variable has no other job, so every plausible spelling of \"no\" counts;\n307\t// anything else — including an empty value — leaves the caller's setting in\n308\t// force. Guessing wrong in this direction records nothing, which is the safe\n309\t// way to be wrong about a store of credentials-adjacent data.\n310\tfunc off(value string) bool {\n311\t\tswitch strings.ToLower(strings.TrimSpace(value)) {\n312\t\tcase \"off\", \"0\", \"false\", \"no\":\n313\t\t\treturn true\n314\t\t}\n315\t\n316\t\treturn false\n317\t}\n318\t"
      }
