8-\tHeaders map[string]string `json:\"headers,omitempty\"`\ninternal/corpus/entry.go-69-\tCookies map[string]string `json:\"cookies,omitempty\"`\ninternal/corpus/entry.go-70-\tBody    *Body             `json:\"body,omitempty\"`\ninternal/corpus/entry.go-71-}\ninternal/corpus/entry.go-72-\ninternal/corpus/entry.go-73-// EntryResponse is the redacted response. Headers keep their repetitions, since\ninternal/corpus/entry.go-74-// Set-Cookie legitimately appears more than once.\ninternal/corpus/entry.go:75:type EntryResponse struct {\ninternal/corpus/entry.go-76-\tStatus   int                 `json:\"status\"`\ninternal/corpus/entry.go-77-\tHeaders  map[string][]string `json:\"headers,omitempty\"`\ninternal/corpus/entry.go-78-\tBody     *Body               `json:\"body,omitempty\"`\ninternal/corpus/entry.go-79-\tTimingMS int64               `json:\"timing_ms\"`\ninternal/corpus/entry.go-80-}\ninternal/corpus/entry.go-81-\ninternal/corpus/entry.go-82-// Body is a recorded body and how much of it was kept.\ninternal/corpus/entry.go-83-type Body struct {\ninternal/corpus/entry.go-84-\tContentType string `json:\"content_type,omitempty\"`\ninternal/corpus/entry.go-85-\tData        string `json:\"data\"`\ninternal/corpus/entry.go-86-\t// Truncated reports that Data is the first MaxBody bytes and not the whole\ninternal/corpus/entry.go-87-\t// body. It is explicit so a reader never mistakes a cut body for what the\ninternal/corpus/entry.go-88-\t// server sent.\ninternal/corpus/entry.go-89-\tTruncated bool `json:\"truncated,omitempty\"`\ninternal/corpus/entry.go-90-}\ninternal/corpus/entry.go-91-\ninternal/corpus/entry.go-92-// Redactors are the two firewalls an entry passes through on its way to disk.\ninternal/corpus/entry.go-93-// Both are nil-safe: the zero Redactors applies the built-in lists, so a caller\ninternal/corpus/entry.go-94-// that forgets to configure them records less rather than more.\ninternal/corpus/entry.go-95-type Redactors struct {\ninternal/corpus/entry.