    "content": [
      {
        "tool_use_id": "toolu_01MMeUKqfZQTEndFi7pzycu3",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"io\"\n6\t\t\"net/url\"\n7\t\t\"sort\"\n8\t\t\"strconv\"\n9\t\t\"strings\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/spf13/cobra\"\n13\t\n14\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n15\t\t\"github.com/Teeeep/talaria/internal/config\"\n16\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n17\t\t\"github.com/Teeeep/talaria/internal/curl\"\n18\t\t\"github.com/Teeeep/talaria/internal/operation\"\n19\t\t\"github.com/Teeeep/talaria/internal/output\"\n20\t\t\"github.com/Teeeep/talaria/internal/request\"\n21\t\t\"github.com/Teeeep/talaria/internal/secret\"\n22\t)\n23\t\n24\t// historyEntryView is one line of `history`: enough to recognise a call and its\n25\t// index, and nothing more. The whole entry is what `history show` is for.\n26\ttype historyEntryView struct {\n27\t\t// Index is the entry's position in the whole store, newest first and\n28\t\t// 1-based. It is *not* its position in a filtered list: it is the number\n29\t\t// `history show` and `history replay` take, so filtering must not renumber\n30\t\t// it.\n31\t\tIndex       int       `json:\"index\"`\n32\t\tTimestamp   time.Time `json:\"timestamp\"`\n33\t\tSource      string    `json:\"source\"`\n34\t\tOperationID string    `json:\"operation_id,omitempty\"`\n35\t\tMethod      string    `json:\"method\"`\n36\t\t// Path is the URL's path, which is what identifies a call at a glance; URL\n37\t\t// carries the rest for anyone who needs it.\n38\t\tPath   string `json:\"path\"`\n39\t\tURL    string `json:\"url\"`\n40\t\tStatus int    `json:\"status,omitempty\"`\n41\t\t// TimingMS is omitted along with Status for an entry that observed no\n42\t\t// response, rather than reported as a zero that reads like a fast call.\n43\t\tTimingMS int64 `json:\"timing_ms,omitempty\"`\n44\t}\n45\t\n46\t// historyListView is the `history` payload.\n47\ttype historyListView struct {\n48\t\tEntries []historyEntryView `json:\"entries\"`\n49\t}\n50\t\n51\t// historyShowView is the `history show` payload: one entry exactly as stored,\n52\t// alongside the index it was asked for.\n53\ttype historyShowView struct {\n54\t\tIndex int          `json:\"index\"`\n55\t\tEntry corpus.Entry `json:\"entry\"`\n56\t}\n57\t\n58\t// historyFilter is the set of `history` flags, parsed. A nil field is a filter\n59\t// the caller did not ask for.\n60\ttype historyFilter struct {\n61\t\toperation string\n62\t\tsource    corpus.Source\n63\t\tsince     *time.Time\n64\t\tstatus    *statusFilter\n65\t}\n66\t\n67\t// statusFilter is `--status`: either an exact code or a class such as 4xx.\n68\ttype statusFilter struct {\n69\t\tlow, high int\n70\t}\n71\t\n72\t// matches reports whether a status falls in the filter's range.\n73\tfunc (s statusFilter) matches(status int) bool {\n74\t\treturn status >= s.low && status <= s.high\n75\t}\n76\t\n77\tfunc newHistoryCmd() *cobra.Command {\n78\t\tvar (\n79\t\t\toperationID string\n80\t\t\tsource      string\n81\t\t\tsince       string\n82\t\t\tstatus      string\n83\t\t)\n84\t\n85\t\tcmd := &cobra.Command{\n86\t\t\tUse:   \"history\",\n87\t\t\tShort: \"List what talaria has already called and what came back\",\n88\t\t\tLong: \"List the recorded request/response pairs, newest first. Everything here\\n\" +\n89\t\t\t\t\"was written redacted: a credential was never stored, so none can be read\\n\" +\n90\t\t\t\t\"back. Recording is switched off per profile with `history.enabled: false`\\n\" +\n91\t\t\t\t\"or everywhere with TALARIA_HISTORY=off.\",\n92\t\t\tArgs: usageArgs(cobra.NoArgs),\n93\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n94\t\t\t\tformat, err := resolveFormat(cmd)\n95\t\t\t\tif err != nil {\n96\t\t\t\t\treturn err\n97\t\t\t\t}\n98\t\n99\t\t\t\tfilter, err := parseHistoryFilter(operationID, source, since, status)\n100\t\t\t\tif err != nil {\n101\t\t\t\t\treturn err\n102\t\t\t\t}\n103\t\n104\t\t\t\tentries, err := loadHistory(cmd)\n105\t\t\t\tif err != nil {\n106\t\t\t\t\treturn err\n107\t\t\t\t}\n108\t\n109\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(historyPayload(entries, filter))\n110\t\t\t},\n111\t\t}\n112\t\n113\t\tcmd.Flags().StringVar(&operationID, \"operation\", \"\",\n114\t\t\t\"only entries for this operationId\")\n115\t\tcmd.Flags().StringVar(&since, \"since\", \"\",\n116\t\t\t\"only entries newer than a duration ago, e.g. 1h or 30m\")\n117\t\tcmd.Flags().StringVar(&status, \"status\", \"\",\n118\t\t\t\"only entries with this response status: an exact code (404) or a class (4xx)\")\n119\t\tcmd.Flags().StringVar(&source, \"source\", \"\",\n120\t\t\t\"only entries from this command: \"+strings.Join(historySources(), \"|\"))\n121\t\n122\t\tcmd.AddCommand(newHistoryShowCmd())\n123\t\tcmd.AddCommand(newHistoryReplayCmd())\n124\t\n125\t\treturn cmd\n126\t}\n127\t\n128\tfunc newHistoryShowCmd() *cobra.Command {\n129\t\treturn &cobra.Command{\n130\t\t\tUse:   \"show <n>\",\n131\t\t\tShort: \"Print one recorded request and response in full\",\n132\t\t\tLong: \"Print the whole of one entry: the request as it was sent and the response\\n\" +\n133\t\t\t\t\"as it came back, both redacted. The index is the one `history` prints.\",\n134\t\t\tArgs: usageArgs(cobra.ExactArgs(1)),\n135\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n136\t\t\t\tformat, err := resolveFormat(cmd)\n137\t\t\t\tif err != nil {\n138\t\t\t\t\treturn err\n139\t\t\t\t}\n140\t\n141\t\t\t\tentries, err := loadHistory(cmd)\n142\t\t\t\tif err != nil {\n143\t\t\t\t\treturn err\n144\t\t\t\t}\n145\t\n146\t\t\t\tindex, entry, err := selectEntry(entries, args[0])\n147\t\t\t\tif err != nil {\n148\t\t\t\t\treturn err\n149\t\t\t\t}\n150\t\n151\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(historyShowPayload(index, entry))\n152\t\t\t},\n153\t\t}\n154\t}\n155\t\n156\tfunc newHistoryReplayCmd() *cobra.Command {\n157\t\tvar allowMutations bool\n158\t\n159\t\tcmd := &cobra.Command{\n160\t\t\tUse:   \"replay <n>\",\n161\t\t\tShort: \"Re-issue a recorded call\",\n162\t\t\tLong: \"Send a recorded request again, to the URL it went to, and record the\\n\" +\n163\t\t\t\t\"result as a new entry. Credentials are resolved from the environment as\\n\" +\n164\t\t\t\t\"they were the first time — history holds their names, never their values,\\n\" +\n165\t\t\t\t\"so there is nothing there to read back.\",\n166\t\t\tArgs: usageArgs(cobra.ExactArgs(1)),\n167\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n168\t\t\t\tformat, err := resolveFormat(cmd)\n169\t\t\t\tif err != nil {\n170\t\t\t\t\treturn err\n171\t\t\t\t}\n172\t\n173\t\t\t\tcfg, err := config.Load(\"\")\n174\t\t\t\tif err != nil {\n175\t\t\t\t\treturn err\n176\t\t\t\t}\n177\t\n178\t\t\t\tstore, err := openHistory(cmd, cfg)\n179\t\t\t\tif err != nil {\n180\t\t\t\t\treturn err\n181\t\t\t\t}\n182\t\n183\t\t\t\tentries, err := store.Read()\n184\t\t\t\tif err != nil {\n185\t\t\t\t\treturn err\n186\t\t\t\t}\n187\t\n188\t\t\t\t_, entry, err := selectEntry(entries, args[0])\n189\t\t\t\tif err != nil {\n190\t\t\t\t\treturn err\n191\t\t\t\t}\n192\t\n193\t\t\t\t// The same gate `call` applies, for the same reason: the method is what\n194\t\t\t\t// makes a request dangerous, and a recorded POST is still a POST.\n195\t\t\t\tif (operation.Operation{Method: entry.Method}).IsMutation() && !allowMutations {\n196\t\t\t\t\treturn clierr.Usage(\n197\t\t\t\t\t\t\"entry %s is a %s request and may change server state: pass --allow-mutations to replay it\",\n198\t\t\t\t\t\targs[0], entry.Method)\n199\t\t\t\t}\n200\t\n201\t\t\t\treq, err := replayRequest(cmd.ErrOrStderr(), entry)\n202\t\t\t\tif err != nil {\n203\t\t\t\t\treturn err\n204\t\t\t\t}\n205\t\n206\t\t\t\trenderer := output.New(format, cmd.OutOrStdout())\n207\t\t\t\tredactors := newRedactors(cfg)\n208\t\n209\t\t\t\tresp, execErr := curl.Execute(req)\n210\t\t\t\trecordCall(cmd.ErrOrStderr(), store, corpus.SourceReplay, req, resp, redactors)\n211\t\t\t\tif execErr != nil {\n212\t\t\t\t\treturn execErr\n213\t\t\t\t}\n214\t\n215\t\t\t\t// No validation block: replay reads a recorded request and needs no\n216\t\t\t\t// spec to send one, so there is no contract here to check against.\n217\t\t\t\treturn renderer.Render(callPayload(req, redactResponse(resp, redactors.Response), nil))\n218\t\t\t},\n219\t\t}\n220\t\n221\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n222\t\t\t\"permit replaying a method other than GET, HEAD or OPTIONS\")\n223\t\n224\t\treturn cmd\n225\t}\n226\t\n227\t// openHistory builds the store with the recording setting the selected profile\n228\t// asks for. Reading never consults it — history written before recording was\n229\t// switched off is still history — but replay writes, so it has to be right.\n230\tfunc openHistory(cmd *cobra.Command, cfg *config.Config) (*corpus.Store, error) {\n231\t\tprof, err := selectProfile(cmd, cfg)\n232\t\tif err != nil {\n233\t\t\treturn nil, err\n234\t\t}\n235\t\n236\t\t// The empty dir is the default state directory; internal/corpus locates it.\n237\t\treturn corpus.New(\"\", prof.HistoryEnabled()), nil\n238\t}\n239\t\n240\t// loadHistory loads the store for a read-only command. The profile still\n241\t// decides the Enabled flag so the store is constructed the one way, but nothing\n242\t// on this path writes.\n243\tfunc loadHistory(cmd *cobra.Command) ([]corpus.Entry, error) {\n244\t\tcfg, err := config.Load(\"\")\n245\t\tif err != nil {\n246\t\t\treturn nil, err\n247\t\t}\n248\t\n249\t\tstore, err := openHistory(cmd, cfg)\n250\t\tif err != nil {\n251\t\t\treturn nil, err\n252\t\t}\n253\t\n254\t\treturn store.Read()\n255\t}\n256\t\n257\t// historyPayload renders the store newest first, keeping the entries the filter\n258\t// admits and the index each had before filtering.\n259\tfunc historyPayload(entries []corpus.Entry, filter historyFilter) output.Payload {\n260\t\tview := historyListView{Entries: []historyEntryView{}}\n261\t\trows := [][]string{}\n262\t\n263\t\t// The store is oldest first, so walking it backwards is both the display\n264\t\t// order and the index order.\n265\t\tfor i := len(entries) - 1; i >= 0; i-- {\n266\t\t\tentry := entries[i]\n267\t\t\tif !filter.admits(entry) {\n268\t\t\t\tcontinue\n269\t\t\t}\n270\t\n271\t\t\tline := newHistoryEntryView(len(entries)-i, entry)\n272\t\t\tview.Entries = append(view.Entries, line)\n273\t\t\trows = append(rows, []string{\n274\t\t\t\tstrconv.Itoa(line.Index),\n275\t\t\t\tline.Timestamp.Format(time.RFC3339),\n276\t\t\t\tstring(line.Source),\n277\t\t\t\tline.Method,\n278\t\t\t\tline.Path,\n279\t\t\t\tstatusCell(line.Status),\n280\t\t\t\tline.OperationID,\n281\t\t\t})\n282\t\t}\n283\t\n284\t\treturn output.Payload{\n285\t\t\tData: view,\n286\t\t\tTable: output.Table{\n287\t\t\t\tHeaders: []string{\"#\", \"WHEN\", \"SOURCE\", \"METHOD\", \"PATH\", \"STATUS\", \"OPERATION\"},\n288\t\t\t\tRows:    rows,\n289\t\t\t},\n290\t\t}\n291\t}\n292\t\n293\tfunc newHistoryEntryView(index int, entry corpus.Entry) historyEntryView {\n294\t\tview := historyEntryView{\n295\t\t\tIndex:       index,\n296\t\t\tTimestamp:   entry.Timestamp,\n297\t\t\tSource:      string(entry.Source),\n298\t\t\tOperationID: entry.OperationID,\n299\t\t\tMethod:      entry.Method,\n300\t\t\tPath:        urlPath(entry.URL),\n301\t\t\tURL:         entry.URL,\n302\t\t}\n303\t\tif entry.Response != nil {\n304\t\t\tview.Status = entry.Response.Status\n305\t\t\tview.TimingMS = entry.Response.TimingMS\n306\t\t}\n307\t\n308\t\treturn view\n309\t}\n310\t\n311\tfunc historyShowPayload(index int, entry corpus.Entry) output.Payload {\n312\t\trows := [][]string{\n313\t\t\t{entry.Method + \" \" + entry.URL},\n314\t\t}\n315\t\tfor _, name := range sortedKeys(entry.Request.Headers) {\n316\t\t\trows = append(rows, []string{name + \": \" + entry.Request.Headers[name]})\n317\t\t}\n318\t\tif entry.Request.Body != nil {\n319\t\t\trows = append(rows, []string{bodyLine(entry.Request.Body)})\n320\t\t}\n321\t\tif entry.Response != nil {\n322\t\t\trows = append(rows, []string{fmt.Sprintf(\"%d in %dms\", entry.Response.Status, entry.Response.TimingMS)})\n323\t\t\tif entry.Response.Body != nil {\n324\t\t\t\trows = append(rows, []string{bodyLine(entry.Response.Body)})\n325\t\t\t}\n326\t\t}\n327\t\n328\t\treturn output.Payload{\n329\t\t\tData:  historyShowView{Index: index, Entry: entry},\n330\t\t\tTable: output.Table{Rows: rows},\n331\t\t}\n332\t}\n333\t\n334\t// bodyLine renders a recorded body for a human. A body with no encoding is the\n335\t// text that was sent and prints as itself; anything else is not text, and\n336\t// printing its stored form would claim bytes went on the wire that did not. The\n337\t// summary says how big it was and how to get at it — `--output json` carries the\n338\t// entry as recorded, encoding and all.\n339\tfunc bodyLine(body *corpus.Body) string {\n340\t\tif body.Encoding == \"\" {\n341\t\t\treturn body.Data\n342\t\t}\n343\t\n344\t\tdata, err := body.Bytes()\n345\t\tif err != nil {\n346\t\t\treturn fmt.Sprintf(\"<body with unreadable %s encoding: %v>\", body.Encoding, err)\n347\t\t}\n348\t\n349\t\treturn fmt.Sprintf(\"<binary body, %d bytes, %s in --output json>\", len(data), body.Encoding)\n350\t}\n351\t\n352\t// statusCell renders the status column, which is empty for an entry that\n353\t// observed no response rather than a 0 nobody's server returned.\n354\tfunc statusCell(status int) string {\n355\t\tif status == 0 {\n356\t\t\treturn \"-\"\n357\t\t}\n358\t\n359\t\treturn strconv.Itoa(status)\n360\t}\n361\t\n362\t// urlPath is the path component of a recorded URL, for the list's path column.\n363\t// A URL that will not parse — nothing writes one, but the store is a file on\n364\t// disk — degrades to itself rather than to nothing.\n365\tfunc urlPath(raw string) string {\n366\t\tparsed, err := url.Parse(raw)\n367\t\tif err != nil {\n368\t\t\treturn raw\n369\t\t}\n370\t\n371\t\treturn parsed.EscapedPath()\n372\t}\n373\t\n374\t// selectEntry resolves a 1-based, newest-first index against the store.\n375\t//\n376\t// Both failures are usage errors carrying what the caller can do instead: the\n377\t// valid range, or the fact that there is no history yet. An agent that guessed\n378\t// an index corrects itself from the message without a second command.\n379\tfunc selectEntry(entries []corpus.Entry, arg string) (int, corpus.Entry, error) {\n380\t\tindex, err := strconv.Atoi(arg)\n381\t\tif err != nil {\n382\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\"history index %q is not a number\", arg)\n383\t\t}\n384\t\n385\t\tif len(entries) == 0 {\n386\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\"no history entry %d: the history is empty\", index)\n387\t\t}\n388\t\tif index < 1 || index > len(entries) {\n389\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\n390\t\t\t\t\"no history entry %d: the valid range is 1-%d\", index, len(entries))\n391\t\t}\n392\t\n393\t\treturn index, entries[len(entries)-index], nil\n394\t}\n395\t\n396\t// admits reports whether an entry survives every filter that was asked for.\n397\tfunc (f historyFilter) admits(entry corpus.Entry) bool {\n398\t\tif f.operation != \"\" && entry.OperationID != f.operation {\n399\t\t\treturn false\n400\t\t}\n401\t\tif f.source != \"\" && entry.Source != f.source {\n402\t\t\treturn false\n403\t\t}\n404\t\tif f.since != nil && entry.Timestamp.Before(*f.since) {\n405\t\t\treturn false\n406\t\t}\n407\t\tif f.status != nil {\n408\t\t\t// An entry with no response has no status to match, so a status filter\n409\t\t\t// excludes it rather than matching it as a zero.\n410\t\t\tif entry.Response == nil || !f.status.matches(entry.Response.Status) {\n411\t\t\t\treturn false\n412\t\t\t}\n413\t\t}\n414\t\n415\t\treturn true\n416\t}\n417\t\n418\t// parseHistoryFilter turns the flags into a filter, failing with exit 2 on\n419\t// anything it cannot read. Parsing happens before the store is opened so a\n420\t// typo is reported without touching the disk.\n421\tfunc parseHistoryFilter(operationID, source, since, status string) (historyFilter, error) {\n422\t\tfilter := historyFilter{operation: operationID}\n423\t\n424\t\tif source != \"\" {\n425\t\t\tparsed, err := parseSource(source)\n426\t\t\tif err != nil {\n427\t\t\t\treturn historyFilter{}, err\n428\t\t\t}\n429\t\t\tfilter.source = parsed\n430\t\t}\n431\t\n432\t\tif since != \"\" {\n433\t\t\tage, err := time.ParseDuration(since)\n434\t\t\tif err != nil || age < 0 {\n435\t\t\t\treturn historyFilter{}, clierr.Usage(\n436\t\t\t\t\t\"cannot read --since %q: give a duration such as 30m, 1h or 7d as 168h\", since)\n437\t\t\t}\n438\t\t\tcutoff := time.Now().Add(-age)\n439\t\t\tfilter.since = &cutoff\n440\t\t}\n441\t\n442\t\tif status != \"\" {\n443\t\t\tparsed, err := parseStatusFilter(status)\n444\t\t\tif err != nil {\n445\t\t\t\treturn historyFilter{}, err\n446\t\t\t}\n447\t\t\tfilter.status = parsed\n448\t\t}\n449\t\n450\t\treturn filter, nil\n451\t}\n452\t\n453\t// parseSource reads --source, offering the valid values on a miss.\n454\tfunc parseSource(value string) (corpus.Source, error) {\n455\t\tfor _, source := range historySources() {\n456\t\t\tif strings.EqualFold(value, source) {\n457\t\t\t\treturn corpus.Source(source), nil\n458\t\t\t}\n459\t\t}\n460\t\n461\t\treturn \"\", clierr.Usage(\"no history source %q\", value).WithAlternatives(historySources()...)\n462\t}\n463\t\n464\t// historySources is the set of commands that write to the store, in the order\n465\t// they are worth reading about.\n466\tfunc historySources() []string {\n467\t\treturn []string{string(corpus.SourceCall), string(corpus.SourceRun), string(corpus.SourceReplay)}\n468\t}\n469\t\n470\t// parseStatusFilter reads --status: an exact code, or a class with x in place\n471\t// of the digits that vary.\n472\tfunc parseStatusFilter(value string) (*statusFilter, error) {\n473\t\tconst bad = \"cannot read --status %q: give an exact code such as 404 or a class such as 4xx\"\n474\t\n475\t\ttrimmed := strings.ToLower(strings.TrimSpace(value))\n476\t\tif len(trimmed) != 3 {\n477\t\t\treturn nil, clierr.Usage(bad, value)\n478\t\t}\n479\t\n480\t\tif strings.HasSuffix(trimmed, \"xx\") {\n481\t\t\tclass, err := strconv.Atoi(trimmed[:1])\n482\t\t\tif err != nil || class < 1 || class > 9 {\n483\t\t\t\treturn nil, clierr.Usage(bad, value)\n484\t\t\t}\n485\t\n486\t\t\treturn &statusFilter{low: class * 100, high: class*100 + 99}, nil\n487\t\t}\n488\t\n489\t\tcode, err := strconv.Atoi(trimmed)\n490\t\tif err != nil {\n491\t\t\treturn nil, clierr.Usage(bad, value)\n492\t\t}\n493\t\n494\t\treturn &statusFilter{low: code, high: code}, nil\n495\t}\n496\t\n497\t// replayRequest rebuilds a runnable request from a stored entry.\n498\t//\n499\t// Every credential position in the entry holds `<redacted:env:NAME>`, which\n500\t// becomes a reference again here — the value is resolved from the environment\n501\t// at exec time, exactly as it was on the original call. Nothing in this function\n502\t// reads a credential, because there is none in the store to read (§5a).\n503\tfunc replayRequest(stderr io.Writer, entry corpus.Entry) (*request.Request, error) {\n504\t\tparsed, err := url.Parse(entry.URL)\n505\t\tif err != nil {\n506\t\t\treturn nil, clierr.Usage(\"the recorded URL %q cannot be parsed: %v\", entry.URL, err)\n507\t\t}\n508\t\t// The store is a file on disk, so its scheme is checked on the way out as\n509\t\t// well as on the way in: an edited entry must not be able to replay as a\n510\t\t// file read or a raw TCP write.\n511\t\tif !request.IsHTTPScheme(parsed.Scheme) {\n512\t\t\treturn nil, clierr.Usage(\"the recorded URL %q has scheme %q; only http and https can be replayed\",\n513\t\t\t\tentry.URL, parsed.Scheme)\n514\t\t}\n515\t\n516\t\treq := &request.Request{\n517\t\t\tOperationID: entry.OperationID,\n518\t\t\tMethod:      entry.Method,\n519\t\t\tBaseURL:     parsed.Scheme + \"://\" + parsed.Host,\n520\t\t\tPath:        parsed.EscapedPath(),\n521\t\t}\n522\t\n523\t\treq.Query, err = replayQuery(stderr, parsed.RawQuery)\n524\t\tif err != nil {\n525\t\t\treturn nil, err\n526\t\t}\n527\t\treq.Headers = replayPairs(stderr, \"header\", entry.Request.Headers)\n528\t\treq.Cookies = replayPairs(stderr, \"cookie\", entry.Request.Cookies)\n529\t\n530\t\tif body := entry.Request.Body; body != nil {\n531\t\t\tif body.Truncated {\n532\t\t\t\treturn nil, clierr.Usage(\n533\t\t\t\t\t\"the recorded request body was truncated at %d bytes, so replaying it would send something the original did not\",\n534\t\t\t\t\tcorpus.MaxBody)\n535\t\t\t}\n536\t\t\tdata, err := body.Bytes()\n537\t\t\tif err != nil {\n538\t\t\t\treturn nil, err\n539\t\t\t}\n540\t\t\treq.Body = &request.Body{ContentType: body.ContentType, Data: data}\n541\t\t}\n542\t\n543\t\treturn req, nil\n544\t}\n545\t\n546\t// replayQuery rebuilds the query parameters in the order they were recorded.\n547\t// The raw string is walked rather than url.ParseQuery'd because a map would lose\n548\t// that order, and a replay that reorders the query string is not the same\n549\t// request.\n550\tfunc replayQuery(stderr io.Writer, raw string) ([]request.Pair, error) {\n551\t\tvar pairs []request.Pair\n552\t\n553\t\tfor _, field := range strings.Split(raw, \"&\") {\n554\t\t\tif field == \"\" {\n555\t\t\t\tcontinue\n556\t\t\t}\n557\t\n558\t\t\trawName, rawValue, _ := strings.Cut(field, \"=\")\n559\t\t\tname, err := url.QueryUnescape(rawName)\n560\t\t\tif err != nil {\n561\t\t\t\treturn nil, clierr.Usage(\"the recorded query parameter %q cannot be parsed: %v\", rawName, err)\n562\t\t\t}\n563\t\t\tvalue, err := url.QueryUnescape(rawValue)\n564\t\t\tif err != nil {\n565\t\t\t\treturn nil, clierr.Usage(\"the recorded value of query parameter %q cannot be parsed: %v\", name, err)\n566\t\t\t}\n567\t\n568\t\t\treplayed, ok := replayValue(value)\n569\t\t\tif !ok {\n570\t\t\t\twarnUnreplayable(stderr, \"query parameter\", name)\n571\t\t\t\tcontinue\n572\t\t\t}\n573\t\t\tpairs = append(pairs, request.Pair{Name: name, Value: replayed})\n574\t\t}\n575\t\n576\t\treturn pairs, nil\n577\t}\n578\t\n579\t// replayPairs rebuilds headers or cookies. The stored form is a map, so the\n580\t// order is gone and is restored as sorted-by-name: emitted curl and the config\n581\t// document both have to be deterministic, and byte-for-byte header order is not\n582\t// something an HTTP request depends on.\n583\tfunc replayPairs(stderr io.Writer, kind string, stored map[string]string) []request.Pair {\n584\t\tvar pairs []request.Pair\n585\t\n586\t\tfor _, name := range sortedKeys(stored) {\n587\t\t\tvalue, ok := replayValue(stored[name])\n588\t\t\tif !ok {\n589\t\t\t\twarnUnreplayable(stderr, kind, name)\n590\t\t\t\tcontinue\n591\t\t\t}\n592\t\t\tpairs = append(pairs, request.Pair{Name: name, Value: value})\n593\t\t}\n594\t\n595\t\treturn pairs\n596\t}\n597\t\n598\t// replayValue turns one stored value back into a request Value, reporting\n599\t// false for one that cannot be reproduced.\n600\t//\n601\t// A `<redacted:env:NAME>` — with or without a scheme prefix — becomes a\n602\t// reference to the same variable. A bare `<redacted>` is a value the name-based\n603\t// matcher caught: a literal the user typed, which was deliberately not written\n604\t// down and so cannot come back. That is the firewall working, not a bug, and\n605\t// the caller says so on stderr rather than silently sending a request missing a\n606\t// header the original had.\n607\tfunc replayValue(stored string) (request.Value, bool) {\n608\t\tif stored == secret.Placeholder {\n609\t\t\treturn request.Value{}, false\n610\t\t}\n611\t\n612\t\t// Longest prefix first, so the raw encoding's empty prefix is the fallback\n613\t\t// rather than the first match.\n614\t\tfor _, enc := range []request.Encoding{request.EncodeBearer, request.EncodeBasic, request.EncodeRaw} {\n615\t\t\tprefix := encodingPrefix(enc)\n616\t\t\tif prefix != \"\" && !strings.HasPrefix(stored, prefix) {\n617\t\t\t\tcontinue\n618\t\t\t}\n619\t\n620\t\t\tif ref, ok := secret.ParseRef(strings.TrimPrefix(stored, prefix)); ok {\n621\t\t\t\treturn request.Secret(ref, enc), true\n622\t\t\t}\n623\t\t}\n624\t\n625\t\treturn request.Literal(stored), true\n626\t}\n627\t\n628\t// encodingPrefix is the text a scheme puts in front of a credential — \"Bearer \"\n629\t// and the rest. It is asked of internal/request rather than repeated here, so\n630\t// the two cannot drift apart.\n631\tfunc encodingPrefix(enc request.Encoding) string {\n632\t\treturn request.Secret(secret.SecretRef{}, enc).Prefix()\n633\t}\n634\t\n635\t// warnUnreplayable reports a field the replay had to drop. It is a warning\n636\t// rather than a failure: the request is still worth making, and a 401 with an\n637\t// explanation on stderr is more useful than a refusal.\n638\tfunc warnUnreplayable(stderr io.Writer, kind, name string) {\n639\t\tfmt.Fprintf(stderr,\n640\t\t\t\"warning: the recorded %s %q held a redacted literal, which history does not store; replaying without it\\n\",\n641\t\t\tkind, name)\n642\t}\n643\t\n644\t// sortedKeys is the deterministic iteration order for the maps a stored entry\n645\t// holds.\n646\tfunc sortedKeys(m map[string]string) []string {\n647\t\tnames := make([]string, 0, len(m))\n648\t\tfor name := range m {\n649\t\t\tnames = append(names, name)\n650\t\t}\n651\t\tsort.Strings(names)\n652\t\n653\t\treturn names\n654\t}\n655\t"
