          "content": "package corpus\n\nimport (\n\t\"os\"\n\t\"os/exec\"\n\t\"strconv\"\n\t\"sync\"\n\t\"testing\"\n)\n\n// TestHelperXProcAppend is the child process. It appends `each` entries tagged\n// with its worker id and exits.\nfunc TestHelperXProcAppend(t *testing.T) {\n\tif os.Getenv(\"TALARIA_XPROC\") == \"\" {\n\t\tt.Skip(\"helper\")\n\t}\n\n\tdir := os.Getenv(\"TALARIA_XPROC_DIR\")\n\tworker := os.Getenv(\"TALARIA_XPROC_WORKER\")\n\tstore := New(dir, true)\n\n\tfor i := 0; i < 40; i++ {\n\t\turl := \"https://api.example.com/pets/\" + worker + \"-\" + strconv.Itoa(i)\n\t\tif err := store.Append(Entry{Source: SourceRun, Method: \"GET\", URL: url}); err != nil {\n\t\t\tt.Fatalf(\"worker %s append %d: %v\", worker, i, err)\n\t\t}\n\t}\n}\n\n// TestCrossProcessAppendsKeepEveryEntry runs 8 separate OS processes appending\n// concurrently over the retention cap, which is the only configuration where\n// trim's rewrite path runs on every append.\nfunc TestCrossProcessAppendsKeepEveryEntry(t *testing.T) {\n\tif os.Getenv(\"TALARIA_XPROC\") != \"\" {\n\t\tt.Skip(\"child\")\n\t}\n\n\tdir := t.TempDir()\n\tseed := New(dir, true)\n\t// Seed to just under the cap so every concurrent append triggers the\n\t// read-modify-write rewrite.\n\tfor i := 0; i < maxPerSource-1; i++ {\n\t\tif err := seed.Append(Entry{\n\t\t\tSource: SourceRun, Method: \"GET\",\n\t\t\tURL: \"https://api.example.com/seed/\" + strconv.Itoa(i),\n\t\t}); err != nil {\n\t\t\tt.Fatalf(\"seed %d: %v\", i, err)\n\t\t}\n\t}\n\n\tconst workers = 8\n\tvar wg sync.WaitGroup\n\tfor w := 0; w < workers; w++ {\n\t\twg.Add(1)\n\t\tgo func(w int) {\n\t\t\tdefer wg.Done()\n\n\t\t\tcmd := exec.Command(os.Args[0], \"-test.run=TestHelperXProcAppend\", \"-test.v\")\n\t\t\tcmd.Env = append(os.Environ(),\n\t\t\t\t\"TALARIA_XPROC=1\",\n\t\t\t\t\"TALARIA_XPROC_DIR=\"+dir,\n\t\t\t\t\"TALARIA_XPROC_WORKER=\"+strconv.Itoa(w),\n\t\t\t)\n\t\t\tout, err := cmd.CombinedOutput()\n\t\t\tif err != nil {\n\t\t\t\tt.Errorf(\"worker %d: %v\\n%s\", w, err, out)\n\t\t\t}\n\t\t}(w)\n\t}\n\twg.Wait()\n\n\tentries, err := New(dir, true).Read()\n\tif err != nil {\n\t\tt.Fatalf(\"Read: %v\", err)\n\t}\n\n\tpresent := map[string]bool{}\n\tfor _, e := range entries {\n\t\tpresent[e.URL] = true\n\t}\n\n\tmissing := 0\n\tfor w := 0; w < workers; w++ {\n\t\tfor i := 0; i < 40; i++ {\n\t\t\turl := \"https://api.example.com/pets/\" + strconv.Itoa(w) + \"-\" + strconv.Itoa(i)\n\t\t\tif !present[url] {\n\t\t\t\tmissing++\n\t\t\t}\n\t\t}\n\t}\n\tif missing != 0 {\n\t\tt.Errorf(\"%d of %d cross-process entries are missing from the store (total entries %d)\",\n\t\t\tmissing, workers*40, len(entries))\n\t}\n}\n"
        },
