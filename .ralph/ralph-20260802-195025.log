or the maps a stored entry\n// holds.\nfunc sortedKeys(m map[string]string) []string {\n\tnames := make([]string, 0, len(m))\n\tfor name := range m {\n\t\tnames = append(names, name)\n\t}\n\tsort.Strings(names)\n\n\treturn names\n}\n",
