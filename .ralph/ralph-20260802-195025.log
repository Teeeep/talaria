    "content": [
      {
        "tool_use_id": "toolu_01Q9RptaHw38pRdhp5V6dd9Q",
        "type": "tool_result",
        "content": "1\tpackage request\n2\t\n3\timport (\n4\t\t\"io\"\n5\t\t\"net/url\"\n6\t\t\"sort\"\n7\t\t\"strings\"\n8\t\n9\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n10\t\t\"github.com/Teeeep/talaria/internal/config\"\n11\t\t\"github.com/Teeeep/talaria/internal/operation\"\n12\t\t\"github.com/Teeeep/talaria/internal/secret\"\n13\t\t\"github.com/Teeeep/talaria/internal/spec\"\n14\t)\n15\t\n16\t// Parameter locations. Three of them are also credential locations and are\n17\t// aliased from internal/config so the two packages cannot drift; `path` is the\n18\t// one place a credential never goes, which is why config does not name it.\n19\tconst (\n20\t\tinPath   = \"path\"\n21\t\tinQuery  = config.InQuery\n22\t\tinHeader = config.InHeader\n23\t\tinCookie = config.InCookie\n24\t)\n25\t\n26\t// Inputs is everything one call needs: the operation and the document it came\n27\t// from, the resolved profile and credentials, and the raw `name=value` flag\n28\t// strings exactly as the CLI received them. Parsing them here rather than in\n29\t// cmd/ keeps the binding rules — and their error messages — testable without a\n30\t// command tree.\n31\ttype Inputs struct {\n32\t\tOp      operation.Operation\n33\t\tDoc     *spec.Document\n34\t\tProfile *config.Profile\n35\t\t// Creds are the credentials config.Resolve produced for Op. They name\n36\t\t// credentials; they never carry one.\n37\t\tCreds []config.Credential\n38\t\t// BaseURL is --base-url. It beats the profile, which beats the spec.\n39\t\tBaseURL string\n40\t\t// Params are --param name=value for parameters the operation declares, in\n41\t\t// any location.\n42\t\tParams []string\n43\t\t// Query are --query name=value, for query parameters the spec may not\n44\t\t// declare.\n45\t\tQuery []string\n46\t\t// Headers are --header name=value.\n47\t\tHeaders []string\n48\t\t// Body holds --body exactly as given: a literal, @file, or \"-\" for stdin.\n49\t\t// It is a slice so a repeated flag is a reportable mistake rather than a\n50\t\t// silent last-one-wins.\n51\t\tBody []string\n52\t\t// Stdin is the reader `--body -` consumes. It is injected rather than read\n53\t\t// from os.Stdin so the ownership rule is testable: the Go process reads the\n54\t\t// body in full before curl exists, and curl's own stdin carries the config\n55\t\t// document (DESIGN.md §5a).\n56\t\tStdin io.Reader\n57\t}\n58\t\n59\t// Build binds inputs to an operation and returns the request to make.\n60\t//\n61\t// Every binding problem is collected before returning rather than reported one\n62\t// at a time: an agent that gets \"petId is required; --header malformed\" fixes\n63\t// both in one round trip, where a fail-fast builder would cost it two.\n64\tfunc Build(in Inputs) (*Request, error) {\n65\t\tb := &binder{in: in}\n66\t\n67\t\treq := &Request{\n68\t\t\tOperationID: in.Op.ID,\n69\t\t\tMethod:      in.Op.Method,\n70\t\t\tBaseURL:     b.baseURL(),\n71\t\t}\n72\t\n73\t\tbound := b.params()\n74\t\treq.Path = b.path(bound)\n75\t\n76\t\treq.Query = append(b.located(bound, inQuery), b.pairs(in.Query, \"--query\")...)\n77\t\treq.Headers = hide(b.headers(bound))\n78\t\treq.Cookies = hide(b.located(bound, inCookie))\n79\t\t// After the headers, because the body's content type defers to a\n80\t\t// Content-Type the user set; before the credentials, which never set one.\n81\t\treq.Body = b.body(req)\n82\t\n83\t\tb.credentials(req)\n84\t\n85\t\tif err := b.err(); err != nil {\n86\t\t\treturn nil, err\n87\t\t}\n88\t\n89\t\treturn req, nil\n90\t}\n91\t\n92\t// binder accumulates the problems found while binding so they can all be\n93\t// reported together.\n94\ttype binder struct {\n95\t\tin       Inputs\n96\t\tproblems []string\n97\t\t// unknown records that some --param named a parameter the operation does\n98\t\t// not declare, so the error can carry the declared names as alternatives.\n99\t\tunknown bool\n100\t}\n101\t\n102\tfunc (b *binder) fail(format string, a ...any) {\n103\t\tb.problems = append(b.problems, clierr.Usage(format, a...).Message)\n104\t}\n105\t\n106\t// err folds the collected problems into one usage error, naming the operation\n107\t// so the message stands alone in a log.\n108\tfunc (b *binder) err() error {\n109\t\tif len(b.problems) == 0 {\n110\t\t\treturn nil\n111\t\t}\n112\t\n113\t\terr := clierr.Usage(\"cannot build a request for %s: %s\",\n114\t\t\toperationName(b.in.Op), strings.Join(b.problems, \"; \"))\n115\t\tif b.unknown {\n116\t\t\terr = err.WithAlternatives(declaredNames(b.in.Op)...)\n117\t\t}\n118\t\n119\t\treturn err\n120\t}\n121\t\n122\t// baseURL resolves where the request goes: --base-url, then the profile, then\n123\t// the spec's first server (DESIGN.md §4). A spec whose server URL is relative\n124\t// — common for specs that expect a host to be supplied — counts as no server.\n125\tfunc (b *binder) baseURL() string {\n126\t\tcandidates := []struct{ source, raw string }{\n127\t\t\t{\"--base-url\", b.in.BaseURL},\n128\t\t}\n129\t\tif b.in.Profile != nil {\n130\t\t\tcandidates = append(candidates, struct{ source, raw string }{\n131\t\t\t\t\"profile \" + b.in.Profile.Name, b.in.Profile.BaseURL})\n132\t\t}\n133\t\tcandidates = append(candidates, struct{ source, raw string }{\"the spec's servers[0].url\", firstServer(b.in.Doc)})\n134\t\n135\t\tfor _, c := range candidates {\n136\t\t\tif c.raw == \"\" {\n137\t\t\t\tcontinue\n138\t\t\t}\n139\t\n140\t\t\tparsed, err := url.Parse(c.raw)\n141\t\t\tif err != nil || parsed.Scheme == \"\" || parsed.Host == \"\" {\n142\t\t\t\tb.fail(\"base URL %q from %s is not an absolute http(s) URL\", c.raw, c.source)\n143\t\t\t\treturn \"\"\n144\t\t\t}\n145\t\n146\t\t\treturn strings.TrimSuffix(c.raw, \"/\")\n147\t\t}\n148\t\n149\t\tb.fail(\"no base URL: the spec declares no server, so pass --base-url or set one in a profile\")\n150\t\n151\t\treturn \"\"\n152\t}\n153\t\n154\t// firstServer returns the document's first server URL, or \"\" when it has none.\n155\tfunc firstServer(doc *spec.Document) string {\n156\t\tif doc == nil || doc.Model == nil || len(doc.Model.Servers) == 0 || doc.Model.Servers[0] == nil {\n157\t\t\treturn \"\"\n158\t\t}\n159\t\n160\t\treturn doc.Model.Servers[0].URL\n161\t}\n162\t\n163\t// params parses --param flags against the parameters the operation declares,\n164\t// keyed by the declared name so path substitution and location routing both\n165\t// read from one place.\n166\tfunc (b *binder) params() map[string]string {\n167\t\tdeclared := map[string]operation.Param{}\n168\t\tfor _, p := range b.in.Op.Params {\n169\t\t\tdeclared[p.Name] = p\n170\t\t}\n171\t\n172\t\tbound := map[string]string{}\n173\t\tfor _, raw := range b.in.Params {\n174\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n175\t\t\tif !ok || name == \"\" {\n176\t\t\t\tb.fail(\"--param %q is not name=value\", raw)\n177\t\t\t\tcontinue\n178\t\t\t}\n179\t\n180\t\t\tif _, ok := declared[name]; !ok {\n181\t\t\t\tb.unknown = true\n182\t\t\t\tb.fail(\"%s declares no parameter %q\", operationName(b.in.Op), name)\n183\t\t\t\tcontinue\n184\t\t\t}\n185\t\n186\t\t\tbound[name] = value\n187\t\t}\n188\t\n189\t\t// Reported after parsing so a missing parameter and a misspelt one surface\n190\t\t// together rather than one run apart.\n191\t\tfor _, p := range b.in.Op.Params {\n192\t\t\tif _, ok := bound[p.Name]; p.Required && !ok {\n193\t\t\t\tb.fail(\"--param %s is required (%s parameter)\", p.Name, p.In)\n194\t\t\t}\n195\t\t}\n196\t\n197\t\treturn bound\n198\t}\n199\t\n200\t// path substitutes the bound path parameters into the operation's template.\n201\t//\n202\t// Values are escaped with url.PathEscape, so a value containing / or ? stays\n203\t// inside its own segment instead of rewriting the request's target — the same\n204\t// reason SQL uses placeholders rather than string concatenation.\n205\tfunc (b *binder) path(bound map[string]string) string {\n206\t\tpath := b.in.Op.Path\n207\t\tfor _, p := range b.in.Op.Params {\n208\t\t\tif p.In != inPath {\n209\t\t\t\tcontinue\n210\t\t\t}\n211\t\n212\t\t\tvalue, ok := bound[p.Name]\n213\t\t\tif !ok {\n214\t\t\t\tcontinue\n215\t\t\t}\n216\t\n217\t\t\tpath = strings.ReplaceAll(path, \"{\"+p.Name+\"}\", url.PathEscape(value))\n218\t\t}\n219\t\n220\t\t// A leftover placeholder means the spec templated a segment it never\n221\t\t// declared a parameter for; without this the request would go to a literal\n222\t\t// \"/pets/{petId}\".\n223\t\tif strings.ContainsAny(path, \"{}\") {\n224\t\t\tb.fail(\"path %q has a placeholder the operation declares no parameter for\", b.in.Op.Path)\n225\t\t}\n226\t\n227\t\treturn path\n228\t}\n229\t\n230\t// located returns the bound parameters that belong in one location, in the\n231\t// order the spec declares them so the result is stable across runs.\n232\tfunc (b *binder) located(bound map[string]string, in string) []Pair {\n233\t\tvar out []Pair\n234\t\tfor _, p := range b.in.Op.Params {\n235\t\t\tif p.In != in {\n236\t\t\t\tcontinue\n237\t\t\t}\n238\t\t\tif value, ok := bound[p.Name]; ok {\n239\t\t\t\tout = append(out, Pair{Name: p.Name, Value: Literal(value)})\n240\t\t\t}\n241\t\t}\n242\t\n243\t\treturn out\n244\t}\n245\t\n246\t// headers merges the three sources of request headers. The profile is the least\n247\t// specific and only contributes names nothing else supplied, so `--header\n248\t// X-Env=explicit` overrides a profile's X-Env instead of sending both.\n249\tfunc (b *binder) headers(bound map[string]string) []Pair {\n250\t\tout := append(b.located(bound, inHeader), b.pairs(b.in.Headers, \"--header\")...)\n251\t\n252\t\tif b.in.Profile == nil {\n253\t\t\treturn out\n254\t\t}\n255\t\n256\t\tset := map[string]bool{}\n257\t\tfor _, p := range out {\n258\t\t\tset[strings.ToLower(p.Name)] = true\n259\t\t}\n260\t\n261\t\tnames := make([]string, 0, len(b.in.Profile.Headers))\n262\t\tfor name := range b.in.Profile.Headers {\n263\t\t\tnames = append(names, name)\n264\t\t}\n265\t\tsort.Strings(names)\n266\t\n267\t\tfor _, name := range names {\n268\t\t\tif !set[strings.ToLower(name)] {\n269\t\t\t\tout = append(out, Pair{Name: name, Value: Literal(b.in.Profile.Headers[name])})\n270\t\t\t}\n271\t\t}\n272\t\n273\t\treturn out\n274\t}\n275\t\n276\t// hide marks every literal sitting under a credential-shaped name — the §5a\n277\t// built-in list: Authorization, Cookie, Proxy-Authorization, *api*key*, *token*,\n278\t// *secret* — as sensitive, so it renders `<redacted>` on every surface that\n279\t// displays a Value while still going on the wire.\n280\t//\n281\t// The name is all there is to go on. talaria cannot tell a token the user typed\n282\t// into --header from an ordinary string by looking at the string, and §5a's\n283\t// answer is that it does not have to: the name decides, whether the value came\n284\t// from a spec's security scheme, a profile, a bound parameter or the flag.\n285\tfunc hide(pairs []Pair) []Pair {\n286\t\t// A nil *Redactor is the built-in list, which is the whole point here: the\n287\t\t// user-extensible patterns are a display concern the config file adds\n288\t\t// downstream, and this floor is not configurable.\n289\t\tvar builtin *secret.Redactor\n290\t\n291\t\tfor i, p := range pairs {\n292\t\t\tif !p.Value.IsSecret() && builtin.IsSensitive(p.Name) {\n293\t\t\t\tpairs[i].Value = p.Value.Sensitive()\n294\t\t\t}\n295\t\t}\n296\t\n297\t\treturn pairs\n298\t}\n299\t\n300\t// pairs parses repeatable name=value flags. Only the first = separates, because\n301\t// header and query values legitimately contain more.\n302\tfunc (b *binder) pairs(raws []string, flag string) []Pair {\n303\t\tout := make([]Pair, 0, len(raws))\n304\t\tfor _, raw := range raws {\n305\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n306\t\t\tif !ok || name == \"\" {\n307\t\t\t\tb.fail(\"%s %q is not name=value\", flag, raw)\n308\t\t\t\tcontinue\n309\t\t\t}\n310\t\n311\t\t\tout = append(out, Pair{Name: name, Value: Literal(value)})\n312\t\t}\n313\t\n314\t\treturn out\n315\t}\n316\t\n317\t// credentials puts each resolved credential where its scheme says it goes, as a\n318\t// reference. This is the §5a boundary: what lands on the request is the name of\n319\t// a credential and how to encode it, never the credential.\n320\tfunc (b *binder) credentials(req *Request) {\n321\t\tfor _, cred := range b.in.Creds {\n322\t\t\tpair := Pair{Name: cred.Name, Value: Secret(cred.Ref, encodingFor(cred.Kind))}\n323\t\n324\t\t\tswitch cred.In {\n325\t\t\tcase inHeader:\n326\t\t\t\treq.Headers = append(req.Headers, pair)\n327\t\t\tcase inQuery:\n328\t\t\t\treq.Query = append(req.Query, pair)\n329\t\t\tcase inCookie:\n330\t\t\t\treq.Cookies = append(req.Cookies, pair)\n331\t\t\tdefault:\n332\t\t\t\tb.fail(\"scheme %q wants its credential in %q, which is not a place a request has\",\n333\t\t\t\t\tcred.Scheme, cred.In)\n334\t\t\t}\n335\t\t}\n336\t}\n337\t\n338\tfunc encodingFor(kind config.Kind) Encoding {\n339\t\tswitch kind {\n340\t\tcase config.KindBearer:\n341\t\t\treturn EncodeBearer\n342\t\tcase config.KindBasic:\n343\t\t\treturn EncodeBasic\n344\t\tdefault:\n345\t\t\treturn EncodeRaw\n346\t\t}\n347\t}\n348\t\n349\t// declaredNames lists the parameters the operation accepts, for the\n350\t// valid_alternatives an agent corrects itself from.\n351\tfunc declaredNames(op operation.Operation) []string {\n352\t\tnames := make([]string, 0, len(op.Params))\n353\t\tfor _, p := range op.Params {\n354\t\t\tnames = append(names, p.Name)\n355\t\t}\n356\t\n357\t\treturn names\n358\t}\n359\t\n360\t// operationName is the operation's ID, falling back to method and path for a\n361\t// spec that sets no operationId.\n362\tfunc operationName(op operation.Operation) string {\n363\t\tif op.ID != \"\" {\n364\t\t\treturn op.ID\n365\t\t}\n366\t\n367\t\treturn op.Method + \" \" + op.Path\n368\t}\n369\t"
      }
