        "content": "1\tpackage request\n2\t\n3\timport (\n4\t\t\"io\"\n5\t\t\"os\"\n6\t\t\"strings\"\n7\t)\n8\t\n9\t// stdinFlag is the --body value that means \"read the body from this process's\n10\t// standard input\". It is curl's own spelling, so a user who knows curl already\n11\t// knows it.\n12\tconst stdinFlag = \"-\"\n13\t\n14\t// fileFlagPrefix marks a --body value as a filename, again following curl.\n15\tconst fileFlagPrefix = \"@\"\n16\t\n17\t// contentTypeHeader is the header a body's media type travels in.\n18\tconst contentTypeHeader = \"Content-Type\"\n19\t\n20\t// body resolves the --body flag into the bytes that will be sent and the media\n21\t// type that describes them, or nil when no body was asked for.\n22\t//\n23\t// The bytes are resolved here, in the Go process, before any curl invocation\n24\t// exists. That is the whole point of this function: DESIGN.md §5a gives the Go\n25\t// process ownership of the real stdin, because curl's stdin is already taken by\n26\t// the `-K -` config document. If `--body -` were passed through to curl, the two\n27\t// would be the same pipe and the body and the credentials would be spliced into\n28\t// one stream (docs/research §8).\n29\t//\n30\t// req is read for the headers already bound, so a user's own Content-Type can\n31\t// beat the operation's declared media type.\n32\tfunc (b *binder) body(req *Request) *Body {\n33\t\tdata, ok := b.bodyData()\n34\t\tif !ok {\n35\t\t\treturn nil\n36\t\t}\n37\t\n38\t\treturn &Body{ContentType: b.contentType(req), Data: data}\n39\t}\n40\t\n41\t// bodyData reads whichever of the three sources --body named. The second return\n42\t// is false when there is no body to send, either because none was asked for or\n43\t// because reading it failed — in which case the problem is already recorded and\n44\t// Build will return it.\n45\tfunc (b *binder) bodyData() ([]byte, bool) {\n46\t\tif len(b.in.Body) == 0 {\n47\t\t\treturn nil, false\n48\t\t}\n49\t\t// A repeated --body is a mistake worth naming rather than resolving by\n50\t\t// last-one-wins: the two values are usually a literal and a file, and\n51\t\t// silently dropping one of them sends a request the user did not write.\n52\t\tif len(b.in.Body) > 1 {\n53\t\t\tb.fail(\"--body was given %d times (%s); a request has one body\",\n54\t\t\t\tlen(b.in.Body), strings.Join(b.in.Body, \", \"))\n55\t\t\treturn nil, false\n56\t\t}\n57\t\n58\t\traw := b.in.Body[0]\n59\t\tswitch {\n60\t\tcase raw == stdinFlag:\n61\t\t\treturn b.stdinBody()\n62\t\tcase strings.HasPrefix(raw, fileFlagPrefix):\n63\t\t\treturn b.fileBody(strings.TrimPrefix(raw, fileFlagPrefix))\n64\t\tdefault:\n65\t\t\treturn []byte(raw), true\n66\t\t}\n67\t}\n68\t\n69\t// stdinBody reads the process's standard input to EOF.\n70\tfunc (b *binder) stdinBody() ([]byte, bool) {\n71\t\tif b.in.Stdin == nil {\n72\t\t\tb.fail(\"--body %s reads the request body from stdin, but this process has no stdin to read\",\n73\t\t\t\tstdinFlag)\n74\t\t\treturn nil, false\n75\t\t}\n76\t\n77\t\tdata, err := io.ReadAll(b.in.Stdin)\n78\t\tif err != nil {\n79\t\t\tb.fail(\"cannot read the request body from stdin: %v\", err)\n80\t\t\treturn nil, false\n81\t\t}\n82\t\n83\t\treturn data, true\n84\t}\n85\t\n86\t// fileBody reads a body from disk verbatim. Nothing is trimmed: a body is bytes,\n87\t// and a signed payload stops verifying if its trailing newline is tidied away.\n88\tfunc (b *binder) fileBody(path string) ([]byte, bool) {\n89\t\tif path == \"\" {\n90\t\t\tb.fail(\"--body %s names no file\", fileFlagPrefix)\n91\t\t\treturn nil, false\n92\t\t}\n93\t\n94\t\tdata, err := os.ReadFile(path)\n95\t\tif err != nil {\n96\t\t\tb.fail(\"cannot read the request body from %s: %v\", path, err)\n97\t\t\treturn nil, false\n98\t\t}\n99\t\n100\t\treturn data, true\n101\t}\n102\t\n103\t// contentType is what the body will be sent as: the Content-Type the user set\n104\t// explicitly, otherwise the first media type the operation declares.\n105\t//\n106\t// The user wins because the spec describes what the server accepts, not what\n107\t// this particular call is sending — an operation declaring application/json can\n108\t// still be handed a form body deliberately. When the operation declares no body\n109\t// at all the result is empty, and talaria sends no Content-Type rather than\n110\t// guessing one.\n111\tfunc (b *binder) contentType(req *Request) string {\n112\t\tfor _, h := range req.Headers {\n113\t\t\tif strings.EqualFold(h.Name, contentTypeHeader) {\n114\t\t\t\treturn h.Value.String()\n115\t\t\t}\n116\t\t}\n117\t\n118\t\trb := b.in.Op.RequestBody\n119\t\tif rb == nil || len(rb.Content) == 0 {\n120\t\t\treturn \"\"\n121\t\t}\n122\t\n123\t\treturn rb.Content[0].ContentType\n124\t}\n125\t"
