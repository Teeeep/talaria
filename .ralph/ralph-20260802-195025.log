      {
        "tool_use_id": "toolu_019gvMgaDhf4v9qtUyXhMViG",
        "type": "tool_result",
        "content": "1\t// Package corpus is talaria's record of what it actually sent and what came\n2\t// back. It backs `talaria history` now and the twin's recordings later: DESIGN.md\n3\t// §5 puts it in Phase 2 even though the recording proxy is Phase 5, because\n4\t// \"history and the twin's corpus are the same data\".\n5\t//\n6\t// Everything here is written redacted. §5a calls the recording \"a permanent\n7\t// artifact — the highest-risk surface in the tool\" and answers it with\n8\t// \"redaction at write time, not read time. Un-redacted recording is not an\n9\t// option.\" An Entry is therefore built by NewEntry out of the redacted\n10\t// representation of a request and a response, and there is no path through this\n11\t// package that puts a resolved credential on disk.\n12\t//\n13\t// The package deliberately does not import internal/config: the profile's\n14\t// history setting arrives as the Enabled bool a caller passes to New, so the\n15\t// store stays usable by the twin, which has no profiles.\n16\tpackage corpus\n17\t\n18\timport (\n19\t\t\"time\"\n20\t\n21\t\t\"github.com/Teeeep/talaria/internal/curl\"\n22\t\t\"github.com/Teeeep/talaria/internal/request\"\n23\t\t\"github.com/Teeeep/talaria/internal/secret\"\n24\t)\n25\t\n26\t// MaxBody is how much of a request or response body one entry keeps. A body\n27\t// past it is cut and marked truncated: history is for answering \"what have I\n28\t// already tried\", and a 40 MB download answers that no better than its first\n29\t// 64 KiB while being the difference between a store you can read and one you\n30\t// cannot.\n31\tconst MaxBody = 64 << 10\n32\t\n33\t// Source says which command produced an entry. It exists because the retention\n34\t// cap is applied per source: a `run` over a large spec must not be able to evict\n35\t// a session of interactive `call` history.\n36\ttype Source string\n37\t\n38\tconst (\n39\t\t// SourceCall is one interactive `talaria call`.\n40\t\tSourceCall Source = \"call\"\n41\t\t// SourceRun is one request made by `talaria run`.\n42\t\tSourceRun Source = \"run\"\n43\t\t// SourceReplay is a `talaria history replay` of an earlier entry.\n44\t\tSourceReplay Source = \"replay\"\n45\t)\n46\t\n47\t// Entry is one recorded request/response pair, already redacted.\n48\t//\n49\t// A Response of nil is a request that produced no observation — a dry run, or a\n50\t// call whose connection failed — which is still worth recording as something\n51\t// that was tried.\n52\ttype Entry struct {\n53\t\tTimestamp   time.Time `json:\"timestamp\"`\n54\t\tSource      Source    `json:\"source\"`\n55\t\tOperationID string    `json:\"operation_id,omitempty\"`\n56\t\tMethod      string    `json:\"method\"`\n57\t\t// URL is the full request URL with credentials in the query string rendered\n58\t\t// as <redacted:env:NAME>.\n59\t\tURL      string         `json:\"url\"`\n60\t\tRequest  EntryRequest   `json:\"request\"`\n61\t\tResponse *EntryResponse `json:\"response,omitempty\"`\n62\t}\n63\t\n64\t// EntryRequest is the redacted request. Headers and cookies are maps rather\n65\t// than ordered pairs because history is read by name; a name that repeats is\n66\t// joined the way HTTP joins repeated field values.\n67\ttype EntryRequest struct {\n68\t\tHeaders map[string]string `json:\"headers,omitempty\"`\n69\t\tCookies map[string]string `json:\"cookies,omitempty\"`\n70\t\tBody    *Body             `json:\"body,omitempty\"`\n71\t}\n72\t\n73\t// EntryResponse is the redacted response. Headers keep their repetitions, since\n74\t// Set-Cookie legitimately appears more than once.\n75\ttype EntryResponse struct {\n76\t\tStatus   int                 `json:\"status\"`\n77\t\tHeaders  map[string][]string `json:\"headers,omitempty\"`\n78\t\tBody     *Body               `json:\"body,omitempty\"`\n79\t\tTimingMS int64               `json:\"timing_ms\"`\n80\t}\n81\t\n82\t// Body is a recorded body and how much of it was kept.\n83\ttype Body struct {\n84\t\tContentType string `json:\"content_type,omitempty\"`\n85\t\tData        string `json:\"data\"`\n86\t\t// Truncated reports that Data is the first MaxBody bytes and not the whole\n87\t\t// body. It is explicit so a reader never mistakes a cut body for what the\n88\t\t// server sent.\n89\t\tTruncated bool `json:\"truncated,omitempty\"`\n90\t}\n91\t\n92\t// Redactors are the two firewalls an entry passes through on its way to disk.\n93\t// Both are nil-safe: the zero Redactors applies the built-in lists, so a caller\n94\t// that forgets to configure them records less rather than more.\n95\ttype Redactors struct {\n96\t\t// Request matches request header names against the built-in credential list\n97\t\t// plus whatever the profile added.\n98\t\tRequest *secret.Redactor\n99\t\t// Response redacts response headers by name and both bodies by JSON path.\n100\t\tResponse *secret.ResponseRedactor\n101\t}\n102\t\n103\t// NewEntry builds the record of one request and the response it produced.\n104\t//\n105\t// Redaction happens here rather than at read time, and it happens before\n106\t// truncation: cutting a JSON body first would leave a prefix the path redactor\n107\t// can no longer parse, and a secret in that prefix would survive.\n108\tfunc NewEntry(source Source, req *request.Request, resp *curl.Response, red Redactors) Entry {\n109\t\tentry := Entry{\n110\t\t\tTimestamp: time.Now().UTC(),\n111\t\t\tSource:    source,\n112\t\t}\n113\t\n114\t\tif req != nil {\n115\t\t\tentry.OperationID = req.OperationID\n116\t\t\tentry.Method = req.Method\n117\t\t\t// request.Redacted cannot fail, and a URL that somehow did not render is\n118\t\t\t// not worth dropping the whole recording over.\n119\t\t\tentry.URL, _ = req.URL(request.Redacted)\n120\t\t\tentry.Request = EntryRequest{\n121\t\t\t\tHeaders: red.headers(req.Headers),\n122\t\t\t\tCookies: red.cookies(req.Cookies),\n123\t\t\t\tBody:    red.requestBody(req.Body),\n124\t\t\t}\n125\t\t}\n126\t\n127\t\tif resp != nil {\n128\t\t\tentry.Response = &EntryResponse{\n129\t\t\t\tStatus:   resp.Status,\n130\t\t\t\tHeaders:  red.Response.Headers(resp.Headers),\n131\t\t\t\tBody:     newBody(contentType(resp.Headers), red.Response.Body(resp.Body)),\n132\t\t\t\tTimingMS: resp.TimingMS,\n133\t\t\t}\n134\t\t}\n135\t\n136\t\treturn entry\n137\t}\n138\t\n139\t// headers renders the request headers by whichever route redacts them.\n140\t//\n141\t// A Value holding a SecretRef prints as <redacted:env:NAME> by construction and\n142\t// keeps that form, which tells a reader which variable to export. Everything\n143\t// else goes through the name-based matcher, which is what catches a credential\n144\t// the user typed into --header as a literal — nothing structural would.\n145\tfunc (r Redactors) headers(pairs []request.Pair) map[string]string {\n146\t\tif len(pairs) == 0 {\n147\t\t\treturn nil\n148\t\t}\n149\t\n150\t\tout := make(map[string]string, len(pairs))\n151\t\tfor _, p := range pairs {\n152\t\t\tvalue := p.Value.String()\n153\t\t\tif !p.Value.IsSecret() {\n154\t\t\t\tvalue = r.Request.Value(p.Name, value)\n155\t\t\t}\n156\t\t\tif existing, ok := out[p.Name]; ok {\n157\t\t\t\tvalue = existing + \", \" + value\n158\t\t\t}\n159\t\t\tout[p.Name] = value\n160\t\t}\n161\t\n162\t\treturn out\n163\t}\n164\t\n165\t// cookies records cookie names and no literal cookie values.\n166\t//\n167\t// On the wire these are one Cookie header, which the built-in list redacts\n168\t// whole; matching a per-cookie name like \"session\" against that list would\n169\t// catch nothing, so keeping literals here would make the same credential safe\n170\t// as a header and exposed as a cookie. A cookie that names a SecretRef keeps\n171\t// its <redacted:env:NAME> form, which says more than the placeholder does.\n172\tfunc (r Redactors) cookies(pairs []request.Pair) map[string]string {\n173\t\tif len(pairs) == 0 {\n174\t\t\treturn nil\n175\t\t}\n176\t\n177\t\tout := make(map[string]string, len(pairs))\n178\t\tfor _, p := range pairs {\n179\t\t\tif p.Value.IsSecret() {\n180\t\t\t\tout[p.Name] = p.Value.String()\n181\t\t\t\tcontinue\n182\t\t\t}\n183\t\t\tout[p.Name] = secret.Placeholder\n184\t\t}\n185\t\n186\t\treturn out\n187\t}\n188\t\n189\t// requestBody redacts and cuts the body that was sent. The response redactor's\n190\t// JSON paths are applied to it too: the built-in list names access_token and\n191\t// refresh_token, and a token-refresh request carries one in exactly that field.\n192\tfunc (r Redactors) requestBody(b *request.Body) *Body {\n193\t\tif b == nil {\n194\t\t\treturn nil\n195\t\t}\n196\t\n197\t\treturn newBody(b.ContentType, r.Response.Body(b.Data))\n198\t}\n199\t\n200\t// newBody keeps at most MaxBody bytes of data, reporting whether it had to cut.\n201\t//\n202\t// The cut is at a byte offset, so it may land inside a UTF-8 sequence; that\n203\t// partial rune becomes a replacement character when the entry is marshalled,\n204\t// which keeps the JSONL line valid — the property that matters, since one\n205\t// unparseable line is one a reader has to skip.\n206\tfunc newBody(contentType string, data []byte) *Body {\n207\t\tif len(data) == 0 {\n208\t\t\treturn nil\n209\t\t}\n210\t\n211\t\tbody := &Body{ContentType: contentType}\n212\t\tif len(data) > MaxBody {\n213\t\t\tdata = data[:MaxBody]\n214\t\t\tbody.Truncated = true\n215\t\t}\n216\t\tbody.Data = string(data)\n217\t\n218\t\treturn body\n219\t}\n220\t\n221\t// contentType reads the media type off a response, for a reader deciding how to\n222\t// interpret the recorded bytes.\n223\tfunc contentType(headers map[string][]string) string {\n224\t\tfor _, value := range headers[\"Content-Type\"] {\n225\t\t\treturn value\n226\t\t}\n227\t\n228\t\treturn \"\"\n229\t}\n230\t"
      }
    ]
