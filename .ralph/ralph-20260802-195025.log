    "oldString": "\t\t\t\truns := []result{\n\t\t\t\t\th.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", format),\n\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n\t\t\t\t}\n\n\t\t\t\tif !strings.Contains(runs[0].stdout, \"canary-marker\") {\n\t\t\t\t\tt.Fatalf(\"the response body never reached stdout; the leak assertions below prove nothing:\\n%s\",\n\t\t\t\t\t\truns[0].stdout)\n\t\t\t\t}",
