        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"net/http\"\n9\t\t\"strconv\"\n10\t\t\"strings\"\n11\t\n12\t\t\"github.com/spf13/cobra\"\n13\t\n14\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n15\t\t\"github.com/Teeeep/talaria/internal/config\"\n16\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n17\t\t\"github.com/Teeeep/talaria/internal/curl\"\n18\t\t\"github.com/Teeeep/talaria/internal/operation\"\n19\t\t\"github.com/Teeeep/talaria/internal/output\"\n20\t\t\"github.com/Teeeep/talaria/internal/request\"\n21\t\t\"github.com/Teeeep/talaria/internal/secret\"\n22\t\t\"github.com/Teeeep/talaria/internal/spec\"\n23\t\t\"github.com/Teeeep/talaria/internal/validate\"\n24\t)\n25\t\n26\t// callView is the payload from DESIGN.md §4's sketch. A dry run fills in\n27\t// everything except the response and validation blocks, so an agent parses one\n28\t// structure whether or not the request was sent.\n29\ttype callView struct {\n30\t\tDryRun     bool             `json:\"dry_run\"`\n31\t\tRequest    requestView      `json:\"request\"`\n32\t\tResponse   *responseView    `json:\"response,omitempty\"`\n33\t\tValidation *validate.Result `json:\"validation,omitempty\"`\n34\t}\n35\t\n36\t// requestView is what was, or would have been, sent. Curl is the symbolic\n37\t// reproduction; every other field is the redacted display form.\n38\ttype requestView struct {\n39\t\tCurl    string            `json:\"curl\"`\n40\t\tMethod  string            `json:\"method\"`\n41\t\tURL     string            `json:\"url\"`\n42\t\tHeaders map[string]string `json:\"headers,omitempty\"`\n43\t\tCookies map[string]string `json:\"cookies,omitempty\"`\n44\t\tBody    string            `json:\"body,omitempty\"`\n45\t}\n46\t\n47\t// responseView is what came back. Headers keep their repetitions — Set-Cookie\n48\t// legitimately appears more than once, and HTTP forbids folding it into one\n49\t// comma-joined value the way requestView's map does.\n50\ttype responseView struct {\n51\t\tStatus   int                 `json:\"status\"`\n52\t\tHeaders  map[string][]string `json:\"headers\"`\n53\t\tBody     responseBody        `json:\"body\"`\n54\t\tTimingMS int64               `json:\"timing_ms\"`\n55\t}\n56\t\n57\t// responseBody is the raw bytes of a response, rendered per §4's sketch: a JSON\n58\t// body is embedded as JSON so an agent can reach into it with one parse instead\n59\t// of two, and anything else becomes a string.\n60\ttype responseBody []byte\n61\t\n62\t// MarshalJSON embeds the body when it is a JSON object or array, and quotes it\n63\t// otherwise.\n64\t//\n65\t// The object/array test is deliberately narrower than \"is valid JSON\": a\n66\t// plain-text body of `42` or `true` parses as JSON, and embedding it would\n67\t// report a document the server never sent. Composite syntax is unambiguous, so\n68\t// that is where the line goes.\n69\tfunc (b responseBody) MarshalJSON() ([]byte, error) {\n70\t\tif len(b) == 0 {\n71\t\t\treturn []byte(\"null\"), nil\n72\t\t}\n73\t\n74\t\ttrimmed := bytes.TrimLeft(b, \" \\t\\r\\n\")\n75\t\tif len(trimmed) > 0 && (trimmed[0] == '{' || trimmed[0] == '[') && json.Valid(trimmed) {\n76\t\t\t// encoding/json compacts and re-validates whatever a MarshalJSON returns,\n77\t\t\t// so the body's own formatting does not leak into the envelope.\n78\t\t\treturn trimmed, nil\n79\t\t}\n80\t\n81\t\treturn json.Marshal(string(b))\n82\t}\n83\t\n84\tfunc newCallCmd() *cobra.Command {\n85\t\tvar (\n86\t\t\tparams         []string\n87\t\t\tqueries        []string\n88\t\t\theaders        []string\n89\t\t\tbody           []string\n90\t\t\tdryRun         bool\n91\t\t\tallowMutations bool\n92\t\t\tfailOnError    bool\n93\t\t)\n94\t\n95\t\t// Built here rather than per-run so the warning fires once for the whole\n96\t\t// command tree, which — since main calls run exactly once — is once per\n97\t\t// process (§5a). Tests get a fresh tree, and so a fresh warner, per case.\n98\t\twarner := secret.NewQueryKeyWarner()\n99\t\n100\t\tcmd := &cobra.Command{\n101\t\t\tUse:   \"call [spec] <operationId>\",\n102\t\t\tShort: \"Build a request for one operation and show the curl that runs it\",\n103\t\t\tLong: \"Bind parameters, headers and credentials to an operation and render the\\n\" +\n104\t\t\t\t\"request as curl. Credentials are referenced by environment-variable name,\\n\" +\n105\t\t\t\t\"never by value, so the emitted command is safe to paste into a bug report\\n\" +\n106\t\t\t\t\"and runnable wherever the variable is set.\",\n107\t\t\tArgs: usageArgs(cobra.RangeArgs(1, 2)),\n108\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n109\t\t\t\tformat, err := resolveFormat(cmd)\n110\t\t\t\tif err != nil {\n111\t\t\t\t\treturn err\n112\t\t\t\t}\n113\t\n114\t\t\t\t// The operationId is always last: with one argument the spec comes\n115\t\t\t\t// from --spec or the environment, with two it is the first.\n116\t\t\t\tid := args[len(args)-1]\n117\t\n118\t\t\t\tdoc, index, err := loadSpec(cmd, args[:len(args)-1])\n119\t\t\t\tif err != nil {\n120\t\t\t\t\treturn err\n121\t\t\t\t}\n122\t\n123\t\t\t\top, err := index.Lookup(id)\n124\t\t\t\tif err != nil {\n125\t\t\t\t\treturn err\n126\t\t\t\t}\n127\t\n128\t\t\t\t// Gated before the request is built, and before --dry-run is even\n129\t\t\t\t// consulted: an agent that tried to POST learns the rule in one\n130\t\t\t\t// round trip rather than after fixing an unrelated flag, and\n131\t\t\t\t// without a network call (DESIGN.md §4).\n132\t\t\t\tif op.IsMutation() && !allowMutations {\n133\t\t\t\t\treturn clierr.Usage(\n134\t\t\t\t\t\t\"%s is a %s request and may change server state: pass --allow-mutations to call it\",\n135\t\t\t\t\t\toperationName(op), op.Method)\n136\t\t\t\t}\n137\t\n138\t\t\t\t// Read whether or not --profile was given: the redaction lists are a\n139\t\t\t\t// security setting, and one that only takes effect when you happen to\n140\t\t\t\t// be using a profile is one that silently does not.\n141\t\t\t\tcfg, err := config.Load(\"\")\n142\t\t\t\tif err != nil {\n143\t\t\t\t\treturn err\n144\t\t\t\t}\n145\t\n146\t\t\t\treq, err := buildRequest(cmd, cfg, op, doc, params, queries, headers, body)\n147\t\t\t\tif err != nil {\n148\t\t\t\t\treturn err\n149\t\t\t\t}\n150\t\n151\t\t\t\t// Before the dry-run branch: the exposure is a property of the\n152\t\t\t\t// request's shape, and an emitted curl is a command the caller may\n153\t\t\t\t// well run.\n154\t\t\t\twarnQueryCredentials(cmd.ErrOrStderr(), warner, req)\n155\t\n156\t\t\t\tstore, err := openHistory(cmd, cfg)\n157\t\t\t\tif err != nil {\n158\t\t\t\t\treturn err\n159\t\t\t\t}\n160\t\n161\t\t\t\trenderer := output.New(format, cmd.OutOrStdout())\n162\t\t\t\tredactors := newRedactors(cfg)\n163\t\t\t\tif dryRun {\n164\t\t\t\t\t// Nothing is recorded: a dry run is a question about a request,\n165\t\t\t\t\t// not a request, and history answers \"what have I already tried\".\n166\t\t\t\t\t// Nothing is validated either — an empty validation block would\n167\t\t\t\t\t// read as \"checked, and fine\".\n168\t\t\t\t\treturn renderer.Render(callPayload(req, nil, nil))\n169\t\t\t\t}\n170\t\n171\t\t\t\tresp, execErr := curl.Execute(req)\n172\t\t\t\t// Recorded either way. A request that never completed is still\n173\t\t\t\t// something that was tried, and the entry says so by having no\n174\t\t\t\t// response block at all.\n175\t\t\t\trecordCall(cmd.ErrOrStderr(), store, corpus.SourceCall, req, resp, redactors)\n176\t\t\t\tif execErr != nil {\n177\t\t\t\t\treturn execErr\n178\t\t\t\t}\n179\t\n180\t\t\t\tview := redactResponse(resp, redactors.Response)\n181\t\t\t\tresult := validateResponse(cmd.ErrOrStderr(), doc, req, view)\n182\t\n183\t\t\t\t// Rendered before the exit code is decided: --fail-on-error changes\n184\t\t\t\t// what the process exits with, not what the caller gets to read. An\n185\t\t\t\t// agent that asked for the flag still gets the full observation on\n186\t\t\t\t// stdout to act on.\n187\t\t\t\tif err := renderer.Render(callPayload(req, view, result)); err != nil {\n188\t\t\t\t\treturn err\n189\t\t\t\t}\n190\t\t\t\tif !failOnError {\n191\t\t\t\t\treturn nil\n192\t\t\t\t}\n193\t\n194\t\t\t\treturn callFailure(view, result)\n195\t\t\t},\n196\t\t}\n197\t\n198\t\t// Local to call: these are how one request is parameterised, and no other\n199\t\t// command binds parameters. --profile and --base-url are persistent on the\n200\t\t// root, because run and auth check take them too.\n201\t\tcmd.Flags().StringArrayVar(&params, \"param\", nil,\n202\t\t\t\"bind a declared parameter, name=value (repeatable)\")\n203\t\tcmd.Flags().StringArrayVar(&queries, \"query\", nil,\n204\t\t\t\"add a query parameter, name=value (repeatable)\")\n205\t\tcmd.Flags().StringArrayVar(&headers, \"header\", nil,\n206\t\t\t\"add a request header, name=value (repeatable)\")\n207\t\tcmd.Flags().StringArrayVar(&body, \"body\", nil,\n208\t\t\t\"request body: a literal, @file to read one, or - to read this process's stdin\")\n209\t\tcmd.Flags().BoolVar(&dryRun, \"dry-run\", false,\n210\t\t\t\"print the curl command and send nothing\")\n211\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n212\t\t\t\"permit a method other than GET, HEAD or OPTIONS\")\n213\t\tcmd.Flags().BoolVar(&failOnError, \"fail-on-error\", false,\n214\t\t\t\"exit 4 if the response is an HTTP error or violates the spec\")\n215\t\n216\t\treturn cmd\n217\t}\n218\t\n219\t// newRedactors builds the pair of firewalls an entry passes through on its way\n220\t// to disk, extended with whatever the config file added. Request and response\n221\t// share the header list: a name worth hiding on the way back is worth hiding on\n222\t// the way out.\n223\tfunc newRedactors(cfg *config.Config) corpus.Redactors {\n224\t\treturn corpus.Redactors{\n225\t\t\tRequest:  secret.NewRedactor(cfg.Redact.Headers...),\n226\t\t\tResponse: secret.NewResponseRedactor(cfg.Redact.Headers, cfg.Redact.BodyPaths),\n227\t\t}\n228\t}\n229\t\n230\t// recordCall writes one entry, reporting a failure to write as a warning and\n231\t// nothing more.\n232\t//\n233\t// A call that reached the server and came back succeeded; whether talaria then\n234\t// managed to write the fact down is not a reason to change the exit code an\n235\t// agent branches on. The warning still goes to stderr, because history silently\n236\t// not recording is how a user discovers weeks later that it never was.\n237\tfunc recordCall(\n238\t\tstderr io.Writer,\n239\t\tstore *corpus.Store,\n240\t\tsource corpus.Source,\n241\t\treq *request.Request,\n242\t\tresp *curl.Response,\n243\t\tred corpus.Redactors,\n244\t) {\n245\t\tif !store.Recording() {\n246\t\t\treturn\n247\t\t}\n248\t\n249\t\tif err := store.Append(corpus.NewEntry(source, req, resp, red)); err != nil {\n250\t\t\tfmt.Fprintf(stderr, \"warning: the call was not recorded in history: %v\\n\", err)\n251\t\t}\n252\t}\n253\t\n254\t// buildRequest resolves the profile and the operation's credentials, then binds\n255\t// the flags to the operation.\n256\tfunc buildRequest(\n257\t\tcmd *cobra.Command,\n258\t\tcfg *config.Config,\n259\t\top operation.Operation,\n260\t\tdoc *spec.Document,\n261\t\tparams, queries, headers, body []string,\n262\t) (*request.Request, error) {\n263\t\tprof, err := selectProfile(cmd, cfg)\n264\t\tif err != nil {\n265\t\t\treturn nil, err\n266\t\t}\n267\t\n268\t\tcreds, err := config.Resolve(op, doc, prof)\n269\t\tif err != nil {\n270\t\t\treturn nil, err\n271\t\t}\n272\t\n273\t\tbaseURL, err := cmd.Flags().GetString(\"base-url\")\n274\t\tif err != nil {\n275\t\t\treturn nil, clierr.Usage(\"%w\", err)\n276\t\t}\n277\t\n278\t\treturn request.Build(request.Inputs{\n279\t\t\tOp:      op,\n280\t\t\tDoc:     doc,\n281\t\t\tProfile: prof,\n282\t\t\tCreds:   creds,\n283\t\t\tBaseURL: baseURL,\n284\t\t\tParams:  params,\n285\t\t\tQuery:   queries,\n286\t\t\tHeaders: headers,\n287\t\t\tBody:    body,\n288\t\t\t// The Go process owns the real stdin, and `--body -` is the only thing\n289\t\t\t// that reads it. curl's stdin carries the config document and nothing\n290\t\t\t// else (DESIGN.md §5a).\n291\t\t\tStdin: cmd.InOrStdin(),\n292\t\t})\n293\t}\n294\t\n295\t// selectProfile picks the profile named by --profile out of an already-loaded\n296\t// config, or returns nil when no name was given.\n297\tfunc selectProfile(cmd *cobra.Command, cfg *config.Config) (*config.Profile, error) {\n298\t\tname, err := cmd.Flags().GetString(\"profile\")\n299\t\tif err != nil {\n300\t\t\treturn nil, clierr.Usage(\"%w\", err)\n301\t\t}\n302\t\tif name == \"\" {\n303\t\t\treturn nil, nil\n304\t\t}\n305\t\n306\t\treturn cfg.Profile(name)\n307\t}\n308\t\n309\t// warnQueryCredentials fires the one-time query-string warning if this request\n310\t// carries a credential in its URL. One warning covers the request: a scheme\n311\t// that puts two keys in the query string is a curiosity, and the point is made\n312\t// by the first.\n313\tfunc warnQueryCredentials(stderr io.Writer, warner *secret.QueryKeyWarner, req *request.Request) {\n314\t\tfor _, p := range req.Query {\n315\t\t\tif p.Value.IsSecret() {\n316\t\t\t\twarner.Warn(stderr, p.Name, p.Value.Ref())\n317\t\t\t\treturn\n318\t\t\t}\n319\t\t}\n320\t}\n321\t\n322\t// redactResponse turns what came off the wire into the display form everything\n323\t// downstream reads. It is the only conversion from curl.Response to\n324\t// responseView, so there is one place where a response stops being raw.\n325\tfunc redactResponse(resp *curl.Response, redactor *secret.ResponseRedactor) *responseView {\n326\t\treturn &responseView{\n327\t\t\tStatus:   resp.Status,\n328\t\t\tHeaders:  redactor.Headers(resp.Headers),\n329\t\t\tBody:     responseBody(redactor.Body(resp.Body)),\n330\t\t\tTimingMS: resp.TimingMS,\n331\t\t}\n332\t}\n333\t\n334\t// validateResponse checks the response against the operation's declared\n335\t// contract, on the *redacted* representation.\n336\t//\n337\t// That is §5a's rule for error paths: validation errors quote the content they\n338\t// rejected, so a validator fed the raw body is a leak channel — the one place a\n339\t// response secret would reappear after redaction removed it. The cost is that a\n340\t// redacted field is validated as `<redacted>`, so redacting a field the schema\n341\t// constrains produces a violation the server did not commit. That is the right\n342\t// way round: a spurious error is visible and correctable, a leaked credential\n343\t// is neither.\n344\t//\n345\t// A response that cannot be validated at all is a warning, not a failure. The\n346\t// call reached the server and came back; whether talaria could then check it\n347\t// against the spec is not a reason to change the exit code an agent branches on.\n348\tfunc validateResponse(\n349\t\tstderr io.Writer,\n350\t\tdoc *spec.Document,\n351\t\treq *request.Request,\n352\t\tview *responseView,\n353\t) *validate.Result {\n354\t\tresult, err := validate.Response(doc, validationInput(req, view))\n355\t\n356\t\treturn reportValidation(stderr, result, err)\n357\t}\n358\t\n359\t// validateWith is validateResponse against a validator that is already built.\n360\t// `run` makes one per suite rather than one per response, because building it\n361\t// compiles every schema in the document.\n362\tfunc validateWith(\n363\t\tstderr io.Writer,\n364\t\tvalidator *validate.Validator,\n365\t\treq *request.Request,\n366\t\tview *responseView,\n367\t) *validate.Result {\n368\t\tresult, err := validator.Response(validationInput(req, view))\n369\t\n370\t\treturn reportValidation(stderr, result, err)\n371\t}\n372\t\n373\t// validationInput is the one conversion from a request and a redacted response\n374\t// into what the validator reads, so `call` and `run` cannot check different\n375\t// things.\n376\tfunc validationInput(req *request.Request, view *responseView) validate.Input {\n377\t\treturn validate.Input{\n378\t\t\tMethod:  req.Method,\n379\t\t\tURL:     curl.URL(req),\n380\t\t\tStatus:  view.Status,\n381\t\t\tHeaders: http.Header(view.Headers),\n382\t\t\tBody:    view.Body,\n383\t\t}\n384\t}\n385\t\n386\t// reportValidation turns a validator failure into a warning and no result.\n387\tfunc reportValidation(stderr io.Writer, result *validate.Result, err error) *validate.Result {\n388\t\tif err != nil {\n389\t\t\tfmt.Fprintf(stderr, \"warning: the response was not validated: %v\\n\", err)\n390\t\t\treturn nil\n391\t\t}\n392\t\n393\t\treturn result\n394\t}\n395\t\n396\t// callFailure is what --fail-on-error turns an observation into.\n397\t//\n398\t// Both cases exit 4 (§4). The HTTP status is reported first when both apply:\n399\t// a 500 whose body does not match the spec's error schema is a server that is\n400\t// down, not a server with a documentation problem.\n401\t//\n402\t// The message summarises rather than quotes. The errors themselves are already\n403\t// on stdout, structured and per-field, which is the surface built for reading\n404\t// them; repeating one here would only add a second place for content to escape.\n405\tfunc callFailure(view *responseView, result *validate.Result) error {\n406\t\tif view.Status >= http.StatusBadRequest {\n407\t\t\treturn clierr.Validation(\"the server returned %s\", statusText(view.Status))\n408\t\t}\n409\t\tif result != nil && len(result.Errors) > 0 {\n410\t\t\treturn clierr.Validation(\"the response violates the spec: %s\",\n411\t\t\t\tpluralise(len(result.Errors), \"validation error\"))\n412\t\t}\n413\t\n414\t\treturn nil\n415\t}\n416\t\n417\t// pluralise renders a count with its noun, adding the s English adds.\n418\tfunc pluralise(n int, noun string) string {\n419\t\tif n == 1 {\n420\t\t\treturn \"1 \" + noun\n421\t\t}\n422\t\n423\t\treturn fmt.Sprintf(\"%d %ss\", n, noun)\n424\t}\n425\t\n426\t// callPayload renders one call in both shapes from the same values, so the JSON\n427\t// block and the printed command cannot disagree about what was sent. A nil resp\n428\t// is a dry run: the request block is identical either way, which is what makes\n429\t// `--dry-run` a faithful preview rather than a separate code path.\n430\t//\n431\t// The view is built from the request's *redacted* representation throughout —\n432\t// requestView holds Value.String() and curl.Render's symbolic form, never a\n433\t// resolved credential. The only code that resolves one is internal/curl, at\n434\t// exec time, and it hands back a Response rather than a Request (§5a).\n435\tfunc callPayload(req *request.Request, resp *responseView, result *validate.Result) output.Payload {\n436\t\tview := callView{\n437\t\t\tDryRun: resp == nil,\n438\t\t\tRequest: requestView{\n439\t\t\t\tCurl:    curl.Render(req),\n440\t\t\t\tMethod:  req.Method,\n441\t\t\t\tURL:     curl.URL(req),\n442\t\t\t\tHeaders: pairMap(req.Headers),\n443\t\t\t\tCookies: pairMap(req.Cookies),\n444\t\t\t},\n445\t\t}\n446\t\tif req.Body != nil {\n447\t\t\tview.Request.Body = string(req.Body.Data)\n448\t\t}\n449\t\n450\t\t// One line each: the request being described, then the command that makes\n451\t\t// it. A table would put the curl in a column and pad it into unreadability.\n452\t\trows := [][]string{\n453\t\t\t{view.Request.Method + \" \" + view.Request.URL},\n454\t\t\t{view.Request.Curl},\n455\t\t}\n456\t\n457\t\tif resp != nil {\n458\t\t\tview.Response = resp\n459\t\t\tview.Validation = result\n460\t\t\t// Status and timing only. The response headers are not summarised here\n461\t\t\t// because a Set-Cookie or an X-Auth-Token would land in a human's\n462\t\t\t// scrollback unasked; --output json is where the full response lives.\n463\t\t\trows = append(rows, []string{statusLine(resp)})\n464\t\t\t// A count, not the messages: a human scanning a call wants to know\n465\t\t\t// whether to go look. The messages are in --output json, where they can\n466\t\t\t// be read whole rather than truncated into a table cell.\n467\t\t\tif result != nil {\n468\t\t\t\trows = append(rows, []string{validationLine(result)})\n469\t\t\t}\n470\t\t}\n471\t\n472\t\treturn output.Payload{Data: view, Table: output.Table{Rows: rows}}\n473\t}\n474\t\n475\t// statusLine is the pretty renderer's one-line summary of a response.\n476\tfunc statusLine(resp *responseView) string {\n477\t\treturn fmt.Sprintf(\"%s in %dms\", statusText(resp.Status), resp.TimingMS)\n478\t}\n479\t\n480\t// statusText renders a status code with its reason phrase, for a code that has\n481\t// one.\n482\tfunc statusText(status int) string {\n483\t\tline := strconv.Itoa(status)\n484\t\tif text := http.StatusText(status); text != \"\" {\n485\t\t\tline += \" \" + text\n486\t\t}\n487\t\n488\t\treturn line\n489\t}\n490\t\n491\t// validationLine is the pretty renderer's one-line summary of the validation\n492\t// block.\n493\tfunc validationLine(result *validate.Result) string {\n494\t\tif len(result.Errors) == 0 {\n495\t\t\treturn \"validation: ok\"\n496\t\t}\n497\t\n498\t\treturn \"validation: \" + pluralise(len(result.Errors), \"error\")\n499\t}\n500\t\n501\t// pairMap renders headers or cookies as the object §4's sketch shows. Values\n502\t// are the redacted display form: this field is read, not run, so it carries\n503\t// <redacted:env:NAME> rather than the shell reference. A name that repeats is\n504\t// joined the way HTTP itself joins repeated field values, so nothing is lost.\n505\tfunc pairMap(pairs []request.Pair) map[string]string {\n506\t\tif len(pairs) == 0 {\n507\t\t\treturn nil\n508\t\t}\n509\t\n510\t\tout := make(map[string]string, len(pairs))\n511\t\tfor _, p := range pairs {\n512\t\t\tif existing, ok := out[p.Name]; ok {\n513\t\t\t\tout[p.Name] = existing + \", \" + p.Value.String()\n514\t\t\t\tcontinue\n515\t\t\t}\n516\t\t\tout[p.Name] = p.Value.String()\n517\t\t}\n518\t\n519\t\treturn out\n520\t}\n521\t\n522\t// operationName is the operation's ID, falling back to method and path for a\n523\t// spec that sets no operationId.\n524\tfunc operationName(op operation.Operation) string {\n525\t\tif op.ID != \"\" {\n526\t\t\treturn op.ID\n527\t\t}\n528\t\n529\t\treturn strings.TrimSpace(op.Method + \" \" + op.Path)\n530\t}\n531\t"
      }
