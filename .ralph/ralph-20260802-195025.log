    "oldString": "import (\n\t\"net/http\"\n\t\"os\"\n\t\"strings\"\n\t\"unicode/utf8\"\n\n\t\"github.com/Teeeep/talaria/internal/clierr\"\n\t\"github.com/Teeeep/talaria/internal/request\"\n)",
