        "type": "tool_result",
        "content": "528\tfunc TestHistoryShowRejectsAnOutOfRangeIndex(t *testing.T) {\n529\t\tisolateHistory(t)\n530\t\tseedHistory(t,\n531\t\t\tseedEntry(corpus.SourceCall, 3*time.Minute, \"a\", \"GET\", \"https://api.test/a\", 200),\n532\t\t\tseedEntry(corpus.SourceCall, 2*time.Minute, \"b\", \"GET\", \"https://api.test/b\", 200),\n533\t\t\tseedEntry(corpus.SourceCall, time.Minute, \"c\", \"GET\", \"https://api.test/c\", 200),\n534\t\t)\n535\t\n536\t\tcode, _, stderr := runHistory(t, \"show\", \"9\")\n537\t\tif code != 2 {\n538\t\t\tt.Fatalf(\"history show 9 = %d, want 2; stderr: %s\", code, stderr)\n539\t\t}\n540\t\n541\t\tmsg := decodeErr(t, stderr).Error.Message\n542\t\tif !strings.Contains(msg, \"9\") {\n543\t\t\tt.Errorf(\"error message %q does not name the index asked for\", msg)\n544\t\t}\n545\t\tif !strings.Contains(msg, \"1-3\") {\n546\t\t\tt.Errorf(\"error message %q does not state the valid range 1-3\", msg)\n547\t\t}\n548\t}\n549\t\n550\tfunc TestHistoryShowOnAnEmptyStoreSaysSo(t *testing.T) {\n551\t\tisolateHistory(t)\n552\t\n553\t\tcode, _, stderr := runHistory(t, \"show\", \"1\")\n554\t\tif code != 2 {\n555\t\t\tt.Fatalf(\"history show on an empty store = %d, want 2; stderr: %s\", code, stderr)\n556\t\t}\n557\t\tif msg := decodeErr(t, stderr).Error.Message; !strings.Contains(msg, \"empty\") {\n558\t\t\tt.Errorf(\"error message %q does not say the history is empty\", msg)\n559\t\t}\n560\t}\n561\t\n562\tfunc TestHistoryReplayReissuesTheCallAndRecordsANewEntry(t *testing.T) {\n563\t\tisolateHistory(t)\n564\t\tsrv := newCallServer(t, jsonPet)\n565\t\n566\t\tcode, _, stderr := runCall(t,\n567\t\t\t\"testdata/call.yaml\", \"getPet\", \"--param\", \"petId=42\", \"--query\", \"verbose=true\",\n568\t\t\t\"--base-url\", srv.URL, \"--output\", \"json\")\n569\t\tif code != 0 {\n570\t\t\tt.Fatalf(\"call = %d, want 0; stderr: %s\", code, stderr)\n571\t\t}\n572\t\n573\t\tcode, stdout, stderr := runHistory(t, \"replay\", \"1\", \"--output\", \"json\")\n574\t\tif code != 0 {\n575\t\t\tt.Fatalf(\"history replay 1 = %d, want 0; stderr: %s\", code, stderr)\n576\t\t}\n577\t\n578\t\t// Replay renders the same envelope a call does, so an agent parses one shape.\n579\t\treplayed := decodeCall(t, stdout)\n580\t\tif replayed.Response == nil || replayed.Response.Status != http.StatusOK {\n581\t\t\tt.Fatalf(\"replay produced no successful response:\\n%s\", stdout)\n582\t\t}\n583\t\n584\t\trec := srv.received()\n585\t\tif rec.Path != \"/pets/42\" {\n586\t\t\tt.Errorf(\"server saw path %q on replay, want /pets/42\", rec.Path)\n587\t\t}\n588\t\tif rec.Query != \"verbose=true\" {\n589\t\t\tt.Errorf(\"server saw query %q on replay, want verbose=true\", rec.Query)\n590\t\t}\n591\t\t// The credential is re-resolved from the environment: it was never written to\n592\t\t// history, so this is the only place it could have come from (§5a).\n593\t\tif got, want := rec.Header.Get(\"Authorization\"), \"Bearer \"+callCanary; got != want {\n594\t\t\tt.Errorf(\"server saw Authorization %q on replay, want %q\", got, want)\n595\t\t}\n596\t\n597\t\tentries := readHistory(t)\n598\t\tif len(entries) != 2 {\n599\t\t\tt.Fatalf(\"history holds %d entries after a replay, want 2\", len(entries))\n600\t\t}\n601\t\tif entries[0].Source != corpus.SourceCall {\n602\t\t\tt.Errorf(\"the original entry became %q; replay must leave it intact\", entries[0].Source)\n603\t\t}\n604\t\tif entries[1].Source != corpus.SourceReplay {\n605\t\t\tt.Errorf(\"the new entry's source = %q, want %q\", entries[1].Source, corpus.SourceReplay)\n606\t\t}\n607\t\tif entries[1].OperationID != \"getPet\" {\n608\t\t\tt.Errorf(\"the new entry's operation_id = %q, want getPet\", entries[1].OperationID)\n609\t\t}\n610\t}\n611\t\n612\tfunc TestHistoryReplayStillRequiresAllowMutations(t *testing.T) {\n613\t\tisolateHistory(t)\n614\t\tsrv := newCallServer(t, func(w http.ResponseWriter, _ *http.Request) {\n615\t\t\tw.WriteHeader(http.StatusCreated)\n616\t\t})\n617\t\n618\t\tcode, _, stderr := runCall(t,\n619\t\t\t\"testdata/call.yaml\", \"createPet\", \"--allow-mutations\", \"--body\", `{\"name\":\"Rex\"}`,\n620\t\t\t\"--base-url\", srv.URL, \"--output\", \"json\")\n621\t\tif code != 0 {\n622\t\t\tt.Fatalf(\"call createPet = %d, want 0; stderr: %s\", code, stderr)\n623\t\t}\n624\t\n625\t\tcode, _, stderr = runHistory(t, \"replay\", \"1\", \"--output\", \"json\")\n626\t\tif code != 2 {\n627\t\t\tt.Fatalf(\"history replay of a POST = %d, want 2; stderr: %s\", code, stderr)\n628\t\t}\n629\t\tif msg := decodeErr(t, stderr).Error.Message; !strings.Contains(msg, \"--allow-mutations\") {\n630\t\t\tt.Errorf(\"error message %q does not name the flag that permits it\", msg)\n631\t\t}\n632\t\tif entries := readHistory(t); len(entries) != 1 {\n633\t\t\tt.Errorf(\"a gated replay wrote %d entries, want the original 1\", len(entries))\n634\t\t}\n635\t\n636\t\tcode, _, stderr = runHistory(t, \"replay\", \"1\", \"--allow-mutations\", \"--output\", \"json\")\n637\t\tif code != 0 {\n638\t\t\tt.Fatalf(\"history replay --allow-mutations = %d, want 0; stderr: %s\", code, stderr)\n639\t\t}\n640\t\tif got := srv.received().Body; got != `{\"name\":\"Rex\"}` {\n641\t\t\tt.Errorf(\"server saw body %q on replay, want the recorded one\", got)\n642\t\t}\n643\t}\n644\t\n645\tfunc TestHistoryDisabledInTheProfileRecordsNothing(t *testing.T) {\n646\t\tpath := isolateHistory(t)\n647\t\twriteRedactConfig(t, \"profiles:\\n  quiet:\\n    history:\\n      enabled: false\\n\")"
      }
