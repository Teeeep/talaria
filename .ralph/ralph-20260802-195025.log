        "tool_use_id": "toolu_016QTNBkNZZiigNMbdkmngxm",
        "type": "tool_result",
        "content": "1\tpackage canary_test\n2\t\n3\timport (\n4\t\t\"encoding/base64\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"io/fs\"\n9\t\t\"net/http\"\n10\t\t\"net/http/httptest\"\n11\t\t\"net/url\"\n12\t\t\"os\"\n13\t\t\"os/exec\"\n14\t\t\"path/filepath\"\n15\t\t\"strings\"\n16\t\t\"sync\"\n17\t\t\"testing\"\n18\t\n19\t\t\"github.com/Teeeep/talaria/internal/canary\"\n20\t)\n21\t\n22\t// specPath is the fixture declaring one security scheme per auth mechanism.\n23\tconst specPath = \"testdata/canary.yaml\"\n24\t\n25\t// binary is the talaria under test, built once by TestMain.\n26\t//\n27\t// The suite drives a real process rather than calling the command tree\n28\t// in-process, for one reason: the command tree lives in package main and cannot\n29\t// be imported. Running the binary is also the stronger reading of §5a — it\n30\t// greps every byte the process emits, including anything written outside the\n31\t// writers a test would otherwise hand it.\n32\tvar binary string\n33\t\n34\tfunc TestMain(m *testing.M) {\n35\t\tdir, err := os.MkdirTemp(\"\", \"talaria-canary-*\")\n36\t\tif err != nil {\n37\t\t\tfmt.Fprintf(os.Stderr, \"creating the build directory: %v\\n\", err)\n38\t\t\tos.Exit(1)\n39\t\t}\n40\t\n41\t\tif err := readSources(); err != nil {\n42\t\t\tfmt.Fprintf(os.Stderr, \"reading the sources under test: %v\\n\", err)\n43\t\t\tos.Exit(1)\n44\t\t}\n45\t\n46\t\tbinary = filepath.Join(dir, \"talaria\")\n47\t\tbuild := exec.Command(\"go\", \"build\", \"-o\", binary, \"./cmd/talaria\")\n48\t\tbuild.Dir = filepath.Join(\"..\", \"..\")\n49\t\tif out, err := build.CombinedOutput(); err != nil {\n50\t\t\tfmt.Fprintf(os.Stderr, \"building talaria: %v\\n%s\", err, out)\n51\t\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n52\t\t\tos.Exit(1)\n53\t\t}\n54\t\n55\t\tcode := m.Run()\n56\t\n57\t\t// Explicit rather than deferred: os.Exit does not run defers.\n58\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n59\t\tos.Exit(code)\n60\t}\n61\t\n62\t// readSources opens every Go source file in the module so the test cache knows\n63\t// this suite depends on all of them.\n64\t//\n65\t// It has to be said out loud because the dependency is invisible to the tool:\n66\t// the suite reaches the code under test by building a binary in a subprocess,\n67\t// and `go test` records nothing about that. Without this, a leak introduced in\n68\t// internal/curl or cmd/talaria would leave the canary package's own inputs\n69\t// untouched, and `go test ./...` would replay a cached pass over code that\n70\t// never ran. A gate that can go stale is not a gate. The test cache does track\n71\t// files a test reads, so reading them is how the dependency is declared.\n72\tfunc readSources() error {\n73\t\troot := filepath.Join(\"..\", \"..\")\n74\t\n75\t\treturn filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {\n76\t\t\tif err != nil || d.IsDir() || !strings.HasSuffix(path, \".go\") {\n77\t\t\t\treturn err\n78\t\t\t}\n79\t\n80\t\t\t_, err = os.ReadFile(path)\n81\t\n82\t\t\treturn err\n83\t\t})\n84\t}\n85\t\n86\t// mechanism is one way of authenticating, driven end to end with its own\n87\t// canary. Received proves the credential actually reached the server, which is\n88\t// what makes the absence of it everywhere else mean something: a call that\n89\t// quietly sent nothing would pass every leak assertion.\n90\ttype mechanism struct {\n91\t\tname string\n92\t\top   string\n93\t\t// env builds the environment carrying the canary, keyed by variable name.\n94\t\tenv func(value string) map[string]string\n95\t\t// received reports whether the server saw the canary on the request.\n96\t\treceived func(req recordedRequest, value string) bool\n97\t}\n98\t\n99\tvar mechanisms = []mechanism{\n100\t\t{\n101\t\t\tname: \"bearer\",\n102\t\t\top:   \"getBearer\",\n103\t\t\tenv:  func(v string) map[string]string { return map[string]string{\"TALARIA_AUTH_BEARER\": v} },\n104\t\t\treceived: func(req recordedRequest, v string) bool {\n105\t\t\t\treturn req.Header.Get(\"Authorization\") == \"Bearer \"+v\n106\t\t\t},\n107\t\t},\n108\t\t{\n109\t\t\tname: \"basic\",\n110\t\t\top:   \"getBasic\",\n111\t\t\tenv: func(v string) map[string]string {\n112\t\t\t\treturn map[string]string{\"TALARIA_AUTH_BASIC\": \"canaryuser:\" + v}\n113\t\t\t},\n114\t\t\treceived: func(req recordedRequest, v string) bool {\n115\t\t\t\t// Basic auth is the one mechanism that encodes the credential before\n116\t\t\t\t// it goes on the wire, which is why Scan looks for base64 too.\n117\t\t\t\twant := \"Basic \" + base64.StdEncoding.EncodeToString([]byte(\"canaryuser:\"+v))\n118\t\t\t\treturn req.Header.Get(\"Authorization\") == want\n119\t\t\t},\n120\t\t},\n121\t\t{\n122\t\t\tname: \"apikey-header\",\n123\t\t\top:   \"getHeaderKey\",\n124\t\t\tenv: func(v string) map[string]string {\n125\t\t\t\treturn map[string]string{\"TALARIA_AUTH_APIKEY_HEADERKEY\": v}\n126\t\t\t},\n127\t\t\treceived: func(req recordedRequest, v string) bool {\n128\t\t\t\treturn req.Header.Get(\"X-Api-Key\") == v\n129\t\t\t},\n130\t\t},\n131\t\t{\n132\t\t\tname: \"apikey-query\",\n133\t\t\top:   \"getQueryKey\",\n134\t\t\tenv: func(v string) map[string]string {\n135\t\t\t\treturn map[string]string{\"TALARIA_AUTH_APIKEY_QUERYKEY\": v}\n136\t\t\t},\n137\t\t\treceived: func(req recordedRequest, v string) bool {\n138\t\t\t\treturn req.Query.Get(\"api_key\") == v\n139\t\t\t},\n140\t\t},\n141\t\t{\n142\t\t\tname: \"apikey-cookie\",\n143\t\t\top:   \"getCookieKey\",\n144\t\t\tenv: func(v string) map[string]string {\n145\t\t\t\treturn map[string]string{\"TALARIA_AUTH_APIKEY_COOKIEKEY\": v}\n146\t\t\t},\n147\t\t\treceived: func(req recordedRequest, v string) bool {\n148\t\t\t\treturn req.Cookies[v] || strings.Contains(req.Header.Get(\"Cookie\"), v)\n149\t\t\t},\n150\t\t},\n151\t}\n152\t\n153\t// result is one talaria invocation.\n154\ttype result struct {\n155\t\targs   []string\n156\t\tcode   int\n157\t\tstdout string\n158\t\tstderr string\n159\t}\n160\t\n161\t// harness runs talaria against an isolated home, so the only credentials in\n162\t// reach are the ones a case injected and the only files it can write are ones\n163\t// the case can then read back and grep.\n164\ttype harness struct {\n165\t\tt     *testing.T\n166\t\tenv   []string\n167\t\tstate string\n168\t\tcache string\n169\t\tconf  string\n170\t}\n171\t\n172\tfunc newHarness(t *testing.T, vars map[string]string) *harness {\n173\t\tt.Helper()\n174\t\n175\t\thome := t.TempDir()\n176\t\th := &harness{\n177\t\t\tt:     t,\n178\t\t\tstate: filepath.Join(home, \"state\"),\n179\t\t\tcache: filepath.Join(home, \"cache\"),\n180\t\t\tconf:  filepath.Join(home, \"config\"),\n181\t\t}\n182\t\n183\t\t// Built from nothing rather than from os.Environ: a developer's own\n184\t\t// TALARIA_AUTH_BEARER or TALARIA_SPEC must not be able to change what this\n185\t\t// suite tests, and PATH is all curl needs to be found.\n186\t\th.env = []string{\n187\t\t\t\"PATH=\" + os.Getenv(\"PATH\"),\n188\t\t\t\"HOME=\" + home,\n189\t\t\t\"XDG_STATE_HOME=\" + h.state,\n190\t\t\t\"XDG_CACHE_HOME=\" + h.cache,\n191\t\t\t\"XDG_CONFIG_HOME=\" + h.conf,\n192\t\t}\n193\t\tfor name, value := range vars {\n194\t\t\th.env = append(h.env, name+\"=\"+value)\n195\t\t}\n196\t\n197\t\treturn h\n198\t}\n199\t\n200\t// run executes talaria and captures both streams.\n201\tfunc (h *harness) run(args ...string) result {\n202\t\th.t.Helper()\n203\t\n204\t\tcmd := exec.Command(binary, args...)\n205\t\tcmd.Env = h.env\n206\t\n207\t\tvar stdout, stderr strings.Builder\n208\t\tcmd.Stdout, cmd.Stderr = &stdout, &stderr\n209\t\n210\t\tcode := 0\n211\t\tif err := cmd.Run(); err != nil {\n212\t\t\tvar exit *exec.ExitError\n213\t\t\tif !errors.As(err, &exit) {\n214\t\t\t\th.t.Fatalf(\"running talaria %s: %v\", strings.Join(args, \" \"), err)\n215\t\t\t}\n216\t\t\tcode = exit.ExitCode()\n217\t\t}\n218\t\n219\t\treturn result{args: args, code: code, stdout: stdout.String(), stderr: stderr.String()}\n220\t}\n221\t\n222\t// runOK runs talaria and fails the test unless it exited 0.\n223\tfunc (h *harness) runOK(args ...string) result {\n224\t\th.t.Helper()\n225\t\n226\t\tres := h.run(args...)\n227\t\tif res.code != 0 {\n228\t\t\th.t.Fatalf(\"talaria %s = %d, want 0; stderr: %s\",\n229\t\t\t\tstrings.Join(args, \" \"), res.code, res.stderr)\n230\t\t}\n231\t\n232\t\treturn res\n233\t}\n234\t\n235\t// surfaces returns both streams of a result as scannable surfaces.\n236\tfunc (r result) surfaces() []canary.Surface {\n237\t\tlabel := strings.Join(r.args, \" \")\n238\t\n239\t\treturn []canary.Surface{\n240\t\t\tcanary.Stream(\"stdout of `talaria \"+label+\"`\", r.stdout),\n241\t\t\tcanary.Stream(\"stderr of `talaria \"+label+\"`\", r.stderr),\n242\t\t}\n243\t}\n244\t\n245\t// written returns every file talaria left behind: the history store, the spec\n246\t// cache, anything a future version starts writing into the same directories.\n247\t// Enumerated by walking, not by name, so a new persistent artifact is covered\n248\t// the day it appears.\n249\t//\n250\t// The config directory is deliberately not among them. Nothing talaria writes\n251\t// goes there — it is an input the user wrote, and a case that puts a canary in\n252\t// a config file to see how an error path handles it would otherwise be caught\n253\t// finding its own fixture.\n254\tfunc (h *harness) written() []canary.Surface {\n255\t\th.t.Helper()\n256\t\n257\t\tvar surfaces []canary.Surface\n258\t\tfor label, root := range map[string]string{\n259\t\t\t\"history\": h.state,\n260\t\t\t\"cache\":   h.cache,\n261\t\t} {\n262\t\t\tfound, err := canary.Tree(label, root)\n263\t\t\tif err != nil {\n264\t\t\t\th.t.Fatalf(\"enumerating the %s surfaces: %v\", label, err)\n265\t\t\t}\n266\t\t\tsurfaces = append(surfaces, found...)\n267\t\t}\n268\t\n269\t\treturn surfaces\n270\t}\n271\t\n272\t// recordedRequest is what arrived at the test server.\n273\ttype recordedRequest struct {\n274\t\tHeader  http.Header\n275\t\tQuery   url.Values\n276\t\tCookies map[string]bool\n277\t}\n278\t\n279\ttype recordingServer struct {\n280\t\t*httptest.Server\n281\t\n282\t\tmu   sync.Mutex\n283\t\tlast recordedRequest\n284\t}\n285\t\n286\t// newServer starts a server that records each request and answers 200 with a\n287\t// body carrying no secret of its own.\n288\tfunc newServer(t *testing.T, body string) *recordingServer {\n289\t\tt.Helper()\n290\t\n291\t\trs := &recordingServer{}\n292\t\trs.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n293\t\t\tcookies := map[string]bool{}\n294\t\t\tfor _, c := range r.Cookies() {\n295\t\t\t\tcookies[c.Value] = true\n296\t\t\t}\n297\t\n298\t\t\trs.mu.Lock()\n299\t\t\trs.last = recordedRequest{\n300\t\t\t\tHeader:  r.Header.Clone(),\n301\t\t\t\tQuery:   r.URL.Query(),\n302\t\t\t\tCookies: cookies,\n303\t\t\t}\n304\t\t\trs.mu.Unlock()\n305\t\n306\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n307\t\t\t_, _ = io.WriteString(w, body)\n308\t\t}))\n309\t\tt.Cleanup(rs.Close)\n310\t\n311\t\treturn rs\n312\t}\n313\t\n314\tfunc (rs *recordingServer) received() recordedRequest {\n315\t\trs.mu.Lock()\n316\t\tdefer rs.mu.Unlock()\n317\t\n318\t\treturn rs.last\n319\t}\n320\t\n321\t// TestNoAuthMechanismLeaksIntoAnyOutputSurface is the suite §5a asks for: every\n322\t// auth mechanism, every output format, every surface a run produces.\n323\t//\n324\t// The format loop comes from canary.Formats, which is internal/output's Format\n325\t// enum. A fourth format is exercised here the day it is added, and the\n326\t// non-empty assertion below means a format that renders nothing fails rather\n327\t// than passing vacuously.\n328\tfunc TestNoAuthMechanismLeaksIntoAnyOutputSurface(t *testing.T) {\n329\t\tfor _, mech := range mechanisms {\n330\t\t\tfor _, format := range canary.Formats() {\n331\t\t\t\tt.Run(mech.name+\"/\"+format, func(t *testing.T) {\n332\t\t\t\t\tt.Parallel()\n333\t\n334\t\t\t\t\tvalue := canary.Value(mech.name)\n335\t\t\t\t\th := newHarness(t, mech.env(value))\n336\t\t\t\t\tsrv := newServer(t, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n337\t\n338\t\t\t\t\tvar runs []result\n339\t\t\t\t\truns = append(runs,\n340\t\t\t\t\t\th.runOK(\"call\", specPath, mech.op,\n341\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--output\", format, \"--dry-run\"),\n342\t\t\t\t\t\th.runOK(\"call\", specPath, mech.op,\n343\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--output\", format),\n344\t\t\t\t\t\t// Exits 5: the fixture declares every scheme and this case\n345\t\t\t\t\t\t// sets one. The report is the surface being checked, and it\n346\t\t\t\t\t\t// is written on the way to that exit code.\n347\t\t\t\t\t\th.run(\"auth\", \"check\", specPath, \"--output\", format),\n348\t\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n349\t\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n350\t\t\t\t\t\th.runOK(\"history\", \"replay\", \"1\", \"--output\", format),\n351\t\t\t\t\t\th.runOK(\"describe\", specPath, mech.op, \"--output\", format),\n352\t\t\t\t\t\th.runOK(\"list\", specPath, \"--output\", format),\n353\t\t\t\t\t\t// Last, so it disturbs no history index above. `run` sends\n354\t\t\t\t\t\t// the same credential `call` does and renders its own\n355\t\t\t\t\t\t// report, so it is its own surface.\n356\t\t\t\t\t\th.runOK(\"run\", specPath, \"--operation\", mech.op,\n357\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--report\", format),\n358\t\t\t\t\t)\n359\t\n360\t\t\t\t\t// The credential reached the server. Without this the rest of\n361\t\t\t\t\t// the test would pass just as well if talaria sent nothing.\n362\t\t\t\t\tif !mech.received(srv.received(), value) {\n363\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s credential; the leak assertions below prove nothing\", mech.name)\n364\t\t\t\t\t}\n365\t\n366\t\t\t\t\tvar surfaces []canary.Surface\n367\t\t\t\t\tfor _, res := range runs {\n368\t\t\t\t\t\tif strings.TrimSpace(res.stdout) == \"\" {\n369\t\t\t\t\t\t\tt.Errorf(\"`talaria %s` printed nothing; --output %s renders no payload\",\n370\t\t\t\t\t\t\t\tstrings.Join(res.args, \" \"), format)\n371\t\t\t\t\t\t}\n372\t\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n373\t\t\t\t\t}\n374\t\t\t\t\tsurfaces = append(surfaces, h.written()...)\n375\t\n376\t\t\t\t\tassertNoLeak(t, value, surfaces)\n377\t\t\t\t})\n378\t\t\t}\n379\t\t}\n380\t}\n381\t\n382\t// TestNoReportFormatLeaksTheCredential covers §5a's \"junit reports\" among the\n383\t// output surfaces, and every other shape `run --report` writes.\n384\t//\n385\t// It is a loop of its own rather than a line in the test above because the\n386\t// report formats are a superset of the --output ones: junit describes a suite\n387\t// of operations, which is something only `run` produces. Driving it from\n388\t// canary.ReportFormats means a fifth report format is covered the day it is\n389\t// added.\n390\tfunc TestNoReportFormatLeaksTheCredential(t *testing.T) {\n391\t\tfor _, mech := range mechanisms {\n392\t\t\tfor _, format := range canary.ReportFormats() {\n393\t\t\t\tt.Run(mech.name+\"/\"+format, func(t *testing.T) {\n394\t\t\t\t\tt.Parallel()\n395\t\n396\t\t\t\t\tvalue := canary.Value(mech.name)\n397\t\t\t\t\th := newHarness(t, mech.env(value))\n398\t\t\t\t\tsrv := newServer(t, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n399\t\n400\t\t\t\t\tres := h.runOK(\"run\", specPath, \"--operation\", mech.op,\n401\t\t\t\t\t\t\"--base-url\", srv.URL, \"--report\", format)\n402\t\n403\t\t\t\t\tif !mech.received(srv.received(), value) {\n404\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s credential; the leak assertions below prove nothing\", mech.name)\n405\t\t\t\t\t}\n406\t\t\t\t\t// A report that named the operation is a report that rendered.\n407\t\t\t\t\t// Without this a format writing an empty shell would pass every\n408\t\t\t\t\t// assertion below by having nothing in it at all.\n409\t\t\t\t\tif !strings.Contains(res.stdout, mech.op) {\n410\t\t\t\t\t\tt.Errorf(\"`--report %s` does not name the operation it ran:\\n%s\", format, res.stdout)\n411\t\t\t\t\t}\n412\t\n413\t\t\t\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n414\t\t\t\t})\n415\t\t\t}\n416\t\t}\n417\t}\n418\t\n419\t// TestErrorPathsDoNotLeakTheCredential covers §5a's \"error paths are where\n420\t// redaction bugs live\": a failure at each stage of a call, with a credential\n421\t// present throughout.\n422\tfunc TestErrorPathsDoNotLeakTheCredential(t *testing.T) {\n423\t\t// A response-validation failure is not here because response validation is\n424\t\t// not built yet (plan tasks 26 and 27). Whoever adds --fail-on-error adds\n425\t\t// the case; the stages that exist are all covered.\n426\t\tstages := []struct {\n427\t\t\tname string\n428\t\t\targs func(serverURL string) []string\n429\t\t\tcode int\n430\t\t}{\n431\t\t\t{\n432\t\t\t\tname: \"spec load\",\n433\t\t\t\targs: func(string) []string { return []string{\"call\", \"testdata/absent.yaml\", \"getBearer\"} },\n434\t\t\t\tcode: 3,\n435\t\t\t},\n436\t\t\t{\n437\t\t\t\tname: \"operation lookup\",\n438\t\t\t\targs: func(string) []string { return []string{\"call\", specPath, \"noSuchOperation\"} },\n439\t\t\t\tcode: 2,\n440\t\t\t},\n441\t\t\t{\n442\t\t\t\tname: \"parameter binding\",\n443\t\t\t\targs: func(url string) []string {\n444\t\t\t\t\t// getPet's petId is required and unbound.\n445\t\t\t\t\treturn []string{\"call\", specPath, \"getPet\", \"--base-url\", url}\n446\t\t\t\t},\n447\t\t\t\tcode: 2,\n448\t\t\t},\n449\t\t\t{\n450\t\t\t\tname: \"mutation gate\",\n451\t\t\t\targs: func(url string) []string {\n452\t\t\t\t\treturn []string{\"call\", specPath, \"createThing\", \"--base-url\", url}\n453\t\t\t\t},\n454\t\t\t\tcode: 2,\n455\t\t\t},\n456\t\t\t{\n457\t\t\t\tname: \"body read\",\n458\t\t\t\targs: func(url string) []string {\n459\t\t\t\t\treturn []string{\"call\", specPath, \"getBearer\", \"--base-url\", url, \"--body\", \"@testdata/absent.json\"}\n460\t\t\t\t},\n461\t\t\t\tcode: 2,\n462\t\t\t},\n463\t\t\t{\n464\t\t\t\tname: \"curl exec\",\n465\t\t\t\targs: func(string) []string {\n466\t\t\t\t\t// Port 1 on the loopback interface: curl runs, the request fails.\n467\t\t\t\t\treturn []string{\"call\", specPath, \"getBearer\", \"--base-url\", \"http://127.0.0.1:1\"}\n468\t\t\t\t},\n469\t\t\t\tcode: 1,\n470\t\t\t},\n471\t\t\t{\n472\t\t\t\tname: \"history index\",\n473\t\t\t\targs: func(string) []string { return []string{\"history\", \"show\", \"99\"} },\n474\t\t\t\tcode: 2,\n475\t\t\t},\n476\t\t}\n477\t\n478\t\tfor _, stage := range stages {\n479\t\t\tt.Run(stage.name, func(t *testing.T) {\n480\t\t\t\tt.Parallel()\n481\t\n482\t\t\t\tvalue := canary.Value(\"error\")\n483\t\t\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n484\t\t\t\tsrv := newServer(t, `{}`)\n485\t\n486\t\t\t\tres := h.run(stage.args(srv.URL)...)\n487\t\t\t\tif res.code != stage.code {\n488\t\t\t\t\tt.Errorf(\"talaria %s = %d, want %d; stderr: %s\",\n489\t\t\t\t\t\tstrings.Join(res.args, \" \"), res.code, stage.code, res.stderr)\n490\t\t\t\t}\n491\t\t\t\tif strings.TrimSpace(res.stderr) == \"\" {\n492\t\t\t\t\tt.Errorf(\"talaria %s failed silently; there is no error surface to check\",\n493\t\t\t\t\t\tstrings.Join(res.args, \" \"))\n494\t\t\t\t}\n495\t\n496\t\t\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n497\t\t\t})\n498\t\t}\n499\t}\n500\t\n501\t// TestACredentialResolutionFailureNamesNoValue covers the one error path where\n502\t// the credential is in a *configuration file* rather than the environment: a\n503\t// profile with a literal value is refused, and the refusal must not quote what\n504\t// it refused (§5a).\n505\tfunc TestACredentialResolutionFailureNamesNoValue(t *testing.T) {\n506\t\tt.Parallel()\n507\t\n508\t\tvalue := canary.Value(\"profile\")\n509\t\th := newHarness(t, nil)\n510\t\twriteConfig(t, h, \"profiles:\\n  staging:\\n    auth:\\n      bearerAuth: \"+value+\"\\n\")\n511\t\n512\t\tres := h.run(\"call\", specPath, \"getBearer\", \"--profile\", \"staging\", \"--dry-run\")\n513\t\tif res.code != 2 {\n514\t\t\tt.Errorf(\"a literal profile credential = %d, want 2; stderr: %s\", res.code, res.stderr)\n515\t\t}\n516\t\n517\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n518\t}\n519\t\n520\t// TestAMissingCredentialIsReportedWithoutAValue exercises the exit-5 path with\n521\t// a canary set for a *different* scheme, so the report is built while a\n522\t// credential is in reach.\n523\tfunc TestAMissingCredentialIsReportedWithoutAValue(t *testing.T) {\n524\t\tt.Parallel()\n525\t\n526\t\tvalue := canary.Value(\"authcheck\")\n527\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n528\t\n529\t\t// Every other scheme in the fixture is unset, so `auth check` reports the\n530\t\t// gap and exits 5.\n531\t\tres := h.run(\"auth\", \"check\", specPath, \"--output\", \"json\")\n532\t\tif res.code != 5 {\n533\t\t\tt.Errorf(\"auth check with schemes unset = %d, want 5; stderr: %s\", res.code, res.stderr)\n534\t\t}\n535\t\n536\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n537\t}\n538\t\n539\t// TestAUserSuppliedHeaderIsRedactedLikeASpecCredential holds the line the\n540\t// Redactor already claims: \"a bearer token the user typed into --header is as\n541\t// sensitive as one talaria resolved itself\". The value's origin does not change\n542\t// what it is.\n543\t//\n544\t// The --query case is here rather than in a test of its own because it is the\n545\t// same claim about a different flag: §5a names query-string API keys as a\n546\t// credential location, so `--query api_key=…` is covered by the built-in name\n547\t// matcher exactly as `--header X-Api-Key: …` is.\n548\tfunc TestAUserSuppliedHeaderIsRedactedLikeASpecCredential(t *testing.T) {\n549\t\tcases := []struct {\n550\t\t\tname string\n551\t\t\tflag string\n552\t\t\t// arg builds the flag's name=value argument around the canary.\n553\t\t\targ func(value string) string\n554\t\t\t// sent returns what the server actually received under that name, so\n555\t\t\t// each case can prove the value still went out before asserting that\n556\t\t\t// no surface printed it.\n557\t\t\tsent func(name string, req recordedRequest) string\n558\t\t}{\n559\t\t\t{\n560\t\t\t\tname: \"authorization\",\n561\t\t\t\tflag: \"--header\",\n562\t\t\t\targ:  func(v string) string { return \"Authorization=Bearer \" + v },\n563\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Header.Get(name) },\n564\t\t\t},\n565\t\t\t{\n566\t\t\t\tname: \"api-key\",\n567\t\t\t\tflag: \"--header\",\n568\t\t\t\targ:  func(v string) string { return \"X-Api-Key=\" + v },\n569\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Header.Get(name) },\n570\t\t\t},\n571\t\t\t{\n572\t\t\t\tname: \"token\",\n573\t\t\t\tflag: \"--header\",\n574\t\t\t\targ:  func(v string) string { return \"X-Session-Token=\" + v },\n575\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Header.Get(name) },\n576\t\t\t},\n577\t\t\t{\n578\t\t\t\tname: \"query-api-key\",\n579\t\t\t\tflag: \"--query\",\n580\t\t\t\targ:  func(v string) string { return \"api_key=\" + v },\n581\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Query.Get(name) },\n582\t\t\t},\n583\t\t}\n584\t\n585\t\tfor _, tc := range cases {\n586\t\t\tfor _, format := range canary.Formats() {\n587\t\t\t\tt.Run(tc.name+\"/\"+format, func(t *testing.T) {\n588\t\t\t\t\tt.Parallel()\n589\t\n590\t\t\t\t\tvalue := canary.Value(\"header\")\n591\t\t\t\t\th := newHarness(t, nil)\n592\t\t\t\t\tsrv := newServer(t, `{\"ok\":true}`)\n593\t\n594\t\t\t\t\truns := []result{\n595\t\t\t\t\t\th.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL,\n596\t\t\t\t\t\t\ttc.flag, tc.arg(value), \"--output\", format, \"--dry-run\"),\n597\t\t\t\t\t\th.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL,\n598\t\t\t\t\t\t\ttc.flag, tc.arg(value), \"--output\", format),\n599\t\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n600\t\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n601\t\t\t\t\t}\n602\t\n603\t\t\t\t\t// It still has to arrive: redaction is about what talaria prints,\n604\t\t\t\t\t// not about dropping what the user asked to send.\n605\t\t\t\t\tname := strings.SplitN(tc.arg(value), \"=\", 2)[0]\n606\t\t\t\t\tif got := tc.sent(name, srv.received()); !strings.Contains(got, value) {\n607\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s value; the leak assertions below prove nothing\", tc.flag)\n608\t\t\t\t\t}\n609\t\n610\t\t\t\t\tvar surfaces []canary.Surface\n611\t\t\t\t\tfor _, res := range runs {\n612\t\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n613\t\t\t\t\t}\n614\t\n615\t\t\t\t\tassertNoLeak(t, value, append(surfaces, h.written()...))\n616\t\t\t\t})\n617\t\t\t}\n618\t\t}\n619\t}\n620\t\n621\t// TestAnUnconfiguredResponseBodySecretIsNotRedacted documents the boundary\n622\t// rather than pretending it is elsewhere. §5a redacts response headers and the\n623\t// RFC 6749 token fields by name; a secret under an API-specific name is the\n624\t// known uncovered threat, because talaria cannot tell a credential from any\n625\t// other string by looking at it.\n626\t//\n627\t// If this ever fails because the value was redacted, the boundary moved and the\n628\t// documentation — AGENT.md, DESIGN.md §5a — moves with it.\n629\tfunc TestAnUnconfiguredResponseBodySecretIsNotRedacted(t *testing.T) {\n630\t\tt.Parallel()\n631\t\n632\t\tvalue := canary.Value(\"response\")\n633\t\th := newHarness(t, nil)\n634\t\tsrv := newServer(t, `{\"access_token\":\"issued\",\"data\":{\"session\":\"`+value+`\"}}`)\n635\t\n636\t\tres := h.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", \"json\")\n637\t\tif !strings.Contains(res.stdout, value) {\n638\t\t\tt.Errorf(\"an unconfigured response body secret was redacted; the documented boundary has moved:\\n%s\", res.stdout)\n639\t\t}\n640\t\t// The names talaria *can* recognise are covered without configuration, which\n641\t\t// is what makes the above a boundary rather than an absence of redaction.\n642\t\tif strings.Contains(res.stdout, `\"issued\"`) {\n643\t\t\tt.Errorf(\"the built-in access_token body path was not redacted:\\n%s\", res.stdout)\n644\t\t}\n645\t\n646\t\t// And the configured countermeasure closes the rest of the gap.\n647\t\twriteConfig(t, h, \"redact:\\n  body-paths:\\n    - data.session\\n\")\n648\t\n649\t\tres = h.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", \"json\")\n650\t\tif strings.Contains(res.stdout, value) {\n651\t\t\tt.Errorf(\"redact.body-paths did not redact the configured path:\\n%s\", res.stdout)\n652\t\t}\n653\t}\n654\t\n655\t// TestNoCommandExposesAVerboseOrDebugFlag is §5a's \"no --verbose that bypasses\n656\t// [redaction]\" in its strongest form: there is no such flag to bypass it.\n657\t// Whoever adds one inherits this test, and with it the obligation to route it\n658\t// through the redacted representation.\n659\tfunc TestNoCommandExposesAVerboseOrDebugFlag(t *testing.T) {\n660\t\tt.Parallel()\n661\t\n662\t\th := newHarness(t, nil)\n663\t\tcommands := listCommands(t, h)\n664\t\n665\t\t// A parse that found nothing would pass silently, so the shape of the help\n666\t\t// output is asserted before anything is concluded from it.\n667\t\tfor _, want := range []string{\"call\", \"list\", \"describe\", \"search\", \"uses\", \"auth\", \"history\", \"version\"} {\n668\t\t\tif !contains(commands, want) {\n669\t\t\t\tt.Fatalf(\"parsed the command list as %v, which is missing %q\", commands, want)\n670\t\t\t}\n671\t\t}\n672\t\n673\t\tfor _, name := range commands {\n674\t\t\tfor _, flag := range []string{\"--verbose\", \"--debug\"} {\n675\t\t\t\tres := h.run(name, flag)\n676\t\t\t\tif res.code != 2 {\n677\t\t\t\t\tt.Errorf(\"`talaria %s %s` = %d, want 2 (unknown flag); stdout: %s stderr: %s\",\n678\t\t\t\t\t\tname, flag, res.code, res.stdout, res.stderr)\n679\t\t\t\t}\n680\t\t\t}\n681\t\n682\t\t\t// A hidden flag would not fail above but also would not be advertised,\n683\t\t\t// so the help text is checked too.\n684\t\t\thelp := h.run(name, \"--help\")\n685\t\t\tfor _, flag := range []string{\"--verbose\", \"--debug\"} {\n686\t\t\t\tif strings.Contains(help.stdout, flag) {\n687\t\t\t\t\tt.Errorf(\"`talaria %s --help` advertises %s:\\n%s\", name, flag, help.stdout)\n688\t\t\t\t}\n689\t\t\t}\n690\t\t}\n691\t}\n692\t\n693\t// TestASpecFetchedOverHTTPLeavesNoCredentialInTheCache covers the spec cache as\n694\t// a surface with something actually in it — a cache that was never written is\n695\t// not evidence of anything.\n696\tfunc TestASpecFetchedOverHTTPLeavesNoCredentialInTheCache(t *testing.T) {\n697\t\tt.Parallel()\n698\t\n699\t\tspec, err := os.ReadFile(specPath)\n700\t\tif err != nil {\n701\t\t\tt.Fatalf(\"reading the fixture: %v\", err)\n702\t\t}\n703\t\n704\t\tvalue := canary.Value(\"cache\")\n705\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n706\t\n707\t\tsrv := newServer(t, `{\"ok\":true}`)\n708\t\tspecSrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {\n709\t\t\t_, _ = w.Write(spec)\n710\t\t}))\n711\t\tt.Cleanup(specSrv.Close)\n712\t\n713\t\tres := h.runOK(\"call\", specSrv.URL+\"/openapi.yaml\", \"getBearer\",\n714\t\t\t\"--base-url\", srv.URL, \"--output\", \"json\")\n715\t\n716\t\tcached, err := canary.Tree(\"cache\", h.cache)\n717\t\tif err != nil {\n718\t\t\tt.Fatalf(\"enumerating the cache: %v\", err)\n719\t\t}\n720\t\tif len(cached) == 0 {\n721\t\t\tt.Fatal(\"the spec cache is empty; the fetch did not exercise the surface this test is about\")\n722\t\t}\n723\t\n724\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n725\t}\n726\t\n727\t// assertNoLeak fails the test naming every surface the canary reached.\n728\tfunc assertNoLeak(t *testing.T, value string, surfaces []canary.Surface) {\n729\t\tt.Helper()\n730\t\n731\t\tleaks := canary.Scan(value, surfaces...)\n732\t\tif len(leaks) == 0 {\n733\t\t\treturn\n734\t\t}\n735\t\n736\t\tvar names []string\n737\t\tfor _, leak := range leaks {\n738\t\t\tnames = append(names, leak.String())\n739\t\t}\n740\t\tt.Errorf(\"the canary reached %d surface(s):\\n  %s\", len(leaks), strings.Join(names, \"\\n  \"))\n741\t}\n742\t\n743\t// listCommands reads the command names out of the root help, so a command\n744\t// added later is checked without anyone remembering to list it here.\n745\tfunc listCommands(t *testing.T, h *harness) []string {\n746\t\tt.Helper()\n747\t\n748\t\thelp := h.runOK(\"--help\")\n749\t\n750\t\tvar names []string\n751\t\tvar inList bool\n752\t\tfor _, line := range strings.Split(help.stdout, \"\\n\") {\n753\t\t\tswitch {\n754\t\t\tcase strings.HasPrefix(line, \"Available Commands:\"):\n755\t\t\t\tinList = true\n756\t\t\tcase inList && strings.TrimSpace(line) == \"\":\n757\t\t\t\tinList = false\n758\t\t\tcase inList:\n759\t\t\t\tif fields := strings.Fields(line); len(fields) > 0 {\n760\t\t\t\t\tnames = append(names, fields[0])\n761\t\t\t\t}\n762\t\t\t}\n763\t\t}\n764\t\n765\t\treturn names\n766\t}\n767\t\n768\tfunc contains(haystack []string, needle string) bool {\n769\t\tfor _, s := range haystack {\n770\t\t\tif s == needle {\n771\t\t\t\treturn true\n772\t\t\t}\n773\t\t}\n774\t\n775\t\treturn false\n776\t}\n777\t\n778\t// writeConfig puts a config file in the harness's isolated config home.\n779\tfunc writeConfig(t *testing.T, h *harness, yaml string) {\n780\t\tt.Helper()\n781\t\n782\t\tdir := filepath.Join(h.conf, \"talaria\")\n783\t\tif err := os.MkdirAll(dir, 0o700); err != nil {\n784\t\t\tt.Fatalf(\"creating the config directory: %v\", err)\n785\t\t}\n786\t\tif err := os.WriteFile(filepath.Join(dir, \"config.yaml\"), []byte(yaml), 0o600); err != nil {\n787\t\t\tt.Fatalf(\"writing the config file: %v\", err)\n788\t\t}\n789\t}\n790\t"
      }
    ]
  },
