    "content": [
      {
        "tool_use_id": "toolu_01DNWfDuRMiBsioBEckpJ1eo",
        "type": "tool_result",
        "content": "1\t// Package config holds the two things that come from outside the spec: the\n2\t// profile file and the environment. Between them they answer \"which base URL,\n3\t// which extra headers, and which credential names does this call use\" — and\n4\t// they answer it in *names*, never values, so the credential firewall in\n5\t// internal/secret extends all the way out to the user's configuration.\n6\tpackage config\n7\t\n8\timport (\n9\t\t\"bytes\"\n10\t\t\"errors\"\n11\t\t\"io\"\n12\t\t\"io/fs\"\n13\t\t\"os\"\n14\t\t\"path/filepath\"\n15\t\t\"sort\"\n16\t\n17\t\t\"gopkg.in/yaml.v3\"\n18\t\n19\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n20\t)\n21\t\n22\t// FileMode is the mode a profile file must not exceed. The file names\n23\t// credentials and describes internal hosts, and DESIGN.md §5 requires 0600, so\n24\t// anything group- or world-readable is refused rather than warned about.\n25\tconst FileMode os.FileMode = 0o600\n26\t\n27\t// Config is the parsed profile file. The zero value is a usable empty config,\n28\t// which is what a missing file loads as.\n29\ttype Config struct {\n30\t\tProfiles map[string]*Profile `yaml:\"profiles\"`\n31\t\t// Redact extends the credential firewall's built-in lists. It is file-wide\n32\t\t// rather than per-profile: which fields of an API's responses are secret is\n33\t\t// a property of the API, not of which environment you point at.\n34\t\tRedact Redact `yaml:\"redact\"`\n35\t\n36\t\t// path is where this config was read from, so an error about a profile can\n37\t\t// name the file to edit.\n38\t\tpath string\n39\t}\n40\t\n41\t// Redact is the user's extension of the built-in redaction lists (§5a). Both\n42\t// lists only ever add: nothing here can stop talaria redacting an Authorization\n43\t// header, because a firewall a config file can switch off is not one.\n44\ttype Redact struct {\n45\t\t// Headers are extra header-name globs, e.g. x-session-*. They apply to\n46\t\t// request and response headers alike.\n47\t\tHeaders []string `yaml:\"headers\"`\n48\t\t// BodyPaths are dotted JSON paths into a *response* body, e.g. data.token.\n49\t\t// They are how a login endpoint's `access_token` stays out of an agent's\n50\t\t// context; §5a is explicit that talaria cannot infer them.\n51\t\tBodyPaths []string `yaml:\"body-paths\"`\n52\t}\n53\t\n54\t// Profile is one named environment: where to send requests, what to send with\n55\t// them, and which credentials to use.\n56\ttype Profile struct {\n57\t\t// Name is the key this profile appeared under. It is filled in on lookup\n58\t\t// rather than read from the file.\n59\t\tName string `yaml:\"-\"`\n60\t\t// BaseURL overrides the spec's servers[0].url. It loses to --base-url.\n61\t\tBaseURL string `yaml:\"base-url\"`\n62\t\t// Headers are sent with every request made under this profile.\n63\t\tHeaders map[string]string `yaml:\"headers\"`\n64\t\t// Auth maps a security scheme name from the spec to an environment-variable\n65\t\t// reference such as ${STAGING_TOKEN}. It holds references, never values:\n66\t\t// see Resolve.\n67\t\tAuth map[string]string `yaml:\"auth\"`\n68\t\t// History is this profile's half of the recording opt-out. It is per-profile\n69\t\t// rather than file-wide because \"record what I do here\" is a property of the\n70\t\t// environment: a production profile is exactly the one you might not want a\n71\t\t// permanent artifact of.\n72\t\tHistory *History `yaml:\"history\"`\n73\t}\n74\t\n75\t// History is the profile's recording setting. It is a pointer on Profile, and\n76\t// its Enabled is a pointer here, so that \"not mentioned\" is distinguishable\n77\t// from \"set to false\" — the default is on, and only an explicit `false` turns\n78\t// it off. TALARIA_HISTORY=off overrides this either way (internal/corpus).\n79\ttype History struct {\n80\t\tEnabled *bool `yaml:\"enabled\"`\n81\t}\n82\t\n83\t// HistoryEnabled reports whether calls under this profile should be recorded.\n84\t//\n85\t// The nil receiver is the common case — no --profile was given — and it records,\n86\t// because history is on by default. This lives here rather than in\n87\t// internal/corpus so that package keeps its independence from the config file.\n88\tfunc (p *Profile) HistoryEnabled() bool {\n89\t\tif p == nil || p.History == nil || p.History.Enabled == nil {\n90\t\t\treturn true\n91\t\t}\n92\t\n93\t\treturn *p.History.Enabled\n94\t}\n95\t\n96\t// DefaultPath is where the profile file lives: $XDG_CONFIG_HOME/talaria/config.yaml,\n97\t// falling back to the platform user config dir (~/.config on Linux).\n98\tfunc DefaultPath() (string, error) {\n99\t\tdir := os.Getenv(\"XDG_CONFIG_HOME\")\n100\t\tif dir == \"\" {\n101\t\t\tvar err error\n102\t\t\tif dir, err = os.UserConfigDir(); err != nil {\n103\t\t\t\treturn \"\", clierr.Usage(\"cannot locate the talaria config directory: %w\", err)\n104\t\t\t}\n105\t\t}\n106\t\n107\t\treturn filepath.Join(dir, \"talaria\", \"config.yaml\"), nil\n108\t}\n109\t\n110\t// Load reads the profile file at path, or the default location when path is\n111\t// empty. A file that is not there is not an error — most invocations have no\n112\t// profile file at all — but one that exists and is unreadable, unparseable or\n113\t// too permissive is.\n114\tfunc Load(path string) (*Config, error) {\n115\t\tif path == \"\" {\n116\t\t\tvar err error\n117\t\t\tif path, err = DefaultPath(); err != nil {\n118\t\t\t\treturn nil, err\n119\t\t\t}\n120\t\t}\n121\t\n122\t\tdata, err := readPrivate(path)\n123\t\tif err != nil {\n124\t\t\treturn nil, err\n125\t\t}\n126\t\tif data == nil {\n127\t\t\treturn &Config{path: path}, nil\n128\t\t}\n129\t\n130\t\t// KnownFields makes a mistyped key an error instead of silence. A profile\n131\t\t// whose `baseurl:` was quietly ignored sends the request somewhere else,\n132\t\t// which is exactly the class of surprise this tool exists to remove.\n133\t\tdec := yaml.NewDecoder(bytes.NewReader(data))\n134\t\tdec.KnownFields(true)\n135\t\n136\t\tcfg := &Config{path: path}\n137\t\tif err := dec.Decode(cfg); err != nil && !errors.Is(err, io.EOF) {\n138\t\t\treturn nil, clierr.Usage(\"parsing %s: %w\", path, err)\n139\t\t}\n140\t\n141\t\treturn cfg, nil\n142\t}\n143\t\n144\t// readPrivate reads path after checking that nobody but its owner can read it.\n145\t// It returns nil data and no error when the file does not exist.\n146\tfunc readPrivate(path string) ([]byte, error) {\n147\t\tinfo, err := os.Stat(path)\n148\t\tswitch {\n149\t\tcase errors.Is(err, fs.ErrNotExist):\n150\t\t\treturn nil, nil\n151\t\tcase err != nil:\n152\t\t\treturn nil, clierr.Usage(\"reading %s: %w\", path, err)\n153\t\t}\n154\t\n155\t\t// Only the extra bits matter: 0400 is stricter than required and fine,\n156\t\t// while any group or other bit exposes the credential names to the machine.\n157\t\tif extra := info.Mode().Perm() &^ FileMode; extra != 0 {\n158\t\t\treturn nil, clierr.Usage(\n159\t\t\t\t\"%s has mode %#o; it names credentials, so it must be %#o or stricter: chmod 0600 %s\",\n160\t\t\t\tpath, info.Mode().Perm(), FileMode, path)\n161\t\t}\n162\t\n163\t\tdata, err := os.ReadFile(path)\n164\t\tif err != nil {\n165\t\t\treturn nil, clierr.Usage(\"reading %s: %w\", path, err)\n166\t\t}\n167\t\n168\t\treturn data, nil\n169\t}\n170\t\n171\t// Profile looks up a named profile. An empty name selects none and returns\n172\t// nil, which is the common case: no --profile was given.\n173\t//\n174\t// An unknown name is a bad invocation (exit 2) carrying the names that do\n175\t// exist, so an agent that guessed can correct itself in one step.\n176\tfunc (c *Config) Profile(name string) (*Profile, error) {\n177\t\tif name == \"\" {\n178\t\t\treturn nil, nil\n179\t\t}\n180\t\n181\t\tif prof, ok := c.Profiles[name]; ok && prof != nil {\n182\t\t\tprof.Name = name\n183\t\t\treturn prof, nil\n184\t\t}\n185\t\n186\t\tif len(c.Profiles) == 0 {\n187\t\t\treturn nil, clierr.Usage(\"no profile %q: %s defines none\", name, c.path)\n188\t\t}\n189\t\n190\t\treturn nil, clierr.Usage(\"no profile %q in %s\", name, c.path).\n191\t\t\tWithAlternatives(c.ProfileNames()...)\n192\t}\n193\t\n194\t// ProfileNames lists the defined profiles in sorted order, for error messages\n195\t// and for `talaria` surfaces that offer the user a choice.\n196\tfunc (c *Config) ProfileNames() []string {\n197\t\tnames := make([]string, 0, len(c.Profiles))\n198\t\tfor name := range c.Profiles {\n199\t\t\tnames = append(names, name)\n200\t\t}\n201\t\tsort.Strings(names)\n202\t\n203\t\treturn names\n204\t}\n205\t"
      }
    ]
