          "command": "mkdir -p /tmp/pgrace && cat > /tmp/pgrace/main.go <<'EOF'\npackage main\n\n// Replicates internal/curl/exec.go + procgroup_unix.go exactly, and detects\n// whether cmd.Cancel (the raw syscall.Kill(-pid, SIGKILL)) is ever invoked\n// AFTER os/exec has already reaped the child -- at which point the pid is free\n// for the kernel to hand to an unrelated process.\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"fmt\"\n\t\"os\"\n\t\"os/exec\"\n\t\"sync/atomic\"\n\t\"syscall\"\n\t\"time\"\n)\n\nfunc reaped(pid int) bool {\n\t// A live or zombie child has /proc/<pid>. A reaped one does not.\n\t_, err := os.Stat(fmt.Sprintf(\"/proc/%d\", pid))\n\treturn os.IsNotExist(err)\n}\n\nfunc main() {\n\tvar lateKills, cancels int64\n\tconst iters = 3000\n\n\tfor i := 0; i < iters; i++ {\n\t\tctx, cancel := context.WithCancel(context.Background())\n\n\t\t// A child that exits almost immediately, as a curl to a fast local\n\t\t// server does.\n\t\tcmd := exec.CommandContext(ctx, \"/bin/true\")\n\t\tcmd.WaitDelay = 2 * time.Second\n\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n\t\tcmd.Stdin = bytes.NewReader([]byte(\"x\"))\n\t\tvar out, errb bytes.Buffer\n\t\tcmd.Stdout, cmd.Stderr = &out, &errb\n\n\t\tcmd.Cancel = func() error {\n\t\t\tatomic.AddInt64(&cancels, 1)\n\t\t\tpid := cmd.Process.Pid\n\t\t\tif reaped(pid) {\n\t\t\t\t// This is the bug: talaria is about to issue\n\t\t\t\t// syscall.Kill(-pid, SIGKILL) against a pid it no longer owns.\n\t\t\t\tatomic.AddInt64(&lateKills, 1)\n\t\t\t}\n\t\t\tif err := syscall.Kill(-pid, syscall.SIGKILL); err != nil {\n\t\t\t\treturn cmd.Process.Kill()\n\t\t\t}\n\t\t\treturn nil\n\t\t}\n\n\t\t_ = cmd.Start()\n\t\t// Cancel at roughly the moment the child exits, which is what a Ctrl-C\n\t\t// or a --timeout landing on a finishing request looks like.\n\t\tgo func() {\n\t\t\ttime.Sleep(time.Duration(i%400) * time.Microsecond)\n\t\t\tcancel()\n\t\t}()\n\t\t_ = cmd.Wait()\n\t\tcancel()\n\t}\n\n\tfmt.Printf(\"iterations=%d cancel-fired=%d cancel-fired-AFTER-reap=%d\\n\", iters, cancels, lateKills)\n}\nEOF\ncd /tmp/pgrace && go mod init pgrace >/dev/null 2>&1; go run /tmp/pgrace/main.go",
