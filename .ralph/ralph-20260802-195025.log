        "tool_use_id": "toolu_01Ss9jEwwpSxSEU4WRnb1XsB",
        "type": "tool_result",
        "content": "1\tpackage spec\n2\t\n3\timport (\n4\t\t\"io\"\n5\t\t\"log/slog\"\n6\t\t\"os\"\n7\t\n8\t\t\"github.com/pb33f/libopenapi\"\n9\t\t\"github.com/pb33f/libopenapi/datamodel\"\n10\t\n11\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n12\t)\n13\t\n14\t// sourceBytes is the Source recorded for a spec that never had a path or URL.\n15\tconst sourceBytes = \"<bytes>\"\n16\t\n17\t// documentConfig is the configuration every parse runs under.\n18\t//\n19\t// Without one, libopenapi builds a default whose logger is a JSON slog handler\n20\t// writing to the real os.Stdout — past cmd.OutOrStdout, past the talaria/v1\n21\t// envelope and past every redaction path. A spec with an unresolvable $ref\n22\t// would put stray log documents where the envelope goes and nothing else, so\n23\t// the logger is discarded here; stdout belongs to the envelope.\n24\t//\n25\t// AllowFileReferences and AllowRemoteReferences stay at their false defaults on\n26\t// purpose: that default is what stops a hostile spec's $ref reading local files\n27\t// or fetching URLs, and naming the configuration explicitly is precisely where\n28\t// it could be lost.\n29\tfunc documentConfig() *datamodel.DocumentConfiguration {\n30\t\tcfg := datamodel.NewDocumentConfiguration()\n31\t\tcfg.Logger = slog.New(slog.NewJSONHandler(io.Discard, nil))\n32\t\n33\t\treturn cfg\n34\t}\n35\t\n36\t// LoadBytes parses raw spec bytes, in either JSON or YAML, and builds the\n37\t// OpenAPI 3.x model. Every failure comes back as a clierr.SpecLoad (exit 3),\n38\t// including the ones libopenapi reports as a panic-free error slice, so no\n39\t// caller has to classify a parse failure itself.\n40\tfunc LoadBytes(data []byte) (*Document, error) {\n41\t\treturn loadBytes(data, sourceBytes)\n42\t}\n43\t\n44\t// LoadFile reads a spec from disk and loads it. A missing or unreadable path is\n45\t// a spec-load failure too, not a usage error: the distinction that matters to an\n46\t// agent is \"the spec did not come up\", and the message names the path either\n47\t// way.\n48\tfunc LoadFile(path string) (*Document, error) {\n49\t\tdata, err := os.ReadFile(path)\n50\t\tif err != nil {\n51\t\t\treturn nil, clierr.SpecLoad(\"reading spec %s: %w\", path, err)\n52\t\t}\n53\t\n54\t\treturn loadBytes(data, path)\n55\t}\n56\t\n57\t// loadBytes is the single parse path both entry points share, so the error\n58\t// wrapping and the Source bookkeeping stay in one place.\n59\tfunc loadBytes(data []byte, source string) (*Document, error) {\n60\t\t// Swagger 2.0 is converted here, before anything else sees the bytes, so\n61\t\t// \"any API doc\" stops being a special case one command at a time.\n62\t\tvar convertedFrom string\n63\t\tif isSwagger2(data) {\n64\t\t\tconverted, err := convertSwagger2(data, source)\n65\t\t\tif err != nil {\n66\t\t\t\treturn nil, err\n67\t\t\t}\n68\t\t\tdata, convertedFrom = converted, versionSwagger2\n69\t\t}\n70\t\n71\t\tdoc, err := libopenapi.NewDocumentWithConfiguration(data, documentConfig())\n72\t\tif err != nil {\n73\t\t\treturn nil, clierr.SpecLoad(\"parsing spec %s: %w\", source, err)\n74\t\t}\n75\t\n76\t\t// The second return is a single error, not a slice; on a spec with several\n77\t\t// build problems it is a join of all of them.\n78\t\tmodel, err := doc.BuildV3Model()\n79\t\tif err != nil {\n80\t\t\treturn nil, clierr.SpecLoad(\"building model for spec %s: %w\", source, err)\n81\t\t}\n82\t\n83\t\treturn &Document{\n84\t\t\tVersion:       model.Model.Version,\n85\t\t\tSource:        source,\n86\t\t\tModel:         &model.Model,\n87\t\t\tConvertedFrom: convertedFrom,\n88\t\t}, nil\n89\t}\n90\t"
      }
    ]
