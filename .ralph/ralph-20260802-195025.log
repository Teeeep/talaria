\n107\t\t\t\t}\n108\t\n109\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(historyPayload(entries, filter))\n110\t\t\t},\n111\t\t}\n112\t\n113\t\tcmd.Flags().StringVar(&operationID, \"operation\", \"\",\n114\t\t\t\"only entries for this operationId\")\n115\t\tcmd.Flags().StringVar(&since, \"since\", \"\",\n116\t\t\t\"only entries newer than a duration ago, e.g. 1h or 30m\")\n117\t\tcmd.Flags().StringVar(&status, \"status\", \"\",\n118\t\t\t\"only entries with this response status: an exact code (404) or a class (4xx)\")\n119\t\tcmd.Flags().StringVar(&source, \"source\", \"\",\n120\t\t\t\"only entries from this command: \"+strings.Join(historySources(), \"|\"))\n121\t\n122\t\tcmd.AddCommand(newHistoryShowCmd())\n123\t\tcmd.AddCommand(newHistoryReplayCmd())\n124\t\n125\t\treturn cmd\n126\t}\n127\t\n128\tfunc newHistoryShowCmd() *cobra.Command {\n129\t\treturn &cobra.Command{\n130\t\t\tUse:   \"show <n>\",\n131\t\t\tShort: \"Print one recorded request and response in full\",\n132\t\t\tLong: \"Print the whole of one entry: the request as it was sent and the response\\n\" +\n133\t\t\t\t\"as it came back, both redacted. The index is the one `history` prints.\",\n134\t\t\tArgs: usageArgs(cobra.ExactArgs(1)),\n135\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n136\t\t\t\tformat, err := resolveFormat(cmd)\n137\t\t\t\tif err != nil {\n138\t\t\t\t\treturn err\n139\t\t\t\t}\n140\t\n141\t\t\t\tentries, err := loadHistory(cmd)\n142\t\t\t\tif err != nil {\n143\t\t\t\t\treturn err\n144\t\t\t\t}\n145\t\n146\t\t\t\tindex, entry, err := selectEntry(entries, args[0])\n147\t\t\t\tif err != nil {\n148\t\t\t\t\treturn err\n149\t\t\t\t}\n150\t\n151\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(historyShowPayload(index, entry))\n152\t\t\t},\n153\t\t}\n154\t}\n155\t\n156\tfunc newHistoryReplayCmd() *cobra.Command {\n157\t\tvar allowMutations bool\n158\t\n159\t\tcmd := &cobra.Command{\n160\t\t\tUse:   \"replay <n>\",\n161\t\t\tShort: \"Re-issue a recorded call\",\n162\t\t\tLong: \"Send a recorded request again, to the URL it went to, and record the\\n\" +\n163\t\t\t\t\"result as a new entry. Credentials are resolved from the environment as\\n\" +\n164\t\t\t\t\"they were the first time — history holds their names, never their values,\\n\" +\n165\t\t\t\t\"so there is nothing there to read back.\",\n166\t\t\tArgs: usageArgs(cobra.ExactArgs(1)),\n167\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n168\t\t\t\tformat, err := resolveFormat(cmd)\n169\t\t\t\tif err != nil {\n170\t\t\t\t\treturn err\n171\t\t\t\t}\n172\t\n173\t\t\t\tcfg, err := config.Load(\"\")\n174\t\t\t\tif err != nil {\n175\t\t\t\t\treturn err\n176\t\t\t\t}\n177\t\n178\t\t\t\tstore, err := openHistory(cmd, cfg)\n179\t\t\t\tif err != nil {\n180\t\t\t\t\treturn err\n181\t\t\t\t}\n182\t\n183\t\t\t\tentries, err := store.Read()\n184\t\t\t\tif err != nil {\n185\t\t\t\t\treturn err\n186\t\t\t\t}\n187\t\n188\t\t\t\t_, entry, err := selectEntry(entries, args[0])\n189\t\t\t\tif err != nil {\n190\t\t\t\t\treturn err\n191\t\t\t\t}\n192\t\n193\t\t\t\t// The same gate `call` applies, for the same reason: the method is what\n194\t\t\t\t// makes a request dangerous, and a recorded POST is still a POST.\n195\t\t\t\tif (operation.Operation{Method: entry.Method}).IsMutation() && !allowMutations {\n196\t\t\t\t\treturn clierr.Usage(\n197\t\t\t\t\t\t\"entry %s is a %s request and may change server state: pass --allow-mutations to replay it\",\n198\t\t\t\t\t\targs[0], entry.Method)\n199\t\t\t\t}\n200\t\n201\t\t\t\treq, err := replayRequest(cmd.ErrOrStderr(), entry)\n202\t\t\t\tif err != nil {\n203\t\t\t\t\treturn err\n204\t\t\t\t}\n205\t\n206\t\t\t\trenderer := output.New(format, cmd.OutOrStdout())\n207\t\t\t\tredactors := newRedactors(cfg)\n208\t\n209\t\t\t\tresp, execErr := curl.Execute(req)\n210\t\t\t\trecordCall(cmd.ErrOrStderr(), store, corpus.SourceReplay, req, resp, redactors)\n211\t\t\t\tif execErr != nil {\n212\t\t\t\t\treturn execErr\n213\t\t\t\t}\n214\t\n215\t\t\t\t// No validation block: replay reads a recorded request and needs no\n216\t\t\t\t// spec to send one, so there is no contract here to check against.\n217\t\t\t\treturn renderer.Render(callPayload(req, redactResponse(resp, redactors.Response), nil))\n218\t\t\t},\n219\t\t}\n220\t\n221\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n222\t\t\t\"permit replaying a method other than GET, HEAD or OPTIONS\")\n223\t\n224\t\treturn cmd\n225\t}\n226\t\n227\t// openHistory builds the store with the recording setting the selected profile\n228\t// asks for. Reading never consults it — history written before recording was\n229\t// switched off is still history — but replay writes, so it has to be right.\n230\tfunc openHistory(cmd *cobra.Command, cfg *config.Config) (*corpus.Store, error) {\n231\t\tprof, err := selectProfile(cmd, cfg)\n232\t\tif err != nil {\n233\t\t\treturn nil, err\n234\t\t}\n235\t\n236\t\t// The empty dir is the default state directory; internal/corpus locates it.\n237\t\treturn corpus.New(\"\", prof.HistoryEnabled()), nil\n238\t}\n239\t\n240\t// loadHistory loads the store for a read-only command. The profile still\n241\t// decides the Enabled flag so the store is constructed the one way, but nothing\n242\t// on this path writes.\n243\tfunc loadHistory(cmd *cobra.Command) ([]corpus.Entry, error) {\n244\t\tcfg, err := config.Load(\"\")\n245\t\tif err != nil {\n246\t\t\treturn nil, err\n247\t\t}\n248\t\n249\t\tstore, err := openHistory(cmd, cfg)\n250\t\tif err != nil {\n251\t\t\treturn nil, err\n252\t\t}\n253\t\n254\t\treturn store.Read()\n255\t}\n256\t\n257\t// historyPayload renders the store newest first, keeping the entries the filter\n258\t// admits and the index each had before filtering.\n259\tfunc historyPayload(entries []corpus.Entry, filter historyFilter) output.Payload {\n260\t\tview := historyListView{Entries: []historyEntryView{}}\n261\t\trows := [][]string{}\n262\t\n263\t\t// The store is oldest first, so walking it backwards is both the display\n264\t\t// order and the index order.\n265\t\tfor i := len(entries) - 1; i >= 0; i-- {\n266\t\t\tentry := entries[i]\n267\t\t\tif !filter.admits(entry) {\n268\t\t\t\tcontinue\n269\t\t\t}\n270\t\n271\t\t\tline := newHistoryEntryView(len(entries)-i, entry)\n272\t\t\tview.Entries = append(view.Entries, line)\n273\t\t\trows = append(rows, []string{\n274\t\t\t\tstrconv.Itoa(line.Index),\n275\t\t\t\tline.Timestamp.Format(time.RFC3339),\n276\t\t\t\tstring(line.Source),\n277\t\t\t\tline.Method,\n278\t\t\t\tline.Path,\n279\t\t\t\tstatusCell(line.Status),\n280\t\t\t\tline.OperationID,\n281\t\t\t})\n282\t\t}\n283\t\n284\t\treturn output.Payload{\n285\t\t\tData: view,\n286\t\t\tTable: output.Table{\n287\t\t\t\tHeaders: []string{\"#\", \"WHEN\", \"SOURCE\", \"METHOD\", \"PATH\", \"STATUS\", \"OPERATION\"},\n288\t\t\t\tRows:    rows,\n289\t\t\t},\n290\t\t}\n291\t}\n292\t\n293\tfunc newHistoryEntryView(index int, entry corpus.Entry) historyEntryView {\n294\t\tview := historyEntryView{\n295\t\t\tIndex:       index,\n296\t\t\tTimestamp:   entry.Timestamp,\n297\t\t\tSource:      string(entry.Source),\n298\t\t\tOperationID: entry.OperationID,\n299\t\t\tMethod:      entry.Method,\n300\t\t\tPath:        urlPath(entry.URL),\n301\t\t\tURL:         entry.URL,\n302\t\t}\n303\t\tif entry.Response != nil {\n304\t\t\tview.Status = entry.Response.Status\n305\t\t\tview.TimingMS = entry.Response.TimingMS\n306\t\t}\n307\t\n308\t\treturn view\n309\t}\n310\t\n311\tfunc historyShowPayload(index int, entry corpus.Entry) output.Payload {\n312\t\trows := [][]string{\n313\t\t\t{entry.Method + \" \" + entry.URL},\n314\t\t}\n315\t\tfor _, name := range sortedKeys(entry.Request.Headers) {\n316\t\t\trows = append(rows, []string{name + \": \" + entry.Request.Headers[name]})\n317\t\t}\n318\t\tif entry.Request.Body != nil {\n319\t\t\trows = append(rows, []string{entry.Request.Body.Data})\n320\t\t}\n321\t\tif entry.Response != nil {\n322\t\t\trows = append(rows, []string{fmt.Sprintf(\"%d in %dms\", entry.Response.Status, entry.Response.TimingMS)})\n323\t\t\tif entry.Response.Body != nil {\n324\t\t\t\trows = append(rows, []string{entry.Response.Body.Data})\n325\t\t\t}\n326\t\t}\n327\t\n328\t\treturn output.Payload{\n329\t\t\tData:  historyShowView{Index: index, Entry: entry},\n330\t\t\tTable: output.Table{Rows: rows},\n331\t\t}\n332\t}\n333\t\n334\t// statusCell renders the status column, which is empty for an entry that\n335\t// observed no response rather than a 0 nobody's server returned.\n336\tfunc statusCell(status int) string {\n337\t\tif status == 0 {\n338\t\t\treturn \"-\"\n339\t\t}\n340\t\n341\t\treturn strconv.Itoa(status)\n342\t}\n343\t\n344\t// urlPath is the path component of a recorded URL, for the list's path column.\n345\t// A URL that will not parse — nothing writes one, but the store is a file on\n346\t// disk — degrades to itself rather than to nothing.\n347\tfunc urlPath(raw string) string {\n348\t\tparsed, err := url.Parse(raw)\n349\t\tif err != nil {\n350\t\t\treturn raw\n351\t\t}\n352\t\n353\t\treturn parsed.EscapedPath()\n354\t}\n355\t\n356\t// selectEntry resolves a 1-based, newest-first index against the store.\n357\t//\n358\t// Both failures are usage errors carrying what the caller can do instead: the\n359\t// valid range, or the fact that there is no history yet. An agent that guessed\n360\t// an index corrects itself from the message without a second command.\n361\tfunc selectEntry(entries []corpus.Entry, arg string) (int, corpus.Entry, error) {\n362\t\tindex, err := strconv.Atoi(arg)\n363\t\tif err != nil {\n364\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\"history index %q is not a number\", arg)\n365\t\t}\n366\t\n367\t\tif len(entries) == 0 {\n368\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\"no history entry %d: the history is empty\", index)\n369\t\t}\n370\t\tif index < 1 || index > len(entries) {\n371\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\n372\t\t\t\t\"no history entry %d: the valid range is 1-%d\", index, len(entries))\n373\t\t}\n374\t\n375\t\treturn index, entries[len(entries)-index], nil\n376\t}\n377\t\n378\t// admits reports whether an entry survives every filter that was asked for.\n379\tfunc (f historyFilter) admits(entry corpus.Entry) bool {\n380\t\tif f.operation != \"\" && entry.OperationID != f.operation {\n381\t\t\treturn false\n382\t\t}\n383\t\tif f.source != \"\" && entry.Source != f.source {\n384\t\t\treturn false\n385\t\t}\n386\t\tif f.since != nil && entry.Timestamp.Before(*f.since) {\n387\t\t\treturn false\n388\t\t}\n389\t\tif f.status != nil {\n390\t\t\t// An entry with no response has no status to match, so a status filter\n391\t\t\t// excludes it rather than matching it as a zero.\n392\t\t\tif entry.Response == nil || !f.status.matches(entry.Response.Status) {\n393\t\t\t\treturn false\n394\t\t\t}\n395\t\t}\n396\t\n397\t\treturn true\n398\t}\n399\t\n400\t// parseHistoryFilter turns the flags into a filter, failing with exit 2 on\n401\t// anything it cannot read. Parsing happens before the store is opened so a\n402\t// typo is reported without touching the disk.\n403\tfunc parseHistoryFilter(operationID, source, since, status string) (historyFilter, error) {\n404\t\tfilter := historyFilter{operation: operationID}\n405\t\n406\t\tif source != \"\" {\n407\t\t\tparsed, err := parseSource(source)\n408\t\t\tif err != nil {\n409\t\t\t\treturn historyFilter{}, err\n410\t\t\t}\n411\t\t\tfilter.source = parsed\n412\t\t}\n413\t\n414\t\tif since != \"\" {\n415\t\t\tage, err := time.ParseDuration(since)\n416\t\t\tif err != nil || age < 0 {\n417\t\t\t\treturn historyFilter{}, clierr.Usage(\n418\t\t\t\t\t\"cannot read --since %q: give a duration such as 30m, 1h or 7d as 168h\", since)\n419\t\t\t}\n420\t\t\tcutoff := time.Now().Add(-age)\n421\t\t\tfilter.since = &cutoff\n422\t\t}\n423\t\n424\t\tif status != \"\" {\n425\t\t\tparsed, err := parseStatusFilter(status)\n426\t\t\tif err != nil {\n427\t\t\t\treturn historyFilter{}, err\n428\t\t\t}\n429\t\t\tfilter.status = parsed\n430\t\t}\n431\t\n432\t\treturn filter, nil\n433\t}\n434\t\n435\t// parseSource reads --source, offering the valid values on a miss.\n436\tfunc parseSource(value string) (corpus.Source, error) {\n437\t\tfor _, source := range historySources() {\n438\t\t\tif strings.EqualFold(value, source) {\n439\t\t\t\treturn corpus.Source(source), nil\n440\t\t\t}\n441\t\t}\n442\t\n443\t\treturn \"\", clierr.Usage(\"no history source %q\", value).WithAlternatives(historySources()...)\n444\t}\n445\t\n446\t// historySources is the set of commands that write to the store, in the order\n447\t// they are worth reading about.\n448\tfunc historySources() []string {\n449\t\treturn []string{string(corpus.SourceCall), string(corpus.SourceRun), string(corpus.SourceReplay)}\n450\t}\n451\t\n452\t// parseStatusFilter reads --status: an exact code, or a class with x in place\n453\t// of the digits that vary.\n454\tfunc parseStatusFilter(value string) (*statusFilter, error) {\n455\t\tconst bad = \"cannot read --status %q: give an exact code such as 404 or a class such as 4xx\"\n456\t\n457\t\ttrimmed := strings.ToLower(strings.TrimSpace(value))\n458\t\tif len(trimmed) != 3 {\n459\t\t\treturn nil, clierr.Usage(bad, value)\n460\t\t}\n461\t\n462\t\tif strings.HasSuffix(trimmed, \"xx\") {\n463\t\t\tclass, err := strconv.Atoi(trimmed[:1])\n464\t\t\tif err != nil || class < 1 || class > 9 {\n465\t\t\t\treturn nil, clierr.Usage(bad, value)\n466\t\t\t}\n467\t\n468\t\t\treturn &statusFilter{low: class * 100, high: class*100 + 99}, nil\n469\t\t}\n470\t\n471\t\tcode, err := strconv.Atoi(trimmed)\n472\t\tif err != nil {\n473\t\t\treturn nil, clierr.Usage(bad, value)\n474\t\t}\n475\t\n476\t\treturn &statusFilter{low: code, high: code}, nil\n477\t}\n478\t\n479\t// replayRequest rebuilds a runnable request from a stored entry.\n480\t//\n481\t// Every credential position in the entry holds `<redacted:env:NAME>`, which\n482\t// becomes a reference again here — the value is resolved from the environment\n483\t// at exec time, exactly as it was on the original call. Nothing in this function\n484\t// reads a credential, because there is none in the store to read (§5a).\n485\tfunc replayRequest(stderr io.Writer, entry corpus.Entry) (*request.Request, error) {\n486\t\tparsed, err := url.Parse(entry.URL)\n487\t\tif err != nil {\n488\t\t\treturn nil, clierr.Usage(\"the recorded URL %q cannot be parsed: %v\", entry.URL, err)\n489\t\t}\n490\t\n491\t\treq := &request.Request{\n492\t\t\tOperationID: entry.OperationID,\n493\t\t\tMethod:      entry.Method,\n494\t\t\tBaseURL:     parsed.Scheme + \"://\" + parsed.Host,\n495\t\t\tPath:        parsed.EscapedPath(),\n496\t\t}\n497\t\n498\t\treq.Query, err = replayQuery(stderr, parsed.RawQuery)\n499\t\tif err != nil {\n500\t\t\treturn nil, err\n501\t\t}\n502\t\treq.Headers = replayPairs(stderr, \"header\", entry.Request.Headers)\n503\t\treq.Cookies = replayPairs(stderr, \"cookie\", entry.Request.Cookies)\n504\t\n505\t\tif body := entry.Request.Body; body != nil {\n506\t\t\tif body.Truncated {\n507\t\t\t\treturn nil, clierr.Usage(\n508\t\t\t\t\t\"the recorded request body was truncated at %d bytes, so replaying it would send something the original did not\",\n509\t\t\t\t\tcorpus.MaxBody)\n510\t\t\t}\n511\t\t\treq.Body = &request.Body{ContentType: body.ContentType, Data: []byte(body.Data)}\n512\t\t}\n513\t\n514\t\treturn req, nil\n515\t}\n516\t\n517\t// replayQuery rebuilds the query parameters in the order they were recorded.\n518\t// The raw string is walked rather than url.ParseQuery'd because a map would lose\n519\t// that order, and a replay that reorders the query string is not the same\n520\t// request.\n521\tfunc replayQuery(stderr io.Writer, raw string) ([]request.Pair, error) {\n522\t\tvar pairs []request.Pair\n523\t\n524\t\tfor _, field := range strings.Split(raw, \"&\") {\n525\t\t\tif field == \"\" {\n526\t\t\t\tcontinue\n527\t\t\t}\n528\t\n529\t\t\trawName, rawValue, _ := strings.Cut(field, \"=\")\n530\t\t\tname, err := url.QueryUnescape(rawName)\n531\t\t\tif err != nil {\n532\t\t\t\treturn nil, clierr.Usage(\"the recorded query parameter %q cannot be parsed: %v\", rawName, err)\n533\t\t\t}\n534\t\t\tvalue, err := url.QueryUnescape(rawValue)\n535\t\t\tif err != nil {\n536\t\t\t\treturn nil, clierr.Usage(\"the recorded value of query parameter %q cannot be parsed: %v\", name, err)\n537\t\t\t}\n538\t\n539\t\t\treplayed, ok := replayValue(value)\n540\t\t\tif !ok {\n541\t\t\t\twarnUnreplayable(stderr, \"query parameter\", name)\n542\t\t\t\tcontinue\n543\t\t\t}\n544\t\t\tpairs = append(pairs, request.Pair{Name: name, Value: replayed})\n545\t\t}\n546\t\n547\t\treturn pairs, nil\n548\t}\n549\t\n550\t// replayPairs rebuilds headers or cookies. The stored form is a map, so the\n551\t// order is gone and is restored as sorted-by-name: emitted curl and the config\n552\t// document both have to be deterministic, and byte-for-byte header order is not\n553\t// something an HTTP request depends on.\n554\tfunc replayPairs(stderr io.Writer, kind string, stored map[string]string) []request.Pair {\n555\t\tvar pairs []request.Pair\n556\t\n557\t\tfor _, name := range sortedKeys(stored) {\n558\t\t\tvalue, ok := replayValue(stored[name])\n559\t\t\tif !ok {\n560\t\t\t\twarnUnreplayable(stderr, kind, name)\n561\t\t\t\tcontinue\n562\t\t\t}\n563\t\t\tpairs = append(pairs, request.Pair{Name: name, Value: value})\n564\t\t}\n565\t\n566\t\treturn pairs\n567\t}\n568\t\n569\t// replayValue turns one stored value back into a request Value, reporting\n570\t// false for one that cannot be reproduced.\n571\t//\n572\t// A `<redacted:env:NAME>` — with or without a scheme prefix — becomes a\n573\t// reference to the same variable. A bare `<redacted>` is a value the name-based\n574\t// matcher caught: a literal the user typed, which was deliberately not written\n575\t// down and so cannot come back. That is the firewall working, not a bug, and\n576\t// the caller says so on stderr rather than silently sending a request missing a\n577\t// header the original had.\n578\tfunc replayValue(stored string) (request.Value, bool) {\n579\t\tif stored == secret.Placeholder {\n580\t\t\treturn request.Value{}, false\n581\t\t}\n582\t\n583\t\t// Longest prefix first, so the raw encoding's empty prefix is the fallback\n584\t\t// rather than the first match.\n585\t\tfor _, enc := range []request.Encoding{request.EncodeBearer, request.EncodeBasic, request.EncodeRaw} {\n586\t\t\tprefix := encodingPrefix(enc)\n587\t\t\tif prefix != \"\" && !strings.HasPrefix(stored, prefix) {\n588\t\t\t\tcontinue\n589\t\t\t}\n590\t\n591\t\t\tif ref, ok := secret.ParseRef(strings.TrimPrefix(stored, prefix)); ok {\n592\t\t\t\treturn request.Secret(ref, enc), true\n593\t\t\t}\n594\t\t}\n595\t\n596\t\treturn request.Literal(stored), true\n597\t}\n598\t\n599\t// encodingPrefix is the text a scheme puts in front of a credential — \"Bearer \"\n600\t// and the rest. It is asked of internal/request rather than repeated here, so\n601\t// the two cannot drift apart.\n602\tfunc encodingPrefix(enc request.Encoding) string {\n603\t\treturn request.Secret(secret.SecretRef{}, enc).Prefix()\n604\t}\n605\t\n606\t// warnUnreplayable reports a field the replay had to drop. It is a warning\n607\t// rather than a failure: the request is still worth making, and a 401 with an\n608\t// explanation on stderr is more useful than a refusal.\n609\tfunc warnUnreplayable(stderr io.Writer, kind, name string) {\n610\t\tfmt.Fprintf(stderr,\n611\t\t\t\"warning: the recorded %s %q held a redacted literal, which history does not store; replaying without it\\n\",\n612\t\t\tkind, name)\n613\t}\n614\t\n615\t// sortedKeys is the deterministic iteration order for the maps a stored entry\n616\t// holds.\n617\tfunc sortedKeys(m map[string]string) []string {\n618\t\tnames := make([]string, 0, len(m))\n619\t\tfor name := range m {\n620\t\t\tnames = append(names, name)\n621\t\t}\n622\t\tsort.Strings(names)\n623\t\n624\t\treturn names\n625\t}\n626\t"
      }
