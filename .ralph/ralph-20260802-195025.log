        "tool_use_id": "toolu_01GUUvP6c4b3u9SDYzeGiL2A",
        "type": "tool_result",
        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"os\"\n5\t\t\"strings\"\n6\t\t\"unicode/utf8\"\n7\t\n8\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n9\t\t\"github.com/Teeeep/talaria/internal/request\"\n10\t)\n11\t\n12\t// maxInlineBody is the size above which a body stops being a directive and\n13\t// becomes a 0600 temp file. DESIGN.md §5a calls the temp file \"the exception\":\n14\t// it is a real file on disk for the length of one exec, so the threshold is set\n15\t// where the config document stops being a reasonable place to put bytes rather\n16\t// than at any hard limit of curl's.\n17\tconst maxInlineBody = 1 << 20\n18\t\n19\t// Capture names the files curl writes the response to. Both are optional; the\n20\t// executor allocates them and passes them here rather than appending them to\n21\t// argv, because §5a's rule is that *nothing* about the call is an argument, not\n22\t// merely nothing sensitive.\n23\ttype Capture struct {\n24\t\t// BodyPath receives the response body, via the output directive.\n25\t\tBodyPath string\n26\t\t// HeaderPath receives the response headers, via the dump-header directive.\n27\t\tHeaderPath string\n28\t}\n29\t\n30\t// BuildConfig renders req as a curl config document for `curl -K -`.\n31\t//\n32\t// This is the one place in talaria where a resolved credential exists. The\n33\t// document is written to curl's stdin and holds the real values; the returned\n34\t// argv is exactly `curl -K -` and holds nothing, because /proc/*/cmdline is\n35\t// readable by any process on the host — including ones an agent spawns (§5a).\n36\t//\n37\t// cleanup must be called once curl has exited. It removes any temp body file\n38\t// and zeroes the document, so the resolved values do not linger in a buffer the\n39\t// rest of the process can still reach. It is safe to call more than once, and\n40\t// is non-nil even when BuildConfig fails.\n41\t//\n42\t// A credential whose environment variable is unset fails with exit code 5 and\n43\t// no document, rather than sending an empty header — an unauthenticated request\n44\t// that looks authenticated is the worse outcome (§4).\n45\tfunc BuildConfig(req *request.Request, capture Capture) (config []byte, argv []string, cleanup func(), err error) {\n46\t\targv = []string{\"curl\", \"-K\", \"-\"}\n47\t\tif req == nil {\n48\t\t\treturn nil, argv, func() {}, clierr.RequestFailed(\"no request to execute\")\n49\t\t}\n50\t\n51\t\tvar doc document\n52\t\tif err := doc.build(req, capture); err != nil {\n53\t\t\tdoc.discard()\n54\t\t\treturn nil, argv, doc.cleanup, err\n55\t\t}\n56\t\n57\t\tconfig = []byte(doc.b.String())\n58\t\tdoc.b.Reset()\n59\t\n60\t\treturn config, argv, doc.cleanupWith(config), nil\n61\t}\n62\t\n63\t// document accumulates the directives and the temp files they point at, so a\n64\t// failure part-way through still knows what to remove.\n65\ttype document struct {\n66\t\tb     strings.Builder\n67\t\tfiles []string\n68\t}\n69\t\n70\tfunc (d *document) build(req *request.Request, capture Capture) error {\n71\t\turl, err := req.URL(resolve)\n72\t\tif err != nil {\n73\t\t\treturn err\n74\t\t}\n75\t\td.directive(\"url\", url)\n76\t\n77\t\tif req.Method != \"\" {\n78\t\t\td.directive(\"request\", req.Method)\n79\t\t}\n80\t\n81\t\tif err := d.auth(req); err != nil {\n82\t\t\treturn err\n83\t\t}\n84\t\tif err := d.cookies(req); err != nil {\n85\t\t\treturn err\n86\t\t}\n87\t\tif err := d.body(req); err != nil {\n88\t\t\treturn err\n89\t\t}\n90\t\n91\t\t// silent suppresses the progress meter, which would otherwise be interleaved\n92\t\t// with the write-out payload on stdout; show-error keeps real failures\n93\t\t// visible despite it.\n94\t\td.flag(\"silent\")\n95\t\td.flag(\"show-error\")\n96\t\t// %{json} is the whole response metadata in one parseable object, and is the\n97\t\t// reason DESIGN.md sets a curl >= 7.70 floor.\n98\t\td.directive(\"write-out\", \"%{json}\")\n99\t\n100\t\tif capture.BodyPath != \"\" {\n101\t\t\td.directive(\"output\", capture.BodyPath)\n102\t\t}\n103\t\tif capture.HeaderPath != \"\" {\n104\t\t\td.directive(\"dump-header\", capture.HeaderPath)\n105\t\t}\n106\t\n107\t\treturn nil\n108\t}\n109\t\n110\t// auth writes the request headers, diverting basic auth to curl's own user\n111\t// directive: the header text is base64(user:password), and letting curl encode\n112\t// it means this package never has to.\n113\tfunc (d *document) auth(req *request.Request) error {\n114\t\tfor _, h := range req.Headers {\n115\t\t\tvalue, err := resolve(h.Value)\n116\t\t\tif err != nil {\n117\t\t\t\treturn err\n118\t\t\t}\n119\t\n120\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n121\t\t\t\td.directive(\"user\", strings.TrimPrefix(value, h.Value.Prefix()))\n122\t\t\t\tcontinue\n123\t\t\t}\n124\t\n125\t\t\td.directive(\"header\", h.Name+\": \"+value)\n126\t\t}\n127\t\n128\t\treturn nil\n129\t}\n130\t\n131\t// cookies writes every cookie as one directive. curl keeps only the last of\n132\t// several, so they are joined rather than repeated.\n133\tfunc (d *document) cookies(req *request.Request) error {\n134\t\tif len(req.Cookies) == 0 {\n135\t\t\treturn nil\n136\t\t}\n137\t\n138\t\tvar b strings.Builder\n139\t\tfor i, c := range req.Cookies {\n140\t\t\tvalue, err := resolve(c.Value)\n141\t\t\tif err != nil {\n142\t\t\t\treturn err\n143\t\t\t}\n144\t\n145\t\t\tif i > 0 {\n146\t\t\t\tb.WriteString(\"; \")\n147\t\t\t}\n148\t\t\tb.WriteString(c.Name + \"=\" + value)\n149\t\t}\n150\t\n151\t\td.directive(\"cookie\", b.String())\n152\t\n153\t\treturn nil\n154\t}\n155\t\n156\t// body writes the request body, inline when it can be and via a temp file when\n157\t// it cannot.\n158\tfunc (d *document) body(req *request.Request) error {\n159\t\tif req.Body == nil {\n160\t\t\treturn nil\n161\t\t}\n162\t\n163\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n164\t\t\td.directive(\"header\", \"Content-Type: \"+req.Body.ContentType)\n165\t\t}\n166\t\n167\t\tif inlinable(req.Body.Data) {\n168\t\t\t// data-raw rather than data or data-binary: those two read a value\n169\t\t\t// starting with @ as a filename, and a JSON body legitimately can. Verified\n170\t\t\t// against curl 8.14.1 — data-raw sends the bytes as given and strips\n171\t\t\t// nothing, where `data = \"@path\"` also strips newlines.\n172\t\t\td.directive(\"data-raw\", string(req.Body.Data))\n173\t\t\treturn nil\n174\t\t}\n175\t\n176\t\tpath, err := d.tempFile(req.Body.Data)\n177\t\tif err != nil {\n178\t\t\treturn err\n179\t\t}\n180\t\t// The file's bytes are read verbatim, so data-binary rather than data: data\n181\t\t// strips newlines and carriage returns out of a file, which corrupts any\n182\t\t// pretty-printed JSON and breaks any signed payload.\n183\t\td.directive(\"data-binary\", \"@\"+path)\n184\t\n185\t\treturn nil\n186\t}\n187\t\n188\t// inlinable reports whether a body can live in the config document. Valid UTF-8\n189\t// under the size limit can; anything else takes the temp-file path, because a\n190\t// NUL byte truncates a quoted value and arbitrary bytes have no escape sequence\n191\t// that survives curl's parser.\n192\tfunc inlinable(data []byte) bool {\n193\t\tif len(data) > maxInlineBody || !utf8.Valid(data) {\n194\t\t\treturn false\n195\t\t}\n196\t\n197\t\treturn !strings.ContainsRune(string(data), 0)\n198\t}\n199\t\n200\t// tempFile writes data to a 0600 file and records it for cleanup.\n201\tfunc (d *document) tempFile(data []byte) (string, error) {\n202\t\tf, err := os.CreateTemp(\"\", \"talaria-body-*\")\n203\t\tif err != nil {\n204\t\t\treturn \"\", clierr.RequestFailed(\"cannot stage the request body: %w\", err)\n205\t\t}\n206\t\td.files = append(d.files, f.Name())\n207\t\n208\t\t// CreateTemp already makes the file 0600; setting it explicitly keeps that a\n209\t\t// guarantee of this code rather than of the standard library's current\n210\t\t// behaviour, since the body may carry credentials the user put in it.\n211\t\tif err := f.Chmod(0o600); err != nil {\n212\t\t\tf.Close()\n213\t\t\treturn \"\", clierr.RequestFailed(\"cannot secure the request body file: %w\", err)\n214\t\t}\n215\t\n216\t\tif _, err := f.Write(data); err != nil {\n217\t\t\tf.Close()\n218\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n219\t\t}\n220\t\n221\t\tif err := f.Close(); err != nil {\n222\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n223\t\t}\n224\t\n225\t\treturn f.Name(), nil\n226\t}\n227\t\n228\t// directive writes one `name = \"value\"` line, escaped for curl's parser.\n229\tfunc (d *document) directive(name, value string) {\n230\t\td.b.WriteString(name + ` = \"` + escapeDirective(value) + \"\\\"\\n\")\n231\t}\n232\t\n233\t// flag writes one bare directive, the config form of a boolean option.\n234\tfunc (d *document) flag(name string) { d.b.WriteString(name + \"\\n\") }\n235\t\n236\t// discard drops a partially built document, so a failure returns nothing a\n237\t// caller could accidentally send or print.\n238\tfunc (d *document) discard() { d.b.Reset() }\n239\t\n240\t// cleanup removes the temp files this document points at.\n241\tfunc (d *document) cleanup() {\n242\t\tfor _, path := range d.files {\n243\t\t\tos.Remove(path) //nolint:errcheck // Best effort; the file is 0600 and in TMPDIR.\n244\t\t}\n245\t\td.files = nil\n246\t}\n247\t\n248\t// cleanupWith also zeroes the finished document, so the resolved credentials in\n249\t// it stop being readable from the buffer once curl has exited.\n250\tfunc (d *document) cleanupWith(config []byte) func() {\n251\t\treturn func() {\n252\t\t\td.cleanup()\n253\t\t\tfor i := range config {\n254\t\t\t\tconfig[i] = 0\n255\t\t\t}\n256\t\t}\n257\t}\n258\t\n259\t// resolve is the renderer that reads real credential values. It is the single\n260\t// crossing of the firewall described in DESIGN.md §5a: every other renderer in\n261\t// talaria produces a redacted or symbolic form, and this one exists only to\n262\t// feed the config document.\n263\tfunc resolve(v request.Value) (string, error) {\n264\t\tif !v.IsSecret() {\n265\t\t\t// Reveal rather than String: a literal the user typed under a\n266\t\t\t// credential-shaped name displays redacted everywhere else, and the\n267\t\t\t// wire is the one place it must not.\n268\t\t\treturn v.Reveal(), nil\n269\t\t}\n270\t\n271\t\tvalue, err := v.Ref().Resolve()\n272\t\tif err != nil {\n273\t\t\treturn \"\", err\n274\t\t}\n275\t\n276\t\treturn v.Prefix() + value, nil\n277\t}\n278\t\n279\t// configEscape covers the escape sequences curl's config parser understands, in\n280\t// the order a single pass must apply them. strings.Replacer scans once and\n281\t// picks the longest match at each position, which is what keeps the backslash\n282\t// rule from re-escaping the backslashes the other rules just introduced — the\n283\t// double-escaping bug that ordered sequential replaces invite.\n284\tvar configEscape = strings.NewReplacer(\n285\t\t`\\`, `\\\\`,\n286\t\t`\"`, `\\\"`,\n287\t\t\"\\t\", `\\t`,\n288\t\t\"\\n\", `\\n`,\n289\t\t\"\\r\", `\\r`,\n290\t)\n291\t\n292\tfunc escapeDirective(s string) string { return configEscape.Replace(s) }\n293\t"
      }
