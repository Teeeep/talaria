        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"strings\"\n8\t\t\"testing\"\n9\t\n10\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n11\t)\n12\t\n13\tfunc TestExitCodeTranslatesErrors(t *testing.T) {\n14\t\ttests := []struct {\n15\t\t\tname string\n16\t\t\terr  error\n17\t\t\twant int\n18\t\t}{\n19\t\t\t{\"nil\", nil, 0},\n20\t\t\t{\"usage\", clierr.Usage(\"unknown operation\"), 2},\n21\t\t\t{\"spec load\", clierr.SpecLoad(\"parse error\"), 3},\n22\t\t\t{\"wrapped spec load\", fmt.Errorf(\"context: %w\", clierr.SpecLoad(\"parse error\")), 3},\n23\t\t\t{\"unrecognised\", errors.New(\"something else went wrong\"), 1},\n24\t\t}\n25\t\n26\t\tfor _, tt := range tests {\n27\t\t\tt.Run(tt.name, func(t *testing.T) {\n28\t\t\t\tvar stderr strings.Builder\n29\t\n30\t\t\t\tif got := exitCode(tt.err, &stderr); got != tt.want {\n31\t\t\t\t\tt.Errorf(\"exitCode = %d, want %d\", got, tt.want)\n32\t\t\t\t}\n33\t\n34\t\t\t\tif tt.err == nil && stderr.Len() != 0 {\n35\t\t\t\t\tt.Errorf(\"a nil error wrote %q to stderr, want nothing\", stderr.String())\n36\t\t\t\t}\n37\t\t\t\tif tt.err != nil && stderr.Len() == 0 {\n38\t\t\t\t\tt.Error(\"a non-nil error wrote nothing to stderr, want structured JSON\")\n39\t\t\t\t}\n40\t\t\t})\n41\t\t}\n42\t}\n43\t\n44\tfunc TestRunReturnsZeroOnSuccess(t *testing.T) {\n45\t\tvar stdout, stderr strings.Builder\n46\t\n47\t\tif got := run([]string{\"version\"}, &stdout, &stderr); got != 0 {\n48\t\t\tt.Errorf(\"run(version) = %d, want 0; stderr: %s\", got, stderr.String())\n49\t\t}\n50\t\tif !strings.Contains(stdout.String(), \"talaria\") {\n51\t\t\tt.Errorf(\"run(version) stdout = %q, want the version line\", stdout.String())\n52\t\t}\n53\t}\n54\t\n55\tfunc TestRunRejectsAnUnknownOutputFormat(t *testing.T) {\n56\t\t// The other half of the internal/output parse-error assertion: the bare error\n57\t\t// that ParseFormat returns has to arrive here as a usage error, exit code 2,\n58\t\t//