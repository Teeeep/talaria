        "tool_use_id": "toolu_01DbZSDNuhYEuDoZNgkjvrEk",
        "type": "tool_result",
        "content": "1\t// Package gen turns a schema into request data for `run` mode.\n2\t//\n3\t// Two rules shape everything here. The first is examples-first (DESIGN.md §5a):\n4\t// a value the spec author wrote is realistic in a way a generated one never is,\n5\t// so an `example` is used verbatim and nothing else is consulted. The second is\n6\t// determinism: every draw comes from a seeded source held on the Generator, so\n7\t// the same seed and the same spec produce byte-identical data. A smoke test\n8\t// whose body changes between runs fails once, passes next time and teaches\n9\t// nobody anything.\n10\t//\n11\t// The package deliberately depends only on the schema model. It is shared with\n12\t// the twin server (DESIGN.md §5), so it must not reach into internal/curl or\n13\t// internal/twin — the boundary is asserted by a test.\n14\tpackage gen\n15\t\n16\timport (\n17\t\t\"encoding/base64\"\n18\t\t\"fmt\"\n19\t\t\"math/rand/v2\"\n20\t\t\"strings\"\n21\t\t\"time\"\n22\t\n23\t\t\"github.com/pb33f/libopenapi/datamodel/high/base\"\n24\t\tyaml \"go.yaml.in/yaml/v4\"\n25\t)\n26\t\n27\t// DefaultMaxDepth is how many levels of nesting the generator will produce\n28\t// before it stops descending. Deep enough for the bodies real APIs accept,\n29\t// shallow enough that a schema with a long tail of nested objects cannot turn a\n30\t// smoke test into a megabyte of noise.\n31\tconst DefaultMaxDepth = 4\n32\t\n33\t// maxRefRepeats is how many times one $ref may appear on a single branch: the\n34\t// value itself, plus one level of self-nesting. Unlike a renderer, a generator\n35\t// producing `parent: {}` for a recursive field emits data the server will\n36\t// reject, so one real level is worth having — and two is already more than a\n37\t// smoke test learns anything from.\n38\tconst maxRefRepeats = 2\n39\t\n40\t// epoch is the instant every generated timestamp is offset from. A fixed epoch\n41\t// rather than time.Now() is what makes date-time data reproducible: two runs at\n42\t// the same seed have to produce the same bytes, and a clock reading would break\n43\t// that on its own.\n44\tvar epoch = time.Date(2024, time.January, 1, 0, 0, 0, 0, time.UTC)\n45\t\n46\t// words is the vocabulary generated strings are built from. A short fixed list\n47\t// keeps values recognisable as test data at a glance, which matters when they\n48\t// turn up in someone's staging database.\n49\tvar words = []string{\"alpha\", \"bravo\", \"charlie\", \"delta\", \"echo\", \"foxtrot\"}\n50\t\n51\t// Generator produces data from schemas. Create one per run: the seeded source\n52\t// lives on it, so two Generators made with the same seed are interchangeable\n53\t// and neither touches the global rand.\n54\ttype Generator struct {\n55\t\trng *rand.Rand\n56\t\t// MaxDepth bounds how far generation nests. Zero means DefaultMaxDepth.\n57\t\tMaxDepth int\n58\t\t// Fixtures are the user's own test data, consulted by DataFor after spec\n59\t\t// examples and before generation. Nil is an empty set.\n60\t\tFixtures *Fixtures\n61\t}\n62\t\n63\t// New returns a Generator drawing from seed. The same seed always produces the\n64\t// same data for the same schema.\n65\tfunc New(seed int64) *Generator {\n66\t\t// PCG needs two words of state; deriving the second from the first keeps\n67\t\t// the caller's single seed the whole story.\n68\t\treturn &Generator{\n69\t\t\trng:      rand.New(rand.NewPCG(uint64(seed), uint64(seed)+0x9e3779b9)),\n70\t\t\tMaxDepth: DefaultMaxDepth,\n71\t\t}\n72\t}\n73\t\n74\t// Value generates one value for a schema, shaped for encoding/json: strings,\n75\t// float64/int64, bool, []any and map[string]any. A nil schema, or one the\n76\t// generator declined to descend into, yields nil.\n77\tfunc (g *Generator) Value(sp *base.SchemaProxy) any {\n78\t\tv, _ := g.value(sp, 0, make(map[string]int))\n79\t\n80\t\treturn v\n81\t}\n82\t\n83\t// value generates a value, reporting whether it produced one at all. The bool\n84\t// is how the cycle guard and the depth limit express \"there is nothing sensible\n85\t// to put here\": the caller then omits the property or the array element rather\n86\t// than writing a null, which would be a claim about the data rather than an\n87\t// absence of it.\n88\t//\n89\t// onPath counts the $refs on the current branch, not every ref ever seen — the\n90\t// same schema may legitimately appear in two sibling properties, and only a\n91\t// reference back into one's own ancestry is a cycle.\n92\tfunc (g *Generator) value(sp *base.SchemaProxy, depth int, onPath map[string]int) (any, bool) {\n93\t\tif sp == nil {\n94\t\t\treturn nil, false\n95\t\t}\n96\t\n97\t\t// The cycle key is the $ref, matching internal/output's walker: recursion\n98\t\t// in a real spec always goes through a reference.\n99\t\tif key := refKey(sp); key != \"\" {\n100\t\t\tif onPath[key] >= maxRefRepeats {\n101\t\t\t\treturn nil, false\n102\t\t\t}\n103\t\t\tonPath[key]++\n104\t\t\tdefer func() { onPath[key]-- }()\n105\t\t}\n106\t\n107\t\ts := sp.Schema()\n108\t\tif s == nil {\n109\t\t\treturn nil, false\n110\t\t}\n111\t\n112\t\t// Examples win outright (DESIGN.md §5a), before type, format or enum.\n113\t\tif v, ok := exampleValue(s); ok {\n114\t\t\treturn v, true\n115\t\t}\n116\t\tif len(s.Enum) > 0 {\n117\t\t\treturn decodeNode(s.Enum[g.rng.IntN(len(s.Enum))])\n118\t\t}\n119\t\n120\t\t// oneOf and anyOf are a choice; take the first branch so the same spec\n121\t\t// keeps producing the same shape as the schema grows siblings. allOf is not\n122\t\t// a choice — every branch applies at once — and is merged into the object\n123\t\t// case instead.\n124\t\tif branch := firstBranch(s); branch != nil {\n125\t\t\treturn g.value(branch, depth, onPath)\n126\t\t}\n127\t\n128\t\tswitch schemaType(s) {\n129\t\tcase \"object\":\n130\t\t\treturn g.object(s, depth, onPath)\n131\t\tcase \"array\":\n132\t\t\treturn g.array(s, depth, onPath)\n133\t\tcase \"boolean\":\n134\t\t\treturn g.rng.IntN(2) == 0, true\n135\t\tcase \"integer\":\n136\t\t\treturn g.integer(s), true\n137\t\tcase \"number\":\n138\t\t\treturn g.number(s), true\n139\t\tcase \"null\":\n140\t\t\treturn nil, true\n141\t\tdefault:\n142\t\t\treturn g.text(s), true\n143\t\t}\n144\t}\n145\t\n146\t// object generates a value for an object schema. Required properties are always\n147\t// present — omitting one produces a request the server rejects before it ever\n148\t// reaches the behaviour under test — while optional ones are included on a coin\n149\t// flip, so a run exercises more than the minimal body.\n150\tfunc (g *Generator) object(s *base.Schema, depth int, onPath map[string]int) (any, bool) {\n151\t\tif depth >= g.maxDepth() {\n152\t\t\treturn nil, false\n153\t\t}\n154\t\n155\t\trequired := requiredSet(s)\n156\t\tout := make(map[string]any)\n157\t\tfor _, p := range propertyPairs(s) {\n158\t\t\tif !required[p.name] && g.rng.IntN(2) == 0 {\n159\t\t\t\tcontinue\n160\t\t\t}\n161\t\t\tif v, ok := g.value(p.schema, depth+1, onPath); ok {\n162\t\t\t\tout[p.name] = v\n163\t\t\t}\n164\t\t}\n165\t\n166\t\treturn out, true\n167\t}\n168\t\n169\t// array generates a value for an array schema. Length comes from the schema's\n170\t// own bounds rather than the seeded source: one element proves the shape, and a\n171\t// length that varies with the seed makes two runs harder to diff for no gain.\n172\tfunc (g *Generator) array(s *base.Schema, depth int, onPath map[string]int) (any, bool) {\n173\t\tif depth >= g.maxDepth() {\n174\t\t\treturn nil, false\n175\t\t}\n176\t\n177\t\tcount := 1\n178\t\tif s.MinItems != nil && int(*s.MinItems) > count {\n179\t\t\tcount = int(*s.MinItems)\n180\t\t}\n181\t\tif s.MaxItems != nil && int(*s.MaxItems) < count {\n182\t\t\tcount = int(*s.MaxItems)\n183\t\t}\n184\t\n185\t\t// An element the generator declined to produce takes the whole array with\n186\t\t// it: an empty array where the schema says minItems is data the server\n187\t\t// rejects, and a shorter array is not what was asked for either.\n188\t\titems := arrayItems(s)\n189\t\tout := make([]any, 0, count)\n190\t\tfor range count {\n191\t\t\tv, ok := g.value(items, depth+1, onPath)\n192\t\t\tif !ok {\n193\t\t\t\treturn nil, false\n194\t\t\t}\n195\t\t\tout = append(out, v)\n196\t\t}\n197\t\n198\t\treturn out, true\n199\t}\n200\t\n201\t// text generates a string, honouring the format hint and any length bounds.\n202\t// Formats matter more than they look: a plain word in a `uri` or `date-time`\n203\t// field fails validation at the server, and a smoke test that only ever proves\n204\t// \"the API rejects nonsense\" is not a smoke test.\n205\tfunc (g *Generator) text(s *base.Schema) string {\n206\t\tvar out string\n207\t\n208\t\tswitch s.Format {\n209\t\tcase \"date-time\":\n210\t\t\tout = g.timestamp().Format(time.RFC3339)\n211\t\tcase \"date\":\n212\t\t\tout = g.timestamp().Format(time.DateOnly)\n213\t\tcase \"time\":\n214\t\t\tout = g.timestamp().Format(\"15:04:05Z07:00\")\n215\t\tcase \"uuid\":\n216\t\t\tout = g.uuid()\n217\t\tcase \"email\":\n218\t\t\tout = g.word() + \"@example.com\"\n219\t\tcase \"hostname\":\n220\t\t\tout = g.word() + \".example.com\"\n221\t\tcase \"ipv4\":\n222\t\t\tout = fmt.Sprintf(\"192.0.2.%d\", g.rng.IntN(254)+1)\n223\t\tcase \"uri\", \"url\", \"uri-reference\":\n224\t\t\tout = \"https://example.com/\" + g.word()\n225\t\tcase \"byte\":\n226\t\t\tout = base64.StdEncoding.EncodeToString([]byte(g.word()))\n227\t\tcase \"password\":\n228\t\t\tout = g.word() + \"-\" + g.word()\n229\t\tdefault:\n230\t\t\tout = g.word()\n231\t\t}\n232\t\n233\t\treturn clampLength(out, s)\n234\t}\n235\t\n236\t// integer generates an integer inside the schema's bounds, as int64 so it\n237\t// marshals without a decimal point.\n238\tfunc (g *Generator) integer(s *base.Schema) int64 {\n239\t\tlow, high := int64(1), int64(1000)\n240\t\tif s.Minimum != nil {\n241\t\t\tlow = int64(*s.Minimum)\n242\t\t}\n243\t\tif s.Maximum != nil {\n244\t\t\thigh = int64(*s.Maximum)\n245\t\t}\n246\t\tif high <= low {\n247\t\t\treturn low\n248\t\t}\n249\t\n250\t\treturn low + g.rng.Int64N(high-low+1)\n251\t}\n252\t\n253\t// number generates a fractional value inside the schema's bounds. The fraction\n254\t// is deliberate: a whole float is indistinguishable from an integer once it is\n255\t// JSON, and a `number` field is worth exercising as one.\n256\tfunc (g *Generator) number(s *base.Schema) float64 {\n257\t\tif s.Minimum != nil || s.Maximum != nil {\n258\t\t\tlow, high := 0.0, 1000.0\n259\t\t\tif s.Minimum != nil {\n260\t\t\t\tlow = *s.Minimum\n261\t\t\t}\n262\t\t\tif s.Maximum != nil {\n263\t\t\t\thigh = *s.Maximum\n264\t\t\t}\n265\t\t\tif high <= low {\n266\t\t\t\treturn low\n267\t\t\t}\n268\t\n269\t\t\treturn low + g.rng.Float64()*(high-low)\n270\t\t}\n271\t\n272\t\treturn float64(g.rng.IntN(1000)) + float64(g.rng.IntN(99)+1)/100\n273\t}\n274\t\n275\t// timestamp returns an instant offset from the fixed epoch, so timestamps vary\n276\t// with the seed but not with the wall clock.\n277\tfunc (g *Generator) timestamp() time.Time {\n278\t\treturn epoch.Add(time.Duration(g.rng.IntN(365*24)) * time.Hour).UTC()\n279\t}\n280\t\n281\t// uuid builds a version 4 UUID from the seeded source rather than crypto/rand,\n282\t// which is the whole point: these are test identifiers, and they have to repeat.\n283\tfunc (g *Generator) uuid() string {\n284\t\tvar b [16]byte\n285\t\tfor i := range b {\n286\t\t\tb[i] = byte(g.rng.IntN(256))\n287\t\t}\n288\t\tb[6] = (b[6] & 0x0f) | 0x40 // version 4\n289\t\tb[8] = (b[8] & 0x3f) | 0x80 // RFC 4122 variant\n290\t\n291\t\treturn fmt.Sprintf(\"%x-%x-%x-%x-%x\", b[0:4], b[4:6], b[6:8], b[8:10], b[10:16])\n292\t}\n293\t\n294\tfunc (g *Generator) word() string {\n295\t\treturn fmt.Sprintf(\"%s-%d\", words[g.rng.IntN(len(words))], g.rng.IntN(1000))\n296\t}\n297\t\n298\tfunc (g *Generator) maxDepth() int {\n299\t\tif g.MaxDepth <= 0 {\n300\t\t\treturn DefaultMaxDepth\n301\t\t}\n302\t\n303\t\treturn g.MaxDepth\n304\t}\n305\t\n306\t// clampLength brings a generated string inside the schema's length bounds.\n307\t// Padding repeats a filler character rather than generating more words: the\n308\t// point is to satisfy minLength, not to look pretty.\n309\tfunc clampLength(s string, schema *base.Schema) string {\n310\t\tif schema.MaxLength != nil && int64(len(s)) > *schema.MaxLength {\n311\t\t\ts = s[:*schema.MaxLength]\n312\t\t}\n313\t\tif schema.MinLength != nil && int64(len(s)) < *schema.MinLength {\n314\t\t\ts += strings.Repeat(\"x\", int(*schema.MinLength)-len(s))\n315\t\t}\n316\t\n317\t\treturn s\n318\t}\n319\t\n320\t// exampleValue returns the schema's example, preferring the 3.0 singular\n321\t// `example` over the 3.1 `examples` list. A caller that wrote both meant both\n322\t// to be the same thing.\n323\tfunc exampleValue(s *base.Schema) (any, bool) {\n324\t\tif s.Example != nil {\n325\t\t\treturn decodeNode(s.Example)\n326\t\t}\n327\t\tfor _, node := range s.Examples {\n328\t\t\tif node != nil {\n329\t\t\t\treturn decodeNode(node)\n330\t\t\t}\n331\t\t}\n332\t\n333\t\treturn nil, false\n334\t}\n335\t\n336\t// decodeNode turns a yaml node from the spec into the plain Go value the rest\n337\t// of the pipeline marshals.\n338\tfunc decodeNode(node *yaml.Node) (any, bool) {\n339\t\tif node == nil {\n340\t\t\treturn nil, false\n341\t\t}\n342\t\n343\t\tvar out any\n344\t\tif err := node.Decode(&out); err != nil {\n345\t\t\treturn nil, false\n346\t\t}\n347\t\n348\t\treturn out, true\n349\t}\n350\t\n351\t// schemaType names the type to generate. A schema with no declared type is\n352\t// common in the wild, so the shape it does declare decides: properties mean an\n353\t// object, items mean an array, and anything else falls through to a string,\n354\t// which is the type most likely to be accepted.\n355\tfunc schemaType(s *base.Schema) string {\n356\t\tfor _, t := range s.Type {\n357\t\t\tif t != \"null\" {\n358\t\t\t\treturn t\n359\t\t\t}\n360\t\t}\n361\t\n362\t\tif (s.Properties != nil && s.Properties.Len() > 0) || len(s.AllOf) > 0 {\n363\t\t\treturn \"object\"\n364\t\t}\n365\t\tif s.Items != nil && s.Items.IsA() {\n366\t\t\treturn \"array\"\n367\t\t}\n368\t\tif len(s.Type) > 0 {\n369\t\t\treturn \"null\" // the type was declared, and it was only \"null\"\n370\t\t}\n371\t\n372\t\treturn \"string\"\n373\t}\n374\t\n375\t// firstBranch returns the branch to generate from for a oneOf/anyOf schema, or\n376\t// nil if the schema is not a choice.\n377\tfunc firstBranch(s *base.Schema) *base.SchemaProxy {\n378\t\tfor _, branches := range [][]*base.SchemaProxy{s.OneOf, s.AnyOf} {\n379\t\t\tfor _, branch := range branches {\n380\t\t\t\tif branch != nil {\n381\t\t\t\t\treturn branch\n382\t\t\t\t}\n383\t\t\t}\n384\t\t}\n385\t\n386\t\treturn nil\n387\t}\n388\t\n389\t// arrayItems returns the element schema of an array, or nil for a schema whose\n390\t// items are the 3.1 boolean form.\n391\tfunc arrayItems(s *base.Schema) *base.SchemaProxy {\n392\t\tif s.Items == nil || !s.Items.IsA() {\n393\t\t\treturn nil\n394\t\t}\n395\t\n396\t\treturn s.Items.A\n397\t}\n398\t\n399\t// property is one entry of an object's properties, kept as a pair so allOf\n400\t// branches can be spliced into the parent's list in order.\n401\ttype property struct {\n402\t\tname   string\n403\t\tschema *base.SchemaProxy\n404\t}\n405\t\n406\t// propertyPairs lists the properties of a schema in spec order, with allOf\n407\t// branches contributing theirs too: allOf means every branch applies at once,\n408\t// so the fields to generate are the union.\n409\tfunc propertyPairs(s *base.Schema) []property {\n410\t\tvar out []property\n411\t\tif s.Properties != nil {\n412\t\t\tfor name, schema := range s.Properties.FromOldest() {\n413\t\t\t\tout = append(out, property{name: name, schema: schema})\n414\t\t\t}\n415\t\t}\n416\t\n417\t\tfor _, branch := range s.AllOf {\n418\t\t\tif branch == nil {\n419\t\t\t\tcontinue\n420\t\t\t}\n421\t\t\tif sub := branch.Schema(); sub != nil {\n422\t\t\t\tout = append(out, propertyPairs(sub)...)\n423\t\t\t}\n424\t\t}\n425\t\n426\t\treturn out\n427\t}\n428\t\n429\t// requiredSet collects the required property names of a schema and of its allOf\n430\t// branches, matching how propertyPairs merges them.\n431\tfunc requiredSet(s *base.Schema) map[string]bool {\n432\t\treq := make(map[string]bool, len(s.Required))\n433\t\tfor _, name := range s.Required {\n434\t\t\treq[name] = true\n435\t\t}\n436\t\n437\t\tfor _, branch := range s.AllOf {\n438\t\t\tif branch == nil {\n439\t\t\t\tcontinue\n440\t\t\t}\n441\t\t\tif sub := branch.Schema(); sub != nil {\n442\t\t\t\tfor name := range requiredSet(sub) {\n443\t\t\t\t\treq[name] = true\n444\t\t\t\t}\n445\t\t\t}\n446\t\t}\n447\t\n448\t\treturn req\n449\t}\n450\t\n451\t// refKey is the cycle-guard key for a schema: its $ref, or empty for an inline\n452\t// schema, which cannot be its own ancestor.\n453\tfunc refKey(sp *base.SchemaProxy) string {\n454\t\tif !sp.IsReference() {\n455\t\t\treturn \"\"\n456\t\t}\n457\t\n458\t\treturn sp.GetReference()\n459\t}\n460\t"
      }
