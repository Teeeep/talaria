mes = append(names, p.Name)\n\t}\n\n\treturn names\n}\n\n// operationName is the operation's ID, falling back to method and path for a\n// spec that sets no operationId.\nfunc operationName(op operation.Operation) string {\n\tif op.ID != \"\" {\n\t\treturn op.ID\n\t}\n\n\treturn op.Method + \" \" + op.Path\n}\n",
