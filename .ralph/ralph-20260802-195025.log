        "content": "200\t\n201\t\treturn h\n202\t}\n203\t\n204\t// run executes talaria and captures both streams.\n205\tfunc (h *harness) run(args ...string) result {\n206\t\th.t.Helper()\n207\t\n208\t\tcmd := exec.Command(binary, args...)\n209\t\tcmd.Env = h.env\n210\t\n211\t\tvar stdout, stderr strings.Builder\n212\t\tcmd.Stdout, cmd.Stderr = &stdout, &stderr\n213\t\n214\t\tcode := 0\n215\t\tif err := cmd.Run(); err != nil {\n216\t\t\tvar exit *exec.ExitError\n217\t\t\tif !errors.As(err, &exit) {\n218\t\t\t\th.t.Fatalf(\"running talaria %s: %v\", strings.Join(args, \" \"), err)\n219\t\t\t}\n220\t\t\tcode = exit.ExitCode()\n221\t\t}\n222\t\n223\t\treturn result{args: args, code: code, stdout: stdout.String(), stderr: stderr.String()}\n224\t}\n225\t\n226\t// runOK runs talaria and fails the test unless it exited 0.\n227\tfunc (h *harness) runOK(args ...string) result {\n228\t\th.t.Helper()\n229\t\n230\t\tres := h.run(args...)\n231\t\tif res.code != 0 {\n232\t\t\th.t.Fatalf(\"talaria %s = %d, want 0; stderr: %s\",\n233\t\t\t\tstrings.Join(args, \" \"), res.code, res.stderr)\n234\t\t}\n235\t\n236\t\treturn res\n237\t}\n238\t\n239\t// surfaces returns both streams of a result as scannable surfaces.\n240\tfunc (r result) surfaces() []canary.Surface {\n241\t\tlabel := strings.Join(r.args, \" \")\n242\t\n243\t\treturn []canary.Surface{\n244\t\t\tcanary.Stream(\"stdout of `talaria \"+label+\"`\", r.stdout),\n245\t\t\tcanary.Stream(\"stderr of `talaria \"+label+\"`\", r.stderr),\n246\t\t}\n247\t}\n248\t\n249\t// written returns every file talaria left behind: the history store, the spec\n250\t// cache, anything a future version starts writing into the same directories.\n251\t// Enumerated by walking, not by name, so a new persistent artifact is covered\n252\t// the day it appears.\n253\t//\n254\t// The config directory is deliberately not among them. Nothing talaria writes\n255\t// goes there — it is an input the user wrote, and a case that puts a canary in\n256\t// a config file to see how an error path handles it would otherwise be caught\n257\t// finding its own fixture.\n258\tfunc (h *harness) written() []canary.Surface {\n259\t\th.t.Helper()\n260\t\n261\t\tvar surfaces []canary.Surface\n262\t\tfor label, root := range map[string]string{\n263\t\t\t\"history\": h.state,\n264\t\t\t\"cache\":   h.cache,\n265\t\t} {\n266\t\t\tfound, err := canary.Tree(label, root)\n267\t\t\tif err != nil {\n268\t\t\t\th.t.Fatalf(\"enumerating the %s surfaces: %v\", label, err)\n269\t\t\t}\n270\t\t\tsurfaces = append(surfaces, found...)\n271\t\t}\n272\t\n273\t\treturn surfaces\n274\t}\n275\t\n276\t// recordedRequest is what arrived at the test server.\n277\ttype recordedRequest struct {\n278\t\tHeader  http.Header\n279\t\tQuery   url.Values\n280\t\tCookies map[string]bool\n281\t}\n282\t\n283\ttype recordingServer struct {\n284\t\t*httptest.Server\n285\t\n286\t\tmu   sync.Mutex\n287\t\tlast recordedRequest\n288\t}\n289\t\n290\t// newServer starts a server that records each request and answers 200 with a\n291\t// body carrying no secret of its own.\n292\tfunc newServer(t *testing.T, body string) *recordingServer {\n293\t\tt.Helper()\n294\t\n295\t\trs := &recordingServer{}\n296\t\trs.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n297\t\t\tcookies := map[string]bool{}\n298\t\t\tfor _, c := range r.Cookies() {\n299\t\t\t\tcookies[c.Value] = true\n300\t\t\t}\n301\t\n302\t\t\trs.mu.Lock()\n303\t\t\trs.last = recordedRequest{\n304\t\t\t\tHeader:  r.Header.Clone(),\n305\t\t\t\tQuery:   r.URL.Query(),\n306\t\t\t\tCookies: cookies,\n307\t\t\t}\n308\t\t\trs.mu.Unlock()\n309\t\n310\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n311\t\t\t_, _ = io.WriteString(w, body)\n312\t\t}))\n313\t\tt.Cleanup(rs.Close)\n314\t\n315\t\treturn rs\n316\t}\n317\t\n318\tfunc (rs *recordingServer) received() recordedRequest {\n319\t\trs.mu.Lock()\n320\t\tdefer rs.mu.Unlock()\n321\t\n322\t\treturn rs.last\n323\t}\n324\t\n325\t// TestNoAuthMechanismLeaksIntoAnyOutputSurface is the suite §5a asks for: every\n326\t// auth mechanism, every output format, every surface a run produces.\n327\t//\n328\t// The format loop comes from canary.Formats, which is internal/output's Format\n329\t// enum. A fourth format is exercised here the day it is added, and the\n330\t// non-empty assertion below means a format that renders nothing fails rather\n331\t// than passing vacuously.\n332\tfunc TestNoAuthMechanismLeaksIntoAnyOutputSurface(t *testing.T) {\n333\t\tfor _, mech := range mechanisms {\n334\t\t\tfor _, format := range canary.Formats() {\n335\t\t\t\tt.Run(mech.name+\"/\"+format, func(t *testing.T) {\n336\t\t\t\t\tt.Parallel()\n337\t\n338\t\t\t\t\tvalue := canary.Value(mech.name)\n339\t\t\t\t\th := newHarness(t, mech.env(value))\n340\t\t\t\t\tsrv := newServer(t, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n341\t\n342\t\t\t\t\tvar runs []result\n343\t\t\t\t\truns = append(runs,\n344\t\t\t\t\t\th.runOK(\"call\", specPath, mech.op,\n345\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--output\", format, \"--dry-run\"),\n346\t\t\t\t\t\th.runOK(\"call\", specPath, mech.op,\n347\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--output\", format),\n348\t\t\t\t\t\t// Exits 5: the fixture declares every scheme and this case\n349\t\t\t\t\t\t// sets one. The report is the surface being checked, and it\n350\t\t\t\t\t\t// is written on the way to that exit code.\n351\t\t\t\t\t\th.run(\"auth\", \"check\", specPath, \"--output\", format),\n352\t\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n353\t\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n354\t\t\t\t\t\th.runOK(\"history\", \"replay\", \"1\", \"--output\", format),\n355\t\t\t\t\t\th.runOK(\"describe\", specPath, mech.op, \"--output\", format),\n356\t\t\t\t\t\th.runOK(\"list\", specPath, \"--output\", format),\n357\t\t\t\t\t\t// Last, so it disturbs no history index above. `run` sends\n358\t\t\t\t\t\t// the same credential `call` does and renders its own\n359\t\t\t\t\t\t// report, so it is its own surface.\n360\t\t\t\t\t\th.runOK(\"run\", specPath, \"--operation\", mech.op,\n361\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--report\", format),\n362\t\t\t\t\t)\n363\t\n364\t\t\t\t\t// The credential reached the server. Without this the rest of\n365\t\t\t\t\t// the test would pass just as well if talaria sent nothing.\n366\t\t\t\t\tif !mech.received(srv.received(), value) {\n367\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s credential; the leak assertions below prove nothing\", mech.name)\n368\t\t\t\t\t}\n369\t\n370\t\t\t\t\tvar surfaces []canary.Surface\n371\t\t\t\t\tfor _, res := range runs {\n372\t\t\t\t\t\tif strings.TrimSpace(res.stdout) == \"\" {\n373\t\t\t\t\t\t\tt.Errorf(\"`talaria %s` printed nothing; --output %s renders no payload\",\n374\t\t\t\t\t\t\t\tstrings.Join(res.args, \" \"), format)\n375\t\t\t\t\t\t}\n376\t\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n377\t\t\t\t\t}\n378\t\t\t\t\tsurfaces = append(surfaces, h.written()...)\n379\t\n380\t\t\t\t\tassertNoLeak(t, value, surfaces)\n381\t\t\t\t})\n382\t\t\t}\n383\t\t}\n384\t}\n385\t\n386\t// TestNoReportFormatLeaksTheCredential covers §5a's \"junit reports\" among the\n387\t// output surfaces, and every other shape `run --report` writes.\n388\t//\n389\t// It is a loop of its own rather than a line in the test above because the\n390\t// report formats are a superset of the --output ones: junit describes a suite\n391\t// of operations, which is something only `run` produces. Driving it from\n392\t// canary.ReportFormats means a fifth report format is covered the day it is\n393\t// added.\n394\tfunc TestNoReportFormatLeaksTheCredential(t *testing.T) {\n395\t\tfor _, mech := range mechanisms {\n396\t\t\tfor _, format := range canary.ReportFormats() {\n397\t\t\t\tt.Run(mech.name+\"/\"+format, func(t *testing.T) {\n398\t\t\t\t\tt.Parallel()\n399\t\n400\t\t\t\t\tvalue := canary.Value(mech.name)\n401\t\t\t\t\th := newHarness(t, mech.env(value))\n402\t\t\t\t\tsrv := newServer(t, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n403\t\n404\t\t\t\t\tres := h.runOK(\"run\", specPath, \"--operation\", mech.op,\n405\t\t\t\t\t\t\"--base-url\", srv.URL, \"--report\", format)\n406\t\n407\t\t\t\t\tif !mech.received(srv.received(), value) {\n408\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s credential; the leak assertions below prove nothing\", mech.name)\n409\t\t\t\t\t}\n410\t\t\t\t\t// A report that named the operation is a report that rendered.\n411\t\t\t\t\t// Without this a format writing an empty shell would pass every\n412\t\t\t\t\t// assertion below by having nothing in it at all.\n413\t\t\t\t\tif !strings.Contains(res.stdout, mech.op) {\n414\t\t\t\t\t\tt.Errorf(\"`--report %s` does not name the operation it ran:\\n%s\", format, res.stdout)\n415\t\t\t\t\t}\n416\t\n417\t\t\t\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n418\t\t\t\t})\n419\t\t\t}\n420\t\t}\n421\t}\n422\t\n423\t// TestErrorPathsDoNotLeakTheCredential covers §5a's \"error paths are where\n424\t// redaction bugs live\": a failure at each stage of a call, with a credential\n425\t// present throughout.\n426\tfunc TestErrorPathsDoNotLeakTheCredential(t *testing.T) {\n427\t\t// A response-validation failure is not here because response validation is\n428\t\t// not built yet (plan tasks 26 and 27). Whoever adds --fail-on-error adds\n429\t\t// the case; the stages that exist are all covered.\n430\t\tstages := []struct {\n431\t\t\tname string\n432\t\t\targs func(serverURL string) []string\n433\t\t\tcode int\n434\t\t}{\n435\t\t\t{\n436\t\t\t\tname: \"spec load\",\n437\t\t\t\targs: func(string) []string { return []string{\"call\", \"testdata/absent.yaml\", \"getBearer\"} },\n438\t\t\t\tcode: 3,\n439\t\t\t},\n440\t\t\t{\n441\t\t\t\tname: \"operation lookup\",\n442\t\t\t\targs: func(string) []string { return []string{\"call\", specPath, \"noSuchOperation\"} },\n443\t\t\t\tcode: 2,\n444\t\t\t},\n445\t\t\t{\n446\t\t\t\tname: \"parameter binding\",\n447\t\t\t\targs: func(url string) []string {\n448\t\t\t\t\t// getPet's petId is required and unbound.\n449\t\t\t\t\treturn []string{\"call\", specPath, \"getPet\", \"--base-url\", url}\n450\t\t\t\t},\n451\t\t\t\tcode: 2,\n452\t\t\t},\n453\t\t\t{\n454\t\t\t\tname: \"mutation gate\",\n455\t\t\t\targs: func(url string) []string {\n456\t\t\t\t\treturn []string{\"call\", specPath, \"createThing\", \"--base-url\", url}\n457\t\t\t\t},\n458\t\t\t\tcode: 2,\n459\t\t\t},\n460\t\t\t{\n461\t\t\t\tname: \"body read\",\n462\t\t\t\targs: func(url string) []string {\n463\t\t\t\t\treturn []string{\"call\", specPath, \"getBearer\", \"--base-url\", url, \"--body\", \"@testdata/absent.json\"}\n464\t\t\t\t},\n465\t\t\t\tcode: 2,\n466\t\t\t},\n467\t\t\t{\n468\t\t\t\tname: \"curl exec\",\n469\t\t\t\targs: func(string) []string {\n470\t\t\t\t\t// Port 1 on the loopback interface: curl runs, the request fails.\n471\t\t\t\t\treturn []string{\"call\", specPath, \"getBearer\", \"--base-url\", \"http://127.0.0.1:1\"}\n472\t\t\t\t},\n473\t\t\t\tcode: 1,\n474\t\t\t},\n475\t\t\t{\n476\t\t\t\tname: \"history index\",\n477\t\t\t\targs: func(string) []string { return []string{\"history\", \"show\", \"99\"} },\n478\t\t\t\tcode: 2,\n479\t\t\t},\n480\t\t}\n481\t\n482\t\tfor _, stage := range stages {\n483\t\t\tt.Run(stage.name, func(t *testing.T) {\n484\t\t\t\tt.Parallel()\n485\t\n486\t\t\t\tvalue := canary.Value(\"error\")\n487\t\t\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n488\t\t\t\tsrv := newServer(t, `{}`)\n489\t\n490\t\t\t\tres := h.run(stage.args(srv.URL)...)\n491\t\t\t\tif res.code != stage.code {\n492\t\t\t\t\tt.Errorf(\"talaria %s = %d, want %d; stderr: %s\",\n493\t\t\t\t\t\tstrings.Join(res.args, \" \"), res.code, stage.code, res.stderr)\n494\t\t\t\t}\n495\t\t\t\tif strings.TrimSpace(res.stderr) == \"\" {\n496\t\t\t\t\tt.Errorf(\"talaria %s failed silently; there is no error surface to check\",\n497\t\t\t\t\t\tstrings.Join(res.args, \" \"))\n498\t\t\t\t}\n499\t\n500\t\t\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n501\t\t\t})\n502\t\t}\n503\t}\n504\t\n505\t// TestACredentialResolutionFailureNamesNoValue covers the one error path where\n506\t// the credential is in a *configuration file* rather than the environment: a\n507\t// profile with a literal value is refused, and the refusal must not quote what\n508\t// it refused (§5a).\n509\tfunc TestACredentialResolutionFailureNamesNoValue(t *testing.T) {\n510\t\tt.Parallel()\n511\t\n512\t\tvalue := canary.Value(\"profile\")\n513\t\th := newHarness(t, nil)\n514\t\twriteConfig(t, h, \"profiles:\\n  staging:\\n    auth:\\n      bearerAuth: \"+value+\"\\n\")\n515\t\n516\t\tres := h.run(\"call\", specPath, \"getBearer\", \"--profile\", \"staging\", \"--dry-run\")\n517\t\tif res.code != 2 {\n518\t\t\tt.Errorf(\"a literal profile credential = %d, want 2; stderr: %s\", res.code, res.stderr)\n519\t\t}\n520\t\n521\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n522\t}\n523\t\n524\t// TestAMissingCredentialIsReportedWithoutAValue exercises the exit-5 path with\n525\t// a canary set for a *different* scheme, so the report is built while a\n526\t// credential is in reach.\n527\tfunc TestAMissingCredentialIsReportedWithoutAValue(t *testing.T) {\n528\t\tt.Parallel()\n529\t"
      }
