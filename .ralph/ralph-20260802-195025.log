        "tool_use_id": "toolu_01AWt1EoJMhzaf9hzKQdpSir",
        "type": "tool_result",
        "content": "529\t\n530\t\tvalue := canary.Value(\"authcheck\")\n531\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n532\t\n533\t\t// Every other scheme in the fixture is unset, so `auth check` reports the\n534\t\t// gap and exits 5.\n535\t\tres := h.run(\"auth\", \"check\", specPath, \"--output\", \"json\")\n536\t\tif res.code != 5 {\n537\t\t\tt.Errorf(\"auth check with schemes unset = %d, want 5; stderr: %s\", res.code, res.stderr)\n538\t\t}\n539\t\n540\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n541\t}\n542\t\n543\t// TestAUserSuppliedHeaderIsRedactedLikeASpecCredential holds the line the\n544\t// Redactor already claims: \"a bearer token the user typed into --header is as\n545\t// sensitive as one talaria resolved itself\". The value's origin does not change\n546\t// what it is.\n547\t//\n548\t// The --query case is here rather than in a test of its own because it is the\n549\t// same claim about a different flag: §5a names query-string API keys as a\n550\t// credential location, so `--query api_key=…` is covered by the built-in name\n551\t// matcher exactly as `--header X-Api-Key: …` is.\n552\tfunc TestAUserSuppliedHeaderIsRedactedLikeASpecCredential(t *testing.T) {\n553\t\tcases := []struct {\n554\t\t\tname string\n555\t\t\tflag string\n556\t\t\t// arg builds the flag's name=value argument around the canary.\n557\t\t\targ func(value string) string\n558\t\t\t// sent returns what the server actually received under that name, so\n559\t\t\t// each case can prove the value still went out before asserting that\n560\t\t\t// no surface printed it.\n561\t\t\tsent func(name string, req recordedRequest) string\n562\t\t}{\n563\t\t\t{\n564\t\t\t\tname: \"authorization\",\n565\t\t\t\tflag: \"--header\",\n566\t\t\t\targ:  func(v string) string { return \"Authorization=Bearer \" + v },\n567\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Header.Get(name) },\n568\t\t\t},\n569\t\t\t{\n570\t\t\t\tname: \"api-key\",\n571\t\t\t\tflag: \"--header\",\n572\t\t\t\targ:  func(v string) string { return \"X-Api-Key=\" + v },\n573\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Header.Get(name) },\n574\t\t\t},\n575\t\t\t{\n576\t\t\t\tname: \"token\",\n577\t\t\t\tflag: \"--header\",\n578\t\t\t\targ:  func(v string) string { return \"X-Session-Token=\" + v },\n579\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Header.Get(name) },\n580\t\t\t},\n581\t\t\t{\n582\t\t\t\tname: \"query-api-key\",\n583\t\t\t\tflag: \"--query\",\n584\t\t\t\targ:  func(v string) string { return \"api_key=\" + v },\n585\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Query.Get(name) },\n586\t\t\t},\n587\t\t}\n588\t\n589\t\tfor _, tc := range cases {\n590\t\t\tfor _, format := range canary.Formats() {\n591\t\t\t\tt.Run(tc.name+\"/\"+format, func(t *testing.T) {\n592\t\t\t\t\tt.Parallel()\n593\t\n594\t\t\t\t\tvalue := canary.Value(\"header\")\n595\t\t\t\t\th := newHarness(t, nil)\n596\t\t\t\t\tsrv := newServer(t, `{\"ok\":true}`)\n597\t\n598\t\t\t\t\truns := []result{\n599\t\t\t\t\t\th.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL,\n600\t\t\t\t\t\t\ttc.flag, tc.arg(value), \"--output\", format, \"--dry-run\"),\n601\t\t\t\t\t\th.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL,\n602\t\t\t\t\t\t\ttc.flag, tc.arg(value), \"--output\", format),\n603\t\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n604\t\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n605\t\t\t\t\t}\n606\t\n607\t\t\t\t\t// It still has to arrive: redaction is about what talaria prints,\n608\t\t\t\t\t// not about dropping what the user asked to send.\n609\t\t\t\t\tname := strings.SplitN(tc.arg(value), \"=\", 2)[0]\n610\t\t\t\t\tif got := tc.sent(name, srv.received()); !strings.Contains(got, value) {\n611\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s value; the leak assertions below prove nothing\", tc.flag)\n612\t\t\t\t\t}\n613\t\n614\t\t\t\t\tvar surfaces []canary.Surface\n615\t\t\t\t\tfor _, res := range runs {\n616\t\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n617\t\t\t\t\t}\n618\t\n619\t\t\t\t\tassertNoLeak(t, value, append(surfaces, h.written()...))\n620\t\t\t\t})\n621\t\t\t}\n622\t\t}\n623\t}\n624\t\n625\t// TestAnUnconfiguredResponseBodySecretIsNotRedacted documents the boundary\n626\t// rather than pretending it is elsewhere. §5a redacts response headers and the\n627\t// RFC 6749 token fields by name; a secret under an API-specific name is the\n628\t// known uncovered threat, because talaria cannot tell a credential from any\n629\t// other string by looking at it.\n630\t//\n631\t// If this ever fails because the value was redacted, the boundary moved and the\n632\t// documentation — AGENT.md, DESIGN.md §5a — moves with it.\n633\tfunc TestAnUnconfiguredResponseBodySecretIsNotRedacted(t *testing.T) {\n634\t\tt.Parallel()\n635\t\n636\t\tvalue := canary.Value(\"response\")\n637\t\th := newHarness(t, nil)\n638\t\tsrv := newServer(t, `{\"access_token\":\"issued\",\"data\":{\"session\":\"`+value+`\"}}`)\n639\t\n640\t\tres := h.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", \"json\")\n641\t\tif !strings.Contains(res.stdout, value) {\n642\t\t\tt.Errorf(\"an unconfigured response body secret was redacted; the documented boundary has moved:\\n%s\", res.stdout)\n643\t\t}\n644\t\t// The names talaria *can* recognise are covered without configuration, which\n645\t\t// is what makes the above a boundary rather than an absence of redaction.\n646\t\tif strings.Contains(res.stdout, `\"issued\"`) {\n647\t\t\tt.Errorf(\"the built-in access_token body path was not redacted:\\n%s\", res.stdout)\n648\t\t}\n649\t\n650\t\t// And the configured countermeasure closes the rest of the gap.\n651\t\twriteConfig(t, h, \"redact:\\n  body-paths:\\n    - data.session\\n\")\n652\t\n653\t\tres = h.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", \"json\")\n654\t\tif strings.Contains(res.stdout, value) {\n655\t\t\tt.Errorf(\"redact.body-paths did not redact the configured path:\\n%s\", res.stdout)\n656\t\t}\n657\t}\n658\t\n659\t// TestNoCommandExposesAVerboseOrDebugFlag is §5a's \"no --verbose that bypasses\n660\t// [redaction]\" in its strongest form: there is no such flag to bypass it.\n661\t// Whoever adds one inherits this test, and with it the obligation to route it\n662\t// through the redacted representation.\n663\tfunc TestNoCommandExposesAVerboseOrDebugFlag(t *testing.T) {\n664\t\tt.Parallel()\n665\t\n666\t\th := newHarness(t, nil)\n667\t\tcommands := listCommands(t, h)\n668\t\n669\t\t// A parse that found nothing would pass silently, so the shape of the help\n670\t\t// output is asserted before anything is concluded from it.\n671\t\tfor _, want := range []string{\"call\", \"list\", \"describe\", \"search\", \"uses\", \"auth\", \"history\", \"version\"} {\n672\t\t\tif !contains(commands, want) {\n673\t\t\t\tt.Fatalf(\"parsed the command list as %v, which is missing %q\", commands, want)\n674\t\t\t}\n675\t\t}\n676\t\n677\t\tfor _, name := range commands {\n678\t\t\tfor _, flag := range []string{\"--verbose\", \"--debug\"} {\n679\t\t\t\tres := h.run(name, flag)\n680\t\t\t\tif res.code != 2 {\n681\t\t\t\t\tt.Errorf(\"`talaria %s %s` = %d, want 2 (unknown flag); stdout: %s stderr: %s\",\n682\t\t\t\t\t\tname, flag, res.code, res.stdout, res.stderr)\n683\t\t\t\t}\n684\t\t\t}\n685\t\n686\t\t\t// A hidden flag would not fail above but also would not be advertised,\n687\t\t\t// so the help text is checked too.\n688\t\t\thelp := h.run(name, \"--help\")\n689\t\t\tfor _, flag := range []string{\"--verbose\", \"--debug\"} {\n690\t\t\t\tif strings.Contains(help.stdout, flag) {\n691\t\t\t\t\tt.Errorf(\"`talaria %s --help` advertises %s:\\n%s\", name, flag, help.stdout)\n692\t\t\t\t}\n693\t\t\t}\n694\t\t}\n695\t}\n696\t\n697\t// TestASpecFetchedOverHTTPLeavesNoCredentialInTheCache covers the spec cache as\n698\t// a surface with something actually in it — a cache that was never written is\n699\t// not evidence of anything.\n700\tfunc TestASpecFetchedOverHTTPLeavesNoCredentialInTheCache(t *testing.T) {\n701\t\tt.Parallel()\n702\t\n703\t\tspec, err := os.ReadFile(specPath)\n704\t\tif err != nil {\n705\t\t\tt.Fatalf(\"reading the fixture: %v\", err)\n706\t\t}\n707\t\n708\t\tvalue := canary.Value(\"cache\")\n709\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n710\t\n711\t\tsrv := newServer(t, `{\"ok\":true}`)\n712\t\tspecSrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {\n713\t\t\t_, _ = w.Write(spec)\n714\t\t}))\n715\t\tt.Cleanup(specSrv.Close)\n716\t\n717\t\tres := h.runOK(\"call\", specSrv.URL+\"/openapi.yaml\", \"getBearer\",\n718\t\t\t\"--base-url\", srv.URL, \"--output\", \"json\")\n719\t\n720\t\tcached, err := canary.Tree(\"cache\", h.cache)\n721\t\tif err != nil {\n722\t\t\tt.Fatalf(\"enumerating the cache: %v\", err)\n723\t\t}\n724\t\tif len(cached) == 0 {\n725\t\t\tt.Fatal(\"the spec cache is empty; the fetch did not exercise the surface this test is about\")\n726\t\t}\n727\t\n728\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n729\t}\n730\t\n731\t// TestAPlantedCurlrcCannotCaptureTheCredential covers the capability §5a does\n732\t// not concede: an attacker who can write one file under $HOME but cannot read\n733\t// the environment.\n734\t//\n735\t// curl parses $HOME/.curlrc before the `-K -` document, so without curl's -q a\n736\t// `trace-ascii` line there writes the plaintext Authorization header — the one\n737\t// place in the process the credential is resolved — to a path of the writer's\n738\t// choosing, at whatever mode their umask gives. The redacted output surfaces\n739\t// stay clean throughout, which is why this needs a case of its own: every other\n740\t// assertion in this suite would pass while the token sat in the trace file.\n741\tfunc TestAPlantedCurlrcCannotCaptureTheCredential(t *testing.T) {\n742\t\tt.Parallel()\n743\t\n744\t\tvalue := canary.Value(\"curlrc\")\n745\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n746\t\tsrv := newServer(t, `{\"ok\":true}`)\n747\t\n748\t\ttrace := filepath.Join(h.home, \"trace.txt\")\n749\t\tcurlrc := filepath.Join(h.home, \".curlrc\")\n750\t\tif err := os.WriteFile(curlrc, []byte(\"trace-ascii = \"+trace+\"\\n\"), 0o600); err != nil {\n751\t\t\tt.Fatalf(\"planting the .curlrc: %v\", err)\n752\t\t}\n753\t\n754\t\tres := h.runOK(\"call\", specPath, \"getBearer\", \"--base-url\", srv.URL, \"--output\", \"json\")\n755\t\n756\t\t// The call has to have happened with the credential on it, or a missing\n757\t\t// trace file would mean nothing.\n758\t\tif got := srv.received().Header.Get(\"Authorization\"); got != \"Bearer \"+value {\n759\t\t\tt.Fatalf(\"the server never saw the credential; the assertions below prove nothing\")\n760\t\t}\n761\t\n762\t\tsurfaces := append(res.surfaces(), h.written()...)\n763\t\tswitch _, err := os.Stat(trace); {\n764\t\tcase err == nil:\n765\t\t\t// The file existing is already the finding, but scanning it says whether\n766\t\t\t// the credential is in it — the difference between a lost -q and a lost\n767\t\t\t// firewall.\n768\t\t\tfound, err := canary.Tree(\"curlrc trace\", trace)\n769\t\t\tif err != nil {\n770\t\t\t\tt.Fatalf(\"reading the trace file: %v\", err)\n771\t\t\t}\n772\t\t\tsurfaces = append(surfaces, found...)\n773\t\t\tt.Errorf(\"curl honoured %s and wrote %s; the -q that disables it is gone from argv\", curlrc, trace)\n774\t\tcase !errors.Is(err, fs.ErrNotExist):\n775\t\t\tt.Fatalf(\"stating the trace file: %v\", err)\n776\t\t}\n777\t\n778\t\tassertNoLeak(t, value, surfaces)\n779\t}\n780\t\n781\t// assertNoLeak fails the test naming every surface the canary reached.\n782\tfunc assertNoLeak(t *testing.T, value string, surfaces []canary.Surface) {\n783\t\tt.Helper()\n784\t\n785\t\tleaks := canary.Scan(value, surfaces...)\n786\t\tif len(leaks) == 0 {\n787\t\t\treturn\n788\t\t}\n789\t\n790\t\tvar names []string\n791\t\tfor _, leak := range leaks {\n792\t\t\tnames = append(names, leak.String())\n793\t\t}\n794\t\tt.Errorf(\"the canary reached %d surface(s):\\n  %s\", len(leaks), strings.Join(names, \"\\n  \"))\n795\t}\n796\t\n797\t// listCommands reads the command names out of the root help, so a command\n798\t// added later is checked without anyone remembering to list it here.\n799\tfunc listCommands(t *testing.T, h *harness) []string {\n800\t\tt.Helper()\n801\t\n802\t\thelp := h.runOK(\"--help\")\n803\t\n804\t\tvar names []string\n805\t\tvar inList bool\n806\t\tfor _, line := range strings.Split(help.stdout, \"\\n\") {\n807\t\t\tswitch {\n808\t\t\tcase strings.HasPrefix(line, \"Available Commands:\"):\n809\t\t\t\tinList = true\n810\t\t\tcase inList && strings.TrimSpace(line) == \"\":\n811\t\t\t\tinList = false\n812\t\t\tcase inList:\n813\t\t\t\tif fields := strings.Fields(line); len(fields) > 0 {\n814\t\t\t\t\tnames = append(names, fields[0])\n815\t\t\t\t}\n816\t\t\t}\n817\t\t}\n818\t\n819\t\treturn names\n820\t}\n821\t\n822\tfunc contains(haystack []string, needle string) bool {\n823\t\tfor _, s := range haystack {\n824\t\t\tif s == needle {\n825\t\t\t\treturn true\n826\t\t\t}\n827\t\t}\n828\t\n829\t\treturn false\n830\t}\n831\t\n832\t// writeConfig puts a config file in the harness's isolated config home.\n833\tfunc writeConfig(t *testing.T, h *harness, yaml string) {\n834\t\tt.Helper()\n835\t\n836\t\tdir := filepath.Join(h.conf, \"talaria\")\n837\t\tif err := os.MkdirAll(dir, 0o700); err != nil {\n838\t\t\tt.Fatalf(\"creating the config directory: %v\", err)\n839\t\t}\n840\t\tif err := os.WriteFile(filepath.Join(dir, \"config.yaml\"), []byte(yaml), 0o600); err != nil {\n841\t\t\tt.Fatalf(\"writing the config file: %v\", err)\n842\t\t}\n843\t}\n844\t"
      }
