        "type": "tool_result",
        "content": "1\t# A deliberately adversarial OpenAPI 3.0 document. Every construct here is legal\n2\t# 3.0 and illegal — or means something different — under the 3.1+ JSON Schema\n3\t# semantics libopenapi-validator defaults to (DESIGN.md §8):\n4\t#\n5\t#   - `nullable: true`          — dropped in 3.1 in favour of `type: [x, \"null\"]`\n6\t#   - boolean exclusiveMinimum  — draft-04 spelling; 2020-12 wants a number\n7\t#   - boolean exclusiveMaximum  — same\n8\t#   - singular `example`        — 3.1 uses `examples` as an array\n9\t#\n10\t# A validator that applies 3.1 semantics to this document rejects a body that\n11\t# the spec's own author considers valid.\n12\topenapi: 3.0.3\n13\tinfo:\n14\t  title: Strict Edges\n15\t  version: \"1.0.0\"\n16\tservers:\n17\t  - url: https://api.strict.example.com\n18\tpaths:\n19\t  /widgets:\n20\t    get:\n21\t      operationId: listWidgets\n22\t      responses:\n23\t        \"200\":\n24\t          description: One widget\n25\t          content:\n26\t            application/json:\n27\t              schema:\n28\t                $ref: \"#/components/schemas/Widget\"\n29\tcomponents:\n30\t  schemas:\n31\t    Widget:\n32\t      type: object\n33\t      required: [id, label, score, tags]\n34\t      properties:\n35\t        id:\n36\t          type: integer\n37\t          minimum: 0\n38\t          exclusiveMinimum: true\n39\t          maximum: 100\n40\t          exclusiveMaximum: true\n41\t          example: 5\n42\t        label:\n43\t          type: string\n44\t          nullable: true\n45\t          example: widget-one\n46\t        score:\n47\t          type: number\n48\t          nullable: true\n49\t          minimum: 0\n50\t          exclusiveMinimum: true\n51\t        tags:\n52\t          type: array\n53\t          nullable: true\n54\t          items:\n55\t            type: string\n56\t          example: [a, b]\n57\t"
      }
    ]
