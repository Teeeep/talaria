        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"net/http\"\n5\t\t\"os\"\n6\t\t\"strconv\"\n7\t\t\"strings\"\n8\t\t\"time\"\n9\t\t\"unicode/utf8\"\n10\t\n11\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n12\t\t\"github.com/Teeeep/talaria/internal/request\"\n13\t)\n14\t\n15\t// maxInlineBody is the size above which a body stops being a directive and\n16\t// becomes a 0600 temp file. DESIGN.md §5a calls the temp file \"the exception\":\n17\t// it is a real file on disk for the length of one exec, so the threshold is set\n18\t// where the config document stops being a reasonable place to put bytes rather\n19\t// than at any hard limit of curl's.\n20\tconst maxInlineBody = 1 << 20\n21\t\n22\t// The default bounds on one call. They are generous enough that a slow but\n23\t// working API still answers, and short enough that a wedged one becomes an exit\n24\t// code rather than a process an agent cannot interpret — the reasoning\n25\t// internal/spec/source.go already applies to fetching a spec, applied to the\n26\t// higher-risk path.\n27\tconst (\n28\t\tDefaultConnectTimeout = 10 * time.Second\n29\t\tDefaultMaxTime        = 30 * time.Second\n30\t)\n31\t\n32\t// Options bound one invocation of curl in time. They are enforced by curl\n33\t// itself, which exits 28 when either runs out; the executor's own deadline is\n34\t// only the backstop for a curl that ignores them.\n35\ttype Options struct {\n36\t\t// ConnectTimeout limits establishing the connection.\n37\t\tConnectTimeout time.Duration\n38\t\t// MaxTime limits the whole operation, connection included.\n39\t\tMaxTime time.Duration\n40\t}\n41\t\n42\t// DefaultOptions returns the bounds a caller gets without asking.\n43\tfunc DefaultOptions() Options {\n44\t\treturn Options{ConnectTimeout: DefaultConnectTimeout, MaxTime: DefaultMaxTime}\n45\t}\n46\t\n47\t// withDefaults fills in the timeouts a caller left unset.\n48\t//\n49\t// A non-positive value means \"unset\" rather than \"no limit\": an unbounded call\n50\t// is exactly what these options exist to prevent, so there is deliberately no\n51\t// way to ask for one. A connect timeout longer than the total is clamped, since\n52\t// curl would enforce the total against it anyway and the pair reads as a lie.\n53\tfunc (o Options) withDefaults() Options {\n54\t\tif o.ConnectTimeout <= 0 {\n55\t\t\to.ConnectTimeout = DefaultConnectTimeout\n56\t\t}\n57\t\tif o.MaxTime <= 0 {\n58\t\t\to.MaxTime = DefaultMaxTime\n59\t\t}\n60\t\tif o.ConnectTimeout > o.MaxTime {\n61\t\t\to.ConnectTimeout = o.MaxTime\n62\t\t}\n63\t\n64\t\treturn o\n65\t}\n66\t\n67\t// Capture names the files curl writes the response to. Both are optional; the\n68\t// executor allocates them and passes them here rather than appending them to\n69\t// argv, because §5a's rule is that *nothing* about the call is an argument, not\n70\t// merely nothing sensitive.\n71\ttype Capture struct {\n72\t\t// BodyPath receives the response body, via the output directive.\n73\t\tBodyPath string\n74\t\t// HeaderPath receives the response headers, via the dump-header directive.\n75\t\tHeaderPath string\n76\t}\n77\t\n78\t// BuildConfig renders req as a curl config document for `curl -K -`.\n79\t//\n80\t// This is the one place in talaria where a resolved credential exists. The\n81\t// document is written to curl's stdin and holds the real values; the returned\n82\t// argv is exactly `curl -K -` and holds nothing, because /proc/*/cmdline is\n83\t// readable by any process on the host — including ones an agent spawns (§5a).\n84\t//\n85\t// cleanup must be called once curl has exited. It removes any temp body file\n86\t// and zeroes the document, so the resolved values do not linger in a buffer the\n87\t// rest of the process can still reach. It is safe to call more than once, and\n88\t// is non-nil even when BuildConfig fails.\n89\t//\n90\t// A credential whose environment variable is unset fails with exit code 5 and\n91\t// no document, rather than sending an empty header — an unauthenticated request\n92\t// that looks authenticated is the worse outcome (§4).\n93\tfunc BuildConfig(req *request.Request, capture Capture) (config []byte, argv []string, cleanup func(), err error) {\n94\t\treturn BuildConfigWith(req, capture, DefaultOptions())\n95\t}\n96\t\n97\t// BuildConfigWith is BuildConfig with the timeouts named rather than defaulted.\n98\tfunc BuildConfigWith(\n99\t\treq *request.Request,\n100\t\tcapture Capture,\n101\t\topts Options,\n102\t) (config []byte, argv []string, cleanup func(), err error) {\n103\t\targv = []string{\"curl\", \"-K\", \"-\"}\n104\t\tif req == nil {\n105\t\t\treturn nil, argv, func() {}, clierr.RequestFailed(\"no request to execute\")\n106\t\t}\n107\t\n108\t\tvar doc document\n109\t\tif err := doc.build(req, capture, opts.withDefaults()); err != nil {\n110\t\t\tdoc.discard()\n111\t\t\treturn nil, argv, doc.cleanup, err\n112\t\t}\n113\t\n114\t\tconfig = []byte(doc.b.String())\n115\t\tdoc.b.Reset()\n116\t\n117\t\treturn config, argv, doc.cleanupWith(config), nil\n118\t}\n119\t\n120\t// document accumulates the directives and the temp files they point at, so a\n121\t// failure part-way through still knows what to remove.\n122\ttype document struct {\n123\t\tb     strings.Builder\n124\t\tfiles []string\n125\t}\n126\t\n127\tfunc (d *document) build(req *request.Request, capture Capture, opts Options) error {\n128\t\turl, err := req.URL(resolve)\n129\t\tif err != nil {\n130\t\t\treturn err\n131\t\t}\n132\t\td.directive(\"url\", url)\n133\t\n134\t\t// head rather than `request = \"HEAD\"`: -X HEAD leaves curl waiting for a body\n135\t\t// of Content-Length bytes that a compliant server never sends, so the call\n136\t\t// hangs (or exits 18 when the connection closes first). HEAD is a safe method\n137\t\t// that `run` includes without --allow-mutations, so one such operation would\n138\t\t// stall an entire report.\n139\t\thead := strings.EqualFold(req.Method, http.MethodHead)\n140\t\tswitch {\n141\t\tcase head:\n142\t\t\td.flag(\"head\")\n143\t\tcase req.Method != \"\":\n144\t\t\td.directive(\"request\", req.Method)\n145\t\t}\n146\t\n147\t\tif err := d.auth(req); err != nil {\n148\t\t\treturn err\n149\t\t}\n150\t\tif err := d.cookies(req); err != nil {\n151\t\t\treturn err\n152\t\t}\n153\t\tif err := d.body(req); err != nil {\n154\t\t\treturn err\n155\t\t}\n156\t\n157\t\t// Defence in depth behind request.IsHTTPScheme: curl speaks file, gopher,\n158\t\t// dict and smb, and a redirect chooses the scheme of the next hop without\n159\t\t// asking talaria. The leading `=` makes each list absolute rather than\n160\t\t// additive, so these two are the only protocols this process can use.\n161\t\td.directive(\"proto\", \"=http,https\")\n162\t\td.directive(\"proto-redir\", \"=http,https\")\n163\t\n164\t\t// The bounds curl enforces on itself. Emitted as directives rather than\n165\t\t// watched from Go because curl exits 28 of its own accord, which runFailure\n166\t\t// already classifies as a failed request — so the happy path never has to\n167\t\t// know a clock exists. A `run` without these stalls on operation k of n and\n168\t\t// emits no report at all.\n169\t\td.directive(\"connect-timeout\", seconds(opts.ConnectTimeout))\n170\t\td.directive(\"max-time\", seconds(opts.MaxTime))\n171\t\n172\t\t// silent suppresses the progress meter, which would otherwise be interleaved\n173\t\t// with the write-out payload on stdout; show-error keeps real failures\n174\t\t// visible despite it.\n175\t\td.flag(\"silent\")\n176\t\td.flag(\"show-error\")\n177\t\t// %{json} is the whole response metadata in one parseable object, and is the\n178\t\t// reason DESIGN.md sets a curl >= 7.70 floor.\n179\t\td.directive(\"write-out\", \"%{json}\")\n180\t\n181\t\tif capture.BodyPath != \"\" {\n182\t\t\t// head makes curl write the header block to the output file, which at\n183\t\t\t// capture.BodyPath would be reported as the response body. dump-header\n184\t\t\t// still captures the headers, and the staged empty body file keeps\n185\t\t\t// readResponse reading a real path.\n186\t\t\tpath := capture.BodyPath\n187\t\t\tif head {\n188\t\t\t\tpath = os.DevNull\n189\t\t\t}\n190\t\t\td.directive(\"output\", path)\n191\t\t}\n192\t\tif capture.HeaderPath != \"\" {\n193\t\t\td.directive(\"dump-header\", capture.HeaderPath)\n194\t\t}\n195\t\n196\t\treturn nil\n197\t}\n198\t\n199\t// auth writes the request headers, diverting basic auth to curl's own user\n200\t// directive: the header text is base64(user:password), and letting curl encode\n201\t// it means this package never has to.\n202\tfunc (d *document) auth(req *request.Request) error {\n203\t\tfor _, h := range req.Headers {\n204\t\t\tvalue, err := resolve(h.Value)\n205\t\t\tif err != nil {\n206\t\t\t\treturn err\n207\t\t\t}\n208\t\n209\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n210\t\t\t\td.directive(\"user\", strings.TrimPrefix(value, h.Value.Prefix()))\n211\t\t\t\tcontinue\n212\t\t\t}\n213\t\n214\t\t\td.directive(\"header\", h.Name+\": \"+value)\n215\t\t}\n216\t\n217\t\treturn nil\n218\t}\n219\t\n220\t// cookies writes every cookie as one directive. curl keeps only the last of\n221\t// several, so they are joined rather than repeated.\n222\tfunc (d *document) cookies(req *request.Request) error {\n223\t\tif len(req.Cookies) == 0 {\n224\t\t\treturn nil\n225\t\t}\n226\t\n227\t\tvar b strings.Builder\n228\t\tfor i, c := range req.Cookies {\n229\t\t\tvalue, err := resolve(c.Value)\n230\t\t\tif err != nil {\n231\t\t\t\treturn err\n232\t\t\t}\n233\t\n234\t\t\tif i > 0 {\n235\t\t\t\tb.WriteString(\"; \")\n236\t\t\t}\n237\t\t\tb.WriteString(c.Name + \"=\" + value)\n238\t\t}\n239\t\n240\t\td.directive(\"cookie\", b.String())\n241\t\n242\t\treturn nil\n243\t}\n244\t\n245\t// body writes the request body, inline when it can be and via a temp file when\n246\t// it cannot.\n247\tfunc (d *document) body(req *request.Request) error {\n248\t\tif req.Body == nil {\n249\t\t\treturn nil\n250\t\t}\n251\t\n252\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n253\t\t\td.directive(\"header\", \"Content-Type: \"+req.Body.ContentType)\n254\t\t}\n255\t\n256\t\tif inlinable(req.Body.Data) {\n257\t\t\t// data-raw rather than data or data-binary: those two read a value\n258\t\t\t// starting with @ as a filename, and a JSON body legitimately can. Verified\n259\t\t\t// against curl 8.14.1 — data-raw sends the bytes as given and strips\n260\t\t\t// nothing, where `data = \"@path\"` also strips newlines.\n261\t\t\td.directive(\"data-raw\", string(req.Body.Data))\n262\t\t\treturn nil\n263\t\t}\n264\t\n265\t\tpath, err := d.tempFile(req.Body.Data)\n266\t\tif err != nil {\n267\t\t\treturn err\n268\t\t}\n269\t\t// The file's bytes are read verbatim, so data-binary rather than data: data\n270\t\t// strips newlines and carriage returns out of a file, which corrupts any\n271\t\t// pretty-printed JSON and breaks any signed payload.\n272\t\td.directive(\"data-binary\", \"@\"+path)\n273\t\n274\t\treturn nil\n275\t}\n276\t\n277\t// inlinable reports whether a body can live in the config document. Valid UTF-8\n278\t// under the size limit can; anything else takes the temp-file path, because a\n279\t// NUL byte truncates a quoted value and arbitrary bytes have no escape sequence\n280\t// that survives curl's parser.\n281\tfunc inlinable(data []byte) bool {\n282\t\tif len(data) > maxInlineBody || !utf8.Valid(data) {\n283\t\t\treturn false\n284\t\t}\n285\t\n286\t\treturn !strings.ContainsRune(string(data), 0)\n287\t}\n288\t\n289\t// tempFile writes data to a 0600 file and records it for cleanup.\n290\tfunc (d *document) tempFile(data []byte) (string, error) {\n291\t\tf, err := os.CreateTemp(\"\", \"talaria-body-*\")\n292\t\tif err != nil {\n293\t\t\treturn \"\", clierr.RequestFailed(\"cannot stage the request body: %w\", err)\n294\t\t}\n295\t\td.files = append(d.files, f.Name())\n296\t\n297\t\t// CreateTemp already makes the file 0600; setting it explicitly keeps that a\n298\t\t// guarantee of this code rather than of the standard library's current\n299\t\t// behaviour, since the body may carry credentials the user put in it.\n300\t\tif err := f.Chmod(0o600); err != nil {\n301\t\t\tf.Close()\n302\t\t\treturn \"\", clierr.RequestFailed(\"cannot secure the request body file: %w\", err)\n303\t\t}\n304\t\n305\t\tif _, err := f.Write(data); err != nil {\n306\t\t\tf.Close()\n307\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n308\t\t}\n309\t\n310\t\tif err := f.Close(); err != nil {\n311\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n312\t\t}\n313\t\n314\t\treturn f.Name(), nil\n315\t}\n316\t\n317\t// seconds renders a duration the way curl's timeout options read it: decimal\n318\t// seconds, with no trailing zeroes, so a sub-second bound survives the trip.\n319\tfunc seconds(d time.Duration) string {\n320\t\treturn strconv.FormatFloat(d.Seconds(), 'f', -1, 64)\n321\t}\n322\t\n323\t// directive writes one `name = \"value\"` line, escaped for curl's parser.\n324\tfunc (d *document) directive(name, value string) {\n325\t\td.b.WriteString(name + ` = \"` + escapeDirective(value) + \"\\\"\\n\")\n326\t}\n327\t\n328\t// flag writes one bare directive, the config form of a boolean option.\n329\tfunc (d *document) flag(name string) { d.b.WriteString(name + \"\\n\") }\n330\t\n331\t// discard drops a partially built document, so a failure returns nothing a\n332\t// caller could accidentally send or print.\n333\tfunc (d *document) discard() { d.b.Reset() }\n334\t\n335\t// cleanup removes the temp files this document points at.\n336\tfunc (d *document) cleanup() {\n337\t\tfor _, path := range d.files {\n338\t\t\tos.Remove(path) //nolint:errcheck // Best effort; the file is 0600 and in TMPDIR.\n339\t\t}\n340\t\td.files = nil\n341\t}\n342\t\n343\t// cleanupWith also zeroes the finished document, so the resolved credentials in\n344\t// it stop being readable from the buffer once curl has exited.\n345\tfunc (d *document) cleanupWith(config []byte) func() {\n346\t\treturn func() {\n347\t\t\td.cleanup()\n348\t\t\tfor i := range config {\n349\t\t\t\tconfig[i] = 0\n350\t\t\t}\n351\t\t}\n352\t}\n353\t\n354\t// resolve is the renderer that reads real credential values. It is the single\n355\t// crossing of the firewall described in DESIGN.md §5a: every other renderer in\n356\t// talaria produces a redacted or symbolic form, and this one exists only to\n357\t// feed the config document.\n358\tfunc resolve(v request.Value) (string, error) {\n359\t\tif !v.IsSecret() {\n360\t\t\t// Reveal rather than String: a literal the user typed under a\n361\t\t\t// credential-shaped name displays redacted everywhere else, and the\n362\t\t\t// wire is the one place it must not.\n363\t\t\treturn v.Reveal(), nil\n364\t\t}\n365\t\n366\t\tvalue, err := v.Ref().Resolve()\n367\t\tif err != nil {\n368\t\t\treturn \"\", err\n369\t\t}\n370\t\n371\t\treturn v.Prefix() + value, nil\n372\t}\n373\t\n374\t// configEscape covers the escape sequences curl's config parser understands, in\n375\t// the order a single pass must apply them. strings.Replacer scans once and\n376\t// picks the longest match at each position, which is what keeps the backslash\n377\t// rule from re-escaping the backslashes the other rules just introduced — the\n378\t// double-escaping bug that ordered sequential replaces invite.\n379\tvar configEscape = strings.NewReplacer(\n380\t\t`\\`, `\\\\`,\n381\t\t`\"`, `\\\"`,\n382\t\t\"\\t\", `\\t`,\n383\t\t\"\\n\", `\\n`,\n384\t\t\"\\r\", `\\r`,\n385\t)\n386\t\n387\tfunc escapeDirective(s string) string { return configEscape.Replace(s) }\n388\t"
      }
