        "tool_use_id": "toolu_018xPKxTq139QStJwm9m5XJL",
        "type": "tool_result",
        "content": "1\tpackage request\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"io\"\n6\t\t\"net/url\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n11\t\t\"github.com/Teeeep/talaria/internal/config\"\n12\t\t\"github.com/Teeeep/talaria/internal/operation\"\n13\t\t\"github.com/Teeeep/talaria/internal/secret\"\n14\t\t\"github.com/Teeeep/talaria/internal/spec\"\n15\t)\n16\t\n17\t// Parameter locations. Three of them are also credential locations and are\n18\t// aliased from internal/config so the two packages cannot drift; `path` is the\n19\t// one place a credential never goes, which is why config does not name it.\n20\tconst (\n21\t\tinPath   = \"path\"\n22\t\tinQuery  = config.InQuery\n23\t\tinHeader = config.InHeader\n24\t\tinCookie = config.InCookie\n25\t)\n26\t\n27\t// Inputs is everything one call needs: the operation and the document it came\n28\t// from, the resolved profile and credentials, and the raw `name=value` flag\n29\t// strings exactly as the CLI received them. Parsing them here rather than in\n30\t// cmd/ keeps the binding rules — and their error messages — testable without a\n31\t// command tree.\n32\ttype Inputs struct {\n33\t\tOp      operation.Operation\n34\t\tDoc     *spec.Document\n35\t\tProfile *config.Profile\n36\t\t// Creds are the credentials config.Resolve produced for Op. They name\n37\t\t// credentials; they never carry one.\n38\t\tCreds []config.Credential\n39\t\t// BaseURL is --base-url. It beats the profile, which beats the spec.\n40\t\tBaseURL string\n41\t\t// Params are --param name=value for parameters the operation declares, in\n42\t\t// any location.\n43\t\tParams []string\n44\t\t// Query are --query name=value, for query parameters the spec may not\n45\t\t// declare.\n46\t\tQuery []string\n47\t\t// Headers are --header name=value.\n48\t\tHeaders []string\n49\t\t// Body holds --body exactly as given: a literal, @file, or \"-\" for stdin.\n50\t\t// It is a slice so a repeated flag is a reportable mistake rather than a\n51\t\t// silent last-one-wins.\n52\t\tBody []string\n53\t\t// Stdin is the reader `--body -` consumes. It is injected rather than read\n54\t\t// from os.Stdin so the ownership rule is testable: the Go process reads the\n55\t\t// body in full before curl exists, and curl's own stdin carries the config\n56\t\t// document (DESIGN.md §5a).\n57\t\tStdin io.Reader\n58\t}\n59\t\n60\t// Build binds inputs to an operation and returns the request to make.\n61\t//\n62\t// Every binding problem is collected before returning rather than reported one\n63\t// at a time: an agent that gets \"petId is required; --header malformed\" fixes\n64\t// both in one round trip, where a fail-fast builder would cost it two.\n65\tfunc Build(in Inputs) (*Request, error) {\n66\t\tb := &binder{in: in}\n67\t\n68\t\treq := &Request{\n69\t\t\tOperationID: in.Op.ID,\n70\t\t\tMethod:      in.Op.Method,\n71\t\t\tBaseURL:     b.baseURL(),\n72\t\t}\n73\t\n74\t\tbound := b.params()\n75\t\treq.Path = b.path(bound)\n76\t\n77\t\t// Query goes through hide for the same reason headers and cookies do: §5a\n78\t\t// names query-string API keys (`?api_key=`) as a credential location, and a\n79\t\t// value's origin — spec, profile, --param or --query — does not change what\n80\t\t// the name says it is.\n81\t\treq.Query = hide(append(b.located(bound, inQuery), b.pairs(in.Query, \"--query\", nil)...))\n82\t\treq.Headers = hide(b.headers(bound))\n83\t\treq.Cookies = hide(b.located(bound, inCookie))\n84\t\t// After the headers, because the body's content type defers to a\n85\t\t// Content-Type the user set; before the credentials, which never set one.\n86\t\treq.Body = b.body(req)\n87\t\n88\t\tb.credentials(req)\n89\t\n90\t\tif err := b.err(); err != nil {\n91\t\t\treturn nil, err\n92\t\t}\n93\t\n94\t\treturn req, nil\n95\t}\n96\t\n97\t// binder accumulates the problems found while binding so they can all be\n98\t// reported together.\n99\ttype binder struct {\n100\t\tin       Inputs\n101\t\tproblems []string\n102\t\t// unknown records that some --param named a parameter the operation does\n103\t\t// not declare, so the error can carry the declared names as alternatives.\n104\t\tunknown bool\n105\t}\n106\t\n107\tfunc (b *binder) fail(format string, a ...any) {\n108\t\tb.problems = append(b.problems, clierr.Usage(format, a...).Message)\n109\t}\n110\t\n111\t// err folds the collected problems into one usage error, naming the operation\n112\t// so the message stands alone in a log.\n113\tfunc (b *binder) err() error {\n114\t\tif len(b.problems) == 0 {\n115\t\t\treturn nil\n116\t\t}\n117\t\n118\t\terr := clierr.Usage(\"cannot build a request for %s: %s\",\n119\t\t\toperationName(b.in.Op), strings.Join(b.problems, \"; \"))\n120\t\tif b.unknown {\n121\t\t\terr = err.WithAlternatives(declaredNames(b.in.Op)...)\n122\t\t}\n123\t\n124\t\treturn err\n125\t}\n126\t\n127\t// baseURL resolves where the request goes: --base-url, then the profile, then\n128\t// the spec's first server (DESIGN.md §4). A spec whose server URL is relative\n129\t// — common for specs that expect a host to be supplied — counts as no server.\n130\tfunc (b *binder) baseURL() string {\n131\t\tcandidates := []struct{ source, raw string }{\n132\t\t\t{\"--base-url\", b.in.BaseURL},\n133\t\t}\n134\t\tif b.in.Profile != nil {\n135\t\t\tcandidates = append(candidates, struct{ source, raw string }{\n136\t\t\t\t\"profile \" + b.in.Profile.Name, b.in.Profile.BaseURL})\n137\t\t}\n138\t\tcandidates = append(candidates, struct{ source, raw string }{\"the spec's servers[0].url\", firstServer(b.in.Doc)})\n139\t\n140\t\tfor _, c := range candidates {\n141\t\t\tif c.raw == \"\" {\n142\t\t\t\tcontinue\n143\t\t\t}\n144\t\n145\t\t\t// Before the parse, so a URL that fails to parse cannot have its\n146\t\t\t// userinfo quoted back by the message below.\n147\t\t\tif host, ok := Userinfo(c.raw); ok {\n148\t\t\t\tb.fail(\"base URL from %s carries a credential in its userinfo (user:password@%s); \"+\n149\t\t\t\t\t\"remove it and set %s=user:password instead, which keeps the value out of the \"+\n150\t\t\t\t\t\"request, the emitted curl and the history\", c.source, host, config.EnvBasic)\n151\t\t\t\treturn \"\"\n152\t\t\t}\n153\t\n154\t\t\tparsed, err := url.Parse(c.raw)\n155\t\t\tif err != nil || parsed.Host == \"\" || !IsHTTPScheme(parsed.Scheme) {\n156\t\t\t\tb.fail(\"base URL %q from %s is not an absolute http(s) URL\", c.raw, c.source)\n157\t\t\t\treturn \"\"\n158\t\t\t}\n159\t\n160\t\t\treturn strings.TrimSuffix(c.raw, \"/\")\n161\t\t}\n162\t\n163\t\tb.fail(\"no base URL: the spec declares no server, so pass --base-url or set one in a profile\")\n164\t\n165\t\treturn \"\"\n166\t}\n167\t\n168\t// firstServer returns the document's first server URL, or \"\" when it has none.\n169\tfunc firstServer(doc *spec.Document) string {\n170\t\tif doc == nil || doc.Model == nil || len(doc.Model.Servers) == 0 || doc.Model.Servers[0] == nil {\n171\t\t\treturn \"\"\n172\t\t}\n173\t\n174\t\treturn doc.Model.Servers[0].URL\n175\t}\n176\t\n177\t// params parses --param flags against the parameters the operation declares,\n178\t// keyed by the declared name so path substitution and location routing both\n179\t// read from one place.\n180\tfunc (b *binder) params() map[string]string {\n181\t\tdeclared := map[string]operation.Param{}\n182\t\tfor _, p := range b.in.Op.Params {\n183\t\t\tdeclared[p.Name] = p\n184\t\t}\n185\t\n186\t\tbound := map[string]string{}\n187\t\tfor i, raw := range b.in.Params {\n188\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n189\t\t\tif !ok || name == \"\" {\n190\t\t\t\t// Reported like every other rejected name=value flag: by position,\n191\t\t\t\t// with the value elided. A --param can be a query-string API key.\n192\t\t\t\tb.fail(\"--param %d is not name=value%s\", i+1, elided(raw))\n193\t\t\t\tcontinue\n194\t\t\t}\n195\t\n196\t\t\tif _, ok := declared[name]; !ok {\n197\t\t\t\tb.unknown = true\n198\t\t\t\tb.fail(\"%s declares no parameter %q\", operationName(b.in.Op), name)\n199\t\t\t\tcontinue\n200\t\t\t}\n201\t\n202\t\t\tbound[name] = value\n203\t\t}\n204\t\n205\t\t// Reported after parsing so a missing parameter and a misspelt one surface\n206\t\t// together rather than one run apart.\n207\t\tfor _, p := range b.in.Op.Params {\n208\t\t\tif _, ok := bound[p.Name]; p.Required && !ok {\n209\t\t\t\tb.fail(\"--param %s is required (%s parameter)\", p.Name, p.In)\n210\t\t\t}\n211\t\t}\n212\t\n213\t\treturn bound\n214\t}\n215\t\n216\t// path substitutes the bound path parameters into the operation's template.\n217\t//\n218\t// Values are escaped with url.PathEscape, so a value containing / or ? stays\n219\t// inside its own segment instead of rewriting the request's target — the same\n220\t// reason SQL uses placeholders rather than string concatenation.\n221\tfunc (b *binder) path(bound map[string]string) string {\n222\t\tpath := b.in.Op.Path\n223\t\tfor _, p := range b.in.Op.Params {\n224\t\t\tif p.In != inPath {\n225\t\t\t\tcontinue\n226\t\t\t}\n227\t\n228\t\t\tvalue, ok := bound[p.Name]\n229\t\t\tif !ok {\n230\t\t\t\tcontinue\n231\t\t\t}\n232\t\n233\t\t\tpath = strings.ReplaceAll(path, \"{\"+p.Name+\"}\", url.PathEscape(value))\n234\t\t}\n235\t\n236\t\t// A leftover placeholder means the spec templated a segment it never\n237\t\t// declared a parameter for; without this the request would go to a literal\n238\t\t// \"/pets/{petId}\".\n239\t\tif strings.ContainsAny(path, \"{}\") {\n240\t\t\tb.fail(\"path %q has a placeholder the operation declares no parameter for\", b.in.Op.Path)\n241\t\t}\n242\t\n243\t\treturn path\n244\t}\n245\t\n246\t// located returns the bound parameters that belong in one location, in the\n247\t// order the spec declares them so the result is stable across runs.\n248\tfunc (b *binder) located(bound map[string]string, in string) []Pair {\n249\t\tvar out []Pair\n250\t\tfor _, p := range b.in.Op.Params {\n251\t\t\tif p.In != in {\n252\t\t\t\tcontinue\n253\t\t\t}\n254\t\t\tif value, ok := bound[p.Name]; ok {\n255\t\t\t\tout = append(out, Pair{Name: p.Name, Value: Literal(value)})\n256\t\t\t}\n257\t\t}\n258\t\n259\t\treturn out\n260\t}\n261\t\n262\t// headers merges the three sources of request headers. The profile is the least\n263\t// specific and only contributes names nothing else supplied, so `--header\n264\t// X-Env=explicit` overrides a profile's X-Env instead of sending both.\n265\tfunc (b *binder) headers(bound map[string]string) []Pair {\n266\t\tout := append(b.located(bound, inHeader), b.pairs(b.in.Headers, \"--header\", httpFieldName)...)\n267\t\n268\t\tif b.in.Profile == nil {\n269\t\t\treturn out\n270\t\t}\n271\t\n272\t\tset := map[string]bool{}\n273\t\tfor _, p := range out {\n274\t\t\tset[strings.ToLower(p.Name)] = true\n275\t\t}\n276\t\n277\t\tnames := make([]string, 0, len(b.in.Profile.Headers))\n278\t\tfor name := range b.in.Profile.Headers {\n279\t\t\tnames = append(names, name)\n280\t\t}\n281\t\tsort.Strings(names)\n282\t\n283\t\tfor _, name := range names {\n284\t\t\tif !set[strings.ToLower(name)] {\n285\t\t\t\tout = append(out, Pair{Name: name, Value: Literal(b.in.Profile.Headers[name])})\n286\t\t\t}\n287\t\t}\n288\t\n289\t\treturn out\n290\t}\n291\t\n292\t// hide marks every literal sitting under a credential-shaped name — the §5a\n293\t// built-in list: Authorization, Cookie, Proxy-Authorization, *api*key*, *token*,\n294\t// *secret* — as sensitive, so it renders `<redacted>` on every surface that\n295\t// displays a Value while still going on the wire.\n296\t//\n297\t// The name is all there is to go on. talaria cannot tell a token the user typed\n298\t// into --header from an ordinary string by looking at the string, and §5a's\n299\t// answer is that it does not have to: the name decides, whether the value came\n300\t// from a spec's security scheme, a profile, a bound parameter or the flag.\n301\tfunc hide(pairs []Pair) []Pair {\n302\t\t// A nil *Redactor is the built-in list, which is the whole point here: the\n303\t\t// user-extensible patterns are a display concern the config file adds\n304\t\t// downstream, and this floor is not configurable.\n305\t\tvar builtin *secret.Redactor\n306\t\n307\t\tfor i, p := range pairs {\n308\t\t\tif !p.Value.IsSecret() && builtin.IsSensitive(p.Name) {\n309\t\t\t\tpairs[i].Value = p.Value.Sensitive()\n310\t\t\t}\n311\t\t}\n312\t\n313\t\treturn pairs\n314\t}\n315\t\n316\t// pairs parses repeatable name=value flags. Only the first = separates, because\n317\t// header and query values legitimately contain more.\n318\t//\n319\t// A rejected argument is reported by position and never by content. The shell\n320\t// expanded it before talaria saw it, so `--header \"Authorization: Bearer\n321\t// $TOKEN\"` — the form a user reaches for — holds the real token, and quoting it\n322\t// back would publish the credential in the exit-2 message on stderr. §5a puts\n323\t// error paths inside the firewall, not outside it.\n324\t//\n325\t// rule, when non-nil, is the extra constraint this flag holds its names to.\n326\tfunc (b *binder) pairs(raws []string, flag string, rule *nameRule) []Pair {\n327\t\tout := make([]Pair, 0, len(raws))\n328\t\tfor i, raw := range raws {\n329\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n330\t\t\tif !ok || name == \"\" {\n331\t\t\t\tb.fail(\"%s %d is not name=value%s\", flag, i+1, elided(raw))\n332\t\t\t\tcontinue\n333\t\t\t}\n334\t\n335\t\t\tif rule != nil && !rule.ok(name) {\n336\t\t\t\tb.fail(\"%s %d %s%s\", flag, i+1, rule.want, elided(name))\n337\t\t\t\tcontinue\n338\t\t\t}\n339\t\n340\t\t\tout = append(out, Pair{Name: name, Value: Literal(value)})\n341\t\t}\n342\t\n343\t\treturn out\n344\t}\n345\t\n346\t// nameRule constrains what the name half of a name=value flag may be. Only\n347\t// --header has one: a header name goes on the wire as an HTTP field name, while\n348\t// a query parameter name is an ordinary string an API is free to spell\n349\t// `filter[status]`.\n350\ttype nameRule struct {\n351\t\t// ok reports whether the name is usable.\n352\t\tok func(string) bool\n353\t\t// want completes \"--header 2 …\" when it is not.\n354\t\twant string\n355\t}\n356\t\n357\t// httpFieldName holds --header names to what a header name can actually be.\n358\tvar httpFieldName = &nameRule{ok: isFieldName, want: \"is not a valid HTTP header name\"}\n359\t\n360\t// fieldNameChars is the token character set an HTTP field name is drawn from\n361\t// (RFC 9110 §5.1, via §5.6.2).\n362\tconst fieldNameChars = \"!#$%&'*+-.^_`|~\" +\n363\t\t\"0123456789\" +\n364\t\t\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\" +\n365\t\t\"abcdefghijklmnopqrstuvwxyz\"\n366\t\n367\t// isFieldName reports whether name can be sent as a header name.\n368\t//\n369\t// The character that fails this in practice is the colon, from curl's `Name:\n370\t// value` form: `--header 'X-Trace: abc=1'` parses as the name \"X-Trace: abc\",\n371\t// which curl's config document renders as the malformed wire header\n372\t// `X-Trace: abc: 1`. Refusing it is the difference between a request the user\n373\t// did not write and a clean exit 2.\n374\tfunc isFieldName(name string) bool {\n375\t\tfor _, r := range name {\n376\t\t\tif !strings.ContainsRune(fieldNameChars, r) {\n377\t\t\t\treturn false\n378\t\t\t}\n379\t\t}\n380\t\n381\t\treturn name != \"\"\n382\t}\n383\t\n384\t// elided describes a rejected argument without echoing what may be a\n385\t// credential: the text before its first `=` or `:`, which is a name, and\n386\t// nothing at all when it holds neither separator — an argument with no\n387\t// separator in it is indistinguishable from a bare token. Not even a truncated\n388\t// prefix of the value: part of a credential is still part of a credential.\n389\tfunc elided(raw string) string {\n390\t\tif cut := strings.IndexAny(raw, \"=:\"); cut > 0 {\n391\t\t\treturn fmt.Sprintf(\" (it starts %q; the rest is not echoed)\", raw[:cut])\n392\t\t}\n393\t\n394\t\treturn \" (its text is not echoed)\"\n395\t}\n396\t\n397\t// credentials puts each resolved credential where its scheme says it goes, as a\n398\t// reference. This is the §5a boundary: what lands on the request is the name of\n399\t// a credential and how to encode it, never the credential.\n400\tfunc (b *binder) credentials(req *Request) {\n401\t\tfor _, cred := range b.in.Creds {\n402\t\t\tpair := Pair{Name: cred.Name, Value: Secret(cred.Ref, encodingFor(cred.Kind))}\n403\t\n404\t\t\tswitch cred.In {\n405\t\t\tcase inHeader:\n406\t\t\t\treq.Headers = append(req.Headers, pair)\n407\t\t\tcase inQuery:\n408\t\t\t\treq.Query = append(req.Query, pair)\n409\t\t\tcase inCookie:\n410\t\t\t\treq.Cookies = append(req.Cookies, pair)\n411\t\t\tdefault:\n412\t\t\t\tb.fail(\"scheme %q wants its credential in %q, which is not a place a request has\",\n413\t\t\t\t\tcred.Scheme, cred.In)\n414\t\t\t}\n415\t\t}\n416\t}\n417\t\n418\tfunc encodingFor(kind config.Kind) Encoding {\n419\t\tswitch kind {\n420\t\tcase config.KindBearer:\n421\t\t\treturn EncodeBearer\n422\t\tcase config.KindBasic:\n423\t\t\treturn EncodeBasic\n424\t\tdefault:\n425\t\t\treturn EncodeRaw\n426\t\t}\n427\t}\n428\t\n429\t// declaredNames lists the parameters the operation accepts, for the\n430\t// valid_alternatives an agent corrects itself from.\n431\tfunc declaredNames(op operation.Operation) []string {\n432\t\tnames := make([]string, 0, len(op.Params))\n433\t\tfor _, p := range op.Params {\n434\t\t\tnames = append(names, p.Name)\n435\t\t}\n436\t\n437\t\treturn names\n438\t}\n439\t\n440\t// operationName is the operation's ID, falling back to method and path for a\n441\t// spec that sets no operationId.\n442\tfunc operationName(op operation.Operation) string {\n443\t\tif op.ID != \"\" {\n444\t\t\treturn op.ID\n445\t\t}\n446\t\n447\t\treturn op.Method + \" \" + op.Path\n448\t}\n449\t"
      }
