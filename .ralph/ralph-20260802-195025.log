        "content": "1\tpackage output\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"strings\"\n8\t\t\"text/tabwriter\"\n9\t)\n10\t\n11\t// Table is the row-oriented view of a result, used by the pretty and TSV\n12\t// renderers. Commands build it alongside the JSON payload rather than letting\n13\t// each renderer reach into the data itself.\n14\ttype Table struct {\n15\t\tHeaders []string\n16\t\tRows    [][]string\n17\t}\n18\t\n19\t// Empty reports whether the table has nothing to print.\n20\tfunc (t Table) Empty() bool { return len(t.Headers) == 0 && len(t.Rows) == 0 }\n21\t\n22\t// Payload is what a command hands to a renderer: Data is serialised by the JSON\n23\t// renderer, Table is printed by the pretty and TSV renderers, JUnit is written\n24\t// by the JUnit renderer. A command fills in whichever the formats it supports\n25\t// need.\n26\ttype Payload struct {\n27\t\tData  any\n28\t\tTable Table\n29\t\tJUnit Suite\n30\t}\n31\t\n32\t// Renderer writes a payload in one output format.\n33\ttype Renderer interface {\n34\t\tRender(p Payload) error\n35\t}\n36\t\n37\t// New returns the renderer for f, writing to w.\n38\tfunc New(f Format, w io.Writer) Renderer {\n39\t\tswitch f {\n40\t\tcase FormatPretty:\n41\t\t\treturn prettyRenderer{w: w}\n42\t\tcase FormatTSV:\n43\t\t\treturn tsvRenderer{w: w}\n44\t\tcase FormatJUnit:\n45\t\t\treturn junitRenderer{w: w}\n46\t\tdefault:\n47\t\t\treturn jsonRenderer{w: w}\n48\t\t}\n49\t}\n50\t\n51\ttype jsonRenderer struct{ w io.Writer }\n52\t\n53\tfunc (r jsonRenderer) Render(p Payload) error {\n54\t\tbody, err := marshalEnvelope(p.Data)\n55\t\tif err != nil {\n56\t\t\treturn err\n57\t\t}\n58\t\n59\t\t_, err = fmt.Fprintf(r.w, \"%s\\n\", body)\n60\t\treturn err\n61\t}\n62\t\n63\t// marshalEnvelope serialises data with the versioned schema field as the first\n64\t// top-level key. Object payloads keep their fields at the top level, matching\n65\t// the shape in DESIGN.md §3.1; anything else (a bare list, a scalar) has no room\n66\t// for a sibling field and is nested under \"data\" instead.\n67\t//\n68\t// The output is deterministic: encoding/json sorts map keys, and the schema\n69\t// field is spliced in at a fixed position rather than merged through a map.\n70\tfunc marshalEnvelope(data any) ([]byte, error) {\n71\t\t// SchemaVersion is a compile-time constant with no characters needing JSON\n72\t\t// escaping, so it can be quoted directly.\n73\t\tprefix := []byte(`{\"schema\":\"` + SchemaVersion + `\"`)\n74\t\n75\t\tif data == nil {\n76\t\t\treturn append(prefix, '}'), nil\n77\t\t}\n78\t\n79\t\tbody, err := json.Marshal(data)\n80\t\tif err != nil {\n81\t\t\treturn nil, fmt.Errorf(\"rendering json output: %w\", err)\n82\t\t}\n83\t\n84\t\tif len(body) == 0 || body[0] != '{' {\n85\t\t\treturn json.Marshal(struct {\n86\t\t\t\tSchema string `json:\"schema\"`\n87\t\t\t\tData   any    `json:\"data\"`\n88\t\t\t}{SchemaVersion, data})\n89\t\t}\n90\t\n91\t\t// body[0] is '{'; drop it and splice the rest onto the prefix. json.Marshal\n92\t\t// emits no insignificant whitespace, so \"{}\" is the only empty-object form.\n93\t\tif string(body) == \"{}\" {\n94\t\t\treturn append(prefix, '}'), nil\n95\t\t}\n96\t\tout := append(prefix, ',')\n97\t\treturn append(out, body[1:]...), nil\n98\t}\n99\t\n100\ttype tsvRenderer struct{ w io.Writer }\n101\t\n102\t// Render writes one tab-separated line per row. Headers are deliberately\n103\t// omitted: TSV exists to be cut, awk'd and piped, and a header line would have\n104\t// to be skipped by every consumer. Use --output json for labelled fields.\n105\tfunc (r tsvRenderer) Render(p Payload) error {\n106\t\tvar b strings.Builder\n107\t\tfor _, row := range p.Table.Rows {\n108\t\t\tb.WriteString(strings.Join(row, \"\\t\"))\n109\t\t\tb.WriteByte('\\n')\n110\t\t}\n111\t\n112\t\t_, err := io.WriteString(r.w, b.String())\n113\t\treturn err\n114\t}\n115\t\n116\ttype prettyRenderer struct{ w io.Writer }\n117\t\n118\t// Render prints a column-aligned table. A payload with no table has no human\n119\t// shape to print, so it falls back to JSON rather than emitting nothing.\n120\tfunc (r prettyRenderer) Render(p Payload) error {\n121\t\tif p.Table.Empty() {\n122\t\t\treturn jsonRenderer{w: r.w}.Render(p)\n123\t\t}\n124\t\n125\t\ttw := tabwriter.NewWriter(r.w, 0, 0, 2, ' ', 0)\n126\t\tif len(p.Table.Headers) > 0 {\n127\t\t\tfmt.Fprintln(tw, strings.Join(p.Table.Headers, \"\\t\"))\n128\t\t}\n129\t\tfor _, row := range p.Table.Rows {\n130\t\t\tfmt.Fprintln(tw, strings.Join(row, \"\\t\"))\n131\t\t}\n132\t\treturn tw.Flush()\n133\t}\n134\t"
