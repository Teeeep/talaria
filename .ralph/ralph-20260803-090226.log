  "type": "user",
  "message": {
    "role": "user",
    "content": [
      {
        "tool_use_id": "toolu_01Cq7CEpJzuy4oFw5eR2kgn5",
        "type": "tool_result",
        "content": "1\t// Package curl turns a bound request into curl: the displayable command\n2\t// `--dry-run` prints and every executed call reports, the config document curl\n3\t// actually reads, and the executor that spawns it (DESIGN.md §3.4).\n4\t//\n5\t// This file is symbolic. It reads request.Value's Symbolic and redacted forms\n6\t// and never calls SecretRef.Resolve, so an emitted command references\n7\t// $TALARIA_AUTH_BEARER rather than a token: \"runnable in a shell where the env\n8\t// var is set, useless to exfiltrate\" (§5a). Resolution happens in exactly one\n9\t// place, config.go's resolve, and nothing outside this package can reach it.\n10\tpackage curl\n11\t\n12\timport (\n13\t\t\"net/http\"\n14\t\t\"net/url\"\n15\t\t\"regexp\"\n16\t\t\"strings\"\n17\t\n18\t\t\"github.com/Teeeep/talaria/internal/request\"\n19\t)\n20\t\n21\t// Render returns the curl command that reproduces req: a portable, symbolic\n22\t// reproduction for bug reports, docs and scripts (§3.4).\n23\t//\n24\t// The URL comes last, the way the design's sketch and most hand-written curl\n25\t// put it, so a reader sees what is being called without scanning past the\n26\t// flags.\n27\tfunc Render(req *request.Request) string {\n28\t\tif req == nil {\n29\t\t\treturn \"\"\n30\t\t}\n31\t\n32\t\t// -q mirrors the executed command (config.go's argv), so a pasted\n33\t\t// reproduction behaves like the call talaria made rather than like the\n34\t\t// reader's ~/.curlrc — which would otherwise apply its directives to a\n35\t\t// request the reader has just expanded a real credential into.\n36\t\targs := []string{\"curl\", \"-q\", \"-s\"}\n37\t\tswitch {\n38\t\t// -I rather than -X HEAD, matching the config document: pasted, -X HEAD waits\n39\t\t// for a body the server never sends, so the reproduction would hang where the\n40\t\t// call it reproduces did not.\n41\t\tcase strings.EqualFold(req.Method, http.MethodHead):\n42\t\t\targs = append(args, \"-I\")\n43\t\t// Naming GET is noise only while curl's default is what actually goes out.\n44\t\t// A body changes that: --data-raw makes curl send POST unless the method is\n45\t\t// named, and the config document the real call reads always writes\n46\t\t// `request = \"GET\"` (config.go's build). Left out, the printed command would\n47\t\t// send a different method than the call it reproduces. Anything else is\n48\t\t// worth seeing, and for a mutation it is the most important token in the\n49\t\t// line.\n50\t\tcase req.Method != \"\" && !(strings.EqualFold(req.Method, http.MethodGet) && req.Body == nil):\n51\t\t\targs = append(args, \"-X\", req.Method)\n52\t\t}\n53\t\n54\t\targs = append(args, headerArgs(req)...)\n55\t\tif cookies := cookieWord(req); cookies != nil {\n56\t\t\targs = append(args, \"-b\", cookies.String())\n57\t\t}\n58\t\targs = append(args, bodyArgs(req)...)\n59\t\targs = append(args, urlWord(req, request.Value.Symbolic).String())\n60\t\n61\t\treturn strings.Join(args, \" \")\n62\t}\n63\t\n64\t// URL renders req's URL the way a reader consumes it: percent-encoded like the\n65\t// wire form, but with credentials shown as <redacted:env:NAME> rather than\n66\t// percent-encoded into illegibility. It is what the `request.url` field of\n67\t// call's output carries (§5a: symbolic in emitted curl, redacted in output URL\n68\t// fields).\n69\t//\n70\t// request.Request.URL is the wire-correct counterpart, and is what the executor\n71\t// uses once it has resolved the credentials.\n72\tfunc URL(req *request.Request) string {\n73\t\tif req == nil {\n74\t\t\treturn \"\"\n75\t\t}\n76\t\n77\t\treturn urlWord(req, request.Value.String).plain()\n78\t}\n79\t\n80\t// headerArgs renders the request headers, with basic auth diverted to curl's\n81\t// own -u.\n82\tfunc headerArgs(req *request.Request) []string {\n83\t\tvar args []string\n84\t\tfor _, h := range req.Headers {\n85\t\t\t// A basic-auth header's text is base64(user:password), which cannot be\n86\t\t\t// produced without the credential. -u takes the raw user:password, so\n87\t\t\t// the command stays symbolic and still works when it is pasted.\n88\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n89\t\t\t\targs = append(args, \"-u\", (&word{}).credential(h.Value.Ref().Symbolic(), h.Value).String())\n90\t\t\t\tcontinue\n91\t\t\t}\n92\t\n93\t\t\targs = append(args, \"-H\", (&word{}).literal(h.Name+\": \").value(h.Value).String())\n94\t\t}\n95\t\n96\t\treturn args\n97\t}\n98\t\n99\t// cookieWord renders every cookie into one -b argument. curl keeps only the\n100\t// last -b of several, so the cookies are joined rather than repeated.\n101\tfunc cookieWord(req *request.Request) *word {\n102\t\tif len(req.Cookies) == 0 {\n103\t\t\treturn nil\n104\t\t}\n105\t\n106\t\tw := &word{}\n107\t\tfor i, c := range req.Cookies {\n108\t\t\tif i > 0 {\n109\t\t\t\tw.literal(\"; \")\n110\t\t\t}\n111\t\t\tw.literal(c.Name + \"=\").value(c.Value)\n112\t\t}\n113\t\n114\t\treturn w\n115\t}\n116\t\n117\t// bodyArgs renders the request body and the content type that describes it.\n118\t// --data-raw rather than --data or --data-binary, matching the config document\n119\t// for the same reason (config.go's body): those two read a value starting with\n120\t// @ as a filename, so the emitted command would read a local file and send it\n121\t// to the API where the call sent the text. --data also strips newlines, which\n122\t// changes the bytes a signed or whitespace-sensitive payload carries.\n123\tfunc bodyArgs(req *request.Request) []string {\n124\t\tif req.Body == nil {\n125\t\t\treturn nil\n126\t\t}\n127\t\n128\t\tvar args []string\n129\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n130\t\t\targs = append(args, \"-H\", (&word{}).literal(\"Content-Type: \"+req.Body.ContentType).String())\n131\t\t}\n132\t\n133\t\treturn append(args, \"--data-raw\", (&word{}).literal(string(req.Body.Data)).String())\n134\t}\n135\t\n136\tfunc hasHeader(req *request.Request, name string) bool {\n137\t\tfor _, h := range req.Headers {\n138\t\t\tif strings.EqualFold(h.Name, name) {\n139\t\t\t\treturn true\n140\t\t\t}\n141\t\t}\n142\t\n143\t\treturn false\n144\t}\n145\t\n146\t// urlWord builds the request URL as one shell word. render chooses how a\n147\t// credential in the query string appears — Symbolic for the emitted command,\n148\t// String for the redacted display form.\n149\t//\n150\t// Literal values are percent-encoded here rather than by request.QueryString\n151\t// because a percent-encoded $NAME would no longer be a reference the shell can\n152\t// expand. Encoding per value, instead of over the finished string, is what lets\n153\t// the two live in one URL.\n154\tfunc urlWord(req *request.Request, render func(request.Value) string) *word {\n155\t\tw := (&word{}).literal(req.BaseURL + req.Path)\n156\t\n157\t\tfor i, q := range req.Query {\n158\t\t\tseparator := \"&\"\n159\t\t\tif i == 0 {\n160\t\t\t\tseparator = \"?\"\n161\t\t\t}\n162\t\t\tw.literal(separator + url.QueryEscape(q.Name) + \"=\")\n163\t\n164\t\t\t// Sensitive rather than secret: a literal hidden by name has no value to\n165\t\t\t// render here either, and percent-encoding its placeholder would print\n166\t\t\t// %3Credacted%3E where a reader expects <redacted>. Skipping the encode\n167\t\t\t// is safe because render is Symbolic or String — display forms, never a\n168\t\t\t// resolving renderer.\n169\t\t\tif q.Value.IsSensitive() {\n170\t\t\t\tw.credential(render(q.Value), q.Value)\n171\t\t\t\tcontinue\n172\t\t\t}\n173\t\t\tw.literal(url.QueryEscape(q.Value.String()))\n174\t\t}\n175\t\n176\t\treturn w\n177\t}\n178\t\n179\t// shellName matches an environment variable name a shell will expand from a\n180\t// bare $NAME. A ref whose name is not one of these is rendered redacted\n181\t// instead: an emitted command that stops being copy-pasteable is a better\n182\t// outcome than one that expands into something unintended.\n183\tvar shellName = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]*$`)\n184\t\n185\t// part is one piece of a shell word. expand marks the pieces the shell is\n186\t// meant to act on — the credential references, and nothing else.\n187\ttype part struct {\n188\t\ttext   string\n189\t\texpand bool\n190\t}\n191\t\n192\t// word is one argument of the rendered command, assembled from literal text and\n193\t// credential references.\n194\t//\n195\t// The quoting rule follows from what each word contains. A word of pure literal\n196\t// text is single-quoted, which needs no escaping beyond the quote itself and\n197\t// leaves every $ and backtick inert. A word carrying a reference has to be\n198\t// double-quoted so the shell expands it, so its literal parts are escaped\n199\t// against the four characters double quotes still interpret.\n200\ttype word struct{ parts []part }\n201\t\n202\tfunc (w *word) literal(s string) *word {\n203\t\tif s != \"\" {\n204\t\t\tw.parts = append(w.parts, part{text: s})\n205\t\t}\n206\t\n207\t\treturn w\n208\t}\n209\t\n210\t// value appends a request value: the reference symbolically, or the literal\n211\t// text for a literal value.\n212\tfunc (w *word) value(v request.Value) *word {\n213\t\tif v.IsSecret() {\n214\t\t\treturn w.credential(v.Symbolic(), v)\n215\t\t}\n216\t\n217\t\treturn w.literal(v.String())\n218\t}\n219\t\n220\t// credential appends a rendered credential, marking it for expansion only when\n221\t// the shell can actually expand it back into the value. A basic-auth value, a\n222\t// redacted rendering, or a ref from a source that is not the environment all\n223\t// render as inert text.\n224\tfunc (w *word) credential(rendered string, v request.Value) *word {\n225\t\tif rendered == v.String() || !shellName.MatchString(v.Ref().Name) {\n226\t\t\treturn w.literal(rendered)\n227\t\t}\n228\t\n229\t\tw.parts = append(w.parts, part{text: rendered, expand: true})\n230\t\n231\t\treturn w\n232\t}\n233\t\n234\t// plain returns the word's text with no quoting, for the display fields that\n235\t// are read rather than run.\n236\tfunc (w *word) plain() string {\n237\t\tvar b strings.Builder\n238\t\tfor _, p := range w.parts {\n239\t\t\tb.WriteString(p.text)\n240\t\t}\n241\t\n242\t\treturn b.String()\n243\t}\n244\t\n245\t// String returns the word quoted for a shell.\n246\tfunc (w *word) String() string {\n247\t\texpands := false\n248\t\tfor _, p := range w.parts {\n249\t\t\tif p.expand {\n250\t\t\t\texpands = true\n251\t\t\t\tbreak\n252\t\t\t}\n253\t\t}\n254\t\n255\t\tif !expands {\n256\t\t\treturn \"'\" + strings.ReplaceAll(w.plain(), \"'\", `'\\''`) + \"'\"\n257\t\t}\n258\t\n259\t\tvar b strings.Builder\n260\t\tb.WriteByte('\"')\n261\t\tfor _, p := range w.parts {\n262\t\t\tif p.expand {\n263\t\t\t\tb.WriteString(p.text)\n264\t\t\t\tcontinue\n265\t\t\t}\n266\t\t\tb.WriteString(escapeInDoubleQuotes(p.text))\n267\t\t}\n268\t\tb.WriteByte('\"')\n269\t\n270\t\treturn b.String()\n271\t}\n272\t\n273\t// doubleQuoted escapes the characters a shell still interprets inside double\n274\t// quotes: command substitution, variable expansion, the quote itself and the\n275\t// escape.\n276\tvar doubleQuoted = strings.NewReplacer(\n277\t\t`\\`, `\\\\`,\n278\t\t`\"`, `\\\"`,\n279\t\t\"`\", \"\\\\`\",\n280\t\t`$`, `\\$`,\n281\t)\n282\t\n283\tfunc escapeInDoubleQuotes(s string) string { return doubleQuoted.Replace(s) }\n284\t"
      }
    ]
  },
