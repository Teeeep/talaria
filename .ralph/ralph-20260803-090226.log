mistake worth naming rather than resolving by\n50\t\t// last-one-wins: the two values are usually a literal and a file, and\n51\t\t// silently dropping one of them sends a request the user did not write.\n52\t\t//\n53\t\t// What it is named by is the count and the kind of each value, never the\n54\t\t// values themselves. A request body is where a client_secret or a password\n55\t\t// travels, so joining them into an error message would put credentials on\n56\t\t// stderr — the §5a firewall covers error paths too.\n57\t\tif len(b.in.Body) > 1 {\n58\t\t\tkinds := make([]string, 0, len(b.in.Body))\n59\t\t\tfor _, raw := range b.in.Body {\n60\t\t\t\tkinds = append(kinds, bodyKind(raw))\n61\t\t\t}\n62\t\n63\t\t\tb.fail(\"--body was given %d times (%s); a request has one body\",\n64\t\t\t\tlen(b.in.Body), strings.Join(kinds, \", \"))\n65\t\t\treturn nil, false\n66\t\t}\n67\t\n68\t\traw := b.in.Body[0]\n69\t\tswitch {\n70\t\tcase raw == stdinFlag:\n71\t\t\treturn b.stdinBody()\n72\t\tcase strings.HasPrefix(raw, fileFlagPrefix):\n73\t\t\treturn b.fileBody(strings.TrimPrefix(raw, fileFlagPrefix))\n74\t\tdefault:\n75\t\t\treturn []byte(raw), true\n76\t\t}\n77\t}\n78\t\n79\t// bodyKind names which of the three sources a --body value is, so a message can\n80\t// tell the user which of their bodies is which without quoting any of them.\n81\t// A file's path is elided along with the bytes: it is chosen by the same\n82\t// command line and can name the secret it holds.\n83\tfunc bodyKind(raw string) string {\n84\t\tswitch {\n85\t\tcase raw == stdinFlag:\n86\t\t\treturn \"stdin\"\n87\t\tcase strings.HasPrefix(raw, fileFlagPrefix):\n88\t\t\treturn \"@file\"\n89\t\tdefault:\n90\t\t\treturn \"literal\"\n91\t\t}\n92\t}\n93\t\n94\t// stdinBody reads the process's standard input to EOF.\n95\tfunc (b *binder) stdinBody() ([]byte, bool) {\n96\t\tif b.in.Stdin == nil {\n97\t\t\tb.fail(\"--body %s reads the request body from stdin, but this process has no stdin to read\",\n98\t\t\t\tstdinFl