        "tool_use_id": "toolu_01Vk3Nny7WkfDSQBqzWHCaDU",
        "type": "tool_result",
        "content": "1\t// Package clierr carries talaria's exit-code contract. Every failure that\n2\t// reaches the command line is an *Error holding one of the codes from\n3\t// DESIGN.md §4, so the mapping lives in one place rather than being rederived\n4\t// at each call site. Agents branch on these codes, and code 5 in particular\n5\t// exists so an agent can tell a human \"set $NAME\" instead of guessing.\n6\tpackage clierr\n7\t\n8\timport (\n9\t\t\"encoding/json\"\n10\t\t\"errors\"\n11\t\t\"fmt\"\n12\t\t\"io\"\n13\t\n14\t\t\"github.com/Teeeep/talaria/internal/output\"\n15\t)\n16\t\n17\t// Code is a process exit code. The values are the contract in DESIGN.md §4 and\n18\t// are part of talaria's public interface: changing one is a breaking change.\n19\ttype Code int\n20\t\n21\tconst (\n22\t\t// CodeOK reports success. For call, an HTTP 4xx/5xx is still a successful\n23\t\t// observation and exits 0; --fail-on-error changes that.\n24\t\tCodeOK Code = 0\n25\t\t// CodeRequestFailed reports that the request could not be completed at all\n26\t\t// (network failure, curl itself failing). It is also the fallback for any\n27\t\t// error that was never classified.\n28\t\tCodeRequestFailed Code = 1\n29\t\t// CodeUsage reports a bad invocation: unknown operation, missing required\n30\t\t// parameter, unparseable flag value.\n31\t\tCodeUsage Code = 2\n32\t\t// CodeSpecLoad reports that the OpenAPI/Swagger spec could not be read or\n33\t\t// parsed.\n34\t\tCodeSpecLoad Code = 3\n35\t\t// CodeValidation reports that a response violates the spec. Only reachable\n36\t\t// with --fail-on-error or run.\n37\t\tCodeValidation Code = 4\n38\t\t// CodeCredentialMissing reports that a required security scheme has no\n39\t\t// credential. It is distinct from CodeUsage precisely so an agent can act on\n40\t\t// it by asking a human to set the named variable.\n41\t\tCodeCredentialMissing Code = 5\n42\t)\n43\t\n44\t// Error is a failure carrying the exit code talaria will exit with, plus the\n45\t// alternatives that would have been valid. It implements error and Unwrap, so\n46\t// callers may add context with fmt.Errorf(\"%w\") without losing the code.\n47\ttype Error struct {\n48\t\tCode    Code\n49\t\tMessage string\n50\t\t// Alternatives are the values that would have been accepted, rendered as\n51\t\t// error.valid_alternatives (§3.1: \"what failed, why, valid alternatives\").\n52\t\tAlternatives []string\n53\t\n54\t\terr error\n55\t}\n56\t\n57\tfunc (e *Error) Error() string { return e.Message }\n58\t\n59\t// Unwrap exposes the error passed to the constructor via %w, keeping errors.Is\n60\t// working through the classification.\n61\tfunc (e *Error) Unwrap() error { return e.err }\n62\t\n63\t// WithAlternatives attaches the valid values for the thing that failed and\n64\t// returns e, so it can be chained onto a constructor.\n65\tfunc (e *Error) WithAlternatives(alts ...string) *Error {\n66\t\te.Alternatives = alts\n67\t\treturn e\n68\t}\n69\t\n70\t// Usage reports a bad invocation (exit 2).\n71\tfunc Usage(format string, a ...any) *Error { return newError(CodeUsage, format, a...) }\n72\t\n73\t// SpecLoad reports a spec that could not be read or parsed (exit 3).\n74\tfunc SpecLoad(format string, a ...any) *Error { return newError(CodeSpecLoad, format, a...) }\n75\t\n76\t// Validation reports a response that violates the spec (exit 4).\n77\tfunc Validation(format string, a ...any) *Error { return newError(CodeValidation, format, a...) }\n78\t\n79\t// CredentialMissing reports a required security scheme with no credential\n80\t// (exit 5).\n81\tfunc CredentialMissing(format string, a ...any) *Error {\n82\t\treturn newError(CodeCredentialMissing, format, a...)\n83\t}\n84\t\n85\t// RequestFailed reports a request that could not be completed (exit 1).\n86\tfunc RequestFailed(format string, a ...any) *Error { return newError(CodeRequestFailed, format, a...) }\n87\t\n88\t// newError formats the message through fmt.Errorf so constructors accept %w and\n89\t// keep the wrapped error reachable by errors.Is.\n90\tfunc newError(code Code, format string, a ...any) *Error {\n91\t\tformatted := fmt.Errorf(format, a...)\n92\t\treturn &Error{\n93\t\t\tCode:    code,\n94\t\t\tMessage: formatted.Error(),\n95\t\t\terr:     errors.Unwrap(formatted),\n96\t\t}\n97\t}\n98\t\n99\t// From converts any error into an *Error so every failure path renders the same\n100\t// shape. An error that is or wraps an *Error keeps its code; anything else was\n101\t// never classified and falls back to CodeRequestFailed. From(nil) is nil.\n102\tfunc From(err error) *Error {\n103\t\tif err == nil {\n104\t\t\treturn nil\n105\t\t}\n106\t\n107\t\tvar target *Error\n108\t\tif errors.As(err, &target) {\n109\t\t\treturn target\n110\t\t}\n111\t\n112\t\treturn &Error{Code: CodeRequestFailed, Message: err.Error(), err: err}\n113\t}\n114\t\n115\t// renderable is the stderr JSON shape: the same versioned envelope as stdout,\n116\t// with the failure under \"error\".\n117\ttype renderable struct {\n118\t\tSchema string        `json:\"schema\"`\n119\t\tError  renderableErr `json:\"error\"`\n120\t}\n121\t\n122\ttype renderableErr struct {\n123\t\tCode         Code     `json:\"code\"`\n124\t\tMessage      string   `json:\"message\"`\n125\t\tAlternatives []string `json:\"valid_alternatives,omitempty\"`\n126\t}\n127\t\n128\t// Render writes err to w as one line of structured JSON. A nil error writes\n129\t// nothing. The payload contains only strings and an int, so marshalling cannot\n130\t// fail; a failed write to stderr is not itself reportable and is dropped.\n131\tfunc Render(w io.Writer, err error) {\n132\t\tcerr := From(err)\n133\t\tif cerr == nil {\n134\t\t\treturn\n135\t\t}\n136\t\n137\t\tbody, marshalErr := json.Marshal(renderable{\n138\t\t\tSchema: output.SchemaVersion,\n139\t\t\tError: renderableErr{\n140\t\t\t\tCode:         cerr.Code,\n141\t\t\t\tMessage:      cerr.Message,\n142\t\t\t\tAlternatives: cerr.Alternatives,\n143\t\t\t},\n144\t\t})\n145\t\tif marshalErr != nil {\n146\t\t\treturn\n147\t\t}\n148\t\n149\t\tfmt.Fprintf(w, \"%s\\n\", body)\n150\t}\n151\t"
      }
    ]
