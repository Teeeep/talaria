        "type": "tool_result",
        "content": "1\t// Package output renders command results in the three shapes talaria speaks:\n2\t// machine-readable JSON carrying a versioned schema field, aligned pretty text\n3\t// for humans, and bare TSV for shell pipelines (DESIGN.md §3.1).\n4\tpackage output\n5\t\n6\timport (\n7\t\t\"fmt\"\n8\t\t\"io\"\n9\t\t\"os\"\n10\t\t\"strings\"\n11\t)\n12\t\n13\t// SchemaVersion is the value of the top-level \"schema\" field on every JSON\n14\t// payload. Agent prompts key off it, so it changes only on a breaking change to\n15\t// the output shape.\n16\tconst SchemaVersion = \"talaria/v1\"\n17\t\n18\t// Format is an output rendering mode selected by --output.\n19\ttype Format string\n20\t\n21\tconst (\n22\t\tFormatJSON   Format = \"json\"\n23\t\tFormatPretty Format = \"pretty\"\n24\t\tFormatTSV    Format = \"tsv\"\n25\t)\n26\t\n27\t// formats lists every valid Format in the order shown to users.\n28\tvar formats = []Format{FormatJSON, FormatPretty, FormatTSV}\n29\t\n30\t// Formats returns every valid --output value, in the order shown to users.\n31\t// Callers rendering a structured usage error need the list as data, not as\n32\t// prose inside ParseFormat's message. The returned slice is a copy.\n33\tfunc Formats() []string { return names(formats) }\n34\t\n35\t// names renders a list of formats as the strings a user types.\n36\tfunc names(fs []Format) []string {\n37\t\tvalid := make([]string, len(fs))\n38\t\tfor i, f := range fs {\n39\t\t\tvalid[i] = string(f)\n40\t\t}\n41\t\treturn valid\n42\t}\n43\t\n44\t// ParseFormat converts a --output value into a Format. The error names every\n45\t// valid value so an agent can correct itself without reading the help text.\n46\tfunc ParseFormat(s string) (Format, error) { return parseFormat(\"output\", s, formats) }\n47\t\n48\t// parseFormat resolves s against valid. Kind names the flag being parsed, so a\n49\t// rejected --report says \"report format\" and points at the values --report\n50\t// takes rather than at --output's shorter list.\n51\tfunc parseFormat(kind, s string, valid []Format) (Format, error) {\n52\t\tfor _, f := range valid {\n53\t\t\tif Format(s) == f {\n54\t\t\t\treturn f, nil\n55\t\t\t}\n56\t\t}\n57\t\n58\t\treturn \"\", fmt.Errorf(\"unknown %s format %q: valid values are %s\", kind, s, strings.Join(names(valid), \", \"))\n59\t}\n60\t\n61\t// Resolve picks the output format. An explicit --output value always wins; with\n62\t// no explicit value the default is pretty on a terminal and JSON when piped,\n63\t// because piped output is being read by a program.\n64\tfunc Resolve(explicit string, isTTY bool) (Format, error) {\n65\t\tif explicit != \"\" {\n66\t\t\treturn ParseFormat(explicit)\n67\t\t}\n68\t\tif isTTY {\n69\t\t\treturn FormatPretty, nil\n70\t\t}\n71\t\treturn FormatJSON, nil\n72\t}\n73\t\n74\t// IsTTY reports whether w is a character device, i.e. an interactive terminal.\n75\t// A writer that is not an *os.File (a test buffer, a pipe wrapper) is never a\n76\t// TTY, so tests and pipelines both land on the machine-readable default.\n77\tfunc IsTTY(w io.Writer) bool {\n78\t\tf, ok := w.(*os.File)\n79\t\tif !ok {\n80\t\t\treturn false\n81\t\t}\n82\t\n83\t\tinfo, err := f.Stat()\n84\t\tif err != nil {\n85\t\t\treturn false\n86\t\t}\n87\t\treturn info.Mode()&os.ModeCharDevice != 0\n88\t}\n89\t"
      }
