      {
        "tool_use_id": "toolu_011tAwVS9w6jSX593gMDyLaY",
        "type": "tool_result",
        "content": "1\tpackage gen\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"os\"\n8\t\t\"path/filepath\"\n9\t\t\"strconv\"\n10\t\t\"strings\"\n11\t\n12\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n13\t\t\"github.com/Teeeep/talaria/internal/operation\"\n14\t\t\"github.com/pb33f/libopenapi/datamodel/high/base\"\n15\t)\n16\t\n17\t// Fixture is one operation's test data as written on disk, in\n18\t// `<fixtures-dir>/<operationId>.json`. Every field is optional: a fixture that\n19\t// only pins the path id and leaves the body to generation is the common case.\n20\ttype Fixture struct {\n21\t\t// Params supply declared parameters by name, in any location. Values are\n22\t\t// scalars; they are rendered to text the way they will travel on the wire.\n23\t\tParams map[string]any `json:\"params\"`\n24\t\t// Headers are sent verbatim, and need not be declared by the spec — a\n25\t\t// tenant or trace header the API expects but the document never mentions is\n26\t\t// exactly what this is for.\n27\t\tHeaders map[string]string `json:\"headers\"`\n28\t\t// Body is kept raw so a fixture reaches the server as the author wrote it,\n29\t\t// rather than round-tripped through a Go value.\n30\t\tBody json.RawMessage `json:\"body\"`\n31\t}\n32\t\n33\t// Fixtures is a loaded --fixtures directory, keyed by operationId. The zero\n34\t// value and a nil *Fixtures are both usable and empty, which is what `run`\n35\t// holds when the flag is unset.\n36\ttype Fixtures struct {\n37\t\tdir  string\n38\t\tbyID map[string]Fixture\n39\t}\n40\t\n41\t// LoadFixtures reads every `*.json` file in dir into a set keyed by the file's\n42\t// base name. An empty path is not an error — it is an unset --fixtures flag —\n43\t// and yields an empty set, so `run` builds the priority chain the same way with\n44\t// or without the flag.\n45\t//\n46\t// The whole directory is read once, up front. A fixture that only fails to\n47\t// parse on the operation that happens to need it would report a typo halfway\n48\t// through a suite, after real requests have already gone out.\n49\tfunc LoadFixtures(dir string) (*Fixtures, error) {\n50\t\tfx := &Fixtures{dir: dir, byID: map[string]Fixture{}}\n51\t\tif dir == \"\" {\n52\t\t\treturn fx, nil\n53\t\t}\n54\t\n55\t\tentries, err := os.ReadDir(dir)\n56\t\tif err != nil {\n57\t\t\treturn nil, clierr.Usage(\"reading fixtures directory %s: %w\", dir, err)\n58\t\t}\n59\t\n60\t\tfor _, entry := range entries {\n61\t\t\tname := entry.Name()\n62\t\t\tif entry.IsDir() || !strings.EqualFold(filepath.Ext(name), \".json\") {\n63\t\t\t\tcontinue\n64\t\t\t}\n65\t\n66\t\t\tpath := filepath.Join(dir, name)\n67\t\t\tdata, err := os.ReadFile(path)\n68\t\t\tif err != nil {\n69\t\t\t\treturn nil, clierr.Usage(\"reading fixture %s: %w\", path, err)\n70\t\t\t}\n71\t\n72\t\t\tvar f Fixture\n73\t\t\tif err := json.Unmarshal(data, &f); err != nil {\n74\t\t\t\treturn nil, clierr.Usage(\"parsing fixture %s: %w\", path, err)\n75\t\t\t}\n76\t\n77\t\t\tfx.byID[strings.TrimSuffix(name, filepath.Ext(name))] = f\n78\t\t}\n79\t\n80\t\treturn fx, nil\n81\t}\n82\t\n83\t// Get returns the fixture for an operationId, and whether there was one.\n84\tfunc (f *Fixtures) Get(id string) (Fixture, bool) {\n85\t\tif f == nil {\n86\t\t\treturn Fixture{}, false\n87\t\t}\n88\t\n89\t\tfixture, ok := f.byID[id]\n90\t\n91\t\treturn fixture, ok\n92\t}\n93\t\n94\t// Len is how many fixtures were loaded.\n95\tfunc (f *Fixtures) Len() int {\n96\t\tif f == nil {\n97\t\t\treturn 0\n98\t\t}\n99\t\n100\t\treturn len(f.byID)\n101\t}\n102\t\n103\t// Data is one operation's request data: what to bind to its declared\n104\t// parameters, what extra headers to send, and the body, JSON-encoded and nil\n105\t// when there is none.\n106\ttype Data struct {\n107\t\t// Params are declared parameters by name, already rendered as text, ready\n108\t\t// for request.Inputs.Params.\n109\t\tParams map[string]string\n110\t\t// Headers are fixture-supplied headers, ready for request.Inputs.Headers.\n111\t\tHeaders map[string]string\n112\t\t// Body is the encoded request body, or nil.\n113\t\tBody []byte\n114\t\t// ContentType is the media type Body was generated as, and empty when there\n115\t\t// is no body. The caller sends it: the operation's own `content` map cannot\n116\t\t// be trusted to describe these bytes, because generation encodes JSON\n117\t\t// whatever media types the document declares.\n118\t\tContentType string\n119\t}\n120\t\n121\t// DataFor returns the request data for one operation, applying the DESIGN.md\n122\t// §5a priority chain: a spec example, then a fixture, then generation.\n123\t//\n124\t// This is the only entry point that decides the order, so `run` cannot get it\n125\t// wrong by assembling the pieces itself. The chain runs per field rather than\n126\t// per request — an example on one parameter beats the fixture for that\n127\t// parameter while the fixture still supplies the next — because a spec that\n128\t// documents one id and a fixture that supplies the rest is the normal case, not\n129\t// a conflict to resolve wholesale.\n130\tfunc (g *Generator) DataFor(op operation.Operation) Data {\n131\t\tfixture, _ := g.Fixtures.Get(op.ID)\n132\t\n133\t\tbody, contentType := g.bodyFor(op, fixture)\n134\t\tdata := Data{\n135\t\t\tParams:      make(map[string]string, len(op.Params)),\n136\t\t\tHeaders:     make(map[string]string, len(fixture.Headers)),\n137\t\t\tBody:        body,\n138\t\t\tContentType: contentType,\n139\t\t}\n140\t\n141\t\tfor name, value := range fixture.Headers {\n142\t\t\tdata.Headers[name] = value\n143\t\t}\n144\t\n145\t\tfor _, p := range op.Params {\n146\t\t\tif v, ok := g.paramValue(p, fixture); ok {\n147\t\t\t\tdata.Params[p.Name] = scalarString(v)\n148\t\t\t}\n149\t\t}\n150\t\n151\t\t// Fixture parameters the operation does not declare are passed through\n152\t\t// rather than dropped: the request builder reports an unknown parameter by\n153\t\t// name, which is a better answer to a typo than a value that silently never\n154\t\t// arrives.\n155\t\tfor name, value := range fixture.Params {\n156\t\t\tif _, ok := data.Params[name]; !ok {\n157\t\t\t\tdata.Params[name] = scalarString(value)\n158\t\t\t}\n159\t\t}\n160\t\n161\t\treturn data\n162\t}\n163\t\n164\t// paramValue resolves one parameter through the chain, reporting whether it\n165\t// found anything at all.\n166\t//\n167\t// An optional parameter with no example and no fixture is deliberately left\n168\t// out. Generating one means a smoke test filtering on an invented cursor or\n169\t// searching for a made-up name, which tests the API's error handling rather\n170\t// than the operation. A required one is always supplied: a request the server\n171\t// rejects for a missing parameter never reaches the behaviour under test.\n172\tfunc (g *Generator) paramValue(p operation.Param, fixture Fixture) (any, bool) {\n173\t\tif p.Schema != nil {\n174\t\t\tif s := p.Schema.Schema(); s != nil {\n175\t\t\t\tif v, ok := exampleValue(s); ok {\n176\t\t\t\t\treturn v, true\n177\t\t\t\t}\n178\t\t\t}\n179\t\t}\n180\t\n181\t\tif v, ok := fixture.Params[p.Name]; ok {\n182\t\t\treturn v, true\n183\t\t}\n184\t\n185\t\tif !p.Required {\n186\t\t\treturn nil, false\n187\t\t}\n188\t\n189\t\treturn g.value(p.Schema, 0, make(map[string]int))\n190\t}\n191\t\n192\t// bodyFor resolves the request body through the same chain, and reports the\n193\t// media type the bytes should be sent as.\n194\t//\n195\t// A fixture body is used even for an operation that declares no request body:\n196\t// specs under-document bodies all the time, and a fixture is the escape hatch\n197\t// for exactly that. The reverse — inventing a body for an operation the spec\n198\t// says takes none — is not something anyone asked for, so generation only runs\n199\t// when there is a schema to generate from.\n200\tfunc (g *Generator) bodyFor(op operation.Operation, fixture Fixture) ([]byte, string) {\n201\t\tsp, mediaType := bodySchema(op)\n202\t\tcontentType := bodyContentType(mediaType)\n203\t\n204\t\tif sp != nil {\n205\t\t\tif s := sp.Schema(); s != nil {\n206\t\t\t\tif v, ok := exampleValue(s); ok {\n207\t\t\t\t\treturn withType(encode(v), contentType)\n208\t\t\t\t}\n209\t\t\t}\n210\t\t}\n211\t\n212\t\tif len(fixture.Body) > 0 {\n213\t\t\treturn withType(compact(fixture.Body), contentType)\n214\t\t}\n215\t\n216\t\tif sp == nil {\n217\t\t\treturn nil, \"\"\n218\t\t}\n219\t\n220\t\tv, ok := g.value(sp, 0, make(map[string]int))\n221\t\tif !ok {\n222\t\t\treturn nil, \"\"\n223\t\t}\n224\t\n225\t\treturn withType(encode(v), contentType)\n226\t}\n227\t\n228\t// bodySchema picks the media type to generate for: JSON if the operation\n229\t// accepts it, otherwise the first declared. Generation produces a Go value\n230\t// shaped for encoding/json, so a JSON media type is the one it can actually\n231\t// satisfy. The chosen media type comes back with the schema so the caller can\n232\t// say what it sent.\n233\tfunc bodySchema(op operation.Operation) (*base.SchemaProxy, string) {\n234\t\tif op.RequestBody == nil {\n235\t\t\treturn nil, \"\"\n236\t\t}\n237\t\n238\t\tfor _, mt := range op.RequestBody.Content {\n239\t\t\tif strings.Contains(mt.ContentType, \"json\") {\n240\t\t\t\treturn mt.Schema, mt.ContentType\n241\t\t\t}\n242\t\t}\n243\t\n244\t\tif len(op.RequestBody.Content) > 0 {\n245\t\t\treturn op.RequestBody.Content[0].Schema, op.RequestBody.Content[0].ContentType\n246\t\t}\n247\t\n248\t\treturn nil, \"\"\n249\t}\n250\t\n251\t// bodyContentType is what a generated body travels as. Everything this package\n252\t// produces is JSON — generated values are marshalled by encoding/json and a\n253\t// fixture body is compacted as JSON — so a media type that is not JSON, or an\n254\t// operation that declares none at all, still yields application/json.\n255\t//\n256\t// Labelling JSON bytes application/x-www-form-urlencoded because a converted\n257\t// Swagger 2.0 formData operation declares that is how a smoke test comes to\n258\t// report a spec bug that is talaria's. A 415 from a server that only speaks XML\n259\t// is the honest answer instead.\n260\tfunc bodyContentType(mediaType string) string {\n261\t\tif strings.Contains(mediaType, \"json\") {\n262\t\t\treturn mediaType\n263\t\t}\n264\t\n265\t\treturn \"application/json\"\n266\t}\n267\t\n268\t// withType pairs a body with its media type, dropping the media type when\n269\t// encoding produced nothing: there is no Content-Type for bytes that will not\n270\t// be sent.\n271\tfunc withType(body []byte, contentType string) ([]byte, string) {\n272\t\tif len(body) == 0 {\n273\t\t\treturn nil, \"\"\n274\t\t}\n275\t\n276\t\treturn body, contentType\n277\t}\n278\t\n279\t// encode marshals a generated value. The value came from the generator or from\n280\t// a spec example that already round-tripped through YAML, so a marshalling\n281\t// failure is not a state the caller can act on: an empty body is the honest\n282\t// result.\n283\tfunc encode(v any) []byte {\n284\t\tout, err := json.Marshal(v)\n285\t\tif err != nil {\n286\t\t\treturn nil\n287\t\t}\n288\t\n289\t\treturn out\n290\t}\n291\t\n292\t// compact strips the formatting from a fixture body so two runs of the same\n293\t// fixture produce byte-identical requests regardless of how it was indented.\n294\tfunc compact(raw json.RawMessage) []byte {\n295\t\tvar buf bytes.Buffer\n296\t\tif err := json.Compact(&buf, raw); err != nil {\n297\t\t\treturn raw\n298\t\t}\n299\t\n300\t\treturn buf.Bytes()\n301\t}\n302\t\n303\t// scalarString renders a parameter value as the text that will travel in a URL\n304\t// or a header. Numbers decoded from a fixture arrive as float64, so 42 has to\n305\t// come back as \"42\" and not \"42.000000\" — a path segment is not the place to\n306\t// discover Go's default float formatting.\n307\tfunc scalarString(v any) string {\n308\t\tswitch t := v.(type) {\n309\t\tcase nil:\n310\t\t\treturn \"\"\n311\t\tcase string:\n312\t\t\treturn t\n313\t\tcase bool:\n314\t\t\treturn strconv.FormatBool(t)\n315\t\tcase float64:\n316\t\t\treturn strconv.FormatFloat(t, 'f', -1, 64)\n317\t\tcase int64:\n318\t\t\treturn strconv.FormatInt(t, 10)\n319\t\tcase int:\n320\t\t\treturn strconv.Itoa(t)\n321\t\tdefault:\n322\t\t\tif out, err := json.Marshal(t); err == nil {\n323\t\t\t\treturn string(out)\n324\t\t\t}\n325\t\n326\t\t\treturn fmt.Sprint(t)\n327\t\t}\n328\t}\n329\t"
      }
