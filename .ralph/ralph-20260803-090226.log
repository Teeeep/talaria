\n103\t\n104\t\tif cachePath != \"\" {\n105\t\t\twriteCache(cachePath, data)\n106\t\t}\n107\t\n108\t\treturn doc, nil\n109\t}\n110\t\n111\tfunc (l *Loader) fetch(url string) ([]byte, error) {\n112\t\tclient := l.Client\n113\t\tif client == nil {\n114\t\t\tclient = &http.Client{Timeout: fetchTimeout}\n115\t\t}\n116\t\n117\t\tresp, err := client.Get(url)\n118\t\tif err != nil {\n119\t\t\treturn nil, clierr.SpecLoad(\"fetching spec %s: %w\", url, err)\n120\t\t}\n121\t\tdefer resp.Body.Close()\n122\t\n123\t\tif resp.StatusCode != http.StatusOK {\n124\t\t\treturn nil, clierr.SpecLoad(\"fetching spec %s: HTTP %s\", url, resp.Status)\n125\t\t}\n126\t\n127\t\tdata, err := io.ReadAll(resp.Body)\n128\t\tif err != nil {\n129\t\t\treturn nil, clierr.SpecLoad(\"reading spec %s: %w\", url, err)\n130\t\t}\n131\t\n132\t\treturn data, nil\n133\t}\n134\t\n135\t// cachePath is where the spec at url is cached. The name is the SHA-256 of the\n136\t// URL, so query strings and paths that would be illegal or colliding as\n137\t// filenames all get one stable, distinct entry.\n138\tfunc (l *Loader) cachePath(url string) (string, error) {\n139\t\tdir := l.CacheDir\n140\t\tif dir == \"\" {\n141\t\t\tbase, err := os.UserCacheDir()\n142\t\t\tif err != nil {\n143\t\t\t\treturn \"\", err\n144\t\t\t}\n145\t\t\tdir = filepath.Join(base, \"talaria\", \"specs\")\n146\t\t}\n147\t\n148\t\tsum := sha256.Sum256([]byte(url))\n149\t\n150\t\treturn filepath.Join(dir, hex.EncodeToString(sum[:])), nil\n151\t}\n152\t\n153\t// writeCache stores data at path. Caching is an optimisation, so every failure\n154\t// is dropped: a spec that loaded is not going to be reported as broken because\n155\t// it could not be written to disk afterwards.\n156\tfunc writeCache(path string, data []byte) {\n157\t\tdir := filepath.Dir(path)\n158\t\tif err := os.MkdirAll(dir, cacheDirMode); err != nil {\n159\t\t\treturn\n160\t\t}\n161\t\n162\t\t// Written to a temp file and renamed so a concurrent talaria never reads a\n163\t\t// half-written spec. CreateTemp already opens at 0600; the Chmod makes that\n164\t\t// a stated guarantee rather than an inherited default.\n165\t\ttmp, err := os.CreateTemp(dir, \".tmp-*\")\n166\t\tif err != nil {\n167\t\t\treturn\n168\t\t}\n169\t\tdefer os.Remove(tmp.Name())\n170\t\n171\t\tif _, err := tmp.Write(data); err != nil {\n172\t\t\ttmp.Close()\n173\t\t\treturn\n174\t\t}\n175\t\tif err := tmp.Chmod(cacheFileMode); err != nil {\n176\t\t\ttmp.Close()\n177\t\t\treturn\n178\t\t}\n179\t\tif err := tmp.Close(); err != nil {\n180\t\t\treturn\n181\t\t}\n182\t\n183\t\tos.Rename(tmp.Name(), path)\n184\t}\n185\t"
