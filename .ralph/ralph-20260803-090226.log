ecoming a failure: a DELETE left alone\n602\t// without --allow-mutations is correct behaviour, and a CI job that went red\n603\t// over it would be turned off within a week.\n604\tfunc junitSuite(view runView) output.Suite {\n605\t\tcases := make([]output.Case, 0, len(view.Results))\n606\t\tfor _, res := range view.Results {\n607\t\t\tc := output.Case{Name: res.OperationID, Seconds: res.seconds()}\n608\t\t\tswitch res.Outcome {\n609\t\t\tcase outcomeFailed:\n610\t\t\t\tc.Failure = res.Reason\n611\t\t\tcase outcomeSkipped:\n612\t\t\t\tc.Skipped = res.Reason\n613\t\t\t}\n614\t\n615\t\t\tcases = append(cases, c)\n616\t\t}\n617\t\n618\t\treturn output.Suite{Name: \"talaria run\", Cases: cases}\n619\t}\n620\t\n621\t// seconds is the operation's timing in the unit JUnit's time attribute is\n622\t// defined in. An operation that never reached a server took no measured time\n623\t// rather than an unknown one: it is reported as 0, with the <skipped> child\n624\t// saying why.\n625\tfunc (res runResult) seconds() float64 {\n626\t\tif res.TimingMS == nil {\n627\t\t\treturn 0\n628\t\t}\n629\t\n630\t\treturn float64(*res.TimingMS) / 1000\n631\t}\n632\t\n633\t// summaryLine is the one line a human is looking for.\n634\tfunc summaryLine(s runSummary) string {\n635\t\treturn fmt.Sprintf(\"%s: %d passed, %d failed, %d skipped\",\n636\t\t\tpluralise(s.Total, \"operation\"), s.Passed, s.Failed, s.Skipped)\n637\t}\n638\t\n639\t// slicesContains reports whether values already holds value.\n640\tfunc slicesContains(values []string, value string) bool {\n641\t\tfor _, v := range values {\n642\t\t\tif v == value {\n643\t\t\t\treturn true\n644\t\t\t}\n645\t\t}\n646\t\n647\t\treturn false\n648\t}\n649\t"
