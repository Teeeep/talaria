        "tool_use_id": "toolu_014ypbjvV9VAtTrLNNJVLdPc",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"github.com/spf13/cobra\"\n5\t\n6\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n7\t\t\"github.com/Teeeep/talaria/internal/operation\"\n8\t\t\"github.com/Teeeep/talaria/internal/output\"\n9\t\t\"github.com/Teeeep/talaria/internal/spec\"\n10\t)\n11\t\n12\t// maxPrettyWidth bounds one pretty `list` line. Progressive disclosure is the\n13\t// product (DESIGN.md §3.2): a line that wraps in an 80–100 column terminal, or\n14\t// in an agent's transcript, costs more context than the operation is worth, so\n15\t// the summary is truncated to fit rather than allowed to wrap.\n16\tconst maxPrettyWidth = 100\n17\t\n18\t// minSummaryWidth is the shortest summary worth printing. Below it the method,\n19\t// path and id have already eaten the line, and two words followed by an\n20\t// ellipsis inform nobody — the summary is dropped instead.\n21\tconst minSummaryWidth = 12\n22\t\n23\t// summaryColumn is the index of the summary in a table row — the one column\n24\t// that can be shortened to make a line fit.\n25\tconst summaryColumn = 3\n26\t\n27\t// listEntry is one operation as `list` reports it: the addressing information\n28\t// plus just enough prose to choose between two endpoints. Everything else is\n29\t// what `describe` is for.\n30\ttype listEntry struct {\n31\t\tID      string   `json:\"id\"`\n32\t\tMethod  string   `json:\"method\"`\n33\t\tPath    string   `json:\"path\"`\n34\t\tTags    []string `json:\"tags\"`\n35\t\tSummary string   `json:\"summary\"`\n36\t}\n37\t\n38\t// listView is the JSON payload. It is a struct rather than a bare slice so the\n39\t// operations sit at the top level next to the schema field.\n40\ttype listView struct {\n41\t\tOperations []listEntry `json:\"operations\"`\n42\t}\n43\t\n44\tfunc newListCmd() *cobra.Command {\n45\t\tvar tag string\n46\t\n47\t\tcmd := &cobra.Command{\n48\t\t\tUse:   \"list [spec]\",\n49\t\t\tShort: \"List a spec's operations, one compact line each\",\n50\t\t\tLong: \"List every operation in a spec: method, path, operationId and a short\\n\" +\n51\t\t\t\t\"summary. Operations the spec did not name get a synthesised id, which is\\n\" +\n52\t\t\t\t\"as callable as an authored one.\",\n53\t\t\tArgs: usageArgs(cobra.MaximumNArgs(1)),\n54\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n55\t\t\t\tformat, err := resolveFormat(cmd)\n56\t\t\t\tif err != nil {\n57\t\t\t\t\treturn err\n58\t\t\t\t}\n59\t\n60\t\t\t\tindex, err := loadIndex(cmd, args)\n61\t\t\t\tif err != nil {\n62\t\t\t\t\treturn err\n63\t\t\t\t}\n64\t\n65\t\t\t\tops := index.Operations()\n66\t\t\t\tif tag != \"\" {\n67\t\t\t\t\tops = index.ByTag(tag)\n68\t\t\t\t}\n69\t\n70\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(listPayload(ops, format))\n71\t\t\t},\n72\t\t}\n73\t\n74\t\t// Local rather than persistent: only the commands that enumerate operations\n75\t\t// have a tag to filter on.\n76\t\tcmd.Flags().StringVar(&tag, \"tag\", \"\", \"only operations carrying this tag\")\n77\t\n78\t\treturn cmd\n79\t}\n80\t\n81\t// listPayload builds the JSON view and the table together. The table is\n82\t// format-aware because only the pretty renderer has a width budget: TSV is\n83\t// piped into other programs, which want the summary whole.\n84\tfunc listPayload(ops []operation.Operation, format output.Format) output.Payload {\n85\t\tview := listView{Operations: make([]listEntry, 0, len(ops))}\n86\t\trows := make([][]string, 0, len(ops))\n87\t\n88\t\tfor _, op := range ops {\n89\t\t\ttags := op.Tags\n90\t\t\tif tags == nil {\n91\t\t\t\t// An untagged operation renders \"tags\": [], not null: agents parse\n92\t\t\t\t// this, and a field that changes type between specs is a trap.\n93\t\t\t\ttags = []string{}\n94\t\t\t}\n95\t\t\tview.Operations = append(view.Operations, listEntry{\n96\t\t\t\tID:      op.ID,\n97\t\t\t\tMethod:  op.Method,\n98\t\t\t\tPath:    op.Path,\n99\t\t\t\tTags:    tags,\n100\t\t\t\tSummary: op.Summary,\n101\t\t\t})\n102\t\n103\t\t\trows = append(rows, []string{op.Method, op.Path, op.ID, op.Summary})\n104\t\t}\n105\t\n106\t\tif format == output.FormatPretty {\n107\t\t\tfitSummaries(rows)\n108\t\t}\n109\t\n110\t\t// No headers: §3.2 asks for one compact line per operation, and a header\n111\t\t// line is one more thing every consumer has to skip. `--output json` is\n112\t\t// where the fields are labelled.\n113\t\treturn output.Payload{\n114\t\t\tData:  view,\n115\t\t\tTable: output.Table{Rows: rows},\n116\t\t}\n117\t}\n118\t\n119\t// fitSummaries truncates the summary column in place so no rendered line\n120\t// exceeds maxPrettyWidth. The budget is what is left after the three columns\n121\t// that cannot be shortened, measured at the width tabwriter will pad them to —\n122\t// the widest cell in each — because that padding is what a row-local\n123\t// measurement would miss.\n124\tfunc fitSummaries(rows [][]string) {\n125\t\tconst padding = 2 // tabwriter is constructed with two spaces between columns.\n126\t\n127\t\tfixed := 0\n128\t\tfor col := 0; col < summaryColumn; col++ {\n129\t\t\twidth := 0\n130\t\t\tfor _, row := range rows {\n131\t\t\t\twidth = max(width, len([]rune(row[col])))\n132\t\t\t}\n133\t\t\tfixed += width + padding\n134\t\t}\n135\t\n136\t\tbudget := maxPrettyWidth - fixed\n137\t\tfor _, row := range rows {\n138\t\t\tif budget < minSummaryWidth {\n139\t\t\t\trow[summaryColumn] = \"\"\n140\t\n141\t\t\t\tcontinue\n142\t\t\t}\n143\t\t\trow[summaryColumn] = truncate(row[summaryColumn], budget)\n144\t\t}\n145\t}\n146\t\n147\t// truncate shortens s to at most max runes, marking the cut with an ellipsis so\n148\t// a reader can tell the summary continues.\n149\tfunc truncate(s string, max int) string {\n150\t\trunes := []rune(s)\n151\t\tif len(runes) <= max {\n152\t\t\treturn s\n153\t\t}\n154\t\n155\t\treturn string(runes[:max-1]) + \"…\"\n156\t}\n157\t\n158\t// loadIndex resolves the spec from the positional argument, --spec or the\n159\t// environment, loads it and indexes its operations. Every spec-reading command\n160\t// starts this way, so the precedence and the error codes are decided once.\n161\tfunc loadIndex(cmd *cobra.Command, args []string) (*operation.Index, error) {\n162\t\t_, index, err := loadSpec(cmd, args)\n163\t\n164\t\treturn index, err\n165\t}\n166\t\n167\t// loadSpec is loadIndex plus the document the index was built from. `call` and\n168\t// `auth check` need it: security schemes live on the document, not on any one\n169\t// operation, so resolving credentials means reading both.\n170\tfunc loadSpec(cmd *cobra.Command, args []string) (*spec.Document, *operation.Index, error) {\n171\t\tvar arg string\n172\t\tif len(args) > 0 {\n173\t\t\targ = args[0]\n174\t\t}\n175\t\n176\t\tflag, err := cmd.Flags().GetString(\"spec\")\n177\t\tif err != nil {\n178\t\t\treturn nil, nil, clierr.Usage(\"%w\", err)\n179\t\t}\n180\t\n181\t\tref, err := spec.Resolve(arg, flag)\n182\t\tif err != nil {\n183\t\t\treturn nil, nil, err\n184\t\t}\n185\t\n186\t\tdoc, err := spec.Load(ref)\n187\t\tif err != nil {\n188\t\t\treturn nil, nil, err\n189\t\t}\n190\t\n191\t\treturn doc, operation.NewIndexFor(doc), nil\n192\t}\n193\t"
      }
    ]
  },
