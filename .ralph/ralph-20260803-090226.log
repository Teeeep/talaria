        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"strings\"\n5\t\n6\t\t\"github.com/spf13/cobra\"\n7\t\n8\t\t\"github.com/Teeeep/talaria/internal/operation\"\n9\t\t\"github.com/Teeeep/talaria/internal/output\"\n10\t)\n11\t\n12\t// usesView is the JSON payload. The schema name is under \"name\" rather than\n13\t// \"schema\" because \"schema\" is the envelope's own version field.\n14\ttype usesView struct {\n15\t\tName       string          `json:\"name\"`\n16\t\tOperations []operation.Use `json:\"operations\"`\n17\t}\n18\t\n19\tfunc newUsesCmd() *cobra.Command {\n20\t\tcmd := &cobra.Command{\n21\t\t\tUse:   \"uses [spec] <schema>\",\n22\t\t\tShort: \"List the operations that reach a component schema\",\n23\t\t\tLong: \"Find every operation that touches a schema, in a parameter, a request\\n\" +\n24\t\t\t\t\"body or a response. References are followed: an operation returning a\\n\" +\n25\t\t\t\t\"PetList is reported for Pet, marked as an indirect use.\",\n26\t\t\tArgs: usageArgs(cobra.RangeArgs(1, 2)),\n27\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n28\t\t\t\tformat, err := resolveFormat(cmd)\n29\t\t\t\tif err != nil {\n30\t\t\t\t\treturn err\n31\t\t\t\t}\n32\t\n33\t\t\t\t// The schema name is always last, as the operationId is for describe.\n34\t\t\t\tname := args[len(args)-1]\n35\t\n36\t\t\t\tindex, err := loadIndex(cmd, args[:len(args)-1])\n37\t\t\t\tif err != nil {\n38\t\t\t\t\treturn err\n39\t\t\t\t}\n40\t\n41\t\t\t\tuses, err := index.Uses(name)\n42\t\t\t\tif err != nil {\n43\t\t\t\t\treturn err\n44\t\t\t\t}\n45\t\n46\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(usesPayload(name, uses))\n47\t\t\t},\n48\t\t}\n49\t\n50\t\treturn cmd\n51\t}\n52\t\n53\tfunc usesPayload(name string, uses []operation.Use) output.Payload {\n54\t\trows := make([][]string, 0, len(uses))\n55\t\tfor _, u := range uses {\n56\t\t\trows = append(rows, []string{u.Method, u.Path, u.ID, strings.Join(u.Where, \",\"), reachLabel(u.Direct)})\n57\t\t}\n58\t\n59\t\treturn output.Payload{\n60\t\t\tData:  usesView{Name: name, Operations: uses},\n61\t\t\tTable: output.Table{Rows: rows},\n62\t\t}\n63\t}\n64\t\n65\t// reachLabel names how the operation gets to the schema. It earns its column:\n66\t// \"indirect\" is the reader's cue that the schema is nested inside whatever the\n67\t// endpoint actually declares, so the field will not be at the top level.\n68\tfunc reachLabel(direct bool) string {\n69\t\tif direct {\n70\t\t\treturn \"direct\"\n71\t\t}\n72\t\n73\t\treturn \"indirect\"\n74\t}\n75\t"
