        "tool_use_id": "toolu_01ABKsmpJk2rtHNfJG3v7Ukq",
        "type": "tool_result",
        "content": "1\tpackage operation\n2\t\n3\timport (\n4\t\t\"sort\"\n5\t\t\"strings\"\n6\t\n7\t\t\"github.com/pb33f/libopenapi/datamodel/high/base\"\n8\t\tv3high \"github.com/pb33f/libopenapi/datamodel/high/v3\"\n9\t\t\"github.com/pb33f/libopenapi/orderedmap\"\n10\t\n11\t\t\"github.com/Teeeep/talaria/internal/spec\"\n12\t)\n13\t\n14\t// Extract walks a loaded spec and returns every operation it describes, in\n15\t// document order: path items as the spec lists them, and the methods under\n16\t// each path item in the order they appear. A spec with no paths yields nil\n17\t// rather than an error — an empty API is a valid one.\n18\tfunc Extract(doc *spec.Document) []Operation {\n19\t\tif doc == nil || doc.Model == nil || doc.Model.Paths == nil {\n20\t\t\treturn nil\n21\t\t}\n22\t\n23\t\t// The document-level requirement is the default for every operation that\n24\t\t// does not state its own, so it is resolved once.\n25\t\tdocSecurity := extractSecurity(doc.Model.Security)\n26\t\n27\t\tvar ops []Operation\n28\t\tfor path, item := range doc.Model.Paths.PathItems.FromOldest() {\n29\t\t\tif item == nil {\n30\t\t\t\tcontinue\n31\t\t\t}\n32\t\t\tfor method, op := range item.GetOperations().FromOldest() {\n33\t\t\t\tif op == nil {\n34\t\t\t\t\tcontinue\n35\t\t\t\t}\n36\t\t\t\tops = append(ops, buildOperation(path, method, item, op, docSecurity))\n37\t\t\t}\n38\t\t}\n39\t\n40\t\treturn ops\n41\t}\n42\t\n43\tfunc buildOperation(path, method string, item *v3high.PathItem, op *v3high.Operation, docSecurity []SecurityRequirement) Operation {\n44\t\tout := Operation{\n45\t\t\tID:          op.OperationId,\n46\t\t\tMethod:      strings.ToUpper(method),\n47\t\t\tPath:        path,\n48\t\t\tSummary:     op.Summary,\n49\t\t\tDescription: op.Description,\n50\t\t\tTags:        op.Tags,\n51\t\t\tDeprecated:  op.Deprecated != nil && *op.Deprecated,\n52\t\t\tParams:      mergeParams(item.Parameters, op.Parameters),\n53\t\t\tRequestBody: extractRequestBody(op.RequestBody),\n54\t\t\tResponses:   extractResponses(op.Responses),\n55\t\t\tSecurity:    docSecurity,\n56\t\t}\n57\t\n58\t\t// An operation-level security block replaces the document-level one rather\n59\t\t// than adding to it. libopenapi gives a non-nil empty slice for an explicit\n60\t\t// `security: []` and nil when the key is absent, which is exactly the\n61\t\t// distinction between \"this endpoint needs no auth\" and \"inherit\".\n62\t\tif op.Security != nil {\n63\t\t\tout.Security = extractSecurity(op.Security)\n64\t\t}\n65\t\n66\t\treturn out\n67\t}\n68\t\n69\t// mergeParams folds the path-item parameters into the operation's own. Entries\n70\t// keep their declared order — path-item first — and an operation-level\n71\t// parameter replaces the path-item one in place when they share a (name, in),\n72\t// which is what the spec means by overriding.\n73\tfunc mergeParams(pathLevel, opLevel []*v3high.Parameter) []Param {\n74\t\tmerged := make([]*v3high.Parameter, 0, len(pathLevel)+len(opLevel))\n75\t\tat := make(map[[2]string]int, len(pathLevel))\n76\t\n77\t\tadd := func(p *v3high.Parameter) {\n78\t\t\tif p == nil {\n79\t\t\t\treturn\n80\t\t\t}\n81\t\t\tkey := [2]string{p.Name, p.In}\n82\t\t\tif i, ok := at[key]; ok {\n83\t\t\t\tmerged[i] = p\n84\t\n85\t\t\t\treturn\n86\t\t\t}\n87\t\t\tat[key] = len(merged)\n88\t\t\tmerged = append(merged, p)\n89\t\t}\n90\t\tfor _, p := range pathLevel {\n91\t\t\tadd(p)\n92\t\t}\n93\t\tfor _, p := range opLevel {\n94\t\t\tadd(p)\n95\t\t}\n96\t\n97\t\tif len(merged) == 0 {\n98\t\t\treturn nil\n99\t\t}\n100\t\n101\t\tparams := make([]Param, 0, len(merged))\n102\t\tfor _, p := range merged {\n103\t\t\tparams = append(params, Param{\n104\t\t\t\tName:        p.Name,\n105\t\t\t\tIn:          p.In,\n106\t\t\t\tRequired:    p.Required != nil && *p.Required,\n107\t\t\t\tDescription: p.Description,\n108\t\t\t\tSchema:      p.Schema,\n109\t\t\t})\n110\t\t}\n111\t\n112\t\treturn params\n113\t}\n114\t\n115\tfunc extractRequestBody(rb *v3high.RequestBody) *RequestBody {\n116\t\tif rb == nil {\n117\t\t\treturn nil\n118\t\t}\n119\t\n120\t\treturn &RequestBody{\n121\t\t\tRequired:    rb.Required != nil && *rb.Required,\n122\t\t\tDescription: rb.Description,\n123\t\t\tContent:     extractContent(rb.Content),\n124\t\t}\n125\t}\n126\t\n127\t// extractResponses flattens the coded responses and the default one into a\n128\t// single list. It sorts by status so output is stable across runs: libopenapi\n129\t// builds the code map concurrently, and \"200 before 404 before default\" is the\n130\t// order a reader expects anyway.\n131\tfunc extractResponses(responses *v3high.Responses) []Response {\n132\t\tif responses == nil {\n133\t\t\treturn nil\n134\t\t}\n135\t\n136\t\tvar out []Response\n137\t\tfor status, resp := range responses.Codes.FromOldest() {\n138\t\t\tout = append(out, newResponse(status, resp))\n139\t\t}\n140\t\tsort.Slice(out, func(i, j int) bool { return out[i].Status < out[j].Status })\n141\t\n142\t\tif responses.Default != nil {\n143\t\t\tout = append(out, newResponse(StatusDefault, responses.Default))\n144\t\t}\n145\t\n146\t\treturn out\n147\t}\n148\t\n149\tfunc newResponse(status string, resp *v3high.Response) Response {\n150\t\tout := Response{Status: status}\n151\t\tif resp != nil {\n152\t\t\tout.Description = resp.Description\n153\t\t\tout.Content = extractContent(resp.Content)\n154\t\t}\n155\t\n156\t\treturn out\n157\t}\n158\t\n159\tfunc extractContent(content *orderedmap.Map[string, *v3high.MediaType]) []MediaType {\n160\t\tif content == nil {\n161\t\t\treturn nil\n162\t\t}\n163\t\n164\t\tvar out []MediaType\n165\t\tfor contentType, media := range content.FromOldest() {\n166\t\t\tentry := MediaType{ContentType: contentType}\n167\t\t\tif media != nil {\n168\t\t\t\tentry.Schema = media.Schema\n169\t\t\t}\n170\t\t\tout = append(out, entry)\n171\t\t}\n172\t\n173\t\treturn out\n174\t}\n175\t\n176\t// extractSecurity turns libopenapi's requirement objects into scheme names and\n177\t// scopes. Each requirement is one alternative; the schemes inside it all apply.\n178\tfunc extractSecurity(reqs []*base.SecurityRequirement) []SecurityRequirement {\n179\t\tvar out []SecurityRequirement\n180\t\tfor _, req := range reqs {\n181\t\t\tif req == nil {\n182\t\t\t\tcontinue\n183\t\t\t}\n184\t\n185\t\t\tvar schemes []SecurityScheme\n186\t\t\tif req.Requirements != nil {\n187\t\t\t\tfor name, scopes := range req.Requirements.FromOldest() {\n188\t\t\t\t\tschemes = append(schemes, SecurityScheme{Name: name, Scopes: scopes})\n189\t\t\t\t}\n190\t\t\t}\n191\t\t\tout = append(out, SecurityRequirement{Schemes: schemes})\n192\t\t}\n193\t\n194\t\treturn out\n195\t}\n196\t"
      }
    ]
