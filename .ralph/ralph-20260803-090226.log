        "tool_use_id": "toolu_01CHDq6H2csQsgoWX6J58cET",
        "type": "tool_result",
        "content": "1\tpackage canary_test\n2\t\n3\timport (\n4\t\t\"encoding/base64\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"io/fs\"\n9\t\t\"net/http\"\n10\t\t\"net/http/httptest\"\n11\t\t\"net/url\"\n12\t\t\"os\"\n13\t\t\"os/exec\"\n14\t\t\"path/filepath\"\n15\t\t\"strings\"\n16\t\t\"sync\"\n17\t\t\"testing\"\n18\t\n19\t\t\"github.com/Teeeep/talaria/internal/canary\"\n20\t)\n21\t\n22\t// specPath is the fixture declaring one security scheme per auth mechanism.\n23\tconst specPath = \"testdata/canary.yaml\"\n24\t\n25\t// binary is the talaria under test, built once by TestMain.\n26\t//\n27\t// The suite drives a real process rather than calling the command tree\n28\t// in-process, for one reason: the command tree lives in package main and cannot\n29\t// be imported. Running the binary is also the stronger reading of §5a — it\n30\t// greps every byte the process emits, including anything written outside the\n31\t// writers a test would otherwise hand it.\n32\tvar binary string\n33\t\n34\tfunc TestMain(m *testing.M) {\n35\t\tdir, err := os.MkdirTemp(\"\", \"talaria-canary-*\")\n36\t\tif err != nil {\n37\t\t\tfmt.Fprintf(os.Stderr, \"creating the build directory: %v\\n\", err)\n38\t\t\tos.Exit(1)\n39\t\t}\n40\t\n41\t\tif err := readSources(); err != nil {\n42\t\t\tfmt.Fprintf(os.Stderr, \"reading the sources under test: %v\\n\", err)\n43\t\t\tos.Exit(1)\n44\t\t}\n45\t\n46\t\tbinary = filepath.Join(dir, \"talaria\")\n47\t\tbuild := exec.Command(\"go\", \"build\", \"-o\", binary, \"./cmd/talaria\")\n48\t\tbuild.Dir = filepath.Join(\"..\", \"..\")\n49\t\tif out, err := build.CombinedOutput(); err != nil {\n50\t\t\tfmt.Fprintf(os.Stderr, \"building talaria: %v\\n%s\", err, out)\n51\t\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n52\t\t\tos.Exit(1)\n53\t\t}\n54\t\n55\t\tcode := m.Run()\n56\t\n57\t\t// Explicit rather than deferred: os.Exit does not run defers.\n58\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n59\t\tos.Exit(code)\n60\t}\n61\t\n62\t// readSources opens every Go source file in the module so the test cache knows\n63\t// this suite depends on all of them.\n64\t//\n65\t// It has to be said out loud because the dependency is invisible to the tool:\n66\t// the suite reaches the code under test by building a binary in a subprocess,\n67\t// and `go test` records nothing about that. Without this, a leak introduced in\n68\t// internal/curl or cmd/talaria would leave the canary package's own inputs\n69\t// untouched, and `go test ./...` would replay a cached pass over code that\n70\t// never ran. A gate that can go stale is not a gate. The test cache does track\n71\t// files a test reads, so reading them is how the dependency is declared.\n72\tfunc readSources() error {\n73\t\troot := filepath.Join(\"..\", \"..\")\n74\t\n75\t\treturn filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {\n76\t\t\tif err != nil || d.IsDir() || !strings.HasSuffix(path, \".go\") {\n77\t\t\t\treturn err\n78\t\t\t}\n79\t\n80\t\t\t_, err = os.ReadFile(path)\n81\t\n82\t\t\treturn err\n83\t\t})\n84\t}\n85\t\n86\t// mechanism is one way of authenticating, driven end to end with its own\n87\t// canary. Received proves the credential actually reached the server, which is\n88\t// what makes the absence of it everywhere else mean something: a call that\n89\t// quietly sent nothing would pass every leak assertion.\n90\ttype mechanism struct {\n91\t\tname string\n92\t\top   string\n93\t\t// env builds the environment carrying the canary, keyed by variable name.\n94\t\tenv func(value string) map[string]string\n95\t\t// received reports whether the server saw the canary on the request.\n96\t\treceived func(req recordedRequest, value string) bool\n97\t}\n98\t\n99\tvar mechanisms = []mechanism{\n100\t\t{\n101\t\t\tname: \"bearer\",\n102\t\t\top:   \"getBearer\",\n103\t\t\tenv:  func(v string) map[string]string { return map[string]string{\"TALARIA_AUTH_BEARER\": v} },\n104\t\t\treceived: func(req recordedRequest, v string) bool {\n105\t\t\t\treturn req.Header.Get(\"Authorization\") == \"Bearer \"+v\n106\t\t\t},\n107\t\t},\n108\t\t{\n109\t\t\tname: \"basic\",\n110\t\t\top:   \"getBasic\",\n111\t\t\tenv: func(v string) map[string]string {\n112\t\t\t\treturn map[string]string{\"TALARIA_AUTH_BASIC\": \"canaryuser:\" + v}\n113\t\t\t},\n114\t\t\treceived: func(req recordedRequest, v string) bool {\n115\t\t\t\t// Basic auth is the one mechanism that encodes the credential before\n116\t\t\t\t// it goes on the wire, which is why Scan looks for base64 too.\n117\t\t\t\twant := \"Basic \" + base64.StdEncoding.EncodeToString([]byte(\"canaryuser:\"+v))\n118\t\t\t\treturn req.Header.Get(\"Authorization\") == want\n119\t\t\t},\n120\t\t},\n121\t\t{\n122\t\t\tname: \"apikey-header\",\n123\t\t\top:   \"getHeaderKey\",\n124\t\t\tenv: func(v string) map[string]string {\n125\t\t\t\treturn map[string]string{\"TALARIA_AUTH_APIKEY_HEADERKEY\": v}\n126\t\t\t},\n127\t\t\treceived: func(req recordedRequest, v string) bool {\n128\t\t\t\treturn req.Header.Get(\"X-Api-Key\") == v\n129\t\t\t},\n130\t\t},\n131\t\t{\n132\t\t\tname: \"apikey-query\",\n133\t\t\top:   \"getQueryKey\",\n134\t\t\tenv: func(v string) map[string]string {\n135\t\t\t\treturn map[string]string{\"TALARIA_AUTH_APIKEY_QUERYKEY\": v}\n136\t\t\t},\n137\t\t\treceived: func(req recordedRequest, v string) bool {\n138\t\t\t\treturn req.Query.Get(\"api_key\") == v\n139\t\t\t},\n140\t\t},\n141\t\t{\n142\t\t\tname: \"apikey-cookie\",\n143\t\t\top:   \"getCookieKey\",\n144\t\t\tenv: func(v string) map[string]string {\n145\t\t\t\treturn map[string]string{\"TALARIA_AUTH_APIKEY_COOKIEKEY\": v}\n146\t\t\t},\n147\t\t\treceived: func(req recordedRequest, v string) bool {\n148\t\t\t\treturn req.Cookies[v] || strings.Contains(req.Header.Get(\"Cookie\"), v)\n149\t\t\t},\n150\t\t},\n151\t}\n152\t\n153\t// result is one talaria invocation.\n154\ttype result struct {\n155\t\targs   []string\n156\t\tcode   int\n157\t\tstdout string\n158\t\tstderr string\n159\t}\n160\t\n161\t// harness runs talaria against an isolated home, so the only credentials in\n162\t// reach are the ones a case injected and the only files it can write are ones\n163\t// the case can then read back and grep.\n164\ttype harness struct {\n165\t\tt   *testing.T\n166\t\tenv []string\n167\t\t// home is $HOME for the run: the directory curl looks in for .curlrc, and\n168\t\t// the parent of the three XDG roots below.\n169\t\thome  string\n170\t\tstate string\n171\t\tcache string\n172\t\tconf  string\n173\t}\n174\t\n175\tfunc newHarness(t *testing.T, vars map[string]string) *harness {\n176\t\tt.Helper()\n177\t\n178\t\thome := t.TempDir()\n179\t\th := &harness{\n180\t\t\tt:     t,\n181\t\t\thome:  home,\n182\t\t\tstate: filepath.Join(home, \"state\"),\n183\t\t\tcache: filepath.Join(home, \"cache\"),\n184\t\t\tconf:  filepath.Join(home, \"config\"),\n185\t\t}\n186\t\n187\t\t// Built from nothing rather than from os.Environ: a developer's own\n188\t\t// TALARIA_AUTH_BEARER or TALARIA_SPEC must not be able to change what this\n189\t\t// suite tests, and PATH is all curl needs to be found.\n190\t\th.env = []string{\n191\t\t\t\"PATH=\" + os.Getenv(\"PATH\"),\n192\t\t\t\"HOME=\" + home,\n193\t\t\t\"XDG_STATE_HOME=\" + h.state,\n194\t\t\t\"XDG_CACHE_HOME=\" + h.cache,\n195\t\t\t\"XDG_CONFIG_HOME=\" + h.conf,\n196\t\t}\n197\t\tfor name, value := range vars {\n198\t\t\th.env = append(h.env, name+\"=\"+value)\n199\t\t}\n200\t\n201\t\treturn h\n202\t}\n203\t\n204\t// run executes talaria and captures both streams.\n205\tfunc (h *harness) run(args ...string) result {\n206\t\th.t.Helper()\n207\t\n208\t\tcmd := exec.Command(binary, args...)\n209\t\tcmd.Env = h.env\n210\t\n211\t\tvar stdout, stderr strings.Builder\n212\t\tcmd.Stdout, cmd.Stderr = &stdout, &stderr\n213\t\n214\t\tcode := 0\n215\t\tif err := cmd.Run(); err != nil {\n216\t\t\tvar exit *exec.ExitError\n217\t\t\tif !errors.As(err, &exit) {\n218\t\t\t\th.t.Fatalf(\"running talaria %s: %v\", strings.Join(args, \" \"), err)\n219\t\t\t}\n220\t\t\tcode = exit.ExitCode()\n221\t\t}\n222\t\n223\t\treturn result{args: args, code: code, stdout: stdout.String(), stderr: stderr.String()}\n224\t}\n225\t\n226\t// runOK runs talaria and fails the test unless it exited 0.\n227\tfunc (h *harness) runOK(args ...string) result {\n228\t\th.t.Helper()\n229\t\n230\t\tres := h.run(args...)\n231\t\tif res.code != 0 {\n232\t\t\th.t.Fatalf(\"talaria %s = %d, want 0; stderr: %s\",\n233\t\t\t\tstrings.Join(args, \" \"), res.code, res.stderr)\n234\t\t}\n235\t\n236\t\treturn res\n237\t}\n238\t\n239\t// surfaces returns both streams of a result as scannable surfaces.\n240\tfunc (r result) surfaces() []canary.Surface {\n241\t\tlabel := strings.Join(r.args, \" \")\n242\t\n243\t\treturn []canary.Surface{\n244\t\t\tcanary.Stream(\"stdout of `talaria \"+label+\"`\", r.stdout),\n245\t\t\tcanary.Stream(\"stderr of `talaria \"+label+\"`\", r.stderr),\n246\t\t}\n247\t}\n248\t\n249\t// written returns every file talaria left behind: the history store, the spec\n250\t// cache, anything a future version starts writing into the same directories.\n251\t// Enumerated by walking, not by name, so a new persistent artifact is covered\n252\t// the day it appears.\n253\t//\n254\t// The config directory is deliberately not among them. Nothing talaria writes\n255\t// goes there — it is an input the user wrote, and a case that puts a canary in\n256\t// a config file to see how an error path handles it would otherwise be caught\n257\t// finding its own fixture.\n258\tfunc (h *harness) written() []canary.Surface {\n259\t\th.t.Helper()\n260\t\n261\t\tvar surfaces []canary.Surface\n262\t\tfor label, root := range map[string]string{\n263\t\t\t\"history\": h.state,\n264\t\t\t\"cache\":   h.cache,\n265\t\t} {\n266\t\t\tfound, err := canary.Tree(label, root)\n267\t\t\tif err != nil {\n268\t\t\t\th.t.Fatalf(\"enumerating the %s surfaces: %v\", label, err)\n269\t\t\t}\n270\t\t\tsurfaces = append(surfaces, found...)\n271\t\t}\n272\t\n273\t\treturn surfaces\n274\t}\n275\t\n276\t// recordedRequest is what arrived at the test server.\n277\ttype recordedRequest struct {\n278\t\tHeader  http.Header\n279\t\tQuery   url.Values\n280\t\tCookies map[string]bool\n281\t}\n282\t\n283\ttype recordingServer struct {\n284\t\t*httptest.Server\n285\t\n286\t\tmu   sync.Mutex\n287\t\tlast recordedRequest\n288\t}\n289\t\n290\t// newServer starts a server that records each request and answers 200 with a\n291\t// body carrying no secret of its own.\n292\tfunc newServer(t *testing.T, body string) *recordingServer {\n293\t\tt.Helper()\n294\t\n295\t\trs := &recordingServer{}\n296\t\trs.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n297\t\t\tcookies := map[string]bool{}\n298\t\t\tfor _, c := range r.Cookies() {\n299\t\t\t\tcookies[c.Value] = true\n300\t\t\t}\n301\t\n302\t\t\trs.mu.Lock()\n303\t\t\trs.last = recordedRequest{\n304\t\t\t\tHeader:  r.Header.Clone(),\n305\t\t\t\tQuery:   r.URL.Query(),\n306\t\t\t\tCookies: cookies,\n307\t\t\t}\n308\t\t\trs.mu.Unlock()\n309\t\n310\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n311\t\t\t_, _ = io.WriteString(w, body)\n312\t\t}))\n313\t\tt.Cleanup(rs.Close)\n314\t\n315\t\treturn rs\n316\t}\n317\t\n318\tfunc (rs *recordingServer) received() recordedRequest {\n319\t\trs.mu.Lock()\n320\t\tdefer rs.mu.Unlock()\n321\t\n322\t\treturn rs.last\n323\t}\n324\t\n325\t// TestNoAuthMechanismLeaksIntoAnyOutputSurface is the suite §5a asks for: every\n326\t// auth mechanism, every output format, every surface a run produces.\n327\t//\n328\t// The format loop comes from canary.Formats, which is internal/output's Format\n329\t// enum. A fourth format is exercised here the day it is added, and the\n330\t// non-empty assertion below means a format that renders nothing fails rather\n331\t// than passing vacuously.\n332\tfunc TestNoAuthMechanismLeaksIntoAnyOutputSurface(t *testing.T) {\n333\t\tfor _, mech := range mechanisms {\n334\t\t\tfor _, format := range canary.Formats() {\n335\t\t\t\tt.Run(mech.name+\"/\"+format, func(t *testing.T) {\n336\t\t\t\t\tt.Parallel()\n337\t\n338\t\t\t\t\tvalue := canary.Value(mech.name)\n339\t\t\t\t\th := newHarness(t, mech.env(value))\n340\t\t\t\t\tsrv := newServer(t, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n341\t\n342\t\t\t\t\tvar runs []result\n343\t\t\t\t\truns = append(runs,\n344\t\t\t\t\t\th.runOK(\"call\", specPath, mech.op,\n345\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--output\", format, \"--dry-run\"),\n346\t\t\t\t\t\th.runOK(\"call\", specPath, mech.op,\n347\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--output\", format),\n348\t\t\t\t\t\t// Exits 5: the fixture declares every scheme and this case\n349\t\t\t\t\t\t// sets one. The report is the surface being checked, and it\n350\t\t\t\t\t\t// is written on the way to that exit code.\n351\t\t\t\t\t\th.run(\"auth\", \"check\", specPath, \"--output\", format),\n352\t\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n353\t\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n354\t\t\t\t\t\th.runOK(\"history\", \"replay\", \"1\", \"--output\", format),\n355\t\t\t\t\t\th.runOK(\"describe\", specPath, mech.op, \"--output\", format),\n356\t\t\t\t\t\th.runOK(\"list\", specPath, \"--output\", format),\n357\t\t\t\t\t\t// Last, so it disturbs no history index above. `run` sends\n358\t\t\t\t\t\t// the same credential `call` does and renders its own\n359\t\t\t\t\t\t// report, so it is its own surface.\n360\t\t\t\t\t\th.runOK(\"run\", specPath, \"--operation\", mech.op,\n361\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--report\", format),\n362\t\t\t\t\t)\n363\t\n364\t\t\t\t\t// The credential reached the server. Without this the rest of\n365\t\t\t\t\t// the test would pass just as well if talaria sent nothing.\n366\t\t\t\t\tif !mech.received(srv.received(), value) {\n367\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s credential; the leak assertions below prove nothing\", mech.name)\n368\t\t\t\t\t}\n369\t\n370\t\t\t\t\tvar surfaces []canary.Surface\n371\t\t\t\t\tfor _, res := range runs {\n372\t\t\t\t\t\tif strings.TrimSpace(res.stdout) == \"\" {\n373\t\t\t\t\t\t\tt.Errorf(\"`talaria %s` printed nothing; --output %s renders no payload\",\n374\t\t\t\t\t\t\t\tstrings.Join(res.args, \" \"), format)\n375\t\t\t\t\t\t}\n376\t\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n377\t\t\t\t\t}\n378\t\t\t\t\tsurfaces = append(surfaces, h.written()...)\n379\t\n380\t\t\t\t\tassertNoLeak(t, value, surfaces)\n381\t\t\t\t})\n382\t\t\t}\n383\t\t}\n384\t}\n385\t\n386\t// TestNoReportFormatLeaksTheCredential covers §5a's \"junit reports\" among the\n387\t// output surfaces, and every other shape `run --report` writes.\n388\t//\n389\t// It is a loop of its own rather than a line in the test above because the\n390\t// report formats are a superset of the --output ones: junit describes a suite\n391\t// of operations, which is something only `run` produces. Driving it from\n392\t// canary.ReportFormats means a fifth report format is covered the day it is\n393\t// added.\n394\tfunc TestNoReportFormatLeaksTheCredential(t *testing.T) {\n395\t\tfor _, mech := range mechanisms {\n396\t\t\tfor _, format := range canary.ReportFormats() {\n397\t\t\t\tt.Run(mech.name+\"/\"+format, func(t *testing.T) {\n398\t\t\t\t\tt.Parallel()\n399\t\n400\t\t\t\t\tvalue := canary.Value(mech.name)\n401\t\t\t\t\th := newHarness(t, mech.env(value))\n402\t\t\t\t\tsrv := newServer(t, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n403\t\n404\t\t\t\t\tres := h.runOK(\"run\", specPath, \"--operation\", mech.op,\n405\t\t\t\t\t\t\"--base-url\", srv.URL, \"--report\", format)\n406\t\n407\t\t\t\t\tif !mech.received(srv.received(), value) {\n408\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s credential; the leak assertions below prove nothing\", mech.name)\n409\t\t\t\t\t}\n410\t\t\t\t\t// A report that named the operation is a report that rendered.\n411\t\t\t\t\t// Without this a format writing an empty shell would pass every\n412\t\t\t\t\t// assertion below by having nothing in it at all.\n413\t\t\t\t\tif !strings.Contains(res.stdout, mech.op) {\n414\t\t\t\t\t\tt.Errorf(\"`--report %s` does not name the operation it ran:\\n%s\", format, res.stdout)\n415\t\t\t\t\t}\n416\t\n417\t\t\t\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n418\t\t\t\t})\n419\t\t\t}\n420\t\t}\n421\t}\n422\t\n423\t// TestErrorPathsDoNotLeakTheCredential covers §5a's \"error paths are where\n424\t// redaction bugs live\": a failure at each stage of a call, with a credential\n425\t// present throughout.\n426\tfunc TestErrorPathsDoNotLeakTheCredential(t *testing.T) {\n427\t\t// A response-validation failure is not here because response validation is\n428\t\t// not built yet (plan tasks 26 and 27). Whoever adds --fail-on-error adds\n429\t\t// the case; the stages that exist are all covered.\n430\t\tstages := []struct {\n431\t\t\tname string\n432\t\t\targs func(serverURL string) []string\n433\t\t\tcode int\n434\t\t}{\n435\t\t\t{\n436\t\t\t\tname: \"spec load\",\n437\t\t\t\targs: func(string) []string { return []string{\"call\", \"testdata/absent.yaml\", \"getBearer\"} },\n438\t\t\t\tcode: 3,\n439\t\t\t},\n440\t\t\t{\n441\t\t\t\tname: \"operation lookup\",\n442\t\t\t\targs: func(string) []string { return []string{\"call\", specPath, \"noSuchOperation\"} },\n443\t\t\t\tcode: 2,\n444\t\t\t},\n445\t\t\t{\n446\t\t\t\tname: \"parameter binding\",\n447\t\t\t\targs: func(url string) []string {\n448\t\t\t\t\t// getPet's petId is required and unbound.\n449\t\t\t\t\treturn []string{\"call\", specPath, \"getPet\", \"--base-url\", url}\n450\t\t\t\t},\n451\t\t\t\tcode: 2,\n452\t\t\t},\n453\t\t\t{\n454\t\t\t\tname: \"mutation gate\",\n455\t\t\t\targs: func(url string) []string {\n456\t\t\t\t\treturn []string{\"call\", specPath, \"createThing\", \"--base-url\", url}\n457\t\t\t\t},\n458\t\t\t\tcode: 2,\n459\t\t\t},\n460\t\t\t{\n461\t\t\t\tname: \"body read\",\n462\t\t\t\targs: func(url string) []string {\n463\t\t\t\t\treturn []string{\"call\", specPath, \"getBearer\", \"--base-url\", url, \"--body\", \"@testdata/absent.json\"}\n464\t\t\t\t},\n465\t\t\t\tcode: 2,\n466\t\t\t},\n467\t\t\t{\n468\t\t\t\tname: \"curl exec\",\n469\t\t\t\targs: func(string) []string {\n470\t\t\t\t\t// Port 1 on the loopback interface: curl runs, the request fails.\n471\t\t\t\t\treturn []string{\"call\", specPath, \"getBearer\", \"--base-url\", \"http://127.0.0.1:1\"}\n472\t\t\t\t},\n473\t\t\t\tcode: 1,\n474\t\t\t},\n475\t\t\t{\n476\t\t\t\tname: \"history index\",\n477\t\t\t\targs: func(string) []string { return []string{\"history\", \"show\", \"99\"} },\n478\t\t\t\tcode: 2,\n479\t\t\t},\n480\t\t}\n481\t\n482\t\tfor _, stage := range stages {\n483\t\t\tt.Run(stage.name, func(t *testing.T) {\n484\t\t\t\tt.Parallel()\n485\t\n486\t\t\t\tvalue := canary.Value(\"error\")\n487\t\t\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n488\t\t\t\tsrv := newServer(t, `{}`)\n489\t\n490\t\t\t\tres := h.run(stage.args(srv.URL)...)\n491\t\t\t\tif res.code != stage.code {\n492\t\t\t\t\tt.Errorf(\"talaria %s = %d, want %d; stderr: %s\",\n493\t\t\t\t\t\tstrings.Join(res.args, \" \"), res.code, stage.code, res.stderr)\n494\t\t\t\t}\n495\t\t\t\tif strings.TrimSpace(res.stderr) == \"\" {\n496\t\t\t\t\tt.Errorf(\"talaria %s failed silently; there is no error surface to check\",\n497\t\t\t\t\t\tstrings.Join(res.args, \" \"))\n498\t\t\t\t}\n499\t\n500\t\t\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n501\t\t\t})\n502\t\t}\n503\t}\n504\t\n505\t// TestAMalformedFlagDoesNotEchoItsValue covers the error path where the\n506\t// credential is in the *argv*: the user wrote curl's `Authorization: Bearer …`\n507\t// form, or repeated --body, and talaria refuses the invocation.\n508\t//\n509\t// The canary rides in the rejected argument itself rather than in the\n510\t// environment, which is what makes this stage different from every other one in\n511\t// this suite — here the value talaria must not print is a value it was handed\n512\t// directly, and the message that refuses it is the surface most likely to quote\n513\t// it back. §5a puts error paths inside the firewall.\n514\t//\n515\t// There is no --report surface: `run` takes no --header, --query or --body, so\n516\t// a malformed one cannot reach it. --output covers what the failing command\n517\t// does render, and h.written() covers the history store.\n518\tfunc TestAMalformedFlagDoesNotEchoItsValue(t *testing.T) {\n519\t\tcases := []struct {\n520\t\t\tname string\n521\t\t\t// args builds the flags carrying the canary, appended to a `call`.\n522\t\t\targs func(value string) []string\n523\t\t\t// wants are the substrings the refusal must carry, so a message that\n524\t\t\t// said nothing at all could not pass by leaking nothing.\n525\t\t\twants []string\n526\t\t}{\n527\t\t\t{\n528\t\t\t\tname: \"header in curl's colon form\",\n529\t\t\t\targs: func(v string) []string {\n530\t\t\t\t\treturn []string{\"--header\", \"Authorization: Bearer \" + v}\n531\t\t\t\t},\n532\t\t\t\twants: []string{\"--header 1\", \"Authorization\"},\n533\t\t\t},\n534\t\t\t{\n535\t\t\t\tname: \"header whose name half is not a field name\",\n536\t\t\t\targs: func(v string) []string {\n537\t\t\t\t\treturn []string{\"--header\", \"X-Trace: \" + v + \"=1\"}\n538\t\t\t\t},\n539\t\t\t\twants: []string{\"--header 1\", \"X-Trace\"},\n540\t\t\t},\n541\t\t\t{\n542\t\t\t\tname: \"query in the colon form\",\n543\t\t\t\targs: func(v string) []string {\n544\t\t\t\t\treturn []string{\"--query\", \"api_key: \" + v}\n545\t\t\t\t},\n546\t\t\t\twants: []string{\"--query 1\", \"api_key\"},\n547\t\t\t},\n548\t\t\t{\n549\t\t\t\tname: \"repeated body\",\n550\t\t\t\targs: func(v string) []string {\n551\t\t\t\t\treturn []string{\n552\t\t\t\t\t\t\"--body\", `{\"client_secret\":\"` + v + `\"}`,\n553\t\t\t\t\t\t\"--body\", \"@/tmp/\" + v + \".json\",\n554\t\t\t\t\t}\n555\t\t\t\t},\n556\t\t\t\twants: []string{\"--body\", \"2 times\", \"literal\", \"@file\"},\n557\t\t\t},\n558\t\t}\n559\t\n560\t\tfor _, tc := range cases {\n561\t\t\tfor _, format := range canary.Formats() {\n562\t\t\t\tt.Run(tc.name+\"/\"+format, func(t *testing.T) {\n563\t\t\t\t\tt.Parallel()\n564\t\n565\t\t\t\t\tvalue := canary.Value(\"argv\")\n566\t\t\t\t\th := newHarness(t, nil)\n567\t\t\t\t\tsrv := newServer(t, `{\"ok\":true}`)\n568\t\n569\t\t\t\t\tvar runs []result\n570\t\t\t\t\tfor _, extra := range [][]string{{\"--dry-run\"}, nil} {\n571\t\t\t\t\t\targs := append([]string{\"call\", specPath, \"getPublic\",\n572\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--output\", format}, tc.args(value)...)\n573\t\t\t\t\t\tres := h.run(append(args, extra...)...)\n574\t\t\t\t\t\tif res.code != 2 {\n575\t\t\t\t\t\t\tt.Errorf(\"talaria %s = %d, want 2; stderr: %s\",\n576\t\t\t\t\t\t\t\tstrings.Join(res.args, \" \"), res.code, res.stderr)\n577\t\t\t\t\t\t}\n578\t\t\t\t\t\tfor _, want := range tc.wants {\n579\t\t\t\t\t\t\tif !strings.Contains(res.stderr, want) {\n580\t\t\t\t\t\t\t\tt.Errorf(\"the refusal does not mention %q:\\n%s\", want, res.stderr)\n581\t\t\t\t\t\t\t}\n582\t\t\t\t\t\t}\n583\t\t\t\t\t\truns = append(runs, res)\n584\t\t\t\t\t}\n585\t\t\t\t\t// The history store is a surface whether or not the refused call\n586\t\t\t\t\t// reached it, so it is listed and scanned either way.\n587\t\t\t\t\truns = append(runs, h.runOK(\"history\", \"--output\", format))\n588\t\n589\t\t\t\t\tvar surfaces []canary.Surface\n590\t\t\t\t\tfor _, res := range runs {\n591\t\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n592\t\t\t\t\t}\n593\t\n594\t\t\t\t\tassertNoLeak(t, value, append(surfaces, h.written()...))\n595\t\t\t\t})\n596\t\t\t}\n597\t\t}\n598\t}\n599\t\n600\t// TestABaseURLCredentialIsRefusedWithoutEchoingIt covers the credential\n601\t// position a URL has no symbolic form for: `--base-url http://user:pass@host`.\n602\t//\n603\t// Accepting it would write the value into request.url, the emitted curl and\n604\t// history.jsonl in cleartext, so talaria refuses it and points at\n605\t// TALARIA_AUTH_BASIC. That makes the refusal an error surface holding a\n606\t// credential it was handed directly — the case §5a calls out — so it must name\n607\t// the host and nothing else.\n608\tfunc TestABaseURLCredentialIsRefusedWithoutEchoingIt(t *testing.T) {\n609\t\tfor _, format := range canary.Formats() {\n610\t\t\tt.Run(format, func(t *testing.T) {\n611\t\t\t\tt.Parallel()\n612\t\n613\t\t\t\tvalue := canary.Value(\"userinfo\")\n614\t\t\t\th := newHarness(t, nil)\n615\t\t\t\tsrv := newServer(t, `{\"ok\":true}`)\n616\t\t\t\tbase := \"http://canaryuser:\" + value + \"@\" + strings.TrimPrefix(srv.URL, \"http://\")\n617\t\n618\t\t\t\tvar runs []result\n619\t\t\t\tfor _, extra := range [][]string{{\"--dry-run\"}, nil} {\n620\t\t\t\t\targs := append([]string{\"call\", specPath, \"getPublic\",\n621\t\t\t\t\t\t\"--base-url\", base, \"--output\", format}, extra...)\n622\t\t\t\t\tres := h.run(args...)\n623\t\t\t\t\tif res.code != 2 {\n624\t\t\t\t\t\tt.Errorf(\"talaria %s = %d, want 2; stderr: %s\",\n625\t\t\t\t\t\t\tstrings.Join(res.args, \" \"), res.code, res.stderr)\n626\t\t\t\t\t}\n627\t\t\t\t\tif !strings.Contains(res.stderr, \"TALARIA_AUTH_BASIC\") {\n628\t\t\t\t\t\tt.Errorf(\"the refusal does not point at the supported path:\\n%s\", res.stderr)\n629\t\t\t\t\t}\n630\t\t\t\t\truns = append(runs, res)\n631\t\t\t\t}\n632\t\t\t\t// The history store is a surface whether or not the refused call\n633\t\t\t\t// reached it, so it is listed and scanned either way.\n634\t\t\t\truns = append(runs, h.runOK(\"history\", \"--output\", format))\n635\t\n636\t\t\t\tvar surfaces []canary.Surface\n637\t\t\t\tfor _, res := range runs {\n638\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n639\t\t\t\t}\n640\t\n641\t\t\t\tassertNoLeak(t, value, append(surfaces, h.written()...))\n642\t\t\t})\n643\t\t}\n644\t}\n645\t\n646\t// TestACredentialResolutionFailureNamesNoValue covers the one error path where\n647\t// the credential is in a *configuration file* rather than the environment: a\n648\t// profile with a literal value is refused, and the refusal must not quote what\n649\t// it refused (§5a).\n650\tfunc TestACredentialResolutionFailureNamesNoValue(t *testing.T) {\n651\t\tt.Parallel()\n652\t\n653\t\tvalue := canary.Value(\"profile\")\n654\t\th := newHarness(t, nil)\n655\t\twriteConfig(t, h, \"profiles:\\n  staging:\\n    auth:\\n      bearerAuth: \"+value+\"\\n\")\n656\t\n657\t\tres := h.run(\"call\", specPath, \"getBearer\", \"--profile\", \"staging\", \"--dry-run\")\n658\t\tif res.code != 2 {\n659\t\t\tt.Errorf(\"a literal profile credential = %d, want 2; stderr: %s\", res.code, res.stderr)\n660\t\t}\n661\t\n662\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n663\t}\n664\t\n665\t// TestAMissingCredentialIsReportedWithoutAValue exercises the exit-5 path with\n666\t// a canary set for a *different* scheme, so the report is built while a\n667\t// credential is in reach.\n668\tfunc TestAMissingCredentialIsReportedWithoutAValue(t *testing.T) {\n669\t\tt.Parallel()\n670\t\n671\t\tvalue := canary.Value(\"authcheck\")\n672\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n673\t\n674\t\t// Every other scheme in the fixture is unset, so `auth check` reports the\n675\t\t// gap and exits 5.\n676\t\tres := h.run(\"auth\", \"check\", specPath, \"--output\", \"json\")\n677\t\tif res.code != 5 {\n678\t\t\tt.Errorf(\"auth check with schemes unset = %d, want 5; stderr: %s\", res.code, res.stderr)\n679\t\t}\n680\t\n681\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n682\t}\n683\t\n684\t// TestAUserSuppliedHeaderIsRedactedLikeASpecCredential holds the line the\n685\t// Redactor already claims: \"a bearer token the user typed into --header is as\n686\t// sensitive as one talaria resolved itself\". The value's origin does not change\n687\t// what it is.\n688\t//\n689\t// The --query case is here rather than in a test of its own because it is the\n690\t// same claim about a different flag: §5a names query-string API keys as a\n691\t// credential location, so `--query api_key=…` is covered by the built-in name\n692\t// matcher exactly as `--header X-Api-Key: …` is.\n693\tfunc TestAUserSuppliedHeaderIsRedactedLikeASpecCredential(t *testing.T) {\n694\t\tcases := []struct {\n695\t\t\tname string\n696\t\t\tflag string\n697\t\t\t// arg builds the flag's name=value argument around the canary.\n698\t\t\targ func(value string) string\n699\t\t\t// sent returns what the server actually received under that name, so\n700\t\t\t// each case can prove the value still went out before asserting that\n701\t\t\t// no surface printed it.\n702\t\t\tsent func(name string, req recordedRequest) string\n703\t\t}{\n704\t\t\t{\n705\t\t\t\tname: \"authorization\",\n706\t\t\t\tflag: \"--header\",\n707\t\t\t\targ:  func(v string) string { return \"Authorization=Bearer \" + v },\n708\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Header.Get(name) },\n709\t\t\t},\n710\t\t\t{\n711\t\t\t\tname: \"api-key\",\n712\t\t\t\tflag: \"--header\",\n713\t\t\t\targ:  func(v string) string { return \"X-Api-Key=\" + v },\n714\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Header.Get(name) },\n715\t\t\t},\n716\t\t\t{\n717\t\t\t\tname: \"token\",\n718\t\t\t\tflag: \"--header\",\n719\t\t\t\targ:  func(v string) string { return \"X-Session-Token=\" + v },\n720\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Header.Get(name) },\n721\t\t\t},\n722\t\t\t{\n723\t\t\t\tname: \"query-api-key\",\n724\t\t\t\tflag: \"--query\",\n725\t\t\t\targ:  func(v string) string { return \"api_key=\" + v },\n726\t\t\t\tsent: func(name string, req recordedRequest) string { return req.Query.Get(name) },\n727\t\t\t},\n728\t\t}\n729\t\n730\t\tfor _, tc := range cases {\n731\t\t\tfor _, format := range canary.Formats() {\n732\t\t\t\tt.Run(tc.name+\"/\"+format, func(t *testing.T) {\n733\t\t\t\t\tt.Parallel()\n734\t\n735\t\t\t\t\tvalue := canary.Value(\"header\")\n736\t\t\t\t\th := newHarness(t, nil)\n737\t\t\t\t\tsrv := newServer(t, `{\"ok\":true}`)\n738\t\n739\t\t\t\t\truns := []result{\n740\t\t\t\t\t\th.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL,\n741\t\t\t\t\t\t\ttc.flag, tc.arg(value), \"--output\", format, \"--dry-run\"),\n742\t\t\t\t\t\th.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL,\n743\t\t\t\t\t\t\ttc.flag, tc.arg(value), \"--output\", format),\n744\t\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n745\t\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n746\t\t\t\t\t}\n747\t\n748\t\t\t\t\t// It still has to arrive: redaction is about what talaria prints,\n749\t\t\t\t\t// not about dropping what the user asked to send.\n750\t\t\t\t\tname := strings.SplitN(tc.arg(value), \"=\", 2)[0]\n751\t\t\t\t\tif got := tc.sent(name, srv.received()); !strings.Contains(got, value) {\n752\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s value; the leak assertions below prove nothing\", tc.flag)\n753\t\t\t\t\t}\n754\t\n755\t\t\t\t\tvar surfaces []canary.Surface\n756\t\t\t\t\tfor _, res := range runs {\n757\t\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n758\t\t\t\t\t}\n759\t\n760\t\t\t\t\tassertNoLeak(t, value, append(surfaces, h.written()...))\n761\t\t\t\t})\n762\t\t\t}\n763\t\t}\n764\t}\n765\t\n766\t// TestConfiguredRedactHeadersCoversTheDisplayedRequest is the user-extensible\n767\t// list at the surface it exists for. `redact.headers` reaching history but not\n768\t// the stdout an agent reads would protect the permanent artifact and leave the\n769\t// live one in the clear, which is the firewall backwards.\n770\t//\n771\t// X-Session-Id matches nothing built in — *token* and *secret* do not catch it\n772\t// — so a pass here is the configured pattern doing the work and nothing else.\n773\t// The companion test below proves that by removing the config.\n774\tfunc TestConfiguredRedactHeadersCoversTheDisplayedRequest(t *testing.T) {\n775\t\tfor _, format := range canary.Formats() {\n776\t\t\tt.Run(format, func(t *testing.T) {\n777\t\t\t\tt.Parallel()\n778\t\n779\t\t\t\tvalue := canary.Value(\"configured\")\n780\t\t\t\th := newHarness(t, nil)\n781\t\t\t\tsrv := newServer(t, `{\"ok\":true}`)\n782\t\t\t\twriteConfig(t, h, \"redact:\\n  headers:\\n    - 'x-session-*'\\n\")\n783\t\n784\t\t\t\tcall := []string{\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL,\n785\t\t\t\t\t\"--header\", \"X-Session-Id=\" + value, \"--output\", format}\n786\t\t\t\truns := []result{\n787\t\t\t\t\th.runOK(append(call, \"--dry-run\")...),\n788\t\t\t\t\th.runOK(call...),\n789\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n790\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n791\t\t\t\t}\n792\t\n793\t\t\t\t// Configuring a display pattern hides the value; it does not stop\n794\t\t\t\t// talaria sending the header the user asked for.\n795\t\t\t\tif got := srv.received().Header.Get(\"X-Session-Id\"); !strings.Contains(got, value) {\n796\t\t\t\t\tt.Fatalf(\"the server never saw X-Session-Id; the leak assertions below prove nothing\")\n797\t\t\t\t}\n798\t\n799\t\t\t\tvar surfaces []canary.Surface\n800\t\t\t\tfor _, res := range runs {\n801\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n802\t\t\t\t}\n803\t\n804\t\t\t\tassertNoLeak(t, value, append(surfaces, h.written()...))\n805\t\t\t})\n806\t\t}\n807\t}\n808\t\n809\t// TestAnUnconfiguredHeaderNameIsNotRedacted is the control for the test above:\n810\t// the same header under the same flag, with no `redact.headers` entry, is shown.\n811\t// Without it a redaction bug that hid everything would pass as a success.\n812\tfunc TestAnUnconfiguredHeaderNameIsNotRedacted(t *testing.T) {\n813\t\tt.Parallel()\n814\t\n815\t\tvalue := canary.Value(\"unconfigured\")\n816\t\th := newHarness(t, nil)\n817\t\tsrv := newServer(t, `{\"ok\":true}`)\n818\t\n819\t\tres := h.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL,\n820\t\t\t\"--header\", \"X-Session-Id=\"+value, \"--output\", \"json\", \"--dry-run\")\n821\t\tif !strings.Contains(res.stdout, value) {\n822\t\t\tt.Errorf(\"X-Session-Id was redacted with no pattern configured; the built-in list has grown \"+\n823\t\t\t\t\"and the test above no longer proves redact.headers does anything:\\n%s\", res.stdout)\n824\t\t}\n825\t}\n826\t\n827\t// TestAnUnconfiguredResponseBodySecretIsNotRedacted documents the boundary\n828\t// rather than pretending it is elsewhere. §5a redacts response headers and the\n829\t// RFC 6749 token fields by name; a secret under an API-specific name is the\n830\t// known uncovered threat, because talaria cannot tell a credential from any\n831\t// other string by looking at it.\n832\t//\n833\t// If this ever fails because the value was redacted, the boundary moved and the\n834\t// documentation — AGENT.md, DESIGN.md §5a — moves with it.\n835\tfunc TestAnUnconfiguredResponseBodySecretIsNotRedacted(t *testing.T) {\n836\t\tt.Parallel()\n837\t\n838\t\tvalue := canary.Value(\"response\")\n839\t\th := newHarness(t, nil)\n840\t\tsrv := newServer(t, `{\"access_token\":\"issued\",\"data\":{\"session\":\"`+value+`\"}}`)\n841\t\n842\t\tres := h.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", \"json\")\n843\t\tif !strings.Contains(res.stdout, value) {\n844\t\t\tt.Errorf(\"an unconfigured response body secret was redacted; the documented boundary has moved:\\n%s\", res.stdout)\n845\t\t}\n846\t\t// The names talaria *can* recognise are covered without configuration, which\n847\t\t// is what makes the above a boundary rather than an absence of redaction.\n848\t\tif strings.Contains(res.stdout, `\"issued\"`) {\n849\t\t\tt.Errorf(\"the built-in access_token body path was not redacted:\\n%s\", res.stdout)\n850\t\t}\n851\t\n852\t\t// And the configured countermeasure closes the rest of the gap.\n853\t\twriteConfig(t, h, \"redact:\\n  body-paths:\\n    - data.session\\n\")\n854\t\n855\t\tres = h.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", \"json\")\n856\t\tif strings.Contains(res.stdout, value) {\n857\t\t\tt.Errorf(\"redact.body-paths did not redact the configured path:\\n%s\", res.stdout)\n858\t\t}\n859\t}\n860\t\n861\t// TestAnArrayResponseBodyIsRedacted gates the two shapes body redaction used to\n862\t// walk straight past: a top-level JSON array, and an array nested under an\n863\t// object. Both are ordinary collection responses, and §5a redacts at write\n864\t// time, so a miss here does not merely print the token once — it files it in\n865\t// history.jsonl for good.\n866\t//\n867\t// The marker field is the proof the body reached each surface at all: without\n868\t// it, a version that dropped response bodies entirely would pass.\n869\tfunc TestAnArrayResponseBodyIsRedacted(t *testing.T) {\n870\t\tcases := []struct {\n871\t\t\tname string\n872\t\t\tbody func(value string) string\n873\t\t\t// config is the redact.body-paths entry the shape needs, if any. A\n874\t\t\t// top-level array needs none: the built-in paths reach it.\n875\t\t\tconfig string\n876\t\t}{\n877\t\t\t{\n878\t\t\t\tname: \"top-level\",\n879\t\t\t\tbody: func(v string) string {\n880\t\t\t\t\treturn `[{\"access_token\":\"` + v + `\",\"marker\":\"canary-marker\"}]`\n881\t\t\t\t},\n882\t\t\t},\n883\t\t\t{\n884\t\t\t\tname: \"nested\",\n885\t\t\t\tbody: func(v string) string {\n886\t\t\t\t\treturn `{\"items\":[{\"access_token\":\"` + v + `\",\"marker\":\"canary-marker\"}]}`\n887\t\t\t\t},\n888\t\t\t\tconfig: \"redact:\\n  body-paths:\\n    - items.access_token\\n\",\n889\t\t\t},\n890\t\t}\n891\t\n892\t\tfor _, tc := range cases {\n893\t\t\tfor _, format := range canary.Formats() {\n894\t\t\t\tt.Run(tc.name+\"/\"+format, func(t *testing.T) {\n895\t\t\t\t\tt.Parallel()\n896\t\n897\t\t\t\t\tvalue := canary.Value(\"array-body\")\n898\t\t\t\t\th := newHarness(t, nil)\n899\t\t\t\t\tsrv := newServer(t, tc.body(value))\n900\t\t\t\t\tif tc.config != \"\" {\n901\t\t\t\t\t\twriteConfig(t, h, tc.config)\n902\t\t\t\t\t}\n903\t\n904\t\t\t\t\truns := []result{\n905\t\t\t\t\t\th.runOK(\"call\", specPath, \"getPublic\", \"--base-url\", srv.URL, \"--output\", format),\n906\t\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n907\t\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n908\t\t\t\t\t\t// The stored entry, which carries the body whatever the format\n909\t\t\t\t\t\t// above chose to display. Only json renders a response body, so\n910\t\t\t\t\t\t// this is where the shape can be proved to have arrived.\n911\t\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", \"json\"),\n912\t\t\t\t\t}\n913\t\n914\t\t\t\t\tif stored := runs[len(runs)-1].stdout; !strings.Contains(stored, \"canary-marker\") {\n915\t\t\t\t\t\tt.Fatalf(\"the response body never reached the history entry; \"+\n916\t\t\t\t\t\t\t\"the leak assertions below prove nothing:\\n%s\", stored)\n917\t\t\t\t\t}\n918\t\n919\t\t\t\t\tvar surfaces []canary.Surface\n920\t\t\t\t\tfor _, res := range runs {\n921\t\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n922\t\t\t\t\t}\n923\t\n924\t\t\t\t\tassertNoLeak(t, value, append(surfaces, h.written()...))\n925\t\t\t\t})\n926\t\t\t}\n927\t\t}\n928\t}\n929\t\n930\t// TestNoCommandExposesAVerboseOrDebugFlag is §5a's \"no --verbose that bypasses\n931\t// [redaction]\" in its strongest form: there is no such flag to bypass it.\n932\t// Whoever adds one inherits this test, and with it the obligation to route it\n933\t// through the redacted representation.\n934\tfunc TestNoCommandExposesAVerboseOrDebugFlag(t *testing.T) {\n935\t\tt.Parallel()\n936\t\n937\t\th := newHarness(t, nil)\n938\t\tcommands := listCommands(t, h)\n939\t\n940\t\t// A parse that found nothing would pass silently, so the shape of the help\n941\t\t// output is asserted before anything is concluded from it.\n942\t\tfor _, want := range []string{\"call\", \"list\", \"describe\", \"search\", \"uses\", \"auth\", \"history\", \"version\"} {\n943\t\t\tif !contains(commands, want) {\n944\t\t\t\tt.Fatalf(\"parsed the command list as %v, which is missing %q\", commands, want)\n945\t\t\t}\n946\t\t}\n947\t\n948\t\tfor _, name := range commands {\n949\t\t\tfor _, flag := range []string{\"--verbose\", \"--debug\"} {\n950\t\t\t\tres := h.run(name, flag)\n951\t\t\t\tif res.code != 2 {\n952\t\t\t\t\tt.Errorf(\"`talaria %s %s` = %d, want 2 (unknown flag); stdout: %s stderr: %s\",\n953\t\t\t\t\t\tname, flag, res.code, res.stdout, res.stderr)\n954\t\t\t\t}\n955\t\t\t}\n956\t\n957\t\t\t// A hidden flag would not fail above but also would not be advertised,\n958\t\t\t// so the help text is checked too.\n959\t\t\thelp := h.run(name, \"--help\")\n960\t\t\tfor _, flag := range []string{\"--verbose\", \"--debug\"} {\n961\t\t\t\tif strings.Contains(help.stdout, flag) {\n962\t\t\t\t\tt.Errorf(\"`talaria %s --help` advertises %s:\\n%s\", name, flag, help.stdout)\n963\t\t\t\t}\n964\t\t\t}\n965\t\t}\n966\t}\n967\t\n968\t// TestASpecFetchedOverHTTPLeavesNoCredentialInTheCache covers the spec cache as\n969\t// a surface with something actually in it — a cache that was never written is\n970\t// not evidence of anything.\n971\tfunc TestASpecFetchedOverHTTPLeavesNoCredentialInTheCache(t *testing.T) {\n972\t\tt.Parallel()\n973\t\n974\t\tspec, err := os.ReadFile(specPath)\n975\t\tif err != nil {\n976\t\t\tt.Fatalf(\"reading the fixture: %v\", err)\n977\t\t}\n978\t\n979\t\tvalue := canary.Value(\"cache\")\n980\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n981\t\n982\t\tsrv := newServer(t, `{\"ok\":true}`)\n983\t\tspecSrv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {\n984\t\t\t_, _ = w.Write(spec)\n985\t\t}))\n986\t\tt.Cleanup(specSrv.Close)\n987\t\n988\t\tres := h.runOK(\"call\", specSrv.URL+\"/openapi.yaml\", \"getBearer\",\n989\t\t\t\"--base-url\", srv.URL, \"--output\", \"json\")\n990\t\n991\t\tcached, err := canary.Tree(\"cache\", h.cache)\n992\t\tif err != nil {\n993\t\t\tt.Fatalf(\"enumerating the cache: %v\", err)\n994\t\t}\n995\t\tif len(cached) == 0 {\n996\t\t\tt.Fatal(\"the spec cache is empty; the fetch did not exercise the surface this test is about\")\n997\t\t}\n998\t\n999\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n1000\t}\n1001\t\n1002\t// TestAPlantedCurlrcCannotCaptureTheCredential covers the capability §5a does\n1003\t// not concede: an attacker who can write one file under $HOME but cannot read\n1004\t// the environment.\n1005\t//\n1006\t// curl parses $HOME/.curlrc before the `-K -` document, so without curl's -q a\n1007\t// `trace-ascii` line there writes the plaintext Authorization header — the one\n1008\t// place in the process the credential is resolved — to a path of the writer's\n1009\t// choosing, at whatever mode their umask gives. The redacted output surfaces\n1010\t// stay clean throughout, which is why this needs a case of its own: every other\n1011\t// assertion in this suite would pass while the token sat in the trace file.\n1012\tfunc TestAPlantedCurlrcCannotCaptureTheCredential(t *testing.T) {\n1013\t\tt.Parallel()\n1014\t\n1015\t\tvalue := canary.Value(\"curlrc\")\n1016\t\th := newHarness(t, map[string]string{\"TALARIA_AUTH_BEARER\": value})\n1017\t\tsrv := newServer(t, `{\"ok\":true}`)\n1018\t\n1019\t\ttrace := filepath.Join(h.home, \"trace.txt\")\n1020\t\tcurlrc := filepath.Join(h.home, \".curlrc\")\n1021\t\tif err := os.WriteFile(curlrc, []byte(\"trace-ascii = \"+trace+\"\\n\"), 0o600); err != nil {\n1022\t\t\tt.Fatalf(\"planting the .curlrc: %v\", err)\n1023\t\t}\n1024\t\n1025\t\tres := h.runOK(\"call\", specPath, \"getBearer\", \"--base-url\", srv.URL, \"--output\", \"json\")\n1026\t\n1027\t\t// The call has to have happened with the credential on it, or a missing\n1028\t\t// trace file would mean nothing.\n1029\t\tif got := srv.received().Header.Get(\"Authorization\"); got != \"Bearer \"+value {\n1030\t\t\tt.Fatalf(\"the server never saw the credential; the assertions below prove nothing\")\n1031\t\t}\n1032\t\n1033\t\tsurfaces := append(res.surfaces(), h.written()...)\n1034\t\tswitch _, err := os.Stat(trace); {\n1035\t\tcase err == nil:\n1036\t\t\t// The file existing is already the finding, but scanning it says whether\n1037\t\t\t// the credential is in it — the difference between a lost -q and a lost\n1038\t\t\t// firewall.\n1039\t\t\tfound, err := canary.Tree(\"curlrc trace\", trace)\n1040\t\t\tif err != nil {\n1041\t\t\t\tt.Fatalf(\"reading the trace file: %v\", err)\n1042\t\t\t}\n1043\t\t\tsurfaces = append(surfaces, found...)\n1044\t\t\tt.Errorf(\"curl honoured %s and wrote %s; the -q that disables it is gone from argv\", curlrc, trace)\n1045\t\tcase !errors.Is(err, fs.ErrNotExist):\n1046\t\t\tt.Fatalf(\"stating the trace file: %v\", err)\n1047\t\t}\n1048\t\n1049\t\tassertNoLeak(t, value, surfaces)\n1050\t}\n1051\t\n1052\t// assertNoLeak fails the test naming every surface the canary reached.\n1053\tfunc assertNoLeak(t *testing.T, value string, surfaces []canary.Surface) {\n1054\t\tt.Helper()\n1055\t\n1056\t\tleaks := canary.Scan(value, surfaces...)\n1057\t\tif len(leaks) == 0 {\n1058\t\t\treturn\n1059\t\t}\n1060\t\n1061\t\tvar names []string\n1062\t\tfor _, leak := range leaks {\n1063\t\t\tnames = append(names, leak.String())\n1064\t\t}\n1065\t\tt.Errorf(\"the canary reached %d surface(s):\\n  %s\", len(leaks), strings.Join(names, \"\\n  \"))\n1066\t}\n1067\t\n1068\t// listCommands reads the command names out of the root help, so a command\n1069\t// added later is checked without anyone remembering to list it here.\n1070\tfunc listCommands(t *testing.T, h *harness) []string {\n1071\t\tt.Helper()\n1072\t\n1073\t\thelp := h.runOK(\"--help\")\n1074\t\n1075\t\tvar names []string\n1076\t\tvar inList bool\n1077\t\tfor _, line := range strings.Split(help.stdout, \"\\n\") {\n1078\t\t\tswitch {\n1079\t\t\tcase strings.HasPrefix(line, \"Available Commands:\"):\n1080\t\t\t\tinList = true\n1081\t\t\tcase inList && strings.TrimSpace(line) == \"\":\n1082\t\t\t\tinList = false\n1083\t\t\tcase inList:\n1084\t\t\t\tif fields := strings.Fields(line); len(fields) > 0 {\n1085\t\t\t\t\tnames = append(names, fields[0])\n1086\t\t\t\t}\n1087\t\t\t}\n1088\t\t}\n1089\t\n1090\t\treturn names\n1091\t}\n1092\t\n1093\tfunc contains(haystack []string, needle string) bool {\n1094\t\tfor _, s := range haystack {\n1095\t\t\tif s == needle {\n1096\t\t\t\treturn true\n1097\t\t\t}\n1098\t\t}\n1099\t\n1100\t\treturn false\n1101\t}\n1102\t\n1103\t// writeConfig puts a config file in the harness's isolated config home.\n1104\tfunc writeConfig(t *testing.T, h *harness, yaml string) {\n1105\t\tt.Helper()\n1106\t\n1107\t\tdir := filepath.Join(h.conf, \"talaria\")\n1108\t\tif err := os.MkdirAll(dir, 0o700); err != nil {\n1109\t\t\tt.Fatalf(\"creating the config directory: %v\", err)\n1110\t\t}\n1111\t\tif err := os.WriteFile(filepath.Join(dir, \"config.yaml\"), []byte(yaml), 0o600); err != nil {\n1112\t\t\tt.Fatalf(\"writing the config file: %v\", err)\n1113\t\t}\n1114\t}\n1115\t"
      }
