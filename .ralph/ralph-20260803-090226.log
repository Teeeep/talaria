        "content": "1\tpackage spec\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"os\"\n6\t\t\"path/filepath\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t\t\"testing\"\n10\t)\n11\t\n12\t// readFixture returns the raw bytes of a testdata file.\n13\tfunc readFixture(t *testing.T, name string) []byte {\n14\t\tt.Helper()\n15\t\n16\t\tdata, err := os.ReadFile(filepath.Join(\"testdata\", name))\n17\t\tif err != nil {\n18\t\t\tt.Fatalf(\"reading fixture %s: %v\", name, err)\n19\t\t}\n20\t\n21\t\treturn data\n22\t}\n23\t\n24\t// loadFixture loads a testdata spec, failing the test if it does not load.\n25\tfunc loadFixture(t *testing.T, name string) *Document {\n26\t\tt.Helper()\n27\t\n28\t\tdoc, err := LoadFile(filepath.Join(\"testdata\", name))\n29\t\tif err != nil {\n30\t\t\tt.Fatalf(\"LoadFile %s: %v\", name, err)\n31\t\t}\n32\t\n33\t\treturn doc\n34\t}\n35\t\n36\t// rawOperationIDs pulls the operationIds straight out of a Swagger 2.0 JSON\n37\t// fixture, so the conversion test compares against the source of truth rather\n38\t// than a hand-copied list that can drift from the fixture.\n39\tfunc rawOperationIDs(t *testing.T, data []byte) []string {\n40\t\tt.Helper()\n41\t\n42\t\tvar raw struct {\n43\t\t\tPaths map[string]map[string]struct {\n44\t\t\t\tOperationID string `json:\"operationId\"`\n45\t\t\t} `json:\"paths\"`\n46\t\t}\n47\t\tif err := json.Unmarshal(data, &raw); err != nil {\n48\t\t\tt.Fatalf(\"unmarshalling fixture: %v\", err)\n49\t\t}\n50\t\n51\t\tvar ids []string\n52\t\tfor _, item := range raw.Paths {\n53\t\t\tfor _, op := range item {\n54\t\t\t\tif op.OperationID != \"\" {\n55\t\t\t\t\tids = append(ids, op.OperationID)\n56\t\t\t\t}\n57\t\t\t}\n58\t\t}\n59\t\tsort.Strings(ids)\n60\t\n61\t\treturn ids\n62\t}\n63\t\n64\tfunc TestIsSwagger2DetectsTopLevelVersionKey(t *testing.T) {\n65\t\ttests := []struct {\n66\t\t\tname    string\n67\t\t\tfixture string\n68\t\t\twant    bool\n69\t\t}{\n70\t\t\t{name: \"swagger 2.0 json\", fixture: \"petstore-2.0.json\", want: true},\n71\t\t\t{name: \"swagger 2.0 yaml\", fixture: \"swagger2.yaml\", want: true},\n72\t\t\t{name: \"openapi 3.0 yaml\", fixture: \"petstore-3.0.yaml\", want: false},\n73\t\t\t{name: \"openapi 3.1 json\", fixture: \"petstore-3.1.json\", want: false},\n74\t\t}\n75\t\n76\t\tfor _, tt := range tests {\n77\t\t\tt.Run(tt.name, func(t *testing.T) {\n78\t\t\t\tif got := isSwagger2(readFixture(t, tt.fixture)); got != tt.want {\n79\t\t\t\t\tt.Errorf(\"isSwagger2(%s) = %v, want %v\", tt.fixture, got, tt.want)\n80\t\t\t\t}\n81\t\t\t})\n82\t\t}\n83\t}\n84\t\n85\t// The Phase 1 requirement is that 2.0 conversion is verified against a real\n86\t// spec: every operation the author wrote must still be addressable afterwards.\n87\tfunc TestLoadConvertsSwagger2PetstoreKeepingEveryOperation(t *testing.T) {\n88\t\tdoc := loadFixture(t, \"petstore-2.0.json\")\n89\t\n90\t\tif !strings.HasPrefix(doc.Version, \"3.\") {\n91\t\t\tt.Errorf(\"Version = %q, want a 3.x version\", doc.Version)\n92\t\t}\n93\t\tif doc.ConvertedFrom != \"2.0\" {\n94\t\t\tt.Errorf(\"ConvertedFrom = %q, want %q\", doc.ConvertedFrom, \"2.0\")\n95\t\t}\n96\t\n97\t\twant := rawOperationIDs(t, readFixture(t, \"petstore-2.0.json\"))\n98\t\tgot := operationIDs(t, doc)\n99\t\tif strings.Join(got, \",\") != strings.Join(want, \",\") {\n100\t\t\tt.Errorf(\"operationIds = %v, want %v\", got, want)\n101\t\t}\n102\t}\n103\t\n104\tfunc TestLoadRecordsNoConversionForOpenAPI3(t *testing.T) {\n105\t\tdoc := loadFixture(t, \"petstore-3.0.yaml\")\n106\t\n107\t\tif doc.ConvertedFrom != \"\" {\n108\t\t\tt.Errorf(\"ConvertedFrom = %q, want empty for a 3.x spec\", doc.ConvertedFrom)\n109\t\t}\n110\t}\n111\t\n112\t// host + basePath + schemes are three separate 2.0 fields describing one base\n113\t// URL. Request construction reads exactly one server, so they must collapse.\n114\tfunc TestConversionCollapsesHostBasePathAndSchemesIntoOneServer(t *testing.T) {\n115\t\tdoc := loadFixture(t, \"swagger2-apikey.json\")\n116\t\n117\t\tif got := len(doc.Model.Servers); got != 1 {\n118\t\t\tt.Fatalf(\"server count = %d, want 1\", got)\n119\t\t}\n120\t\tif got, want := doc.Model.Servers[0].URL, \"https://api.example.com/v1\"; got != want {\n121\t\t\tt.Errorf(\"server URL = %q, want %q\", got, want)\n122\t\t}\n123\t}\n124\t\n125\t// Auth mapping later binds credentials by scheme name, location and header\n126\t// name, so all three have to survive the move to components.securitySchemes.\n127\tfunc TestConversionPreservesSecurityDefinitions(t *testing.T) {\n128\t\tdoc := loadFixture(t, \"swagger2-apikey.json\")\n129\t\n130\t\tif doc.Model.Components == nil || doc.Model.Components.SecuritySchemes == nil {\n131\t\t\tt.Fatal(\"converted document has no components.securitySchemes\")\n132\t\t}\n133\t\n134\t\tscheme, ok := doc.Model.Components.SecuritySchemes.Get(\"apiKey\")\n135\t\tif !ok {\n136\t\t\tt.Fatalf(\"securitySchemes has no %q entry\", \"apiKey\")\n137\t\t}\n138\t\tif got, want := scheme.Type, \"apiKey\"; got != want {\n139\t\t\tt.Errorf(\"scheme type = %q, want %q\", got, want)\n140\t\t}\n141\t\tif got, want := scheme.In, \"header\"; got != want {\n142\t\t\tt.Errorf(\"scheme in = %q, want %q\", got, want)\n143\t\t}\n144\t\tif got, want := scheme.Name, \"X-API-Key\"; got != want {\n145\t\t\tt.Errorf(\"scheme name = %q, want %q\", got, want)\n146\t\t}\n147\t}\n148\t\n149\t// #/definitions/Pet has to become #/components/schemas/Pet and still resolve\n150\t// from the operation that referenced it, with required fields intact.\n151\tfunc TestConversionResolvesDefinitionRefs(t *testing.T) {\n152\t\tdoc := loadFixture(t, \"swagger2-apikey.json\")\n153\t\n154\t\tpathItem, ok := doc.Model.Paths.PathItems.Get(\"/pets/{petId}\")\n155\t\tif !ok {\n156\t\t\tt.Fatal(\"converted document has no /pets/{petId} path item\")\n157\t\t}\n158\t\tresponse, ok := pathItem.Get.Responses.Codes.Get(\"200\")\n159\t\tif !ok {\n160\t\t\tt.Fatal(\"getPet has no 200 response\")\n161\t\t}\n162\t\tmedia, ok := response.Content.Get(\"application/json\")\n163\t\tif !ok {\n164\t\t\tt.Fatal(\"getPet 200 response has no application/json content\")\n165\t\t}\n166\t\n167\t\tschema := media.Schema.Schema()\n168\t\tif schema == nil {\n169\t\t\tt.Fatal(\"getPet 200 schema did not resolve\")\n170\t\t}\n171\t\n172\t\tgot := append([]string(nil), schema.Required...)\n173\t\tsort.Strings(got)\n174\t\tif strings.Join(got, \",\") != \"id,name\" {\n175\t\t\tt.Errorf(\"required = %v, want [id name]\", got)\n176\t\t}\n177\t}\n178\t\n179\t// The YAML fixture describes the same API as the JSON one. If they diverge, a\n180\t// YAML→JSON bridge that mangles mappings is the likely cause, and every\n181\t// downstream command would silently see a different API depending on the file\n182\t// extension it was handed.\n183\tfunc TestConversionIsIndifferentToInputFormat(t *testing.T) {\n184\t\tfromJSON := loadFixture(t, \"swagger2-apikey.json\")\n185\t\tfromYAML := loadFixture(t, \"swagger2.yaml\")\n186\t\n187\t\tif got, want := operationIDs(t, fromYAML), operationIDs(t, fromJSON); strings.Join(got, \",\") != strings.Join(want, \",\") {\n188\t\t\tt.Errorf(\"operationIds = %v, want %v\", got, want)\n189\t\t}\n190\t\n191\t\tif got := len(fromYAML.Model.Servers); got != 1 {\n192\t\t\tt.Fatalf(\"server count = %d, want 1\", got)\n193\t\t}\n194\t\tif got, want := fromYAML.Model.Servers[0].URL, fromJSON.Model.Servers[0].URL; got != want {\n195\t\t\tt.Errorf(\"server URL = %q, want %q\", got, want)\n196\t\t}\n197\t\n198\t\tjsonScheme, ok := fromJSON.Model.Components.SecuritySchemes.Get(\"apiKey\")\n199\t\tif !ok {\n200\t\t\tt.Fatal(\"JSON fixture lost its apiKey scheme\")\n201\t\t}\n202\t\tyamlScheme, ok := fromYAML.Model.Components.SecuritySchemes.Get(\"apiKey\")\n203\t\tif !ok {\n204\t\t\tt.Fatal(\"YAML fixture lost its apiKey scheme\")\n205\t\t}\n206\t\tif yamlScheme.Type != jsonScheme.Type || yamlScheme.In != jsonScheme.In || yamlScheme.Name != jsonScheme.Name {\n207\t\t\tt.Errorf(\"scheme = %+v, want %+v\", yamlScheme, jsonScheme)\n208\t\t}\n209\t}\n210\t"
      }
