      {
        "tool_use_id": "toolu_01QkpsWpHXdUzFy1sY5J9NU7",
        "type": "tool_result",
        "content": "1\tpackage spec\n2\t\n3\timport (\n4\t\t\"crypto/sha256\"\n5\t\t\"encoding/hex\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"os\"\n9\t\t\"path/filepath\"\n10\t\t\"strings\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n14\t)\n15\t\n16\t// EnvSpec names the environment variable consulted when neither the positional\n17\t// argument nor --spec supplies a spec. Setting it once is what lets an agent\n18\t// run a dozen commands against the same API without repeating itself.\n19\tconst EnvSpec = \"TALARIA_SPEC\"\n20\t\n21\t// fetchTimeout bounds a remote spec fetch. A spec that never arrives has to\n22\t// become an exit code rather than a hung process an agent cannot interpret.\n23\tconst fetchTimeout = 30 * time.Second\n24\t\n25\t// cacheDirMode and cacheFileMode keep the cache private to its owner. Specs are\n26\t// other people's API descriptions and routinely carry example credentials and\n27\t// internal hostnames, so they are not world-readable.\n28\tconst (\n29\t\tcacheDirMode  os.FileMode = 0o700\n30\t\tcacheFileMode os.FileMode = 0o600\n31\t)\n32\t\n33\t// Resolve picks the spec source from the three ways of supplying one, in\n34\t// precedence order: positional argument, then --spec, then $TALARIA_SPEC. The\n35\t// result is a file path or a URL; classifying it is Load's job.\n36\tfunc Resolve(arg, flag string) (string, error) {\n37\t\tfor _, candidate := range []string{arg, flag, os.Getenv(EnvSpec)} {\n38\t\t\tif candidate != \"\" {\n39\t\t\t\treturn candidate, nil\n40\t\t\t}\n41\t\t}\n42\t\n43\t\treturn \"\", clierr.Usage(\n44\t\t\t\"no spec given: pass one as the positional argument, with --spec, or in $%s\", EnvSpec)\n45\t}\n46\t\n47\t// Loader loads a spec from a path or a URL, caching remote specs on disk. The\n48\t// zero value is usable and caches under the user cache dir; tests set CacheDir\n49\t// to a temporary directory so they never touch the real one.\n50\ttype Loader struct {\n51\t\t// CacheDir holds cached remote specs. Empty means\n52\t\t// $XDG_CACHE_HOME/talaria/specs (falling back to ~/.cache/talaria/specs).\n53\t\tCacheDir string\n54\t\t// Client fetches remote specs. Nil means a default client with\n55\t\t// fetchTimeout. Spec fetches deliberately use net/http: the rule that API\n56\t\t// traffic goes through curl is about calls the agent makes, not about\n57\t\t// reading the description of them.\n58\t\tClient *http.Client\n59\t}\n60\t\n61\t// Load reads the spec named by ref, which is either a URL or a file path.\n62\tfunc Load(ref string) (*Document, error) {\n63\t\treturn (&Loader{}).Load(ref)\n64\t}\n65\t\n66\t// Load reads the spec named by ref. A remote spec is served from the cache when\n67\t// one is present, so a session that makes a dozen calls downloads it once.\n68\tfunc (l *Loader) Load(ref string) (*Document, error) {\n69\t\tif !isURL(ref) {\n70\t\t\treturn LoadFile(ref)\n71\t\t}\n72\t\n73\t\treturn l.loadURL(ref)\n74\t}\n75\t\n76\t// isURL classifies a spec reference. Anything that is not plainly http(s) is a\n77\t// path, so Windows drive letters and relative paths stay paths.\n78\tfunc isURL(ref string) bool {\n79\t\treturn strings.HasPrefix(ref, \"http://\") || strings.HasPrefix(ref, \"https://\")\n80\t}\n81\t\n82\tfunc (l *Loader) loadURL(url string) (*Document, error) {\n83\t\t// A cache path that cannot be computed is not fatal: the fetch still works,\n84\t\t// it just will not be remembered.\n85\t\tcachePath, _ := l.cachePath(url)\n86\t\tif cachePath != \"\" {\n87\t\t\tif data, err := os.ReadFile(cachePath); err == nil {\n88\t\t\t\treturn loadBytes(data, url)\n89\t\t\t}\n90\t\t}\n91\t\n92\t\tdata, err := l.fetch(url)\n93\t\tif err != nil {\n94\t\t\treturn nil, err\n95\t\t}\n96\t\n97\t\t// Parse before caching. Caching first would make one bad response poison\n98\t\t// every later run, and the cache has no expiry an agent could reach.\n99\t\tdoc, err := loadBytes(data, url)\n100\t\tif err != nil {\n101\t\t\treturn nil, err\n102\t\t}\n103\t\n104\t\tif cachePath != \"\" {\n105\t\t\twriteCache(cachePath, data)\n106\t\t}\n107\t\n108\t\treturn doc, nil\n109\t}\n110\t\n111\tfunc (l *Loader) fetch(url string) ([]byte, error) {\n112\t\tclient := l.Client\n113\t\tif client == nil {\n114\t\t\tclient = &http.Client{Timeout: fetchTimeout}\n115\t\t}\n116\t\n117\t\tresp, err := client.Get(url)\n118\t\tif err != nil {\n119\t\t\treturn nil, clierr.SpecLoad(\"fetching spec %s: %w\", url, err)\n120\t\t}\n121\t\tdefer resp.Body.Close()\n122\t\n123\t\tif resp.StatusCode != http.StatusOK {\n124\t\t\treturn nil, clierr.SpecLoad(\"fetching spec %s: HTTP %s\", url, resp.Status)\n125\t\t}\n126\t\n127\t\tdata, err := io.ReadAll(resp.Body)\n128\t\tif err != nil {\n129\t\t\treturn nil, clierr.SpecLoad(\"reading spec %s: %w\", url, err)\n130\t\t}\n131\t\n132\t\treturn data, nil\n133\t}\n134\t\n135\t// cachePath is where the spec at url is cached. The name is the SHA-256 of the\n136\t// URL, so query strings and paths that would be illegal or colliding as\n137\t// filenames all get one stable, distinct entry.\n138\tfunc (l *Loader) cachePath(url string) (string, error) {\n139\t\tdir := l.CacheDir\n140\t\tif dir == \"\" {\n141\t\t\tbase, err := os.UserCacheDir()\n142\t\t\tif err != nil {\n143\t\t\t\treturn \"\", err\n144\t\t\t}\n145\t\t\tdir = filepath.Join(base, \"talaria\", \"specs\")\n146\t\t}\n147\t\n148\t\tsum := sha256.Sum256([]byte(url))\n149\t\n150\t\treturn filepath.Join(dir, hex.EncodeToString(sum[:])), nil\n151\t}\n152\t\n153\t// writeCache stores data at path. Caching is an optimisation, so every failure\n154\t// is dropped: a spec that loaded is not going to be reported as broken because\n155\t// it could not be written to disk afterwards.\n156\tfunc writeCache(path string, data []byte) {\n157\t\tdir := filepath.Dir(path)\n158\t\tif err := os.MkdirAll(dir, cacheDirMode); err != nil {\n159\t\t\treturn\n160\t\t}\n161\t\n162\t\t// Written to a temp file and renamed so a concurrent talaria never reads a\n163\t\t// half-written spec. CreateTemp already opens at 0600; the Chmod makes that\n164\t\t// a stated guarantee rather than an inherited default.\n165\t\ttmp, err := os.CreateTemp(dir, \".tmp-*\")\n166\t\tif err != nil {\n167\t\t\treturn\n168\t\t}\n169\t\tdefer os.Remove(tmp.Name())\n170\t\n171\t\tif _, err := tmp.Write(data); err != nil {\n172\t\t\ttmp.Close()\n173\t\t\treturn\n174\t\t}\n175\t\tif err := tmp.Chmod(cacheFileMode); err != nil {\n176\t\t\ttmp.Close()\n177\t\t\treturn\n178\t\t}\n179\t\tif err := tmp.Close(); err != nil {\n180\t\t\treturn\n181\t\t}\n182\t\n183\t\tos.Rename(tmp.Name(), path)\n184\t}\n185\t"
      }
