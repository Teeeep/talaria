 289 +++++\n 122 files changed, 28637 insertions(+)\n---TREE---\ncmd/talaria/agentdoc_test.go\ncmd/talaria/auth.go\ncmd/talaria/auth_test.go\ncmd/talaria/call_dryrun_test.go\ncmd/talaria/call.go\ncmd/talaria/call_redact_test.go\ncmd/talaria/call_test.go\ncmd/talaria/call_validate_test.go\ncmd/talaria/describe.go\ncmd/talaria/describe_test.go\ncmd/talaria/exitcode_test.go\ncmd/talaria/flags_test.go\ncmd/talaria/history.go\ncmd/talaria/history_test.go\ncmd/talaria/list.go\ncmd/talaria/list_test.go\ncmd/talaria/main.go\ncmd/talaria/main_test.go\ncmd/talaria/output_flag_test.go\ncmd/talaria/root.go\ncmd/talaria/run.go\ncmd/talaria/run_test.go\ncmd/talaria/search.go\ncmd/talaria/search_test.go\ncmd/talaria/uses.go\ncmd/talaria/uses_test.go\ncmd/talaria/version.go\ncmd/talaria/version_test.go\ninternal/canary/canary_test.go\ninternal/canary/surfaces.go\ninternal/ci/workflow_test.go\ninternal/clierr/clierr.go\ninternal/clierr/clierr_test.go\ninternal/config/auth.go\ninternal/config/auth_test.go\ninternal/config/config.go\ninternal/config/config_test.go\ninternal/corpus/entry.go\ninternal/corpus/entry_test.go\ninternal/corpus/lock_other.go\ninternal/corpus/lock_unix.go\ninternal/corpus/store.go\ninternal/corpus/store_test.go\ninternal/curl/config.go\ninternal/curl/config_test.go\ninternal/curl/exec.go\ninternal/curl/exec_test.go\ninternal/curl/procgroup_other.go\ninternal/curl/procgroup_unix.go\ninternal/curl/render.go\ninternal/curl/render_test.go\ninternal/curl/sweep.go\ninternal/curl/version.go\ninternal/e2e/boundary_test.go\ninternal/e2e/e2e_test.go\ninternal/gen/fixtures.go\ninternal/gen/fixtures_test.go\ninternal/gen/gen.go\ninternal/gen/gen_test.go\ninternal/operation/extract.go\ninternal/operation/index.go\ninternal/operation/index_test.go\ninternal/operation/operation.go\ninternal/operation/operation_test.go\ninternal/operation/search.go\ninternal/output/junit.go\ninternal/output/junit_test.go\ninternal/output/output.go\ninternal/output/render.go\ninternal/output/r