{
  "type": "user",
  "message": {
    "role": "user",
    "content": [
      {
        "tool_use_id": "toolu_01LGtx7ViUQkAmHAA2UTE2tF",
        "type": "tool_result",
        "content": "1\t// Package ci holds no code. It exists for one test: the CI workflow has to keep\n2\t// running the commands this project actually uses.\n3\t//\n4\t// The workflow is what turns the Task 24 canary suite from a file somebody could\n5\t// remember to run into a build gate, which §5a of the design requires (\"redaction\n6\t// regressions fail the build\"). A gate that runs invented commands, or a stale Go\n7\t// version, gates nothing — so the test reads the workflow and the two files it is\n8\t// supposed to agree with, and compares them.\n9\tpackage ci\n10\t\n11\timport (\n12\t\t\"encoding/json\"\n13\t\t\"os\"\n14\t\t\"path/filepath\"\n15\t\t\"strings\"\n16\t\t\"testing\"\n17\t\n18\t\t\"gopkg.in/yaml.v3\"\n19\t)\n20\t\n21\t// Paths are relative to this package directory.\n22\tconst (\n23\t\tworkflowPath = \"../../.github/workflows/ci.yml\"\n24\t\tstackPath    = \"../../.ralph/stack.json\"\n25\t\tgoModPath    = \"../../go.mod\"\n26\t)\n27\t\n28\t// workflow is the subset of GitHub Actions syntax this test reads.\n29\ttype workflow struct {\n30\t\tOn   map[string]yaml.Node `yaml:\"on\"`\n31\t\tJobs map[string]struct {\n32\t\t\tRunsOn string `yaml:\"runs-on\"`\n33\t\t\tSteps  []struct {\n34\t\t\t\tName string            `yaml:\"name\"`\n35\t\t\t\tUses string            `yaml:\"uses\"`\n36\t\t\t\tWith map[string]string `yaml:\"with\"`\n37\t\t\t\tRun  string            `yaml:\"run\"`\n38\t\t\t} `yaml:\"steps\"`\n39\t\t} `yaml:\"jobs\"`\n40\t}\n41\t\n42\t// stack is the subset of .ralph/stack.json that records shell commands.\n43\ttype stack struct {\n44\t\tBuildCommand string `json:\"build_command\"`\n45\t\tLintCommand  string `json:\"lint_command\"`\n46\t\tTestCommand  string `json:\"test_command\"`\n47\t}\n48\t\n49\tfunc loadWorkflow(t *testing.T) workflow {\n50\t\tt.Helper()\n51\t\n52\t\traw, err := os.ReadFile(filepath.FromSlash(workflowPath))\n53\t\tif err != nil {\n54\t\t\tt.Fatalf(\"reading the workflow: %v\", err)\n55\t\t}\n56\t\n57\t\tvar w workflow\n58\t\tif err := yaml.Unmarshal(raw, &w); err != nil {\n59\t\t\tt.Fatalf(\"parsing %s as YAML: %v\", workflowPath, err)\n60\t\t}\n61\t\n62\t\treturn w\n63\t}\n64\t\n65\tfunc loadStack(t *testing.T) stack {\n66\t\tt.Helper()\n67\t\n68\t\traw, err := os.ReadFile(filepath.FromSlash(stackPath))\n69\t\tif err != nil {\n70\t\t\tt.Fatalf(\"reading the stack file: %v\", err)\n71\t\t}\n72\t\n73\t\tvar s stack\n74\t\tif err := json.Unmarshal(raw, &s); err != nil {\n75\t\t\tt.Fatalf(\"parsing %s as JSON: %v\", stackPath, err)\n76\t\t}\n77\t\n78\t\treturn s\n79\t}\n80\t\n81\t// runCommands returns every shell command the workflow executes, in order.\n82\tfunc runCommands(w workflow) []string {\n83\t\tvar cmds []string\n84\t\n85\t\tfor _, job := range w.Jobs {\n86\t\t\tfor _, step := range job.Steps {\n87\t\t\t\tif run := strings.TrimSpace(step.Run); run != \"\" {\n88\t\t\t\t\tcmds = append(cmds, run)\n89\t\t\t\t}\n90\t\t\t}\n91\t\t}\n92\t\n93\t\treturn cmds\n94\t}\n95\t\n96\t// TestWorkflowTriggersOnPushAndPullRequest keeps the gate on both paths into\n97\t// main: a direct push and a pull request.\n98\tfunc TestWorkflowTriggersOnPushAndPullRequest(t *testing.T) {\n99\t\tw := loadWorkflow(t)\n100\t\n101\t\tif len(w.Jobs) == 0 {\n102\t\t\tt.Fatalf(\"the workflow declares no jobs\")\n103\t\t}\n104\t\n105\t\tfor _, trigger := range []string{\"push\", \"pull_request\"} {\n106\t\t\tif _, ok := w.On[trigger]; !ok {\n107\t\t\t\tt.Errorf(\"the workflow has no %q trigger; it has %v\", trigger, triggerNames(w))\n108\t\t\t}\n109\t\t}\n110\t}\n111\t\n112\tfunc triggerNames(w workflow) []string {\n113\t\tnames := make([]string, 0, len(w.On))\n114\t\tfor name := range w.On {\n115\t\t\tnames = append(names, name)\n116\t\t}\n117\t\n118\t\treturn names\n119\t}\n120\t\n121\t// TestWorkflowRunsOnlyStackCommands is the anti-drift check. Every command the\n122\t// workflow runs has to be one .ralph/stack.json already records, so CI cannot\n123\t// quietly start testing something other than what this project builds, lints and\n124\t// tests locally.\n125\tfunc TestWorkflowRunsOnlyStackCommands(t *testing.T) {\n126\t\tw := loadWorkflow(t)\n127\t\ts := loadStack(t)\n128\t\n129\t\trecorded := map[string]string{\n130\t\t\ts.BuildCommand: \"build_command\",\n131\t\t\ts.LintCommand:  \"lint_command\",\n132\t\t\ts.TestCommand:  \"test_command\",\n133\t\t}\n134\t\n135\t\tfor _, field := range []struct{ name, value string }{\n136\t\t\t{\"build_command\", s.BuildCommand},\n137\t\t\t{\"lint_command\", s.LintCommand},\n138\t\t\t{\"test_command\", s.TestCommand},\n139\t\t} {\n140\t\t\tif field.value == \"\" {\n141\t\t\t\tt.Fatalf(\"%s records no %s\", stackPath, field.name)\n142\t\t\t}\n143\t\t}\n144\t\n145\t\tran := make(map[string]bool)\n146\t\n147\t\tfor _, cmd := range runCommands(w) {\n148\t\t\tfield, ok := recorded[cmd]\n149\t\t\tif !ok {\n150\t\t\t\tt.Errorf(\"the workflow runs %q, which appears in no command field of %s\", cmd, stackPath)\n151\t\n152\t\t\t\tcontinue\n153\t\t\t}\n154\t\n155\t\t\tran[field] = true\n156\t\t}\n157\t\n158\t\tfor _, field := range []string{\"build_command\", \"lint_command\", \"test_command\"} {\n159\t\t\tif !ran[field] {\n160\t\t\t\tt.Errorf(\"the workflow never runs the %s from %s\", field, stackPath)\n161\t\t\t}\n162\t\t}\n163\t}\n164\t\n165\t// TestWorkflowRunsTheFullTestSuite states the canary gate directly rather than\n166\t// leaving it implied by the stack file: `go test ./...` runs internal/canary, so\n167\t// a redaction regression fails the build.\n168\tfunc TestWorkflowRunsTheFullTestSuite(t *testing.T) {\n169\t\tconst suite = \"go test ./...\"\n170\t\n171\t\tfor _, cmd := range runCommands(loadWorkflow(t)) {\n172\t\t\tif cmd == suite {\n173\t\t\t\treturn\n174\t\t\t}\n175\t\t}\n176\t\n177\t\tt.Errorf(\"the workflow never runs %q, so the canary suite gates nothing\", suite)\n178\t}\n179\t\n180\t// TestWorkflowPinsTheGoModVersion catches the workflow testing against a\n181\t// toolchain the module does not target.\n182\tfunc TestWorkflowPinsTheGoModVersion(t *testing.T) {\n183\t\twant := goDirective(t)\n184\t\n185\t\tgot, ok := setupGoVersion(loadWorkflow(t))\n186\t\tif !ok {\n187\t\t\tt.Fatalf(\"the workflow has no actions/setup-go step with a go-version\")\n188\t\t}\n189\t\n190\t\tif got != want {\n191\t\t\tt.Errorf(\"the workflow pins Go %q; go.mod requires %q\", got, want)\n192\t\t}\n193\t}\n194\t\n195\t// goDirective returns the version from the `go` line of go.mod.\n196\tfunc goDirective(t *testing.T) string {\n197\t\tt.Helper()\n198\t\n199\t\traw, err := os.ReadFile(filepath.FromSlash(goModPath))\n200\t\tif err != nil {\n201\t\t\tt.Fatalf(\"reading go.mod: %v\", err)\n202\t\t}\n203\t\n204\t\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n205\t\t\tif fields := strings.Fields(line); len(fields) == 2 && fields[0] == \"go\" {\n206\t\t\t\treturn fields[1]\n207\t\t\t}\n208\t\t}\n209\t\n210\t\tt.Fatalf(\"go.mod has no `go` directive\")\n211\t\n212\t\treturn \"\"\n213\t}\n214\t\n215\t// setupGoVersion returns the version the setup-go step pins.\n216\tfunc setupGoVersion(w workflow) (string, bool) {\n217\t\tfor _, job := range w.Jobs {\n218\t\t\tfor _, step := range job.Steps {\n219\t\t\t\tif !strings.HasPrefix(step.Uses, \"actions/setup-go@\") {\n220\t\t\t\t\tcontinue\n221\t\t\t\t}\n222\t\n223\t\t\t\tif version, ok := step.With[\"go-version\"]; ok {\n224\t\t\t\t\treturn strings.TrimSpace(version), true\n225\t\t\t\t}\n226\t\t\t}\n227\t\t}\n228\t\n229\t\treturn \"\", false\n230\t}\n231\t"
      }
    ]
  },
  "parent_tool_use_id": "toolu_013KDzFVgt2BRXsP1kowxSxs",
