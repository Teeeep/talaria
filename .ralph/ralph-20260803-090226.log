    "content": [
      {
        "tool_use_id": "toolu_01JruCUTQL9rdqnGbWEHS5xG",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"sort\"\n9\t\t\"strings\"\n10\t\n11\t\t\"github.com/spf13/cobra\"\n12\t\n13\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n14\t\t\"github.com/Teeeep/talaria/internal/config\"\n15\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n16\t\t\"github.com/Teeeep/talaria/internal/curl\"\n17\t\t\"github.com/Teeeep/talaria/internal/gen\"\n18\t\t\"github.com/Teeeep/talaria/internal/operation\"\n19\t\t\"github.com/Teeeep/talaria/internal/output\"\n20\t\t\"github.com/Teeeep/talaria/internal/request\"\n21\t\t\"github.com/Teeeep/talaria/internal/secret\"\n22\t\t\"github.com/Teeeep/talaria/internal/spec\"\n23\t\t\"github.com/Teeeep/talaria/internal/validate\"\n24\t)\n25\t\n26\t// runSeed is what the data generator draws from. It is a constant rather than a\n27\t// flag because a smoke test whose request bodies change between runs fails once,\n28\t// passes next time and teaches nobody anything (DESIGN.md §5a).\n29\tconst runSeed = 1\n30\t\n31\t// contentTypeHeader is the header a generated body's media type travels in.\n32\tconst contentTypeHeader = \"Content-Type\"\n33\t\n34\t// The three outcomes one operation can have. Skipped is deliberately not a\n35\t// failure: a DELETE left alone without --allow-mutations, or an operation whose\n36\t// path parameter nothing could supply, is correct behaviour rather than a\n37\t// broken API.\n38\tconst (\n39\t\toutcomePassed  = \"passed\"\n40\t\toutcomeFailed  = \"failed\"\n41\t\toutcomeSkipped = \"skipped\"\n42\t)\n43\t\n44\t// runResult is one operation's line in the report.\n45\ttype runResult struct {\n46\t\tOperationID string `json:\"operation_id\"`\n47\t\tMethod      string `json:\"method\"`\n48\t\tPath        string `json:\"path\"`\n49\t\tOutcome     string `json:\"outcome\"`\n50\t\t// Reason says why a skip or a failure happened. A passing operation has\n51\t\t// none: there is nothing to explain.\n52\t\tReason string `json:\"reason,omitempty\"`\n53\t\t// Status and TimingMS are absent for an operation that was never executed.\n54\t\t// TimingMS is a pointer so a call to a local server that legitimately\n55\t\t// rounded to 0ms is still reported as timed.\n56\t\tStatus     int              `json:\"status,omitempty\"`\n57\t\tTimingMS   *int64           `json:\"timing_ms,omitempty\"`\n58\t\tValidation *validate.Result `json:\"validation,omitempty\"`\n59\t}\n60\t\n61\t// runSummary is the count an agent, or a CI job, reads first.\n62\ttype runSummary struct {\n63\t\tTotal   int `json:\"total\"`\n64\t\tPassed  int `json:\"passed\"`\n65\t\tFailed  int `json:\"failed\"`\n66\t\tSkipped int `json:\"skipped\"`\n67\t}\n68\t\n69\t// runView is the whole report.\n70\ttype runView struct {\n71\t\tResults []runResult `json:\"results\"`\n72\t\tSummary runSummary  `json:\"summary\"`\n73\t}\n74\t\n75\tfunc newRunCmd() *cobra.Command {\n76\t\tvar (\n77\t\t\ttags           []string\n78\t\t\tids            []string\n79\t\t\tfixturesDir    string\n80\t\t\treport         string\n81\t\t\tallowMutations bool\n82\t\t\tfailOnError    bool\n83\t\t\ttimeout        float64\n84\t\t)\n85\t\n86\t\t// One warner for the whole command, as on `call`: a run that puts a\n87\t\t// credential in the query string makes the point once, not once per\n88\t\t// operation.\n89\t\twarner := secret.NewQueryKeyWarner()\n90\t\n91\t\tcmd := &cobra.Command{\n92\t\t\tUse:   \"run [spec]\",\n93\t\t\tShort: \"Smoke-test a spec's operations and report what each one did\",\n94\t\t\tLong: \"Call every operation the filters select, check each response against the\\n\" +\n95\t\t\t\t\"spec, and report one line per operation. Mutating operations are skipped\\n\" +\n96\t\t\t\t\"unless --allow-mutations is given. Request data comes from the spec's own\\n\" +\n97\t\t\t\t\"examples first, then --fixtures, then generation.\",\n98\t\t\tArgs: usageArgs(cobra.MaximumNArgs(1)),\n99\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n100\t\t\t\tformat, err := resolveReportFormat(cmd, report)\n101\t\t\t\tif err != nil {\n102\t\t\t\t\treturn err\n103\t\t\t\t}\n104\t\n105\t\t\t\tdoc, index, err := loadSpec(cmd, args)\n106\t\t\t\tif err != nil {\n107\t\t\t\t\treturn err\n108\t\t\t\t}\n109\t\n110\t\t\t\tops, err := selectOperations(index, tags, ids)\n111\t\t\t\tif err != nil {\n112\t\t\t\t\treturn err\n113\t\t\t\t}\n114\t\n115\t\t\t\trunner, err := newRunner(cmd, doc, fixturesDir, allowMutations, timeoutOptions(timeout), warner)\n116\t\t\t\tif err != nil {\n117\t\t\t\t\treturn err\n118\t\t\t\t}\n119\t\n120\t\t\t\t// Sequential, in spec order. Determinism beats speed here, and\n121\t\t\t\t// parallel calls against a real API are a surprise nobody asked for.\n122\t\t\t\tresults := make([]runResult, 0, len(ops))\n123\t\t\t\tfor _, op := range ops {\n124\t\t\t\t\tres := runner.execute(op)\n125\t\t\t\t\t// A cancelled suite stops here, and the operation that was in\n126\t\t\t\t\t// flight is dropped rather than reported: every remaining request\n127\t\t\t\t\t// would fail instantly against a context that is already done, and\n128\t\t\t\t\t// a report blaming the API for requests nobody made is worse than\n129\t\t\t\t\t// a short one.\n130\t\t\t\t\tif runner.cancelled {\n131\t\t\t\t\t\tbreak\n132\t\t\t\t\t}\n133\t\n134\t\t\t\t\tresults = append(results, res)\n135\t\t\t\t}\n136\t\n137\t\t\t\tview := runView{Results: results, Summary: summarise(results)}\n138\t\n139\t\t\t\t// Rendered before the exit code is decided, for the reason `call`\n140\t\t\t\t// renders first: the flags change what the process exits with, not\n141\t\t\t\t// what the caller gets to read.\n142\t\t\t\tif err := output.New(format, cmd.OutOrStdout()).Render(runPayload(view)); err != nil {\n143\t\t\t\t\treturn err\n144\t\t\t\t}\n145\t\n146\t\t\t\treturn runner.verdict(view, failOnError)\n147\t\t\t},\n148\t\t}\n149\t\n150\t\t// All local to run: no other command enumerates operations, reports on a\n151\t\t// suite, or has test data to supply.\n152\t\tcmd.Flags().StringArrayVar(&tags, \"tag\", nil,\n153\t\t\t\"only operations carrying this tag (repeatable)\")\n154\t\tcmd.Flags().StringArrayVar(&ids, \"operation\", nil,\n155\t\t\t\"only this operationId (repeatable); combined with --tag as a union\")\n156\t\tcmd.Flags().StringVar(&fixturesDir, \"fixtures\", \"\",\n157\t\t\t\"directory of <operationId>.json test data, consulted after spec examples\")\n158\t\tcmd.Flags().StringVar(&report, \"report\", \"\",\n159\t\t\t\"report format: json|pretty|tsv|junit (overrides --output)\")\n160\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n161\t\t\t\"include operations whose method is not GET, HEAD or OPTIONS\")\n162\t\tcmd.Flags().BoolVar(&failOnError, \"fail-on-error\", false,\n163\t\t\t\"exit 4 if any operation failed\")\n164\t\t// Per operation, not per suite: the bound that matters is the one that keeps\n165\t\t// a single wedged endpoint from costing the report.\n166\t\tcmd.Flags().Float64Var(&timeout, \"timeout\", curl.DefaultMaxTime.Seconds(),\n167\t\t\t\"give up on each operation's request after this many seconds\")\n168\t\n169\t\treturn cmd\n170\t}\n171\t\n172\t// resolveReportFormat picks the format the report is written in. --report is\n173\t// run's own flag and wins over the persistent --output: an agent that set\n174\t// --output globally and then asked run for JSON must get JSON, not a format it\n175\t// asked for two flags ago.\n176\t//\n177\t// It also accepts junit, which --output does not: a suite of operations is the\n178\t// only thing there is to render as a test report, and `run` is the only command\n179\t// that produces one.\n180\tfunc resolveReportFormat(cmd *cobra.Command, report string) (output.Format, error) {\n181\t\tif report == \"\" {\n182\t\t\treturn resolveFormat(cmd)\n183\t\t}\n184\t\n185\t\tformat, err := output.ParseReportFormat(report)\n186\t\tif err != nil {\n187\t\t\treturn \"\", clierr.Usage(\"%w\", err).WithAlternatives(output.ReportFormats()...)\n188\t\t}\n189\t\n190\t\treturn format, nil\n191\t}\n192\t\n193\t// selectOperations applies --tag and --operation as a union, in spec order. No\n194\t// filters at all means the whole spec.\n195\t//\n196\t// A filter that selects nothing is a usage error rather than an empty pass: a\n197\t// mistyped tag that exits 0 with nothing tested is a green CI run that proves\n198\t// nothing, which is the one result a smoke test must never produce.\n199\tfunc selectOperations(index *operation.Index, tags, ids []string) ([]operation.Operation, error) {\n200\t\tif len(tags) == 0 && len(ids) == 0 {\n201\t\t\treturn index.Operations(), nil\n202\t\t}\n203\t\n204\t\tkeep := map[string]bool{}\n205\t\tfor _, tag := range tags {\n206\t\t\tfor _, op := range index.ByTag(tag) {\n207\t\t\t\tkeep[operationKey(op)] = true\n208\t\t\t}\n209\t\t}\n210\t\t// Looked up rather than matched, so a misspelt id gets Lookup's suggestions\n211\t\t// instead of silently selecting nothing.\n212\t\tfor _, id := range ids {\n213\t\t\top, err := index.Lookup(id)\n214\t\t\tif err != nil {\n215\t\t\t\treturn nil, err\n216\t\t\t}\n217\t\t\tkeep[operationKey(op)] = true\n218\t\t}\n219\t\n220\t\tvar ops []operation.Operation\n221\t\tfor _, op := range index.Operations() {\n222\t\t\tif keep[operationKey(op)] {\n223\t\t\t\tops = append(ops, op)\n224\t\t\t}\n225\t\t}\n226\t\tif len(ops) == 0 {\n227\t\t\treturn nil, clierr.Usage(\"no operation matches %s\",\n228\t\t\t\tstrings.Join(append(quoted(\"--tag\", tags), quoted(\"--operation\", ids)...), \" or \"))\n229\t\t}\n230\t\n231\t\treturn ops, nil\n232\t}\n233\t\n234\t// operationKey identifies an operation independently of its id, so the two\n235\t// filters can be unioned even for operations the spec never named.\n236\tfunc operationKey(op operation.Operation) string { return op.Method + \" \" + op.Path }\n237\t\n238\t// quoted renders one filter's values for an error message.\n239\tfunc quoted(flag string, values []string) []string {\n240\t\tout := make([]string, 0, len(values))\n241\t\tfor _, value := range values {\n242\t\t\tout = append(out, fmt.Sprintf(\"%s %q\", flag, value))\n243\t\t}\n244\t\n245\t\treturn out\n246\t}\n247\t\n248\t// runner holds everything one suite reuses across operations: the compiled\n249\t// validator, the seeded generator, the history store and the redactors. Built\n250\t// once so the per-operation loop only makes requests.\n251\ttype runner struct {\n252\t\t// ctx is the suite's cancellation source, carried here because a run is a\n253\t\t// loop of requests and a Ctrl-C partway through has to stop the one in\n254\t\t// flight, not just the ones not yet made.\n255\t\tctx       context.Context\n256\t\tdoc       *spec.Document\n257\t\tprofile   *config.Profile\n258\t\tbaseURL   string\n259\t\tgen       *gen.Generator\n260\t\tvalidator *validate.Validator\n261\t\tstore     *corpus.Store\n262\t\tredactors corpus.Redactors\n263\t\twarner    *secret.QueryKeyWarner\n264\t\topts      curl.Options\n265\t\tstderr    io.Writer\n266\t\n267\t\tallowMutations bool\n268\t\t// missing collects the security schemes that stopped an operation from\n269\t\t// running, in the display form the exit-5 error reports.\n270\t\tmissing []string\n271\t\t// cancelled records that ctx ended mid-suite, which is what stops the loop\n272\t\t// and what the verdict reports instead of a result for a suite that never\n273\t\t// finished.\n274\t\tcancelled bool\n275\t}\n276\t\n277\tfunc newRunner(\n278\t\tcmd *cobra.Command,\n279\t\tdoc *spec.Document,\n280\t\tfixturesDir string,\n281\t\tallowMutations bool,\n282\t\topts curl.Options,\n283\t\twarner *secret.QueryKeyWarner,\n284\t) (*runner, error) {\n285\t\t// The whole fixtures directory is read up front, before any request goes\n286\t\t// out: a typo in a fixture should not surface halfway through a suite.\n287\t\tfixtures, err := gen.LoadFixtures(fixturesDir)\n288\t\tif err != nil {\n289\t\t\treturn nil, err\n290\t\t}\n291\t\n292\t\tcfg, err := config.Load(\"\")\n293\t\tif err != nil {\n294\t\t\treturn nil, err\n295\t\t}\n296\t\n297\t\tprofile, err := selectProfile(cmd, cfg)\n298\t\tif err != nil {\n299\t\t\treturn nil, err\n300\t\t}\n301\t\n302\t\tstore, err := openHistory(cmd, cfg)\n303\t\tif err != nil {\n304\t\t\treturn nil, err\n305\t\t}\n306\t\n307\t\tbaseURL, err := cmd.Flags().GetString(\"base-url\")\n308\t\tif err != nil {\n309\t\t\treturn nil, clierr.Usage(\"%w\", err)\n310\t\t}\n311\t\n312\t\tgenerator := gen.New(runSeed)\n313\t\tgenerator.Fixtures = fixtures\n314\t\n315\t\treturn &runner{\n316\t\t\tctx:            cmd.Context(),\n317\t\t\tdoc:            doc,\n318\t\t\tprofile:        profile,\n319\t\t\tbaseURL:        baseURL,\n320\t\t\tgen:            generator,\n321\t\t\tvalidator:      validate.New(doc),\n322\t\t\tstore:          store,\n323\t\t\tredactors:      newRedactors(cfg),\n324\t\t\twarner:         warner,\n325\t\t\topts:           opts,\n326\t\t\tstderr:         cmd.ErrOrStderr(),\n327\t\t\tallowMutations: allowMutations,\n328\t\t}, nil\n329\t}\n330\t\n331\t// execute runs one operation and reports what happened. It never returns an\n332\t// error: one operation's problem is a line in the report, not the end of the\n333\t// suite, and the exit code is decided once at the end from the whole of it.\n334\tfunc (r *runner) execute(op operation.Operation) runResult {\n335\t\tres := runResult{\n336\t\t\tOperationID: operationName(op),\n337\t\t\tMethod:      op.Method,\n338\t\t\tPath:        op.Path,\n339\t\t}\n340\t\n341\t\t// Nothing is attempted once the suite's context has ended — including the\n342\t\t// work a skip does before deciding it is a skip.\n343\t\tif r.ctx.Err() != nil {\n344\t\t\tr.cancelled = true\n345\t\n346\t\t\treturn res\n347\t\t}\n348\t\n349\t\tif op.IsMutation() && !r.allowMutations {\n350\t\t\treturn res.skip(\"a %s request may change server state: pass --allow-mutations to include it\",\n351\t\t\t\top.Method)\n352\t\t}\n353\t\n354\t\tcreds, err := config.Resolve(op, r.doc, r.profile)\n355\t\tif err != nil {\n356\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n357\t\t}\n358\t\t// Checked before the request is built rather than left to fail at exec\n359\t\t// time, so an agent gets the variable to export and the server gets no\n360\t\t// request it was always going to reject.\n361\t\tif missing := missingCredentials(creds); len(missing) > 0 {\n362\t\t\tr.noteMissing(missing)\n363\t\n364\t\t\treturn res.skip(\"no credential for security %s\",\n365\t\t\t\tpluralise(len(missing), \"scheme\")+\" \"+strings.Join(missing, \", \"))\n366\t\t}\n367\t\n368\t\tdata := r.gen.DataFor(op)\n369\t\treq, err := request.Build(request.Inputs{\n370\t\t\tOp:      op,\n371\t\t\tDoc:     r.doc,\n372\t\t\tProfile: r.profile,\n373\t\t\tCreds:   creds,\n374\t\t\tBaseURL: r.baseURL,\n375\t\t\tParams:  flagPairs(data.Params),\n376\t\t\tHeaders: flagPairs(headersFor(data)),\n377\t\t\tBody:    bodyFlag(data.Body),\n378\t\t\t// Already built from this run's config, and shared with the entry that\n379\t\t\t// goes to history so the two surfaces cannot disagree.\n380\t\t\tRedactor: r.redactors.Request,\n381\t\t\t// No stdin: `run` makes many requests and stdin can only be read once,\n382\t\t\t// so there is nothing here for `--body -` to mean.\n383\t\t})\n384\t\tif err != nil {\n385\t\t\t// A request that cannot be built is data talaria could not supply, not\n386\t\t\t// an API that misbehaved, so it is a skip carrying the builder's own\n387\t\t\t// message — which names the parameter.\n388\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n389\t\t}\n390\t\n391\t\twarnQueryCredentials(r.stderr, r.warner, req)\n392\t\n393\t\tresp, execErr := curl.ExecuteWith(r.ctx, req, r.opts)\n394\t\t// A request the suite's own cancellation killed is not an observation about\n395\t\t// the API: it is not recorded, not reported, and it ends the suite. History\n396\t\t// in particular must not gain entries for it — they land under SourceRun and\n397\t\t// count against the per-source retention cap, so a cancelled run over a large\n398\t\t// spec would evict the previous run's real history with requests that were\n399\t\t// never made.\n400\t\tif execErr != nil && r.ctx.Err() != nil {\n401\t\t\tr.cancelled = true\n402\t\n403\t\t\treturn res\n404\t\t}\n405\t\n406\t\t// Recorded either way, as `call` records: a request that never completed is\n407\t\t// still something that was tried.\n408\t\trecordCall(r.stderr, r.store, corpus.SourceRun, req, resp, r.redactors)\n409\t\tif execErr != nil {\n410\t\t\treturn res.fail(\"%s\", clierr.From(execErr).Message)\n411\t\t}\n412\t\n413\t\tview := redactResponse(resp, r.redactors.Response)\n414\t\ttiming := view.TimingMS\n415\t\tres.Status, res.TimingMS = view.Status, &timing\n416\t\tres.Validation = validateWith(r.stderr, r.validator, req, view)\n417\t\n418\t\treturn res.judge()\n419\t}\n420\t\n421\t// noteMissing records the credentials blocking an operation, without repeating\n422\t// one that already blocked another.\n423\tfunc (r *runner) noteMissing(missing []string) {\n424\t\tfor _, name := range missing {\n425\t\t\tif !slicesContains(r.missing, name) {\n426\t\t\t\tr.missing = append(r.missing, name)\n427\t\t\t}\n428\t\t}\n429\t}\n430\t\n431\t// verdict turns the finished report into an exit code.\n432\t//\n433\t// A missing credential exits 5 whether or not --fail-on-error was given, as\n434\t// `auth check` does: it means the suite did not test the operation at all,\n435\t// which is a different thing from an API that answered badly, and an agent\n436\t// acts on it by exporting a variable rather than by reading the report.\n437\tfunc (r *runner) verdict(view runView, failOnError bool) error {\n438\t\t// Ahead of both of those, because neither is a statement anyone can make\n439\t\t// about a suite that did not finish. It is exit 1, as a cancelled `call` is:\n440\t\t// the requests could not be completed. Exiting 0 would tell CI a suite passed\n441\t\t// on the strength of the fraction of it that ran.\n442\t\tif r.cancelled {\n443\t\t\treturn clierr.RequestFailed(\"the run was cancelled after %s\",\n444\t\t\t\tpluralise(len(view.Results), \"operation\"))\n445\t\t}\n446\t\tif len(r.missing) > 0 {\n447\t\t\treturn clierr.CredentialMissing(\"no credential for security %s %s\",\n448\t\t\t\tpluralise(len(r.missing), \"scheme\"), strings.Join(r.missing, \", \"))\n449\t\t}\n450\t\tif failOnError && view.Summary.Failed > 0 {\n451\t\t\treturn clierr.Validation(\"%s failed\", pluralise(view.Summary.Failed, \"operation\"))\n452\t\t}\n453\t\n454\t\treturn nil\n455\t}\n456\t\n457\t// skip marks an operation as not run, and why.\n458\tfunc (res runResult) skip(format string, a ...any) runResult {\n459\t\tres.Outcome, res.Reason = outcomeSkipped, fmt.Sprintf(format, a...)\n460\t\n461\t\treturn res\n462\t}\n463\t\n464\t// fail marks an operation as run and wrong, and why.\n465\tfunc (res runResult) fail(format string, a ...any) runResult {\n466\t\tres.Outcome, res.Reason = outcomeFailed, fmt.Sprintf(format, a...)\n467\t\n468\t\treturn res\n469\t}\n470\t\n471\t// judge decides the outcome of an operation that reached the server. The HTTP\n472\t// status is reported first when both apply, for `call --fail-on-error`'s\n473\t// reason: a 500 whose body does not match the error schema is a server that is\n474\t// down, not a server with a documentation problem.\n475\tfunc (res runResult) judge() runResult {\n476\t\tswitch {\n477\t\tcase res.Status >= http.StatusBadRequest:\n478\t\t\treturn res.fail(\"the server returned %s\", statusText(res.Status))\n479\t\tcase res.Validation != nil && len(res.Validation.Errors) > 0:\n480\t\t\treturn res.fail(\"the response violates the spec: %s\",\n481\t\t\t\tpluralise(len(res.Validation.Errors), \"validation error\"))\n482\t\tdefault:\n483\t\t\tres.Outcome = outcomePassed\n484\t\n485\t\t\treturn res\n486\t\t}\n487\t}\n488\t\n489\t// missingCredentials names the credentials an operation needs and does not\n490\t// have, in the form `scheme (set $VAR)` — the same phrasing `auth check` uses,\n491\t// because it answers the same question.\n492\tfunc missingCredentials(creds []config.Credential) []string {\n493\t\tvar missing []string\n494\t\tfor _, cred := range creds {\n495\t\t\tif !cred.Present() {\n496\t\t\t\tmissing = append(missing, cred.Scheme+\" (set \"+cred.Ref.Symbolic()+\")\")\n497\t\t\t}\n498\t\t}\n499\t\n500\t\treturn missing\n501\t}\n502\t\n503\t// flagPairs renders generated data as the `name=value` strings request.Build\n504\t// parses, sorted so two runs of the same spec build byte-identical requests.\n505\tfunc flagPairs(values map[string]string) []string {\n506\t\tout := make([]string, 0, len(values))\n507\t\tfor name, value := range values {\n508\t\t\tout = append(out, name+\"=\"+value)\n509\t\t}\n510\t\tsort.Strings(out)\n511\t\n512\t\treturn out\n513\t}\n514\t\n515\t// headersFor is the headers one request sends: the fixture's, plus the media\n516\t// type the body was generated as.\n517\t//\n518\t// Without that header the request builder falls back to the operation's first\n519\t// declared media type, which is not necessarily the one the body was generated\n520\t// from — a spec listing application/xml before application/json, or a converted\n521\t// Swagger 2.0 formData operation, then sends JSON bytes under a media type it\n522\t// is not. A fixture header wins, as a user-set --header wins in `call`.\n523\tfunc headersFor(data gen.Data) map[string]string {\n524\t\theaders := make(map[string]string, len(data.Headers)+1)\n525\t\tfor name, value := range data.Headers {\n526\t\t\theaders[name] = value\n527\t\t}\n528\t\n529\t\tif len(data.Body) == 0 || data.ContentType == \"\" {\n530\t\t\treturn headers\n531\t\t}\n532\t\n533\t\tfor name := range headers {\n534\t\t\tif strings.EqualFold(name, contentTypeHeader) {\n535\t\t\t\treturn headers\n536\t\t\t}\n537\t\t}\n538\t\theaders[contentTypeHeader] = data.ContentType\n539\t\n540\t\treturn headers\n541\t}\n542\t\n543\t// bodyFlag renders a generated