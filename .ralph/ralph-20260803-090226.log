        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"os/exec\"\n5\t\t\"regexp\"\n6\t\t\"strconv\"\n7\t\t\"sync\"\n8\t\n9\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n10\t)\n11\t\n12\t// minVersion is the hard floor from DESIGN.md §3.4. `--write-out '%{json}'`\n13\t// landed in curl 7.70, and the executor's whole three-channel design rests on\n14\t// it, so an older curl is refused rather than worked around.\n15\tconst minVersion = \"7.70\"\n16\t\n17\tconst (\n18\t\tminMajor = 7\n19\t\tminMinor = 70\n20\t)\n21\t\n22\t// versionLine matches the `curl 8.14.1 (…) libcurl/…` banner. Only the first\n23\t// two components decide the floor; distributions append their own suffixes to\n24\t// the patch component and none of them matter here.\n25\tvar versionLine = regexp.MustCompile(`(?m)^curl\\s+(\\d+)\\.(\\d+)`)\n26\t\n27\t// preflightOnce keeps the version check to one subprocess per talaria run: it\n28\t// is the same binary every time, and `run` executes hundreds of calls.\n29\tvar (\n30\t\tpreflightOnce sync.Once\n31\t\tpreflightErr  error\n32\t)\n33\t\n34\t// preflight verifies that the curl at path is new enough, once per process.\n35\t//\n36\t// Checking the version rather than mere presence is what turns \"curl: option\n37\t// --write-out: is unknown\" on an older machine into a sentence that names the\n38\t// requirement — and the distribution story targets machines that are not this\n39\t// one.\n40\tfunc preflight(path string) error {\n41\t\tpreflightOnce.Do(func() {\n42\t\t\tout, err := exec.Command(path, \"--version\").Output()\n43\t\t\tif err != nil {\n44\t\t\t\tpreflightErr = clierr.RequestFailed(\"cannot run %s --version: %w\", path, err)\n45\t\t\t\treturn\n46\t\t\t}\n47\t\n48\t\t\tpreflightErr = checkVersion(string(out))\n49\t\t})\n50\t\n51\t\treturn preflightErr\n52\t}\n53\t\n54\t// checkVersion reports whether the output of `curl --version` describes a curl\n55\t// at or above the floor.\n56\tfunc checkVersion(output string) error {\n57\t\tmatch := versionLine.FindStringSubmatch(output)\n58\t\tif match == nil {\n59\t\t\treturn clierr.RequestFailed(\n60\t\t\t\t\"cannot determine the curl version; talaria needs curl >= %s for --write-out '%%{json}'\",\n61\t\t\t\tminVersion,\n62\t\t\t)\n63\t\t}\n64\t\n65\t\t// The regexp matched \\d+, so these cannot fail on anything but an\n66\t\t// implausibly long number, which strconv reports as out of range — and a\n67\t\t// curl with a 20-digit major version is above the floor either way.\n68\t\tmajor, err := strconv.Atoi(match[1])\n69\t\tif err != nil {\n70\t\t\treturn nil\n71\t\t}\n72\t\tminor, err := strconv.Atoi(match[2])\n73\t\tif err != nil {\n74\t\t\treturn nil\n75\t\t}\n76\t\n77\t\tif major > minMajor || (major == minMajor && minor >= minMinor) {\n78\t\t\treturn nil\n79\t\t}\n80\t\n81\t\treturn clierr.RequestFailed(\n82\t\t\t\"curl %d.%d is too old; talaria needs curl >= %s for --write-out '%%{json}'\",\n83\t\t\tmajor, minor, minVersion,\n84\t\t)\n85\t}\n86\t"
      }
    ]
