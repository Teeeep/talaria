        "type": "tool_result",
        "content": "1\tpackage output\n2\t\n3\timport (\n4\t\t\"slices\"\n5\t\t\"strings\"\n6\t\n7\t\t\"github.com/pb33f/libopenapi/datamodel/high/base\"\n8\t)\n9\t\n10\t// DefaultSchemaDepth is how deep the renderer walks before it stops. Deep\n11\t// enough for the shapes people actually send, shallow enough that a schema with\n12\t// a long tail of nested objects cannot become the context bomb this tool exists\n13\t// to prevent (DESIGN.md §3.2).\n14\tconst DefaultSchemaDepth = 6\n15\t\n16\t// CircularMarker ends the line of a property whose schema refers back to one of\n17\t// its own ancestors. Real specs self-reference constantly, so this is a normal\n18\t// outcome, not an error.\n19\tconst CircularMarker = \"[circular]\"\n20\t\n21\t// DepthMarker ends the line of a property that has children the renderer chose\n22\t// not to walk into, so a reader can tell the difference between \"no more\n23\t// fields\" and \"not shown\".\n24\tconst DepthMarker = \"[max depth]\"\n25\t\n26\t// indent is one nesting level of the rendered tree. Two spaces keeps deep\n27\t// schemas inside a terminal width.\n28\tconst indent = \"  \"\n29\t\n30\t// The type names the renderer invents when the spec does not supply one.\n31\tconst (\n32\t\ttypeAny    = \"any\"\n33\t\ttypeObject = \"object\"\n34\t\ttypeArray  = \"array\"\n35\t\ttypeNull   = \"null\"\n36\t)\n37\t\n38\t// SchemaNode is one node of a schema rendered for human and agent consumption\n39\t// alike: the pretty renderer turns it into lines, and `--output json` marshals\n40\t// the tree as it stands. Building it once and rendering twice is what keeps the\n41\t// two views from drifting.\n42\t//\n43\t// The tree is deliberately lossy. It answers \"what do I put in this field\", not\n44\t// \"what does this schema validate\" — no patterns, no bounds, no formats.\n45\ttype SchemaNode struct {\n46\t\t// Name is the property name. It is empty on the root of a schema that was\n47\t\t// not reached through a property; callers naming a root — a parameter, a\n48\t\t// request body — set it themselves.\n49\t\tName string `json:\"name,omitempty\"`\n50\t\t// Type is the rendered type: a JSON Schema type, \"[]\" plus an element type\n51\t\t// for an array, \"a|b\" for a union, or a \"oneOf: a|b\" summary for a\n52\t\t// composition.\n53\t\tType     string `json:\"type,omitempty\"`\n54\t\tRequired bool   `json:\"required,omitempty\"`\n55\t\t// Description is the spec's description, collapsed onto one line.\n56\t\tDescription string       `json:\"description,omitempty\"`\n57\t\tEnum        []string     `json:\"enum,omitempty\"`\n58\t\tProperties  []SchemaNode `json:\"properties,omitempty\"`\n59\t\t// Circular reports that this node's schema is one of its own ancestors, so\n60\t\t// its properties were not walked.\n61\t\tCircular bool `json:\"circular,omitempty\"`\n62\t\t// Truncated reports that this node has properties the depth limit stopped\n63\t\t// the renderer from walking.\n64\t\tTruncated bool `json:\"truncated,omitempty\"`\n65\t}\n66\t\n67\t// SchemaTree walks a schema into a SchemaNode, stopping at maxDepth levels of\n68\t// nesting and at any schema that refers back to one of its own ancestors. A\n69\t// maxDepth of zero or less means DefaultSchemaDepth. A nil schema yields the\n70\t// zero node, which renders as nothing.\n71\tfunc SchemaTree(sp *base.SchemaProxy, maxDepth int) SchemaNode {\n72\t\tif sp == nil {\n73\t\t\treturn SchemaNode{}\n74\t\t}\n75\t\tif maxDepth <= 0 {\n76\t\t\tmaxDepth = DefaultSchemaDepth\n77\t\t}\n78\t\n79\t\tw := walker{maxDepth: maxDepth, onPath: make(map[string]bool)}\n80\t\n81\t\treturn w.node(\"\", false, sp, 0)\n82\t}\n83\t\n84\t// Lines renders the node as one line per property, nested properties indented\n85\t// one level per depth. The root's own line is suppressed when it is an unnamed\n86\t// object: a caller rendering a request body wants its fields, not an \"(object)\"\n87\t// header above them.\n88\tfunc (n SchemaNode) Lines() []string {\n89\t\tif n.Type == \"\" && len(n.Properties) == 0 {\n90\t\t\treturn nil\n91\t\t}\n92\t\n93\t\tvar out []string\n94\t\tn.appendLines(&out, 0)\n95\t\n96\t\treturn out\n97\t}\n98\t\n99\t// Line renders just this node, without its properties: the `name*: (type)\n100\t// description` form from DESIGN.md §3.2.\n101\tfunc (n SchemaNode) Line() string {\n102\t\tvar b strings.Builder\n103\t\tif n.Name != \"\" {\n104\t\t\tb.WriteString(n.Name)\n105\t\t\tif n.Required {\n106\t\t\t\tb.WriteString(\"*\")\n107\t\t\t}\n108\t\t\tb.WriteString(\": \")\n109\t\t}\n110\t\tb.WriteString(\"(\" + n.Type + \")\")\n111\t\n112\t\tfor _, part := range []string{n.Description, enumPhrase(n.Enum), n.marker()} {\n113\t\t\tif part != \"\" {\n114\t\t\t\tb.WriteString(\" \" + part)\n115\t\t\t}\n116\t\t}\n117\t\n118\t\treturn b.String()\n119\t}\n120\t\n121\tfunc (n SchemaNode) appendLines(out *[]string, depth int) {\n122\t\tnext := depth\n123\t\tif !n.suppressed() {\n124\t\t\t*out = append(*out, strings.Repeat(indent, depth)+n.Line())\n125\t\t\tnext++\n126\t\t}\n127\t\n128\t\tfor _, p := range n.Properties {\n129\t\t\tp.appendLines(out, next)\n130\t\t}\n131\t}\n132\t\n133\t// suppressed reports whether this node's own line adds nothing — an unnamed\n134\t// object whose properties speak for it.\n135\tfunc (n SchemaNode) suppressed() bool {\n136\t\treturn n.Name == \"\" && n.Type == typeObject && len(n.Properties) > 0\n137\t}\n138\t\n139\tfunc (n SchemaNode) marker() string {\n140\t\tswitch {\n141\t\tcase n.Circular:\n142\t\t\treturn CircularMarker\n143\t\tcase n.Truncated:\n144\t\t\treturn DepthMarker\n145\t\tdefault:\n146\t\t\treturn \"\"\n147\t\t}\n148\t}\n149\t\n150\tfunc enumPhrase(values []string) string {\n151\t\tif len(values) == 0 {\n152\t\t\treturn \"\"\n153\t\t}\n154\t\n155\t\treturn \"one of: \" + strings.Join(values, \", \")\n156\t}\n157\t\n158\t// walker carries the state one SchemaTree call needs: the depth limit and the\n159\t// $refs on the current path, which is what makes the cycle guard a guard rather\n160\t// than a global \"seen once\" filter — the same schema may legitimately appear in\n161\t// two sibling branches.\n162\ttype walker struct {\n163\t\tmaxDepth int\n164\t\tonPath   map[string]bool\n165\t}\n166\t\n167\tfunc (w *walker) node(name string, required bool, sp *base.SchemaProxy, depth int) SchemaNode {\n168\t\tn := SchemaNode{Name: name, Required: required, Type: typeAny}\n169\t\tif sp == nil {\n170\t\t\treturn n\n171\t\t}\n172\t\n173\t\t// The cycle key is the $ref rather than the resolved schema pointer:\n174\t\t// recursion in a real spec always goes through a reference, and a ref\n175\t\t// string is stable where libopenapi's resolved pointers need not be.\n176\t\tif key := refKey(sp); key != \"\" {\n177\t\t\tif w.onPath[key] {\n178\t\t\t\tn.Type = typeName(sp, 0)\n179\t\t\t\tn.Circular = true\n180\t\n181\t\t\t\treturn n\n182\t\t\t}\n183\t\t\tw.onPath[key] = true\n184\t\t\tdefer delete(w.onPath, key)\n185\t\t}\n186\t\n187\t\ts := sp.Schema()\n188\t\tif s == nil {\n189\t\t\treturn n\n190\t\t}\n191\t\n192\t\tn.Description = collapse(s.Description)\n193\t\tn.Enum = enumValues(s)\n194\t\n195\t\t// An array delegates to its element: the element decides the type name, the\n196\t\t// properties and the cycle verdict, and the array only prefixes \"[]\". The\n197\t\t// element is at the same depth — an array is a container, not a level of\n198\t\t// nesting a reader has to hold in their head.\n199\t\tif items := arrayItems(s); items != nil {\n200\t\t\telem := w.node(name, required, items, depth)\n201\t\t\telem.Type = \"[]\" + elem.Type\n202\t\t\tif elem.Description == \"\" {\n203\t\t\t\telem.Description = n.Description\n204\t\t\t}\n205\t\n206\t\t\treturn elem\n207\t\t}\n208\t\n209\t\tn.Type = typeName(sp, 0)\n210\t\n211\t\tproperties := propertyPairs(s)\n212\t\tif len(properties) == 0 {\n213\t\t\treturn n\n214\t\t}\n215\t\tif depth >= w.maxDepth {\n216\t\t\tn.Truncated = true\n217\t\n218\t\t\treturn n\n219\t\t}\n220\t\n221\t\treq := requiredSet(s)\n222\t\tfor _, p := range properties {\n223\t\t\tn.Properties = append(n.Properties, w.node(p.name, req[p.name], p.schema, depth+1))\n224\t\t}\n225\t\n226\t\treturn n\n227\t}\n228\t\n229\t// property is one entry of an object's properties, kept as a pair so allOf\n230\t// branches can be spliced into the parent's list in order.\n231\ttype property struct {\n232\t\tname   string\n233\t\tschema *base.SchemaProxy\n234\t}\n235\t\n236\t// propertyPairs lists the properties of a schema in spec order. allOf branches\n237\t// contribute theirs too: allOf means every branch applies at once, so the\n238\t// fields a caller has to supply are the union. oneOf and anyOf are a choice\n239\t// rather than a union, so they contribute nothing here — typeName names their\n240\t// branches instead.\n241\tfunc propertyPairs(s *base.Schema) []property {\n242\t\tvar out []property\n243\t\tif s.Properties != nil {\n244\t\t\tfor name, schema := range s.Properties.FromOldest() {\n245\t\t\t\tout = append(out, property{name: name, schema: schema})\n246\t\t\t}\n247\t\t}\n248\t\n249\t\tfor _, branch := range s.AllOf {\n250\t\t\tif branch == nil {\n251\t\t\t\tcontinue\n252\t\t\t}\n253\t\t\tif sub := branch.Schema(); sub != nil {\n254\t\t\t\tout = append(out, propertyPairs(sub)...)\n255\t\t\t}\n256\t\t}\n257\t\n258\t\treturn out\n259\t}\n260\t\n261\t// requiredSet collects the required property names of a schema and of its allOf\n262\t// branches, matching how propertyPairs merges them.\n263\tfunc requiredSet(s *base.Schema) map[string]bool {\n264\t\treq := make(map[string]bool, len(s.Required))\n265\t\tfor _, name := range s.Required {\n266\t\t\treq[name] = true\n267\t\t}\n268\t\n269\t\tfor _, branch := range s.AllOf {\n270\t\t\tif branch == nil {\n271\t\t\t\tcontinue\n272\t\t\t}\n273\t\t\tif sub := branch.Schema(); sub != nil {\n274\t\t\t\tfor name := range requiredSet(sub) {\n275\t\t\t\t\treq[name] = true\n276\t\t\t\t}\n277\t\t\t}\n278\t\t}\n279\t\n280\t\treturn req\n281\t}\n282\t\n283\t// arrayItems returns the element schema of an array, or nil for anything else.\n284\t// A schema with items but no declared type is treated as an array too: 3.1\n285\t// specs routinely omit the type.\n286\tfunc arrayItems(s *base.Schema) *base.SchemaProxy {\n287\t\tif s.Items == nil || !s.Items.IsA() {\n288\t\t\treturn nil\n289\t\t}\n290\t\tif len(s.Type) > 0 && !slices.Contains(s.Type, typeArray) {\n291\t\t\treturn nil\n292\t\t}\n293\t\n294\t\treturn s.Items.A\n295\t}\n296\t\n297\t// typeName names a schema's type for display. budget bounds the one place it\n298\t// recurses — an array element — so a self-referential array cannot spin here;\n299\t// the cycle guard in walker covers the structural walk, but typeName is also\n300\t// called on a node whose walk has already been cut short.\n301\tfunc typeName(sp *base.SchemaProxy, budget int) string {\n302\t\tif sp == nil || budget > 2 {\n303\t\t\treturn typeAny\n304\t\t}\n305\t\n306\t\ts := sp.Schema()\n307\t\tif s == nil {\n308\t\t\treturn typeAny\n309\t\t}\n310\t\n311\t\tif declared := declaredTypes(s); len(declared) > 0 {\n312\t\t\tif len(declared) == 1 && declared[0] == typeArray {\n313\t\t\t\treturn \"[]\" + typeName(itemsOf(s), budget+1)\n314\t\t\t}\n315\t\n316\t\t\treturn strings.Join(declared, \"|\")\n317\t\t}\n318\t\n319\t\t// No declared type: infer from what the schema actually constrains.\n320\t\tswitch {\n321\t\tcase len(s.OneOf) > 0:\n322\t\t\treturn branchSummary(\"oneOf\", s.OneOf, budget)\n323\t\tcase len(s.AnyOf) > 0:\n324\t\t\treturn branchSummary(\"anyOf\", s.AnyOf, budget)\n325\t\tcase s.Properties != nil && s.Properties.Len() > 0, len(s.AllOf) > 0:\n326\t\t\treturn typeObject\n327\t\tcase itemsOf(s) != nil:\n328\t\t\treturn \"[]\" + typeName(itemsOf(s), budget+1)\n329\t\tdefault:\n330\t\t\treturn typeAny\n331\t\t}\n332\t}\n333\t\n334\t// branchSummary names a composition by its branch types rather than expanding\n335\t// each one. An agent needs to know it has a choice and between what; the full\n336\t// expansion of every branch is what `describe` exists to avoid.\n337\tfunc branchSummary(keyword string, branches []*base.SchemaProxy, budget int) string {\n338\t\tnames := make([]string, 0, len(branches))\n339\t\tseen := make(map[string]bool, len(branches))\n340\t\tfor _, branch := range branches {\n341\t\t\tname := typeName(branch, budget+1)\n342\t\t\tif seen[name] {\n343\t\t\t\tcontinue\n344\t\t\t}\n345\t\t\tseen[name] = true\n346\t\t\tnames = append(names, name)\n347\t\t}\n348\t\n349\t\treturn keyword + \": \" + strings.Join(names, \"|\")\n350\t}\n351\t\n352\t// declaredTypes returns the schema's declared types with \"null\" dropped, since\n353\t// nullability is not what a caller is choosing between. A schema declared only\n354\t// null keeps it.\n355\tfunc declaredTypes(s *base.Schema) []string {\n356\t\tout := make([]string, 0, len(s.Type))\n357\t\tfor _, t := range s.Type {\n358\t\t\tif t != typeNull {\n359\t\t\t\tout = append(out, t)\n360\t\t\t}\n361\t\t}\n362\t\tif len(out) == 0 && len(s.Type) > 0 {\n363\t\t\treturn []string{typeNull}\n364\t\t}\n365\t\n366\t\treturn out\n367\t}\n368\t\n369\tfunc itemsOf(s *base.Schema) *base.SchemaProxy {\n370\t\tif s.Items == nil || !s.Items.IsA() {\n371\t\t\treturn nil\n372\t\t}\n373\t\n374\t\treturn s.Items.A\n375\t}\n376\t\n377\t// refKey identifies a schema by the reference it was reached through, or \"\" for\n378\t// an inline schema, which cannot be its own ancestor.\n379\tfunc refKey(sp *base.SchemaProxy) string {\n380\t\tif !sp.IsReference() {\n381\t\t\treturn \"\"\n382\t\t}\n383\t\n384\t\treturn sp.GetReference()\n385\t}\n386\t\n387\t// enumValues renders the enum as the strings a caller would type. Values are\n388\t// yaml scalars; a non-scalar enum entry has no compact rendering and is skipped\n389\t// rather than dumped.\n390\tfunc enumValues(s *base.Schema) []string {\n391\t\tif len(s.Enum) == 0 {\n392\t\t\treturn nil\n393\t\t}\n394\t\n395\t\tout := make([]string, 0, len(s.Enum))\n396\t\tfor _, node :=