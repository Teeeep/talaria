        "tool_use_id": "toolu_01YRU9kZwiosuHd39YLqF1xw",
        "type": "tool_result",
        "content": "1\tpackage request\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"io\"\n6\t\t\"net/url\"\n7\t\t\"sort\"\n8\t\t\"strings\"\n9\t\n10\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n11\t\t\"github.com/Teeeep/talaria/internal/config\"\n12\t\t\"github.com/Teeeep/talaria/internal/operation\"\n13\t\t\"github.com/Teeeep/talaria/internal/secret\"\n14\t\t\"github.com/Teeeep/talaria/internal/spec\"\n15\t)\n16\t\n17\t// Parameter locations. Three of them are also credential locations and are\n18\t// aliased from internal/config so the two packages cannot drift; `path` is the\n19\t// one place a credential never goes, which is why config does not name it.\n20\tconst (\n21\t\tinPath   = \"path\"\n22\t\tinQuery  = config.InQuery\n23\t\tinHeader = config.InHeader\n24\t\tinCookie = config.InCookie\n25\t)\n26\t\n27\t// Inputs is everything one call needs: the operation and the document it came\n28\t// from, the resolved profile and credentials, and the raw `name=value` flag\n29\t// strings exactly as the CLI received them. Parsing them here rather than in\n30\t// cmd/ keeps the binding rules — and their error messages — testable without a\n31\t// command tree.\n32\ttype Inputs struct {\n33\t\tOp      operation.Operation\n34\t\tDoc     *spec.Document\n35\t\tProfile *config.Profile\n36\t\t// Creds are the credentials config.Resolve produced for Op. They name\n37\t\t// credentials; they never carry one.\n38\t\tCreds []config.Credential\n39\t\t// BaseURL is --base-url. It beats the profile, which beats the spec.\n40\t\tBaseURL string\n41\t\t// Params are --param name=value for parameters the operation declares, in\n42\t\t// any location.\n43\t\tParams []string\n44\t\t// Query are --query name=value, for query parameters the spec may not\n45\t\t// declare.\n46\t\tQuery []string\n47\t\t// Headers are --header name=value.\n48\t\tHeaders []string\n49\t\t// Body holds --body exactly as given: a literal, @file, or \"-\" for stdin.\n50\t\t// It is a slice so a repeated flag is a reportable mistake rather than a\n51\t\t// silent last-one-wins.\n52\t\tBody []string\n53\t\t// Redactor is the config file's user-extensible display patterns\n54\t\t// (`redact.headers`), layered over the built-in credential names §5a fixes\n55\t\t// as the non-configurable floor. Nil means that floor and nothing more.\n56\t\tRedactor *secret.Redactor\n57\t\t// Stdin is the reader `--body -` consumes. It is injected rather than read\n58\t\t// from os.Stdin so the ownership rule is testable: the Go process reads the\n59\t\t// body in full before curl exists, and curl's own stdin carries the config\n60\t\t// document (DESIGN.md §5a).\n61\t\tStdin io.Reader\n62\t}\n63\t\n64\t// Build binds inputs to an operation and returns the request to make.\n65\t//\n66\t// Every binding problem is collected before returning rather than reported one\n67\t// at a time: an agent that gets \"petId is required; --header malformed\" fixes\n68\t// both in one round trip, where a fail-fast builder would cost it two.\n69\tfunc Build(in Inputs) (*Request, error) {\n70\t\tb := &binder{in: in}\n71\t\n72\t\treq := &Request{\n73\t\t\tOperationID: in.Op.ID,\n74\t\t\tMethod:      b.method(in.Op.Method),\n75\t\t\tBaseURL:     b.baseURL(),\n76\t\t}\n77\t\n78\t\tbound := b.params()\n79\t\treq.Path = b.path(bound)\n80\t\n81\t\t// Query goes through hide for the same reason headers and cookies do: §5a\n82\t\t// names query-string API keys (`?api_key=`) as a credential location, and a\n83\t\t// value's origin — spec, profile, --param or --query — does not change what\n84\t\t// the name says it is.\n85\t\treq.Query = hide(in.Redactor, append(b.located(bound, inQuery), b.pairs(in.Query, \"--query\", nil)...))\n86\t\treq.Headers = hide(in.Redactor, b.headers(bound))\n87\t\treq.Cookies = hide(in.Redactor, b.located(bound, inCookie))\n88\t\t// After the headers, because the body's content type defers to a\n89\t\t// Content-Type the user set; before the credentials, which never set one.\n90\t\treq.Body = b.body(req)\n91\t\n92\t\tb.credentials(req)\n93\t\n94\t\tif err := b.err(); err != nil {\n95\t\t\treturn nil, err\n96\t\t}\n97\t\n98\t\treturn req, nil\n99\t}\n100\t\n101\t// binder accumulates the problems found while binding so they can all be\n102\t// reported together.\n103\ttype binder struct {\n104\t\tin       Inputs\n105\t\tproblems []string\n106\t\t// unknown records that some --param named a parameter the operation does\n107\t\t// not declare, so the error can carry the declared names as alternatives.\n108\t\tunknown bool\n109\t}\n110\t\n111\tfunc (b *binder) fail(format string, a ...any) {\n112\t\tb.problems = append(b.problems, clierr.Usage(format, a...).Message)\n113\t}\n114\t\n115\t// err folds the collected problems into one usage error, naming the operation\n116\t// so the message stands alone in a log.\n117\tfunc (b *binder) err() error {\n118\t\tif len(b.problems) == 0 {\n119\t\t\treturn nil\n120\t\t}\n121\t\n122\t\terr := clierr.Usage(\"cannot build a request for %s: %s\",\n123\t\t\toperationName(b.in.Op), strings.Join(b.problems, \"; \"))\n124\t\tif b.unknown {\n125\t\t\terr = err.WithAlternatives(declaredNames(b.in.Op)...)\n126\t\t}\n127\t\n128\t\treturn err\n129\t}\n130\t\n131\t// baseURL resolves where the request goes: --base-url, then the profile, then\n132\t// the spec's first server (DESIGN.md §4). A spec whose server URL is relative\n133\t// — common for specs that expect a host to be supplied — counts as no server.\n134\tfunc (b *binder) baseURL() string {\n135\t\tcandidates := []struct{ source, raw string }{\n136\t\t\t{\"--base-url\", b.in.BaseURL},\n137\t\t}\n138\t\tif b.in.Profile != nil {\n139\t\t\tcandidates = append(candidates, struct{ source, raw string }{\n140\t\t\t\t\"profile \" + b.in.Profile.Name, b.in.Profile.BaseURL})\n141\t\t}\n142\t\tcandidates = append(candidates, struct{ source, raw string }{\"the spec's servers[0].url\", firstServer(b.in.Doc)})\n143\t\n144\t\tfor _, c := range candidates {\n145\t\t\tif c.raw == \"\" {\n146\t\t\t\tcontinue\n147\t\t\t}\n148\t\n149\t\t\t// Before the parse, so a URL that fails to parse cannot have its\n150\t\t\t// userinfo quoted back by the message below.\n151\t\t\tif host, ok := Userinfo(c.raw); ok {\n152\t\t\t\tb.fail(\"base URL from %s carries a credential in its userinfo (user:password@%s); \"+\n153\t\t\t\t\t\"remove it and set %s=user:password instead, which keeps the value out of the \"+\n154\t\t\t\t\t\"request, the emitted curl and the history\", c.source, host, config.EnvBasic)\n155\t\t\t\treturn \"\"\n156\t\t\t}\n157\t\n158\t\t\tparsed, err := url.Parse(c.raw)\n159\t\t\tif err != nil || parsed.Host == \"\" || !IsHTTPScheme(parsed.Scheme) {\n160\t\t\t\tb.fail(\"base URL %q from %s is not an absolute http(s) URL\", c.raw, c.source)\n161\t\t\t\treturn \"\"\n162\t\t\t}\n163\t\n164\t\t\treturn strings.TrimSuffix(c.raw, \"/\")\n165\t\t}\n166\t\n167\t\tb.fail(\"no base URL: the spec declares no server, so pass --base-url or set one in a profile\")\n168\t\n169\t\treturn \"\"\n170\t}\n171\t\n172\t// firstServer returns the document's first server URL, or \"\" when it has none.\n173\tfunc firstServer(doc *spec.Document) string {\n174\t\tif doc == nil || doc.Model == nil || len(doc.Model.Servers) == 0 || doc.Model.Servers[0] == nil {\n175\t\t\treturn \"\"\n176\t\t}\n177\t\n178\t\treturn doc.Model.Servers[0].URL\n179\t}\n180\t\n181\t// params parses --param flags against the parameters the operation declares,\n182\t// keyed by the declared name so path substitution and location routing both\n183\t// read from one place.\n184\tfunc (b *binder) params() map[string]string {\n185\t\tdeclared := map[string]operation.Param{}\n186\t\tfor _, p := range b.in.Op.Params {\n187\t\t\tdeclared[p.Name] = p\n188\t\t}\n189\t\n190\t\tbound := map[string]string{}\n191\t\tfor i, raw := range b.in.Params {\n192\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n193\t\t\tif !ok || name == \"\" {\n194\t\t\t\t// Reported like every other rejected name=value flag: by position,\n195\t\t\t\t// with the value elided. A --param can be a query-string API key.\n196\t\t\t\tb.fail(\"--param %d is not name=value%s\", i+1, elided(raw))\n197\t\t\t\tcontinue\n198\t\t\t}\n199\t\n200\t\t\tif _, ok := declared[name]; !ok {\n201\t\t\t\tb.unknown = true\n202\t\t\t\tb.fail(\"%s declares no parameter %q\", operationName(b.in.Op), name)\n203\t\t\t\tcontinue\n204\t\t\t}\n205\t\n206\t\t\tbound[name] = value\n207\t\t}\n208\t\n209\t\t// Reported after parsing so a missing parameter and a misspelt one surface\n210\t\t// together rather than one run apart.\n211\t\tfor _, p := range b.in.Op.Params {\n212\t\t\tif _, ok := bound[p.Name]; p.Required && !ok {\n213\t\t\t\tb.fail(\"--param %s is required (%s parameter)\", p.Name, p.In)\n214\t\t\t}\n215\t\t}\n216\t\n217\t\treturn bound\n218\t}\n219\t\n220\t// path substitutes the bound path parameters into the operation's template.\n221\t//\n222\t// Values are escaped with url.PathEscape, so a value containing / or ? stays\n223\t// inside its own segment instead of rewriting the request's target — the same\n224\t// reason SQL uses placeholders rather than string concatenation.\n225\tfunc (b *binder) path(bound map[string]string) string {\n226\t\tpath := b.in.Op.Path\n227\t\tfor _, p := range b.in.Op.Params {\n228\t\t\tif p.In != inPath {\n229\t\t\t\tcontinue\n230\t\t\t}\n231\t\n232\t\t\tvalue, ok := bound[p.Name]\n233\t\t\tif !ok {\n234\t\t\t\tcontinue\n235\t\t\t}\n236\t\n237\t\t\tpath = strings.ReplaceAll(path, \"{\"+p.Name+\"}\", url.PathEscape(value))\n238\t\t}\n239\t\n240\t\t// A leftover placeholder means the spec templated a segment it never\n241\t\t// declared a parameter for; without this the request would go to a literal\n242\t\t// \"/pets/{petId}\".\n243\t\tif strings.ContainsAny(path, \"{}\") {\n244\t\t\tb.fail(\"path %q has a placeholder the operation declares no parameter for\", b.in.Op.Path)\n245\t\t}\n246\t\n247\t\treturn path\n248\t}\n249\t\n250\t// method holds the operation's method to the HTTP token charset before it can\n251\t// become curl's `request` directive.\n252\t//\n253\t// The request line is `METHOD SP target SP HTTP/1.1`, so a method carrying a\n254\t// space rewrites the target and one carrying a CRLF appends a request of the\n255\t// caller's choosing. The method comes from the spec, which is untrusted input\n256\t// like every other source here.\n257\t//\n258\t// An empty method is left alone: it is the absence of a method rather than a\n259\t// bad one, and internal/curl already reads it as \"let curl default to GET\".\n260\tfunc (b *binder) method(method string) string {\n261\t\tif method == \"\" || isFieldName(method) {\n262\t\t\treturn method\n263\t\t}\n264\t\n265\t\t// Quoted, unlike a rejected value: a method is a verb, never a credential,\n266\t\t// and %q renders any CR or LF in it as an escape rather than a real one.\n267\t\tb.fail(\"method %q is not a valid HTTP method\", method)\n268\t\n269\t\treturn \"\"\n270\t}\n271\t\n272\t// located returns the bound parameters that belong in one location, in the\n273\t// order the spec declares them so the result is stable across runs.\n274\tfunc (b *binder) located(bound map[string]string, in string) []Pair {\n275\t\tvar out []Pair\n276\t\tfor _, p := range b.in.Op.Params {\n277\t\t\tif p.In != in {\n278\t\t\t\tcontinue\n279\t\t\t}\n280\t\n281\t\t\tvalue, ok := bound[p.Name]\n282\t\t\tif !ok {\n283\t\t\t\tcontinue\n284\t\t\t}\n285\t\n286\t\t\t// Only header names are field names. A query or cookie parameter is an\n287\t\t\t// ordinary string an API is free to spell `filter[status]`.\n288\t\t\tif in == inHeader && !isFieldName(p.Name) {\n289\t\t\t\tb.fail(\"%s declares header parameter %q, which is not a valid HTTP header name\",\n290\t\t\t\t\toperationName(b.in.Op), p.Name)\n291\t\t\t\tcontinue\n292\t\t\t}\n293\t\n294\t\t\tif SplitsRequest(p.Name, value) {\n295\t\t\t\tb.fail(\"--param %s %s (%s parameter)\", p.Name, crlfProblem, p.In)\n296\t\t\t\tcontinue\n297\t\t\t}\n298\t\n299\t\t\tout = append(out, Pair{Name: p.Name, Value: Literal(value)})\n300\t\t}\n301\t\n302\t\treturn out\n303\t}\n304\t\n305\t// headers merges the three sources of request headers. The profile is the least\n306\t// specific and only contributes names nothing else supplied, so `--header\n307\t// X-Env=explicit` overrides a profile's X-Env instead of sending both.\n308\tfunc (b *binder) headers(bound map[string]string) []Pair {\n309\t\tout := append(b.located(bound, inHeader), b.pairs(b.in.Headers, \"--header\", httpFieldName)...)\n310\t\n311\t\tif b.in.Profile == nil {\n312\t\t\treturn out\n313\t\t}\n314\t\n315\t\tset := map[string]bool{}\n316\t\tfor _, p := range out {\n317\t\t\tset[strings.ToLower(p.Name)] = true\n318\t\t}\n319\t\n320\t\tnames := make([]string, 0, len(b.in.Profile.Headers))\n321\t\tfor name := range b.in.Profile.Headers {\n322\t\t\tnames = append(names, name)\n323\t\t}\n324\t\tsort.Strings(names)\n325\t\n326\t\tfor _, name := range names {\n327\t\t\tif set[strings.ToLower(name)] {\n328\t\t\t\tcontinue\n329\t\t\t}\n330\t\n331\t\t\tvalue := b.in.Profile.Headers[name]\n332\t\t\tif !isFieldName(name) {\n333\t\t\t\tb.fail(\"profile %s sets header %q, which is not a valid HTTP header name\", b.in.Profile.Name, name)\n334\t\t\t\tcontinue\n335\t\t\t}\n336\t\t\tif SplitsRequest(name, value) {\n337\t\t\t\tb.fail(\"profile %s header %s %s\", b.in.Profile.Name, name, crlfProblem)\n338\t\t\t\tcontinue\n339\t\t\t}\n340\t\n341\t\t\tout = append(out, Pair{Name: name, Value: Literal(value)})\n342\t\t}\n343\t\n344\t\treturn out\n345\t}\n346\t\n347\t// hide marks every literal sitting under a credential-shaped name — the §5a\n348\t// built-in list: Authorization, Cookie, Proxy-Authorization, *api*key*, *token*,\n349\t// *secret* — as sensitive, so it renders `<redacted>` on every surface that\n350\t// displays a Value while still going on the wire.\n351\t//\n352\t// The name is all there is to go on. talaria cannot tell a token the user typed\n353\t// into --header from an ordinary string by looking at the string, and §5a's\n354\t// answer is that it does not have to: the name decides, whether the value came\n355\t// from a spec's security scheme, a profile, a bound parameter or the flag.\n356\t//\n357\t// red is the config file's extension of that list. A nil one is the built-in\n358\t// floor alone, which is what it has to be: redaction is never opt-in, so a\n359\t// caller that supplies no patterns gets the same protection as one that does.\n360\tfunc hide(red *secret.Redactor, pairs []Pair) []Pair {\n361\t\tfor i, p := range pairs {\n362\t\t\tif !p.Value.IsSecret() && red.IsSensitive(p.Name) {\n363\t\t\t\tpairs[i].Value = p.Value.Sensitive()\n364\t\t\t}\n365\t\t}\n366\t\n367\t\treturn pairs\n368\t}\n369\t\n370\t// pairs parses repeatable name=value flags. Only the first = separates, because\n371\t// header and query values legitimately contain more.\n372\t//\n373\t// A rejected argument is reported by position and never by content. The shell\n374\t// expanded it before talaria saw it, so `--header \"Authorization: Bearer\n375\t// $TOKEN\"` — the form a user reaches for — holds the real token, and quoting it\n376\t// back would publish the credential in the exit-2 message on stderr. §5a puts\n377\t// error paths inside the firewall, not outside it.\n378\t//\n379\t// rule, when non-nil, is the extra constraint this flag holds its names to.\n380\tfunc (b *binder) pairs(raws []string, flag string, rule *nameRule) []Pair {\n381\t\tout := make([]Pair, 0, len(raws))\n382\t\tfor i, raw := range raws {\n383\t\t\tname, value, ok := strings.Cut(raw, \"=\")\n384\t\t\tif !ok || name == \"\" {\n385\t\t\t\tb.fail(\"%s %d is not name=value%s\", flag, i+1, elided(raw))\n386\t\t\t\tcontinue\n387\t\t\t}\n388\t\n389\t\t\tif rule != nil && !rule.ok(name) {\n390\t\t\t\tb.fail(\"%s %d %s%s\", flag, i+1, rule.want, elided(name))\n391\t\t\t\tcontinue\n392\t\t\t}\n393\t\n394\t\t\tif SplitsRequest(name, value) {\n395\t\t\t\tb.fail(\"%s %d %s%s\", flag, i+1, crlfProblem, elided(raw))\n396\t\t\t\tcontinue\n397\t\t\t}\n398\t\n399\t\t\tout = append(out, Pair{Name: name, Value: Literal(value)})\n400\t\t}\n401\t\n402\t\treturn out\n403\t}\n404\t\n405\t// nameRule constrains what the name half of a name=value flag may be. Only\n406\t// --header has one: a header name goes on the wire as an HTTP field name, while\n407\t// a query parameter name is an ordinary string an API is free to spell\n408\t// `filter[status]`.\n409\ttype nameRule struct {\n410\t\t// ok reports whether the name is usable.\n411\t\tok func(string) bool\n412\t\t// want completes \"--header 2 …\" when it is not.\n413\t\twant string\n414\t}\n415\t\n416\t// httpFieldName holds --header names to what a header name can actually be.\n417\tvar httpFieldName = &nameRule{ok: isFieldName, want: \"is not a valid HTTP header name\"}\n418\t\n419\t// fieldNameChars is the token character set an HTTP field name is drawn from\n420\t// (RFC 9110 §5.1, via §5.6.2).\n421\tconst fieldNameChars = \"!#$%&'*+-.^_`|~\" +\n422\t\t\"0123456789\" +\n423\t\t\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\" +\n424\t\t\"abcdefghijklmnopqrstuvwxyz\"\n425\t\n426\t// crlfProblem completes the messages that reject a request-splitting value. It\n427\t// describes the fault without echoing what caused it, for the reason `pairs`\n428\t// gives: the value may be a credential.\n429\tconst crlfProblem = \"carries a carriage return or newline, which would end its line early and \" +\n430\t\t\"append a header the caller did not write (its value is not echoed)\"\n431\t\n432\t// SplitsRequest reports whether a name=value pair would break out of the field\n433\t// it sits in. A CR or an LF ends a header line on the wire, so a value holding\n434\t// either turns one field into two — or, with a bare CRLF pair, ends the header\n435\t// block and starts a second request on the same connection.\n436\t//\n437\t// Both halves are checked because both go on the wire: a cookie's name is\n438\t// joined to its value in one Cookie header, and a query name is only safe\n439\t// because QueryString escapes it.\n440\t//\n441\t// Escaping is deliberately not the answer. curl's config document has escapes\n442\t// for both characters (see internal/curl's escapeDirective), but they protect\n443\t// curl's *parser* — curl un-escapes them back to the literal bytes and writes\n444\t// those to the socket. A value carrying a CRLF is a value the caller cannot\n445\t// have meant, so it is a usage error, not something to sanitise into a request\n446\t// they did not ask for.\n447\t//\n448\t// It is exported for the same reason IsMethod is: internal/curl re-checks every\n449\t// pair as the last gate before the document, and a credential is only a string\n450\t// there — it is resolved after this package has finished with the Request.\n451\tfunc SplitsRequest(name, value string) bool {\n452\t\treturn strings.ContainsAny(name, \"\\r\\n\") || strings.ContainsAny(value, \"\\r\\n\")\n453\t}\n454\t\n455\t// IsMethod reports whether s can go in a request line as its method. An HTTP\n456\t// method is a token (RFC 9110 §9), the same production a field name is drawn\n457\t// from, so it is the same check under the name that says what it guards.\n458\t//\n459\t// It is exported for internal/curl, which re-checks the method as the last gate\n460\t// before the `request` directive: not every Request is built by this package —\n461\t// `history replay` rebuilds one from a stored entry — and the charset should\n462\t// not be spelled out twice.\n463\tfunc IsMethod(s string) bool { return isFieldName(s) }\n464\t\n465\t// isFieldName reports whether name can be sent as a header name.\n466\t//\n467\t// The character that fails this in practice is the colon, from curl's `Name:\n468\t// value` form: `--header 'X-Trace: abc=1'` parses as the name \"X-Trace: abc\",\n469\t// which curl's config document renders as the malformed wire header\n470\t// `X-Trace: abc: 1`. Refusing it is the difference between a request the user\n471\t// did not write and a clean exit 2.\n472\tfunc isFieldName(name string) bool {\n473\t\tfor _, r := range name {\n474\t\t\tif !strings.ContainsRune(fieldNameChars, r) {\n475\t\t\t\treturn false\n476\t\t\t}\n477\t\t}\n478\t\n479\t\treturn name != \"\"\n480\t}\n481\t\n482\t// elided describes a rejected argument without echoing what may be a\n483\t// credential: the text before its first `=` or `:`, which is a name, and\n484\t// nothing at all when it holds neither separator — an argument with no\n485\t// separator in it is indistinguishable from a bare token. Not even a truncated\n486\t// prefix of the value: part of a credential is still part of a credential.\n487\tfunc elided(raw string) string {\n488\t\tif cut := strings.IndexAny(raw, \"=:\"); cut > 0 {\n489\t\t\treturn fmt.Sprintf(\" (it starts %q; the rest is not echoed)\", raw[:cut])\n490\t\t}\n491\t\n492\t\treturn \" (its text is not echoed)\"\n493\t}\n494\t\n495\t// credentials puts each resolved credential where its scheme says it goes, as a\n496\t// reference. This is the §5a boundary: what lands on the request is the name of\n497\t// a credential and how to encode it, never the credential.\n498\tfunc (b *binder) credentials(req *Request) {\n499\t\tfor _, cred := range b.in.Creds {\n500\t\t\tpair := Pair{Name: cred.Name, Value: Secret(cred.Ref, encodingFor(cred.Kind))}\n501\t\n502\t\t\tswitch cred.In {\n503\t\t\tcase inHeader:\n504\t\t\t\treq.Headers = append(req.Headers, pair)\n505\t\t\tcase inQuery:\n506\t\t\t\treq.Query = append(req.Query, pair)\n507\t\t\tcase inCookie:\n508\t\t\t\treq.Cookies = append(req.Cookies, pair)\n509\t\t\tdefault:\n510\t\t\t\tb.fail(\"scheme %q wants its credential in %q, which is not a place a request has\",\n511\t\t\t\t\tcred.Scheme, cred.In)\n512\t\t\t}\n513\t\t}\n514\t}\n515\t\n516\tfunc encodingFor(kind config.Kind) Encoding {\n517\t\tswitch kind {\n518\t\tcase config.KindBearer:\n519\t\t\treturn EncodeBearer\n520\t\tcase config.KindBasic:\n521\t\t\treturn EncodeBasic\n522\t\tdefault:\n523\t\t\treturn EncodeRaw\n524\t\t}\n525\t}\n526\t\n527\t// declaredNames lists the parameters the operation accepts, for the\n528\t// valid_alternatives an agent corrects itself from.\n529\tfunc declaredNames(op operation.Operation) []string {\n530\t\tnames := make([]string, 0, len(op.Params))\n531\t\tfor _, p := range op.Params {\n532\t\t\tnames = append(names, p.Name)\n533\t\t}\n534\t\n535\t\treturn names\n536\t}\n537\t\n538\t// operationName is the operation's ID, falling back to method and path for a\n539\t// spec that sets no operationId.\n540\tfunc operationName(op operation.Operation) string {\n541\t\tif op.ID != \"\" {\n542\t\t\treturn op.ID\n543\t\t}\n544\t\n545\t\treturn op.Method + \" \" + op.Path\n546\t}\n547\t"
