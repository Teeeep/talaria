    "content": [
      {
        "tool_use_id": "toolu_01UorczMWnBoQVXdpL6aCWDr",
        "type": "tool_result",
        "content": "1\t// Package corpus is talaria's record of what it actually sent and what came\n2\t// back. It backs `talaria history` now and the twin's recordings later: DESIGN.md\n3\t// §5 puts it in Phase 2 even though the recording proxy is Phase 5, because\n4\t// \"history and the twin's corpus are the same data\".\n5\t//\n6\t// Everything here is written redacted. §5a calls the recording \"a permanent\n7\t// artifact — the highest-risk surface in the tool\" and answers it with\n8\t// \"redaction at write time, not read time. Un-redacted recording is not an\n9\t// option.\" An Entry is therefore built by NewEntry out of the redacted\n10\t// representation of a request and a response, and there is no path through this\n11\t// package that puts a resolved credential on disk.\n12\t//\n13\t// The package deliberately does not import internal/config: the profile's\n14\t// history setting arrives as the Enabled bool a caller passes to New, so the\n15\t// store stays usable by the twin, which has no profiles.\n16\tpackage corpus\n17\t\n18\timport (\n19\t\t\"encoding/base64\"\n20\t\t\"time\"\n21\t\t\"unicode/utf8\"\n22\t\n23\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n24\t\t\"github.com/Teeeep/talaria/internal/curl\"\n25\t\t\"github.com/Teeeep/talaria/internal/request\"\n26\t\t\"github.com/Teeeep/talaria/internal/secret\"\n27\t)\n28\t\n29\t// MaxBody is how much of a request or response body one entry keeps. A body\n30\t// past it is cut and marked truncated: history is for answering \"what have I\n31\t// already tried\", and a 40 MB download answers that no better than its first\n32\t// 64 KiB while being the difference between a store you can read and one you\n33\t// cannot.\n34\tconst MaxBody = 64 << 10\n35\t\n36\t// Source says which command produced an entry. It exists because the retention\n37\t// cap is applied per source: a `run` over a large spec must not be able to evict\n38\t// a session of interactive `call` history.\n39\ttype Source string\n40\t\n41\tconst (\n42\t\t// SourceCall is one interactive `talaria call`.\n43\t\tSourceCall Source = \"call\"\n44\t\t// SourceRun is one request made by `talaria run`.\n45\t\tSourceRun Source = \"run\"\n46\t\t// SourceReplay is a `talaria history replay` of an earlier entry.\n47\t\tSourceReplay Source = \"replay\"\n48\t)\n49\t\n50\t// Entry is one recorded request/response pair, already redacted.\n51\t//\n52\t// A Response of nil is a request that produced no observation — a dry run, or a\n53\t// call whose connection failed — which is still worth recording as something\n54\t// that was tried.\n55\ttype Entry struct {\n56\t\t// ID is the entry's stable handle, assigned by Store.Append. A positional\n57\t\t// index is recomputed on every read, and `call`, `run` and `replay` all\n58\t\t// append, so the index printed by one command has already shifted by the time\n59\t\t// the next one runs; the id is what lets `history show` and `history replay`\n60\t\t// name the same entry twice in a row.\n61\t\t//\n62\t\t// An entry written by an older talaria has none. It stays empty rather than\n63\t\t// being invented at read time, because an id derived on the way out would\n64\t\t// differ between two reads and could collide with an assigned one.\n65\t\tID          string    `json:\"id,omitempty\"`\n66\t\tTimestamp   time.Time `json:\"timestamp\"`\n67\t\tSource      Source    `json:\"source\"`\n68\t\tOperationID string    `json:\"operation_id,omitempty\"`\n69\t\tMethod      string    `json:\"method\"`\n70\t\t// URL is the full request URL with credentials in the query string rendered\n71\t\t// as <redacted:env:NAME>.\n72\t\tURL      string         `json:\"url\"`\n73\t\tRequest  EntryRequest   `json:\"request\"`\n74\t\tResponse *EntryResponse `json:\"response,omitempty\"`\n75\t}\n76\t\n77\t// EntryRequest is the redacted request. Headers and cookies are maps rather\n78\t// than ordered pairs because history is read by name; a name that repeats is\n79\t// joined the way HTTP joins repeated field values.\n80\ttype EntryRequest struct {\n81\t\tHeaders map[string]string `json:\"headers,omitempty\"`\n82\t\tCookies map[string]string `json:\"cookies,omitempty\"`\n83\t\tBody    *Body             `json:\"body,omitempty\"`\n84\t}\n85\t\n86\t// EntryResponse is the redacted response. Headers keep their repetitions, since\n87\t// Set-Cookie legitimately appears more than once.\n88\ttype EntryResponse struct {\n89\t\tStatus   int                 `json:\"status\"`\n90\t\tHeaders  map[string][]string `json:\"headers,omitempty\"`\n91\t\tBody     *Body               `json:\"body,omitempty\"`\n92\t\tTimingMS int64               `json:\"timing_ms\"`\n93\t}\n94\t\n95\t// EncodingBase64 marks a Data that holds standard base64 rather than the body's\n96\t// own bytes. It is the only encoding this build writes or reads.\n97\tconst EncodingBase64 = \"base64\"\n98\t\n99\t// Body is a recorded body and how much of it was kept.\n100\ttype Body struct {\n101\t\tContentType string `json:\"content_type,omitempty\"`\n102\t\tData        string `json:\"data\"`\n103\t\t// Encoding says how to read Data. Empty means Data is the body's bytes as\n104\t\t// text, which is the case for everything that is valid UTF-8; a body that is\n105\t\t// not gets EncodingBase64, because a JSON string cannot carry an invalid\n106\t\t// byte — encoding/json rewrites each one to U+FFFD, and a reader replaying\n107\t\t// that would send bytes the original call never sent.\n108\t\tEncoding string `json:\"encoding,omitempty\"`\n109\t\t// Truncated reports that Data is the first MaxBody bytes and not the whole\n110\t\t// body. It is explicit so a reader never mistakes a cut body for what the\n111\t\t// server sent.\n112\t\tTruncated bool `json:\"truncated,omitempty\"`\n113\t}\n114\t\n115\t// Bytes returns the recorded body as the bytes it was on the wire.\n116\t//\n117\t// An encoding this build does not know is refused rather than guessed at: the\n118\t// store is a file anything can write, and a newer talaria may have added one.\n119\t// Reading such a Data as literal text is the exact silent corruption the\n120\t// Encoding field exists to prevent.\n121\tfunc (b Body) Bytes() ([]byte, error) {\n122\t\tswitch b.Encoding {\n123\t\tcase \"\":\n124\t\t\treturn []byte(b.Data), nil\n125\t\tcase EncodingBase64:\n126\t\t\tdata, err := base64.StdEncoding.DecodeString(b.Data)\n127\t\t\tif err != nil {\n128\t\t\t\treturn nil, clierr.Usage(\"the recorded body claims %s encoding but does not decode: %v\", EncodingBase64, err)\n129\t\t\t}\n130\t\n131\t\t\treturn data, nil\n132\t\tdefault:\n133\t\t\treturn nil, clierr.Usage(\"the recorded body has encoding %q, which this version of talaria cannot read\", b.Encoding)\n134\t\t}\n135\t}\n136\t\n137\t// Redactors are the two firewalls an entry passes through on its way to disk.\n138\t// Both are nil-safe: the zero Redactors applies the built-in lists, so a caller\n139\t// that forgets to configure them records less rather than more.\n140\ttype Redactors struct {\n141\t\t// Request matches request header names against the built-in credential list\n142\t\t// plus whatever the profile added.\n143\t\tRequest *secret.Redactor\n144\t\t// Response redacts response headers by name and both bodies by JSON path.\n145\t\tResponse *secret.ResponseRedactor\n146\t}\n147\t\n148\t// NewEntry builds the record of one request and the response it produced.\n149\t//\n150\t// Redaction happens here rather than at read time, and it happens before\n151\t// truncation: cutting a JSON body first would leave a prefix the path redactor\n152\t// can no longer parse, and a secret in that prefix would survive.\n153\tfunc NewEntry(source Source, req *request.Request, resp *curl.Response, red Redactors) Entry {\n154\t\tentry := Entry{\n155\t\t\tTimestamp: time.Now().UTC(),\n156\t\t\tSource:    source,\n157\t\t}\n158\t\n159\t\tif req != nil {\n160\t\t\tentry.OperationID = req.OperationID\n161\t\t\tentry.Method = req.Method\n162\t\t\t// request.Redacted cannot fail, and a URL that somehow did not render is\n163\t\t\t// not worth dropping the whole recording over.\n164\t\t\tentry.URL, _ = req.URL(request.Redacted)\n165\t\t\tentry.Request = EntryRequest{\n166\t\t\t\tHeaders: red.headers(req.Headers),\n167\t\t\t\tCookies: red.cookies(req.Cookies),\n168\t\t\t\tBody:    red.requestBody(req.Body),\n169\t\t\t}\n170\t\t}\n171\t\n172\t\tif resp != nil {\n173\t\t\tentry.Response = &EntryResponse{\n174\t\t\t\tStatus:   resp.Status,\n175\t\t\t\tHeaders:  red.Response.Headers(resp.Headers),\n176\t\t\t\tBody:     newBody(contentType(resp.Headers), red.Response.Body(resp.Body)),\n177\t\t\t\tTimingMS: resp.TimingMS,\n178\t\t\t}\n179\t\t}\n180\t\n181\t\treturn entry\n182\t}\n183\t\n184\t// headers renders the request headers by whichever route redacts them.\n185\t//\n186\t// A Value holding a SecretRef prints as <redacted:env:NAME> by construction and\n187\t// keeps that form, which tells a reader which variable to export. Everything\n188\t// else goes through the name-based matcher, which is what catches a credential\n189\t// the user typed into --header as a literal — nothing structural would.\n190\tfunc (r Redactors) headers(pairs []request.Pair) map[string]string {\n191\t\tif len(pairs) == 0 {\n192\t\t\treturn nil\n193\t\t}\n194\t\n195\t\tout := make(map[string]string, len(pairs))\n196\t\tfor _, p := range pairs {\n197\t\t\tvalue := p.Value.String()\n198\t\t\tif !p.Value.IsSecret() {\n199\t\t\t\tvalue = r.Request.Value(p.Name, value)\n200\t\t\t}\n201\t\t\tif existing, ok := out[p.Name]; ok {\n202\t\t\t\tvalue = existing + \", \" + value\n203\t\t\t}\n204\t\t\tout[p.Name] = value\n205\t\t}\n206\t\n207\t\treturn out\n208\t}\n209\t\n210\t// cookies records cookie names and no literal cookie values.\n211\t//\n212\t// On the wire these are one Cookie header, which the built-in list redacts\n213\t// whole; matching a per-cookie name like \"session\" against that list would\n214\t// catch nothing, so keeping literals here would make the same credential safe\n215\t// as a header and exposed as a cookie. A cookie that names a SecretRef keeps\n216\t// its <redacted:env:NAME> form, which says more than the placeholder does.\n217\tfunc (r Redactors) cookies(pairs []request.Pair) map[string]string {\n218\t\tif len(pairs) == 0 {\n219\t\t\treturn nil\n220\t\t}\n221\t\n222\t\tout := make(map[string]string, len(pairs))\n223\t\tfor _, p := range pairs {\n224\t\t\tif p.Value.IsSecret() {\n225\t\t\t\tout[p.Name] = p.Value.String()\n226\t\t\t\tcontinue\n227\t\t\t}\n228\t\t\tout[p.Name] = secret.Placeholder\n229\t\t}\n230\t\n231\t\treturn out\n232\t}\n233\t\n234\t// requestBody redacts and cuts the body that was sent. The response redactor's\n235\t// JSON paths are applied to it too: the built-in list names access_token and\n236\t// refresh_token, and a token-refresh request carries one in exactly that field.\n237\tfunc (r Redactors) requestBody(b *request.Body) *Body {\n238\t\tif b == nil {\n239\t\t\treturn nil\n240\t\t}\n241\t\n242\t\treturn newBody(b.ContentType, r.Response.Body(b.Data))\n243\t}\n244\t\n245\t// newBody keeps at most MaxBody bytes of data, reporting whether it had to cut.\n246\t//\n247\t// A JSONL line has to stay parseable — one unparseable line is one a reader has\n248\t// to skip — and encoding/json buys that by rewriting every byte a Go string\n249\t// cannot hold to U+FFFD. That is fine for text and destroys anything else, so\n250\t// the bytes are checked first: valid UTF-8 is stored as itself and stays\n251\t// readable in the store, and anything else is base64'd so the entry survives the\n252\t// round trip byte for byte. The cut is at a byte offset and may land inside a\n253\t// UTF-8 sequence, which lands such a body in the base64 case too.\n254\tfunc newBody(contentType string, data []byte) *Body {\n255\t\tif len(data) == 0 {\n256\t\t\treturn nil\n257\t\t}\n258\t\n259\t\tbody := &Body{ContentType: contentType}\n260\t\tif len(data) > MaxBody {\n261\t\t\tdata = data[:MaxBody]\n262\t\t\tbody.Truncated = true\n263\t\t}\n264\t\tif utf8.Valid(data) {\n265\t\t\tbody.Data = string(data)\n266\t\n267\t\t\treturn body\n268\t\t}\n269\t\tbody.Data = base64.StdEncoding.EncodeToString(data)\n270\t\tbody.Encoding = EncodingBase64\n271\t\n272\t\treturn body\n273\t}\n274\t\n275\t// contentType reads the media type off a response, for a reader deciding how to\n276\t// interpret the recorded bytes.\n277\tfunc contentType(headers map[string][]string) string {\n278\t\tfor _, value := range headers[\"Content-Type\"] {\n279\t\t\treturn value\n280\t\t}\n281\t\n282\t\treturn \"\"\n283\t}\n284\t"
      }
    ]
  },
