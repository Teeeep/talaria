    "role": "user",
    "content": [
      {
        "tool_use_id": "toolu_01KhTKtEqP8XjnU3K4RufFi4",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"net/http\"\n9\t\t\"strconv\"\n10\t\t\"strings\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/spf13/cobra\"\n14\t\n15\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n16\t\t\"github.com/Teeeep/talaria/internal/config\"\n17\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n18\t\t\"github.com/Teeeep/talaria/internal/curl\"\n19\t\t\"github.com/Teeeep/talaria/internal/operation\"\n20\t\t\"github.com/Teeeep/talaria/internal/output\"\n21\t\t\"github.com/Teeeep/talaria/internal/request\"\n22\t\t\"github.com/Teeeep/talaria/internal/secret\"\n23\t\t\"github.com/Teeeep/talaria/internal/spec\"\n24\t\t\"github.com/Teeeep/talaria/internal/validate\"\n25\t)\n26\t\n27\t// callView is the payload from DESIGN.md §4's sketch. A dry run fills in\n28\t// everything except the response and validation blocks, so an agent parses one\n29\t// structure whether or not the request was sent.\n30\ttype callView struct {\n31\t\tDryRun     bool             `json:\"dry_run\"`\n32\t\tRequest    requestView      `json:\"request\"`\n33\t\tResponse   *responseView    `json:\"response,omitempty\"`\n34\t\tValidation *validate.Result `json:\"validation,omitempty\"`\n35\t}\n36\t\n37\t// requestView is what was, or would have been, sent. Curl is the symbolic\n38\t// reproduction; every other field is the redacted display form.\n39\ttype requestView struct {\n40\t\tCurl    string            `json:\"curl\"`\n41\t\tMethod  string            `json:\"method\"`\n42\t\tURL     string            `json:\"url\"`\n43\t\tHeaders map[string]string `json:\"headers,omitempty\"`\n44\t\tCookies map[string]string `json:\"cookies,omitempty\"`\n45\t\tBody    string            `json:\"body,omitempty\"`\n46\t}\n47\t\n48\t// responseView is what came back. Headers keep their repetitions — Set-Cookie\n49\t// legitimately appears more than once, and HTTP forbids folding it into one\n50\t// comma-joined value the way requestView's map does.\n51\ttype responseView struct {\n52\t\tStatus   int                 `json:\"status\"`\n53\t\tHeaders  map[string][]string `json:\"headers\"`\n54\t\tBody     responseBody        `json:\"body\"`\n55\t\tTimingMS int64               `json:\"timing_ms\"`\n56\t}\n57\t\n58\t// responseBody is the raw bytes of a response, rendered per §4's sketch: a JSON\n59\t// body is embedded as JSON so an agent can reach into it with one parse instead\n60\t// of two, and anything else becomes a string.\n61\ttype responseBody []byte\n62\t\n63\t// MarshalJSON embeds the body when it is a JSON object or array, and quotes it\n64\t// otherwise.\n65\t//\n66\t// The object/array test is deliberately narrower than \"is valid JSON\": a\n67\t// plain-text body of `42` or `true` parses as JSON, and embedding it would\n68\t// report a document the server never sent. Composite syntax is unambiguous, so\n69\t// that is where the line goes.\n70\tfunc (b responseBody) MarshalJSON() ([]byte, error) {\n71\t\tif len(b) == 0 {\n72\t\t\treturn []byte(\"null\"), nil\n73\t\t}\n74\t\n75\t\ttrimmed := bytes.TrimLeft(b, \" \\t\\r\\n\")\n76\t\tif len(trimmed) > 0 && (trimmed[0] == '{' || trimmed[0] == '[') && json.Valid(trimmed) {\n77\t\t\t// encoding/json compacts and re-validates whatever a MarshalJSON returns,\n78\t\t\t// so the body's own formatting does not leak into the envelope.\n79\t\t\treturn trimmed, nil\n80\t\t}\n81\t\n82\t\treturn json.Marshal(string(b))\n83\t}\n84\t\n85\tfunc newCallCmd() *cobra.Command {\n86\t\tvar (\n87\t\t\tparams         []string\n88\t\t\tqueries        []string\n89\t\t\theaders        []string\n90\t\t\tbody           []string\n91\t\t\tdryRun         bool\n92\t\t\tallowMutations bool\n93\t\t\tfailOnError    bool\n94\t\t\ttimeout        float64\n95\t\t)\n96\t\n97\t\t// Built here rather than per-run so the warning fires once for the whole\n98\t\t// command tree, which — since main calls run exactly once — is once per\n99\t\t// process (§5a). Tests get a fresh tree, and so a fresh warner, per case.\n100\t\twarner := secret.NewQueryKeyWarner()\n101\t\n102\t\tcmd := &cobra.Command{\n103\t\t\tUse:   \"call [spec] <operationId>\",\n104\t\t\tShort: \"Build a request for one operation and show the curl that runs it\",\n105\t\t\tLong: \"Bind parameters, headers and credentials to an operation and render the\\n\" +\n106\t\t\t\t\"request as curl. Credentials are referenced by environment-variable name,\\n\" +\n107\t\t\t\t\"never by value, so the emitted command is safe to paste into a bug report\\n\" +\n108\t\t\t\t\"and runnable wherever the variable is set.\",\n109\t\t\tArgs: usageArgs(cobra.RangeArgs(1, 2)),\n110\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n111\t\t\t\tformat, err := resolveFormat(cmd)\n112\t\t\t\tif err != nil {\n113\t\t\t\t\treturn err\n114\t\t\t\t}\n115\t\n116\t\t\t\t// The operationId is always last: with one argument the spec comes\n117\t\t\t\t// from --spec or the environment, with two it is the first.\n118\t\t\t\tid := args[len(args)-1]\n119\t\n120\t\t\t\tdoc, index, err := loadSpec(cmd, args[:len(args)-1])\n121\t\t\t\tif err != nil {\n122\t\t\t\t\treturn err\n123\t\t\t\t}\n124\t\n125\t\t\t\top, err := index.Lookup(id)\n126\t\t\t\tif err != nil {\n127\t\t\t\t\treturn err\n128\t\t\t\t}\n129\t\n130\t\t\t\t// Gated before the request is built, and before --dry-run is even\n131\t\t\t\t// consulted: an agent that tried to POST learns the rule in one\n132\t\t\t\t// round trip rather than after fixing an unrelated flag, and\n133\t\t\t\t// without a network call (DESIGN.md §4).\n134\t\t\t\tif op.IsMutation() && !allowMutations {\n135\t\t\t\t\treturn clierr.Usage(\n136\t\t\t\t\t\t\"%s is a %s request and may change server state: pass --allow-mutations to call it\",\n137\t\t\t\t\t\toperationName(op), op.Method)\n138\t\t\t\t}\n139\t\n140\t\t\t\t// Read whether or not --profile was given: the redaction lists are a\n141\t\t\t\t// security setting, and one that only takes effect when you happen to\n142\t\t\t\t// be using a profile is one that silently does not.\n143\t\t\t\tcfg, err := config.Load(\"\")\n144\t\t\t\tif err != nil {\n145\t\t\t\t\treturn err\n146\t\t\t\t}\n147\t\n148\t\t\t\treq, err := buildRequest(cmd, cfg, op, doc, params, queries, headers, body)\n149\t\t\t\tif err != nil {\n150\t\t\t\t\treturn err\n151\t\t\t\t}\n152\t\n153\t\t\t\t// Before the dry-run branch: the exposure is a property of the\n154\t\t\t\t// request's shape, and an emitted curl is a command the caller may\n155\t\t\t\t// well run.\n156\t\t\t\twarnQueryCredentials(cmd.ErrOrStderr(), warner, req)\n157\t\n158\t\t\t\tstore, err := openHistory(cmd, cfg)\n159\t\t\t\tif err != nil {\n160\t\t\t\t\treturn err\n161\t\t\t\t}\n162\t\n163\t\t\t\trenderer := output.New(format, cmd.OutOrStdout())\n164\t\t\t\tredactors := newRedactors(cfg)\n165\t\t\t\tif dryRun {\n166\t\t\t\t\t// Nothing is recorded: a dry run is a question about a request,\n167\t\t\t\t\t// not a request, and history answers \"what have I already tried\".\n168\t\t\t\t\t// Nothing is validated either — an empty validation block would\n169\t\t\t\t\t// read as \"checked, and fine\".\n170\t\t\t\t\treturn renderer.Render(callPayload(req, nil, nil))\n171\t\t\t\t}\n172\t\n173\t\t\t\tresp, execErr := curl.ExecuteWith(cmd.Context(), req, timeoutOptions(timeout))\n174\t\t\t\t// Recorded either way. A request that never completed is still\n175\t\t\t\t// something that was tried, and the entry says so by having no\n176\t\t\t\t// response block at all.\n177\t\t\t\trecordCall(cmd.ErrOrStderr(), store, corpus.SourceCall, req, resp, redactors)\n178\t\t\t\tif execErr != nil {\n179\t\t\t\t\treturn execErr\n180\t\t\t\t}\n181\t\n182\t\t\t\tview := redactResponse(resp, redactors.Response)\n183\t\t\t\tresult := validateResponse(cmd.ErrOrStderr(), doc, req, view)\n184\t\n185\t\t\t\t// Rendered before the exit code is decided: --fail-on-error changes\n186\t\t\t\t// what the process exits with, not what the caller gets to read. An\n187\t\t\t\t// agent that asked for the flag still gets the full observation on\n188\t\t\t\t// stdout to act on.\n189\t\t\t\tif err := renderer.Render(callPayload(req, view, result)); err != nil {\n190\t\t\t\t\treturn err\n191\t\t\t\t}\n192\t\t\t\tif !failOnError {\n193\t\t\t\t\treturn nil\n194\t\t\t\t}\n195\t\n196\t\t\t\treturn callFailure(view, result)\n197\t\t\t},\n198\t\t}\n199\t\n200\t\t// Local to call: these are how one request is parameterised, and no other\n201\t\t// command binds parameters. --profile and --base-url are persistent on the\n202\t\t// root, because run and auth check take them too.\n203\t\tcmd.Flags().StringArrayVar(&params, \"param\", nil,\n204\t\t\t\"bind a declared parameter, name=value (repeatable)\")\n205\t\tcmd.Flags().StringArrayVar(&queries, \"query\", nil,\n206\t\t\t\"add a query parameter, name=value (repeatable)\")\n207\t\tcmd.Flags().StringArrayVar(&headers, \"header\", nil,\n208\t\t\t\"add a request header, name=value (repeatable)\")\n209\t\tcmd.Flags().StringArrayVar(&body, \"body\", nil,\n210\t\t\t\"request body: a literal, @file to read one, or - to read this process's stdin\")\n211\t\tcmd.Flags().BoolVar(&dryRun, \"dry-run\", false,\n212\t\t\t\"print the curl command and send nothing\")\n213\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n214\t\t\t\"permit a method other than GET, HEAD or OPTIONS\")\n215\t\tcmd.Flags().BoolVar(&failOnError, \"fail-on-error\", false,\n216\t\t\t\"exit 4 if the response is an HTTP error or violates the spec\")\n217\t\tcmd.Flags().Float64Var(&timeout, \"timeout\", curl.DefaultMaxTime.Seconds(),\n218\t\t\t\"give up on the request after this many seconds\")\n219\t\n220\t\treturn cmd\n221\t}\n222\t\n223\t// timeoutOptions turns the --timeout flag into the executor's options, shared by\n224\t// call and run because both bound one request the same way.\n225\t//\n226\t// A non-positive value falls back to the default rather than meaning \"no\n227\t// limit\": a call that can hang forever is what the flag exists to prevent, and\n228\t// `--timeout 0` is far more likely to be a mistake than a request for one.\n229\tfunc timeoutOptions(seconds float64) curl.Options {\n230\t\treturn curl.Options{MaxTime: time.Duration(seconds * float64(time.Second))}\n231\t}\n232\t\n233\t// newRedactors builds the pair of firewalls an entry passes through on its way\n234\t// to disk, extended with whatever the config file added. Request and response\n235\t// share the header list: a name worth hiding on the way back is worth hiding on\n236\t// the way out.\n237\tfunc newRedactors(cfg *config.Config) corpus.Redactors {\n238\t\treturn corpus.Redactors{\n239\t\t\tRequest:  secret.NewRedactor(cfg.Redact.Headers...),\n240\t\t\tResponse: secret.NewResponseRedactor(cfg.Redact.Headers, cfg.Redact.BodyPaths),\n241\t\t}\n242\t}\n243\t\n244\t// recordCall writes one entry, reporting a failure to write as a warning and\n245\t// nothing more.\n246\t//\n247\t// A call that reached the server and came back succeeded; whether talaria then\n248\t// managed to write the fact down is not a reason to change the exit code an\n249\t// agent branches on. The warning still goes to stderr, because history silently\n250\t// not recording is how a user discovers weeks later that it never was.\n251\tfunc recordCall(\n252\t\tstderr io.Writer,\n253\t\tstore *corpus.Store,\n254\t\tsource corpus.Source,\n255\t\treq *request.Request,\n256\t\tresp *curl.Response,\n257\t\tred corpus.Redactors,\n258\t) {\n259\t\tif !store.Recording() {\n260\t\t\treturn\n261\t\t}\n262\t\n263\t\tif err := store.Append(corpus.NewEntry(source, req, resp, red)); err != nil {\n264\t\t\tfmt.Fprintf(stderr, \"warning: the call was not recorded in history: %v\\n\", err)\n265\t\t}\n266\t}\n267\t\n268\t// buildRequest resolves the profile and the operation's credentials, then binds\n269\t// the flags to the operation.\n270\tfunc buildRequest(\n271\t\tcmd *cobra.Command,\n272\t\tcfg *config.Config,\n273\t\top operation.Operation,\n274\t\tdoc *spec.Document,\n275\t\tparams, queries, headers, body []string,\n276\t) (*request.Request, error) {\n277\t\tprof, err := selectProfile(cmd, cfg)\n278\t\tif err != nil {\n279\t\t\treturn nil, err\n280\t\t}\n281\t\n282\t\tcreds, err := config.Resolve(op, doc, prof)\n283\t\tif err != nil {\n284\t\t\treturn nil, err\n285\t\t}\n286\t\n287\t\tbaseURL, err := cmd.Flags().GetString(\"base-url\")\n288\t\tif err != nil {\n289\t\t\treturn nil, clierr.Usage(\"%w\", err)\n290\t\t}\n291\t\n292\t\treturn request.Build(request.Inputs{\n293\t\t\tOp:      op,\n294\t\t\tDoc:     doc,\n295\t\t\tProfile: prof,\n296\t\t\tCreds:   creds,\n297\t\t\tBaseURL: baseURL,\n298\t\t\tParams:  params,\n299\t\t\tQuery:   queries,\n300\t\t\tHeaders: headers,\n301\t\t\tBody:    body,\n302\t\t\t// The same list history is redacted with. A pattern that hides a value\n303\t\t\t// in the permanent artifact but not on the stdout an agent reads has\n304\t\t\t// the firewall backwards.\n305\t\t\tRedactor: newRedactors(cfg).Request,\n306\t\t\t// The Go process owns the real stdin, and `--body -` is the only thing\n307\t\t\t// that reads it. curl's stdin carries the config document and nothing\n308\t\t\t// else (DESIGN.md §5a).\n309\t\t\tStdin: cmd.InOrStdin(),\n310\t\t})\n311\t}\n312\t\n313\t// selectProfile picks the profile named by --profile out of an already-loaded\n314\t// config, or returns nil when no name was given.\n315\tfunc selectProfile(cmd *cobra.Command, cfg *config.Config) (*config.Profile, error) {\n316\t\tname, err := cmd.Flags().GetString(\"profile\")\n317\t\tif err != nil {\n318\t\t\treturn nil, clierr.Usage(\"%w\", err)\n319\t\t}\n320\t\tif name == \"\" {\n321\t\t\treturn nil, nil\n322\t\t}\n323\t\n324\t\treturn cfg.Profile(name)\n325\t}\n326\t\n327\t// warnQueryCredentials fires the one-time query-string warning if this request\n328\t// carries a credential in its URL. One warning covers the request: a scheme\n329\t// that puts two keys in the query string is a curiosity, and the point is made\n330\t// by the first.\n331\tfunc warnQueryCredentials(stderr io.Writer, warner *secret.QueryKeyWarner, req *request.Request) {\n332\t\tfor _, p := range req.Query {\n333\t\t\tif p.Value.IsSecret() {\n334\t\t\t\twarner.Warn(stderr, p.Name, p.Value.Ref())\n335\t\t\t\treturn\n336\t\t\t}\n337\t\t}\n338\t}\n339\t\n340\t// redactResponse turns what came off the wire into the display form everything\n341\t// downstream reads. It is the only conversion from curl.Response to\n342\t// responseView, so there is one place where a response stops being raw.\n343\tfunc redactResponse(resp *curl.Response, redactor *secret.ResponseRedactor) *responseView {\n344\t\treturn &responseView{\n345\t\t\tStatus:   resp.Status,\n346\t\t\tHeaders:  redactor.Headers(resp.Headers),\n347\t\t\tBody:     responseBody(redactor.Body(resp.Body)),\n348\t\t\tTimingMS: resp.TimingMS,\n349\t\t}\n350\t}\n351\t\n352\t// validateResponse checks the response against the operation's declared\n353\t// contract, on the *redacted* representation.\n354\t//\n355\t// That is §5a's rule for error paths: validation errors quote the content they\n356\t// rejected, so a validator fed the raw body is a leak channel — the one place a\n357\t// response secret would reappear after redaction removed it. The cost is that a\n358\t// redacted field is validated as `<redacted>`, so redacting a field the schema\n359\t// constrains produces a violation the server did not commit. That is the right\n360\t// way round: a spurious error is visible and correctable, a leaked credential\n361\t// is neither.\n362\t//\n363\t// A response that cannot be validated at all is a warning, not a failure. The\n364\t// call reached the server and came back; whether talaria could then check it\n365\t// against the spec is not a reason to change the exit code an agent branches on.\n366\tfunc validateResponse(\n367\t\tstderr io.Writer,\n368\t\tdoc *spec.Document,\n369\t\treq *request.Request,\n370\t\tview *responseView,\n371\t) *validate.Result {\n372\t\tresult, err := validate.Response(doc, validationInput(req, view))\n373\t\n374\t\treturn reportValidation(stderr, result, err)\n375\t}\n376\t\n377\t// validateWith is validateResponse against a validator that is already built.\n378\t// `run` makes one per suite rather than one per response, because building it\n379\t// compiles every schema in the document.\n380\tfunc validateWith(\n381\t\tstderr io.Writer,\n382\t\tvalidator *validate.Validator,\n383\t\treq *request.Request,\n384\t\tview *responseView,\n385\t) *validate.Result {\n386\t\tresult, err := validator.Response(validationInput(req, view))\n387\t\n388\t\treturn reportValidation(stderr, result, err)\n389\t}\n390\t\n391\t// validationInput is the one conversion from a request and a redacted response\n392\t// into what the validator reads, so `call` and `run` cannot check different\n393\t// things.\n394\tfunc validationInput(req *request.Request, view *responseView) validate.Input {\n395\t\treturn validate.Input{\n396\t\t\tMethod:  req.Method,\n397\t\t\tURL:     curl.URL(req),\n398\t\t\tStatus:  view.Status,\n399\t\t\tHeaders: http.Header(view.Headers),\n400\t\t\tBody:    view.Body,\n401\t\t}\n402\t}\n403\t\n404\t// reportValidation turns a validator failure into a warning and no result.\n405\tfunc reportValidation(stderr io.Writer, result *validate.Result, err error) *validate.Result {\n406\t\tif err != nil {\n407\t\t\tfmt.Fprintf(stderr, \"warning: the response was not validated: %v\\n\", err)\n408\t\t\treturn nil\n409\t\t}\n410\t\n411\t\treturn result\n412\t}\n413\t\n414\t// callFailure is what --fail-on-error turns an observation into.\n415\t//\n416\t// Both cases exit 4 (§4). The HTTP status is reported first when both apply:\n417\t// a 500 whose body does not match the spec's error schema is a server that is\n418\t// down, not a server with a documentation problem.\n419\t//\n420\t// The message summarises rather than quotes. The errors themselves are already\n421\t// on stdout, structured and per-field, which is the surface built for reading\n422\t// them; repeating one here would only add a second place for content to escape.\n423\tfunc callFailure(view *responseView, result *validate.Result) error {\n424\t\tif view.Status >= http.StatusBadRequest {\n425\t\t\treturn clierr.Validation(\"the server returned %s\", statusText(view.Status))\n426\t\t}\n427\t\tif result != nil && len(result.Errors) > 0 {\n428\t\t\treturn clierr.Validation(\"the response violates the spec: %s\",\n429\t\t\t\tpluralise(len(result.Errors), \"validation error\"))\n430\t\t}\n431\t\n432\t\treturn nil\n433\t}\n434\t\n435\t// pluralise renders a count with its noun, adding the s English adds.\n436\tfunc pluralise(n int, noun string) string {\n437\t\tif n == 1 {\n438\t\t\treturn \"1 \" + noun\n439\t\t}\n440\t\n441\t\treturn fmt.Sprintf(\"%d %ss\", n, noun)\n442\t}\n443\t\n444\t// callPayload renders one call in both shapes from the same values, so the JSON\n445\t// block and the printed command cannot disagree about what was sent. A nil resp\n446\t// is a dry run: the request block is identical either way, which is what makes\n447\t// `--dry-run` a faithful preview rather than a separate code path.\n448\t//\n449\t// The view is built from the request's *redacted* representation throughout —\n450\t// requestView holds Value.String() and curl.Render's symbolic form, never a\n451\t// resolved credential. The only code that resolves one is internal/curl, at\n452\t// exec time, and it hands back a Response rather than a Request (§5a).\n453\tfunc callPayload(req *request.Request, resp *responseView, result *validate.Result) output.Payload {\n454\t\tview := callView{\n455\t\t\tDryRun: resp == nil,\n456\t\t\tRequest: requestView{\n457\t\t\t\tCurl:    curl.Render(req),\n458\t\t\t\tMethod:  req.Method,\n459\t\t\t\tURL:     curl.URL(req),\n460\t\t\t\tHeaders: pairMap(req.Headers),\n461\t\t\t\tCookies: pairMap(req.Cookies),\n462\t\t\t},\n463\t\t}\n464\t\tif req.Body != nil {\n465\t\t\tview.Request.Body = string(req.Body.Data)\n466\t\t}\n467\t\n468\t\t// One line each: the request being described, then the command that makes\n469\t\t// it. A table would put the curl in a column and pad it into unreadability.\n470\t\trows := [][]string{\n471\t\t\t{view.Request.Method + \" \" + view.Request.URL},\n472\t\t\t{view.Request.Curl},\n473\t\t}\n474\t\n475\t\tif resp != nil {\n476\t\t\tview.Response = resp\n477\t\t\tview.Validation = result\n478\t\t\t// Status and timing only. The response headers are not summarised here\n479\t\t\t// because a Set-Cookie or an X-Auth-Token would land in a human's\n480\t\t\t// scrollback unasked; --output json is where the full response lives.\n481\t\t\trows = append(rows, []string{statusLine(resp)})\n482\t\t\t// A count, not the messages: a human scanning a call wants to know\n483\t\t\t// whether to go look. The messages are in --output json, where they can\n484\t\t\t// be read whole rather than truncated into a table cell.\n485\t\t\tif result != nil {\n486\t\t\t\trows = append(rows, []string{validationLine(result)})\n487\t\t\t}\n488\t\t}\n489\t\n490\t\treturn output.Payload{Data: view, Table: output.Table{Rows: rows}}\n491\t}\n492\t\n493\t// statusLine is the pretty renderer's one-line summary of a response.\n494\tfunc statusLine(resp *responseView) string {\n495\t\treturn fmt.Sprintf(\"%s in %dms\", statusText(resp.Status), resp.TimingMS)\n496\t}\n497\t\n498\t// statusText renders a status code with its reason phrase, for a code that has\n499\t// one.\n500\tfunc statusText(status int) string {\n501\t\tline := strconv.Itoa(status)\n502\t\tif text := http.StatusText(status); text != \"\" {\n503\t\t\tline += \" \" + text\n504\t\t}\n505\t\n506\t\treturn line\n507\t}\n508\t\n509\t// validationLine is the pretty renderer's one-line summary of the validation\n510\t// block.\n511\tfunc validationLine(result *validate.Result) string {\n512\t\tif len(result.Errors) == 0 {\n513\t\t\treturn \"validation: ok\"\n514\t\t}\n515\t\n516\t\treturn \"validation: \" + pluralise(len(result.Errors), \"error\")\n517\t}\n518\t\n519\t// pairMap renders headers or cookies as the object §4's sketch shows. Values\n520\t// are the redacted display form: this field is read, not run, so it carries\n521\t// <redacted:env:NAME> rather than the shell reference. A name that repeats is\n522\t// joined the way HTTP itself joins repeated field values, so nothing is lost.\n523\tfunc pairMap(pairs []request.Pair) map[string]string {\n524\t\tif len(pairs) == 0 {\n525\t\t\treturn nil\n526\t\t}\n527\t\n528\t\tout := make(map[string]string, len(pairs))\n529\t\tfor _, p := range pairs {\n530\t\t\tif existing, ok := out[p.Name]; ok {\n531\t\t\t\tout[p.Name] = existing + \", \" + p.Value.String()\n532\t\t\t\tcontinue\n533\t\t\t}\n534\t\t\tout[p.Name] = p.Value.String()\n535\t\t}\n536\t\n537\t\treturn out\n538\t}\n539\t\n540\t// operationName is the operation's ID, falling back to method and path for a\n541\t// spec that sets no operationId.\n542\tfunc operationName(op operation.Operation) string {\n543\t\tif op.ID != \"\" {\n544\t\t\treturn op.ID\n545\t\t}\n546\t\n547\t\treturn strings.TrimSpace(op.Method + \" \" + op.Path)\n548\t}\n549\t"
      }
    ]
  },
