        "tool_use_id": "toolu_012cqC58USaiX8rLNweDw4v4",
        "type": "tool_result",
        "content": "1\tpackage e2e\n2\t\n3\timport (\n4\t\t\"os/exec\"\n5\t\t\"path/filepath\"\n6\t\t\"strings\"\n7\t\t\"testing\"\n8\t)\n9\t\n10\t// modulePath is talaria's import path, so a package can be named to `go list`\n11\t// and matched in its output without repeating the prefix at each use.\n12\tconst modulePath = \"github.com/Teeeep/talaria\"\n13\t\n14\t// shared are the packages DESIGN.md §5 calls \"consumed by **both** the curl\n15\t// executor and the twin server\".\n16\tvar shared = []string{\n17\t\t\"internal/operation\",\n18\t\t\"internal/validate\",\n19\t\t\"internal/gen\",\n20\t}\n21\t\n22\t// forbidden are the packages a shared one may not reach. `curl` is the outbound\n23\t// executor and `twin` the inbound server, so a shared package that depended on\n24\t// either would be usable from only one side of the tool; `corpus` is listed\n25\t// with them because it backs both history and the recording proxy, and an\n26\t// operation model that reached into a store of past calls would carry the\n27\t// store's shape into the twin.\n28\t//\n29\t// internal/twin does not exist yet — the twin lands in Phase 6. It is named\n30\t// here anyway: the point of this test is that the rule holds when the package\n31\t// arrives, and a test that had to be extended on the day it mattered would not\n32\t// have held it.\n33\tvar forbidden = []string{\n34\t\t\"internal/curl\",\n35\t\t\"internal/corpus\",\n36\t\t\"internal/twin\",\n37\t}\n38\t\n39\t// TestSharedPackagesDoNotDependOnTheExecutorOrTheTwin asserts DESIGN.md §5's\n40\t// boundary rule against the real import graph rather than against prose.\n41\t//\n42\t// Every other test in the suite passes whether or not this invariant holds, so\n43\t// nothing else can catch its breach. The dependencies are read transitively,\n44\t// because an indirect edge violates the rule just as completely as a direct\n45\t// import and is far easier to add by accident.\n46\tfunc TestSharedPackagesDoNotDependOnTheExecutorOrTheTwin(t *testing.T) {\n47\t\tt.Parallel()\n48\t\n49\t\tfor _, pkg := range shared {\n50\t\t\tt.Run(pkg, func(t *testing.T) {\n51\t\t\t\tt.Parallel()\n52\t\n53\t\t\t\tdeps := dependenciesOf(t, pkg)\n54\t\n55\t\t\t\t// A `go list` that printed nothing, or that resolved some other\n56\t\t\t\t// package, would let every assertion below pass vacuously. Its own\n57\t\t\t\t// import path is in its own transitive closure, so finding it there\n58\t\t\t\t// proves the output is about the package under test.\n59\t\t\t\tif !contains(deps, modulePath+\"/\"+pkg) {\n60\t\t\t\t\tt.Fatalf(\"go list -deps %s does not include the package itself; \"+\n61\t\t\t\t\t\t\"the %d dependencies read are not this package's\", pkg, len(deps))\n62\t\t\t\t}\n63\t\n64\t\t\t\tfor _, banned := range forbidden {\n65\t\t\t\t\tif contains(deps, modulePath+\"/\"+banned) {\n66\t\t\t\t\t\tt.Errorf(\"%s depends on %s, which DESIGN.md §5 forbids: \"+\n67\t\t\t\t\t\t\t\"%s is shared with the twin server and may not reach the executor's side of the tool\",\n68\t\t\t\t\t\t\tpkg, banned, pkg)\n69\t\t\t\t\t}\n70\t\t\t\t}\n71\t\t\t})\n72\t\t}\n73\t}\n74\t\n75\t// dependenciesOf returns pkg's transitive dependencies as import paths.\n76\tfunc dependenciesOf(t *testing.T, pkg string) []string {\n77\t\tt.Helper()\n78\t\n79\t\tcmd := exec.Command(\"go\", \"list\", \"-deps\", modulePath+\"/\"+pkg)\n80\t\tcmd.Dir = filepath.Join(\"..\", \"..\")\n81\t\n82\t\tout, err := cmd.Output()\n83\t\tif err != nil {\n84\t\t\tt.Fatalf(\"listing the dependencies of %s: %v\", pkg, err)\n85\t\t}\n86\t\n87\t\tvar deps []string\n88\t\tfor _, line := range strings.Split(string(out), \"\\n\") {\n89\t\t\tif line = strings.TrimSpace(line); line != \"\" {\n90\t\t\t\tdeps = append(deps, line)\n91\t\t\t}\n92\t\t}\n93\t\n94\t\treturn deps\n95\t}\n96\t\n97\tfunc contains(haystack []string, needle string) bool {\n98\t\tfor _, s := range haystack {\n99\t\t\tif s == needle {\n100\t\t\t\treturn true\n101\t\t\t}\n102\t\t}\n103\t\n104\t\treturn false\n105\t}\n106\t"
      }
