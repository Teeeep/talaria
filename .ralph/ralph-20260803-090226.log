        "tool_use_id": "toolu_01EpPXNJ7GdzAURtnG74xwZL",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"github.com/spf13/cobra\"\n5\t\n6\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n7\t\t\"github.com/Teeeep/talaria/internal/operation\"\n8\t\t\"github.com/Teeeep/talaria/internal/output\"\n9\t)\n10\t\n11\t// searchView is the JSON payload. The query is echoed back so a transcript of\n12\t// several searches stays readable without the invocations next to it.\n13\ttype searchView struct {\n14\t\tQuery   string             `json:\"query\"`\n15\t\tResults []operation.Result `json:\"results\"`\n16\t}\n17\t\n18\tfunc newSearchCmd() *cobra.Command {\n19\t\tvar kind string\n20\t\n21\t\tcmd := &cobra.Command{\n22\t\t\tUse:   \"search [spec] <query>\",\n23\t\t\tShort: \"Find operations, schemas and parameters by substring\",\n24\t\t\tLong: \"Search a spec for a term across operation ids, paths, summaries and\\n\" +\n25\t\t\t\t\"descriptions, component schema names and parameter names. Matching is\\n\" +\n26\t\t\t\t\"case-insensitive, and results are ranked with name matches first.\\n\\n\" +\n27\t\t\t\t\"A term that matches nothing is not an error: an empty result set is the\\n\" +\n28\t\t\t\t\"answer that this API has no such concept.\",\n29\t\t\tArgs: usageArgs(cobra.RangeArgs(1, 2)),\n30\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n31\t\t\t\tformat, err := resolveFormat(cmd)\n32\t\t\t\tif err != nil {\n33\t\t\t\t\treturn err\n34\t\t\t\t}\n35\t\n36\t\t\t\t// Validated before the spec is loaded: a bad --kind is a bad\n37\t\t\t\t// invocation whatever the spec turns out to contain.\n38\t\t\t\tsearchKind, err := operation.ParseKind(kind)\n39\t\t\t\tif err != nil {\n40\t\t\t\t\treturn clierr.Usage(\"%w\", err).WithAlternatives(operation.Kinds()...)\n41\t\t\t\t}\n42\t\n43\t\t\t\t// The query is always last: with one argument the spec comes from\n44\t\t\t\t// --spec or the environment, with two it is the first.\n45\t\t\t\tquery := args[len(args)-1]\n46\t\n47\t\t\t\tindex, err := loadIndex(cmd, args[:len(args)-1])\n48\t\t\t\tif err != nil {\n49\t\t\t\t\treturn err\n50\t\t\t\t}\n51\t\n52\t\t\t\treturn output.New(format, cmd.OutOrStdout()).\n53\t\t\t\t\tRender(searchPayload(query, index.Search(query, searchKind)))\n54\t\t\t},\n55\t\t}\n56\t\n57\t\tcmd.Flags().StringVar(&kind, \"kind\", \"\",\n58\t\t\t\"restrict results to one kind: operation|schema|param (default: all three)\")\n59\t\n60\t\treturn cmd\n61\t}\n62\t\n63\tfunc searchPayload(query string, results []operation.Result) output.Payload {\n64\t\trows := make([][]string, 0, len(results))\n65\t\tfor _, r := range results {\n66\t\t\trows = append(rows, []string{string(r.Kind), r.Name, r.Where, r.Summary})\n67\t\t}\n68\t\n69\t\treturn output.Payload{\n70\t\t\tData:  searchView{Query: query, Results: results},\n71\t\t\tTable: output.Table{Rows: rows},\n72\t\t}\n73\t}\n74\t"
      }
