        "tool_use_id": "toolu_01XyZK4LUTv1heRZhFHjbX5v",
        "type": "tool_result",
        "content": "1\t// Package operation is the core model of the tool: one flat, spec-shaped\n2\t// description of every callable endpoint, built once from a *spec.Document and\n3\t// then read by everything downstream — list, describe, search, the request\n4\t// builder, the curl executor and response validation.\n5\t//\n6\t// The model deliberately stops at the schema boundary. Parameters, request\n7\t// bodies and responses carry the libopenapi schema proxy rather than a\n8\t// flattened copy, because describe and the data generator need the real schema\n9\t// — including its resolved $refs — and re-deriving it later would mean every\n10\t// consumer reaching back into the parser.\n11\tpackage operation\n12\t\n13\timport (\n14\t\t\"github.com/pb33f/libopenapi/datamodel/high/base\"\n15\t)\n16\t\n17\t// StatusDefault is the status key OpenAPI uses for the fallback response — the\n18\t// one that applies when no explicit code matches.\n19\tconst StatusDefault = \"default\"\n20\t\n21\t// Operation is one method/path pair from a spec.\n22\ttype Operation struct {\n23\t\t// ID is the spec's operationId. It can be empty: not every spec sets one,\n24\t\t// and synthesising a stable ID is a separate concern.\n25\t\tID string\n26\t\t// Method is the HTTP method, upper-cased.\n27\t\tMethod string\n28\t\t// Path is the templated path as written in the spec, e.g. /pets/{petId}.\n29\t\tPath        string\n30\t\tSummary     string\n31\t\tDescription string\n32\t\tTags        []string\n33\t\tDeprecated  bool\n34\t\t// Params are the path-item and operation parameters merged into one list,\n35\t\t// with operation-level entries winning on a (name, in) collision.\n36\t\tParams []Param\n37\t\t// RequestBody is nil for operations that take no body.\n38\t\tRequestBody *RequestBody\n39\t\t// Responses are the declared response contracts, ordered by status with\n40\t\t// StatusDefault last.\n41\t\tResponses []Response\n42\t\t// Security is the effective requirement list: the operation's own block if\n43\t\t// it has one, otherwise the document-level block. Empty means no auth,\n44\t\t// which is also what an explicit `security: []` resolves to. Any one\n45\t\t// requirement in the list is enough to authenticate the call.\n46\t\tSecurity []SecurityRequirement\n47\t}\n48\t\n49\t// Param is a single input to an operation.\n50\ttype Param struct {\n51\t\tName string\n52\t\t// In is the location: path, query, header or cookie.\n53\t\tIn          string\n54\t\tRequired    bool\n55\t\tDescription string\n56\t\t// Schema is the parameter's schema, still as a proxy so callers can render\n57\t\t// or generate from the real thing. It can be nil for a content-typed\n58\t\t// parameter, which is rare and not yet supported.\n59\t\tSchema *base.SchemaProxy\n60\t}\n61\t\n62\t// RequestBody is the body contract of an operation.\n63\ttype RequestBody struct {\n64\t\tRequired    bool\n65\t\tDescription string\n66\t\t// Content lists the accepted media types in spec order.\n67\t\tContent []MediaType\n68\t}\n69\t\n70\t// Response is one declared outcome of an operation.\n71\ttype Response struct {\n72\t\t// Status is the status code as written in the spec — \"200\", \"4XX\", or\n73\t\t// StatusDefault.\n74\t\tStatus      string\n75\t\tDescription string\n76\t\t// Content lists the response media types in spec order. It is empty for a\n77\t\t// response with no body, such as a 204.\n78\t\tContent []MediaType\n79\t}\n80\t\n81\t// MediaType pairs a content type with the schema that applies to it.\n82\ttype MediaType struct {\n83\t\tContentType string\n84\t\tSchema      *base.SchemaProxy\n85\t}\n86\t\n87\t// SecurityRequirement is one alternative way to authenticate an operation.\n88\t// Every scheme it names has to be satisfied together; a requirement with no\n89\t// schemes means authentication is optional.\n90\ttype SecurityRequirement struct {\n91\t\tSchemes []SecurityScheme\n92\t}\n93\t\n94\t// SecurityScheme names one scheme from components.securitySchemes, along with\n95\t// the scopes this operation needs from it.\n96\ttype SecurityScheme struct {\n97\t\tName   string\n98\t\tScopes []string\n99\t}\n100\t\n101\t// safeMethods are the HTTP methods DESIGN.md §4 treats as read-only. Anything\n102\t// outside this set needs --allow-mutations, so the check is a deny-list by\n103\t// design: an unfamiliar method is assumed to change state.\n104\tvar safeMethods = map[string]bool{\n105\t\t\"GET\":     true,\n106\t\t\"HEAD\":    true,\n107\t\t\"OPTIONS\": true,\n108\t}\n109\t\n110\t// IsMutation reports whether calling this operation may change server state,\n111\t// and so whether it falls under the --allow-mutations gate.\n112\tfunc (o Operation) IsMutation() bool {\n113\t\treturn !safeMethods[o.Method]\n114\t}\n115\t\n116\t// ResponseFor returns the declared response for a status key, or nil if the\n117\t// operation does not declare one. Pass StatusDefault for the fallback; the\n118\t// caller decides whether to fall back, because a status with no contract is\n119\t// meaningful to validation.\n120\tfunc (o Operation) ResponseFor(status string) *Response {\n121\t\tfor i := range o.Responses {\n122\t\t\tif o.Responses[i].Status == status {\n123\t\t\t\treturn &o.Responses[i]\n124\t\t\t}\n125\t\t}\n126\t\n127\t\treturn nil\n128\t}\n129\t"
