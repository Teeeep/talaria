        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"context\"\n5\t\t\"fmt\"\n6\t\t\"io\"\n7\t\t\"net/http\"\n8\t\t\"sort\"\n9\t\t\"strings\"\n10\t\n11\t\t\"github.com/spf13/cobra\"\n12\t\n13\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n14\t\t\"github.com/Teeeep/talaria/internal/config\"\n15\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n16\t\t\"github.com/Teeeep/talaria/internal/curl\"\n17\t\t\"github.com/Teeeep/talaria/internal/gen\"\n18\t\t\"github.com/Teeeep/talaria/internal/operation\"\n19\t\t\"github.com/Teeeep/talaria/internal/output\"\n20\t\t\"github.com/Teeeep/talaria/internal/request\"\n21\t\t\"github.com/Teeeep/talaria/internal/secret\"\n22\t\t\"github.com/Teeeep/talaria/internal/spec\"\n23\t\t\"github.com/Teeeep/talaria/internal/validate\"\n24\t)\n25\t\n26\t// runSeed is what the data generator draws from. It is a constant rather than a\n27\t// flag because a smoke test whose request bodies change between runs fails once,\n28\t// passes next time and teaches nobody anything (DESIGN.md §5a).\n29\tconst runSeed = 1\n30\t\n31\t// contentTypeHeader is the header a generated body's media type travels in.\n32\tconst contentTypeHeader = \"Content-Type\"\n33\t\n34\t// The three outcomes one operation can have. Skipped is deliberately not a\n35\t// failure: a DELETE left alone without --allow-mutations, or an operation whose\n36\t// path parameter nothing could supply, is correct behaviour rather than a\n37\t// broken API.\n38\tconst (\n39\t\toutcomePassed  = \"passed\"\n40\t\toutcomeFailed  = \"failed\"\n41\t\toutcomeSkipped = \"skipped\"\n42\t)\n43\t\n44\t// runResult is one operation's line in the report.\n45\ttype runResult struct {\n46\t\tOperationID string `json:\"operation_id\"`\n47\t\tMethod      string `json:\"method\"`\n48\t\tPath        string `json:\"path\"`\n49\t\tOutcome     string `json:\"outcome\"`\n50\t\t// Reason says why a skip or a failure happened. A passing operation has\n51\t\t// none: there is nothing to explain.\n52\t\tReason string `json:\"reason,omitempty\"`\n53\t\t// Status and TimingMS are absent for an operation that was never executed.\n54\t\t// TimingMS is a pointer so a call to a local server that legitimately\n55\t\t// rounded to 0ms is still reported as timed.\n56\t\tStatus     int              `json:\"status,omitempty\"`\n57\t\tTimingMS   *int64           `json:\"timing_ms,omitempty\"`\n58\t\tValidation *validate.Result `json:\"validation,omitempty\"`\n59\t}\n60\t\n61\t// runSummary is the count an agent, or a CI job, reads first.\n62\ttype runSummary struct {\n63\t\tTotal   int `json:\"total\"`\n64\t\tPassed  int `json:\"passed\"`\n65\t\tFailed  int `json:\"failed\"`\n66\t\tSkipped int `json:\"skipped\"`\n67\t}\n68\t\n69\t// runView is the whole report.\n70\ttype runView struct {\n71\t\tResults []runResult `json:\"results\"`\n72\t\tSummary runSummary  `json:\"summary\"`\n73\t}\n74\t\n75\tfunc newRunCmd() *cobra.Command {\n76\t\tvar (\n77\t\t\ttags           []string\n78\t\t\tids            []string\n79\t\t\tfixturesDir    string\n80\t\t\treport         string\n81\t\t\tallowMutations bool\n82\t\t\tfailOnError    bool\n83\t\t\ttimeout        float64\n84\t\t)\n85\t\n86\t\t// One warner for the whole command, as on `call`: a run that puts a\n87\t\t// credential in the query string makes the point once, not once per\n88\t\t// operation.\n89\t\twarner := secret.NewQueryKeyWarner()\n90\t\n91\t\tcmd := &cobra.Command{\n92\t\t\tUse:   \"run [spec]\",\n93\t\t\tShort: \"Smoke-test a spec's operations and report what each one did\",\n94\t\t\tLong: \"Call every operation the filters select, check each response against the\\n\" +\n95\t\t\t\t\"spec, and report one line per operation. Mutating operations are skipped\\n\" +\n96\t\t\t\t\"unless --allow-mutations is given. Request data comes from the spec's own\\n\" +\n97\t\t\t\t\"examples first, then --fixtures, then generation.\",\n98\t\t\tArgs: usageArgs(cobra.MaximumNArgs(1)),\n99\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n100\t\t\t\tformat, err := resolveReportFormat(cmd, report)\n101\t\t\t\tif err != nil {\n102\t\t\t\t\treturn err\n103\t\t\t\t}\n104\t\n105\t\t\t\tdoc, index, err := loadSpec(cmd, args)\n106\t\t\t\tif err != nil {\n107\t\t\t\t\treturn err\n108\t\t\t\t}\n109\t\n110\t\t\t\tops, err := selectOperations(index, tags, ids)\n111\t\t\t\tif err != nil {\n112\t\t\t\t\treturn err\n113\t\t\t\t}\n114\t\n115\t\t\t\trunner, err := newRunner(cmd, doc, fixturesDir, allowMutations, timeoutOptions(timeout), warner)\n116\t\t\t\tif err != nil {\n117\t\t\t\t\treturn err\n118\t\t\t\t}\n119\t\n120\t\t\t\t// Sequential, in spec order. Determinism beats speed here, and\n121\t\t\t\t// parallel calls against a real API are a surprise nobody asked for.\n122\t\t\t\tresults := make([]runResult, 0, len(ops))\n123\t\t\t\tfor _, op := range ops {\n124\t\t\t\t\tresults = append(results, runner.execute(op))\n125\t\t\t\t}\n126\t\n127\t\t\t\tview := runView{Results: results, Summary: summarise(results)}\n128\t\n129\t\t\t\t// Rendered before the exit code is decided, for the reason `call`\n130\t\t\t\t// renders first: the flags change what the process exits with, not\n131\t\t\t\t// what the caller gets to read.\n132\t\t\t\tif err := output.New(format, cmd.OutOrStdout()).Render(runPayload(view)); err != nil {\n133\t\t\t\t\treturn err\n134\t\t\t\t}\n135\t\n136\t\t\t\treturn runner.verdict(view, failOnError)\n137\t\t\t},\n138\t\t}\n139\t\n140\t\t// All local to run: no other command enumerates operations, reports on a\n141\t\t// suite, or has test data to supply.\n142\t\tcmd.Flags().StringArrayVar(&tags, \"tag\", nil,\n143\t\t\t\"only operations carrying this tag (repeatable)\")\n144\t\tcmd.Flags().StringArrayVar(&ids, \"operation\", nil,\n145\t\t\t\"only this operationId (repeatable); combined with --tag as a union\")\n146\t\tcmd.Flags().StringVar(&fixturesDir, \"fixtures\", \"\",\n147\t\t\t\"directory of <operationId>.json test data, consulted after spec examples\")\n148\t\tcmd.Flags().StringVar(&report, \"report\", \"\",\n149\t\t\t\"report format: json|pretty|tsv|junit (overrides --output)\")\n150\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n151\t\t\t\"include operations whose method is not GET, HEAD or OPTIONS\")\n152\t\tcmd.Flags().BoolVar(&failOnError, \"fail-on-error\", false,\n153\t\t\t\"exit 4 if any operation failed\")\n154\t\t// Per operation, not per suite: the bound that matters is the one that keeps\n155\t\t// a single wedged endpoint from costing the report.\n156\t\tcmd.Flags().Float64Var(&timeout, \"timeout\", curl.DefaultMaxTime.Seconds(),\n157\t\t\t\"give up on each operation's request after this many seconds\")\n158\t\n159\t\treturn cmd\n160\t}\n161\t\n162\t// resolveReportFormat picks the format the report is written in. --report is\n163\t// run's own flag and wins over the persistent --output: an agent that set\n164\t// --output globally and then asked run for JSON must get JSON, not a format it\n165\t// asked for two flags ago.\n166\t//\n167\t// It also accepts junit, which --output does not: a suite of operations is the\n168\t// only thing there is to render as a test report, and `run` is the only command\n169\t// that produces one.\n170\tfunc resolveReportFormat(cmd *cobra.Command, report string) (output.Format, error) {\n171\t\tif report == \"\" {\n172\t\t\treturn resolveFormat(cmd)\n173\t\t}\n174\t\n175\t\tformat, err := output.ParseReportFormat(report)\n176\t\tif err != nil {\n177\t\t\treturn \"\", clierr.Usage(\"%w\", err).WithAlternatives(output.ReportFormats()...)\n178\t\t}\n179\t\n180\t\treturn format, nil\n181\t}\n182\t\n183\t// selectOperations applies --tag and --operation as a union, in spec order. No\n184\t// filters at all means the whole spec.\n185\t//\n186\t// A filter that selects nothing is a usage error rather than an empty pass: a\n187\t// mistyped tag that exits 0 with nothing tested is a green CI run that proves\n188\t// nothing, which is the one result a smoke test must never produce.\n189\tfunc selectOperations(index *operation.Index, tags, ids []string) ([]operation.Operation, error) {\n190\t\tif len(tags) == 0 && len(ids) == 0 {\n191\t\t\treturn index.Operations(), nil\n192\t\t}\n193\t\n194\t\tkeep := map[string]bool{}\n195\t\tfor _, tag := range tags {\n196\t\t\tfor _, op := range index.ByTag(tag) {\n197\t\t\t\tkeep[operationKey(op)] = true\n198\t\t\t}\n199\t\t}\n200\t\t// Looked up rather than matched, so a misspelt id gets Lookup's suggestions\n201\t\t// instead of silently selecting nothing.\n202\t\tfor _, id := range ids {\n203\t\t\top, err := index.Lookup(id)\n204\t\t\tif err != nil {\n205\t\t\t\treturn nil, err\n206\t\t\t}\n207\t\t\tkeep[operationKey(op)] = true\n208\t\t}\n209\t\n210\t\tvar ops []operation.Operation\n211\t\tfor _, op := range index.Operations() {\n212\t\t\tif keep[operationKey(op)] {\n213\t\t\t\tops = append(ops, op)\n214\t\t\t}\n215\t\t}\n216\t\tif len(ops) == 0 {\n217\t\t\treturn nil, clierr.Usage(\"no operation matches %s\",\n218\t\t\t\tstrings.Join(append(quoted(\"--tag\", tags), quoted(\"--operation\", ids)...), \" or \"))\n219\t\t}\n220\t\n221\t\treturn ops, nil\n222\t}\n223\t\n224\t// operationKey identifies an operation independently of its id, so the two\n225\t// filters can be unioned even for operations the spec never named.\n226\tfunc operationKey(op operation.Operation) string { return op.Method + \" \" + op.Path }\n227\t\n228\t// quoted renders one filter's values for an error message.\n229\tfunc quoted(flag string, values []string) []string {\n230\t\tout := make([]string, 0, len(values))\n231\t\tfor _, value := range values {\n232\t\t\tout = append(out, fmt.Sprintf(\"%s %q\", flag, value))\n233\t\t}\n234\t\n235\t\treturn out\n236\t}\n237\t\n238\t// runner holds everything one suite reuses across operations: the compiled\n239\t// validator, the seeded generator, the history store and the redactors. Built\n240\t// once so the per-operation loop only makes requests.\n241\ttype runner struct {\n242\t\t// ctx is the suite's cancellation source, carried here because a run is a\n243\t\t// loop of requests and a Ctrl-C partway through has to stop the one in\n244\t\t// flight, not just the ones not yet made.\n245\t\tctx       context.Context\n246\t\tdoc       *spec.Document\n247\t\tprofile   *config.Profile\n248\t\tbaseURL   string\n249\t\tgen       *gen.Generator\n250\t\tvalidator *validate.Validator\n251\t\tstore     *corpus.Store\n252\t\tredactors corpus.Redactors\n253\t\twarner    *secret.QueryKeyWarner\n254\t\topts      curl.Options\n255\t\tstderr    io.Writer\n256\t\n257\t\tallowMutations bool\n258\t\t// missing collects the security schemes that stopped an operation from\n259\t\t// running, in the display form the exit-5 error reports.\n260\t\tmissing []string\n261\t}\n262\t\n263\tfunc newRunner(\n264\t\tcmd *cobra.Command,\n265\t\tdoc *spec.Document,\n266\t\tfixturesDir string,\n267\t\tallowMutations bool,\n268\t\topts curl.Options,\n269\t\twarner *secret.QueryKeyWarner,\n270\t) (*runner, error) {\n271\t\t// The whole fixtures directory is read up front, before any request goes\n272\t\t// out: a typo in a fixture should not surface halfway through a suite.\n273\t\tfixtures, err := gen.LoadFixtures(fixturesDir)\n274\t\tif err != nil {\n275\t\t\treturn nil, err\n276\t\t}\n277\t\n278\t\tcfg, err := config.Load(\"\")\n279\t\tif err != nil {\n280\t\t\treturn nil, err\n281\t\t}\n282\t\n283\t\tprofile, err := selectProfile(cmd, cfg)\n284\t\tif err != nil {\n285\t\t\treturn nil, err\n286\t\t}\n287\t\n288\t\tstore, err := openHistory(cmd, cfg)\n289\t\tif err != nil {\n290\t\t\treturn nil, err\n291\t\t}\n292\t\n293\t\tbaseURL, err := cmd.Flags().GetString(\"base-url\")\n294\t\tif err != nil {\n295\t\t\treturn nil, clierr.Usage(\"%w\", err)\n296\t\t}\n297\t\n298\t\tgenerator := gen.New(runSeed)\n299\t\tgenerator.Fixtures = fixtures\n300\t\n301\t\treturn &runner{\n302\t\t\tctx:            cmd.Context(),\n303\t\t\tdoc:            doc,\n304\t\t\tprofile:        profile,\n305\t\t\tbaseURL:        baseURL,\n306\t\t\tgen:            generator,\n307\t\t\tvalidator:      validate.New(doc),\n308\t\t\tstore:          store,\n309\t\t\tredactors:      newRedactors(cfg),\n310\t\t\twarner:         warner,\n311\t\t\topts:           opts,\n312\t\t\tstderr:         cmd.ErrOrStderr(),\n313\t\t\tallowMutations: allowMutations,\n314\t\t}, nil\n315\t}\n316\t\n317\t// execute runs one operation and reports what happened. It never returns an\n318\t// error: one operation's problem is a line in the report, not the end of the\n319\t// suite, and the exit code is decided once at the end from the whole of it.\n320\tfunc (r *runner) execute(op operation.Operation) runResult {\n321\t\tres := runResult{\n322\t\t\tOperationID: operationName(op),\n323\t\t\tMethod:      op.Method,\n324\t\t\tPath:        op.Path,\n325\t\t}\n326\t\n327\t\tif op.IsMutation() && !r.allowMutations {\n328\t\t\treturn res.skip(\"a %s request may change server state: pass --allow-mutations to include it\",\n329\t\t\t\top.Method)\n330\t\t}\n331\t\n332\t\tcreds, err := config.Resolve(op, r.doc, r.profile)\n333\t\tif err != nil {\n334\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n335\t\t}\n336\t\t// Checked before the request is built rather than left to fail at exec\n337\t\t// time, so an agent gets the variable to export and the server gets no\n338\t\t// request it was always going to reject.\n339\t\tif missing := missingCredentials(creds); len(missing) > 0 {\n340\t\t\tr.noteMissing(missing)\n341\t\n342\t\t\treturn res.skip(\"no credential for security %s\",\n343\t\t\t\tpluralise(len(missing), \"scheme\")+\" \"+strings.Join(missing, \", \"))\n344\t\t}\n345\t\n346\t\tdata := r.gen.DataFor(op)\n347\t\treq, err := request.Build(request.Inputs{\n348\t\t\tOp:      op,\n349\t\t\tDoc:     r.doc,\n350\t\t\tProfile: r.profile,\n351\t\t\tCreds:   creds,\n352\t\t\tBaseURL: r.baseURL,\n353\t\t\tParams:  flagPairs(data.Params),\n354\t\t\tHeaders: flagPairs(headersFor(data)),\n355\t\t\tBody:    bodyFlag(data.Body),\n356\t\t\t// Already built from this run's config, and shared with the entry that\n357\t\t\t// goes to history so the two surfaces cannot disagree.\n358\t\t\tRedactor: r.redactors.Request,\n359\t\t\t// No stdin: `run` makes many requests and stdin can only be read once,\n360\t\t\t// so there is nothing here for `--body -` to mean.\n361\t\t})\n362\t\tif err != nil {\n363\t\t\t// A request that cannot be built is data talaria could not supply, not\n364\t\t\t// an API that misbehaved, so it is a skip carrying the builder's own\n365\t\t\t// message — which names the parameter.\n366\t\t\treturn res.skip(\"%s\", clierr.From(err).Message)\n367\t\t}\n368\t\n369\t\twarnQueryCredentials(r.stderr, r.warner, req)\n370\t\n371\t\tresp, execErr := curl.ExecuteWith(r.ctx, req, r.opts)\n372\t\t// Recorded either way, as `call` records: a request that never completed is\n373\t\t// still something that was tried.\n374\t\trecordCall(r.stderr, r.store, corpus.SourceRun, req, resp, r.redactors)\n375\t\tif execErr != nil {\n376\t\t\treturn res.fail(\"%s\", clierr.From(execErr).Message)\n377\t\t}\n378\t\n379\t\tview := redactResponse(resp, r.redactors.Response)\n380\t\ttiming := view.TimingMS\n381\t\tres.Status, res.TimingMS = view.Status, &timing\n382\t\tres.Validation = validateWith(r.stderr, r.validator, req, view)\n383\t\n384\t\treturn res.judge()\n385\t}\n386\t\n387\t// noteMissing records the credentials blocking an operation, without repeating\n388\t// one that already blocked another.\n389\tfunc (r *runner) noteMissing(missing []string) {\n390\t\tfor _, name := range missing {\n391\t\t\tif !slicesContains(r.missing, name) {\n392\t\t\t\tr.missing = append(r.missing, name)\n393\t\t\t}\n394\t\t}\n395\t}\n396\t\n397\t// verdict turns the finished report into an exit code.\n398\t//\n399\t// A missing credential exits 5 whether or not --fail-on-error was given, as\n400\t// `auth check` does: it means the suite did not test the operation at all,\n401\t// which is a different thing from an API that answered badly, and an agent\n402\t// acts on it by exporting a variable rather than by reading the report.\n403\tfunc (r *runner) verdict(view runView, failOnError bool) error {\n404\t\tif len(r.missing) > 0 {\n405\t\t\treturn clierr.CredentialMissing(\"no credential for security %s %s\",\n406\t\t\t\tpluralise(len(r.missing), \"scheme\"), strings.Join(r.missing, \", \"))\n407\t\t}\n408\t\tif failOnError && view.Summary.Failed > 0 {\n409\t\t\treturn clierr.Validation(\"%s failed\", pluralise(view.Summary.Failed, \"operation\"))\n410\t\t}\n411\t\n412\t\treturn nil\n413\t}\n414\t\n415\t// skip marks an operation as not run, and why.\n416\tfunc (res runResult) skip(format string, a ...any) runResult {\n417\t\tres.Outcome, res.Reason = outcomeSkipped, fmt.Sprintf(format, a...)\n418\t\n419\t\treturn res\n420\t}\n421\t\n422\t// fail marks an operation as run and wrong, and why.\n423\tfunc (res runResult) fail(format string, a ...any) runResult {\n424\t\tres.Outcome, res.Reason = outcomeFailed, fmt.Sprintf(format, a...)\n425\t\n426\t\treturn res\n427\t}\n428\t\n429\t// judge decides the outcome of an operation that reached the server. The HTTP\n430\t// status is reported first when both apply, for `call --fail-on-error`'s\n431\t// reason: a 500 whose body does not match the error schema is a server that is\n432\t// down, not a server with a documentation problem.\n433\tfunc (res runResult) judge() runResult {\n434\t\tswitch {\n435\t\tcase res.Status >= http.StatusBadRequest:\n436\t\t\treturn res.fail(\"the server returned %s\", statusText(res.Status))\n437\t\tcase res.Validation != nil && len(res.Validation.Errors) > 0:\n438\t\t\treturn res.fail(\"the response violates the spec: %s\",\n439\t\t\t\tpluralise(len(res.Validation.Errors), \"validation error\"))\n440\t\tdefault:\n441\t\t\tres.Outcome = outcomePassed\n442\t\n443\t\t\treturn res\n444\t\t}\n445\t}\n446\t\n447\t// missingCredentials names the credentials an operation needs and does not\n448\t// have, in the form `scheme (set $VAR)` — the same phrasing `auth check` uses,\n449\t// because it answers the same question.\n450\tfunc missingCredentials(creds []config.Credential) []string {\n451\t\tvar missing []string\n452\t\tfor _, cred := range creds {\n453\t\t\tif !cred.Present() {\n454\t\t\t\tmissing = append(missing, cred.Scheme+\" (set \"+cred.Ref.Symbolic()+\")\")\n455\t\t\t}\n456\t\t}\n457\t\n458\t\treturn missing\n459\t}\n460\t\n461\t// flagPairs renders generated data as the `name=value` strings request.Build\n462\t// parses, sorted so two runs of the same spec build byte-identical requests.\n463\tfunc flagPairs(values map[string]string) []string {\n464\t\tout := make([]string, 0, len(values))\n465\t\tfor name, value := range values {\n466\t\t\tout = append(out, name+\"=\"+value)\n467\t\t}\n468\t\tsort.Strings(out)\n469\t\n470\t\treturn out\n471\t}\n472\t\n473\t// headersFor is the headers one request sends: the fixture's, plus the media\n474\t// type the body was generated as.\n475\t//\n476\t// Without that header the request builder falls back to the operation's first\n477\t// declared media type, which is not necessarily the one the body was generated\n478\t// from — a spec listing application/xml before application/json, or a converted\n479\t// Swagger 2.0 formData operation, then sends JSON bytes under a media type it\n480\t// is not. A fixture header wins, as a user-set --header wins in `call`.\n481\tfunc headersFor(data gen.Data) map[string]string {\n482\t\theaders := make(map[string]string, len(data.Headers)+1)\n483\t\tfor name, value := range data.Headers {\n484\t\t\theaders[name] = value\n485\t\t}\n486\t\n487\t\tif len(data.Body) == 0 || data.ContentType == \"\" {\n488\t\t\treturn headers\n489\t\t}\n490\t\n491\t\tfor name := range headers {\n492\t\t\tif strings.EqualFold(name, contentTypeHeader) {\n493\t\t\t\treturn headers\n494\t\t\t}\n495\t\t}\n496\t\theaders[contentTypeHeader] = data.ContentType\n497\t\n498\t\treturn headers\n499\t}\n500\t\n501\t// bodyFlag renders a generated body as the --body value it stands in for, so\n502\t// the media type travels with it in headersFor rather than being re-derived\n503\t// from the spec. Generated and fixture bodies are always JSON, so neither can\n504\t// collide with --body's `@file` and `-` spellings.\n505\tfunc bodyFlag(body []byte) []string {\n506\t\tif len(body) == 0 {\n507\t\t\treturn nil\n508\t\t}\n509\t\n510\t\treturn []string{string(body)}\n511\t}\n512\t\n513\t// summarise counts the outcomes.\n514\tfunc summarise(results []runResult) runSummary {\n515\t\tsummary := runSummary{Total: len(results)}\n516\t\tfor _, res := range results {\n517\t\t\tswitch res.Outcome {\n518\t\t\tcase outcomePassed:\n519\t\t\t\tsummary.Passed++\n520\t\t\tcase outcomeFailed:\n521\t\t\t\tsummary.Failed++\n522\t\t\tdefault:\n523\t\t\t\tsummary.Skipped++\n524\t\t\t}\n525\t\t}\n526\t\n527\t\treturn summary\n528\t}\n529\t\n530\t// runPayload builds the JSON view and the table from the same results.\n531\t//\n532\t// The table is one row per operation and then the summary, which is the shape a\n533\t// human reads top to bottom and a `grep -c failed` reads too. The last row is a\n534\t// single cell, so tabwriter leaves it unpadded rather than aligning a sentence\n535\t// into the status column.\n536\tfunc runPayload(view runView) output.Payload {\n537\t\trows := make([][]string, 0, len(view.Results)+1)\n538\t\tfor _, res := range view.Results {\n539\t\t\trows = append(rows, []string{\n540\t\t\t\tres.Outcome,\n541\t\t\t\tres.Method,\n542\t\t\t\tres.Path,\n543\t\t\t\tres.OperationID,\n544\t\t\t\tstatusCell(res.Status),\n545\t\t\t\tres.Reason,\n546\t\t\t})\n547\t\t}\n548\t\trows = append(rows, []string{summaryLine(view.Summary)})\n549\t\n550\t\treturn output.Payload{\n551\t\t\tData:  view,\n552\t\t\tTable: output.Table{Rows: rows},\n553\t\t\tJUnit: junitSuite(view),\n554\t\t}\n555\t}\n556\t\n557\t// junitSuite is the same results as a test suite, for `--report junit`.\n558\t//\n559\t// A skip stays a skip rather than becoming a failure: a DELETE left alone\n560\t// without --allow-mutations is correct behaviour, and a CI job that went red\n561\t// over it would be turned off within a week.\n562\tfunc junitSuite(view runView) output.Suite {\n563\t\tcases := make([]output.Case, 0, len(view.Results))\n564\t\tfor _, res := range view.Results {\n565\t\t\tc := output.Case{Name: res.OperationID, Seconds: res.seconds()}\n566\t\t\tswitch res.Outcome {\n567\t\t\tcase outcomeFailed:\n568\t\t\t\tc.Failure = res.Reason\n569\t\t\tcase outcomeSkipped:\n570\t\t\t\tc.Skipped = res.Reason\n571\t\t\t}\n572\t\n573\t\t\tcases = append(cases, c)\n574\t\t}\n575\t\n576\t\treturn output.Suite{Name: \"talaria run\", Cases: cases}\n577\t}\n578\t\n579\t// seconds is the operation's timing in the unit JUnit's time attribute is\n580\t// defined in. An operation that never reached a server took no measured time\n581\t// rather than an unknown one: it is reported as 0, with the <skipped> child\n582\t// saying why.\n583\tfunc (res runResult) seconds() float64 {\n584\t\tif res.TimingMS == nil {\n585\t\t\treturn 0\n586\t\t}\n587\t\n588\t\treturn float64(*res.TimingMS) / 1000\n589\t}\n590\t\n591\t// summaryLine is the one line a human is looking for.\n592\tfunc summaryLine(s runSummary) string {\n593\t\treturn fmt.Sprintf(\"%s: %d passed, %d failed, %d skipped\",\n594\t\t\tpluralise(s.Total, \"operation\"), s.Passed, s.Failed, s.Skipped)\n595\t}\n596\t\n597\t// slicesContains reports whether values already holds value.\n598\tfunc slicesContains(values []string, value string) bool {\n599\t\tfor _, v := range values {\n600\t\t\tif v == value {\n601\t\t\t\treturn true\n602\t\t\t}\n603\t\t}\n604\t\n605\t\treturn false\n606\t}\n607\t"
      }
