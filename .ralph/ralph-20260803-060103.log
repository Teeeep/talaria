        "content": "85\t\tview := listView{Operations: make([]listEntry, 0, len(ops))}\n86\t\trows := make([][]string, 0, len(ops))\n87\t\n88\t\tfor _, op := range ops {\n89\t\t\ttags := op.Tags\n90\t\t\tif tags == nil {\n91\t\t\t\t// An untagged operation renders \"tags\": [], not null: agents parse\n92\t\t\t\t// this, and a field that changes type between specs is a trap.\n93\t\t\t\ttags = []string{}\n94\t\t\t}\n95\t\t\tview.Operations = append(view.Operations, listEntry{\n96\t\t\t\tID:      op.ID,\n97\t\t\t\tMethod:  op.Method,\n98\t\t\t\tPath:    op.Path,\n99\t\t\t\tTags:    tags,\n100\t\t\t\tSummary: op.Summary,\n101\t\t\t})\n102\t\n103\t\t\trows = append(rows, []string{op.Method, op.Path, op.ID, op.Summary})\n104\t\t}\n105\t\n106\t\tif format == output.FormatPretty {\n107\t\t\tfitSummaries(rows)\n108\t\t}\n109\t\n110\t\t// No headers: §3.2 asks for one compact line per operation, and a header\n111\t\t// line is one more thing every consumer has to skip. `--output json` is\n112\t\t// where the fields are labelled.\n113\t\treturn output.Payload{\n114\t\t\tData:  view,\n115\t\t\tTable: output.Table{Rows: rows},\n116\t\t}\n117\t}\n118\t\n119\t// fitSummaries truncates the summary column in place so no rendered line\n120\t// exceeds maxPrettyWidth. The budget is what is left after the three columns\n121\t// that cannot be shortened, measured at the width tabwriter will pad them to —\n122\t// the widest cell in each — because that padding is what a row-local\n123\t// measurement would miss.\n124\tfunc fitSummaries(rows [][]string) {\n125\t\tconst padding = 2 // tabwriter is constructed with two spaces between columns.\n126\t\n127\t\tfixed := 0\n128\t\tfor col := 0; col < summaryColumn; col++ {\n129\t\t\twidth := 0\n130\t\t\tfor _, row := range rows {\n131\t\t\t\twidth = max(width, len([]rune(row[col])))\n132\t\t\t}\n133\t\t\tfixed += width + padding\n134\t\t}\n135\t\n136\t\tbudget := maxPrettyWidth - fixed\n137\t\tfor _, row := range rows {\n138\t\t\tif budget < minSummaryWidth {\n139\t\t\t\trow[summaryColumn] = \"\"\n140\t\n141\t\t\t\tcontinue\n142\t\t\t}\n143\t\t\trow[summaryColumn] = truncate(row[summaryColumn], budget)\n144\t\t}"
