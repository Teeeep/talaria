        "tool_use_id": "toolu_019KSpXUjWvQjRY5tPKRoTYR",
        "type": "tool_result",
        "content": "openapi: 3.0.3\ninfo:\n  title: Talaria E2E API\n  version: 1.0.0\nservers:\n  # Unroutable on purpose: every case passes --base-url at the test server, so\n  # a step that ignored it would fail here rather than reach the network.\n  - url: https://api.invalid/v1\ncomponents:\n  schemas:\n    Pet:\n      type: object\n      required: [id, name]\n      properties:\n        id:\n          type: string\n        name:\n          type: string\n  securitySchemes:\n    bearerAuth:\n      type: http\n      scheme: bearer\n    secureKey:\n      type: apiKey\n      in: header\n      name: X-Secure-Key\n# Document-level, so every operation below needs the bearer token unless it\n# names its own scheme. The canary rides in on this one.\nsecurity:\n  - bearerAuth: []\npaths:\n  /pets:\n    get:\n      operationId: listPets\n      summary: List every pet in the store\n      tags: [pets]\n      responses:\n        \"200\":\n          description: The pets\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: \"#/components/schemas/Pet\"\n    post:\n      operationId: createPet\n      summary: Create a pet\n      tags: [pets]\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              type: object\n              required: [name]\n              properties:\n                name:\n                  type: string\n      responses:\n        \"201\":\n          description: Created\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"\n  /pets/{petId}:\n    get:\n      operationId: getPet\n      summary: Fetch one pet by id\n      tags: [pets]\n      parameters:\n        # The example is what `run` fills the path template with; without it\n        # the operation would be skipped rather than called.\n        - name: petId\n          in