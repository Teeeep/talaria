        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"context\"\n6\t\t\"encoding/json\"\n7\t\t\"errors\"\n8\t\t\"math\"\n9\t\t\"net/http\"\n10\t\t\"net/url\"\n11\t\t\"os\"\n12\t\t\"os/exec\"\n13\t\t\"path/filepath\"\n14\t\t\"strings\"\n15\t\t\"time\"\n16\t\n17\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n18\t\t\"github.com/Teeeep/talaria/internal/request\"\n19\t\t\"github.com/Teeeep/talaria/internal/secret\"\n20\t)\n21\t\n22\t// Response is one observed HTTP response. It is the `response` block of call's\n23\t// output (DESIGN.md §4) before any redaction is applied — redaction of what came\n24\t// back off the wire is Task 20's job, and doing it here would leave no\n25\t// unredacted copy for validation to check against the spec.\n26\ttype Response struct {\n27\t\tStatus   int         `json:\"status\"`\n28\t\tHeaders  http.Header `json:\"headers\"`\n29\t\tBody     []byte      `json:\"body\"`\n30\t\tTimingMS int64       `json:\"timing_ms\"`\n31\t}\n32\t\n33\t// Execute runs req through the system curl and returns what came back.\n34\t//\n35\t// An HTTP 4xx or 5xx is a successful observation and returns a Response with no\n36\t// error (§4); only a request that could not be completed at all — a refused\n37\t// connection, a TLS failure, curl itself failing — is an error, and it carries\n38\t// exit code 1.\n39\t//\n40\t// The credential values live in the config document written to curl's stdin and\n41\t// nowhere else: not in argv, which /proc/*/cmdline exposes to any process on\n42\t// the host, and not in the environment curl inherits (§5a).\n43\tfunc Execute(ctx context.Context, req *request.Request) (*Response, error) {\n44\t\treturn ExecuteWith(ctx, req, DefaultOptions())\n45\t}\n46\t\n47\t// killGrace is how long past its own max-time a curl gets before talaria stops\n48\t// waiting for it. curl enforces the timeout itself in every case anyone has\n49\t// seen; this margin is for the ones nobody has — a curl wedged in a syscall, or\n50\t// one whose stdout pipe a child process is still holding open. Without it, the\n51\t// bound is only as good as the subprocess's willingness to honour it.\n52\tconst killGrace = 2 * time.Second\n53\t\n54\t// ExecuteWith is Execute with the timeouts named rather than defaulted.\n55\tfunc ExecuteWith(ctx context.Context, req *request.Request, opts Options) (*Response, error) {\n56\t\topts = opts.withDefaults()\n57\t\n58\t\tpath, err := exec.LookPath(\"curl\")\n59\t\tif err != nil {\n60\t\t\treturn nil, clierr.RequestFailed(\"curl is not installed or not on PATH: %w\", err)\n61\t\t}\n62\t\tif err := preflight(path); err != nil {\n63\t\t\treturn nil, err\n64\t\t}\n65\t\n66\t\tcapture, cleanupCapture, err := newCapture()\n67\t\tif err != nil {\n68\t\t\treturn nil, err\n69\t\t}\n70\t\tdefer cleanupCapture()\n71\t\n72\t\tconfig, argv, cleanupConfig, err := BuildConfigWith(req, capture, opts)\n73\t\tdefer cleanupConfig()\n74\t\tif err != nil {\n75\t\t\treturn nil, err\n76\t\t}\n77\t\n78\t\t// Derived from the caller's context, not from Background: a Ctrl-C has to\n79\t\t// reach curl through the same CommandContext the timeout uses, so that one\n80\t\t// mechanism kills the process and every defer above — the capture directory\n81\t\t// and the config's temp body file — runs on the way out.\n82\t\texecCtx, cancel := context.WithTimeout(ctx, opts.MaxTime+killGrace)\n83\t\tdefer cancel()\n84\t\n85\t\t// argv[0] is the command name BuildConfig reports; the resolved path is what\n86\t\t// actually gets executed, so a PATH change mid-run cannot swap the binary\n87\t\t// between the preflight and the call.\n88\t\tcmd := exec.CommandContext(execCtx, path, argv[1:]...)\n89\t\t// The context kills the process; WaitDelay bounds the reaping too, so a\n90\t\t// grandchild still holding the output pipe cannot leave Wait blocked after\n91\t\t// curl itself is gone.\n92\t\tcmd.WaitDelay = killGrace\n93\t\t// And the kill goes to curl's whole process group, so nothing it spawned —\n94\t\t// an ssh for a proxy, a helper for a scheme — survives it.\n95\t\tisolate(cmd)\n96\t\t// The document goes in over a pipe rather than through the process's own\n97\t\t// stdin, which belongs to the user and may be a request body (Task 18).\n98\t\tcmd.Stdin = bytes.NewReader(config)\n99\t\n100\t\tvar stdout, stderr bytes.Buffer\n101\t\tcmd.Stdout = &stdout\n102\t\tcmd.Stderr = &stderr\n103\t\n104\t\tif err := cmd.Run(); err != nil {\n105\t\t\t// Either context ending means curl was killed rather than having exited,\n106\t\t\t// so its status is talaria's signal and not curl's own 28. Which of the\n107\t\t\t// two it was matters to whoever reads the message: a cancelled request is\n108\t\t\t// the caller's own Ctrl-C, and reporting it as a timeout would send an\n109\t\t\t// agent looking for a slow API that does not exist.\n110\t\t\tif ctx.Err() != nil {\n111\t\t\t\treturn nil, clierr.RequestFailed(\"the request was cancelled before it completed\")\n112\t\t\t}\n113\t\t\tif execCtx.Err() != nil {\n114\t\t\t\treturn nil, clierr.RequestFailed(\n115\t\t\t\t\t\"the request could not be completed: curl outlived its %s timeout and was killed\",\n116\t\t\t\t\topts.MaxTime)\n117\t\t\t}\n118\t\n119\t\t\treturn nil, runFailure(req, err, stderr.String())\n120\t\t}\n121\t\n122\t\treturn readResponse(req, capture, stdout.Bytes())\n123\t}\n124\t\n125\t// writeOut is curl's `--write-out '%{json}'` payload, of which talaria reads\n126\t// two fields. It arrives as the whole of curl's stdout, so it is unmarshalled\n127\t// as one object rather than scanned for out of a mixed stream — the split that\n128\t// makes a response body impersonating this shape a non-event.\n129\ttype writeOut struct {\n130\t\tHTTPCode  int     `json:\"http_code\"`\n131\t\tTimeTotal float64 `json:\"time_total\"`\n132\t\tErrorMsg  string  `json:\"errormsg\"`\n133\t}\n134\t\n135\t// readResponse assembles the Response from curl's three output channels.\n136\tfunc readResponse(req *request.Request, capture Capture, stdout []byte) (*Response, error) {\n137\t\tvar meta writeOut\n138\t\tif err := json.Unmarshal(stdout, &meta); err != nil {\n139\t\t\treturn nil, clierr.RequestFailed(\"cannot parse curl's response metadata: %w\", err)\n140\t\t}\n141\t\n142\t\tbody, err := os.ReadFile(capture.BodyPath)\n143\t\tif err != nil {\n144\t\t\treturn nil, clierr.RequestFailed(\"cannot read the response body: %w\", err)\n145\t\t}\n146\t\n147\t\tdump, err := os.ReadFile(capture.HeaderPath)\n148\t\tif err != nil {\n149\t\t\treturn nil, clierr.RequestFailed(\"cannot read the response headers: %w\", err)\n150\t\t}\n151\t\n152\t\t// http_code is 0 when curl never got a response. That is a completed process\n153\t\t// with nothing observed, which is a failed request rather than an empty one.\n154\t\tif meta.HTTPCode == 0 {\n155\t\t\treturn nil, requestFailed(req, 0, meta.ErrorMsg)\n156\t\t}\n157\t\n158\t\treturn &Response{\n159\t\t\tStatus:   meta.HTTPCode,\n160\t\t\tHeaders:  parseHeaders(dump),\n161\t\t\tBody:     body,\n162\t\t\tTimingMS: int64(math.Round(meta.TimeTotal * 1000)),\n163\t\t}, nil\n164\t}\n165\t\n166\t// newCapture allocates the two files curl writes the response to, inside a 0700\n167\t// directory of their own. They hold response data, which may carry a session\n168\t// cookie or a token the API handed back, so they are never world-readable and\n169\t// never outlive the exec.\n170\tfunc newCapture() (Capture, func(), error) {\n171\t\tdir, err := os.MkdirTemp(\"\", \"talaria-call-*\")\n172\t\tif err != nil {\n173\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot stage the response: %w\", err)\n174\t\t}\n175\t\n176\t\tcleanup := func() { os.RemoveAll(dir) } //nolint:errcheck // Best effort; 0700 and in TMPDIR.\n177\t\n178\t\tif err := os.Chmod(dir, 0o700); err != nil {\n179\t\t\tcleanup()\n180\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot secure the response directory: %w\", err)\n181\t\t}\n182\t\n183\t\tcapture := Capture{\n184\t\t\tBodyPath:   filepath.Join(dir, \"body\"),\n185\t\t\tHeaderPath: filepath.Join(dir, \"headers\"),\n186\t\t}\n187\t\n188\t\t// Creating both up front means curl writes into a file that is already 0600,\n189\t\t// rather than one whose mode comes from curl's umask.\n190\t\tfor _, path := range []string{capture.BodyPath, capture.HeaderPath} {\n191\t\t\tf, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)\n192\t\t\tif err != nil {\n193\t\t\t\tcleanup()\n194\t\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot stage the response: %w\", err)\n195\t\t\t}\n196\t\t\tif err := f.Close(); err != nil {\n197\t\t\t\tcleanup()\n198\t\t\t\treturn Capture{}, func() {}, clierr.RequestFailed(\"cannot stage the response: %w\", err)\n199\t\t\t}\n200\t\t}\n201\t\n202\t\treturn capture, cleanup, nil\n203\t}\n204\t\n205\t// parseHeaders turns curl's dump-header file into an http.Header, keeping only\n206\t// the last response block. Redirects and a 100 Continue each leave a block in\n207\t// front of the real one, and a stale Location reported as the response's own is\n208\t// worse than no Location at all.\n209\tfunc parseHeaders(dump []byte) http.Header {\n210\t\theaders := http.Header{}\n211\t\n212\t\tblocks := strings.Split(strings.ReplaceAll(string(dump), \"\\r\\n\", \"\\n\"), \"\\n\\n\")\n213\t\tlast := \"\"\n214\t\tfor _, block := range blocks {\n215\t\t\tif strings.TrimSpace(block) != \"\" {\n216\t\t\t\tlast = block\n217\t\t\t}\n218\t\t}\n219\t\n220\t\tfor _, line := range strings.Split(last, \"\\n\") {\n221\t\t\t// The status line is not a header; the Response's Status comes from\n222\t\t\t// %{json}, which does not need re-deriving from text.\n223\t\t\tif line == \"\" || strings.HasPrefix(line, \"HTTP/\") {\n224\t\t\t\tcontinue\n225\t\t\t}\n226\t\n227\t\t\tname, value, ok := strings.Cut(line, \":\")\n228\t\t\tif !ok {\n229\t\t\t\tcontinue\n230\t\t\t}\n231\t\t\theaders.Add(strings.TrimSpace(name), strings.TrimSpace(value))\n232\t\t}\n233\t\n234\t\treturn headers\n235\t}\n236\t\n237\t// runFailure classifies a curl process that did not exit 0.\n238\tfunc runFailure(req *request.Request, err error, stderr string) error {\n239\t\tvar exitErr *exec.ExitError\n240\t\tif errors.As(err, &exitErr) {\n241\t\t\treturn requestFailed(req, exitErr.ExitCode(), stderr)\n242\t\t}\n243\t\n244\t\treturn clierr.RequestFailed(\"cannot run curl: %w\", err)\n245\t}\n246\t\n247\t// requestFailed builds the error for a request curl could not complete, with\n248\t// curl's own exit status in it so an operator can look the code up.\n249\t//\n250\t// The detail passes through the request's scrubber first: curl echoes the URL\n251\t// it was given into several of its messages, and for an API-key scheme the URL\n252\t// is exactly where the credential is. §5a — errors are built from the redacted\n253\t// representation.\n254\tfunc requestFailed(req *request.Request, exitCode int, detail string) error {\n255\t\tdetail = strings.TrimSpace(scrubber(req).Replace(detail))\n256\t\tif detail == \"\" {\n257\t\t\treturn clierr.RequestFailed(\"the request could not be completed: curl exited %d\", exitCode)\n258\t\t}\n259\t\n260\t\treturn clierr.RequestFailed(\"the request could not be completed: curl exited %d: %s\", exitCode, detail)\n261\t}\n262\t\n263\t// scrubber returns a replacer that rewrites any credential this request put on\n264\t// the wire back into the form every other surface shows it as.\n265\t//\n266\t// It works from the request's own values rather than from a pattern over the\n267\t// text: talaria knows exactly which values it sent, and matching those is\n268\t// neither a guess nor defeatable by an unusual message format. A referenced\n269\t// credential that will not resolve was never sent and so cannot be echoed.\n270\t//\n271\t// Sensitive, not secret: a literal the user typed under a credential-shaped\n272\t// name — `--query api_key=…`, hidden by request.Build — is a credential too,\n273\t// and skipping it would leave it in cleartext in curl's own error text while\n274\t// every other output surface prints <redacted>.\n275\tfunc scrubber(req *request.Request) *strings.Replacer {\n276\t\tif req == nil {\n277\t\t\treturn strings.NewReplacer()\n278\t\t}\n279\t\n280\t\tvar pairs []string\n281\t\tfor _, group := range [][]request.Pair{req.Headers, req.Query, req.Cookies} {\n282\t\t\tfor _, p := range group {\n283\t\t\t\tif !p.Value.IsSensitive() {\n284\t\t\t\t\tcontinue\n285\t\t\t\t}\n286\t\n287\t\t\t\t// A ref prints as its own <redacted:env:NAME> form, which tells the\n288\t\t\t\t// reader which credential failed; a hidden literal has no name to\n289\t\t\t\t// give and falls back to the bare placeholder.\n290\t\t\t\tsent, redacted := p.Value.Reveal(), secret.Placeholder\n291\t\t\t\tif p.Value.IsSecret() {\n292\t\t\t\t\tresolved, err := p.Value.Ref().Resolve()\n293\t\t\t\t\tif err != nil || resolved == \"\" {\n294\t\t\t\t\t\tcontinue\n295\t\t\t\t\t}\n296\t\n297\t\t\t\t\tsent, redacted = resolved, p.Value.Ref().String()\n298\t\t\t\t}\n299\t\n300\t\t\t\tif sent == \"\" {\n301\t\t\t\t\tcontinue\n302\t\t\t\t}\n303\t\n304\t\t\t\tpairs = append(pairs, sent, redacted)\n305\t\t\t\t// A credential echoed back as part of a URL is percent-encoded, which\n306\t\t\t\t// the literal form would walk straight past.\n307\t\t\t\tif encoded := url.QueryEscape(sent); encoded != sent {\n308\t\t\t\t\tpairs = append(pairs, encoded, redacted)\n309\t\t\t\t}\n310\t\t\t}\n311\t\t}\n312\t\n313\t\treturn strings.NewReplacer(pairs...)\n314\t}\n315\t"
