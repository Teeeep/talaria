        "content": "1\tpackage spec\n2\t\n3\timport (\n4\t\t\"encoding/json\"\n5\t\t\"strings\"\n6\t\n7\t\t\"github.com/getkin/kin-openapi/openapi2\"\n8\t\t\"github.com/getkin/kin-openapi/openapi2conv\"\n9\t\t\"gopkg.in/yaml.v3\"\n10\t\n11\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n12\t)\n13\t\n14\t// versionSwagger2 is the only Swagger 2.0 version string, and the value\n15\t// recorded in Document.ConvertedFrom for a converted document.\n16\tconst versionSwagger2 = \"2.0\"\n17\t\n18\t// versionProbe reads just the mutually exclusive version keys. Swagger 2.0\n19\t// declares \"swagger\", OpenAPI 3.x declares \"openapi\", and every other field\n20\t// differs enough that guessing from anything else is unreliable.\n21\ttype versionProbe struct {\n22\t\tSwagger string `json:\"swagger\" yaml:\"swagger\"`\n23\t\tOpenAPI string `json:\"openapi\" yaml:\"openapi\"`\n24\t}\n25\t\n26\t// isSwagger2 reports whether raw spec bytes, in either JSON or YAML, declare\n27\t// Swagger 2.0. Format is detected by trying JSON and falling back to YAML\n28\t// rather than by file extension, because specs also arrive from URLs that carry\n29\t// no extension at all.\n30\tfunc isSwagger2(data []byte) bool {\n31\t\tvar probe versionProbe\n32\t\n33\t\tif err := json.Unmarshal(data, &probe); err != nil {\n34\t\t\tif err := yaml.Unmarshal(data, &probe); err != nil {\n35\t\t\t\treturn false\n36\t\t\t}\n37\t\t}\n38\t\n39\t\treturn strings.HasPrefix(probe.Swagger, \"2.\")\n40\t}\n41\t\n42\t// convertSwagger2 turns Swagger 2.0 bytes into OpenAPI 3.x JSON bytes that the\n43\t// normal load path can build. libopenapi cannot do this conversion, so\n44\t// kin-openapi's openapi2conv does it and hands the result back as bytes rather\n45\t// than as a second model type — one model reaches the rest of the program.\n46\tfunc convertSwagger2(data []byte, source string) ([]byte, error) {\n47\t\tjsonData, err := toJSON(data, source)\n48\t\tif err != nil {\n49\t\t\treturn nil, err\n50\t\t}\n51\t\n52\t\tvar v2 openapi2.T\n53\t\tif err := json.Unmarshal(jsonData, &v2); err != nil {\n54\t\t\treturn nil, clierr.SpecLoad(\"reading Swagger 2.0 spec %s: %w\", source, err)\n55\t\t}\n56\t\n57\t\tv3, err := openapi2conv.ToV3(&v2)\n58\t\tif err != nil {\n59\t\t\treturn nil, clierr.SpecLoad(\"converting Swagger 2.0 spec %s to OpenAPI 3: %w\", source, err)\n60\t\t}\n61\t\n62\t\tconverted, err := json.Marshal(v3)\n63\t\tif err != nil {\n64\t\t\treturn nil, clierr.SpecLoad(\"serialising converted spec %s: %w\", source, err)\n65\t\t}\n66\t\n67\t\treturn converted, nil\n68\t}\n69\t\n70\t// toJSON returns spec bytes as JSON, converting from YAML when needed, because\n71\t// openapi2.T only unmarshals JSON.\n72\t//\n73\t// The YAML decode goes through yaml.v3 deliberately: yaml.v2 decodes mappings\n74\t// as map[interface{}]interface{}, which json.Marshal rejects outright, so a\n75\t// downgrade there would break every YAML 2.0 spec.\n76\tfunc toJSON(data []byte, source string) ([]byte, error) {\n77\t\tif json.Valid(data) {\n78\t\t\treturn data, nil\n79\t\t}\n80\t\n81\t\tvar doc any\n82\t\tif err := yaml.Unmarshal(data, &doc); err != nil {\n83\t\t\treturn nil, clierr.SpecLoad(\"parsing spec %s: %w\", source, err)\n84\t\t}\n85\t\n86\t\tjsonData, err := json.Marshal(doc)\n87\t\tif err != nil {\n88\t\t\treturn nil, clierr.SpecLoad(\"converting spec %s from YAML to JSON: %w\", source, err)\n89\t\t}\n90\t\n91\t\treturn jsonData, nil\n92\t}\n93\t"
