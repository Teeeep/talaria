        "content": "// for the one renderer that builds curl's config document: a sensitive literal\n// still has to go on the wire, and String no longer returns it.\n//\n// For a value naming a credential it returns the redacted display form.\n// Reading a real credential is SecretRef.Resolve, in internal/curl at exec\n// time, and this is not that.\nfunc (v Value) Reveal() string {\n\tif v.IsSecret() {\n\t\treturn v.String()\n\t}\n\n\treturn v.literal\n}\n\n// GoString keeps %#v — the verb reached for when debugging, i.e. exactly when a\n// leak would be least expected — as safe as %v.\nfunc (v Value) GoString() string { return v.String() }\n\n// MarshalJSON renders the display form, so any JSON carrying a credential\n// position carries the redacted name instead of a value.\nfunc (v Value) MarshalJSON() ([]byte, error) { return json.Marshal(v.String()) }\n--- ParseRef ---\n\n// String returns the display form, <redacted:env:NAME>. Defining it on the\n// value receiver is deliberate: fmt then uses it for a SecretRef, a *SecretRef,\n// and a SecretRef held as a field of some larger struct printed with %v.\nfunc (r SecretRef) String() string { return \"<redacted:\" + r.Location() + \">\" }\n\n// ParseRef reads back the display form String produces, reporting whether s was\n// one. It exists for `history replay`: a stored entry carries\n// `<redacted:env:NAME>` where a credential stood, and replaying it means\n// resolving that name from the environment again — the value was never written\n// down, so re-deriving the *reference* is the only route back to a runnable\n// request.\n//\n// The round trip lives here, next to String, because the format is this\n// package's to change.\nfunc ParseRef(s string) (SecretRef, bool) {\n\tconst openTag, closeTag = \"<redacted:\", \">\"\n\n\tif !strings.HasPrefix(s, openTag) || !strings.HasSuffix(s, closeTag) {\n\t\treturn SecretRef{}, false\n\t}\n\n\tlocation := s[len(openTag) : len(s)-len(closeTag)]\n\tsource, name, ok := strings.Cut(location, \":\")\n\tif !ok || source == \"\" || name == \"\" {\n\t\treturn SecretRef{}, false\n\t}\n\n\treturn SecretRef{Source: source, Name: name}, true\n}\n\n// Location is where the value will be read from and under which name, `env:NAME`.\n// It is what `auth check` reports as a credential's source (§4), without the\n// <redacted:...> framing: nothing is being withheld here, because the answer\n// *is* the name — it is what an agent asks a human to export.\nfunc (r SecretRef) Location() string { return r.Source + \":\" + r.Name }\n\n// GoString returns the same redacted form, so %#v — the verb reached for when\n// debugging, i.e. exactly when a leak would be least expected — is safe too.\nfunc (r SecretRef) GoString() string { return r.String() }\n\n--- config.go auth/cookies ---\ninternal/curl/config.go:133:func (d *document) build(req *request.Request, capture Capture, opts Options) error {\ninternal/curl/config.go:140:\t// head rather than `request = \"HEAD\"`: -X HEAD leaves curl waiting for a body\ninternal/curl/config.go:208:func (d *document) auth(req *request.Request) error {\ninternal/curl/config.go:228:func (d *document) cookies(req *request.Request) error {\ninternal/curl/config.go:253:func (d *document) body(req *request.Request) error {\ninternal/curl/config.go:296:func (d *document) tempFile(data []byte) (string, error) {\ninternal/curl/config.go:330:func (d *document) directive(name, value string) {\ninternal/curl/config.go:331:\td.b.WriteString(name + ` = \"` + escapeDirective(value) + \"\\\"\\n\")\ninternal/curl/config.go:335:func (d *document) flag(name string) { d.b.WriteString(name + \"\\n\") }\ninternal/curl/config.go:339:func (d *document) discard() { d.b.Reset() }\ninternal/curl/config.go:342:func (d *document) cleanup() {\ninternal/curl/config.go:351:func (d *document) cleanupWith(config []byte) func() {\ninternal/curl/config.go:393:func escapeDirective(s string) string { return configEscape.Replace(s) }\ninternal/request/build.go: