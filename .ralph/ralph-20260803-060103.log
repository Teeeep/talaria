          "command": "mkdir -p /tmp/tal && cat > /tmp/tal/server.py <<'PYEOF'\nimport socket, threading, sys, os, json, time\n\nCAP = os.environ.get(\"CAPFILE\", \"/tmp/tal/capture.log\")\nPORT = int(os.environ.get(\"PORT\", \"9977\"))\n\nlock = threading.Lock()\n\ndef handle(c):\n    c.settimeout(5)\n    data = b\"\"\n    try:\n        # read headers\n        while b\"\\r\\n\\r\\n\" not in data:\n            chunk = c.recv(65536)\n            if not chunk: break\n            data += chunk\n        head, _, rest = data.partition(b\"\\r\\n\\r\\n\")\n        lines = head.split(b\"\\r\\n\")\n        hdrs = {}\n        for l in lines[1:]:\n            k, _, v = l.partition(b\":\")\n            hdrs[k.decode().lower()] = v.strip()\n        body = rest\n        cl = hdrs.get(\"content-length\")\n        if cl:\n            n = int(cl)\n            while len(body) < n:\n                ch = c.recv(65536)\n                if not ch: break\n                body += ch\n        elif hdrs.get(\"transfer-encoding\") == b\"chunked\":\n            while not body.endswith(b\"0\\r\\n\\r\\n\"):\n                ch = c.recv(65536)\n                if not ch: break\n                body += ch\n        raw = head + b\"\\r\\n\\r\\n\" + body\n        with lock:\n            with open(CAP, \"ab\") as f:\n                f.write(b\"===REQ===\\n\" + raw + b\"\\n===END===\\n\")\n        reqline = lines[0].decode(errors=\"replace\")\n        method, path = (reqline.split(\" \") + [\"\", \"\"])[:2]\n        status = \"200 OK\"\n        if \"/status/\" in path:\n            code = path.split(\"/status/\")[1].split(\"?\")[0]\n            status = code + \" Custom\"\n        if path.startswith(\"/slow\"):\n            time.sleep(10)\n        if path.startswith(\"/badshape\"):\n            payload = json.dumps({\"id\": \"not-an-int\", \"name\": 5}).encode()\n        elif path.startswith(\"/notjson\"):\n            payload = b\"plain text here\"\n        else:\n            payload = json.dumps({\"id\": 42, \"name\": \"Fido\", \"tag\": \"dog\"}).encode()\n        if method == \"HEAD\":\n            resp = (\"HTTP/1.1 %s\\r\\nContent-Type: application/json\\r\\nContent-Length: %d\\r\\nSet-Cookie: sess=supersecretcookie\\r\\nConnection: close\\r\\n\\r\\n\" % (status, len(payload))).encode()\n        else:\n            resp = (\"HTTP/1.1 %s\\r\\nContent-Type: application/json\\r\\nContent-Length: %d\\r\\nSet-Cookie: sess=supersecretcookie\\r\\nConnection: close\\r\\n\\r\\n\" % (status, len(payload))).encode() + payload\n        c.sendall(resp)\n    except Exception as e:\n        sys.stderr.write(\"err %r\\n\" % (e,))\n    finally:\n        try: c.close()\n        except: pass\n\ns = socket.socket()\ns.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\ns.bind((\"127.0.0.1\", PORT))\ns.listen(64)\nsys.stderr.write(\"listening %d\\n\" % PORT)\nsys.stderr.flush()\nwhile True:\n    c, _ = s.accept()\n    threading.Thread(target=handle, args=(c,), daemon=True).start()\nPYEOF\necho written",
