51\t\tif strings.Contains(stdout, authCanary) {\n52\t\t\tt.Fatalf(\"auth check leaked the credential on stdout:\\n%s\", stdout)\n53\t\t}\n54\t\tif strings.Contains(stderr, authCanary) {\n55\t\t\tt.Fatalf(\"auth check leaked the credential on stderr:\\n%s\", stderr)\n56\t\t}\n57\t\n58\t\treturn code, stdout, stderr\n59\t}\n60\t\n61\tfunc decodeAuth(t *testing.T, stdout string) authJSON {\n62\t\tt.Helper()\n63\t\n64\t\tvar got authJSON\n65\t\tif err := json.Unmarshal([]byte(stdout), &got); err != nil {\n66\t\t\tt.Fatalf(\"decoding %q: %v\", stdout, err)\n67\t\t}\n68\t\n69\t\treturn got\n70\t}\n71\t\n72\tfunc TestAuthCheckReportsPresenceInTheDocumentedShape(t *testing.T) {"
