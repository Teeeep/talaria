        "tool_use_id": "toolu_01ChkgJtaTkqq4wiprC1AhLx",
        "type": "tool_result",
        "content": "1\tpackage secret\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"strings\"\n9\t\t\"sync\"\n10\t)\n11\t\n12\t// builtinBodyPaths are the response-body JSON paths redacted without any\n13\t// configuration: the RFC 6749 token-response fields. A body carrying one of\n14\t// these came from a credential-issuing endpoint, which is exactly the case\n15\t// DESIGN.md §5a names. Everything else is API-specific — talaria cannot tell a\n16\t// secret field from an ordinary one by looking at it — and has to be configured.\n17\tvar builtinBodyPaths = []string{\"access_token\", \"refresh_token\", \"id_token\"}\n18\t\n19\t// ResponseRedactor redacts what came back off the wire, which is the one leak\n20\t// channel §5a admits it does not close: a response body may contain a secret\n21\t// and the tool cannot know which field it is. What it can do is what this type\n22\t// does — always redact the response headers that carry credentials by name, and\n23\t// redact the body paths the user has told it about.\n24\t//\n25\t// It is deliberately separate from the request-side Redactor. A request's\n26\t// secrets are structural: they are SecretRefs, and a ref cannot print its\n27\t// value. A response's secrets are just bytes, so redacting them is pattern\n28\t// matching, with the weaker guarantee that implies.\n29\t//\n30\t// The zero value — including a nil *ResponseRedactor, which is what an unset\n31\t// struct field is — redacts the built-in lists, so redaction is never\n32\t// accidentally opt-in.\n33\ttype ResponseRedactor struct {\n34\t\theaders *Redactor\n35\t\tpaths   [][]string\n36\t}\n37\t\n38\t// NewResponseRedactor returns a redactor matching the built-in header list plus\n39\t// extraHeaders, and the built-in body paths plus extraPaths.\n40\t//\n41\t// A body path is dotted — `data.token` names the `token` key of the top-level\n42\t// `data` object. Neither list can be shrunk: a firewall a misconfiguration can\n43\t// switch off is not one.\n44\tfunc NewResponseRedactor(extraHeaders, extraPaths []string) *ResponseRedactor {\n45\t\tpaths := make([][]string, 0, len(builtinBodyPaths)+len(extraPaths))\n46\t\tfor _, path := range builtinBodyPaths {\n47\t\t\tpaths = append(paths, strings.Split(path, \".\"))\n48\t\t}\n49\t\tfor _, path := range extraPaths {\n50\t\t\tif segments := splitPath(path); segments != nil {\n51\t\t\t\tpaths = append(paths, segments)\n52\t\t\t}\n53\t\t}\n54\t\n55\t\treturn &ResponseRedactor{headers: NewRedactor(extraHeaders...), paths: paths}\n56\t}\n57\t\n58\t// Headers returns a copy of h with the values of sensitive headers replaced.\n59\t//\n60\t// Repetitions are kept — Set-Cookie legitimately appears more than once, and a\n61\t// caller counting cookies should still see the right number — and the whole\n62\t// value goes, cookie name included, because `session=` in front of a token does\n63\t// not make the token safe to print.\n64\t//\n65\t// The original map is left untouched — a redactor reports, it does not edit\n66\t// what came off the wire — and only the copy travels onward. Everything\n67\t// downstream of this point, response validation included, reads the copy.\n68\tfunc (r *ResponseRedactor) Headers(h map[string][]string) map[string][]string {\n69\t\tif h == nil {\n70\t\t\treturn nil\n71\t\t}\n72\t\n73\t\tredacted := make(map[string][]string, len(h))\n74\t\tfor name, values := range h {\n75\t\t\tsensitive := r.headerRedactor().IsSensitive(name)\n76\t\n77\t\t\tcopied := make([]string, len(values))\n78\t\t\tfor i, value := range values {\n79\t\t\t\tif sensitive {\n80\t\t\t\t\tcopied[i] = Placeholder\n81\t\t\t\t} else {\n82\t\t\t\t\tcopied[i] = value\n83\t\t\t\t}\n84\t\t\t}\n85\t\t\tredacted[name] = copied\n86\t\t}\n87\t\n88\t\treturn redacted\n89\t}\n90\t\n91\t// Body returns body with the configured JSON paths replaced.\n92\t//\n93\t// A body that is not a single JSON object or array is returned verbatim: a\n94\t// dotted path has no meaning in a text or binary body, and rewriting bytes\n95\t// talaria does not understand would report a document the server never sent. So\n96\t// is a body in which nothing matched, which keeps the common case exact — the\n97\t// caller sees the server's own formatting, not encoding/json's.\n98\tfunc (r *ResponseRedactor) Body(body []byte) []byte {\n99\t\tpaths := r.bodyPaths()\n100\t\tif len(paths) == 0 || len(body) == 0 {\n101\t\t\treturn body\n102\t\t}\n103\t\n104\t\tdoc, ok := decodeDocument(body)\n105\t\tif !ok {\n106\t\t\treturn body\n107\t\t}\n108\t\n109\t\tredacted := false\n110\t\tfor _, path := range paths {\n111\t\t\tif redactPath(doc, path) {\n112\t\t\t\tredacted = true\n113\t\t\t}\n114\t\t}\n115\t\tif !redacted {\n116\t\t\treturn body\n117\t\t}\n118\t\n119\t\tout, err := json.Marshal(doc)\n120\t\tif err != nil {\n121\t\t\t// Unreachable for a document that just decoded, but the alternative to\n122\t\t\t// returning the original here is returning nothing at all.\n123\t\t\treturn body\n124\t\t}\n125\t\n126\t\treturn out\n127\t}\n128\t\n129\t// headerRedactor returns the header matcher, treating a nil receiver as the\n130\t// built-in list.\n131\tfunc (r *ResponseRedactor) headerRedactor() *Redactor {\n132\t\tif r == nil {\n133\t\t\treturn nil // A nil *Redactor is the built-in list; see Redactor.match.\n134\t\t}\n135\t\n136\t\treturn r.headers\n137\t}\n138\t\n139\t// bodyPaths returns the paths in effect, treating a nil receiver as the\n140\t// built-in list.\n141\tfunc (r *ResponseRedactor) bodyPaths() [][]string {\n142\t\tif r == nil {\n143\t\t\treturn NewResponseRedactor(nil, nil).paths\n144\t\t}\n145\t\n146\t\treturn r.paths\n147\t}\n148\t\n149\t// decodeDocument decodes body as exactly one JSON object or array. Trailing\n150\t// content means this was never one JSON document — a body ending in junk is not\n151\t// something to re-encode — and a root that is neither is skipped, because a\n152\t// dotted path cannot name anything inside a bare string or number.\n153\t//\n154\t// An array root is decoded rather than skipped: a collection endpoint answers\n155\t// with one, and the elements are objects a path does name.\n156\tfunc decodeDocument(body []byte) (any, bool) {\n157\t\ttrimmed := bytes.TrimLeft(body, \" \\t\\r\\n\")\n158\t\tif len(trimmed) == 0 || (trimmed[0] != '{' && trimmed[0] != '[') {\n159\t\t\treturn nil, false\n160\t\t}\n161\t\n162\t\tdec := json.NewDecoder(bytes.NewReader(trimmed))\n163\t\t// Numbers stay as their original text: without this an id of\n164\t\t// 1234567890123456789 comes back out as 1.2345678901234568e+18, and a\n165\t\t// redacted body must still report what the server actually sent.\n166\t\tdec.UseNumber()\n167\t\n168\t\tvar doc any\n169\t\tif err := dec.Decode(&doc); err != nil {\n170\t\t\treturn nil, false\n171\t\t}\n172\t\tif _, err := dec.Token(); err != io.EOF {\n173\t\t\treturn nil, false\n174\t\t}\n175\t\n176\t\treturn doc, true\n177\t}\n178\t\n179\t// redactPath replaces the value at path within doc, reporting whether anything\n180\t// was there to replace. A path that names nothing — a missing key, or a segment\n181\t// that turns out not to be an object — is a no-op rather than an error: a\n182\t// redaction list is written once and applied to every response an API returns.\n183\t//\n184\t// An array is fanned out over without consuming a segment, because a path names\n185\t// keys and an array has none: `items.token` reaches the token of every element\n186\t// of items, and a top-level `access_token` reaches every element of a top-level\n187\t// array. Anything matched anywhere is reported as a match.\n188\tfunc redactPath(doc any, path []string) bool {\n189\t\tswitch node := doc.(type) {\n190\t\tcase []any:\n191\t\t\tredacted := false\n192\t\t\tfor _, element := range node {\n193\t\t\t\tif redactPath(element, path) {\n194\t\t\t\t\tredacted = true\n195\t\t\t\t}\n196\t\t\t}\n197\t\n198\t\t\treturn redacted\n199\t\n200\t\tcase map[string]any:\n201\t\t\tif len(path) > 1 {\n202\t\t\t\treturn redactPath(node[path[0]], path[1:])\n203\t\t\t}\n204\t\t\tif _, ok := node[path[0]]; !ok {\n205\t\t\t\treturn false\n206\t\t\t}\n207\t\t\tnode[path[0]] = Placeholder\n208\t\n209\t\t\treturn true\n210\t\n211\t\tdefault:\n212\t\t\treturn false\n213\t\t}\n214\t}\n215\t\n216\t// splitPath splits a dotted path into segments, returning nil for one that\n217\t// cannot name anything — empty, or with an empty segment. Silently ignoring it\n218\t// is right here: config validation belongs to whoever read the config, and a\n219\t// redactor that refused to be built would fail an unrelated call.\n220\tfunc splitPath(path string) []string {\n221\t\tif path == \"\" {\n222\t\t\treturn nil\n223\t\t}\n224\t\n225\t\tsegments := strings.Split(path, \".\")\n226\t\tfor _, segment := range segments {\n227\t\t\tif segment == \"\" {\n228\t\t\t\treturn nil\n229\t\t\t}\n230\t\t}\n231\t\n232\t\treturn segments\n233\t}\n234\t\n235\t// QueryKeyWarner emits the one-time warning from §5a's leak-channel table: an\n236\t// API key in the query string is symbolic in emitted curl and redacted in\n237\t// output, and still ends up in the *server's* access log, where talaria has no\n238\t// say. The user is told once so they can decide whether that is acceptable.\n239\t//\n240\t// Once per process rather than once per call, because `run` makes hundreds of\n241\t// calls against the same spec and a warning repeated hundreds of times is one\n242\t// nobody reads.\n243\ttype QueryKeyWarner struct{ once sync.Once }\n244\t\n245\t// NewQueryKeyWarner returns a warner that has not yet fired.\n246\tfunc NewQueryKeyWarner() *QueryKeyWarner { return &QueryKeyWarner{} }\n247\t\n248\t// Warn writes the warning for a credential travelling in query parameter param,\n249\t// the first time it is called and never again.\n250\t//\n251\t// The message names the parameter and the environment variable, both of which\n252\t// are names; a warning about a leak that quoted the value would be one.\n253\tfunc (w *QueryKeyWarner) Warn(out io.Writer, param string, ref SecretRef) {\n254\t\tif w == nil || out == nil {\n255\t\t\treturn\n256\t\t}\n257\t\n258\t\tw.once.Do(func() {\n259\t\t\tfmt.Fprintf(out,\n260\t\t\t\t\"warning: this operation sends %s in the query parameter %q; \"+\n261\t\t\t\t\t\"URLs are recorded in server access logs, so the key is exposed there \"+\n262\t\t\t\t\t\"whatever talaria redacts\\n\",\n263\t\t\t\tref.Symbolic(), param)\n264\t\t})\n265\t}\n266\t"
      }
    ]
