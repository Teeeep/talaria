        "tool_use_id": "toolu_013VmsX7r9JY7xkxpMttynQz",
        "type": "tool_result",
        "content": "40\t\n41\t// reproSpecPath describes the same API in the shapes whose rendered curl could\n42\t// diverge from the executed one — a GET with a body, a HEAD, a cookie, a form\n43\t// body. It is separate so the pair above stays symmetrical.\n44\tconst reproSpecPath = \"testdata/e2e-reproduce.yaml\"\n45\t\n46\t// binary is the talaria under test, built once by TestMain.\n47\t//\n48\t// The suite drives a real process rather than the command tree in-process, for\n49\t// the reason the canary suite does: the tree lives in package main and cannot\n50\t// be imported. It is also the stronger reading of an end-to-end test — the exit\n51\t// codes asserted here are the ones a shell would see, and the streams scanned\n52\t// for a credential include anything written outside the writers a test would\n53\t// otherwise hand it.\n54\tvar binary string\n55\t\n56\tfunc TestMain(m *testing.M) {\n57\t\tdir, err := os.MkdirTemp(\"\", \"talaria-e2e-*\")\n58\t\tif err != nil {\n59\t\t\tfmt.Fprintf(os.Stderr, \"creating the build directory: %v\\n\", err)\n60\t\t\tos.Exit(1)\n61\t\t}\n62\t\n63\t\tif err := readSources(); err != nil {\n64\t\t\tfmt.Fprintf(os.Stderr, \"reading the sources under test: %v\\n\", err)\n65\t\t\tos.Exit(1)\n66\t\t}\n67\t\n68\t\tbinary = filepath.Join(dir, \"talaria\")\n69\t\tbuild := exec.Command(\"go\", \"build\", \"-o\", binary, \"./cmd/talaria\")\n70\t\tbuild.Dir = filepath.Join(\"..\", \"..\")\n71\t\tif out, err := build.CombinedOutput(); err != nil {\n72\t\t\tfmt.Fprintf(os.Stderr, \"building talaria: %v\\n%s\", err, out)\n73\t\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n74\t\t\tos.Exit(1)\n75\t\t}\n76\t\n77\t\tcode := m.Run()\n78\t\n79\t\t// Explicit rather than deferred: os.Exit does not run defers.\n80\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n81\t\tos.Exit(code)\n82\t}\n83\t\n84\t// readSources opens every Go source file in the module so the test cache knows\n85\t// this suite depends on all of them.\n86\t//\n87\t// The dependency is real but invisible to the tool: the suite reaches the code\n88\t// under test by building a binary in a subprocess, and `go test` records\n89\t// nothing about that. Without this, a break anywhere in cmd/ or internal/ would\n90\t// leave this package's own inputs untouched and `go test ./...` would replay a\n91\t// cached pass over code that never ran.\n92\tfunc readSources() error {\n93\t\troot := filepath.Join(\"..\", \"..\")\n94\t\n95\t\treturn filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {\n96\t\t\tif err != nil || d.IsDir() || !strings.HasSuffix(path, \".go\") {\n97\t\t\t\treturn err\n98\t\t\t}\n99\t\n100\t\t\t_, err = os.ReadFile(path)\n101\t\n102\t\t\treturn err\n103\t\t})\n104\t}\n105\t\n106\t// result is one talaria invocation.\n107\ttype result struct {\n108\t\targs   []string\n109\t\tcode   int\n110\t\tstdout string\n111\t\tstderr string\n112\t}\n113\t\n114\t// label renders the invocation for a failure message.\n115\tfunc (r result) label() string { return \"talaria \" + strings.Join(r.args, \" \") }\n116\t\n117\t// surfaces returns both streams of a result as scannable surfaces.\n118\tfunc (r result) surfaces() []canary.Surface {\n119\t\treturn []canary.Surface{\n120\t\t\tcanary.Stream(\"stdout of `\"+r.label()+\"`\", r.stdout),\n121\t\t\tcanary.Stream(\"stderr of `\"+r.label()+\"`\", r.stderr),\n122\t\t}\n123\t}\n124\t\n125\t// harness runs talaria against an isolated home, so history, cache and config\n126\t// belong to the test rather than to the developer, and the only credentials in\n127\t// reach are the ones the case injected.\n128\ttype harness struct {\n129\t\tt     *testing.T\n130\t\tenv   []string\n131\t\tstate string\n132\t\tcache string\n133\t\tconf  string\n134\t}\n135\t\n136\tfunc newHarness(t *testing.T, vars map[string]string) *harness {\n137\t\tt.Helper()\n138\t\n139\t\thome := t.TempDir()\n140\t\th := &harness{\n141\t\t\tt:     t,\n142\t\t\tstate: filepath.Join(home, \"state\"),\n143\t\t\tcache: filepath.Join(home, \"cache\"),\n144\t\t\tconf:  filepath.Join(home, \"config\"),\n145\t\t}\n146\t\n147\t\t// Built from nothing rather than from os.Environ: a developer's own\n148\t\t// TALARIA_AUTH_BEARER or TALARIA_SPEC must not be able to change what this\n149\t\t// suite tests, and PATH is all curl needs to be found.\n150\t\th.env = []string{\n151\t\t\t\"PATH=\" + os.Getenv(\"PATH\"),\n152\t\t\t\"HOME=\" + home,\n153\t\t\t\"XDG_STATE_HOME=\" + h.state,\n154\t\t\t\"XDG_CACHE_HOME=\" + h.cache,\n155\t\t\t\"XDG_CONFIG_HOME=\" + h.conf,\n156\t\t}\n157\t\tfor name, value := range vars {\n158\t\t\th.env = append(h.env, name+\"=\"+value)\n159\t\t}\n160\t\n161\t\treturn h\n162\t}\n163\t\n164\t// run executes talaria and captures both streams and the exit code.\n165\tfunc (h *harness) run(args ...string) result {\n166\t\th.t.Helper()\n167\t\n168\t\tcmd := exec.Command(binary, args...)\n169\t\tcmd.Env = h.env\n170\t\n171\t\tvar stdout, stderr strings.Builder\n172\t\tcmd.Stdout, cmd.Stderr = &stdout, &stderr\n173\t\n174\t\tcode := 0\n175\t\tif err := cmd.Run(); err != nil {\n176\t\t\tvar exit *exec.ExitError\n177\t\t\tif !errors.As(err, &exit) {\n178\t\t\t\th.t.Fatalf(\"running talaria %s: %v\", strings.Join(args, \" \"), err)\n179\t\t\t}\n180\t\t\tcode = exit.ExitCode()\n181\t\t}\n182\t\n183\t\treturn result{args: args, code: code, stdout: stdout.String(), stderr: stderr.String()}\n184\t}\n185\t\n186\t// runOK runs talaria and fails the test unless it exited 0. A step of a\n187\t// workflow that did not succeed makes every assertion after it meaningless, so\n188\t// this is fatal rather than an error.\n189\tfunc (h *harness) runOK(args ...string) result {\n190\t\th.t.Helper()\n191\t\n192\t\tres := h.run(args...)\n193\t\tif res.code != 0 {\n194\t\t\th.t.Fatalf(\"`%s` = %d, want 0; stderr: %s\", res.label(), res.code, res.stderr)\n195\t\t}\n196\t\n197\t\treturn res\n198\t}\n199\t\n200\t// reproduce runs the command `--dry-run` printed, in a shell holding the same\n201\t// environment talaria had, so a $TALARIA_AUTH_BEARER in it expands to the same\n202\t// credential the real call resolved.\n203\t//\n204\t// This is the only way to test what --dry-run claims. Comparing the rendered\n205\t// string against another rendering of the same request compares talaria with\n206\t// itself; only curl can say what the printed command actually sends.\n207\tfunc (h *harness) reproduce(command string) {\n208\t\th.t.Helper()\n209\t\n210\t\tcmd := exec.Command(\"sh\", \"-c\", command)\n211\t\tcmd.Env = h.env\n212\t\n213\t\tif out, err := cmd.CombinedOutput(); err != nil {\n214\t\t\th.t.Fatalf(\"running the rendered command: %v\\n%s\\n%s\", err, command, out)\n215\t\t}\n216\t}\n217\t\n218\t// written returns every file talaria left behind — the history store, the spec\n219\t// cache — as surfaces to scan. Enumerated by walking rather than by name, so a\n220\t// new persistent artifact is covered the day it appears.\n221\tfunc (h *harness) written() []canary.Surface {\n222\t\th.t.Helper()\n223\t\n224\t\tvar surfaces []canary.Surface\n225\t\tfor label, root := range map[string]string{\"history\": h.state, \"cache\": h.cache} {\n226\t\t\tfound, err := canary.Tree(label, root)\n227\t\t\tif err != nil {\n228\t\t\t\th.t.Fatalf(\"enumerating the %s surfaces: %v\", label, err)\n229\t\t\t}\n230\t\t\tsurfaces = append(surfaces, found...)\n231\t\t}\n232\t\n233\t\treturn surfaces\n234\t}\n235\t\n236\t// The bodies the test server answers with. brokenPet is the one that matters:\n237\t// it is a 200 the spec documents, carrying a body the spec's Pet schema does\n238\t// not allow — an integer id and no name — so it separates \"the server is down\"\n239\t// from \"the server disagrees with its own documentation\".\n240\tconst (\n241\t\tonePet     = `{\"id\":\"42\",\"name\":\"Rex\"}`\n242\t\tbrokenPet  = `{\"id\":7}`\n243\t\tcreatedPet = `{\"id\":\"43\",\"name\":\"Rex\"}`\n244\t)\n245\t\n246\t// recordedRequest is one request as it arrived at the test server.\n247\ttype recordedRequest struct {\n248\t\tMethod string\n249\t\tPath   string\n250\t\tHeader http.Header\n251\t\tBody   string\n252\t}\n253\t\n254\t// server is the API both specs describe.\n255\ttype server struct {\n256\t\t*httptest.Server\n257\t\n258\t\tmu       sync.Mutex\n259\t\treceived []recordedRequest"
      }
    ]
