        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"fmt\"\n5\t\t\"io\"\n6\t\t\"net/url\"\n7\t\t\"sort\"\n8\t\t\"strconv\"\n9\t\t\"strings\"\n10\t\t\"time\"\n11\t\n12\t\t\"github.com/spf13/cobra\"\n13\t\n14\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n15\t\t\"github.com/Teeeep/talaria/internal/config\"\n16\t\t\"github.com/Teeeep/talaria/internal/corpus\"\n17\t\t\"github.com/Teeeep/talaria/internal/curl\"\n18\t\t\"github.com/Teeeep/talaria/internal/operation\"\n19\t\t\"github.com/Teeeep/talaria/internal/output\"\n20\t\t\"github.com/Teeeep/talaria/internal/request\"\n21\t\t\"github.com/Teeeep/talaria/internal/secret\"\n22\t)\n23\t\n24\t// historyEntryView is one line of `history`: enough to recognise a call and its\n25\t// index, and nothing more. The whole entry is what `history show` is for.\n26\ttype historyEntryView struct {\n27\t\t// Index is the entry's position in the whole store, newest first and\n28\t\t// 1-based. It is *not* its position in a filtered list: it is the number\n29\t\t// `history show` and `history replay` take, so filtering must not renumber\n30\t\t// it.\n31\t\tIndex int `json:\"index\"`\n32\t\t// ID is the entry's stable handle, which `show` and `replay` also take. It\n33\t\t// is what an agent should keep hold of: unlike Index it does not shift when\n34\t\t// something appends, and every one of those three commands appends. An entry\n35\t\t// recorded before ids existed has none.\n36\t\tID          string    `json:\"id\"`\n37\t\tTimestamp   time.Time `json:\"timestamp\"`\n38\t\tSource      string    `json:\"source\"`\n39\t\tOperationID string    `json:\"operation_id,omitempty\"`\n40\t\tMethod      string    `json:\"method\"`\n41\t\t// Path is the URL's path, which is what identifies a call at a glance; URL\n42\t\t// carries the rest for anyone who needs it.\n43\t\tPath   string `json:\"path\"`\n44\t\tURL    string `json:\"url\"`\n45\t\tStatus int    `json:\"status,omitempty\"`\n46\t\t// TimingMS is omitted along with Status for an entry that observed no\n47\t\t// response, rather than reported as a zero that reads like a fast call.\n48\t\tTimingMS int64 `json:\"timing_ms,omitempty\"`\n49\t}\n50\t\n51\t// historyListView is the `history` payload.\n52\ttype historyListView struct {\n53\t\tEntries []historyEntryView `json:\"entries\"`\n54\t}\n55\t\n56\t// historyShowView is the `history show` payload: one entry exactly as stored,\n57\t// alongside the index it was asked for.\n58\ttype historyShowView struct {\n59\t\tIndex int          `json:\"index\"`\n60\t\tEntry corpus.Entry `json:\"entry\"`\n61\t}\n62\t\n63\t// historyFilter is the set of `history` flags, parsed. A nil field is a filter\n64\t// the caller did not ask for.\n65\ttype historyFilter struct {\n66\t\toperation string\n67\t\tsource    corpus.Source\n68\t\tsince     *time.Time\n69\t\tstatus    *statusFilter\n70\t}\n71\t\n72\t// statusFilter is `--status`: either an exact code or a class such as 4xx.\n73\ttype statusFilter struct {\n74\t\tlow, high int\n75\t}\n76\t\n77\t// matches reports whether a status falls in the filter's range.\n78\tfunc (s statusFilter) matches(status int) bool {\n79\t\treturn status >= s.low && status <= s.high\n80\t}\n81\t\n82\tfunc newHistoryCmd() *cobra.Command {\n83\t\tvar (\n84\t\t\toperationID string\n85\t\t\tsource      string\n86\t\t\tsince       string\n87\t\t\tstatus      string\n88\t\t)\n89\t\n90\t\tcmd := &cobra.Command{\n91\t\t\tUse:   \"history\",\n92\t\t\tShort: \"List what talaria has already called and what came back\",\n93\t\t\tLong: \"List the recorded request/response pairs, newest first. Everything here\\n\" +\n94\t\t\t\t\"was written redacted: a credential was never stored, so none can be read\\n\" +\n95\t\t\t\t\"back. Recording is switched off per profile with `history.enabled: false`\\n\" +\n96\t\t\t\t\"or everywhere with TALARIA_HISTORY=off.\",\n97\t\t\tArgs: usageArgs(cobra.NoArgs),\n98\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n99\t\t\t\tformat, err := resolveFormat(cmd)\n100\t\t\t\tif err != nil {\n101\t\t\t\t\treturn err\n102\t\t\t\t}\n103\t\n104\t\t\t\tfilter, err := parseHistoryFilter(operationID, source, since, status)\n105\t\t\t\tif err != nil {\n106\t\t\t\t\treturn err\n107\t\t\t\t}\n108\t\n109\t\t\t\tentries, err := loadHistory(cmd)\n110\t\t\t\tif err != nil {\n111\t\t\t\t\treturn err\n112\t\t\t\t}\n113\t\n114\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(historyPayload(entries, filter))\n115\t\t\t},\n116\t\t}\n117\t\n118\t\tcmd.Flags().StringVar(&operationID, \"operation\", \"\",\n119\t\t\t\"only entries for this operationId\")\n120\t\tcmd.Flags().StringVar(&since, \"since\", \"\",\n121\t\t\t\"only entries newer than a duration ago, e.g. 1h or 30m\")\n122\t\tcmd.Flags().StringVar(&status, \"status\", \"\",\n123\t\t\t\"only entries with this response status: an exact code (404) or a class (4xx)\")\n124\t\tcmd.Flags().StringVar(&source, \"source\", \"\",\n125\t\t\t\"only entries from this command: \"+strings.Join(historySources(), \"|\"))\n126\t\n127\t\tcmd.AddCommand(newHistoryShowCmd())\n128\t\tcmd.AddCommand(newHistoryReplayCmd())\n129\t\n130\t\treturn cmd\n131\t}\n132\t\n133\tfunc newHistoryShowCmd() *cobra.Command {\n134\t\treturn &cobra.Command{\n135\t\t\tUse:   \"show <id|n>\",\n136\t\t\tShort: \"Print one recorded request and response in full\",\n137\t\t\tLong: \"Print the whole of one entry: the request as it was sent and the response\\n\" +\n138\t\t\t\t\"as it came back, both redacted. Name the entry by the id `history` prints,\\n\" +\n139\t\t\t\t\"which is stable, or by its index, which shifts every time anything is\\n\" +\n140\t\t\t\t\"recorded.\",\n141\t\t\tArgs: usageArgs(cobra.ExactArgs(1)),\n142\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n143\t\t\t\tformat, err := resolveFormat(cmd)\n144\t\t\t\tif err != nil {\n145\t\t\t\t\treturn err\n146\t\t\t\t}\n147\t\n148\t\t\t\tentries, err := loadHistory(cmd)\n149\t\t\t\tif err != nil {\n150\t\t\t\t\treturn err\n151\t\t\t\t}\n152\t\n153\t\t\t\tindex, entry, err := selectEntry(entries, args[0])\n154\t\t\t\tif err != nil {\n155\t\t\t\t\treturn err\n156\t\t\t\t}\n157\t\n158\t\t\t\treturn output.New(format, cmd.OutOrStdout()).Render(historyShowPayload(index, entry))\n159\t\t\t},\n160\t\t}\n161\t}\n162\t\n163\tfunc newHistoryReplayCmd() *cobra.Command {\n164\t\tvar allowMutations bool\n165\t\n166\t\tcmd := &cobra.Command{\n167\t\t\tUse:   \"replay <id|n>\",\n168\t\t\tShort: \"Re-issue a recorded call\",\n169\t\t\tLong: \"Send a recorded request again, to the URL it went to, and record the\\n\" +\n170\t\t\t\t\"result as a new entry. Credentials are resolved from the environment as\\n\" +\n171\t\t\t\t\"they were the first time — history holds their names, never their values,\\n\" +\n172\t\t\t\t\"so there is nothing there to read back. Name the entry by its id: a replay\\n\" +\n173\t\t\t\t\"is itself recorded, so every index shifts as soon as one runs.\",\n174\t\t\tArgs: usageArgs(cobra.ExactArgs(1)),\n175\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n176\t\t\t\tformat, err := resolveFormat(cmd)\n177\t\t\t\tif err != nil {\n178\t\t\t\t\treturn err\n179\t\t\t\t}\n180\t\n181\t\t\t\tcfg, err := config.Load(\"\")\n182\t\t\t\tif err != nil {\n183\t\t\t\t\treturn err\n184\t\t\t\t}\n185\t\n186\t\t\t\tstore, err := openHistory(cmd, cfg)\n187\t\t\t\tif err != nil {\n188\t\t\t\t\treturn err\n189\t\t\t\t}\n190\t\n191\t\t\t\tentries, err := store.Read()\n192\t\t\t\tif err != nil {\n193\t\t\t\t\treturn err\n194\t\t\t\t}\n195\t\n196\t\t\t\t_, entry, err := selectEntry(entries, args[0])\n197\t\t\t\tif err != nil {\n198\t\t\t\t\treturn err\n199\t\t\t\t}\n200\t\n201\t\t\t\t// The same gate `call` applies, for the same reason: the method is what\n202\t\t\t\t// makes a request dangerous, and a recorded POST is still a POST.\n203\t\t\t\tif (operation.Operation{Method: entry.Method}).IsMutation() && !allowMutations {\n204\t\t\t\t\treturn clierr.Usage(\n205\t\t\t\t\t\t\"entry %s is a %s request and may change server state: pass --allow-mutations to replay it\",\n206\t\t\t\t\t\targs[0], entry.Method)\n207\t\t\t\t}\n208\t\n209\t\t\t\t// The profile is policy here, not connection detail: it is the other half\n210\t\t\t\t// of the set of credentials this replay is allowed to resolve.\n211\t\t\t\tprof, err := selectProfile(cmd, cfg)\n212\t\t\t\tif err != nil {\n213\t\t\t\t\treturn err\n214\t\t\t\t}\n215\t\n216\t\t\t\treq, err := replayRequest(cmd.ErrOrStderr(), entry, prof)\n217\t\t\t\tif err != nil {\n218\t\t\t\t\treturn err\n219\t\t\t\t}\n220\t\n221\t\t\t\trenderer := output.New(format, cmd.OutOrStdout())\n222\t\t\t\tredactors := newRedactors(cfg)\n223\t\n224\t\t\t\tresp, execErr := curl.Execute(cmd.Context(), req)\n225\t\t\t\trecordCall(cmd.ErrOrStderr(), store, corpus.SourceReplay, req, resp, redactors)\n226\t\t\t\tif execErr != nil {\n227\t\t\t\t\treturn execErr\n228\t\t\t\t}\n229\t\n230\t\t\t\t// No validation block: replay reads a recorded request and needs no\n231\t\t\t\t// spec to send one, so there is no contract here to check against.\n232\t\t\t\treturn renderer.Render(callPayload(req, redactResponse(resp, redactors.Response), nil))\n233\t\t\t},\n234\t\t}\n235\t\n236\t\tcmd.Flags().BoolVar(&allowMutations, \"allow-mutations\", false,\n237\t\t\t\"permit replaying a method other than GET, HEAD or OPTIONS\")\n238\t\n239\t\treturn cmd\n240\t}\n241\t\n242\t// openHistory builds the store with the recording setting the selected profile\n243\t// asks for. Reading never consults it — history written before recording was\n244\t// switched off is still history — but replay writes, so it has to be right.\n245\tfunc openHistory(cmd *cobra.Command, cfg *config.Config) (*corpus.Store, error) {\n246\t\tprof, err := selectProfile(cmd, cfg)\n247\t\tif err != nil {\n248\t\t\treturn nil, err\n249\t\t}\n250\t\n251\t\t// The empty dir is the default state directory; internal/corpus locates it.\n252\t\treturn corpus.New(\"\", prof.HistoryEnabled()), nil\n253\t}\n254\t\n255\t// loadHistory loads the store for a read-only command. The profile still\n256\t// decides the Enabled flag so the store is constructed the one way, but nothing\n257\t// on this path writes.\n258\tfunc loadHistory(cmd *cobra.Command) ([]corpus.Entry, error) {\n259\t\tcfg, err := config.Load(\"\")\n260\t\tif err != nil {\n261\t\t\treturn nil, err\n262\t\t}\n263\t\n264\t\tstore, err := openHistory(cmd, cfg)\n265\t\tif err != nil {\n266\t\t\treturn nil, err\n267\t\t}\n268\t\n269\t\treturn store.Read()\n270\t}\n271\t\n272\t// historyPayload renders the store newest first, keeping the entries the filter\n273\t// admits and the index each had before filtering.\n274\tfunc historyPayload(entries []corpus.Entry, filter historyFilter) output.Payload {\n275\t\tview := historyListView{Entries: []historyEntryView{}}\n276\t\trows := [][]string{}\n277\t\n278\t\t// The store is oldest first, so walking it backwards is both the display\n279\t\t// order and the index order.\n280\t\tfor i := len(entries) - 1; i >= 0; i-- {\n281\t\t\tentry := entries[i]\n282\t\t\tif !filter.admits(entry) {\n283\t\t\t\tcontinue\n284\t\t\t}\n285\t\n286\t\t\tline := newHistoryEntryView(len(entries)-i, entry)\n287\t\t\tview.Entries = append(view.Entries, line)\n288\t\t\trows = append(rows, []string{\n289\t\t\t\tstrconv.Itoa(line.Index),\n290\t\t\t\tidCell(line.ID),\n291\t\t\t\tline.Timestamp.Format(time.RFC3339),\n292\t\t\t\tstring(line.Source),\n293\t\t\t\tline.Method,\n294\t\t\t\tline.Path,\n295\t\t\t\tstatusCell(line.Status),\n296\t\t\t\tline.OperationID,\n297\t\t\t})\n298\t\t}\n299\t\n300\t\treturn output.Payload{\n301\t\t\tData: view,\n302\t\t\tTable: output.Table{\n303\t\t\t\tHeaders: []string{\"#\", \"ID\", \"WHEN\", \"SOURCE\", \"METHOD\", \"PATH\", \"STATUS\", \"OPERATION\"},\n304\t\t\t\tRows:    rows,\n305\t\t\t},\n306\t\t}\n307\t}\n308\t\n309\tfunc newHistoryEntryView(index int, entry corpus.Entry) historyEntryView {\n310\t\tview := historyEntryView{\n311\t\t\tIndex:       index,\n312\t\t\tID:          entry.ID,\n313\t\t\tTimestamp:   entry.Timestamp,\n314\t\t\tSource:      string(entry.Source),\n315\t\t\tOperationID: entry.OperationID,\n316\t\t\tMethod:      entry.Method,\n317\t\t\tPath:        urlPath(entry.URL),\n318\t\t\tURL:         entry.URL,\n319\t\t}\n320\t\tif entry.Response != nil {\n321\t\t\tview.Status = entry.Response.Status\n322\t\t\tview.TimingMS = entry.Response.TimingMS\n323\t\t}\n324\t\n325\t\treturn view\n326\t}\n327\t\n328\tfunc historyShowPayload(index int, entry corpus.Entry) output.Payload {\n329\t\trows := [][]string{\n330\t\t\t{entry.Method + \" \" + entry.URL},\n331\t\t}\n332\t\tfor _, name := range sortedKeys(entry.Request.Headers) {\n333\t\t\trows = append(rows, []string{name + \": \" + entry.Request.Headers[name]})\n334\t\t}\n335\t\tif entry.Request.Body != nil {\n336\t\t\trows = append(rows, []string{bodyLine(entry.Request.Body)})\n337\t\t}\n338\t\tif entry.Response != nil {\n339\t\t\trows = append(rows, []string{fmt.Sprintf(\"%d in %dms\", entry.Response.Status, entry.Response.TimingMS)})\n340\t\t\tif entry.Response.Body != nil {\n341\t\t\t\trows = append(rows, []string{bodyLine(entry.Response.Body)})\n342\t\t\t}\n343\t\t}\n344\t\n345\t\treturn output.Payload{\n346\t\t\tData:  historyShowView{Index: index, Entry: entry},\n347\t\t\tTable: output.Table{Rows: rows},\n348\t\t}\n349\t}\n350\t\n351\t// bodyLine renders a recorded body for a human. A body with no encoding is the\n352\t// text that was sent and prints as itself; anything else is not text, and\n353\t// printing its stored form would claim bytes went on the wire that did not. The\n354\t// summary says how big it was and how to get at it — `--output json` carries the\n355\t// entry as recorded, encoding and all.\n356\tfunc bodyLine(body *corpus.Body) string {\n357\t\tif body.Encoding == \"\" {\n358\t\t\treturn body.Data\n359\t\t}\n360\t\n361\t\tdata, err := body.Bytes()\n362\t\tif err != nil {\n363\t\t\treturn fmt.Sprintf(\"<body with unreadable %s encoding: %v>\", body.Encoding, err)\n364\t\t}\n365\t\n366\t\treturn fmt.Sprintf(\"<binary body, %d bytes, %s in --output json>\", len(data), body.Encoding)\n367\t}\n368\t\n369\t// statusCell renders the status column, which is empty for an entry that\n370\t// observed no response rather than a 0 nobody's server returned.\n371\tfunc statusCell(status int) string {\n372\t\tif status == 0 {\n373\t\t\treturn \"-\"\n374\t\t}\n375\t\n376\t\treturn strconv.Itoa(status)\n377\t}\n378\t\n379\t// idCell renders the id column. An entry recorded before ids existed has none,\n380\t// and prints as the same dash an absent status does rather than as a blank cell\n381\t// a reader could mistake for a column that failed to render.\n382\tfunc idCell(id string) string {\n383\t\tif id == \"\" {\n384\t\t\treturn \"-\"\n385\t\t}\n386\t\n387\t\treturn id\n388\t}\n389\t\n390\t// urlPath is the path component of a recorded URL, for the list's path column.\n391\t// A URL that will not parse — nothing writes one, but the store is a file on\n392\t// disk — degrades to itself rather than to nothing.\n393\tfunc urlPath(raw string) string {\n394\t\tparsed, err := url.Parse(raw)\n395\t\tif err != nil {\n396\t\t\treturn raw\n397\t\t}\n398\t\n399\t\treturn parsed.EscapedPath()\n400\t}\n401\t\n402\t// selectEntry resolves what `show` and `replay` are given: an entry's stable id,\n403\t// or a 1-based, newest-first positional index.\n404\t//\n405\t// The id is tried first and wins outright. An index is recomputed on every read\n406\t// and shifts as soon as anything appends — and `call`, `run` and `replay` all\n407\t// append, replay included — so `replay 2` followed by `replay 1` re-issues the\n408\t// same entry twice. The id is what makes two commands in a row mean two entries.\n409\t// The index stays supported because it is documented and is what a human reads\n410\t// off the list.\n411\t//\n412\t// Every failure is a usage error carrying what the caller can do instead: the\n413\t// valid range, or the fact that there is no history yet. An agent that guessed\n414\t// corrects itself from the message without a second command.\n415\tfunc selectEntry(entries []corpus.Entry, arg string) (int, corpus.Entry, error) {\n416\t\t// Newest first, so an id that a hand-edited store repeats resolves to the\n417\t\t// same entry the index would.\n418\t\tif arg != \"\" {\n419\t\t\tfor i := len(entries) - 1; i >= 0; i-- {\n420\t\t\t\tif entries[i].ID == arg {\n421\t\t\t\t\treturn len(entries) - i, entries[i], nil\n422\t\t\t\t}\n423\t\t\t}\n424\t\t}\n425\t\n426\t\tindex, err := strconv.Atoi(arg)\n427\t\tif err != nil {\n428\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\n429\t\t\t\t\"no history entry %q: give an id from the ID column, or an entry's 1-based index\", arg)\n430\t\t}\n431\t\n432\t\tif len(entries) == 0 {\n433\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\"no history entry %d: the history is empty\", index)\n434\t\t}\n435\t\tif index < 1 || index > len(entries) {\n436\t\t\treturn 0, corpus.Entry{}, clierr.Usage(\n437\t\t\t\t\"no history entry %d: the valid range is 1-%d\", index, len(entries))\n438\t\t}\n439\t\n440\t\treturn index, entries[len(entries)-index], nil\n441\t}\n442\t\n443\t// admits reports whether an entry survives every filter that was asked for.\n444\tfunc (f historyFilter) admits(entry corpus.Entry) bool {\n445\t\tif f.operation != \"\" && entry.OperationID != f.operation {\n446\t\t\treturn false\n447\t\t}\n448\t\tif f.source != \"\" && entry.Source != f.source {\n449\t\t\treturn false\n450\t\t}\n451\t\tif f.since != nil && entry.Timestamp.Before(*f.since) {\n452\t\t\treturn false\n453\t\t}\n454\t\tif f.status != nil {\n455\t\t\t// An entry with no response has no status to match, so a status filter\n456\t\t\t// excludes it rather than matching it as a zero.\n457\t\t\tif entry.Response == nil || !f.status.matches(entry.Response.Status) {\n458\t\t\t\treturn false\n459\t\t\t}\n460\t\t}\n461\t\n462\t\treturn true\n463\t}\n464\t\n465\t// parseHistoryFilter turns the flags into a filter, failing with exit 2 on\n466\t// anything it cannot read. Parsing happens before the store is opened so a\n467\t// typo is reported without touching the disk.\n468\tfunc parseHistoryFilter(operationID, source, since, status string) (historyFilter, error) {\n469\t\tfilter := historyFilter{operation: operationID}\n470\t\n471\t\tif source != \"\" {\n472\t\t\tparsed, err := parseSource(source)\n473\t\t\tif err != nil {\n474\t\t\t\treturn historyFilter{}, err\n475\t\t\t}\n476\t\t\tfilter.source = parsed\n477\t\t}\n478\t\n479\t\tif since != \"\" {\n480\t\t\tage, err := time.ParseDuration(since)\n481\t\t\tif err != nil || age < 0 {\n482\t\t\t\treturn historyFilter{}, clierr.Usage(\n483\t\t\t\t\t\"cannot read --since %q: give a duration such as 30m, 1h or 7d as 168h\", since)\n484\t\t\t}\n485\t\t\tcutoff := time.Now().Add(-age)\n486\t\t\tfilter.since = &cutoff\n487\t\t}\n488\t\n489\t\tif status != \"\" {\n490\t\t\tparsed, err := parseStatusFilter(status)\n491\t\t\tif err != nil {\n492\t\t\t\treturn historyFilter{}, err\n493\t\t\t}\n494\t\t\tfilter.status = parsed\n495\t\t}\n496\t\n497\t\treturn filter, nil\n498\t}\n499\t\n500\t// parseSource reads --source, offering the valid values on a miss.\n501\tfunc parseSource(value string) (corpus.Source, error) {\n502\t\tfor _, source := range historySources() {\n503\t\t\tif strings.EqualFold(value, source) {\n504\t\t\t\treturn corpus.Source(source), nil\n505\t\t\t}\n506\t\t}\n507\t\n508\t\treturn \"\", clierr.Usage(\"no history source %q\", value).WithAlternatives(historySources()...)\n509\t}\n510\t\n511\t// historySources is the set of commands that write to the store, in the order\n512\t// they are worth reading about.\n513\tfunc historySources() []string {\n514\t\treturn []string{string(corpus.SourceCall), string(corpus.SourceRun), string(corpus.SourceReplay)}\n515\t}\n516\t\n517\t// parseStatusFilter reads --status: an exact code, or a class with x in place\n518\t// of the digits that vary.\n519\tfunc parseStatusFilter(value string) (*statusFilter, error) {\n520\t\tconst bad = \"cannot read --status %q: give an exact code such as 404 or a class such as 4xx\"\n521\t\n522\t\ttrimmed := strings.ToLower(strings.TrimSpace(value))\n523\t\tif len(trimmed) != 3 {\n524\t\t\treturn nil, clierr.Usage(bad, value)\n525\t\t}\n526\t\n527\t\tif strings.HasSuffix(trimmed, \"xx\") {\n528\t\t\tclass, err := strconv.Atoi(trimmed[:1])\n529\t\t\tif err != nil || class < 1 || class > 9 {\n530\t\t\t\treturn nil, clierr.Usage(bad, value)\n531\t\t\t}\n532\t\n533\t\t\treturn &statusFilter{low: class * 100, high: class*100 + 99}, nil\n534\t\t}\n535\t\n536\t\tcode, err := strconv.Atoi(trimmed)\n537\t\tif err != nil {\n538\t\t\treturn nil, clierr.Usage(bad, value)\n539\t\t}\n540\t\n541\t\treturn &statusFilter{low: code, high: code}, nil\n542\t}\n543\t\n544\t// replayRequest rebuilds a runnable request from a stored entry.\n545\t//\n546\t// Every credential position in the entry holds `<redacted:env:NAME>`, which\n547\t// becomes a reference again here — the value is resolved from the environment\n548\t// at exec time, exactly as it was on the original call. Nothing in this function\n549\t// reads a credential, because there is none in the store to read (§5a).\n550\t//\n551\t// prof is the profile in force, and is policy rather than data: it decides,\n552\t// with the TALARIA_AUTH_* convention, which variable names the store is allowed\n553\t// to ask for. See replayableEnv.\n554\tfunc replayRequest(stderr io.Writer, entry corpus.Entry, prof *config.Profile) (*request.Request, error) {\n555\t\t// The store is a file on disk, so what it holds is checked on the way out as\n556\t\t// well as on the way in: an edited entry must not be able to replay as a\n557\t\t// file read or a raw TCP write, nor to smuggle a credential into a URL that\n558\t\t// every later surface prints whole. Both checks come before the parse error\n559\t\t// below, which quotes the URL it could not read.\n560\t\tif host, ok := request.Userinfo(entry.URL); ok {\n561\t\t\treturn nil, clierr.Usage(\n562\t\t\t\t\"the recorded URL for %s carries a credential in its userinfo, so it will not be replayed; \"+\n563\t\t\t\t\t\"re-run the call with %s=user:password set instead\", host, config.EnvBasic)\n564\t\t}\n565\t\n566\t\tparsed, err := url.Parse(entry.URL)\n567\t\tif err != nil {\n568\t\t\treturn nil, clierr.Usage(\"the recorded URL %q cannot be parsed: %v\", entry.URL, err)\n569\t\t}\n570\t\tif !request.IsHTTPScheme(parsed.Scheme) {\n571\t\t\treturn nil, clierr.Usage(\"the recorded URL %q has scheme %q; only http and https can be replayed\",\n572\t\t\t\tentry.URL, parsed.Scheme)\n573\t\t}\n574\t\n575\t\treq := &request.Request{\n576\t\t\tOperationID: entry.OperationID,\n577\t\t\tMethod:      entry.Method,\n578\t\t\tBaseURL:     parsed.Scheme + \"://\" + parsed.Host,\n579\t\t\tPath:        parsed.EscapedPath(),\n580\t\t}\n581\t\n582\t\treq.Query, err = replayQuery(stderr, parsed.RawQuery, prof)\n583\t\tif err != nil {\n584\t\t\treturn nil, err\n585\t\t}\n586\t\treq.Headers, err = replayPairs(stderr, \"header\", entry.Request.Headers, prof)\n587\t\tif err != nil {\n588\t\t\treturn nil, err\n589\t\t}\n590\t\treq.Cookies, err = replayPairs(stderr, \"cookie\", entry.Request.Cookies, prof)\n591\t\tif err != nil {\n592\t\t\treturn nil, err\n593\t\t}\n594\t\n595\t\tif body := entry.Request.Body; body != nil {\n596\t\t\tif body.Truncated {\n597\t\t\t\treturn nil, clierr.Usage(\n598\t\t\t\t\t\"the recorded request body was truncated at %d bytes, so replaying it would send something the original did not\",\n599\t\t\t\t\tcorpus.MaxBody)\n600\t\t\t}\n601\t\t\tdata, err := body.Bytes()\n602\t\t\tif err != nil {\n603\t\t\t\treturn nil, err\n604\t\t\t}\n605\t\t\treq.Body = &request.Body{ContentType: body.ContentType, Data: data}\n606\t\t}\n607\t\n608\t\treturn req, nil\n609\t}\n610\t\n611\t// replayQuery rebuilds the query parameters in the order they were recorded.\n612\t// The raw string is walked rather than url.ParseQuery'd because a map would lose\n613\t// that order, and a replay that reorders the query string is not the same\n614\t// request.\n615\tfunc replayQuery(stderr io.Writer, raw string, prof *config.Profile) ([]request.Pair, error) {\n616\t\tvar pairs []request.Pair\n617\t\n618\t\tfor _, field := range strings.Split(raw, \"&\") {\n619\t\t\tif field == \"\" {\n620\t\t\t\tcontinue\n621\t\t\t}\n622\t\n623\t\t\trawName, rawValue, _ := strings.Cut(field, \"=\")\n624\t\t\tname, err := url.QueryUnescape(rawName)\n625\t\t\tif err != nil {\n626\t\t\t\treturn nil, clierr.Usage(\"the recorded query parameter %q cannot be parsed: %v\", rawName, err)\n627\t\t\t}\n628\t\t\tvalue, err := url.QueryUnescape(rawValue)\n629\t\t\tif err != nil {\n630\t\t\t\treturn nil, clierr.Usage(\"the recorded value of query parameter %q cannot be parsed: %v\", name, err)\n631\t\t\t}\n632\t\n633\t\t\treplayed, ok, err := replayValue(value, prof, \"query parameter\", name)\n634\t\t\tif err != nil {\n635\t\t\t\treturn nil, err\n636\t\t\t}\n637\t\t\tif !ok {\n638\t\t\t\twarnUnreplayable(stderr, \"query parameter\", name)\n639\t\t\t\tcontinue\n640\t\t\t}\n641\t\t\tpairs = append(pairs, request.Pair{Name: name, Value: replayed})\n642\t\t}\n643\t\n644\t\treturn pairs, nil\n645\t}\n646\t\n647\t// replayPairs rebuilds headers or cookies. The stored form is a map, so the\n648\t// order is gone and is restored as sorted-by-name: emitted curl and the config\n649\t// document both have to be deterministic, and byte-for-byte header order is not\n650\t// something an HTTP request depends on.\n651\tfunc replayPairs(stderr io.Writer, kind string, stored map[string]string, prof *config.Profile) ([]request.Pair, error) {\n652\t\tvar pairs []request.Pair\n653\t\n654\t\tfor _, name := range sortedKeys(stored) {\n655\t\t\tvalue, ok, err := replayValue(stored[name], prof, kind, name)\n656\t\t\tif err != nil {\n657\t\t\t\treturn nil, err\n658\t\t\t}\n659\t\t\tif !ok {\n660\t\t\t\twarnUnreplayable(stderr, kind, name)\n661\t\t\t\tcontinue\n662\t\t\t}\n663\t\t\tpairs = append(pairs, request.Pair{Name: name, Value: value})\n664\t\t}\n665\t\n666\t\treturn pairs, nil\n667\t}\n668\t\n669\t// replayValue turns one stored value back into a request Value, reporting\n670\t// false for one that cannot be reproduced and an error for one it refuses.\n671\t//\n672\t// A `<redacted:env:NAME>` — with or without a scheme prefix — becomes a\n673\t// reference to the same variable, provided replayableEnv admits the name. A\n674\t// bare `<redacted>` is a value the name-based matcher caught: a literal the\n675\t// user typed, which was deliberately not written down and so cannot come back.\n676\t// That is the firewall working, not a bug, and the caller says so on stderr\n677\t// rather than silently sending a request missing a header the original had.\n678\t//\n679\t// kind and name describe the field this value stood in; they are only used to\n680\t// say which one was refused.\n681\tfunc replayValue(stored string, prof *config.Profile, kind, name string) (request.Value, bool, error) {\n682\t\tif stored == secret.Placeholder {\n683\t\t\treturn request.Value{}, false, nil\n684\t\t}\n685\t\n686\t\t// Longest prefix first, so the raw encoding's empty prefix is the fallback\n687\t\t// rather than the first match.\n688\t\tfor _, enc := range []request.Encoding{request.EncodeBearer, request.EncodeBasic, request.EncodeRaw} {\n689\t\t\tprefix := encodingPrefix(enc)\n690\t\t\tif prefix != \"\" && !strings.HasPrefix(stored, prefix) {\n691\t\t\t\tcontinue\n692\t\t\t}\n693\t\n694\t\t\tif ref, ok := secret.ParseRef(strings.TrimPrefix(stored, prefix)); ok {\n695\t\t\t\tif !replayableEnv(prof, ref) {\n696\t\t\t\t\t// Not a fall-through to Literal: that would put the string\n697\t\t\t\t\t// `<redacted:env:NAME>` itself on the wire, which is neither what was\n698\t\t\t\t\t// recorded nor anything the user asked for.\n699\t\t\t\t\treturn request.Value{}, false, clierr.Usage(\n700\t\t\t\t\t\t\"the recorded %s %q asks for %s, which is outside the credentials replay resolves; \"+\n701\t\t\t\t\t\t\t\"only %s, %s, %s* and the variables the selected profile's auth map names are replayed\",\n702\t\t\t\t\t\tkind, name, ref.Location(), config.EnvBearer, config.EnvBasic, config.EnvAPIKeyPrefix)\n703\t\t\t\t}\n704\t\n705\t\t\t\treturn request.Secret(ref, enc), true, nil\n706\t\t\t}\n707\t\t}\n708\t\n709\t\treturn request.Literal(stored), true, nil\n710\t}\n711\t\n712\t// replayableEnv is the allowlist of credentials `history replay` may resolve.\n713\t//\n714\t// The store is a plain JSONL file, so the name in `<redacted:env:NAME>` is an\n715\t// instruction something with write access to that file chose, and the URL it\n716\t// would be sent to comes from the same line. Resolving any name at all would\n717\t// make talaria a \"read $ANY_VAR and send it to $ANY_URL\" primitive, run from\n718\t// the one process the deployment trusts with credentials — the opposite of what\n719\t// §5a claims. So the set is exactly what talaria itself records: the\n720\t// TALARIA_AUTH_* convention, and the variables the profile in force names.\n721\tfunc replayableEnv(prof *config.Profile, ref secret.SecretRef) bool {\n722\t\tif ref.Source != secret.SourceEnv {\n723\t\t\treturn false\n724\t\t}\n725\t\n726\t\tswitch {\n727\t\tcase ref.Name == config.EnvBearer, ref.Name == config.EnvBasic:\n728\t\t\treturn true\n729\t\tcase strings.HasPrefix(ref.Name, config.EnvAPIKeyPrefix):\n730\t\t\treturn true\n731\t\t}\n732\t\n733\t\treturn prof.ReferencesEnv(ref.Name)\n734\t}\n735\t\n736\t// encodingPrefix is the text a scheme puts in front of a credential — \"Bearer \"\n737\t// and the rest. It is asked of internal/request rather than repeated here, so\n738\t// the two cannot drift apart.\n739\tfunc encodingPrefix(enc request.Encoding) string {\n740\t\treturn request.Secret(secret.SecretRef{}, enc).Prefix()\n741\t}\n742\t\n743\t// warnUnreplayable reports a field the replay had to drop. It is a warning\n744\t// rather than a failure: the request is still worth making, and a 401 with an\n745\t// explanation on stderr is more useful than a refusal.\n746\tfunc warnUnreplayable(stderr io.Writer, kind, name string) {\n747\t\tfmt.Fprintf(stderr,\n748\t\t\t\"warning: the recorded %s %q held a redacted literal, which history does not store; replaying without it\\n\",\n749\t\t\tkind, name)\n750\t}\n751\t\n752\t// sortedKeys is the deterministic iteration order for the maps a stored entry\n753\t// holds.\n754\tfunc sortedKeys(m map[string]string) []string {\n755\t\tnames := make([]string, 0, len(m))\n756\t\tfor name := range m {\n757\t\t\tnames = append(names, name)\n758\t\t}\n759\t\tsort.Strings(names)\n760\t\n761\t\treturn names\n762\t}\n763\t"
      }
