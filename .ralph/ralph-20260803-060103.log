    "content": [
      {
        "tool_use_id": "toolu_01CWeu31qEjwhKAqm1ov5wDy",
        "type": "tool_result",
        "content": "1\t// Package request holds the HTTP request talaria is about to make. It is the\n2\t// type DESIGN.md §5a says the credential firewall shapes: every field that\n3\t// could carry a credential holds a Value, and a Value is either a literal\n4\t// string or a secret.SecretRef — never a resolved credential.\n5\t//\n6\t// Everything downstream reads this type: symbolic curl rendering, the curl\n7\t// config document, JSON output, history and the corpus. If it could hold a bare\n8\t// secret string, each of those would become a leak channel, so it cannot.\n9\t// Reading the actual credential is one call to Value.Resolve, made by\n10\t// internal/curl at exec time and nowhere else.\n11\tpackage request\n12\t\n13\timport (\n14\t\t\"encoding/json\"\n15\t\t\"net/url\"\n16\t\t\"strings\"\n17\t\n18\t\t\"github.com/Teeeep/talaria/internal/secret\"\n19\t)\n20\t\n21\t// Encoding says how a Value's credential becomes the text of the field it sits\n22\t// in. It exists because a bearer token is not sent verbatim — the header reads\n23\t// `Bearer <token>` — and the prefix has to survive into rendering without the\n24\t// renderer having to know which scheme produced the value.\n25\ttype Encoding string\n26\t\n27\tconst (\n28\t\t// EncodeRaw sends the value as it stands. Literals and API keys use it.\n29\t\tEncodeRaw Encoding = \"\"\n30\t\t// EncodeBearer sends `Bearer ` followed by the value (RFC 6750).\n31\t\tEncodeBearer Encoding = \"bearer\"\n32\t\t// EncodeBasic sends `Basic ` followed by base64(user:password). The base64\n33\t\t// needs the value, so only a resolving renderer can produce the header text;\n34\t\t// internal/curl renders it as curl's own -u instead, which keeps it symbolic.\n35\t\tEncodeBasic Encoding = \"basic\"\n36\t)\n37\t\n38\t// Value is one header, query or cookie value: either a literal or a reference\n39\t// to a credential, never both and never a resolved secret. It is a struct\n40\t// rather than an interface so it marshals, compares and prints as one thing.\n41\t//\n42\t// The zero Value is an empty literal.\n43\ttype Value struct {\n44\t\tliteral string\n45\t\tref     secret.SecretRef\n46\t\tenc     Encoding\n47\t\t// sensitive hides a literal from every display form. A referenced\n48\t\t// credential needs no such flag: it has no value to hide.\n49\t\tsensitive bool\n50\t}\n51\t\n52\t// Literal returns a Value holding text the user supplied directly.\n53\tfunc Literal(s string) Value { return Value{literal: s} }\n54\t\n55\t// Secret returns a Value naming a credential, encoded per enc.\n56\tfunc Secret(ref secret.SecretRef, enc Encoding) Value { return Value{ref: ref, enc: enc} }\n57\t\n58\t// Sensitive returns a copy of v that displays as `<redacted>` everywhere a\n59\t// Value is displayed, while still going on the wire unchanged.\n60\t//\n61\t// It is what a literal sitting under a credential-shaped name becomes: a token\n62\t// the user typed into `--header Authorization: …` is as sensitive as one\n63\t// talaria resolved itself (§5a's built-in list, which \"applies to pretty output\n64\t// too\"). Marking the Value rather than scrubbing each renderer is the point —\n65\t// §5a's architecture consequence is that a surface has to *ask* for a secret to\n66\t// leak one, and there is no way to ask a Value for a hidden literal except\n67\t// Reveal.\n68\tfunc (v Value) Sensitive() Value {\n69\t\tv.sensitive = true\n70\t\n71\t\treturn v\n72\t}\n73\t\n74\t// IsSecret reports whether this value names a credential.\n75\tfunc (v Value) IsSecret() bool { return !v.ref.IsZero() }\n76\t\n77\t// IsSensitive reports whether this value is hidden from display: every secret\n78\t// is, and so is a literal marked by Sensitive.\n79\tfunc (v Value) IsSensitive() bool { return v.sensitive || v.IsSecret() }\n80\t\n81\t// Ref returns the credential this value names, or the zero SecretRef for a\n82\t// literal. The ref is safe to print: it holds a name, not a value.\n83\tfunc (v Value) Ref() secret.SecretRef { return v.ref }\n84\t\n85\t// Encoding returns how this value becomes field text, so internal/curl can pick\n86\t// the right directive without re-deriving it from the scheme.\n87\tfunc (v Value) Encoding() Encoding { return v.enc }\n88\t\n89\t// String is the display form: the literal as-is, or the encoding prefix\n90\t// followed by `<redacted:env:NAME>`. It is what JSON output, pretty output and\n91\t// history show, and it is safe under every printf verb because SecretRef is.\n92\tfunc (v Value) String() string {\n93\t\tif !v.IsSecret() {\n94\t\t\tif v.sensitive {\n95\t\t\t\treturn secret.Placeholder\n96\t\t\t}\n97\t\n98\t\t\treturn v.literal\n99\t\t}\n100\t\n101\t\treturn v.Prefix() + v.ref.String()\n102\t}\n103\t\n104\t// Reveal returns the literal text this value carries, hidden or not. It exists\n105\t// for the one renderer that builds curl's config document: a sensitive literal\n106\t// still has to go on the wire, and String no longer returns it.\n107\t//\n108\t// For a value naming a credential it returns the redacted display form.\n109\t// Reading a real credential is SecretRef.Resolve, in internal/curl at exec\n110\t// time, and this is not that.\n111\tfunc (v Value) Reveal() string {\n112\t\tif v.IsSecret() {\n113\t\t\treturn v.String()\n114\t\t}\n115\t\n116\t\treturn v.literal\n117\t}\n118\t\n119\t// GoString keeps %#v — the verb reached for when debugging, i.e. exactly when a\n120\t// leak would be least expected — as safe as %v.\n121\tfunc (v Value) GoString() string { return v.String() }\n122\t\n123\t// MarshalJSON renders the display form, so any JSON carrying a credential\n124\t// position carries the redacted name instead of a value.\n125\tfunc (v Value) MarshalJSON() ([]byte, error) { return json.Marshal(v.String()) }\n126\t\n127\t// Symbolic is the form for emitted and dry-run curl: `Bearer $TALARIA_AUTH_BEARER`,\n128\t// runnable wherever the variable is set and useless to exfiltrate (§5a).\n129\t//\n130\t// EncodeBasic has no symbolic header form — the value must be base64-encoded\n131\t// before it goes in the header — so it falls back to the redacted form. The\n132\t// emitted command stays correct because internal/curl renders basic auth with\n133\t// curl's -u, which takes the raw `user:password` and can stay symbolic.\n134\tfunc (v Value) Symbolic() string {\n135\t\tif !v.IsSecret() || v.enc == EncodeBasic {\n136\t\t\treturn v.String()\n137\t\t}\n138\t\n139\t\treturn v.Prefix() + v.ref.Symbolic()\n140\t}\n141\t\n142\t// Prefix is the literal text that precedes the credential in the field, e.g.\n143\t// \"Bearer \" for a token. It is exported because internal/curl builds the\n144\t// resolved field text at exec time and would otherwise have to re-derive the\n145\t// prefix from the scheme — the duplication §5a's single-crossing rule exists to\n146\t// avoid.\n147\tfunc (v Value) Prefix() string {\n148\t\tswitch v.enc {\n149\t\tcase EncodeBearer:\n150\t\t\treturn \"Bearer \"\n151\t\tcase EncodeBasic:\n152\t\t\treturn \"Basic \"\n153\t\tdefault:\n154\t\t\treturn \"\"\n155\t\t}\n156\t}\n157\t\n158\t// Render turns a Value into the text that goes on the wire, in a URL, or on\n159\t// screen. Making it a parameter rather than a method is what keeps resolution\n160\t// out of this package: Redacted and Symbolic live here, and the one renderer\n161\t// that reads credentials is internal/curl's, at exec time.\n162\ttype Render func(Value) (string, error)\n163\t\n164\t// Redacted renders credentials as `<redacted:env:NAME>`. It is the default for\n165\t// every surface a user or agent reads.\n166\tfunc Redacted(v Value) (string, error) { return v.String(), nil }\n167\t\n168\t// Symbolic renders credentials as `$NAME`, for copy-pasteable curl.\n169\tfunc Symbolic(v Value) (string, error) { return v.Symbolic(), nil }\n170\t\n171\t// Pair is one named value on the request: a header, a query parameter or a\n172\t// cookie. Pairs are ordered slices rather than maps because repetition is legal\n173\t// for all three and because a stable order makes emitted curl reproducible.\n174\ttype Pair struct {\n175\t\tName  string `json:\"name\"`\n176\t\tValue Value  `json:\"value\"`\n177\t}\n178\t\n179\t// Body is the request body: the bytes --body resolved to, and the media type\n180\t// they will be sent as. Data is already the final bytes — the Go process reads\n181\t// a file or stdin before curl exists, so nothing downstream has to open\n182\t// anything (DESIGN.md §5a).\n183\ttype Body struct {\n184\t\tContentType string\n185\t\tData        []byte\n186\t}\n187\t\n188\t// MarshalJSON renders the body as text alongside its content type.\n189\tfunc (b Body) MarshalJSON() ([]byte, error) {\n190\t\treturn json.Marshal(struct {\n191\t\t\tContentType string `json:\"content_type\"`\n192\t\t\tData        string `json:\"data\"`\n193\t\t}{b.ContentType, string(b.Data)})\n194\t}\n195\t\n196\t// IsHTTPScheme reports whether scheme is one talaria will make a request with.\n197\t//\n198\t// curl also speaks file, gopher, dict, smb and a dozen others, so an unchecked\n199\t// scheme turns \"call this operation\" into a local file read or a raw write to\n200\t// an arbitrary TCP port. Every URL talaria assembles comes from untrusted input\n201\t// — a spec's servers[0].url, a profile, a stored history entry — so the check\n202\t// belongs at each of those boundaries, not only on the flag a user typed.\n203\t//\n204\t// Schemes are case-insensitive per RFC 3986 §3.1, so HTTPS:// is accepted.\n205\tfunc IsHTTPScheme(scheme string) bool {\n206\t\tswitch strings.ToLower(scheme) {\n207\t\tcase \"http\", \"https\":\n208\t\t\treturn true\n209\t\t}\n210\t\n211\t\treturn false\n212\t}\n213\t\n214\t// Userinfo reports whether raw carries a `user:password@` before its host, and\n215\t// returns the host it precedes so a refusal can name where the URL pointed\n216\t// without quoting what it carried.\n217\t//\n218\t// Userinfo is the one credential position a URL has no symbolic form for: a\n219\t// base URL is copied whole into request.url, into the emitted curl and into the\n220\t// history store, all of which are read back later, so a credential written\n221\t// there is a credential in cleartext forever (§5a). Every source is untrusted —\n222\t// a flag, a profile, a spec's servers[0].url, a stored entry — so the check\n223\t// belongs at each of those boundaries.\n224\t//\n225\t// It reads the text rather than url.Parse's User field so that a URL too\n226\t// malformed to parse is covered too: the parse error quotes the whole string,\n227\t// and a check that ran after it would have nothing left to protect. Only a URL\n228\t// with an authority can have userinfo, hence the `://` requirement; anything\n229\t// else is left to IsHTTPScheme to refuse.\n230\tfunc Userinfo(raw string) (host string, present bool) {\n231\t\t_, authority, ok := strings.Cut(raw, \"://\")\n232\t\tif !ok {\n233\t\t\treturn \"\", false\n234\t\t}\n235\t\tif end := strings.IndexAny(authority, \"/?#\"); end >= 0 {\n236\t\t\tauthority = authority[:end]\n237\t\t}\n238\t\n239\t\t// Last, not first: a userinfo may itself contain an escaped separator, and\n240\t\t// the host is always what follows the final one.\n241\t\tat := strings.LastIndex(authority, \"@\")\n242\t\tif at < 0 {\n243\t\t\treturn \"\", false\n244\t\t}\n245\t\n246\t\treturn authority[at+1:], true\n247\t}\n248\t\n249\t// Request is a fully bound HTTP request, still symbolic about credentials.\n250\t//\n251\t// BaseURL and Path are kept apart from Query because the query string cannot be\n252\t// materialised without deciding how to render secrets, and that decision belongs\n253\t// to the caller: see URL.\n254\ttype Request struct {\n255\t\t// OperationID names the operation this came from, for output and history.\n256\t\tOperationID string `json:\"operation_id\"`\n257\t\tMethod      string `json:\"method\"`\n258\t\t// BaseURL is the scheme://host[/prefix] the call goes to, without a trailing\n259\t\t// slash.\n260\t\tBaseURL string `json:\"base_url\"`\n261\t\t// Path is the operation's path with its path parameters substituted and\n262\t\t// percent-encoded, e.g. /pets/42.\n263\t\tPath    string `json:\"path\"`\n264\t\tQuery   []Pair `json:\"query,omitempty\"`\n265\t\tHeaders []Pair `json:\"headers,omitempty\"`\n266\t\tCookies []Pair `json:\"cookies,omitempty\"`\n267\t\tBody    *Body  `json:\"body,omitempty\"`\n268\t}\n269\t\n270\t// URL builds the full request URL, rendering any credential in the query string\n271\t// with render. Pass Redacted for anything a user reads, Symbolic for emitted\n272\t// curl; internal/curl passes a resolving renderer at exec time and nothing else\n273\t// does.\n274\tfunc (r Request) URL(render Render) (string, error) {\n275\t\tquery, err := r.QueryString(render)\n276\t\tif err != nil {\n277\t\t\treturn \"\", err\n278\t\t}\n279\t\n280\t\tfull := r.BaseURL + r.Path\n281\t\tif query == \"\" {\n282\t\t\treturn full, nil\n283\t\t}\n284\t\n285\t\treturn full + \"?\" + query, nil\n286\t}\n287\t\n288\t// QueryString renders the query parameters in the order they were bound.\n289\t// url.QueryEscape does the encoding so it is not hand-rolled, and the order is\n290\t// preserved rather than sorted so emitted curl matches what was asked for.\n291\tfunc (r Request) QueryString(render Render) (string, error) {\n292\t\tvar b strings.Builder\n293\t\tfor _, p := range r.Query {\n294\t\t\tvalue, err := render(p.Value)\n295\t\t\tif err != nil {\n296\t\t\t\treturn \"\", err\n297\t\t\t}\n298\t\n299\t\t\tif b.Len() > 0 {\n300\t\t\t\tb.WriteByte('&')\n301\t\t\t}\n302\t\t\tb.WriteString(url.QueryEscape(p.Name))\n303\t\t\tb.WriteByte('=')\n304\t\n305\t\t\t// A placeholder is text to read, not bytes to send, so encoding it\n306\t\t\t// would only turn <redacted> into %3Credacted%3E. The test is what was\n307\t\t\t// rendered, not whether the value is sensitive: this function is shared\n308\t\t\t// with the wire path (internal/curl resolves through it), and skipping\n309\t\t\t// the escape for a resolved credential would put unescaped bytes in the\n310\t\t\t// request URL. Same comparison word.credential makes.\n311\t\t\tif p.Value.IsSensitive() && (value == p.Value.String() || value == p.Value.Symbolic()) {\n312\t\t\t\tb.WriteString(value)\n313\t\t\t\tcontinue\n314\t\t\t}\n315\t\t\tb.WriteString(url.QueryEscape(value))\n316\t\t}\n317\t\n318\t\treturn b.String(), nil\n319\t}\n320\t"
      }
