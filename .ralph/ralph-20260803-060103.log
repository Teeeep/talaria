      {
        "tool_use_id": "toolu_01ToL4jL1F49wFCKP5AM6vGy",
        "type": "tool_result",
        "content": "1\tpackage main\n2\t\n3\timport (\n4\t\t\"strings\"\n5\t\n6\t\t\"github.com/spf13/cobra\"\n7\t\n8\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n9\t\t\"github.com/Teeeep/talaria/internal/config\"\n10\t\t\"github.com/Teeeep/talaria/internal/operation\"\n11\t\t\"github.com/Teeeep/talaria/internal/output\"\n12\t)\n13\t\n14\t// authView is the JSON payload: one entry per security scheme the spec\n15\t// declares and talaria can satisfy.\n16\ttype authView struct {\n17\t\tSchemes []authScheme `json:\"schemes\"`\n18\t}\n19\t\n20\t// authScheme is DESIGN.md §4's object, field for field. The source is a *name* —\n21\t// `env:TALARIA_AUTH_BEARER` — because that is the whole of what an agent needs\n22\t// and the whole of what it may learn: it turns the name into \"export this and\n23\t// retry\" without ever holding the value.\n24\ttype authScheme struct {\n25\t\tScheme  string `json:\"scheme\"`\n26\t\tSource  string `json:\"source\"`\n27\t\tPresent bool   `json:\"present\"`\n28\t}\n29\t\n30\tfunc newAuthCmd() *cobra.Command {\n31\t\t// A group, not a command: `auth` holds the subcommands and answers nothing\n32\t\t// itself, so naming it alone is an incomplete invocation rather than a\n33\t\t// successful one. groupCommand is what makes that exit 2.\n34\t\tcmd := groupCommand(&cobra.Command{\n35\t\t\tUse:   \"auth\",\n36\t\t\tShort: \"Inspect the credentials a spec's security schemes need\",\n37\t\t})\n38\t\n39\t\tcmd.AddCommand(newAuthCheckCmd())\n40\t\n41\t\treturn cmd\n42\t}\n43\t\n44\tfunc newAuthCheckCmd() *cobra.Command {\n45\t\treturn &cobra.Command{\n46\t\t\tUse:   \"check [spec]\",\n47\t\t\tShort: \"Report which security schemes have a credential, without reading one\",\n48\t\t\tLong: \"Answer, for each of a spec's security schemes, whether a credential is\\n\" +\n49\t\t\t\t\"present and which environment variable it comes from. Values are never\\n\" +\n50\t\t\t\t\"read, so this is how an agent diagnoses a broken auth setup blind. It\\n\" +\n51\t\t\t\t\"exits 5 when an operation has no credential to authenticate it with.\",\n52\t\t\tArgs: usageArgs(cobra.MaximumNArgs(1)),\n53\t\t\tRunE: func(cmd *cobra.Command, args []string) error {\n54\t\t\t\tformat, err := resolveFormat(cmd)\n55\t\t\t\tif err != nil {\n56\t\t\t\t\treturn err\n57\t\t\t\t}\n58\t\n59\t\t\t\tdoc, index, err := loadSpec(cmd, args)\n60\t\t\t\tif err != nil {\n61\t\t\t\t\treturn err\n62\t\t\t\t}\n63\t\n64\t\t\t\tcfg, err := config.Load(\"\")\n65\t\t\t\tif err != nil {\n66\t\t\t\t\treturn err\n67\t\t\t\t}\n68\t\n69\t\t\t\tprof, err := selectProfile(cmd, cfg)\n70\t\t\t\tif err != nil {\n71\t\t\t\t\treturn err\n72\t\t\t\t}\n73\t\n74\t\t\t\tcreds, err := config.Schemes(doc, prof)\n75\t\t\t\tif err != nil {\n76\t\t\t\t\treturn err\n77\t\t\t\t}\n78\t\n79\t\t\t\tif err := output.New(format, cmd.OutOrStdout()).Render(authPayload(creds)); err != nil {\n80\t\t\t\t\treturn err\n81\t\t\t\t}\n82\t\n83\t\t\t\t// The report is printed before the verdict, and whatever the verdict\n84\t\t\t\t// is: the exit code says \"act on this\", and the body says what to act\n85\t\t\t\t// on. Failing first would leave an agent a code 5 and nothing to read.\n86\t\t\t\treturn unsatisfied(index.Operations(), creds)\n87\t\t\t},\n88\t\t}\n89\t}\n90\t\n91\tfunc authPayload(creds []config.Credential) output.Payload {\n92\t\tview := authView{Schemes: make([]authScheme, 0, len(creds))}\n93\t\trows := make([][]string, 0, len(creds))\n94\t\n95\t\tfor _, cred := range creds {\n96\t\t\tpresent := cred.Present()\n97\t\t\tview.Schemes = append(view.Schemes, authScheme{\n98\t\t\t\tScheme:  cred.Scheme,\n99\t\t\t\tSource:  cred.Ref.Location(),\n100\t\t\t\tPresent: present,\n101\t\t\t})\n102\t\t\trows = append(rows, []string{cred.Scheme, cred.Ref.Location(), presenceLabel(present)})\n103\t\t}\n104\t\n105\t\treturn output.Payload{Data: view, Table: output.Table{Rows: rows}}\n106\t}\n107\t\n108\t// presenceLabel is the pretty and TSV form of the present field. The words name\n109\t// the two states a reader acts on, and \"missing\" is the one to go export.\n110\tfunc presenceLabel(present bool) string {\n111\t\tif present {\n112\t\t\treturn \"present\"\n113\t\t}\n114\t\n115\t\treturn \"missing\"\n116\t}\n117\t\n118\t// unsatisfied returns the exit-5 error naming the credentials that stand\n119\t// between the caller and some operation, or nil when every operation in the\n120\t// spec can be authenticated.\n121\tfunc unsatisfied(ops []operation.Operation, creds []config.Credential) error {\n122\t\tbyName := make(map[string]config.Credential, len(creds))\n123\t\tfor _, cred := range creds {\n124\t\t\tbyName[cred.Scheme] = cred\n125\t\t}\n126\t\n127\t\t// creds is already sorted by scheme name, so walking it to collect the\n128\t\t// blocking ones keeps the message's order stable too.\n129\t\tblocking := map[string]bool{}\n130\t\tfor _, op := range ops {\n131\t\t\tif satisfied(op, byName) {\n132\t\t\t\tcontinue\n133\t\t\t}\n134\t\n135\t\t\tfor _, req := range op.Security {\n136\t\t\t\tfor _, want := range req.Schemes {\n137\t\t\t\t\tif cred, ok := byName[want.Name]; ok && !cred.Present() {\n138\t\t\t\t\t\tblocking[want.Name] = true\n139\t\t\t\t\t}\n140\t\t\t\t}\n141\t\t\t}\n142\t\t}\n143\t\tif len(blocking) == 0 {\n144\t\t\treturn nil\n145\t\t}\n146\t\n147\t\tvar parts []string\n148\t\tfor _, cred := range creds {\n149\t\t\tif blocking[cred.Scheme] {\n150\t\t\t\tparts = append(parts, cred.Scheme+\" (set \"+cred.Ref.Symbolic()+\")\")\n151\t\t\t}\n152\t\t}\n153\t\n154\t\tif len(parts) == 1 {\n155\t\t\treturn clierr.CredentialMissing(\"no credential for security scheme %s\", parts[0])\n156\t\t}\n157\t\n158\t\treturn clierr.CredentialMissing(\"no credential for security schemes %s\", strings.Join(parts, \", \"))\n159\t}\n160\t\n161\t// satisfied reports whether op has an alternative talaria can authenticate with\n162\t// the credentials that are actually set.\n163\t//\n164\t// A spec may offer alternatives and any one of them is enough, so a bearer\n165\t// token alone satisfies an operation that accepts either it or an API key. An\n166\t// alternative naming a scheme talaria cannot supply — OAuth2 — is skipped\n167\t// rather than counted against the caller: v1's position is that you bring your\n168\t// own token for those, and there is no variable to report missing (§5 Auth).\n169\tfunc satisfied(op operation.Operation, byName map[string]config.Credential) bool {\n170\t\tusable := false\n171\t\n172\t\tfor _, req := range op.Security {\n173\t\t\t// An empty requirement is the spec saying authentication is optional here.\n174\t\t\tif len(req.Schemes) == 0 {\n175\t\t\t\treturn true\n176\t\t\t}\n177\t\n178\t\t\tknown, present := true, true\n179\t\t\tfor _, want := range req.Schemes {\n180\t\t\t\tcred, ok := byName[want.Name]\n181\t\t\t\tswitch {\n182\t\t\t\tcase !ok:\n183\t\t\t\t\tknown = false\n184\t\t\t\tcase !cred.Present():\n185\t\t\t\t\tpresent = false\n186\t\t\t\t}\n187\t\t\t}\n188\t\n189\t\t\tif !known {\n190\t\t\t\tcontinue\n191\t\t\t}\n192\t\t\tusable = true\n193\t\n194\t\t\tif present {\n195\t\t\t\treturn true\n196\t\t\t}\n197\t\t}\n198\t\n199\t\t// No usable alternative means nothing talaria could have satisfied, which\n200\t\t// includes the common case of an operation with no security at all.\n201\t\treturn !usable\n202\t}\n203\t"
      }
    ]
  },
