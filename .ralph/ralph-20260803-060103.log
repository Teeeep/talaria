        "type": "tool_result",
        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"net/http\"\n5\t\t\"os\"\n6\t\t\"strconv\"\n7\t\t\"strings\"\n8\t\t\"time\"\n9\t\t\"unicode/utf8\"\n10\t\n11\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n12\t\t\"github.com/Teeeep/talaria/internal/request\"\n13\t)\n14\t\n15\t// maxInlineBody is the size above which a body stops being a directive and\n16\t// becomes a 0600 temp file. DESIGN.md §5a calls the temp file \"the exception\":\n17\t// it is a real file on disk for the length of one exec, so the threshold is set\n18\t// where the config document stops being a reasonable place to put bytes rather\n19\t// than at any hard limit of curl's.\n20\tconst maxInlineBody = 1 << 20\n21\t\n22\t// The default bounds on one call. They are generous enough that a slow but\n23\t// working API still answers, and short enough that a wedged one becomes an exit\n24\t// code rather than a process an agent cannot interpret — the reasoning\n25\t// internal/spec/source.go already applies to fetching a spec, applied to the\n26\t// higher-risk path.\n27\tconst (\n28\t\tDefaultConnectTimeout = 10 * time.Second\n29\t\tDefaultMaxTime        = 30 * time.Second\n30\t)\n31\t\n32\t// Options bound one invocation of curl in time. They are enforced by curl\n33\t// itself, which exits 28 when either runs out; the executor's own deadline is\n34\t// only the backstop for a curl that ignores them.\n35\ttype Options struct {\n36\t\t// ConnectTimeout limits establishing the connection.\n37\t\tConnectTimeout time.Duration\n38\t\t// MaxTime limits the whole operation, connection included.\n39\t\tMaxTime time.Duration\n40\t}\n41\t\n42\t// DefaultOptions returns the bounds a caller gets without asking.\n43\tfunc DefaultOptions() Options {\n44\t\treturn Options{ConnectTimeout: DefaultConnectTimeout, MaxTime: DefaultMaxTime}\n45\t}\n46\t\n47\t// withDefaults fills in the timeouts a caller left unset.\n48\t//\n49\t// A non-positive value means \"unset\" rather than \"no limit\": an unbounded call\n50\t// is exactly what these options exist to prevent, so there is deliberately no\n51\t// way to ask for one. A connect timeout longer than the total is clamped, since\n52\t// curl would enforce the total against it anyway and the pair reads as a lie.\n53\tfunc (o Options) withDefaults() Options {\n54\t\tif o.ConnectTimeout <= 0 {\n55\t\t\to.ConnectTimeout = DefaultConnectTimeout\n56\t\t}\n57\t\tif o.MaxTime <= 0 {\n58\t\t\to.MaxTime = DefaultMaxTime\n59\t\t}\n60\t\tif o.ConnectTimeout > o.MaxTime {\n61\t\t\to.ConnectTimeout = o.MaxTime\n62\t\t}\n63\t\n64\t\treturn o\n65\t}\n66\t\n67\t// Capture names the files curl writes the response to. Both are optional; the\n68\t// executor allocates them and passes them here rather than appending them to\n69\t// argv, because §5a's rule is that *nothing* about the call is an argument, not\n70\t// merely nothing sensitive.\n71\ttype Capture struct {\n72\t\t// BodyPath receives the response body, via the output directive.\n73\t\tBodyPath string\n74\t\t// HeaderPath receives the response headers, via the dump-header directive.\n75\t\tHeaderPath string\n76\t}\n77\t\n78\t// BuildConfig renders req as a curl config document for `curl -K -`.\n79\t//\n80\t// This is the one place in talaria where a resolved credential exists. The\n81\t// document is written to curl's stdin and holds the real values; the returned\n82\t// argv is exactly `curl -K -` and holds nothing, because /proc/*/cmdline is\n83\t// readable by any process on the host — including ones an agent spawns (§5a).\n84\t//\n85\t// cleanup must be called once curl has exited. It removes any temp body file\n86\t// and zeroes the document, so the resolved values do not linger in a buffer the\n87\t// rest of the process can still reach. It is safe to call more than once, and\n88\t// is non-nil even when BuildConfig fails.\n89\t//\n90\t// A credential whose environment variable is unset fails with exit code 5 and\n91\t// no document, rather than sending an empty header — an unauthenticated request\n92\t// that looks authenticated is the worse outcome (§4).\n93\tfunc BuildConfig(req *request.Request, capture Capture) (config []byte, argv []string, cleanup func(), err error) {\n94\t\treturn BuildConfigWith(req, capture, DefaultOptions())\n95\t}\n96\t\n97\t// BuildConfigWith is BuildConfig with the timeouts named rather than defaulted.\n98\tfunc BuildConfigWith(\n99\t\treq *request.Request,\n100\t\tcapture Capture,\n101\t\topts Options,\n102\t) (config []byte, argv []string, cleanup func(), err error) {\n103\t\t// -q first, where curl reads it: it disables the default config file, which\n104\t\t// curl would otherwise parse *before* the -K document. A `trace-ascii` or\n105\t\t// `proxy` line in a $HOME/.curlrc anyone can write applies to the one request\n106\t\t// carrying the resolved credential, and copies it straight back out. Writing\n107\t\t// that file is a weaker capability than the env-var read §5a concedes, so\n108\t\t// this flag is what keeps the firewall inside its claimed boundary.\n109\t\targv = []string{\"curl\", \"-q\", \"-K\", \"-\"}\n110\t\tif req == nil {\n111\t\t\treturn nil, argv, func() {}, clierr.RequestFailed(\"no request to execute\")\n112\t\t}\n113\t\n114\t\tvar doc document\n115\t\tif err := doc.build(req, capture, opts.withDefaults()); err != nil {\n116\t\t\tdoc.discard()\n117\t\t\treturn nil, argv, doc.cleanup, err\n118\t\t}\n119\t\n120\t\tconfig = []byte(doc.b.String())\n121\t\tdoc.b.Reset()\n122\t\n123\t\treturn config, argv, doc.cleanupWith(config), nil\n124\t}\n125\t\n126\t// document accumulates the directives and the temp files they point at, so a\n127\t// failure part-way through still knows what to remove.\n128\ttype document struct {\n129\t\tb     strings.Builder\n130\t\tfiles []string\n131\t}\n132\t\n133\tfunc (d *document) build(req *request.Request, capture Capture, opts Options) error {\n134\t\turl, err := req.URL(resolve)\n135\t\tif err != nil {\n136\t\t\treturn err\n137\t\t}\n138\t\td.directive(\"url\", url)\n139\t\n140\t\t// head rather than `request = \"HEAD\"`: -X HEAD leaves curl waiting for a body\n141\t\t// of Content-Length bytes that a compliant server never sends, so the call\n142\t\t// hangs (or exits 18 when the connection closes first). HEAD is a safe method\n143\t\t// that `run` includes without --allow-mutations, so one such operation would\n144\t\t// stall an entire report.\n145\t\thead := strings.EqualFold(req.Method, http.MethodHead)\n146\t\tswitch {\n147\t\tcase head:\n148\t\t\td.flag(\"head\")\n149\t\tcase req.Method != \"\":\n150\t\t\td.directive(\"request\", req.Method)\n151\t\t}\n152\t\n153\t\tif err := d.auth(req); err != nil {\n154\t\t\treturn err\n155\t\t}\n156\t\tif err := d.cookies(req); err != nil {\n157\t\t\treturn err\n158\t\t}\n159\t\tif err := d.body(req); err != nil {\n160\t\t\treturn err\n161\t\t}\n162\t\n163\t\t// Defence in depth behind request.IsHTTPScheme: curl speaks file, gopher,\n164\t\t// dict and smb, and a redirect chooses the scheme of the next hop without\n165\t\t// asking talaria. The leading `=` makes each list absolute rather than\n166\t\t// additive, so these two are the only protocols this process can use.\n167\t\td.directive(\"proto\", \"=http,https\")\n168\t\td.directive(\"proto-redir\", \"=http,https\")\n169\t\n170\t\t// The bounds curl enforces on itself. Emitted as directives rather than\n171\t\t// watched from Go because curl exits 28 of its own accord, which runFailure\n172\t\t// already classifies as a failed request — so the happy path never has to\n173\t\t// know a clock exists. A `run` without these stalls on operation k of n and\n174\t\t// emits no report at all.\n175\t\td.directive(\"connect-timeout\", seconds(opts.ConnectTimeout))\n176\t\td.directive(\"max-time\", seconds(opts.MaxTime))\n177\t\n178\t\t// silent suppresses the progress meter, which would otherwise be interleaved\n179\t\t// with the write-out payload on stdout; show-error keeps real failures\n180\t\t// visible despite it.\n181\t\td.flag(\"silent\")\n182\t\td.flag(\"show-error\")\n183\t\t// %{json} is the whole response metadata in one parseable object, and is the\n184\t\t// reason DESIGN.md sets a curl >= 7.70 floor.\n185\t\td.directive(\"write-out\", \"%{json}\")\n186\t\n187\t\tif capture.BodyPath != \"\" {\n188\t\t\t// head makes curl write the header block to the output file, which at\n189\t\t\t// capture.BodyPath would be reported as the response body. dump-header\n190\t\t\t// still captures the headers, and the staged empty body file keeps\n191\t\t\t// readResponse reading a real path.\n192\t\t\tpath := capture.BodyPath\n193\t\t\tif head {\n194\t\t\t\tpath = os.DevNull\n195\t\t\t}\n196\t\t\td.directive(\"output\", path)\n197\t\t}\n198\t\tif capture.HeaderPath != \"\" {\n199\t\t\td.directive(\"dump-header\", capture.HeaderPath)\n200\t\t}\n201\t\n202\t\treturn nil\n203\t}\n204\t\n205\t// auth writes the request headers, diverting basic auth to curl's own user\n206\t// directive: the header text is base64(user:password), and letting curl encode\n207\t// it means this package never has to.\n208\tfunc (d *document) auth(req *request.Request) error {\n209\t\tfor _, h := range req.Headers {\n210\t\t\tvalue, err := resolve(h.Value)\n211\t\t\tif err != nil {\n212\t\t\t\treturn err\n213\t\t\t}\n214\t\n215\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n216\t\t\t\td.directive(\"user\", strings.TrimPrefix(value, h.Value.Prefix()))\n217\t\t\t\tcontinue\n218\t\t\t}\n219\t\n220\t\t\td.directive(\"header\", h.Name+\": \"+value)\n221\t\t}\n222\t\n223\t\treturn nil\n224\t}\n225\t\n226\t// cookies writes every cookie as one directive. curl keeps only the last of\n227\t// several, so they are joined rather than repeated.\n228\tfunc (d *document) cookies(req *request.Request) error {\n229\t\tif len(req.Cookies) == 0 {\n230\t\t\treturn nil\n231\t\t}\n232\t\n233\t\tvar b strings.Builder\n234\t\tfor i, c := range req.Cookies {\n235\t\t\tvalue, err := resolve(c.Value)\n236\t\t\tif err != nil {\n237\t\t\t\treturn err\n238\t\t\t}\n239\t\n240\t\t\tif i > 0 {\n241\t\t\t\tb.WriteString(\"; \")\n242\t\t\t}\n243\t\t\tb.WriteString(c.Name + \"=\" + value)\n244\t\t}\n245\t\n246\t\td.directive(\"cookie\", b.String())\n247\t\n248\t\treturn nil\n249\t}\n250\t\n251\t// body writes the request body, inline when it can be and via a temp file when\n252\t// it cannot.\n253\tfunc (d *document) body(req *request.Request) error {\n254\t\tif req.Body == nil {\n255\t\t\treturn nil\n256\t\t}\n257\t\n258\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n259\t\t\td.directive(\"header\", \"Content-Type: \"+req.Body.ContentType)\n260\t\t}\n261\t\n262\t\tif inlinable(req.Body.Data) {\n263\t\t\t// data-raw rather than data or data-binary: those two read a value\n264\t\t\t// starting with @ as a filename, and a JSON body legitimately can. Verified\n265\t\t\t// against curl 8.14.1 — data-raw sends the bytes as given and strips\n266\t\t\t// nothing, where `data = \"@path\"` also strips newlines.\n267\t\t\td.directive(\"data-raw\", string(req.Body.Data))\n268\t\t\treturn nil\n269\t\t}\n270\t\n271\t\tpath, err := d.tempFile(req.Body.Data)\n272\t\tif err != nil {\n273\t\t\treturn err\n274\t\t}\n275\t\t// The file's bytes are read verbatim, so data-binary rather than data: data\n276\t\t// strips newlines and carriage returns out of a file, which corrupts any\n277\t\t// pretty-printed JSON and breaks any signed payload.\n278\t\td.directive(\"data-binary\", \"@\"+path)\n279\t\n280\t\treturn nil\n281\t}\n282\t\n283\t// inlinable reports whether a body can live in the config document. Valid UTF-8\n284\t// under the size limit can; anything else takes the temp-file path, because a\n285\t// NUL byte truncates a quoted value and arbitrary bytes have no escape sequence\n286\t// that survives curl's parser.\n287\tfunc inlinable(data []byte) bool {\n288\t\tif len(data) > maxInlineBody || !utf8.Valid(data) {\n289\t\t\treturn false\n290\t\t}\n291\t\n292\t\treturn !strings.ContainsRune(string(data), 0)\n293\t}\n294\t\n295\t// tempFile writes data to a 0600 file and records it for cleanup.\n296\tfunc (d *document) tempFile(data []byte) (string, error) {\n297\t\tf, err := os.CreateTemp(\"\", \"talaria-body-*\")\n298\t\tif err != nil {\n299\t\t\treturn \"\", clierr.RequestFailed(\"cannot stage the request body: %w\", err)\n300\t\t}\n301\t\td.files = append(d.files, f.Name())\n302\t\n303\t\t// CreateTemp already makes the file 0600; setting it explicitly keeps that a\n304\t\t// guarantee of this code rather than of the standard library's current\n305\t\t// behaviour, since the body may carry credentials the user put in it.\n306\t\tif err := f.Chmod(0o600); err != nil {\n307\t\t\tf.Close()\n308\t\t\treturn \"\", clierr.RequestFailed(\"cannot secure the request body file: %w\", err)\n309\t\t}\n310\t\n311\t\tif _, err := f.Write(data); err != nil {\n312\t\t\tf.Close()\n313\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n314\t\t}\n315\t\n316\t\tif err := f.Close(); err != nil {\n317\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n318\t\t}\n319\t\n320\t\treturn f.Name(), nil\n321\t}\n322\t\n323\t// seconds renders a duration the way curl's timeout options read it: decimal\n324\t// seconds, with no trailing zeroes, so a sub-second bound survives the trip.\n325\tfunc seconds(d time.Duration) string {\n326\t\treturn strconv.FormatFloat(d.Seconds(), 'f', -1, 64)\n327\t}\n328\t\n329\t// directive writes one `name = \"value\"` line, escaped for curl's parser.\n330\tfunc (d *document) directive(name, value string) {\n331\t\td.b.WriteString(name + ` = \"` + escapeDirective(value) + \"\\\"\\n\")\n332\t}\n333\t\n334\t// flag writes one bare directive, the config form of a boolean option.\n335\tfunc (d *document) flag(name string) { d.b.WriteString(name + \"\\n\") }\n336\t\n337\t// discard drops a partially built document, so a failure returns nothing a\n338\t// caller could accidentally send or print.\n339\tfunc (d *document) discard() { d.b.Reset() }\n340\t\n341\t// cleanup removes the temp files this document points at.\n342\tfunc (d *document) cleanup() {\n343\t\tfor _, path := range d.files {\n344\t\t\tos.Remove(path) //nolint:errcheck // Best effort; the file is 0600 and in TMPDIR.\n345\t\t}\n346\t\td.files = nil\n347\t}\n348\t\n349\t// cleanupWith also zeroes the finished document, so the resolved credentials in\n350\t// it stop being readable from the buffer once curl has exited.\n351\tfunc (d *document) cleanupWith(config []byte) func() {\n352\t\treturn func() {\n353\t\t\td.cleanup()\n354\t\t\tfor i := range config {\n355\t\t\t\tconfig[i] = 0\n356\t\t\t}\n357\t\t}\n358\t}\n359\t\n360\t// resolve is the renderer that reads real credential values. It is the single\n361\t// crossing of the firewall described in DESIGN.md §5a: every other renderer in\n362\t// talaria produces a redacted or symbolic form, and this one exists only to\n363\t// feed the config document.\n364\tfunc resolve(v request.Value) (string, error) {\n365\t\tif !v.IsSecret() {\n366\t\t\t// Reveal rather than String: a literal the user typed under a\n367\t\t\t// credential-shaped name displays redacted everywhere else, and the\n368\t\t\t// wire is the one place it must not.\n369\t\t\treturn v.Reveal(), nil\n370\t\t}\n371\t\n372\t\tvalue, err := v.Ref().Resolve()\n373\t\tif err != nil {\n374\t\t\treturn \"\", err\n375\t\t}\n376\t\n377\t\treturn v.Prefix() + value, nil\n378\t}\n379\t\n380\t// configEscape covers the escape sequences curl's config parser understands, in\n381\t// the order a single pass must apply them. strings.Replacer scans once and\n382\t// picks the longest match at each position, which is what keeps the backslash\n383\t// rule from re-escaping the backslashes the other rules just introduced — the\n384\t// double-escaping bug that ordered sequential replaces invite.\n385\tvar configEscape = strings.NewReplacer(\n386\t\t`\\`, `\\\\`,\n387\t\t`\"`, `\\\"`,\n388\t\t\"\\t\", `\\t`,\n389\t\t\"\\n\", `\\n`,\n390\t\t\"\\r\", `\\r`,\n391\t)\n392\t\n393\tfunc escapeDirective(s string) string { return configEscape.Replace(s) }\n394\t"
      }
