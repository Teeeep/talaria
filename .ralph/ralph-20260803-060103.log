        "content": "40\t\t// it by asking a human to set the named variable.\n41\t\tCodeCredentialMissing Code = 5\n42\t)\n43\t\n44\t// Error is a failure carrying the exit code talaria will exit with, plus the\n45\t// alternatives that would have been valid. It implements error and Unwrap, so\n46\t// callers may add context with fmt.Errorf(\"%w\") without losing the code.\n47\ttype Error struct {\n48\t\tCode    Code\n49\t\tMessage string\n50\t\t// Alternatives are the values that would have been accepted, rendered as\n51\t\t// error.valid_alternatives (§3.1: \"what failed, why, valid alternatives\").\n52\t\tAlternatives []string\n53\t\n54\t\terr error\n55\t}\n56\t\n57\tfunc (e *Error) Error() string { return e.Message }\n58\t\n59\t// Unwrap exposes the error passed to the constructor via %w, keeping errors.Is\n60\t// working through the classification.\n61\tfunc (e *Error) Unwrap() error { return e.err }\n62\t\n63\t// WithAlternatives attaches the valid values for the thing that failed and\n64\t// returns e, so it can be chained onto a constructor.\n65\tfunc (e *Error) WithAlternatives(alts ...string) *Error {\n66\t\te.Alternatives = alts\n67\t\treturn e\n68\t}\n69\t\n70\t// Usage reports a bad invocation (exit 2).\n71\tfunc Usage(format string, a ...any) *Error { return newError(CodeUsage, format, a...) }\n72\t\n73\t// SpecLoad reports a spec that could not be read or parsed (exit 3).\n74\tfunc SpecLoad(format string, a ...any) *Error { return newError(CodeSpecLoad, format, a...) }\n75\t\n76\t// Validation reports a response that violates the spec (exit 4).\n77\tfunc Validation(format string, a ...any) *Error { return newError(CodeValidation, format, a...) }\n78\t\n79\t// CredentialMissing reports a required security scheme with no credential"
