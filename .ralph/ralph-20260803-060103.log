        "content": "58:\t// Fixtures are the user's own test data, consulted by DataFor after spec\n59-\t// examples and before generation. Nil is an empty set.\n60-\tFixtures *Fixtures\n61-}\n62-\n63-// New returns a Generator drawing from seed. The same seed always produces the\n64-// same data for the same schema.\n65-func New(seed int64) *Generator {\n66-\t// PCG needs two words of state; deriving the second from the first keeps\n67-\t// the caller's single seed the whole story.\n68-\treturn &Generator{\n69-\t\trng:      rand.New(rand.NewPCG(uint64(seed), uint64(seed)+0x9e3779b9)),\n70-\t\tMaxDepth: DefaultMaxDepth,\n71-\t}\n72-}\n73-\n74-// Value generates one value for a schema, shaped for encoding/json: strings,\n75-// float64/int64, bool, []any and map[string]any. A nil schema, or one the\n76-// generator declined to descend into, yields nil.\n77-func (g *Generator) Value(sp *base.SchemaProxy) any {\n78-\tv, _ := g.value(sp, 0, make(map[string]int))\n79-\n80-\treturn v\n81-}\n82-\n83-// value generates a value, reporting whether it produced one at all. The bool\n84-// is how the cycle guard and the depth limit express \"there is nothing sensible\n85-// to put here\": the caller then omits the property or the array element rather\n86-// than writing a null, which would be a claim about the data rather than an\n87-// absence of it.\n88-//\n89-// onPath counts the $refs on the current branch, not every ref ever seen — the\n90-// same schema may legitimately appear in two sibling properties, and only a\n91-// reference back into one's own ancestry is a cycle.\n92-func (g *Generator) value(sp *base.SchemaProxy, depth int, onPath map[string]int) (any, bool) {\n93-\tif sp == nil {\n94-\t\treturn nil, false\n95-\t}\n96-\n97-\t// The cycle key is the $ref, matching internal/output's walker: recursion\n98-\t// in a real spec always goes through a reference.\n99-\tif key := refKey(sp); key != \"\" {\n100-\t\tif onPath[key] >= maxRefRepeats {\n101-\t\t\treturn nil, false\n102-\t\t}\n103-\t\tonPath[key]++\n104-\t\tdefer func() { onPath[key]-- }()\n105-\t}\n106-\n107-\ts := sp.Schema()\n108-\tif s == nil {\n109-\t\treturn nil, false\n110-\t}\n111-\n112-\t// Examples win outright (DESIGN.md §5a), before type, format or enum.\n113-\tif v, ok := exampleValue(s); ok {\n114-\t\treturn v, true\n115-\t}\n116-\tif len(s.Enum) > 0 {\n117-\t\treturn decodeNode(s.Enum[g.rng.IntN(len(s.Enum))])\n118-\t}",
