t\t\tpairs = append(pairs, request.Pair{Name: name, Value: value})\n651\t\t}\n652\t\n653\t\treturn pairs\n654\t}\n655\t\n656\t// replayValue turns one stored value back into a request Value, reporting\n657\t// false for one that cannot be reproduced.\n658\t//\n659\t// A `<redacted:env:NAME>` — with or without a scheme prefix — becomes a\n660\t// reference to the same variable. A bare `<redacted>` is a value the name-based\n661\t// matcher caught: a literal the user typed, which was deliberately not written\n662\t// down and so cannot come back. That is the firewall working, not a bug, and\n663\t// the caller says so on stderr rather than silently sending a request missing a\n664\t// header the original had.\n665\tfunc replayValue(stored string) (request.Value, bool) {\n666\t\tif stored == secret.Placeholder {\n667\t\t\treturn request.Value{}, false\n668\t\t}\n669\t\n670\t\t// Longest prefix first, so the raw encoding's empty prefix is the fallback\n671\t\t// rather than the first match.\n672\t\tfor _, enc := range []request.Encoding{request.EncodeBearer, request.EncodeBasic, request.EncodeRaw} {\n673\t\t\tprefix := encodingPrefix(enc)\n674\t\t\tif prefix != \"\" && !strings.HasPrefix(stored, prefix) {\n675\t\t\t\tcontinue\n676\t\t\t}\n677\t\n678\t\t\tif ref, ok := secret.ParseRef(strings.TrimPrefix(stored, prefix)); ok {\n679\t\t\t\treturn request.Secret(ref, enc), true\n680\t\t\t}\n681\t\t}\n682\t\n683\t\treturn request.Literal(stored), true\n684\t}\n685\t\n686\t// encodingPrefix is the text a scheme puts in front of a credential — \"Bearer \"\n687\t// and the rest. It is asked of internal/request rather than repeated here, so\n688\t// the two cannot drift apart."
