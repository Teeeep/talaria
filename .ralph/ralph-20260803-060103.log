          "+func (h *harness) reproduce(command string) {",
          "+  h.t.Helper()",
          "+",
          "+  cmd := exec.Command(\"sh\", \"-c\", command)",
          "+  cmd.Env = h.env",
          "+",
          "+  if out, err := cmd.CombinedOutput(); err != nil {",
          "+    h.t.Fatalf(\"running the rendered command: %v\\n%s\\n%s\", err, command, out)",
