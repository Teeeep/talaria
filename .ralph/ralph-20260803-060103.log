      {
        "tool_use_id": "toolu_01KKAtSfwjTZtXW1vNY9UsZc",
        "type": "tool_result",
        "content": "1\tpackage corpus\n2\t\n3\timport (\n4\t\t\"bytes\"\n5\t\t\"encoding/json\"\n6\t\t\"errors\"\n7\t\t\"fmt\"\n8\t\t\"io/fs\"\n9\t\t\"os\"\n10\t\t\"path/filepath\"\n11\t\t\"strconv\"\n12\t\t\"strings\"\n13\t\t\"time\"\n14\t)\n15\t\n16\t// EnvHistory switches recording off wherever talaria runs. It is read here\n17\t// rather than layered in with the profile settings because it is the operator's\n18\t// override: `history.enabled` is what a user configured, and this is what\n19\t// someone auditing a machine sets, so it wins over both.\n20\tconst EnvHistory = \"TALARIA_HISTORY\"\n21\t\n22\tconst (\n23\t\t// fileName is the store, one JSON entry per line, under the state directory.\n24\t\tfileName = \"history.jsonl\"\n25\t\t// lockSuffix names the sibling file appends hold their advisory lock on. It\n26\t\t// is a separate file so the lock outlives trim's rename of the store.\n27\t\tlockSuffix = \".lock\"\n28\t\t// maxPerSource is the retention cap, applied per Source rather than over the\n29\t\t// whole file: a single `run` over a large spec would otherwise evict every\n30\t\t// interactive call a session had made.\n31\t\tmaxPerSource = 1000\n32\t\n33\t\tdirMode  fs.FileMode = 0o700\n34\t\tfileMode fs.FileMode = 0o600\n35\t)\n36\t\n37\t// Store is the append-only history file.\n38\t//\n39\t// Failures from its methods are deliberately unclassified: a call that reached\n40\t// the server and came back is a success, and whether talaria managed to write\n41\t// the fact down afterwards is the caller's decision to report, not a reason to\n42\t// change the command's exit code.\n43\ttype Store struct {\n44\t\tdir     string\n45\t\tenabled bool\n46\t}\n47\t\n48\t// New returns a store writing under dir, recording only when enabled.\n49\t//\n50\t// An empty dir means the default state directory; tests pass a temporary one.\n51\t// The enabled flag is the profile's `history.enabled` as the caller resolved it\n52\t// — this package never reads the config itself, so that the twin can use the\n53\t// same store without one.\n54\tfunc New(dir string, enabled bool) *Store {\n55\t\treturn &Store{dir: dir, enabled: enabled}\n56\t}\n57\t\n58\t// Path is the history file's location.\n59\tfunc (s *Store) Path() (string, error) {\n60\t\tdir := \"\"\n61\t\tif s != nil {\n62\t\t\tdir = s.dir\n63\t\t}\n64\t\n65\t\tif dir == \"\" {\n66\t\t\tbase, err := stateDir()\n67\t\t\tif err != nil {\n68\t\t\t\treturn \"\", fmt.Errorf(\"cannot locate the talaria state directory: %w\", err)\n69\t\t\t}\n70\t\t\tdir = base\n71\t\t}\n72\t\n73\t\treturn filepath.Join(dir, fileName), nil\n74\t}\n75\t\n76\t// Recording reports whether Append will write anything, so a caller can skip\n77\t// building an entry it is only going to throw away.\n78\tfunc (s *Store) Recording() bool {\n79\t\tif s == nil || !s.enabled {\n80\t\t\treturn false\n81\t\t}\n82\t\n83\t\treturn !off(os.Getenv(EnvHistory))\n84\t}\n85\t\n86\t// Append records one entry, gives it its stable id, and applies the retention\n87\t// cap.\n88\t//\n89\t// The id, the write and the trim are one critical section. Trim rewrites the\n90\t// whole file from a snapshot it read, so an entry appended between that read and\n91\t// the rename would be dropped silently — Append had already returned nil for it,\n92\t// so nothing would ever report it missing. The id is chosen against the same\n93\t// snapshot for the same reason: two processes that picked one concurrently could\n94\t// pick the same one. Holding the lock across all three is what makes a nil\n95\t// return mean the entry is in the store under an id nothing else holds.\n96\t//\n97\t// With recording off it does nothing at all — no file, no directory, no lock.\n98\t// An opt-out that still left a history file behind would not be one.\n99\tfunc (s *Store) Append(e Entry) error {\n100\t\tif !s.Recording() {\n101\t\t\treturn nil\n102\t\t}\n103\t\n104\t\tpath, err := s.Path()\n105\t\tif err != nil {\n106\t\t\treturn err\n107\t\t}\n108\t\n109\t\tunlock, err := lock(path)\n110\t\tif err != nil {\n111\t\t\treturn err\n112\t\t}\n113\t\tdefer unlock()\n114\t\n115\t\te.ID = uniqueID(path, e)\n116\t\n117\t\tline, err := json.Marshal(e)\n118\t\tif err != nil {\n119\t\t\treturn fmt.Errorf(\"cannot encode the history entry: %w\", err)\n120\t\t}\n121\t\n122\t\tif err := write(path, append(line, '\\n')); err != nil {\n123\t\t\treturn err\n124\t\t}\n125\t\n126\t\treturn trim(path)\n127\t}\n128\t\n129\t// uniqueID is the id the entry goes to disk under. The caller holds the append\n130\t// lock, so what this reads off the store cannot change under it.\n131\t//\n132\t// The timestamp is the id: it needs no counter kept anywhere, it is already in\n133\t// append order, and trim rewriting the file around it cannot change it. Two\n134\t// entries can still land on the same instant — a second process, or a clock with\n135\t// less than nanosecond resolution — and a duplicate id would resolve to whichever\n136\t// entry came first and silently replay the wrong request, which is the thing the\n137\t// field exists to stop. So a taken id gets a counting suffix instead.\n138\tfunc uniqueID(path string, e Entry) string {\n139\t\tcandidate := e.ID\n140\t\tif candidate == \"\" {\n141\t\t\tcandidate = e.Timestamp.UTC().Format(time.RFC3339Nano)\n142\t\t}\n143\t\n144\t\ttaken := storedIDs(path)\n145\t\tif !taken[candidate] {\n146\t\t\treturn candidate\n147\t\t}\n148\t\tfor n := 2; ; n++ {\n149\t\t\tsuffixed := candidate + \"#\" + strconv.Itoa(n)\n150\t\t\tif !taken[suffixed] {\n151\t\t\t\treturn suffixed\n152\t\t\t}\n153\t\t}\n154\t}\n155\t\n156\t// storedIDs is the set of ids already in the store. A file that cannot be read —\n157\t// it usually does not exist yet — holds no ids, which makes every candidate\n158\t// free. Lines written before ids existed contribute none, so an old store's\n159\t// entries never make a new id look taken.\n160\tfunc storedIDs(path string) map[string]bool {\n161\t\tdata, err := os.ReadFile(path)\n162\t\tif err != nil {\n163\t\t\treturn nil\n164\t\t}\n165\t\n166\t\tids := map[string]bool{}\n167\t\tfor _, line := range lines(data) {\n168\t\t\tif head, ok := lineHead(line); ok && head.ID != \"\" {\n169\t\t\t\tids[head.ID] = true\n170\t\t\t}\n171\t\t}\n172\t\n173\t\treturn ids\n174\t}\n175\t\n176\t// Read returns every readable entry, oldest first.\n177\t//\n178\t// It does not consult the recording setting: history written before recording\n179\t// was switched off is still history, and reading it puts nothing new on disk.\n180\t// A store that was never written is empty rather than an error.\n181\tfunc (s *Store) Read() ([]Entry, error) {\n182\t\tpath, err := s.Path()\n183\t\tif err != nil {\n184\t\t\treturn nil, err\n185\t\t}\n186\t\n187\t\tdata, err := os.ReadFile(path)\n188\t\tif errors.Is(err, fs.ErrNotExist) {\n189\t\t\treturn nil, nil\n190\t\t}\n191\t\tif err != nil {\n192\t\t\treturn nil, fmt.Errorf(\"cannot read the history file: %w\", err)\n193\t\t}\n194\t\n195\t\tvar entries []Entry\n196\t\tfor _, line := range lines(data) {\n197\t\t\tvar entry Entry\n198\t\t\t// A line that will not parse is skipped rather than fatal. The file is\n199\t\t\t// appended to by every call, so a process killed mid-write leaves a\n200\t\t\t// partial last line, and losing every earlier entry to it would make the\n201\t\t\t// store fragile exactly when something has already gone wrong.\n202\t\t\tif err := json.Unmarshal(line, &entry); err != nil {\n203\t\t\t\tcontinue\n204\t\t\t}\n205\t\t\tentries = append(entries, entry)\n206\t\t}\n207\t\n208\t\treturn entries, nil\n209\t}\n210\t\n211\t// write appends one line, creating the directory and the file with the modes\n212\t// DESIGN.md §5a requires of talaria's highest-risk artifact.\n213\tfunc write(path string, line []byte) error {\n214\t\tdir := filepath.Dir(path)\n215\t\tif err := os.MkdirAll(dir, dirMode); err != nil {\n216\t\t\treturn fmt.Errorf(\"cannot create the history directory: %w\", err)\n217\t\t}\n218\t\t// MkdirAll leaves an existing directory's mode alone and gives a new one\n219\t\t// dirMode masked by the umask. The Chmod makes 0700 a guarantee rather than\n220\t\t// an inherited default.\n221\t\tif err := os.Chmod(dir, dirMode); err != nil {\n222\t\t\treturn fmt.Errorf(\"cannot secure the history directory: %w\", err)\n223\t\t}\n224\t\n225\t\tf, err := os.OpenFile(path, os.O_APPEND|os.O_CREATE|os.O_WRONLY, fileMode)\n226\t\tif err != nil {\n227\t\t\treturn fmt.Errorf(\"cannot open the history file: %w\", err)\n228\t\t}\n229\t\tif err := f.Chmod(fileMode); err != nil {\n230\t\t\tf.Close() //nolint:errcheck // The Chmod failure is the one worth reporting.\n231\t\t\treturn fmt.Errorf(\"cannot secure the history file: %w\", err)\n232\t\t}\n233\t\tif _, err := f.Write(line); err != nil {\n234\t\t\tf.Close() //nolint:errcheck // The Write failure is the one worth reporting.\n235\t\t\treturn fmt.Errorf(\"cannot write the history entry: %w\", err)\n236\t\t}\n237\t\n238\t\tif err := f.Close(); err != nil {\n239\t\t\treturn fmt.Errorf(\"cannot write the history entry: %w\", err)\n240\t\t}\n241\t\n242\t\treturn nil\n243\t}\n244\t\n245\t// trim enforces the per-source cap, rewriting the file only when some source is\n246\t// over it. The common append leaves the file alone.\n247\tfunc trim(path string) error {\n248\t\tdata, err := os.ReadFile(path)\n249\t\tif err != nil {\n250\t\t\treturn fmt.Errorf(\"cannot read the history file: %w\", err)\n251\t\t}\n252\t\n253\t\tall := lines(data)\n254\t\tsources := make([]Source, len(all))\n255\t\treadable := make([]bool, len(all))\n256\t\tcounts := map[Source]int{}\n257\t\tfor i, line := range all {\n258\t\t\thead, ok := lineHead(line)\n259\t\t\tsources[i], readable[i] = head.Source, ok\n260\t\t\tif ok {\n261\t\t\t\tcounts[head.Source]++\n262\t\t\t}\n263\t\t}\n264\t\n265\t\tdrop := map[Source]int{}\n266\t\tfor source, n := range counts {\n267\t\t\tif n > maxPerSource {\n268\t\t\t\tdrop[source] = n - maxPerSource\n269\t\t\t}\n270\t\t}\n271\t\tif len(drop) == 0 {\n272\t\t\treturn nil\n273\t\t}\n274\t\n275\t\t// Oldest first: the file is in append order, so dropping the first n lines\n276\t\t// of an over-cap source keeps the newest maxPerSource of it, and every other\n277\t\t// source stays exactly where it was.\n278\t\tvar kept bytes.Buffer\n279\t\tfor i, line := range all {\n280\t\t\tif !readable[i] {\n281\t\t\t\t// The rewrite is the one moment a line nothing can parse can be\n282\t\t\t\t// dropped without losing anything Read would have returned.\n283\t\t\t\tcontinue\n284\t\t\t}\n285\t\t\tif drop[sources[i]] > 0 {\n286\t\t\t\tdrop[sources[i]]--\n287\t\t\t\tcontinue\n288\t\t\t}\n289\t\t\tkept.Write(line)\n290\t\t\tkept.WriteByte('\\n')\n291\t\t}\n292\t\n293\t\treturn replace(path, kept.Bytes())\n294\t}\n295\t\n296\t// replace swaps the file's contents atomically, so a reader never sees a\n297\t// half-written store and a crash mid-trim leaves the old file intact.\n298\tfunc replace(path string, data []byte) error {\n299\t\tdir := filepath.Dir(path)\n300\t\n301\t\ttmp, err := os.CreateTemp(dir, \".history-*\")\n302\t\tif err != nil {\n303\t\t\treturn fmt.Errorf(\"cannot stage the trimmed history: %w\", err)\n304\t\t}\n305\t\t// A no-op once the rename has happened, and the cleanup for every path where\n306\t\t// it has not.\n307\t\tdefer os.Remove(tmp.Name()) //nolint:errcheck // Best effort; the file is 0600 in the state dir.\n308\t\n309\t\t// CreateTemp already opens at 0600; the Chmod makes that a stated guarantee\n310\t\t// rather than an inherited default.\n311\t\tif err := tmp.Chmod(fileMode); err != nil {\n312\t\t\ttmp.Close() //nolint:errcheck // The Chmod failure is the one worth reporting.\n313\t\t\treturn fmt.Errorf(\"cannot secure the trimmed history: %w\", err)\n314\t\t}\n315\t\tif _, err := tmp.Write(data); err != nil {\n316\t\t\ttmp.Close() //nolint:errcheck // The Write failure is the one worth reporting.\n317\t\t\treturn fmt.Errorf(\"cannot write the trimmed history: %w\", err)\n318\t\t}\n319\t\tif err := tmp.Close(); err != nil {\n320\t\t\treturn fmt.Errorf(\"cannot write the trimmed history: %w\", err)\n321\t\t}\n322\t\n323\t\tif err := os.Rename(tmp.Name(), path); err != nil {\n324\t\t\treturn fmt.Errorf(\"cannot replace the history file: %w\", err)\n325\t\t}\n326\t\n327\t\treturn nil\n328\t}\n329\t\n330\t// entryHead is the part of a stored line the store itself consults: the source\n331\t// the retention cap counts by, and the id a new one must not collide with.\n332\ttype entryHead struct {\n333\t\tID     string `json:\"id\"`\n334\t\tSource Source `json:\"source\"`\n335\t}\n336\t\n337\t// lineHead reads that head off a stored line, reporting whether the line parses\n338\t// at all. Trimming and id assignment work from the raw bytes rather than from\n339\t// decoded entries so a rewrite reproduces what was written, byte for byte.\n340\tfunc lineHead(line []byte) (entryHead, bool) {\n341\t\tvar head entryHead\n342\t\tif err := json.Unmarshal(line, &head); err != nil {\n343\t\t\treturn entryHead{}, false\n344\t\t}\n345\t\n346\t\treturn head, true\n347\t}\n348\t\n349\t// lines splits the store into its non-empty lines.\n350\tfunc lines(data []byte) [][]byte {\n351\t\tvar out [][]byte\n352\t\tfor _, line := range bytes.Split(data, []byte(\"\\n\")) {\n353\t\t\tif len(bytes.TrimSpace(line)) == 0 {\n354\t\t\t\tcontinue\n355\t\t\t}\n356\t\t\tout = append(out, line)\n357\t\t}\n358\t\n359\t\treturn out\n360\t}\n361\t\n362\t// stateDir is $XDG_STATE_HOME/talaria, falling back to ~/.local/state/talaria.\n363\t// The lookup is spelled out because Go's os package has no UserStateDir; the\n364\t// fallback is the one the XDG spec itself names. A relative XDG_STATE_HOME is\n365\t// ignored, as the spec requires.\n366\tfunc stateDir() (string, error) {\n367\t\tif dir := os.Getenv(\"XDG_STATE_HOME\"); filepath.IsAbs(dir) {\n368\t\t\treturn filepath.Join(dir, \"talaria\"), nil\n369\t\t}\n370\t\n371\t\thome, err := os.UserHomeDir()\n372\t\tif err != nil {\n373\t\t\tr