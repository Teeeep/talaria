type: string}, tag: {type: string}}}}}}}}}\n  /binary: {get: {operationId: binaryOp, responses: {'200': {description: ok}}}}\n  /big: {get: {operationId: bigOp, responses: {'200': {description: ok}}}}\n  /empty: {get: {operationId: emptyOp, responses: {'204': {description: none}}}}\nEOF\nexport XDG_CONFIG_HOME=/tmp/tal/cfg XDG_STATE_HOME=/tmp/tal/state\necho \"--- chunked/unicode/multi-header\"; /tmp/talaria-int call ./resp.yaml chunkedOp | jq -c '{s:.response.status,h:.response.headers,name:.response.body.name,v:.validation}'\necho \"--- binary\"; /tmp/talaria-int call ./resp.yaml binaryOp 2>&1 | head -c 400; echo; echo \"rc=$?\"\necho \"--- big\"; /tmp/talaria-int call ./resp.yaml bigOp | jq -c '{s:.response.status, len:(.response.body.tag|length)}'\necho \"--- 204 empty\"; /tmp/talaria-int call ./resp.yaml emptyOp | jq -c .",
