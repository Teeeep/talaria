          "content": "# The operations whose curl rendering differs from the config document talaria\n# actually executes, or would if the two ever drifted: a GET carrying a body, a\n# HEAD, a cookie parameter and a form body. Kept out of e2e-api.yaml so that\n# file stays the exact counterpart of e2e-api-2.0.json, which is what makes the\n# Swagger 2.0 run a test of the conversion rather than of a second API.\n#\n# Every path here is one the e2e server already answers, so the reproduction\n# test needs no routes of its own.\nopenapi: 3.0.3\ninfo:\n  title: Talaria E2E Reproduction API\n  version: 1.0.0\nservers:\n  - url: https://api.invalid/v1\ncomponents:\n  schemas:\n    Pet:\n      type: object\n      required: [id, name]\n      properties:\n        id:\n          type: string\n        name:\n          type: string\n  securitySchemes:\n    bearerAuth:\n      type: http\n      scheme: bearer\n# Document-level, so every case below carries a credential the rendered command\n# has to reproduce as an expandable $TALARIA_AUTH_BEARER.\nsecurity:\n  - bearerAuth: []\npaths:\n  /pets:\n    get:\n      operationId: searchPets\n      summary: List pets, with the filter in a body\n      tags: [pets]\n      # Legal and rare: a GET with a body is the one case where curl's default\n      # method is not what talaria sends, because --data-raw switches it to POST.\n      requestBody:\n        required: false\n        content:\n          application/json:\n            schema:\n              type: object\n              properties:\n                name:\n                  type: string\n      responses:\n        \"200\":\n          description: The pets\n          content:\n            application/json:\n              schema:\n                type: array\n                items:\n                  $ref: \"#/components/schemas/Pet\"\n    head:\n      operationId: checkPets\n      summary: Headers only\n      tags: [pets]\n      responses:\n        \"200\":\n          description: The headers of the pet list\n    post:\n      operationId: createPetForm\n      summary: Create a pet from a form body\n      tags: [pets]\n      requestBody:\n        required: true\n        content:\n          application/x-www-form-urlencoded:\n            schema:\n              type: object\n              required: [name]\n              properties:\n                name:\n                  type: string\n      responses:\n        \"201\":\n          description: Created\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"\n  /pets/{petId}:\n    get:\n      operationId: sessionPets\n      summary: Fetch one pet, identified by a session cookie\n      tags: [pets]\n      parameters:\n        - name: petId\n          in: path\n          required: true\n          schema:\n            type: string\n            example: \"42\"\n        - name: session\n          in: cookie\n          required: true\n          schema:\n            type: string\n      responses:\n        \"200\":\n          description: The pet\n          content:\n            application/json:\n              schema:\n                $ref: \"#/components/schemas/Pet\"\n"
        },
