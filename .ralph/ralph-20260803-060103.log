        "type": "tool_result",
        "content": "88\t\t}\n89\t}\n90\t\n91\t// TestAgentDocInvocationsAreAcceptedAsWritten runs every command the doc shows\n92\t// in a fenced block, exactly as written, and requires it not to be a usage\n93\t// error. The tests above read command names, exit codes and variable names;\n94\t// none of them read a flag's argument, which is how the headline `call` example\n95\t// came to say `--header 'X-Trace: abc'` when the parser takes `X-Trace=abc`.\n96\t// That line exits 2, and it is the one line a model copies verbatim.\n97\tfunc TestAgentDocInvocationsAreAcceptedAsWritten(t *testing.T) {\n98\t\tfixture := filepath.Join(\"testdata\", \"call.yaml\")\n99\t\n100\t\t// The doc writes the spec as `./openapi.yaml`, and omits it entirely where it\n101\t\t// is showing that $TALARIA_SPEC replaces the argument. Both have to land on a\n102\t\t// real spec for the invocation to get as far as its flags.\n103\t\tt.Setenv(spec.EnvSpec, fixture)\n104\t\n105\t\tfor _, invocation := range fencedInvocations(t, readAgentDoc(t)) {\n106\t\t\tt.Run(invocation, func(t *testing.T) {\n107\t\t\t\tif reason := notRunnable[invocation]; reason != \"\" {\n108\t\t\t\t\tt.Skip(reason)\n109\t\t\t\t}\n110\t\n111\t\t\t\targs := shellFields(t, invocation)[1:]\n112\t\t\t\tfor i, arg := range args {\n113\t\t\t\t\tif arg == docSpecPath {\n114\t\t\t\t\t\targs[i] = fixture\n115\t\t\t\t\t}\n116\t\t\t\t}\n117\t\t\t\t// Appended rather than assumed: --dry-run is `call`'s flag, and adding\n118\t\t\t\t// it to `list` or `auth check` would itself be the usage error under\n119\t\t\t\t// test. Every command that has it is one that would otherwise send a\n120\t\t\t\t// request to the fixture's deliberately unroutable server.\n121\t\t\t\tif hasDryRun(newRootCmd(), args) && !slices.Contains(args, \"--dry-run\") {\n122\t\t\t\t\targs = append(args, \"--dry-run\")\n123\t\t\t\t}\n124\t\n125\t\t\t\tvar stdout, stderr strings.Builder\n126\t\t\t\tif code := run(args, &stdout, &stderr); code == int(clierr.CodeUsage) {\n127\t\t\t\t\tt.Errorf(\"AGENT.md shows `%s`, which exits 2: %s\", invocation, stderr.String())\n128\t\t\t\t}\n129\t\t\t})\n130\t\t}\n131\t}\n132\t\n133\t// docSpecPath is the placeholder path the doc uses for the user's own spec.\n134\tconst docSpecPath = \"./openapi.yaml\"\n135\t\n136\t// TestDocsWriteHeadersAsNameEqualsValue covers the prose that the test above\n137\t// cannot execute. An inline `--header 'X-Api-Key: sk-live-…'` sits outside every\n138\t// fenced block and is copied just as readily as one inside — and a header the\n139\t// parser rejects is a header whose value reached an error message.\n140\tfunc TestDocsWriteHeadersAsNameEqualsValue(t *testing.T) {\n141\t\tfor _, path := range []string{agentDocPath, readmePath} {\n142\t\t\tbody, err := os.ReadFile(path)\n143\t\t\tif err != nil {\n144\t\t\t\tt.Fatalf(\"reading %s: %v\", path, err)\n145\t\t\t}\n146\t\n147\t\t\tfor _, match := range headerColonForm.FindAllString(string(body), -1) {\n148\t\t\t\tt.Errorf(\"%s writes `%s…`; talaria's --header takes name=value, and this exits 2\",\n149\t\t\t\t\tpath, strings.TrimSpace(match))\n150\t\t\t}\n151\t\t}\n152\t}\n153\t\n154\t// headerColonForm matches a `--header` whose argument is written curl's way,\n155\t// `Name: value`, quoted or not. `--header` with no argument after it — the way\n156\t// both docs refer to the flag in passing — has no colon and does not match.\n157\tvar headerColonForm = regexp.MustCompile(`--header\\s+['\"]?[A-Za-z][A-Za-z0-9-]*\\s*:`)\n158\t\n159\t// notRunnable holds the fenced invocations that cannot be executed here, keyed\n160\t// by the line as the doc writes it so that editing the line brings the reason\n161\t// back for review rather than silently disabling the check. Narrowing the\n162\t// extraction instead would have hidden them.\n163\tvar notRunnable = map[string]string{\n164\t\t\"talaria run ./openapi.yaml --tag pets --operation getPet --base-url http://localhost:9000\": \"\" +\n165\t\t\t\"`run` has no --dry-run — sending the requests is what it is for — and this example \" +\n166\t\t\t\"points at a host that is not listening\",\n167\t\t\"talaria history show 2026-08-02T21:40:11.183204Z\": \"\" +\n168\t\t\t\"names one recorded entry by id; the id is an illustration and the isolated history \" +\n169\t\t\t\"these tests run against is empty\",\n170\t}\n171\t\n172\t// fencedInvocations extracts the commands the doc shows in fenced blocks, which\n173\t// unlike the inline code spans docInvocations reads are written to be run: they\n174\t// carry real arguments rather than `<operationId>` placeholders.\n175\tfunc fencedInvocations(t *testing.T, doc string) []string {\n176\t\tt.Helper()\n177\t\n178\t\tvar out []string\n179\t\tfenced := false\n180\t\tfor _, line := range strings.Split(doc, \"\\n\") {\n181\t\t\tif strings.HasPrefix(line, \"```\") {\n182\t\t\t\tfenced = !fenced\n183\t\t\t\tcontinue\n184\t\t\t}\n185\t\t\tif fenced && strings.HasPrefix(line, \"talaria \") {\n186\t\t\t\tout = append(out, strings.TrimSpace(line))\n187\t\t\t}\n188\t\t}\n189\t\n190\t\tif len(out) == 0 {\n191\t\t\tt.Fatal(\"AGENT.md shows no runnable command in a fenced block\")\n192\t\t}\n193\t\n194\t\treturn out\n195\t}\n196\t\n197\t// hasDryRun reports whether the command args name accepts --dry-run. It resolves\n198\t// the command rather than matching on its name so that a second command growing\n199\t// the flag is covered without a change here.\n200\tfunc hasDryRun(root *cobra.Command, args []string) bool {\n201\t\tcmd, _, err := root.Find(args)\n202\t\treturn err == nil && cmd.Flags().Lookup(\"dry-run\") != nil\n203\t}\n204\t\n205\t// shellFields splits an invocation into arguments the way a shell would, so an\n206\t// example is executed as the reader's shell would execute it. Splitting on\n207\t// whitespace alone would turn `--header 'X-Trace: abc'` into two mangled"
      }
