/build.go                          |  546 ++++++++++\n internal/request/request.go                        |  319 ++++++\n internal/request/request_test.go                   | 1021 ++++++++++++++++++\n internal/request/testdata/request.yaml             |   84 ++\n internal/secret/redact.go                          |  131 +++\n internal/secret/response.go                        |  265 +++++\n internal/secret/response_test.go                   |  289 +++++\n internal/secret/secret.go                          |  138 +++\n internal/secret/secret_test.go                     |  331 ++++++\n internal/spec/convert.go                           |   92 ++\n internal/spec/convert_test.go                      |  209 ++++\n internal/spec/load.go                              |   89 ++\n internal/spec/load_test.go                         |  224 ++++\n internal/spec/source.go                            |  184 ++++\n internal/spec/source_test.go                       |  235 +++++\n internal/spec/spec.go                              |   29 +\n internal/spec/testdata/local-file-ref.yaml         |   11 +\n internal/spec/testdata/malformed.yaml              |    8 +\n internal/spec/testdata/petstore-2.0.json           |  165 +++\n internal/spec/testdata/petstore-3.0.yaml           |   69 ++\n internal/spec/testdata/petstore-3.1.json           |   91 ++\n internal/spec/testdata/swagger2-apikey.json        |  119 +++\n internal/spec/testdata/swagger2.yaml               |   76 ++\n .../spec/testdata/unresolvable-remote-ref.yaml     |   11 +\n internal/validate/testdata/petstore-3.0.yaml       |   79 ++\n internal/validate/testdata/strict-3.0.yaml         |   56 +\n internal/validate/validate.go                      |  189 ++++\n internal/validate/validate_test.go                 |  289 +++++\n tasks.json                                         |   56 +\n 143 files changed, 31647 insertions(+), 5 deletions(-)",
