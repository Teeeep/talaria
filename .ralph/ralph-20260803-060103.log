        "content": "72\tfunc TestAuthCheckReportsPresenceInTheDocumentedShape(t *testing.T) {\n73\t\tisolateAuthEnv(t)\n74\t\tt.Setenv(config.EnvBearer, authCanary)\n75\t\n76\t\tcode, stdout, stderr := runAuth(t, \"testdata/auth.yaml\", \"--output\", \"json\")\n77\t\tif code != 0 {\n78\t\t\tt.Fatalf(\"auth check = %d, want 0; stderr: %s\", code, stderr)\n79\t\t}\n80\t\n81\t\tgot := decodeAuth(t, stdout)\n82\t\tif got.Schema != \"talaria/v1\" {\n83\t\t\tt.Errorf(\"schema = %q, want talaria/v1\", got.Schema)\n84\t\t}\n85\t\tif len(got.Schemes) != 1 {\n86\t\t\tt.Fatalf(\"reported %d schemes, want 1:\\n%s\", len(got.Schemes), stdout)\n87\t\t}\n88\t\n89\t\t// The §4 sketch, character for character: an agent prompt keys off these\n90\t\t// three fields, and the source is the *name* an agent asks a human to set.\n91\t\twant := `{\"scheme\":\"bearerAuth\",\"source\":\"env:TALARIA_AUTH_BEARER\",\"present\":true}`\n92\t\tif got := string(got.Schemes[0]); got != want {\n93\t\t\tt.Errorf(\"scheme entry =\\n %s\\nwant\\n %s\", got, want)\n94\t\t}\n95\t}\n96\t\n97\tfunc TestAuthCheckExitsFiveWhenTheCredentialIsMissing(t *testing.T) {\n98\t\tisolateAuthEnv(t)\n99\t\n100\t\tcode, stdout, stderr := runAuth(t, \"testdata/auth.yaml\", \"--output\", \"json\")\n101\t\t// Not 2: a missing credential is a fixable environment problem, and §4 gives\n102\t\t// it its own code so an agent asks the human to set the variable instead of\n103\t\t// re-reading its own invocation.\n104\t\tif code != int(clierr.CodeCredentialMissing) {\n105\t\t\tt.Fatalf(\"auth check = %d, want 5; stderr: %s\", code, stderr)\n106\t\t}\n107\t\n108\t\tgot := decodeAuth(t, stdout)\n109\t\tif len(got.Schemes) != 1 {\n110\t\t\tt.Fatalf(\"reported %d schemes, want 1:\\n%s\", len(got.Schemes), stdout)\n111\t\t}\n112\t\n113\t\twant := `{\"scheme\":\"bearerAuth\",\"source\":\"env:TALARIA_AUTH_BEARER\",\"present\":false}`\n114\t\tif got := string(got.Schemes[0]); got != want {\n115\t\t\tt.Errorf(\"scheme entry =\\n %s\\nwant\\n %s\", got, want)\n116\t\t}\n117\t\n118\t\t// The error is the actionable half: it names the variable to export.\n119\t\tif err := decodeErr(t, stderr); err.Error.Code != int(clierr.CodeCredentialMissing) ||\n120\t\t\t!strings.Contains(err.Error.Message, \"$\"+config.EnvBearer) {\n121\t\t\tt.Errorf(\"error = %+v, want code 5 naming $%s\", err.Error, config.EnvBearer)\n122\t\t}\n123\t}\n124\t\n125\tfunc TestAuthCheckReportsEverySchemeTheSpecDeclares(t *testing.T) {\n126\t\t// call.yaml declares a bearer scheme and a query API key, and has an\n127\t\t// operation that requires each.\n128\t\tisolateAuthEnv(t)\n129\t\tt.Setenv(config.EnvBearer, authCanary)\n130\t\n131\t\tcode, stdout, stderr := runAuth(t, \"testdata/call.yaml\", \"--output\", \"json\")\n132\t\tif code != int(clierr.CodeCredentialMissing) {\n133\t\t\tt.Fatalf(\"auth check = %d, want 5 with petKey unset; stderr: %s\", code, stderr)\n134\t\t}\n135\t\n136\t\tentries := decodeAuthEntries(t, stdout)\n137\t\tif len(entries) != 2 {\n138\t\t\tt.Fatalf(\"reported %d schemes, want 2:\\n%s\", len(entries), stdout)\n139\t\t}\n140\t\tif !entries[\"bearerAuth\"].Present {\n141\t\t\tt.Error(\"bearerAuth reported absent, but its variable is set\")\n142\t\t}\n143\t\tif entries[\"petKey\"].Present {\n144\t\t\tt.Error(\"petKey reported present, but its variable is unset\")\n145\t\t}\n146\t\tif want := \"env:TALARIA_AUTH_APIKEY_PETKEY\"; entries[\"petKey\"].Source != want {\n147\t\t\tt.Errorf(\"petKey source = %q, want %q\", entries[\"petKey\"].Source, want)\n148\t\t}\n149\t\n150\t\tif err := decodeErr(t, stderr); !strings.Contains(err.Error.Message, \"petKey\") {\n151\t\t\tt.Errorf(\"error message = %q, want it to name the unsatisfied scheme\", err.Error.Message)\n152\t\t}\n153\t}\n154\t\n155\tfunc TestAuthCheckSucceedsWhenEverySchemeIsSatisfied(t *testing.T) {\n156\t\tisolateAuthEnv(t)\n157\t\tt.Setenv(config.EnvBearer, authCanary)\n158\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_PETKEY\", authCanary)\n159\t\n160\t\tcode, stdout, stderr := runAuth(t, \"testdata/call.yaml\", \"--output\", \"json\")\n161\t\tif code != 0 {\n162\t\t\tt.Fatalf(\"auth check = %d, want 0; stderr: %s\", code, stderr)\n163\t\t}\n164\t\n165\t\tfor name, entry := range decodeAuthEntries(t, stdout) {\n166\t\t\tif !entry.Present {\n167\t\t\t\tt.Errorf(\"%s reported absent, but its variable is set\", name)\n168\t\t\t}\n169\t\t}\n170\t}\n171\t\n172\tfunc TestAuthCheckReportsTheProfilesVariableAsTheSource(t *testing.T) {\n173\t\tisolateAuthEnv(t)\n174\t\twriteRedactConfig(t, \"profiles:\\n  staging:\\n    auth:\\n      bearerAuth: ${\"+authProfileVar+\"}\\n\")\n175\t\t// The convention's variable is deliberately left unset: the credential can\n176\t\t// only be found through the profile.\n177\t\tt.Setenv(authProfileVar, authCanary)\n178\t\n179\t\tcode, stdout, stderr := runAuth(t, \"testdata/auth.yaml\", \"--profile\", \"staging\", \"--output\", \"json\")\n180\t\tif code != 0 {\n181\t\t\tt.Fatalf(\"auth check --profile = %d, want 0; stderr: %s\", code, stderr)\n182\t\t}\n183\t\n184\t\tentry := decodeAuthEntries(t, stdout)[\"bearerAuth\"]\n185\t\tif want := \"env:\" + authProfileVar; entry.Source != want {\n186\t\t\tt.Errorf(\"bearerAuth source = %q, want %q\", entry.Source, want)\n187\t\t}\n188\t\tif !entry.Present {\n189\t\t\tt.Error(\"bearerAuth reported absent, but the profile's variable is set\")\n190\t\t}\n191\t}\n192\t\n193\tfunc TestAuthCheckNeverPrintsTheValueInAnyFormat(t *testing.T) {\n194\t\tfor _, format := range []string{\"json\", \"pretty\", \"tsv\"} {\n195\t\t\tt.Run(format, func(t *testing.T) {\n196\t\t\t\tisolateAuthEnv(t)\n197\t\t\t\tt.Setenv(config.EnvBearer, authCanary)\n198\t\n199\t\t\t\t// runAuth fails the test if the canary appears on either stream.\n200\t\t\t\tcode, stdout, stderr := runAuth(t, \"testdata/auth.yaml\", \"--output\", format)\n201\t\t\t\tif code != 0 {\n202\t\t\t\t\tt.Fatalf(\"auth check --output %s = %d, want 0; stderr: %s\", format, code, stderr)\n203\t\t\t\t}\n204\t\t\t\tif !string