        "content": "1\t//go:build unix\n2\t\n3\tpackage curl\n4\t\n5\timport (\n6\t\t\"os/exec\"\n7\t\t\"syscall\"\n8\t)\n9\t\n10\t// isolate puts curl in a process group of its own and makes the context's\n11\t// cancellation signal that whole group rather than curl alone.\n12\t//\n13\t// exec's default Cancel kills the one process it started. curl can have\n14\t// children of its own — an ssh for a `socks5h://` proxy, a helper for an\n15\t// unusual scheme — and those are what get reparented to init and left running\n16\t// with the credential still in flight. Signalling `-pgid` takes the tree.\n17\t//\n18\t// The group also stops a Ctrl-C in a terminal from reaching curl twice: the\n19\t// shell sends SIGINT to the foreground group, and curl is no longer in it, so\n20\t// the only thing that stops curl is talaria deciding to stop it — after which\n21\t// talaria's own defers still run.\n22\tfunc isolate(cmd *exec.Cmd) {\n23\t\tcmd.SysProcAttr = &syscall.SysProcAttr{Setpgid: true}\n24\t\n25\t\tcmd.Cancel = func() error {\n26\t\t\t// Start failed, so there is no group to signal.\n27\t\t\tif cmd.Process == nil {\n28\t\t\t\treturn nil\n29\t\t\t}\n30\t\n31\t\t\t// Setpgid with no Pgid makes the child its own group leader, so its pid\n32\t\t\t// is the group id and the negative of it addresses the group.\n33\t\t\tif err := syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL); err != nil {\n34\t\t\t\t// The group is already gone, or was never formed; the single-process\n35\t\t\t\t// kill is what exec would have done anyway.\n36\t\t\t\treturn cmd.Process.Kill()\n37\t\t\t}\n38\t\n39\t\t\treturn nil\n40\t\t}\n41\t}\n42\t"
