        "content": "1\tpackage canary_test\n2\t\n3\timport (\n4\t\t\"encoding/base64\"\n5\t\t\"errors\"\n6\t\t\"fmt\"\n7\t\t\"io\"\n8\t\t\"io/fs\"\n9\t\t\"net/http\"\n10\t\t\"net/http/httptest\"\n11\t\t\"net/url\"\n12\t\t\"os\"\n13\t\t\"os/exec\"\n14\t\t\"path/filepath\"\n15\t\t\"strings\"\n16\t\t\"sync\"\n17\t\t\"testing\"\n18\t\n19\t\t\"github.com/Teeeep/talaria/internal/canary\"\n20\t)\n21\t\n22\t// specPath is the fixture declaring one security scheme per auth mechanism.\n23\tconst specPath = \"testdata/canary.yaml\"\n24\t\n25\t// binary is the talaria under test, built once by TestMain.\n26\t//\n27\t// The suite drives a real process rather than calling the command tree\n28\t// in-process, for one reason: the command tree lives in package main and cannot\n29\t// be imported. Running the binary is also the stronger reading of §5a — it\n30\t// greps every byte the process emits, including anything written outside the\n31\t// writers a test would otherwise hand it.\n32\tvar binary string\n33\t\n34\tfunc TestMain(m *testing.M) {\n35\t\tdir, err := os.MkdirTemp(\"\", \"talaria-canary-*\")\n36\t\tif err != nil {\n37\t\t\tfmt.Fprintf(os.Stderr, \"creating the build directory: %v\\n\", err)\n38\t\t\tos.Exit(1)\n39\t\t}\n40\t\n41\t\tif err := readSources(); err != nil {\n42\t\t\tfmt.Fprintf(os.Stderr, \"reading the sources under test: %v\\n\", err)\n43\t\t\tos.Exit(1)\n44\t\t}\n45\t\n46\t\tbinary = filepath.Join(dir, \"talaria\")\n47\t\tbuild := exec.Command(\"go\", \"build\", \"-o\", binary, \"./cmd/talaria\")\n48\t\tbuild.Dir = filepath.Join(\"..\", \"..\")\n49\t\tif out, err := build.CombinedOutput(); err != nil {\n50\t\t\tfmt.Fprintf(os.Stderr, \"building talaria: %v\\n%s\", err, out)\n51\t\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n52\t\t\tos.Exit(1)\n53\t\t}\n54\t\n55\t\tcode := m.Run()\n56\t\n57\t\t// Explicit rather than deferred: os.Exit does not run defers.\n58\t\tos.RemoveAll(dir) //nolint:errcheck // Best effort; it is a temp dir.\n59\t\tos.Exit(code)\n60\t}\n61\t\n62\t// readSources opens every Go source file in the module so the test cache knows\n63\t// this suite depends on all of them.\n64\t//\n65\t// It has to be said out loud because the dependency is invisible to the tool:\n66\t// the suite reaches the code under test by building a binary in a subprocess,\n67\t// and `go test` records nothing about that. Without this, a leak introduced in\n68\t// internal/curl or cmd/talaria would leave the canary package's own inputs\n69\t// untouched, and `go test ./...` would replay a cached pass over code that\n70\t// never ran. A gate that can go stale is not a gate. The test cache does track\n71\t// files a test reads, so reading them is how the dependency is declared.\n72\tfunc readSources() error {\n73\t\troot := filepath.Join(\"..\", \"..\")\n74\t\n75\t\treturn filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {\n76\t\t\tif err != nil || d.IsDir() || !strings.HasSuffix(path, \".go\") {\n77\t\t\t\treturn err\n78\t\t\t}\n79\t\n80\t\t\t_, err = os.ReadFile(path)\n81\t\n82\t\t\treturn err\n83\t\t})\n84\t}\n85\t\n86\t// mechanism is one way of authenticating, driven end to end with its own\n87\t// canary. Received proves the credential actually reached the server, which is\n88\t// what makes the absence of it everywhere else mean something: a call that\n89\t// quietly sent nothing would pass every leak assertion.\n90\ttype mechanism struct {\n91\t\tname string\n92\t\top   string\n93\t\t// env builds the environment carrying the canary, keyed by variable name.\n94\t\tenv func(value string) map[string]string\n95\t\t// received reports whether the server saw the canary on the request.\n96\t\treceived func(req recordedRequest, value string) bool\n97\t}\n98\t\n99\tvar mechanisms = []mechanism{\n100\t\t{\n101\t\t\tname: \"bearer\",\n102\t\t\top:   \"getBearer\",\n103\t\t\tenv:  func(v string) map[string]string { return map[string]string{\"TALARIA_AUTH_BEARER\": v} },\n104\t\t\treceived: func(req recordedRequest, v string) bool {\n105\t\t\t\treturn req.Header.Get(\"Authorization\") == \"Bearer \"+v\n106\t\t\t},\n107\t\t},\n108\t\t{\n109\t\t\tname: \"basic\",\n110\t\t\top:   \"getBasic\",\n111\t\t\tenv: func(v string) map[string]string {\n112\t\t\t\treturn map[string]string{\"TALARIA_AUTH_BASIC\": \"canaryuser:\" + v}\n113\t\t\t},\n114\t\t\treceived: func(req recordedRequest, v string) bool {\n115\t\t\t\t// Basic auth is the one mechanism that encodes the credential before\n116\t\t\t\t// it goes on the wire, which is why Scan looks for base64 too.\n117\t\t\t\twant := \"Basic \" + base64.StdEncoding.EncodeToString([]byte(\"canaryuser:\"+v))\n118\t\t\t\treturn req.Header.Get(\"Authorization\") == want\n119\t\t\t},\n120\t\t},\n121\t\t{\n122\t\t\tname: \"apikey-header\",\n123\t\t\top:   \"getHeaderKey\",\n124\t\t\tenv: func(v string) map[string]string {\n125\t\t\t\treturn map[string]string{\"TALARIA_AUTH_APIKEY_HEADERKEY\": v}\n126\t\t\t},\n127\t\t\treceived: func(req recordedRequest, v string) bool {\n128\t\t\t\treturn req.Header.Get(\"X-Api-Key\") == v\n129\t\t\t},\n130\t\t},\n131\t\t{\n132\t\t\tname: \"apikey-query\",\n133\t\t\top:   \"getQueryKey\",\n134\t\t\tenv: func(v string) map[string]string {\n135\t\t\t\treturn map[string]string{\"TALARIA_AUTH_APIKEY_QUERYKEY\": v}\n136\t\t\t},\n137\t\t\treceived: func(req recordedRequest, v string) bool {\n138\t\t\t\treturn req.Query.Get(\"api_key\") == v\n139\t\t\t},\n140\t\t},\n141\t\t{\n142\t\t\tname: \"apikey-cookie\",\n143\t\t\top:   \"getCookieKey\",\n144\t\t\tenv: func(v string) map[string]string {\n145\t\t\t\treturn map[string]string{\"TALARIA_AUTH_APIKEY_COOKIEKEY\": v}\n146\t\t\t},\n147\t\t\treceived: func(req recordedRequest, v string) bool {\n148\t\t\t\treturn req.Cookies[v] || strings.Contains(req.Header.Get(\"Cookie\"), v)\n149\t\t\t},\n150\t\t},\n151\t}\n152\t\n153\t// result is one talaria invocation.\n154\ttype result struct {\n155\t\targs   []string\n156\t\tcode   int\n157\t\tstdout string\n158\t\tstderr string\n159\t}\n160\t\n161\t// harness runs talaria against an isolated home, so the only credentials in\n162\t// reach are the ones a case injected and the only files it can write are ones\n163\t// the case can then read back and grep.\n164\ttype harness struct {\n165\t\tt   *testing.T\n166\t\tenv []string\n167\t\t// home is $HOME for the run: the directory curl looks in for .curlrc, and\n168\t\t// the parent of the three XDG roots below.\n169\t\thome  string\n170\t\tstate string\n171\t\tcache string\n172\t\tconf  string\n173\t}\n174\t\n175\tfunc newHarness(t *testing.T, vars map[string]string) *harness {\n176\t\tt.Helper()\n177\t\n178\t\thome := t.TempDir()\n179\t\th := &harness{\n180\t\t\tt:     t,\n181\t\t\thome:  home,\n182\t\t\tstate: filepath.Join(home, \"state\"),\n183\t\t\tcache: filepath.Join(home, \"cache\"),\n184\t\t\tconf:  filepath.Join(home, \"config\"),\n185\t\t}\n186\t\n187\t\t// Built from nothing rather than from os.Environ: a developer's own\n188\t\t// TALARIA_AUTH_BEARER or TALARIA_SPEC must not be able to change what this\n189\t\t// suite tests, and PATH is all curl needs to be found.\n190\t\th.env = []string{\n191\t\t\t\"PATH=\" + os.Getenv(\"PATH\"),\n192\t\t\t\"HOME=\" + home,\n193\t\t\t\"XDG_STATE_HOME=\" + h.state,\n194\t\t\t\"XDG_CACHE_HOME=\" + h.cache,\n195\t\t\t\"XDG_CONFIG_HOME=\" + h.conf,\n196\t\t}\n197\t\tfor name, value := range vars {\n198\t\t\th.env = append(h.env, name+\"=\"+value)\n199\t\t}\n200\t\n201\t\treturn h\n202\t}\n203\t\n204\t// run executes talaria and captures both streams.\n205\tfunc (h *harness) run(args ...string) result {\n206\t\th.t.Helper()\n207\t\n208\t\tcmd := exec.Command(binary, args...)\n209\t\tcmd.Env = h.env\n210\t\n211\t\tvar stdout, stderr strings.Builder\n212\t\tcmd.Stdout, cmd.Stderr = &stdout, &stderr\n213\t\n214\t\tcode := 0\n215\t\tif err := cmd.Run(); err != nil {\n216\t\t\tvar exit *exec.ExitError\n217\t\t\tif !errors.As(err, &exit) {\n218\t\t\t\th.t.Fatalf(\"running talaria %s: %v\", strings.Join(args, \" \"), err)\n219\t\t\t}\n220\t\t\tcode = exit.ExitCode()\n221\t\t}\n222\t\n223\t\treturn result{args: args, code: code, stdout: stdout.String(), stderr: stderr.String()}\n224\t}\n225\t\n226\t// runOK runs talaria and fails the test unless it exited 0.\n227\tfunc (h *harness) runOK(args ...string) result {\n228\t\th.t.Helper()\n229\t\n230\t\tres := h.run(args...)\n231\t\tif res.code != 0 {\n232\t\t\th.t.Fatalf(\"talaria %s = %d, want 0; stderr: %s\",\n233\t\t\t\tstrings.Join(args, \" \"), res.code, res.stderr)\n234\t\t}\n235\t\n236\t\treturn res\n237\t}\n238\t\n239\t// surfaces returns both streams of a result as scannable surfaces.\n240\tfunc (r result) surfaces() []canary.Surface {\n241\t\tlabel := strings.Join(r.args, \" \")\n242\t\n243\t\treturn []canary.Surface{\n244\t\t\tcanary.Stream(\"stdout of `talaria \"+label+\"`\", r.stdout),\n245\t\t\tcanary.Stream(\"stderr of `talaria \"+label+\"`\", r.stderr),\n246\t\t}\n247\t}\n248\t\n249\t// written returns every file talaria left behind: the history store, the spec\n250\t// cache, anything a future version starts writing into the same directories.\n251\t// Enumerated by walking, not by name, so a new persistent artifact is covered\n252\t// the day it appears.\n253\t//\n254\t// The config directory is deliberately not among them. Nothing talaria writes\n255\t// goes there — it is an input the user wrote, and a case that puts a canary in\n256\t// a config file to see how an error path handles it would otherwise be caught\n257\t// finding its own fixture.\n258\tfunc (h *harness) written() []canary.Surface {\n259\t\th.t.Helper()\n260\t\n261\t\tvar surfaces []canary.Surface\n262\t\tfor label, root := range map[string]string{\n263\t\t\t\"history\": h.state,\n264\t\t\t\"cache\":   h.cache,\n265\t\t} {\n266\t\t\tfound, err := canary.Tree(label, root)\n267\t\t\tif err != nil {\n268\t\t\t\th.t.Fatalf(\"enumerating the %s surfaces: %v\", label, err)\n269\t\t\t}\n270\t\t\tsurfaces = append(surfaces, found...)\n271\t\t}\n272\t\n273\t\treturn surfaces\n274\t}\n275\t\n276\t// recordedRequest is what arrived at the test server.\n277\ttype recordedRequest struct {\n278\t\tHeader  http.Header\n279\t\tQuery   url.Values\n280\t\tCookies map[string]bool\n281\t}\n282\t\n283\ttype recordingServer struct {\n284\t\t*httptest.Server\n285\t\n286\t\tmu   sync.Mutex\n287\t\tlast recordedRequest\n288\t}\n289\t\n290\t// newServer starts a server that records each request and answers 200 with a\n291\t// body carrying no secret of its own.\n292\tfunc newServer(t *testing.T, body string) *recordingServer {\n293\t\tt.Helper()\n294\t\n295\t\trs := &recordingServer{}\n296\t\trs.Server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {\n297\t\t\tcookies := map[string]bool{}\n298\t\t\tfor _, c := range r.Cookies() {\n299\t\t\t\tcookies[c.Value] = true\n300\t\t\t}\n301\t\n302\t\t\trs.mu.Lock()\n303\t\t\trs.last = recordedRequest{\n304\t\t\t\tHeader:  r.Header.Clone(),\n305\t\t\t\tQuery:   r.URL.Query(),\n306\t\t\t\tCookies: cookies,\n307\t\t\t}\n308\t\t\trs.mu.Unlock()\n309\t\n310\t\t\tw.Header().Set(\"Content-Type\", \"application/json\")\n311\t\t\t_, _ = io.WriteString(w, body)\n312\t\t}))\n313\t\tt.Cleanup(rs.Close)\n314\t\n315\t\treturn rs\n316\t}\n317\t\n318\tfunc (rs *recordingServer) received() recordedRequest {\n319\t\trs.mu.Lock()\n320\t\tdefer rs.mu.Unlock()\n321\t\n322\t\treturn rs.last\n323\t}\n324\t\n325\t// TestNoAuthMechanismLeaksIntoAnyOutputSurface is the suite §5a asks for: every\n326\t// auth mechanism, every output format, every surface a run produces.\n327\t//\n328\t// The format loop comes from canary.Formats, which is internal/output's Format\n329\t// enum. A fourth format is exercised here the day it is added, and the\n330\t// non-empty assertion below means a format that renders nothing fails rather\n331\t// than passing vacuously.\n332\tfunc TestNoAuthMechanismLeaksIntoAnyOutputSurface(t *testing.T) {\n333\t\tfor _, mech := range mechanisms {\n334\t\t\tfor _, format := range canary.Formats() {\n335\t\t\t\tt.Run(mech.name+\"/\"+format, func(t *testing.T) {\n336\t\t\t\t\tt.Parallel()\n337\t\n338\t\t\t\t\tvalue := canary.Value(mech.name)\n339\t\t\t\t\th := newHarness(t, mech.env(value))\n340\t\t\t\t\tsrv := newServer(t, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n341\t\n342\t\t\t\t\tvar runs []result\n343\t\t\t\t\truns = append(runs,\n344\t\t\t\t\t\th.runOK(\"call\", specPath, mech.op,\n345\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--output\", format, \"--dry-run\"),\n346\t\t\t\t\t\th.runOK(\"call\", specPath, mech.op,\n347\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--output\", format),\n348\t\t\t\t\t\t// Exits 5: the fixture declares every scheme and this case\n349\t\t\t\t\t\t// sets one. The report is the surface being checked, and it\n350\t\t\t\t\t\t// is written on the way to that exit code.\n351\t\t\t\t\t\th.run(\"auth\", \"check\", specPath, \"--output\", format),\n352\t\t\t\t\t\th.runOK(\"history\", \"--output\", format),\n353\t\t\t\t\t\th.runOK(\"history\", \"show\", \"1\", \"--output\", format),\n354\t\t\t\t\t\th.runOK(\"history\", \"replay\", \"1\", \"--output\", format),\n355\t\t\t\t\t\th.runOK(\"describe\", specPath, mech.op, \"--output\", format),\n356\t\t\t\t\t\th.runOK(\"list\", specPath, \"--output\", format),\n357\t\t\t\t\t\t// Last, so it disturbs no history index above. `run` sends\n358\t\t\t\t\t\t// the same credential `call` does and renders its own\n359\t\t\t\t\t\t// report, so it is its own surface.\n360\t\t\t\t\t\th.runOK(\"run\", specPath, \"--operation\", mech.op,\n361\t\t\t\t\t\t\t\"--base-url\", srv.URL, \"--report\", format),\n362\t\t\t\t\t)\n363\t\n364\t\t\t\t\t// The credential reached the server. Without this the rest of\n365\t\t\t\t\t// the test would pass just as well if talaria sent nothing.\n366\t\t\t\t\tif !mech.received(srv.received(), value) {\n367\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s credential; the leak assertions below prove nothing\", mech.name)\n368\t\t\t\t\t}\n369\t\n370\t\t\t\t\tvar surfaces []canary.Surface\n371\t\t\t\t\tfor _, res := range runs {\n372\t\t\t\t\t\tif strings.TrimSpace(res.stdout) == \"\" {\n373\t\t\t\t\t\t\tt.Errorf(\"`talaria %s` printed nothing; --output %s renders no payload\",\n374\t\t\t\t\t\t\t\tstrings.Join(res.args, \" \"), format)\n375\t\t\t\t\t\t}\n376\t\t\t\t\t\tsurfaces = append(surfaces, res.surfaces()...)\n377\t\t\t\t\t}\n378\t\t\t\t\tsurfaces = append(surfaces, h.written()...)\n379\t\n380\t\t\t\t\tassertNoLeak(t, value, surfaces)\n381\t\t\t\t})\n382\t\t\t}\n383\t\t}\n384\t}\n385\t\n386\t// TestNoReportFormatLeaksTheCredential covers §5a's \"junit reports\" among the\n387\t// output surfaces, and every other shape `run --report` writes.\n388\t//\n389\t// It is a loop of its own rather than a line in the test above because the\n390\t// report formats are a superset of the --output ones: junit describes a suite\n391\t// of operations, which is something only `run` produces. Driving it from\n392\t// canary.ReportFormats means a fifth report format is covered the day it is\n393\t// added.\n394\tfunc TestNoReportFormatLeaksTheCredential(t *testing.T) {\n395\t\tfor _, mech := range mechanisms {\n396\t\t\tfor _, format := range canary.ReportFormats() {\n397\t\t\t\tt.Run(mech.name+\"/\"+format, func(t *testing.T) {\n398\t\t\t\t\tt.Parallel()\n399\t\n400\t\t\t\t\tvalue := canary.Value(mech.name)\n401\t\t\t\t\th := newHarness(t, mech.env(value))\n402\t\t\t\t\tsrv := newServer(t, `{\"id\":\"42\",\"name\":\"Rex\"}`)\n403\t\n404\t\t\t\t\tres := h.runOK(\"run\", specPath, \"--operation\", mech.op,\n405\t\t\t\t\t\t\"--base-url\", srv.URL, \"--report\", format)\n406\t\n407\t\t\t\t\tif !mech.received(srv.received(), value) {\n408\t\t\t\t\t\tt.Fatalf(\"the server never saw the %s credential; the leak assertions below prove nothing\", mech.name)\n409\t\t\t\t\t}\n410\t\t\t\t\t// A report that named the operation is a report that rendered.\n411\t\t\t\t\t// Without this a format writing an empty shell would pass every\n412\t\t\t\t\t// assertion below by having nothing in it at all.\n413\t\t\t\t\tif !strings.Contains(res.stdout, mech.op) {\n414\t\t\t\t\t\tt.Errorf(\"`--report %s` does not name the operation it ran:\\n%s\", format, res.stdout)\n415\t\t\t\t\t}\n416\t\n417\t\t\t\t\tassertNoLeak(t, value, append(res.surfaces(), h.written()...))\n418\t\t\t\t})\n419\t\t\t}\n420\t\t}\n421\t}\n422\t\n423\t// TestErrorPathsDoNotLeakTheCredential covers §5a's \"error paths are where\n424\t// redaction bugs live\": a failure at each stage of a call, with a credential\n425\t// present throughout.\n426\tfunc TestErrorPathsDoNotLeakTheCredential(t *testing.T) {\n427\t\t// A response-validation failure is not here because response validation is\n428\t\t// not built yet (plan tasks 26 and 27). Whoever adds --fail-on-error adds\n429\t\t// the case; the stages that exist are all covered.\n430\t\tstages := []struct {"
