        "content": "1\tpackage config\n2\t\n3\timport (\n4\t\t\"regexp\"\n5\t\t\"sort\"\n6\t\t\"strings\"\n7\t\n8\t\tv3high \"github.com/pb33f/libopenapi/datamodel/high/v3\"\n9\t\n10\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n11\t\t\"github.com/Teeeep/talaria/internal/operation\"\n12\t\t\"github.com/Teeeep/talaria/internal/secret\"\n13\t\t\"github.com/Teeeep/talaria/internal/spec\"\n14\t)\n15\t\n16\t// The env-var convention from DESIGN.md §5. It is a convention rather than a\n17\t// setting on purpose: an agent can tell a human \"export $TALARIA_AUTH_BEARER\"\n18\t// having read nothing but the scheme's type.\n19\tconst (\n20\t\t// EnvBearer holds the token for an `http`/`bearer` scheme.\n21\t\tEnvBearer = \"TALARIA_AUTH_BEARER\"\n22\t\t// EnvBasic holds the user:password for an `http`/`basic` scheme.\n23\t\tEnvBasic = \"TALARIA_AUTH_BASIC\"\n24\t\t// EnvAPIKeyPrefix is followed by the upper-cased scheme name, so a scheme\n25\t\t// called petKey reads TALARIA_AUTH_APIKEY_PETKEY.\n26\t\tEnvAPIKeyPrefix = \"TALARIA_AUTH_APIKEY_\"\n27\t)\n28\t\n29\t// Kind is the shape of a credential, which decides how internal/curl sends it.\n30\ttype Kind string\n31\t\n32\tconst (\n33\t\t// KindBearer is an RFC 6750 bearer token: Authorization: Bearer <value>.\n34\t\tKindBearer Kind = \"bearer\"\n35\t\t// KindBasic is HTTP basic auth, whose value is user:password.\n36\t\tKindBasic Kind = \"basic\"\n37\t\t// KindAPIKey is an opaque key sent verbatim in a header, query parameter or\n38\t\t// cookie.\n39\t\tKindAPIKey Kind = \"apiKey\"\n40\t)\n41\t\n42\t// Credential locations, matching the OpenAPI `in` values.\n43\tconst (\n44\t\tInHeader = \"header\"\n45\t\tInQuery  = \"query\"\n46\t\tInCookie = \"cookie\"\n47\t)\n48\t\n49\t// Credential is one security scheme resolved to a place on the request and the\n50\t// *name* of the value that goes there. It deliberately has no field that could\n51\t// hold the value: everything downstream can carry a Credential safely, and\n52\t// reading the secret is internal/curl calling Ref.Resolve at exec time.\n53\ttype Credential struct {\n54\t\t// Scheme is the key from components.securitySchemes.\n55\t\tScheme string `json:\"scheme\"`\n56\t\tKind   Kind   `json:\"kind\"`\n57\t\t// In is where the credential goes: InHeader, InQuery or InCookie.\n58\t\tIn string `json:\"in\"`\n59\t\t// Name is the header name, query parameter or cookie name. For bearer and\n60\t\t// basic it is always Authorization.\n61\t\tName string `json:\"name\"`\n62\t\t// Ref names the credential. It marshals redacted, like everywhere else.\n63\t\tRef secret.SecretRef `json:\"source\"`\n64\t}\n65\t\n66\t// Present reports whether the credential this names is set, without reading it.\n67\t// `auth check` is built on this: the answer an agent needs is \"is it there\",\n68\t// and the value is never part of the answer (§5 Auth).\n69\tfunc (c Credential) Present() bool { return c.Ref.Present() }\n70\t\n71\t// Coverage is how one security requirement stands against the credentials that\n72\t// actually exist.\n73\ttype Coverage int\n74\t\n75\tconst (\n76\t\t// Unsupported means the requirement names a scheme talaria has no way to\n77\t\t// supply, such as OAuth2. There is no variable to report missing.\n78\t\tUnsupported Coverage = iota\n79\t\t// Incomplete means talaria can supply every scheme the requirement names,\n80\t\t// but at least one credential is not set.\n81\t\tIncomplete\n82\t\t// Satisfied means every scheme is supported and every credential is set.\n83\t\tSatisfied\n84\t\t// Optional means the requirement is empty: the spec is saying that\n85\t\t// authentication is optional here.\n86\t\tOptional\n87\t)\n88\t\n89\t// Covers classifies one security requirement against byName, which maps a\n90\t// scheme name to the credential that satisfies it — Schemes' result for a\n91\t// document, or the map Resolve builds for an operation. A scheme missing from\n92\t// byName is one talaria cannot supply, since both sources leave those out.\n93\t//\n94\t// This is the one rule behind both Resolve's choice of alternative and `auth\n95\t// check`'s verdict. The two used to derive it separately, in separate packages,\n96\t// and drifted: `auth check` exited 0 on a spec offering either of two API keys\n97\t// with one of them exported, and `call` then refused the same spec with exit 5\n98\t// asking for the other one.\n99\tfunc Covers(req operation.SecurityRequirement, byName map[string]Credential) Coverage {\n100\t\tif len(req.Schemes) == 0 {\n101\t\t\treturn Optional\n102\t\t}\n103\t\n104\t\t// A requirement's schemes apply together, so one scheme talaria cannot\n105\t\t// supply makes the whole alternative unusable, and one credential that is\n106\t\t// not set makes it incomplete.\n107\t\tcoverage := Satisfied\n108\t\tfor _, want := range req.Schemes {\n109\t\t\tcred, ok := byName[want.Name]\n110\t\t\tswitch {\n111\t\t\tcase !ok:\n112\t\t\t\treturn Unsupported\n113\t\t\tcase !cred.Present():\n114\t\t\t\tcoverage = Incomplete\n115\t\t\t}\n116\t\t}\n117\t\n118\t\treturn coverage\n119\t}\n120\t\n121\t// Resolve maps the security schemes op requires onto credentials.\n122\t//\n123\t// A spec may offer several alternative requirements. The first one talaria can\n124\t// supply *and* has every credential for wins, so a spec offering either of two\n125\t// API keys resolves to whichever one the caller has exported. If no alternative\n126\t// is fully covered, the first supported one is returned anyway: the caller is\n127\t// heading for exit 5, and the error is only actionable if it names a variable.\n128\t// Every scheme within the chosen requirement is returned, because a\n129\t// requirement's schemes apply together.\n130\t//\n131\t// An operation with no security, or with an empty requirement (auth optional),\n132\t// resolves to no credentials.\n133\tfunc Resolve(op operation.Operation, doc *spec.Document, prof *Profile) ([]Credential, error) {\n134\t\tschemes := securitySchemes(doc)\n135\t\n136\t\tbyName, err := supportedCredentials(op, schemes, prof)\n137\t\tif err != nil {\n138\t\t\treturn nil, err\n139\t\t}\n140\t\n141\t\tvar (\n142\t\t\tunsupported []string\n143\t\t\tfallback    []Credential\n144\t\t)\n145\t\tfor _, req := range op.Security {\n146\t\t\tswitch Covers(req, byName) {\n147\t\t\tcase Optional:\n148\t\t\t\treturn nil, nil\n149\t\t\tcase Unsupported:\n150\t\t\t\tunsupported = append(unsupported, unsupportedReason(req, schemes))\n151\t\t\tcase Satisfied:\n152\t\t\t\treturn credentials(req, byName), nil\n153\t\t\tcase Incomplete:\n154\t\t\t\tif fallback == nil {\n155\t\t\t\t\tfallback = credentials(req, byName)\n156\t\t\t\t}\n157\t\t\t}\n158\t\t}\n159\t\n160\t\tswitch {\n161\t\tcase fallback != nil:\n162\t\t\treturn fallback, nil\n163\t\tcase len(unsupported) == 0:\n164\t\t\treturn nil, nil\n165\t\t}\n166\t\n167\t\treturn nil, clierr.Usage(\"no usable security scheme for %s: %s\",\n168\t\t\toperationName(op), strings.Join(unsupported, \"; \"))\n169\t}\n170\t\n171\t// Schemes lists every security scheme the document declares that talaria can\n172\t// satisfy, as the credential that would satisfy it, sorted by scheme name.\n173\t//\n174\t// Resolve answers \"which credentials does this call use\". This answers \"which\n175\t// credentials does this spec ask for at all\", which is the question `auth\n176\t// check` reports on. Schemes talaria has no way to supply — OAuth2, OpenID\n177\t// Connect, an API key in a place a request does not have — are left out: there\n178\t// is no variable to tell a human to set, so there is nothing to report (§5).\n179\tfunc Schemes(doc *spec.Document, prof *Profile) ([]Credential, error) {\n180\t\tdeclared := securitySchemes(doc)\n181\t\n182\t\tnames := make([]string, 0, len(declared))\n183\t\tfor name, scheme := range declared {\n184\t\t\tif schemeReason(name, scheme) == \"\" {\n185\t\t\t\tnames = append(names, name)\n186\t\t\t}\n187\t\t}\n188\t\t// Sorted, because the map iteration behind it is not, and a report whose\n189\t\t// line order changes between runs is one no diff can be taken of.\n190\t\tsort.Strings(names)\n191\t\n192\t\tout := make([]Credential, 0, len(names))\n193\t\tfor _, name := range names {\n194\t\t\tcred, err := credentialFor(name, declared[name], prof)\n195\t\t\tif err != nil {\n196\t\t\t\treturn nil, err\n197\t\t\t}\n198\t\t\tout = append(out, cred)\n199\t\t}\n200\t\n201\t\treturn out, nil\n202\t}\n203\t\n204\t// unsupportedReason returns why this requirement cannot be satisfied, or \"\" if\n205\t// it can. A requirement's schemes apply together, so one unusable scheme makes\n206\t// the whole alternative unusable.\n207\tfunc unsupportedReason(req operation.SecurityRequirement, schemes map[string]*v3high.SecurityScheme) string {\n208\t\tfor _, want := range req.Schemes {\n209\t\t\tscheme, ok := schemes[want.Name]\n210\t\t\tif !ok {\n211\t\t\t\treturn \"scheme \" + want.Name + \" is not declared in components.securitySchemes\"\n212\t\t\t}\n213\t\n214\t\t\tif reason := schemeReason(want.Name, scheme); reason != \"\" {\n215\t\t\t\treturn reason\n216\t\t\t}\n217\t\t}\n218\t\n219\t\treturn \"\"\n220\t}\n221\t\n222\t// schemeReason returns why talaria cannot use one declared scheme, or \"\" if it\n223\t// can. v1 covers bearer, basic and API keys; OAuth2 and OpenID Connect are out\n224\t// of scope, and the caller is expected to bring a token for them (§5 Auth).\n225\tfunc schemeReason(name string, scheme *v3high.SecurityScheme) string {\n226\t\tswitch {\n227\t\tcase isHTTP(scheme, \"bearer\"), isHTTP(scheme, \"basic\"):\n228\t\t\treturn \"\"\n229\t\tcase strings.EqualFold(scheme.Type, \"apiKey\"):\n230\t\t\tswitch scheme.In {\n231\t\t\tcase InHeader, InQuery, InCookie:\n232\t\t\t\treturn \"\"\n233\t\t\tdefault:\n234\t\t\t\treturn \"scheme \" + name + \" puts its API key in \" + scheme.In\n235\t\t\t}\n236\t\tdefault:\n237\t\t\treturn \"scheme \" + name + \" is of unsupported type \" + describeType(scheme)\n238\t\t}\n239\t}\n240\t\n241\t// supportedCredentials builds the credential for every scheme op names that\n242\t// talaria can actually supply, keyed by scheme name. Schemes it cannot supply\n243\t// are left out, which is what Covers reads as an unsupported alternative.\n244\t//\n245\t// It is built for the whole operation rather than per alternative because the\n246\t// choice between alternatives depends on which credentials are present, which\n247\t// cannot be known before they are built. The only failure is a malformed\n248\t// profile entry, which is fatal rather than a reason to try another\n249\t// alternative: the user meant to configure this scheme and got it wrong.\n250\tfunc supportedCredentials(\n251\t\top operation.Operation,\n252\t\tschemes map[string]*v3high.SecurityScheme,\n253\t\tprof *Profile,\n254\t) (map[string]Credential, error) {\n255\t\tout := map[string]Credential{}\n256\t\tfor _, req := range op.Security {\n257\t\t\tfor _, want := range req.Schemes {\n258\t\t\t\tscheme, ok := schemes[want.Name]\n259\t\t\t\tif _, done := out[want.Name]; done || !ok || schemeReason(want.Name, scheme) != \"\" {\n260\t\t\t\t\tcontinue\n261\t\t\t\t}\n262\t\n263\t\t\t\tcred, err := credentialFor(want.Name, scheme, prof)\n264\t\t\t\tif err != nil {\n265\t\t\t\t\treturn nil, err\n266\t\t\t\t}\n267\t\n268\t\t\t\tout[want.Name] = cred\n269\t\t\t}\n270\t\t}\n271\t\n272\t\treturn out, nil\n273\t}\n274\t\n275\t// credentials collects the credentials of a requirement already known to be\n276\t// supported, in the order the requirement names its schemes.\n277\tfunc credentials(req operation.SecurityRequirement, byName map[string]Credential) []Credential {\n278\t\tout := make([]Credential, 0, len(req.Schemes))\n279\t\tfor _, want := range req.Schemes {\n280\t\t\tout = append(out, byName[want.Name])\n281\t\t}\n282\t\n283\t\treturn out\n284\t}\n285\t\n286\t// credentialFor builds the Credential for one supported scheme: where the value\n287\t// goes on the request, and the name of the value that goes there.\n288\tfunc credentialFor(name string, scheme *v3high.SecurityScheme, prof *Profile) (Credential, error) {\n289\t\tcred := Credential{Scheme: name, In: InHeader, Name: \"Authorization\"}\n290\t\tswitch {\n291\t\tcase isHTTP(scheme, \"bearer\"):\n292\t\t\tcred.Kind, cred.Ref = KindBearer, secret.Env(EnvBearer)\n293\t\tcase isHTTP(scheme, \"basic\"):\n294\t\t\tcred.Kind, cred.Ref = KindBasic, secret.Env(EnvBasic)\n295\t\tdefault:\n296\t\t\tcred.Kind = KindAPIKey\n297\t\t\tcred.In, cred.Name = scheme.In, scheme.Name\n298\t\t\tcred.Ref = secret.Env(EnvAPIKeyPrefix + envSuffix(name))\n299\t\t}\n300\t\n301\t\t// The profile is the more specific source and wins over the convention: it\n302\t\t// is how one machine talks to staging and production at once.\n303\t\tref, err := profileRef(prof, name)\n304\t\tif err != nil {\n305\t\t\treturn Credential{}, err\n306\t\t}\n307\t\tif !ref.IsZero() {\n308\t\t\tcred.Ref = ref\n309\t\t}\n310\t\n311\t\treturn cred, nil\n312\t}\n313\t\n314\t// envRef matches a profile auth entry: ${VAR} or $VAR, and nothing else.\n315\tvar envRef = regexp.MustCompile(`^\\$\\{?([A-Za-z_][A-Za-z0-9_]*)\\}?$`)\n316\t\n317\t// ReferencesEnv reports whether this profile's auth map names the given\n318\t// environment variable.\n319\t//\n320\t// It exists for `history replay`, which reads a variable's *name* out of a file\n321\t// on disk and would otherwise resolve whatever that file asked for. The set of\n322\t// names a replay may resolve is the TALARIA_AUTH_* convention plus this: the\n323\t// variables the profile in force deliberately points at. A literal entry — the\n324\t// one profileRef refuses — names no variable and so admits none.\n325\t//\n326\t// The nil receiver is \"no --profile was given\", which names nothing rather than\n327\t// everything.\n328\tfunc (p *Profile) ReferencesEnv(name string) bool {\n329\t\tif p == nil || name == \"\" {\n330\t\t\treturn false\n331\t\t}\n332\t\n333\t\tfor _, entry := range p.Auth {\n334\t\t\tif match := envRef.FindStringSubmatch(entry); match != nil && match[1] == name {\n335\t\t\t\treturn true\n336\t\t\t}\n337\t\t}\n338\t\n339\t\treturn false\n340\t}\n341\t\n342\t// profileRef reads the profile's entry for a scheme. A profile may only\n343\t// *reference* an environment variable; a literal value is refused, because a\n344\t// credential in a config file is a credential this process would have to carry,\n345\t// and the firewall's whole claim is that it never does.\n346\t//\n347\t// The error names neither the value nor any part of it.\n348\tfunc profileRef(prof *Profile, scheme string) (secret.SecretRef, error) {\n349\t\tif prof == nil {\n350\t\t\treturn secret.SecretRef{}, nil\n351\t\t}\n352\t\n353\t\tentry, ok := prof.Auth[scheme]\n354\t\tif !ok || entry == \"\" {\n355\t\t\treturn secret.SecretRef{}, nil\n356\t\t}\n357\t\n358\t\tmatch := envRef.FindStringSubmatch(entry)\n359\t\tif match == nil {\n360\t\t\treturn secret.SecretRef{}, clierr.Usage(\n361\t\t\t\t\"profile %q sets auth for scheme %q to a literal value; \"+\n362\t\t\t\t\t\"it must reference an environment variable, e.g. ${MY_TOKEN}\",\n363\t\t\t\tprof.Name, scheme)\n364\t\t}\n365\t\n366\t\treturn secret.Env(match[1]), nil\n367\t}\n368\t\n369\t// securitySchemes flattens components.securitySchemes into a lookup. A document\n370\t// without any is not an error: an operation that names a scheme the document\n371\t// does not declare is reported per-requirement by unsupportedReason.\n372\tfunc securitySchemes(doc *spec.Document) map[string]*v3high.SecurityScheme {\n373\t\tout := map[string]*v3high.SecurityScheme{}\n374\t\tif doc == nil || doc.Model == nil || doc.Model.Components == nil {\n375\t\t\treturn out\n376\t\t}\n377\t\n378\t\tfor pair := doc.Model.Components.SecuritySchemes.First(); pair != nil; pair = pair.Next() {\n379\t\t\tif scheme := pair.Value(); scheme != nil {\n380\t\t\t\tout[pair.Key()] = scheme\n381\t\t\t}\n382\t\t}\n383\t\n384\t\treturn out\n385\t}\n386\t\n387\tfunc isHTTP(scheme *v3high.SecurityScheme, kind string) bool {\n388\t\treturn strings.EqualFold(scheme.Type, \"http\") && strings.EqualFold(scheme.Scheme, kind)\n389\t}\n390\t\n391\t// describeType renders a scheme's type for an error message, including the\n392\t// http scheme when there is one, so \"http (digest)\" is distinguishable from\n393\t// the bearer and basic cases talaria does support.\n394\tfunc describeType(scheme *v3high.SecurityScheme) string {\n395\t\tif scheme.Scheme != \"\" {\n396\t\t\treturn scheme.Type + \" (\" + scheme.Scheme + \")\"\n397\t\t}\n398\t\n399\t\treturn scheme.Type\n400\t}\n401\t\n402\t// envSuffix turns a scheme name into the tail of its env var: upper-cased, with\n403\t// everything outside [A-Z0-9] flattened to _ so a scheme called `pet-key` maps\n404\t// to a name a shell can actually export.\n405\tfunc envSuffix(scheme string) string {\n406\t\tupper := strings.ToUpper(scheme)\n407\t\n408\t\tvar b strings.Builder\n409\t\tb.Grow(len(upper))\n410\t\tfor _, r := range upper {\n411\t\t\tswitch {\n412\t\t\tcase r >= 'A' && r <= 'Z', r >= '0' && r <= '9':\n413\t\t\t\tb.WriteRune(r)\n414\t\t\tdefault:\n415\t\t\t\tb.WriteByte('_')\n416\t\t\t}\n417\t\t}\n418\t\n419\t\treturn b.String()\n420\t}\n421\t\n422\t// operationName is the operation's ID, falling back to method and path for a\n423\t// spec that sets no operationId — an error naming neither is unactionable.\n424\tfunc operationName(op operation.Operation) string {\n425\t\tif op.ID != \"\" {\n426\t\t\treturn op.ID\n427\t\t}\n428\t\n429\t\treturn op.Method + \" \" + op.Path\n430\t}\n431\t"
      }
    ]
