      {
        "tool_use_id": "toolu_01Fns9pWFuG9oCuzjvigef9P",
        "type": "tool_result",
        "content": "1\tpackage curl\n2\t\n3\timport (\n4\t\t\"net/http\"\n5\t\t\"os\"\n6\t\t\"strconv\"\n7\t\t\"strings\"\n8\t\t\"time\"\n9\t\t\"unicode/utf8\"\n10\t\n11\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n12\t\t\"github.com/Teeeep/talaria/internal/request\"\n13\t)\n14\t\n15\t// maxInlineBody is the size above which a body stops being a directive and\n16\t// becomes a 0600 temp file. DESIGN.md §5a calls the temp file \"the exception\":\n17\t// it is a real file on disk for the length of one exec, so the threshold is set\n18\t// where the config document stops being a reasonable place to put bytes rather\n19\t// than at any hard limit of curl's.\n20\tconst maxInlineBody = 1 << 20\n21\t\n22\t// The default bounds on one call. They are generous enough that a slow but\n23\t// working API still answers, and short enough that a wedged one becomes an exit\n24\t// code rather than a process an agent cannot interpret — the reasoning\n25\t// internal/spec/source.go already applies to fetching a spec, applied to the\n26\t// higher-risk path.\n27\tconst (\n28\t\tDefaultConnectTimeout = 10 * time.Second\n29\t\tDefaultMaxTime        = 30 * time.Second\n30\t)\n31\t\n32\t// Options bound one invocation of curl in time. They are enforced by curl\n33\t// itself, which exits 28 when either runs out; the executor's own deadline is\n34\t// only the backstop for a curl that ignores them.\n35\ttype Options struct {\n36\t\t// ConnectTimeout limits establishing the connection.\n37\t\tConnectTimeout time.Duration\n38\t\t// MaxTime limits the whole operation, connection included.\n39\t\tMaxTime time.Duration\n40\t}\n41\t\n42\t// DefaultOptions returns the bounds a caller gets without asking.\n43\tfunc DefaultOptions() Options {\n44\t\treturn Options{ConnectTimeout: DefaultConnectTimeout, MaxTime: DefaultMaxTime}\n45\t}\n46\t\n47\t// withDefaults fills in the timeouts a caller left unset.\n48\t//\n49\t// A non-positive value means \"unset\" rather than \"no limit\": an unbounded call\n50\t// is exactly what these options exist to prevent, so there is deliberately no\n51\t// way to ask for one. A connect timeout longer than the total is clamped, since\n52\t// curl would enforce the total against it anyway and the pair reads as a lie.\n53\tfunc (o Options) withDefaults() Options {\n54\t\tif o.ConnectTimeout <= 0 {\n55\t\t\to.ConnectTimeout = DefaultConnectTimeout\n56\t\t}\n57\t\tif o.MaxTime <= 0 {\n58\t\t\to.MaxTime = DefaultMaxTime\n59\t\t}\n60\t\tif o.ConnectTimeout > o.MaxTime {\n61\t\t\to.ConnectTimeout = o.MaxTime\n62\t\t}\n63\t\n64\t\treturn o\n65\t}\n66\t\n67\t// Capture names the files curl writes the response to. Both are optional; the\n68\t// executor allocates them and passes them here rather than appending them to\n69\t// argv, because §5a's rule is that *nothing* about the call is an argument, not\n70\t// merely nothing sensitive.\n71\ttype Capture struct {\n72\t\t// BodyPath receives the response body, via the output directive.\n73\t\tBodyPath string\n74\t\t// HeaderPath receives the response headers, via the dump-header directive.\n75\t\tHeaderPath string\n76\t}\n77\t\n78\t// BuildConfig renders req as a curl config document for `curl -K -`.\n79\t//\n80\t// This is the one place in talaria where a resolved credential exists. The\n81\t// document is written to curl's stdin and holds the real values; the returned\n82\t// argv is exactly `curl -K -` and holds nothing, because /proc/*/cmdline is\n83\t// readable by any process on the host — including ones an agent spawns (§5a).\n84\t//\n85\t// cleanup must be called once curl has exited. It removes any temp body file\n86\t// and zeroes the document, so the resolved values do not linger in a buffer the\n87\t// rest of the process can still reach. It is safe to call more than once, and\n88\t// is non-nil even when BuildConfig fails.\n89\t//\n90\t// A credential whose environment variable is unset fails with exit code 5 and\n91\t// no document, rather than sending an empty header — an unauthenticated request\n92\t// that looks authenticated is the worse outcome (§4).\n93\tfunc BuildConfig(req *request.Request, capture Capture) (config []byte, argv []string, cleanup func(), err error) {\n94\t\treturn BuildConfigWith(req, capture, DefaultOptions())\n95\t}\n96\t\n97\t// BuildConfigWith is BuildConfig with the timeouts named rather than defaulted.\n98\tfunc BuildConfigWith(\n99\t\treq *request.Request,\n100\t\tcapture Capture,\n101\t\topts Options,\n102\t) (config []byte, argv []string, cleanup func(), err error) {\n103\t\t// -q first, where curl reads it: it disables the default config file, which\n104\t\t// curl would otherwise parse *before* the -K document. A `trace-ascii` or\n105\t\t// `proxy` line in a $HOME/.curlrc anyone can write applies to the one request\n106\t\t// carrying the resolved credential, and copies it straight back out. Writing\n107\t\t// that file is a weaker capability than the env-var read §5a concedes, so\n108\t\t// this flag is what keeps the firewall inside its claimed boundary.\n109\t\targv = []string{\"curl\", \"-q\", \"-K\", \"-\"}\n110\t\tif req == nil {\n111\t\t\treturn nil, argv, func() {}, clierr.RequestFailed(\"no request to execute\")\n112\t\t}\n113\t\n114\t\tvar doc document\n115\t\tif err := doc.build(req, capture, opts.withDefaults()); err != nil {\n116\t\t\tdoc.discard()\n117\t\t\treturn nil, argv, doc.cleanup, err\n118\t\t}\n119\t\n120\t\tconfig = []byte(doc.b.String())\n121\t\tdoc.b.Reset()\n122\t\n123\t\treturn config, argv, doc.cleanupWith(config), nil\n124\t}\n125\t\n126\t// document accumulates the directives and the temp files they point at, so a\n127\t// failure part-way through still knows what to remove.\n128\ttype document struct {\n129\t\tb     strings.Builder\n130\t\tfiles []string\n131\t}\n132\t\n133\tfunc (d *document) build(req *request.Request, capture Capture, opts Options) error {\n134\t\turl, err := req.URL(resolve)\n135\t\tif err != nil {\n136\t\t\treturn err\n137\t\t}\n138\t\td.directive(\"url\", url)\n139\t\n140\t\tif req.Method != \"\" && !request.IsMethod(req.Method) {\n141\t\t\t// Quoted where a value never is: a method is a verb, not a credential,\n142\t\t\t// and %q renders any CR or LF in it as an escape rather than a real one.\n143\t\t\treturn clierr.Usage(\"method %q is not a valid HTTP method\", req.Method)\n144\t\t}\n145\t\n146\t\t// head rather than `request = \"HEAD\"`: -X HEAD leaves curl waiting for a body\n147\t\t// of Content-Length bytes that a compliant server never sends, so the call\n148\t\t// hangs (or exits 18 when the connection closes first). HEAD is a safe method\n149\t\t// that `run` includes without --allow-mutations, so one such operation would\n150\t\t// stall an entire report.\n151\t\thead := strings.EqualFold(req.Method, http.MethodHead)\n152\t\tswitch {\n153\t\tcase head:\n154\t\t\td.flag(\"head\")\n155\t\tcase req.Method != \"\":\n156\t\t\td.directive(\"request\", req.Method)\n157\t\t}\n158\t\n159\t\tif err := d.auth(req); err != nil {\n160\t\t\treturn err\n161\t\t}\n162\t\tif err := d.cookies(req); err != nil {\n163\t\t\treturn err\n164\t\t}\n165\t\tif err := d.body(req); err != nil {\n166\t\t\treturn err\n167\t\t}\n168\t\n169\t\t// Defence in depth behind request.IsHTTPScheme: curl speaks file, gopher,\n170\t\t// dict and smb, and a redirect chooses the scheme of the next hop without\n171\t\t// asking talaria. The leading `=` makes each list absolute rather than\n172\t\t// additive, so these two are the only protocols this process can use.\n173\t\td.directive(\"proto\", \"=http,https\")\n174\t\td.directive(\"proto-redir\", \"=http,https\")\n175\t\n176\t\t// The bounds curl enforces on itself. Emitted as directives rather than\n177\t\t// watched from Go because curl exits 28 of its own accord, which runFailure\n178\t\t// already classifies as a failed request — so the happy path never has to\n179\t\t// know a clock exists. A `run` without these stalls on operation k of n and\n180\t\t// emits no report at all.\n181\t\td.directive(\"connect-timeout\", seconds(opts.ConnectTimeout))\n182\t\td.directive(\"max-time\", seconds(opts.MaxTime))\n183\t\n184\t\t// silent suppresses the progress meter, which would otherwise be interleaved\n185\t\t// with the write-out payload on stdout; show-error keeps real failures\n186\t\t// visible despite it.\n187\t\td.flag(\"silent\")\n188\t\td.flag(\"show-error\")\n189\t\t// %{json} is the whole response metadata in one parseable object, and is the\n190\t\t// reason DESIGN.md sets a curl >= 7.70 floor.\n191\t\td.directive(\"write-out\", \"%{json}\")\n192\t\n193\t\tif capture.BodyPath != \"\" {\n194\t\t\t// head makes curl write the header block to the output file, which at\n195\t\t\t// capture.BodyPath would be reported as the response body. dump-header\n196\t\t\t// still captures the headers, and the staged empty body file keeps\n197\t\t\t// readResponse reading a real path.\n198\t\t\tpath := capture.BodyPath\n199\t\t\tif head {\n200\t\t\t\tpath = os.DevNull\n201\t\t\t}\n202\t\t\td.directive(\"output\", path)\n203\t\t}\n204\t\tif capture.HeaderPath != \"\" {\n205\t\t\td.directive(\"dump-header\", capture.HeaderPath)\n206\t\t}\n207\t\n208\t\treturn nil\n209\t}\n210\t\n211\t// auth writes the request headers, diverting basic auth to curl's own user\n212\t// directive: the header text is base64(user:password), and letting curl encode\n213\t// it means this package never has to.\n214\tfunc (d *document) auth(req *request.Request) error {\n215\t\tfor _, h := range req.Headers {\n216\t\t\tvalue, err := resolve(h.Value)\n217\t\t\tif err != nil {\n218\t\t\t\treturn err\n219\t\t\t}\n220\t\n221\t\t\tif err := checkSplit(\"header\", h.Name, value); err != nil {\n222\t\t\t\treturn err\n223\t\t\t}\n224\t\n225\t\t\tif h.Value.Encoding() == request.EncodeBasic {\n226\t\t\t\td.directive(\"user\", strings.TrimPrefix(value, h.Value.Prefix()))\n227\t\t\t\tcontinue\n228\t\t\t}\n229\t\n230\t\t\td.directive(\"header\", h.Name+\": \"+value)\n231\t\t}\n232\t\n233\t\treturn nil\n234\t}\n235\t\n236\t// cookies writes every cookie as one directive. curl keeps only the last of\n237\t// several, so they are joined rather than repeated.\n238\tfunc (d *document) cookies(req *request.Request) error {\n239\t\tif len(req.Cookies) == 0 {\n240\t\t\treturn nil\n241\t\t}\n242\t\n243\t\tvar b strings.Builder\n244\t\tfor i, c := range req.Cookies {\n245\t\t\tvalue, err := resolve(c.Value)\n246\t\t\tif err != nil {\n247\t\t\t\treturn err\n248\t\t\t}\n249\t\n250\t\t\tif err := checkSplit(\"cookie\", c.Name, value); err != nil {\n251\t\t\t\treturn err\n252\t\t\t}\n253\t\n254\t\t\tif i > 0 {\n255\t\t\t\tb.WriteString(\"; \")\n256\t\t\t}\n257\t\t\tb.WriteString(c.Name + \"=\" + value)\n258\t\t}\n259\t\n260\t\td.directive(\"cookie\", b.String())\n261\t\n262\t\treturn nil\n263\t}\n264\t\n265\t// checkSplit is the last gate before a pair is written into the document, and\n266\t// it is not redundant with the binder's: `history replay` rebuilds a Request\n267\t// from a stored entry rather than from request.Build, and a credential is only\n268\t// a string here, after resolve. escapeDirective is not the answer — it protects\n269\t// curl's parser, and curl un-escapes \\r\\n back to the two bytes on the wire.\n270\t//\n271\t// Only the name is quoted back, and never the value: the value may be the\n272\t// resolved credential this package exists to keep off every other surface.\n273\tfunc checkSplit(kind, name, value string) error {\n274\t\tif !request.SplitsRequest(name, value) {\n275\t\t\treturn nil\n276\t\t}\n277\t\n278\t\treturn clierr.Usage(\"%s %q carries a carriage return or newline, which would end its line \"+\n279\t\t\t\"early and append a header the caller did not write (its value is not echoed)\", kind, name)\n280\t}\n281\t\n282\t// body writes the request body, inline when it can be and via a temp file when\n283\t// it cannot.\n284\tfunc (d *document) body(req *request.Request) error {\n285\t\tif req.Body == nil {\n286\t\t\treturn nil\n287\t\t}\n288\t\n289\t\tif req.Body.ContentType != \"\" && !hasHeader(req, \"Content-Type\") {\n290\t\t\td.directive(\"header\", \"Content-Type: \"+req.Body.ContentType)\n291\t\t}\n292\t\n293\t\tif inlinable(req.Body.Data) {\n294\t\t\t// data-raw rather than data or data-binary: those two read a value\n295\t\t\t// starting with @ as a filename, and a JSON body legitimately can. Verified\n296\t\t\t// against curl 8.14.1 — data-raw sends the bytes as given and strips\n297\t\t\t// nothing, where `data = \"@path\"` also strips newlines.\n298\t\t\td.directive(\"data-raw\", string(req.Body.Data))\n299\t\t\treturn nil\n300\t\t}\n301\t\n302\t\tpath, err := d.tempFile(req.Body.Data)\n303\t\tif err != nil {\n304\t\t\treturn err\n305\t\t}\n306\t\t// The file's bytes are read verbatim, so data-binary rather than data: data\n307\t\t// strips newlines and carriage returns out of a file, which corrupts any\n308\t\t// pretty-printed JSON and breaks any signed payload.\n309\t\td.directive(\"data-binary\", \"@\"+path)\n310\t\n311\t\treturn nil\n312\t}\n313\t\n314\t// inlinable reports whether a body can live in the config document. Valid UTF-8\n315\t// under the size limit can; anything else takes the temp-file path, because a\n316\t// NUL byte truncates a quoted value and arbitrary bytes have no escape sequence\n317\t// that survives curl's parser.\n318\tfunc inlinable(data []byte) bool {\n319\t\tif len(data) > maxInlineBody || !utf8.Valid(data) {\n320\t\t\treturn false\n321\t\t}\n322\t\n323\t\treturn !strings.ContainsRune(string(data), 0)\n324\t}\n325\t\n326\t// tempFile writes data to a 0600 file and records it for cleanup.\n327\tfunc (d *document) tempFile(data []byte) (string, error) {\n328\t\tf, err := os.CreateTemp(\"\", \"talaria-body-*\")\n329\t\tif err != nil {\n330\t\t\treturn \"\", clierr.RequestFailed(\"cannot stage the request body: %w\", err)\n331\t\t}\n332\t\td.files = append(d.files, f.Name())\n333\t\n334\t\t// CreateTemp already makes the file 0600; setting it explicitly keeps that a\n335\t\t// guarantee of this code rather than of the standard library's current\n336\t\t// behaviour, since the body may carry credentials the user put in it.\n337\t\tif err := f.Chmod(0o600); err != nil {\n338\t\t\tf.Close()\n339\t\t\treturn \"\", clierr.RequestFailed(\"cannot secure the request body file: %w\", err)\n340\t\t}\n341\t\n342\t\tif _, err := f.Write(data); err != nil {\n343\t\t\tf.Close()\n344\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n345\t\t}\n346\t\n347\t\tif err := f.Close(); err != nil {\n348\t\t\treturn \"\", clierr.RequestFailed(\"cannot write the request body: %w\", err)\n349\t\t}\n350\t\n351\t\treturn f.Name(), nil\n352\t}\n353\t\n354\t// seconds renders a duration the way curl's timeout options read it: decimal\n355\t// seconds, with no trailing zeroes, so a sub-second bound survives the trip.\n356\tfunc seconds(d time.Duration) string {\n357\t\treturn strconv.FormatFloat(d.Seconds(), 'f', -1, 64)\n358\t}\n359\t\n360\t// directive writes one `name = \"value\"` line, escaped for curl's parser.\n361\tfunc (d *document) directive(name, value string) {\n362\t\td.b.WriteString(name + ` = \"` + escapeDirective(value) + \"\\\"\\n\")\n363\t}\n364\t\n365\t// flag writes one bare directive, the config form of a boolean option.\n366\tfunc (d *document) flag(name string) { d.b.WriteString(name + \"\\n\") }\n367\t\n368\t// discard drops a partially built document, so a failure returns nothing a\n369\t// caller could accidentally send or print.\n370\tfunc (d *document) discard() { d.b.Reset() }\n371\t\n372\t// cleanup removes the temp files this document points at.\n373\tfunc (d *document) cleanup() {\n374\t\tfor _, path := range d.files {\n375\t\t\tos.Remove(path) //nolint:errcheck // Best effort; the file is 0600 and in TMPDIR.\n376\t\t}\n377\t\td.files = nil\n378\t}\n379\t\n380\t// cleanupWith also zeroes the finished document, so the resolved credentials in\n381\t// it stop being readable from the b