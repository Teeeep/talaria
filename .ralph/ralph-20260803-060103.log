f curl actually died.\ninternal/curl/exec_test.go-482-\t\t// An orphaned curl reparented to init would hold this open and finish\ninternal/curl/exec_test.go-483-\t\t// the request long after talaria returned, which is the bug.\ninternal/curl/exec_test.go-484-\t\tcase <-r.Context().Done():\ninternal/curl/exec_test.go-485-\t\t\tdropped <- struct{}{}\ninternal/curl/exec_test.go-486-\t\tcase <-time.After(10 * time.Second):\ninternal/curl/exec_test.go-487-\t\t}\ninternal/curl/exec_test.go-488-\t})",
