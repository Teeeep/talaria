        "content": "420\t\n421\t\treq := &request.Request{\n422\t\t\tMethod:  \"GET\",\n423\t\t\tBaseURL: \"https://api.example.com\",\n424\t\t\tPath:    \"/pets\",\n425\t\t\tHeaders: []request.Pair{{\n426\t\t\t\tName:  \"Authorization\",\n427\t\t\t\tValue: request.Secret(secret.Env(\"TALARIA_AUTH_BASIC\"), request.EncodeBasic),\n428\t\t\t}},\n429\t\t}\n430\t\n431\t\tconfig, _, _ := buildConfig(t, req, Capture{})\n432\t\n433\t\t// curl does the base64, so the raw user:password never has to be encoded here.\n434\t\tif !hasDirective(config, `user = \"alice:`+canary+`\"`) {\n435\t\t\tt.Errorf(\"basic auth is not a user directive:\\n%s\", config)\n436\t\t}\n437\t\tif bytes.Contains(config, []byte(`header = \"Authorization:`)) {\n438\t\t\tt.Errorf(\"basic auth was also emitted as a header:\\n%s\", config)\n439\t\t}\n440\t}\n441\t\n442\t// TestBuildConfigRejectsCRLFThatWouldSplitTheRequest is the last gate, and it\n443\t// is not redundant with the binder's: not every Request comes from\n444\t// request.Build — `history replay` rebuilds one from a stored entry, which is\n445\t// untrusted input read back off disk. Escaping is not the answer here, because\n446\t// escapeDirective only protects curl's own parser: curl un-escapes \\r\\n back to\n447\t// the two bytes and writes them to the socket, ending the header line early.\n448\tfunc TestBuildConfigRejectsCRLFThatWouldSplitTheRequest(t *testing.T) {\n449\t\tconst injection = \"ok\\r\\nX-Injected: 1\"\n450\t\n451\t\tbase := func() *request.Request {\n452\t\t\treturn &request.Request{Method: \"GET\", BaseURL: \"https://api.example.com\", Path: \"/pets\"}\n453\t\t}\n454\t\n455\t\ttests := []struct {\n456\t\t\tname string\n457\t\t\treq  func() *request.Request\n458\t\t}{\n459\t\t\t{\"header value\", func() *request.Request {\n460\t\t\t\treq := base()\n461\t\t\t\treq.Headers = []request.Pair{{Name: \"X-Trace\", Value: request.Literal(injection)}}\n462\t\t\t\treturn req\n463\t\t\t}},\n464\t\t\t{\"header name\", func() *request.Request {\n465\t\t\t\treq := base()\n466\t\t\t\treq.Headers = []request.Pair{{Name: \"X-Trace\\r\\nX-Injected\", Value: request.Literal(\"ok\")}}\n467\t\t\t\treturn req\n468\t\t\t}},\n469\t\t\t{\"basic auth credential\", func() *request.Request {\n470\t\t\t\treq := base()\n471\t\t\t\treq.Headers = []request.Pair{{\n472\t\t\t\t\tName:  \"Authorization\",\n473\t\t\t\t\tValue: request.Secret(secret.Env(\"TALARIA_AUTH_BASIC\"), request.EncodeBasic),\n474\t\t\t\t}}\n475\t\t\t\treturn req\n476\t\t\t}},\n477\t\t\t{\"cookie value\", func() *request.Request {\n478\t\t\t\treq := base()\n479\t\t\t\treq.Cookies = []request.Pair{{Name: \"flavour\", Value: request.Literal(injection)}}\n480\t\t\t\treturn req\n481\t\t\t}},\n482\t\t\t{\"cookie name\", func() *request.Request {\n483\t\t\t\treq := base()\n484\t\t\t\treq.Cookies = []request.Pair{{Name: \"flavour\\r\\nX-Injected: 1\", Value: request.Literal(\"salty\")}}\n485\t\t\t\treturn req\n486\t\t\t}},\n487\t\t\t{\"method\", func() *request.Request {\n488\t\t\t\treq := base()\n489\t\t\t\treq.Method = \"GET /admin HTTP/1.1\"\n490\t\t\t\treturn req\n491\t\t\t}},\n492\t\t\t{\"method with a CRLF\", func() *request.Request {\n493\t\t\t\treq := base()\n494\t\t\t\treq.Method = \"GET\\r\\nX-Injected: 1\"\n495\t\t\t\treturn req\n496\t\t\t}},\n497\t\t}\n498\t\n499\t\tfor _, tc := range tests {\n500\t\t\tt.Run(tc.name, func(t *testing.T) {\n501\t\t\t\tt.Setenv(\"TALARIA_AUTH_BASIC\", \"alice:pw\\r\\nX-Injected: 1\")\n502\t\n503\t\t\t\tconfig, _, cleanup, err := BuildConfig(tc.req(), Capture{})\n504\t\t\t\tif cleanup != nil {\n505\t\t\t\t\tcleanup()\n506\t\t\t\t}\n507\t\n508\t\t\t\tif err == nil {\n509\t\t\t\t\tt.Fatalf(\"BuildConfig() succeeded, want a refusal; document:\\n%s\", config)\n510\t\t\t\t}\n511\t\t\t\tif code := clierr.From(err).Code; code != clierr.CodeUsage {\n512\t\t\t\t\tt.Errorf(\"exit code = %d, want %d\", code, clierr.CodeUsage)\n513\t\t\t\t}\n514\t\t\t\t// The document is what curl reads. A refusal that still returns one\n5