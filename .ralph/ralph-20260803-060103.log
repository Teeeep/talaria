        "content": "384\tfunc TestRunStillReportsWhenAnOperationTimesOut(t *testing.T) {\n385\t\t// A listener that accepts and never answers. Without a bound on the curl\n386\t\t// subprocess the suite would stall here and emit no report at all, which is\n387\t\t// the one outcome CI and an agent cannot act on.\n388\t\tln, err := net.Listen(\"tcp\", \"127.0.0.1:0\")\n389\t\tif err != nil {\n390\t\t\tt.Fatalf(\"listen: %v\", err)\n391\t\t}\n392\t\n393\t\taccepted := make(chan struct{})\n394\t\tgo func() {\n395\t\t\tdefer close(accepted)\n396\t\n397\t\t\tvar conns []net.Conn\n398\t\t\tdefer func() {\n399\t\t\t\tfor _, conn := range conns {\n400\t\t\t\t\tconn.Close() //nolint:errcheck // Test teardown.\n401\t\t\t\t}\n402\t\t\t}()\n403\t\n404\t\t\tfor {\n405\t\t\t\tconn, err := ln.Accept()\n406\t\t\t\tif err != nil {\n407\t\t\t\t\treturn\n408\t\t\t\t}\n409\t\t\t\tconns = append(conns, conn)\n410\t\t\t}\n411\t\t}()\n412\t\tt.Cleanup(func() {\n413\t\t\tln.Close() //nolint:errcheck // Test teardown.\n414\t\t\t<-accepted\n415\t\t})\n416\t\n417\t\tcode, stdout, stderr := runRun(t, runSpecFile, \"--operation\", \"listPets\",\n418\t\t\t\"--base-url\", \"http://\"+ln.Addr().String(), \"--timeout\", \"1\", \"--output\", \"json\")\n419\t\tif code != 0 {\n420\t\t\tt.Fatalf(\"run = %d, want 0 without --fail-on-error; stderr: %s\", code, stderr)\n421\t\t}\n422\t\n423\t\tgot := decodeRun(t, stdout)\n424\t\tif got.Summary.Failed != 1 {\n425\t\t\tt.Fatalf(\"summary = %+v, want the timed-out operation reported as failed\", got.Summary)\n426\t\t}\n427\t\tif reason := got.result(t, \"listPets\").Reason; !strings.Contains(reason, \"curl exited 28\") {\n428\t\t\tt.Errorf(\"listPets reason = %q, want curl's timeout status in it\", reason)\n429\t\t}\n430\t}\n431\t\n432\tfunc TestRunReportsAnUnsatisfiedCredentialAndExitsFive(t *testing.T) {\n433\t\tsrv := newRunServer(t)\n434\t\tt.Setenv(\"TALARIA_AUTH_APIKEY_PETKEY\", \"\")\n435\t\n436\t\tcode, stdout, stderr := runRun(t, runSpecFile,\n437\t\t\t\"--operation\", \"getSecure\", \"--base-url\", srv.URL, \"--output\", \"json\")\n438\t\tif code != 5 {\n439\t\t\tt.Fatalf(\"run = %d, want 5; stderr: %s\", code, stderr)\n440\t\t}\n441\t\n442\t\tres := decodeRun(t, stdout).result(t, \"getSecure\")\n443\t\tif res.Outcome != \"skipped\" {\n444\t\t\tt.Errorf(\"getSecure outcome = %q, want skipped\", res.Outcome)\n445\t\t}\n446\t\tif !strings.Contains(res.Reason, \"TALARIA_AUTH_APIKEY_PETKEY\") {\n447\t\t\tt.Errorf(\"getSecure reason = %q, want it to name the variable to export\", res.Reason)\n448\t\t}\n449\t\tif len(srv.received()) != 0 {\n450\t\t\tt.Errorf(\"server saw %v, want no request without a credential\", srv.paths())\n451\t\t}\n452\t}\n453\t\n454\tfunc TestRunFillsPathParametersFromThePriorityChain(t *testing.T) {\n455\t\tsrv := newRunServer(t)\n456\t\n457\t\tcode, stdout, stderr := runRun(t, runSpecFile,\n458\t\t\t\"--operation\", \"getPet\", \"--base-url\", srv.URL, \"--output\", \"json\")\n459\t\tif code != 0 {\n460\t\t\tt.Fatalf(\"run = %d, want 0; stderr: %s\", code, stderr)\n461\t\t}\n462\t\tif res := decodeRun(t, stdout).result(t, \"getPet\"); res.Outcome != \"passed\" {\n463\t\t\tt.Errorf(\"getPet outcome = %q (%s), want passed\", res.Outcome, res.Reason)\n464\t\t}\n465\t\t// \"42\" is the spec example, which beats generation.\n466\t\tif want := []string{\"GET /pets/42\"}; strings.Join(srv.paths(), \",\") != strings.Join(want, \",\") {\n467\t\t\tt.Errorf(\"server saw %v, want %v\", srv.paths(), want)\n468\t\t}\n469\t\n470\t\tunsuppliable := newRunServer(t)\n471\t\tcode, stdout, stderr = runRun(t, runSpecFile,\n472\t\t\t\"--operation\", \"getReport\", \"--base-url\", unsuppliable.URL, \"--output\", \"json\")\n473\t\tif code != 0 {\n474\t\t\tt.Fatalf(\"run = %d, want 0; stderr: %s\", code, stderr)\n475\t\t}\n476\t\tres := decodeRun(t, stdout).result(t, \"getReport\")\n477\t\tif res.Outcome != \"skipped\" {\n478\t\t\tt.Fatalf(\"getReport outcome = %q, want skipped\", res.Outcome)\n479\t\t}\n480\t\tif