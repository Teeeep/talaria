t\tfor j := 0; j < 40; j++ {\n\t\t\t\tif _, err := s.Read(); err != nil {\n\t\t\t\t\tt.Error(err)\n\t\t\t\t\treturn\n\t\t\t\t}\n\t\t\t}\n\t\t}()\n\t}\n\twg.Wait()\n\n\tgot, err := s.Read()\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif len(got) != 320 {\n\t\tt.Fatalf(\"lost entries: got %d want 320\", len(got))\n\t}\n\tseen := map[string]bool{}\n\tfor _, e := range got {\n\t\tif seen[e.ID] {\n\t\t\tt.Fatalf(\"duplicate id %q\", e.ID)\n\t\t}\n\t\tseen[e.ID] = true\n\t}\n}\nEOF\ngo mod tidy >/dev/null 2>&1; go test -race -count=1 -v ./... 2>&1 | tail -30"
