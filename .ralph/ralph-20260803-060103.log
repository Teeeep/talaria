        "content": "1\tpackage config\n2\t\n3\timport (\n4\t\t\"regexp\"\n5\t\t\"sort\"\n6\t\t\"strings\"\n7\t\n8\t\tv3high \"github.com/pb33f/libopenapi/datamodel/high/v3\"\n9\t\n10\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n11\t\t\"github.com/Teeeep/talaria/internal/operation\"\n12\t\t\"github.com/Teeeep/talaria/internal/secret\"\n13\t\t\"github.com/Teeeep/talaria/internal/spec\"\n14\t)\n15\t\n16\t// The env-var convention from DESIGN.md §5. It is a convention rather than a\n17\t// setting on purpose: an agent can tell a human \"export $TALARIA_AUTH_BEARER\"\n18\t// having read nothing but the scheme's type.\n19\tconst (\n20\t\t// EnvBearer holds the token for an `http`/`bearer` scheme.\n21\t\tEnvBearer = \"TALARIA_AUTH_BEARER\"\n22\t\t// EnvBasic holds the user:password for an `http`/`basic` scheme.\n23\t\tEnvBasic = \"TALARIA_AUTH_BASIC\"\n24\t\t// EnvAPIKeyPrefix is followed by the upper-cased scheme name, so a scheme\n25\t\t// called petKey reads TALARIA_AUTH_APIKEY_PETKEY.\n26\t\tEnvAPIKeyPrefix = \"TALARIA_AUTH_APIKEY_\"\n27\t)\n28\t\n29\t// Kind is the shape of a credential, which decides how internal/curl sends it.\n30\ttype Kind string\n31\t\n32\tconst (\n33\t\t// KindBearer is an RFC 6750 bearer token: Authorization: Bearer <value>.\n34\t\tKindBearer Kind = \"bearer\"\n35\t\t// KindBasic is HTTP basic auth, whose value is user:password.\n36\t\tKindBasic Kind = \"basic\"\n37\t\t// KindAPIKey is an opaque key sent verbatim in a header, query parameter or\n38\t\t// cookie.\n39\t\tKindAPIKey Kind = \"apiKey\"\n40\t)\n41\t\n42\t// Credential locations, matching the OpenAPI `in` values.\n43\tconst (\n44\t\tInHeader = \"header\"\n45\t\tInQuery  = \"query\"\n46\t\tInCookie = \"cookie\"\n47\t)\n48\t\n49\t// Credential is one security scheme resolved to a place on the request and the\n50\t// *name* of the value that goes there. It deliberately has no field that could\n51\t// hold the value: everything downstream can carry a Credential safely, and\n52\t// reading the secret is internal/curl calling Ref.Resolve at exec time.\n53\ttype Credential struct {\n54\t\t// Scheme is the key from components.securitySchemes.\n55\t\tScheme string `json:\"scheme\"`\n56\t\tKind   Kind   `json:\"kind\"`\n57\t\t// In is where the credential goes: InHeader, InQuery or InCookie.\n58\t\tIn string `json:\"in\"`\n59\t\t// Name is the header name, query parameter or cookie name. For bearer and\n60\t\t// basic it is always Authorization.\n61\t\tName string `json:\"name\"`\n62\t\t// Ref names the credential. It marshals redacted, like everywhere else.\n63\t\tRef secret.SecretRef `json:\"source\"`\n64\t}\n65\t\n66\t// Present reports whether the credential this names is set, without reading it.\n67\t// `auth check` is built on this: the answer an agent needs is \"is it there\",\n68\t// and the value is never part of the answer (§5 Auth).\n69\tfunc (c Credential) Present() bool { return c.Ref.Present() }\n70\t\n71\t// Resolve maps the security schemes op requires onto credentials.\n72\t//\n73\t// A spec may offer several alternative requirements; the first one talaria can\n74\t// satisfy wins, so a spec offering OAuth2 or a bearer token resolves to the\n75\t// bearer token rather than failing. Every scheme within the chosen requirement\n76\t// is returned, because a requirement's schemes apply together.\n77\t//\n78\t// An operation with no security, or with an empty requirement (auth optional),\n79\t// resolves to no credentials.\n80\tfunc Resolve(op operation.Operation, doc *spec.Document, prof *Profile) ([]Credential, error) {\n81\t\tschemes := securitySchemes(doc)\n82\t\n83\t\tvar unsupported []string\n84\t\tfor _, req := range op.Security {\n85\t\t\tif len(req.Schemes) == 0 {\n86\t\t\t\treturn nil, nil\n87\t\t\t}\n88\t\n89\t\t\tif reason := unsupportedReason(req, schemes); reason != \"\" {\n90\t\t\t\tunsupported = append(unsupported, reason)\n91\t\t\t\tcontinue\n92\t\t\t}\n93\t\n94\t\t\treturn credentials(req, schemes, prof)\n95\t\t}\n96\t\n97\t\tif len(unsupported) == 0 {\n98\t\t\treturn nil, nil\n99\t\t}\n100\t\n101\t\treturn nil, clierr.Usage(\"no usable security scheme for %s: %s\",\n102\t\t\toperationName(op), strings.Join(unsupported, \"; \"))\n103\t}\n104\t\n105\t// Schemes lists every security scheme the document declares that talaria can\n106\t// satisfy, as the credential that would satisfy it, sorted by scheme name.\n107\t//\n108\t// Resolve answers \"which credentials does this call use\". This answers \"which\n109\t// credentials does this spec ask for at all\", which is the question `auth\n110\t// check` reports on. Schemes talaria has no way to supply — OAuth2, OpenID\n111\t// Connect, an API key in a place a request does not have — are left out: there\n112\t// is no variable to tell a human to set, so there is nothing to report (§5).\n113\tfunc Schemes(doc *spec.Document, prof *Profile) ([]Credential, error) {\n114\t\tdeclared := securitySchemes(doc)\n115\t\n116\t\tnames := make([]string, 0, len(declared))\n117\t\tfor name, scheme := range declared {\n118\t\t\tif schemeReason(name, scheme) == \"\" {\n119\t\t\t\tnames = append(names, name)\n120\t\t\t}\n121\t\t}\n122\t\t// Sorted, because the map iteration behind it is not, and a report whose\n123\t\t// line order changes between runs is one no diff can be taken of.\n124\t\tsort.Strings(names)\n125\t\n126\t\tout := make([]Credential, 0, len(names))\n127\t\tfor _, name := range names {\n128\t\t\tcred, err := credentialFor(name, declared[name], prof)\n129\t\t\tif err != nil {\n130\t\t\t\treturn nil, err\n131\t\t\t}\n132\t\t\tout = append(out, cred)\n133\t\t}\n134\t\n135\t\treturn out, nil\n136\t}\n137\t\n138\t// unsupportedReason returns why this requirement cannot be satisfied, or \"\" if\n139\t// it can. A requirement's schemes apply together, so one unusable scheme makes\n140\t// the whole alternative unusable.\n141\tfunc unsupportedReason(req operation.SecurityRequirement, schemes map[string]*v3high.SecurityScheme) string {\n142\t\tfor _, want := range req.Schemes {\n143\t\t\tscheme, ok := schemes[want.Name]\n144\t\t\tif !ok {\n145\t\t\t\treturn \"scheme \" + want.Name + \" is not declared in components.securitySchemes\"\n146\t\t\t}\n147\t\n148\t\t\tif reason := schemeReason(want.Name, scheme); reason != \"\" {\n149\t\t\t\treturn reason\n150\t\t\t}\n151\t\t}\n152\t\n153\t\treturn \"\"\n154\t}\n155\t\n156\t// schemeReason returns why talaria cannot use one declared scheme, or \"\" if it\n157\t// can. v1 covers bearer, basic and API keys; OAuth2 and OpenID Connect are out\n158\t// of scope, and the caller is expected to bring a token for them (§5 Auth).\n159\tfunc schemeReason(name string, scheme *v3high.SecurityScheme) string {\n160\t\tswitch {\n161\t\tcase isHTTP(scheme, \"bearer\"), isHTTP(scheme, \"basic\"):\n162\t\t\treturn \"\"\n163\t\tcase strings.EqualFold(scheme.Type, \"apiKey\"):\n164\t\t\tswitch scheme.In {\n165\t\t\tcase InHeader, InQuery, InCookie:\n166\t\t\t\treturn \"\"\n167\t\t\tdefault:\n168\t\t\t\treturn \"scheme \" + name + \" puts its API key in \" + scheme.In\n169\t\t\t}\n170\t\tdefault:\n171\t\t\treturn \"scheme \" + name + \" is of unsupported type \" + describeType(scheme)\n172\t\t}\n173\t}\n174\t\n175\t// credentials builds one Credential per scheme of a requirement already known\n176\t// to be supported. The only failure left is a malformed profile entry, which is\n177\t// fatal rather than a reason to try another alternative: the user meant to\n178\t// configure this scheme and got it wrong.\n179\tfunc credentials(\n180\t\treq operation.SecurityRequirement,\n181\t\tschemes map[string]*v3high.SecurityScheme,\n182\t\tprof *Profile,\n183\t) ([]Credential, error) {\n184\t\tout := make([]Credential, 0, len(req.Schemes))\n185\t\tfor _, want := range req.Schemes {\n186\t\t\tcred, err := credentialFor(want.Name, schemes[want.Name], prof)\n187\t\t\tif err != nil {\n188\t\t\t\treturn nil, err\n189\t\t\t}\n190\t\n191\t\t\tout = append(out, cred)\n192\t\t}\n193\t\n194\t\treturn out, nil\n195\t}\n196\t\n197\t// credentialFor builds the Credential for one supported scheme: where the value\n198\t// goes on the request, and the name of the value that goes there.\n199\tfunc credentialFor(name string, scheme *v3high.SecurityScheme, prof *Profile) (Credential, error) {\n200\t\tcred := Credential{Scheme: name, In: InHeader, Name: \"Authorization\"}\n201\t\tswitch {\n202\t\tcase isHTTP(scheme, \"bearer\"):\n203\t\t\tcred.Kind, cred.Ref = KindBearer, secret.Env(EnvBearer)\n204\t\tcase isHTTP(scheme, \"basic\"):\n205\t\t\tcred.Kind, cred.Ref = KindBasic, secret.Env(EnvBasic)\n206\t\tdefault:\n207\t\t\tcred.Kind = KindAPIKey\n208\t\t\tcred.In, cred.Name = scheme.In, scheme.Name\n209\t\t\tcred.Ref = secret.Env(EnvAPIKeyPrefix + envSuffix(name))\n210\t\t}\n211\t\n212\t\t// The profile is the more specific source and wins over the convention: it\n213\t\t// is how one machine talks to staging and production at once.\n214\t\tref, err := profileRef(prof, name)\n215\t\tif err != nil {\n216\t\t\treturn Credential{}, err\n217\t\t}\n218\t\tif !ref.IsZero() {\n219\t\t\tcred.Ref = ref\n220\t\t}\n221\t\n222\t\treturn cred, nil\n223\t}\n224\t\n225\t// envRef matches a profile auth entry: ${VAR} or $VAR, and nothing else.\n226\tvar envRef = regexp.MustCompile(`^\\$\\{?([A-Za-z_][A-Za-z0-9_]*)\\}?$`)\n227\t\n228\t// profileRef reads the profile's entry for a scheme. A profile may only\n229\t// *reference* an environment variable; a literal value is refused, because a\n230\t// credential in a config file is a credential this process would have to carry,\n231\t// and the firewall's whole claim is that it never does.\n232\t//\n233\t// The error names neither the value nor any part of it.\n234\tfunc profileRef(prof *Profile, scheme string) (secret.SecretRef, error) {\n235\t\tif prof == nil {\n236\t\t\treturn secret.SecretRef{}, nil\n237\t\t}\n238\t\n239\t\tentry, ok := prof.Auth[scheme]\n240\t\tif !ok || entry == \"\" {\n241\t\t\treturn secret.SecretRef{}, nil\n242\t\t}\n243\t\n244\t\tmatch := envRef.FindStringSubmatch(entry)\n245\t\tif match == nil {\n246\t\t\treturn secret.SecretRef{}, clierr.Usage(\n247\t\t\t\t\"profile %q sets auth for scheme %q to a literal value; \"+\n248\t\t\t\t\t\"it must reference an environment variable, e.g. ${MY_TOKEN}\",\n249\t\t\t\tprof.Name, scheme)\n250\t\t}\n251\t\n252\t\treturn secret.Env(match[1]), nil\n253\t}\n254\t\n255\t// securitySchemes flattens components.securitySchemes into a lookup. A document\n256\t// without any is not an error: an operation that names a scheme the document\n257\t// does not declare is reported per-requirement by unsupportedReason.\n258\tfunc securitySchemes(doc *spec.Document) map[string]*v3high.SecurityScheme {\n259\t\tout := map[string]*v3high.SecurityScheme{}\n260\t\tif doc == nil || doc.Model == nil || doc.Model.Components == nil {\n261\t\t\treturn out\n262\t\t}\n263\t\n264\t\tfor pair := doc.Model.Components.SecuritySchemes.First(); pair != nil; pair = pair.Next() {\n265\t\t\tif scheme := pair.Value(); scheme != nil {\n266\t\t\t\tout[pair.Key()] = scheme\n267\t\t\t}\n268\t\t}\n269\t\n270\t\treturn out\n271\t}\n272\t\n273\tfunc isHTTP(scheme *v3high.SecurityScheme, kind string) bool {\n274\t\treturn strings.EqualFold(scheme.Type, \"http\") && strings.EqualFold(scheme.Scheme, kind)\n275\t}\n276\t\n277\t// describeType renders a scheme's type for an error message, including the\n278\t// http scheme when there is one, so \"http (digest)\" is distinguishable from\n279\t// the bearer and basic cases talaria does support.\n280\tfunc describeType(scheme *v3high.SecurityScheme) string {\n281\t\tif scheme.Scheme != \"\" {\n282\t\t\treturn scheme.Type + \" (\" + scheme.Scheme + \")\"\n283\t\t}\n284\t\n285\t\treturn scheme.Type\n286\t}\n287\t\n288\t// envSuffix turns a scheme name into the tail of its env var: upper-cased, with\n289\t// everything outside [A-Z0-9] flattened to _ so a scheme called `pet-key` maps\n290\t// to a name a shell can actually export.\n291\tfunc envSuffix(scheme string) string {\n292\t\tupper := strings.ToUpper(scheme)\n293\t\n294\t\tvar b strings.Builder\n295\t\tb.Grow(len(upper))\n296\t\tfor _, r := range upper {\n297\t\t\tswitch {\n298\t\t\tcase r >= 'A' && r <= 'Z', r >= '0' && r <= '9':\n299\t\t\t\tb.WriteRune(r)\n300\t\t\tdefault:\n301\t\t\t\tb.WriteByte('_')\n302\t\t\t}\n303\t\t}\n304\t\n305\t\treturn b.String()\n306\t}\n307\t\n308\t// operationName is the operation's ID, falling back to method and path for a\n309\t// spec that sets no operationId — an error naming neither is unactionable.\n310\tfunc operationName(op operation.Operation) string {\n311\t\tif op.ID != \"\" {\n312\t\t\treturn op.ID\n313\t\t}\n314\t\n315\t\treturn op.Method + \" \" + op.Path\n316\t}\n317\t"
      }
