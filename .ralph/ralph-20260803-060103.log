    "content": [
      {
        "tool_use_id": "toolu_017aobPqWafyhERNeVtmLu3b",
        "type": "tool_result",
        "content": "1\t// Package validate checks an observed HTTP response against the contract the\n2\t// spec declares for it: was the status documented, was the content type\n3\t// declared, does the body match the schema.\n4\t//\n5\t// It takes plain data — method, URL, status, headers, body bytes — rather than\n6\t// an http.Response or anything from internal/curl. That is the §5 boundary\n7\t// rule: this package is shared with the twin server and, later, with replay\n8\t// from the corpus, so the caller converts its own representation into an Input\n9\t// and this package converts nothing back.\n10\tpackage validate\n11\t\n12\timport (\n13\t\t\"bytes\"\n14\t\t\"io\"\n15\t\t\"net/http\"\n16\t\t\"net/url\"\n17\t\n18\t\tvalidator \"github.com/pb33f/libopenapi-validator\"\n19\t\tliberrors \"github.com/pb33f/libopenapi-validator/errors\"\n20\t\t\"github.com/pb33f/libopenapi-validator/helpers\"\n21\t\n22\t\t\"github.com/Teeeep/talaria/internal/clierr\"\n23\t\t\"github.com/Teeeep/talaria/internal/spec\"\n24\t)\n25\t\n26\t// Input is one observed HTTP exchange, reduced to the data validation needs.\n27\t// Headers may be nil; Body may be empty, which is how a 204 arrives.\n28\ttype Input struct {\n29\t\t// Method is the HTTP method of the request that produced the response.\n30\t\tMethod string\n31\t\t// URL is the request URL as called. It may point somewhere other than the\n32\t\t// spec's declared server — --base-url and the twin both do that — and\n33\t\t// routing tolerates it (see Validator.Response).\n34\t\tURL string\n35\t\t// Status is the HTTP status code observed.\n36\t\tStatus int\n37\t\t// Headers are the response headers.\n38\t\tHeaders http.Header\n39\t\t// Body is the raw response body.\n40\t\tBody []byte\n41\t}\n42\t\n43\t// Result is the `validation` block of call's output (DESIGN.md §4). The three\n44\t// booleans answer the three questions independently, so an agent can tell \"the\n45\t// server returned an undocumented 500\" from \"the documented 200 came back with\n46\t// the wrong shape\" without parsing prose.\n47\ttype Result struct {\n48\t\tStatusDocumented      bool    `json:\"status_documented\"`\n49\t\tContentTypeDocumented bool    `json:\"content_type_documented\"`\n50\t\tBodyValid             bool    `json:\"body_valid\"`\n51\t\tErrors                []Error `json:\"errors\"`\n52\t}\n53\t\n54\t// Error is one contract violation, flattened. A schema failure produces one\n55\t// Error per failing field rather than one per response, because the field is\n56\t// the actionable part.\n57\ttype Error struct {\n58\t\tMessage string `json:\"message\"`\n59\t\tReason  string `json:\"reason,omitempty\"`\n60\t\t// Field is the JSONPath to the offending value, e.g. \"$[0].id\". It is\n61\t\t// empty for violations that are not about a field — an undocumented status\n62\t\t// or content type.\n63\t\tField string `json:\"field,omitempty\"`\n64\t}\n65\t\n66\t// Validator holds the compiled schemas for one document. Building it warms\n67\t// every schema in the spec, so `run` builds one and reuses it across the whole\n68\t// smoke test rather than paying that cost per response.\n69\ttype Validator struct {\n70\t\tv validator.Validator\n71\t}\n72\t\n73\t// New builds a Validator for doc.\n74\t//\n75\t// No strictness options are passed. libopenapi-validator defaults to OpenAPI\n76\t// 3.1+ JSON Schema semantics, which DESIGN.md §8 flagged as a risk for 3.0\n77\t// documents; as of v0.14.0 the library reads the document's own version and\n78\t// rewrites the 3.0-only constructs (`nullable`, boolean exclusive bounds,\n79\t// singular `example`) before compiling, so the default is already correct.\n80\t// validate_test.go pins that behaviour against an adversarial 3.0 fixture.\n81\tfunc New(doc *spec.Document) *Validator {\n82\t\treturn &Validator{v: validator.NewValidatorFromV3Model(doc.Model)}\n83\t}\n84\t\n85\t// Response validates in against the document.\n86\t//\n87\t// Routing is host- and prefix-tolerant by design: the validator matches on the\n88\t// path alone, so a call redirected by --base-url to a twin on localhost, with\n89\t// or without the server's path prefix, validates against the same operation as\n90\t// a call to the real host. The returned error is reserved for input this\n91\t// package cannot even attempt — an unparseable URL — not for a response that\n92\t// violates the contract, which is a Result with Errors and exit code 0 unless\n93\t// the caller asked for --fail-on-error.\n94\tfunc (val *Validator) Response(in Input) (*Result, error) {\n95\t\treq, err := buildRequest(in)\n96\t\tif err != nil {\n97\t\t\treturn nil, err\n98\t\t}\n99\t\n100\t\t_, verrs := val.v.ValidateHttpResponse(req, buildResponse(in))\n101\t\n102\t\tres := &Result{\n103\t\t\tStatusDocumented:      true,\n104\t\t\tContentTypeDocumented: true,\n105\t\t\tBodyValid:             true,\n106\t\t\tErrors:                []Error{},\n107\t\t}\n108\t\tfor _, verr := range verrs {\n109\t\t\tswitch {\n110\t\t\tcase verr.ValidationType == helpers.PathValidation:\n111\t\t\t\t// The spec has no such operation, so nothing about this response is\n112\t\t\t\t// documented. Reporting the status as documented here would be a\n113\t\t\t\t// claim about a contract that does not exist.\n114\t\t\t\tres.StatusDocumented = false\n115\t\t\t\tres.ContentTypeDocumented = false\n116\t\t\t\tres.BodyValid = false\n117\t\t\tcase verr.ValidationSubType == helpers.ResponseBodyResponseCode:\n118\t\t\t\tres.StatusDocumented = false\n119\t\t\tcase verr.ValidationSubType == helpers.RequestBodyContentType:\n120\t\t\t\tres.ContentTypeDocumented = false\n121\t\t\tdefault:\n122\t\t\t\tres.BodyValid = false\n123\t\t\t}\n124\t\t\tres.Errors = append(res.Errors, flatten(verr)...)\n125\t\t}\n126\t\n127\t\treturn res, nil\n128\t}\n129\t\n130\t// Response is the one-shot form: build a validator for doc and validate a\n131\t// single exchange. Callers validating many responses against one spec should\n132\t// use New instead.\n133\tfunc Response(doc *spec.Document, in Input) (*Result, error) {\n134\t\treturn New(doc).Response(in)\n135\t}\n136\t\n137\t// buildRequest reconstructs the request the validator needs to locate the\n138\t// operation. Only the method and URL matter — the request body is never\n139\t// consulted when validating a response.\n140\tfunc buildRequest(in Input) (*http.Request, error) {\n141\t\tparsed, err := url.Parse(in.URL)\n142\t\tif err != nil {\n143\t\t\treturn nil, clierr.Usage(\"validating response: parsing request URL %q: %w\", in.URL, err)\n144\t\t}\n145\t\n146\t\treturn &http.Request{\n147\t\t\tMethod: in.Method,\n148\t\t\tURL:    parsed,\n149\t\t\tHost:   parsed.Host,\n150\t\t\tHeader: http.Header{},\n151\t\t}, nil\n152\t}\n153\t\n154\t// buildResponse wraps the observed data in the http.Response the validator\n155\t// takes. The body is a fresh reader over the caller's bytes, so validating the\n156\t// same Input twice reads the same body twice.\n157\tfunc buildResponse(in Input) *http.Response {\n158\t\theaders := in.Headers\n159\t\tif headers == nil {\n160\t\t\theaders = http.Header{}\n161\t\t}\n162\t\n163\t\treturn &http.Response{\n164\t\t\tStatusCode:    in.Status,\n165\t\t\tHeader:        headers,\n166\t\t\tBody:          io.NopCloser(bytes.NewReader(in.Body)),\n167\t\t\tContentLength: int64(len(in.Body)),\n168\t\t}\n169\t}\n170\t\n171\t// flatten turns one library error into the Errors it should surface as. A\n172\t// schema failure carries a list of per-field failures; anything else — an\n173\t// undocumented status, an undeclared content type — is a single Error.\n174\tfunc flatten(verr *liberrors.ValidationError) []Error {\n175\t\tif len(verr.SchemaValidationErrors) == 0 {\n176\t\t\treturn []Error{{Message: verr.Message, Reason: verr.Reason}}\n177\t\t}\n178\t\n179\t\tout := make([]Error, 0, len(verr.SchemaValidationErrors))\n180\t\tfor _, failure := range verr.SchemaValidationErrors {\n181\t\t\tfield := failure.FieldPath\n182\t\t\tif field == \"\" {\n183\t\t\t\tfield = failure.FieldName\n184\t\t\t}\n185\t\t\tout = append(out, Error{Message: verr.Message, Reason: failure.Reason, Field: field})\n186\t\t}\n187\t\n188\t\treturn out\n189\t}\n190\t"
      }
