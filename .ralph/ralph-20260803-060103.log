        "content": "40\t// rather than an interface so it marshals, compares and prints as one thing.\n41\t//\n42\t// The zero Value is an empty literal.\n43\ttype Value struct {\n44\t\tliteral string\n45\t\tref     secret.SecretRef\n46\t\tenc     Encoding\n47\t\t// sensitive hides a literal from every display form. A referenced\n48\t\t// credential needs no such flag: it has no value to hide.\n49\t\tsensitive bool\n50\t}\n51\t\n52\t// Literal returns a Value holding text the user supplied directly.\n53\tfunc Literal(s string) Value { return Value{literal: s} }\n54\t\n55\t// Secret returns a Value naming a credential, encoded per enc.\n56\tfunc Secret(ref secret.SecretRef, enc Encoding) Value { return Value{ref: ref, enc: enc} }\n57\t\n58\t// Sensitive returns a copy of v that displays as `<redacted>` everywhere a\n59\t// Value is displayed, while still going on the wire unchanged.\n60\t//\n61\t// It is what a literal sitting under a credential-shaped name becomes: a token\n62\t// the user typed into `--header Authorization: …` is as sensitive as one\n63\t// talaria resolved itself (§5a's built-in list, which \"applies to pretty output\n64\t// too\"). Marking the Value rather than scrubbing each renderer is the point —\n65\t// §5a's architecture consequence is that a surface has to *ask* for a secret to\n66\t// leak one, and there is no way to ask a Value for a hidden literal except\n67\t// Reveal.\n68\tfunc (v Value) Sensitive() Value {\n69\t\tv.sensitive = true\n70\t\n71\t\treturn v\n72\t}\n73\t\n74\t// IsSecret reports whether this value names a credential.\n75\tfunc (v Value) IsSecret() bool { return !v.ref.IsZero() }\n76\t\n77\t// IsSensitive reports whether this value is hidden from display: every secret\n78\t// is, and so is a literal marked by Sensitive.\n79\tfunc (v Value) IsSensitive() bool { return v.sensitive || v.IsSecret() }\n80\t\n81\t// Ref returns the credential this value names, or the zero SecretRef for a\n82\t// literal. The ref is safe to print: it holds a name, not a value.\n83\tfunc (v Value) Ref() secret.SecretRef { return v.ref }\n84\t\n85\t// Encoding returns how this value becomes field text, so internal/curl can pick\n86\t// the right directive without re-deriving it from the scheme.\n87\tfunc (v Value) Encoding() Encoding { return v.enc }\n88\t\n89\t// String is the display form: the literal as-is, or the encoding prefix\n90\t// followed by `<redacted:env:NAME>`. It is what JSON output, pretty output and\n91\t// history show, and it is safe under every printf verb because SecretRef is.\n92\tfunc (v Value) String() string {\n93\t\tif !v.IsSecret() {\n94\t\t\tif v.sensitive {\n95\t\t\t\treturn secret.Placeholder\n96\t\t\t}\n97\t\n98\t\t\treturn v.literal\n99\t\t}\n100\t\n101\t\treturn v.Prefix() + v.ref.String()\n102\t}\n103\t\n104\t// Reveal returns the literal text this value carries, hidden or not. It exists\n105\t// for the one renderer that builds curl's config document: a sensitive literal\n106\t// still has to go on the wire, and String no longer returns it.\n107\t//\n108\t// For a value naming a credential it returns the redacted display form.\n109\t// Reading a real credential is SecretRef.Resolve, in internal/curl at exec\n110\t// time, and this is not that.\n111\tfunc (v Value) Reveal() string {\n112\t\tif v.IsSecret() {\n113\t\t\treturn v.String()\n114\t\t}\n115\t\n116\t\treturn v.literal\n117\t}\n118\t\n119\t// GoString keeps %#v — the verb reached for when debugging, i.e. exactly when a\n120\t// leak would be least expected — as safe as %v.\n121\tfunc (v Value) GoString() string { return v.String() }\n122\t\n123\t// MarshalJSON renders the display form, so any JSON carrying a credential\n124\t// position carries the redacted name instead of a value.\n125\tfunc (v Value) MarshalJSON() ([]byte, error) { return json.Marshal(v.String()) }\n126\t\n127\t// Symbolic is the form for emitted and dry-run curl: `Bearer $TALARIA_AUTH_BEARER`,\n128\t// runnable wherever the variable is set and useless to exfiltrate (§5a).\n129\t//\n130\t// EncodeBasic has no symbolic header form — the value must be base64-encoded\n131\t// before it goes in the header — so it falls back to the redacted form. The\n132\t// emitted command stays correct because internal/curl renders basic auth with\n133\t// curl's -u, which takes the raw `user:password` and can stay symbolic.\n134\tfunc (v Value) Symbolic() string {\n135\t\tif !v.IsSecret() || v.enc == EncodeBasic {\n136\t\t\treturn v.String()\n137\t\t}\n138\t\n139\t\treturn v.Prefix() + v.ref.Symbolic()\n140\t}\n141\t\n142\t// Prefix is the literal text that precedes the credential in the field, e.g.\n143\t// \"Bearer \" for a token. It is exported because internal/curl builds the\n144\t// resolved field text at exec time and would otherwise have to re-derive the\n145\t// prefix from the scheme — the duplication §5a's single-crossing rule exists to\n146\t// avoid.\n147\tfunc (v Value) Prefix() string {\n148\t\tswitch v.enc {\n149\t\tcase EncodeBearer:\n150\t\t\treturn \"Bearer \"\n151\t\tcase EncodeBasic:\n152\t\t\treturn \"Basic \"\n153\t\tdefault:\n154\t\t\treturn \"\"\n155\t\t}\n156\t}\n157\t\n158\t// Render turns a Value into the text that goes on the wire, in a URL, or on\n159\t// screen. Making it a parameter rather than a method is what keeps resolution\n160\t// out of this package: Redacted and Symbolic live here, and the one renderer\n161\t// that reads credentials is internal/curl's, at exec time.\n162\ttype Render func(Value) (string, error)\n163\t\n164\t// Redacted renders credentials as `<redacted:env:NAME>`. It is the default for\n165\t// every surface a user or agent reads.\n166\tfunc Redacted(v Value) (string, error) { return v.String(), nil }\n167\t\n168\t// Symbolic renders credentials as `$NAME`, for copy-pasteable curl.\n169\tfunc Symbolic(v Value) (string, error) { return v.Symbolic(), nil }"
